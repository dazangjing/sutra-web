{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "阅藏经",
  "version": "0.1.0",
  "identifier": "com.yuezangjing.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "阅藏经",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": null,
        "titleBarStyle": "Visible",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/corpus/assets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/corpus": "corpus"
    },
    "copyright": "© 2026 阅藏经",
    "category": "Education",
    "shortDescription": "阅藏经 · 大藏经桌面阅读器",
    "longDescription": "阅藏经桌面端：内置 CBETA 大藏经全量语料（3,684 篇、4,959 幅图，含正文插图与生僻字字形图），离线全文检索、书架与阅读进度、批注摘录、一键导出。",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
