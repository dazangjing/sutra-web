[[{"t":"礼吴中石佛起止仪式","level":0},{"t":"天台山幽溪沙门　传灯　集","level":0},{"t":"一切恭敬。","level":0},{"t":"一心顶礼十方常住三宝(一拜已，互跪，烧香，散华)。","level":0},{"t":"愿此香华云，徧满十方界，无边佛土中，","level":0,"quote":true},{"t":"无量香庄严，具足菩萨道，成就如来香。","level":0,"quote":true},{"t":"(辍唱，想云：我此香华徧十方，至同入无生证佛智。想已，唱云：)","level":0},{"t":"供养已，一切恭敬(一拜互跪，赞云：)","level":0},{"t":"佛面犹如净满月，亦如千日放光明，","level":0,"quote":true},{"t":"目净修广若青莲，齿白齐密犹珂雪，","level":0,"quote":true},{"t":"佛德无边如大海，无限妙宝积其中，","level":0,"quote":true},{"t":"智慧德水镇常盈，百千胜定咸充满。","level":0,"quote":true},{"t":"足下轮相皆严饰，𨐅辋千辐悉齐平，","level":0,"quote":true},{"t":"手足缦网徧庄严，犹如鹅王相具足。","level":0,"quote":true},{"t":"佛身晃耀等金山，清净殊特无端匹，","level":0,"quote":true},{"t":"亦如妙高功德满，故我稽首佛山王。","level":0,"quote":true},{"t":"相好如空不可测，逾於千日放光明。","level":0,"quote":true},{"t":"皆如燄幻不思议，故我稽首心无著。","level":0,"quote":true},{"t":"(赞已重烧香，然彼礼诸相好)。","level":0},{"t":"足下安平如奁底","level":0},{"t":"足下千辐轮相","level":0},{"t":"手足指长胜餘人","level":0},{"t":"手足柔软胜餘身分","level":0},{"t":"手足指合缦网胜餘人","level":0},{"t":"足跟具足满好","level":0},{"t":"足趺高好跟相称","level":0},{"t":"一心顶礼过去维卫佛迦叶佛手足满","level":0},{"t":"手足如意","level":0},{"t":"手文明直","level":0},{"t":"手文长","level":0},{"t":"手文不断","level":0},{"t":"手足赤白如莲华色","level":0},{"t":"踝不现","level":0},{"t":"爪如赤铜色薄而细滑","level":0},{"t":"指长纤圆","level":0},{"t":"指文藏覆","level":0},{"t":"脉深不现","level":0},{"t":"手足软净滑泽","level":0},{"t":"手足有德相","level":0},{"t":"如伊尼延鹿王腨纤好","level":0},{"t":"膝骨坚著圆好","level":0},{"t":"立手摩膝","level":0},{"t":"阴藏相如马王","level":0},{"t":"脐深圆好","level":0},{"t":"一心顶礼过去维卫佛迦叶佛脐不出","level":0},{"t":"腹不现","level":0},{"t":"其腹细","level":0},{"t":"孔门相具","level":0},{"t":"身纵广等","level":0},{"t":"身坚实如那罗延","level":0},{"t":"骨际如钩鎻","level":0},{"t":"身上如师子王","level":0},{"t":"身清净","level":0},{"t":"身柔软","level":0},{"t":"身不曲","level":0},{"t":"身润泽","level":0},{"t":"身自持不逶迤","level":0},{"t":"身满足","level":0},{"t":"身不倾动","level":0},{"t":"身持重","level":0},{"t":"其身大","level":0},{"t":"其身长","level":0},{"t":"一心顶礼过去维卫佛迦叶佛身端直","level":0},{"t":"肩圆好","level":0},{"t":"一一毛孔青色柔软","level":0},{"t":"毛上向","level":0},{"t":"毛右旋","level":0},{"t":"毛红色","level":0},{"t":"毛软净","level":0},{"t":"皮肤薄细滑不受尘水(不停蚊蚋)","level":0},{"t":"两足下两手两肩项中(七处满)","level":0},{"t":"两腋下满","level":0},{"t":"毛孔出香气","level":0},{"t":"颊车如师子","level":0},{"t":"唇色如频婆果","level":0},{"t":"四十齿具足","level":0},{"t":"齿白齐密而根深","level":0},{"t":"四牙最白而大","level":0},{"t":"四牙白利","level":0},{"t":"舌薄覆面至发际","level":0},{"t":"一心顶礼过去维卫佛迦叶佛舌色赤","level":0},{"t":"舌薄广","level":0},{"t":"随众生音声不增不减","level":0},{"t":"说法不著","level":0},{"t":"随众生语言说法","level":0},{"t":"发音报众声","level":0},{"t":"次第有因缘说法","level":0},{"t":"咽中津液得味中上味","level":0},{"t":"口出无上香","level":0},{"t":"一切声分具足","level":0},{"t":"言音声远","level":0},{"t":"梵音深远如迦陵频迦声","level":0},{"t":"随众生意和悦与语","level":0},{"t":"面不长丈","level":0},{"t":"正容白不挠色","level":0},{"t":"面具满足","level":0},{"t":"面广姝好","level":0},{"t":"面净满如月","level":0},{"t":"一心顶礼过去维卫佛迦叶佛鼻高孔不现","level":0},{"t":"眼色如金精","level":0},{"t":"眼睫如牛王","level":0},{"t":"广长眼","level":0},{"t":"平等视众生","level":0},{"t":"不轻众生","level":0},{"t":"眉如初月绀琉璃色","level":0},{"t":"眉间白毫如兜罗绵","level":0},{"t":"耳轮辐相埵成","level":0},{"t":"头如摩陀那果","level":0},{"t":"发长好","level":0},{"t":"发不好","level":0},{"t":"发旋乱","level":0},{"t":"发色青珠","level":0},{"t":"顶肉髻成","level":0},{"t":"无见顶相","level":0},{"t":"金色光其相微妙","level":0},{"t":"身光面各一丈","level":0},{"t":"一心顶礼过去维卫佛迦叶佛四边光各一丈","level":0},{"t":"光照身而行","level":0},{"t":"行时足去地四寸而印文现","level":0},{"t":"威仪如师子","level":0},{"t":"进止如象王","level":0},{"t":"行法如鹅王","level":0},{"t":"身一时回如象王","level":0},{"t":"容仪备足","level":0},{"t":"容仪满足","level":0},{"t":"住处安无能动者","level":0},{"t":"威振一切","level":0},{"t":"一切乐观","level":0},{"t":"一心顶礼过去维卫佛迦叶佛一切众生不能尽观相","level":0},{"t":"观无厌足","level":0},{"t":"一切恶心众生见者和悦","level":0},{"t":"八万四千相好光明","level":0},{"t":"(礼已，重烧香，忏悔，发愿云：)","level":0},{"t":"至心忏悔。我弟子(某甲)，与法界一切众生，现前一念，清净本然。具无量相好光明，一切神通自在。良由真如妙性，不变随缘。成六尺蕞尔之身，弃百千澄清大海。聚缘内摇，趣外奔逸。纵身口意，起贪嗔痴。身三口四，而无恶不为。五逆七遮，而无罪不造。竖穷九世，横遍六根。开八万四千尘劳之门，备八万四千烦恼之法。自顶至足，何处有功德藂林。由外及中，无非是罪恶园薮。业因不忒，果报无差。缘薄善而暂往人天，因重愆而终归恶道。不重佛性，埋没己灵。妄来妄往，而徒费精神。浪死虗生，而毫无利益。然以罪无自性，其体本空。既不变以随缘，故随缘而不变。悟之成性，固不涉於阶差。起以成修，要必托乎尊胜。普贤十行，礼敬为先。净土五门，忏悔为最。恭闻维卫善逝迦叶如来，一性圆成於[旲/(衣-〦+旦)]劫，三身普覆於十方。示灭度非灭度，石像由南海而浮来；非神通现神通，宝钵自西天而泛至。故知像性即佛，量等虗空，三身宛然，四德无减。归依者福增无量，忏悔者罪灭河沙。故竭愚诚，向二尊而顶礼；五体投地，接两足以翘勤。达能礼所礼，其性虗通；感之应之，不可思议。如帝网之千珠，瑶天之万目，光光交映，彼波互融。对八万四千相好之尊，设八万四千至诚之礼，寂灭八万四千烦恼，成就八万四千度门。惟愿神通显示，威德冥加，使戒定慧清净以无瑕，闻思修精进而不退。念念无违法性，尘尘皆见寂光。即此凡夫之身，堪作菩提之器。众生无边誓愿度，烦恼无数誓愿断，法门无量誓愿学，佛道无上誓愿成。愿命终时神不乱，正念直往生安养，面奉弥陀值众圣，修行十地胜常乐。忏悔发愿已，一心归命顶礼。","level":0},{"t":"(起身一拜，重烧香散华，如法旋绕)。","level":0},{"t":"南无十方佛南无十方法南无十方僧南无维卫佛南无迦叶佛南无诸尊(菩萨摩诃萨)","level":0},{"t":"(或三徧，或七遍，旋毕至佛前，三自归依)。","level":0},{"t":"自归於佛当愿众生体解大道发无上心自归於法当愿众生深入经藏智慧如海自归於僧当愿众生统理大众一切无碍和南圣众","level":0},{"t":"礼吴中石佛起止仪式(终)","level":0}]]