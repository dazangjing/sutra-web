[[{"t":"经卷第五十六","level":2},{"t":"离世闲品之四","level":0},{"t":"迫隘","level":0},{"t":"(隘於懈反玉篇曰迫隘也隘狭也夫狭窄必相逼)。","level":0},{"t":"无所触娆","level":0},{"t":"(娆乃了反三苍娆扰也孔安注书曰扰乱也说文曰扰烦也)。","level":0},{"t":"悉称","level":0},{"t":"(称昌孕惬可也又[迄-乙+小]雅曰称好也郭璞注云事称人意皆好也)。","level":0},{"t":"补特伽罗","level":0},{"t":"(此翻为数取趣谓数造趣因数取趣果也旧翻为人随方语便非正刻字译也)。","level":0},{"t":"心恒<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />复","level":0},{"t":"(已见苐二十三卷)。","level":0},{"t":"嬉戏","level":0},{"t":"(嬉许其反切韵称戏游也)。","level":0}],[{"t":"经卷第五十七","level":2},{"t":"离世闲品之五","level":0},{"t":"得预","level":0},{"t":"(预餘茹反珠丛曰凡事相及曰预字古作与也)。","level":0},{"t":"菩提萨埵","level":0},{"t":"(依佛地论云亲光菩萨以三义释菩提萨埵具如彼论中也)。","level":0},{"t":"不<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06114.gif\" alt=\"㢮\" title=\"㢮\" />","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06114.gif\" alt=\"㢮\" title=\"㢮\" />式尓反论语云君子不<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06114.gif\" alt=\"㢮\" title=\"㢮\" />其亲孔安注曰<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06114.gif\" alt=\"㢮\" title=\"㢮\" />易也韦昭注汉书曰<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06114.gif\" alt=\"㢮\" title=\"㢮\" />废也郭璞注尓雅曰<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06114.gif\" alt=\"㢮\" title=\"㢮\" />放也郑玄注礼记曰<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06114.gif\" alt=\"㢮\" title=\"㢮\" />弃也此中经文含於多义故具存之)。","level":0},{"t":"无险诐故","level":0},{"t":"(已见苐四卷中)。","level":0},{"t":"身心憺怕","level":0},{"t":"(憺徒敢徒滥二反怕普白反王逸注楚辞曰憺安也广雅曰怕静也憺字又作淡澹二体也)。","level":0},{"t":"惯习","level":0},{"t":"(惯古患反案诸字书正冝作惯有作串字者[謵-白+尒]也)。","level":0},{"t":"痴[穀-(一/禾)+(夕*ㄗ)]","level":0},{"t":"([穀-(一/禾)+(夕<em>ㄗ)]苦角反有从[穀-(一/禾)+(夕</em>ㄗ)]下作夘者不是字也)。","level":0}],[{"t":"经卷第五十八","level":2},{"t":"离世闲品之六","level":0},{"t":"残毁","level":0},{"t":"(苍颉篇曰残伤也)。","level":0},{"t":"无中息","level":0},{"t":"(中陟仲反)。","level":0},{"t":"难处受生","level":0},{"t":"(难[邱-丘+(白-日+(丹-、+十))]干反难处谓八难中五也)。","level":0},{"t":"舍一切乌波涅[臊-品+巳]法","level":0},{"t":"(乌波此翻为有提云苦也谓二乘所得无餘涅[臊-品+巳]未离变易行苦随故有餘涅[臊-品+巳]反诸外道所计涅[臊-品+巳]并未离三苦故法即涅[臊-品+巳]或通教等於彼悉舍故云舍一切有苦涅[臊-品+巳]法)。","level":0},{"t":"乐法乐义以法为乐","level":0},{"t":"(此中三个乐字初二音五教反后一音郎各反)。","level":0},{"t":"如虹蜺色","level":0},{"t":"(虹古巷胡公二反蜺研奚反蔡雍月令曰虹䗖𬟽也谓阴阳交接之气而著之形色雄者曰虹雌者曰蜺者也)。","level":0},{"t":"无主无待","level":0},{"t":"([迄-乙+小]雅曰待湏也谓凢事相湏待藉於他也今此谓求缘无作即曰待义也)。","level":0},{"t":"无著无行","level":0},{"t":"(行遐庚反)。","level":0},{"t":"无有疮疣","level":0},{"t":"(疣有鸠反广雅疣肿也说文曰疣赘也赘谓賸聚肉也赘音支<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07536.gif\" alt=\"𨦣\" title=\"𨦣\" />反疣字又作肬也)。","level":0},{"t":"瘢痕","level":0},{"t":"(瘢蒱寒反痕户恩反)。","level":0},{"t":"解因自悟","level":0},{"t":"(因由也言辟支悟於苦无常等但用自观缘生克证不依师受故立其名为独觉也)。","level":0},{"t":"而强为说","level":0},{"t":"(强其两反)。","level":0},{"t":"志尚涅[臊-品+巳]","level":0},{"t":"(颜注汉书曰尚崇也)。","level":0},{"t":"求其罪舋","level":0},{"t":"(舋许觐反玉篇曰舋谓有祸兆也)。","level":0},{"t":"或以妙义授非其人","level":0},{"t":"(颜注萧望之传曰将非其人者言不才之才也谓有器量者也)。","level":0},{"t":"嚬蹙不喜","level":0},{"t":"(嚬脾仁反蹙子六反玉篇曰嚬蹙谓忧愁不乐之状也贾注国语曰频近也毛诗传曰蹙促也言人有忧愁则皱<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07955.gif\" alt=\"𢲻\" title=\"𢲻\" />眉额鼻目皆相促近也又案说文渡水向岸水文丛皱亦谓之嚬蹙然愁忧之频频下著卑今从省之不用也经本有吏安口者俗也)。","level":0},{"t":"伺其过失","level":0},{"t":"(伺相吏反郑玄注周礼曰伺犹察也玉篇曰伺侯也方言曰伺视也自关而北凢窃相视谓之伺也)。","level":0},{"t":"顽佷","level":0},{"t":"(佷何垦反左氏传曰心不测德义之经曰顽也杜注左传曰佷戾也说文曰佷不任从也佷字正体从彳今亻者俗也)。","level":0},{"t":"我[慢-(一/又)+万]所吞","level":0},{"t":"(吞他痕他贤反广雅广吞灭也)。","level":0},{"t":"醒悟","level":0},{"t":"(醒▆形桑迳二反)。","level":0},{"t":"天魔波旬","level":0},{"t":"(具云提婆魔罗播裨言提婆者此云天也摩罗障<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01002.gif\" alt=\"㝵\" title=\"㝵\" />也播裨罪<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />也谓此类生天宫性好劝人造<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />退善令不得出离故也)。","level":0},{"t":"悉知将有","level":0},{"t":"(广雅曰将欲也当也)。","level":0},{"t":"[徙-止+(光-儿)]置","level":0},{"t":"([徙-止+(光-儿)]仙紫反苍颉篇曰[徙-止+(光-儿)]移也郑玄注考工记云置犹著於地也置字本[徙-止+(光-儿)]<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02508.gif\" alt=\"𠕀\" title=\"𠕀\" />下直今従曰者俗也)。","level":0},{"t":"侍卫","level":0},{"t":"(苍颉篇曰侍従也毛诗传曰侍近也言侧近左右扶侍之也王弼注易曰卫护也)。","level":0}],[{"t":"经卷第五十九","level":2},{"t":"离世间品之七","level":0},{"t":"免济","level":0},{"t":"(免民辩反杜注左传曰免脱也毛诗传曰济渡也言令物脱苦渡难也)。","level":0},{"t":"欣慰","level":0},{"t":"(广雅曰欣喜也毛诗传曰慰安也言欢喜则心安也)。","level":0},{"t":"图书[郃-口+一]玺","level":0},{"t":"(郑玄注周礼曰图畫也玺[郃-口+一]也蔡雍独断曰天子之玺以螭虎劒古者尊卑共之日令秦以前诸侯卿大夫皆曰<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />自兹已降天子独称诸侯不敢用也秦王子婴上高祖传国玺文曰受命于天既寿永昌此[郃-口+一]章古名玺节今谓升捡文也螭音<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30072.gif\" alt=\"𠡠\" title=\"𠡠\" />支反)。","level":0},{"t":"弧矢劒<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02455.gif\" alt=\"㦸\" title=\"㦸\" />","level":0},{"t":"(弧户孤反矢式耳反<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02455.gif\" alt=\"㦸\" title=\"㦸\" />居逆反说文曰弧木曰弓考工记曰孤名弧谓徃多而来寡也易曰刾谓之矢矢即箭也<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02455.gif\" alt=\"㦸\" title=\"㦸\" />有三岐岐皆两刃或中有小子名雄<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02455.gif\" alt=\"㦸\" title=\"㦸\" />或有两<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21902.gif\" alt=\"𣥣\" title=\"𣥣\" />各偏<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02455.gif\" alt=\"㦸\" title=\"㦸\" />矢字又作<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08703.gif\" alt=\"𠂕\" title=\"𠂕\" />)。","level":0},{"t":"愽弈嬉戏","level":0},{"t":"(嬉许其反愽字正冝从竹说文曰簙谓戏为戏六薄十二棋也杜注左传曰弈围棋也切韵称嬉游也)。","level":0},{"t":"亲戚","level":0},{"t":"(戚千历反孔安注书曰戚近也<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />野王曰近所以为亲也毛诗传曰相亲曰戚戚字正冝从竖心也经本作戚者俗也)。","level":0},{"t":"能忍劬劳","level":0},{"t":"(劬具虞反毛诗传曰劬劳病苦也勤劬劳倦犹病苦也)。","level":0},{"t":"正法盈洽","level":0},{"t":"(洽侯夹反注左传曰盈充也玉篇洽濡也濡湿闰也)。","level":0},{"t":"菩萨无<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01002.gif\" alt=\"㝵\" title=\"㝵\" />乘巾之出三界","level":0},{"t":"(乘食证反乘谓车马通称巾谓服乘之名案周礼巾车氏即掌驾之官主当严乘故郑玄注云巾犹衣也衣音於记反谓<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />饰衣带之也珠丛曰以衣被车谓之巾也此则文言尚简名有影略故巾车之言当乘车之谓亦犹设席之名以目食客也)。","level":0},{"t":"宴然","level":0},{"t":"(宴於见反汉书音义曰宴安居也嘿静也)。","level":0},{"t":"晈镜","level":0},{"t":"(方言曰晈明也广雅曰镜照也又可晈然如镜故曰晈镜也)。","level":0},{"t":"驰逐","level":0},{"t":"(广雅曰驰奔也玉篇曰逐駈也)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07739.gif\" alt=\"𦴻\" title=\"𦴻\" />[卄/滔]花","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07739.gif\" alt=\"𦴻\" title=\"𦴻\" />胡感反[卄/滔]徒感反说文曰芙蓉花未发者盛之貌也<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07739.gif\" alt=\"𦴻\" title=\"𦴻\" />[卄/滔]二字玉篇作[卄/滔]兰字书作菡菌说文作莟[卄/滔]也)。","level":0},{"t":"娱乐","level":0},{"t":"(杜注左传曰娱乐也乐即可乐故七娱乐也)。","level":0}],[{"t":"经卷第六十","level":2}],[{"t":"入法界品第三十九之一","level":3},{"t":"室罗筏国","level":0},{"t":"(旧云舍卫国具称室罗筏悉底此翻为好道或曰闻物此乃城名非是国号以其城多出人物好行道德五天共闻故名闻物或曰室罗筏悉底者此云闻者城西域俗闻传记云昔於此处有一老仙修习仙道复有少仙从其受学厥号闻者老仙殁后少仙建立此城即以少仙之名为其城称然国都号为𱞽萨罗但以就胜易彰故城取国号耳)。","level":0},{"t":"逝多林","level":0},{"t":"(逝多梵言也或曰制多或云祇陁此翻为战胜即太子之名当欲造此寺时湏达长者买园太子出树故曰逝多林者也)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />藏菩萨","level":0},{"t":"(案此菩萨名<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />即是肚<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />之<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />字冝从肉也)。","level":0},{"t":"师子频申三昧","level":0},{"t":"(杜注左传曰频<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />名申展也谓申展四体之拘急所以解於劳倦故曰频申也表此三昧能申展自在无<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01002.gif\" alt=\"㝵\" title=\"㝵\" />法法界解脱障<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01002.gif\" alt=\"㝵\" title=\"㝵\" />拘急劳倦故喻名耳此或全是梵言也刊定记说)。","level":0},{"t":"危楼逈带","level":0},{"t":"(逈胡项反郑注礼记云危高也[迄-乙+小]雅曰逈远也言高楼险绝似空中之远卦者也)。","level":0},{"t":"栋宇","level":0},{"t":"(栋都弄反尓雅曰栋屋<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08211.gif\" alt=\"𬃡\" title=\"𬃡\" />也<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08211.gif\" alt=\"𬃡\" title=\"𬃡\" />即屋脊也字也<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08211.gif\" alt=\"𬃡\" title=\"𬃡\" />音於靳反)。","level":0},{"t":"阶墀轩㨫","level":0},{"t":"(墀直尼反玉篇曰阶谓登堂之道也说文曰墀谓以丹涂地即天子丹墀也韦昭注汉书曰轩㨫上板也王逸注楚辤曰㨫檀也纵曰㨫横曰楯<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />野王曰谓殿上拘栏也)。","level":0},{"t":"阶隥栏楯","level":0},{"t":"(撜多邓反楯食尹反隥级道也王逸注楚辞云纵曰栏撗曰楯楯间子谓之櫺也隥字又作嶝)。","level":0},{"t":"湍激洄澓","level":0},{"t":"(湍吐官反激古历反洄音回澓音服说文曰湍疾瀬也浅水流於砂上曰湍也水文疑邪急疾曰激也三苍曰水转洄也澓深也谓洄澓之处其水必深也)。","level":0},{"t":"芬敷","level":0},{"t":"(芬麸云反郭璞曰芬谓香气和调也小雅曰敷布散也)。","level":0},{"t":"舍利弗","level":0},{"t":"(具云奢唎补怛罗言奢唎者此云鹙鹭鸟也禄怛罗者此云子也此尊者母眼黑白分明转动流利似鹙鹭眼故时共号为奢唎也其尊者依母得名故云鹙鹭子旧翻为身子者[謵-白+尒]也梵本中呼身为设利罗故知悬别也)。","level":0},{"t":"大目<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00371.gif\" alt=\"𠃵\" title=\"𠃵\" />连","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00371.gif\" alt=\"𠃵\" title=\"𠃵\" />渠焉反目连者此云采[卄/(、廾、、、)]氏即此尊者母姓又以尊者有大神通即将二事为号也然母本族采绿豆仙之苗<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02370.gif\" alt=\"𮖭\" title=\"𮖭\" />也)。","level":0},{"t":"摩诃迦叶","level":0},{"t":"(具云摩诃迦叶波言摩诃此云大也迦叶波此云饮光也此尊者上古元祖是大仙人身有光明而能吞蔽灯火之光时人异之号曰饮光仙人因此标其氏族焉又以尊者有头陁大行故时与其大饮光名之耳)。","level":0},{"t":"离波多","level":0},{"t":"(此云所供养之也)。","level":0},{"t":"湏菩提","level":0},{"t":"(此云善现亦曰善实旧云善吉者非)。","level":0},{"t":"阿<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00145.gif\" alt=\"㝹\" title=\"㝹\" />楼<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00501.gif\" alt=\"䭾\" title=\"䭾\" />","level":0},{"t":"(正云阿泥噜多此云无灭)。","level":0},{"t":"难陁","level":0},{"t":"(此云欢喜也)。","level":0},{"t":"刧[實-毌+尸]<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />","level":0},{"t":"(此云黄色者谓此尊者上祖是黄头仙人因为族此则氏族为名耳)。","level":0},{"t":"迦旃延","level":0},{"t":"(迦旃者一宗之姓氏也延此云胤也言此尊者是彼种族之后胤耳)。","level":0},{"t":"富楼<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />","level":0},{"t":"(具云富楼<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />[弓<em>(乞-乙+小)]多罗尼子言富楼𨚗者此云满也[弓</em>(乞-乙+小)]多罗尼者此云愿也满愿是尊者母称子即尊者自身从母立名故曰满愿子也)。","level":0},{"t":"不能游履","level":0},{"t":"(履字本作属者[謵-白+尒]勘梵本是履也属委也属音之欲毛诗传曰游观案经义谓不能观都众会委听法音也)。","level":0},{"t":"举体燋然","level":0},{"t":"(刘兆注仪礼曰举毕尽也此言举体燋者遍体尽燋也)。","level":0},{"t":"乌鹫","level":0},{"t":"(郭璞注山海经曰鹫者鹫谓即雕也说文曰鹫鸟黑色而多子也)。","level":0},{"t":"瞖膜","level":0},{"t":"(瞖於计反文字集略曰瞖目障也经本有从羽作者非此所用也)。","level":0},{"t":"捕猎放牧","level":0},{"t":"(牧叵福莫六二反三苍曰牧养<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04424.gif\" alt=\"𩚅\" title=\"𩚅\" />也)。","level":0},{"t":"振<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00421.gif\" alt=\"䘏\" title=\"䘏\" />","level":0},{"t":"(振之刃反<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00421.gif\" alt=\"䘏\" title=\"䘏\" />湏聿反郑注礼曰振救也又注周礼曰<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00421.gif\" alt=\"䘏\" title=\"䘏\" />忧贫也又云忧恤从心<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00421.gif\" alt=\"䘏\" title=\"䘏\" />少从阝[迄-乙+小]雅通用今案诸书依说文从阝为胜)。","level":0},{"t":"均赡","level":0},{"t":"(均居春反赡市燄反小雅曰赡足也言均平皆使得足也)。","level":0},{"t":"举世","level":0},{"t":"(杜注左传曰举皆也言世皆不能测也)。","level":0},{"t":"孰有","level":0},{"t":"([迄-乙+小]雅曰孰谁也)。","level":0},{"t":"凢夫婴妄惑","level":0},{"t":"(广雅曰凢轻也案夫犹人夫婴绕也言轻庸之人为虚妄惑障緾绕也)。","level":0},{"t":"难称","level":0},{"t":"(称昌陵反郑注礼云称犹言也广雅曰称举也字正体从立人今多从禾)。","level":0},{"t":"钦叹","level":0},{"t":"(钦去今反孔安注书曰叹敬也)。","level":0},{"t":"晓悟","level":0},{"t":"(广雅曰晓说也说音书历反说文曰悟觉也声类曰悟解也言说化令觉也)。","level":0}],[{"t":"经卷第六十一","level":2},{"t":"入法界品之二","level":0},{"t":"因陁罗[絅-口+又]","level":0},{"t":"(因陁罗者此云帝也帝谓帝释[絅-口+又]谓帝释大衙殿上结珠之[絅-口+又]孔相望更为中表<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06171.gif\" alt=\"𮞏\" title=\"𮞏\" />相围绕之作主伴同时成就围绕相应也)。","level":0},{"t":"舟","level":0},{"t":"(章由反船也)。","level":0},{"t":"明练","level":0},{"t":"(珠丛曰镕金使精曰鍊煑丝令熟曰练也今谓善知仪式分明精熟故云明练也又李善注文选曰练简也谓简分明也)。","level":0},{"t":"君慧比丘","level":0},{"t":"(梵本中云因陁罗末底比丘言因陁罗者此云君也末底惠也言此比丘智惠比餘比丘最尊如君故曰君惠也)。","level":0}],[{"t":"经卷第六十二","level":2},{"t":"入法界品之三","level":0},{"t":"娑罗林","level":0},{"t":"(娑罗者此云高远以其林木森竦出於餘林之上也旧翻云坚固者误由娑罗之与娑罗声势相近若呼坚固即转舌言之若呼高远直尒称之耳)。","level":0},{"t":"湏达多","level":0},{"t":"(此云善给施无依怙者旧译云给孤独者是也)。","level":0},{"t":"婆湏达多","level":0},{"t":"(此云财施或云有善施行)。","level":0},{"t":"威光赫弈","level":0},{"t":"(赫许挌反弈移益反广雅曰赫赫威也弈弈明也赫字又作[烝-氶+卄]弈字经本亦下著廾者薄弈字也)。","level":0},{"t":"徽𬙊","level":0},{"t":"(徽许事反𬙊莫北反广雅曰徽束也珠丛曰𬙊绳索也案经义谓以爱绳束缚难可解也)。","level":0},{"t":"[轡-口+(匚@一)]勒","level":0},{"t":"([轡-口+(匚@一)]鄙媚反说文谓曰勒谓马头鏣衔)。","level":0},{"t":"𱞽盈","level":0},{"t":"(玉篇曰盈懈也缓也谓𱞽恣懈怠[慢-(一/又)+万]缓也)。","level":0},{"t":"令我载此乘","level":0},{"t":"(乘食证反王逸注楚辞曰载乘也乘音绳也)。","level":0},{"t":"茵蓐","level":0},{"t":"(茵於真反蓐如欲反毛诗传曰茵虎皮也玉篇曰以虎皮为蓐曰茵也茵字又作鞇郭注[迄-乙+小]雅曰蓐席也声类曰蓐荐也案茵蓐二字以草为之者字即从廿若以皮为之者字即从革其蓐字从衣者盖是通用也)。","level":0},{"t":"羁鞅","level":0},{"t":"(羁居冝反鞅於两反王逸注楚辞曰羁谓络马头也鞅谓靳牛颈绳也)。","level":0},{"t":"周挍","level":0},{"t":"(周帀<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />挍故言挍也)。","level":0},{"t":"四维","level":0},{"t":"(广雅曰维隅也隅即角也)。","level":0},{"t":"玩好之物","level":0},{"t":"(玩五<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01008.gif\" alt=\"𫨻\" title=\"𫨻\" />反孔安注书曰玩戏弄也谓戏弄之具)。","level":0},{"t":"等祐一切","level":0},{"t":"(郑注礼云等齐也周礼曰祐助也普皆齐等以福助之祐字古作佑阇二体也)。","level":0},{"t":"颇有","level":0},{"t":"(颇普歌反广雅曰颇少也少犹希也有呼颇音为叵者甚误)。","level":0},{"t":"因陁罗尼罗","level":0},{"t":"(因陁罗者此云帝也主也尼罗青也此宝青色宝中<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />尊苐一故曰青主也)。","level":0},{"t":"分敷布濩","level":0},{"t":"(濩音护颜注汉书曰布濩犹言布露谓於[卸-ㄗ+夬]露之处皆遍布也芬敷如上濩字经本从言作者[謵-白+尒]也)。","level":0},{"t":"辩析","level":0},{"t":"(扸苏历反汉书音义曰辩别也析分也析字有作扸者俗也)。","level":0},{"t":"深入法旋澓","level":0},{"t":"(旋徐挛切澓浮福反切韵称旋洄也三苍曰澓深也谓深水下有深穴则令水有洄澓也经本旋字从方者音徐缘反切韵称还也)。","level":0},{"t":"行至楞伽道","level":0},{"t":"(楞伽者具云楞求罗伽西域山名在南天笁南界近海岸也)。","level":0},{"t":"激电","level":0},{"t":"(激经历反说文曰激疾波也谓电光急速如波迅速也)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09400.gif\" alt=\"𠛴\" title=\"𠛴\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />罗婆牟呼栗多","level":0},{"t":"(仁王经云九百生灭为一<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09400.gif\" alt=\"𠛴\" title=\"𠛴\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />九十<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09400.gif\" alt=\"𠛴\" title=\"𠛴\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />为一念案俱舍论等谓时之<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />少名一<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09400.gif\" alt=\"𠛴\" title=\"𠛴\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />一百二十<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09400.gif\" alt=\"𠛴\" title=\"𠛴\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />名一怛<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09400.gif\" alt=\"𠛴\" title=\"𠛴\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />六十怛<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09400.gif\" alt=\"𠛴\" title=\"𠛴\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />名一罗婆三十罗婆名一牟呼栗多三十牟呼栗多为一昼夜也)。","level":0},{"t":"国名达利鼻荼","level":0},{"t":"(荼除加反其国在南印度境此翻为销谓此国人生无妄语出言成呪若隣国侵迫但共呪之令其灭亡如火销膏耳)。","level":0},{"t":"[弓*(乞-乙+小)]伽","level":0},{"t":"(此云能降伏或翻为昙也)。","level":0}],[{"t":"经卷第六十三","level":2},{"t":"入法界品之四","level":0},{"t":"市肆","level":0},{"t":"(崔豹古今注曰肆陈也谓陈[(夕*匕)/貝]鬻物)。","level":0},{"t":"善财言唯","level":0},{"t":"(唯营癸反孔安注书曰直晓不问曰唯也郑注礼曰唯恭於诺也谓诺然敬许)。","level":0},{"t":"遽即下","level":0},{"t":"(遽渠预反贾注国语曰遽疾也玉篇曰遽<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03871.gif\" alt=\"㥯\" title=\"㥯\" />也)。","level":0},{"t":"则为不断","level":0},{"t":"(为于危反广雅曰则即也为犹是也下诸问并准此)。","level":0},{"t":"菩萨为一切众生恃怙","level":0},{"t":"(恃时止反怙胡古反韩诗伝曰无父何恃恃负也无母何怙怙頼也案经义菩萨於众生如父母慈威兼济常为倚頼也)。","level":0},{"t":"长者","level":0},{"t":"(风俗通曰春秋之末郑有贤人著书一篇号郑长者谓年长德艾事长於人以之为长者故也)。","level":0},{"t":"涕泗悲泣","level":0},{"t":"(涕音体泗音四毛诗传曰自目曰涕自鼻曰泗也崔晧注汉纪曰泪下无声曰泣也)。","level":0},{"t":"拔犹预箭","level":0},{"t":"([迄-乙+小]雅曰犹狩名也其形似虎善登木性多疑虑常止山中忽闻有声恐人来<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10329.gif\" alt=\"𡧱\" title=\"𡧱\" />即豫上树久无方下须臾又上如此非一故时谓不决多猜虑者为犹豫焉或曰陇西时俗呼犬子为犹犬随人行喜预在先未至却此迎候因谓心所不决为犹豫也今案论中犹豫即是疑烦<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08974.gif\" alt=\"𢙉\" title=\"𢙉\" />摄而於善品不能进修故此湏拔者也)。","level":0},{"t":"坦荡自心","level":0},{"t":"(论语曰君子坦荡荡小人长戚戚郑玄曰坦荡宽广貌戚多忧惧也)。","level":0},{"t":"有一国土名摩利伽罗","level":0},{"t":"(未译也)。","level":0},{"t":"梵行之道","level":0},{"t":"(梵摩具云跋滥摩此云清净也又葛洪字苑云梵净也)。","level":0},{"t":"冲","level":0},{"t":"(昌容反)。","level":0},{"t":"优婆夷名<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09109.gif\" alt=\"𠇲\" title=\"𠇲\" />舍","level":0},{"t":"(休舍具云呼舍罗此云悕望亦曰意乐或曰满愿满众生希望意乐故也)。","level":0},{"t":"咨嗟恋慕","level":0},{"t":"(咨音諮孔安注书咨嗟也玉篇曰<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02386.gif\" alt=\"𭉊\" title=\"𭉊\" />嗟嗟叹也郑笺诗曰咨嗟叹美之深者)。","level":0},{"t":"想其容止","level":0},{"t":"(容谓容仪止谓行止)。","level":0}],[{"t":"经卷第六十四","level":2},{"t":"入法界品之五","level":0},{"t":"善知识者是我师傅","level":0},{"t":"(府遇反师傅者尚书云周官有三公三孤言三公者谓太师太傅太保师谓天子所师傅谓傅相天子保谓保安天子於德义此三公之位佐王论道以经缚国事如理阴阳有德行者乃堪之也三孤谓少师少傅少保孤特也言卑於三公尊於六卿特置少三人也玉篇曰傅犹於附如以脂粉涂附於面益乎姿质也今案所喻虽举师傅义通於保谓求道者得善友益己犹天子之有三公三孤佐弼之也)。","level":0},{"t":"毗卢遮<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />摩尼宝","level":0},{"t":"(此云光明遍照如意宝也)。","level":0},{"t":"凫[序-予+(鴈-厂)]","level":0},{"t":"(凫狭趺反似鸭而小谓之凫也)。","level":0},{"t":"俱抧罗鸟","level":0},{"t":"(抧经以反其鸟未译)。","level":0},{"t":"宝多罗树","level":0},{"t":"(多罗树者形如此方椶榈树其[葉-世+ㄊ]繁密此中然是胜宝所成也)。","level":0},{"t":"徐摇","level":0},{"t":"(徐缓也摇动也)。","level":0},{"t":"挟阁","level":0},{"t":"(挟弦颊反)。","level":0},{"t":"阿卢<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />香","level":0},{"t":"(阿卢<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />者此云赤色也)。","level":0},{"t":"挂","level":0},{"t":"(古卖反又作挂)。","level":0},{"t":"钏","level":0},{"t":"(昌恋反)。","level":0},{"t":"耳珰","level":0},{"t":"(珰得郎反释名云穿耳施珠曰当也)。","level":0},{"t":"婆楼<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />天佛","level":0},{"t":"(婆楼<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />者此云水也)。","level":0},{"t":"国土名<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />罗素","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />罗素者此云不<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04165.gif\" alt=\"嬾\" title=\"嬾\" />惰也)。","level":0},{"t":"仙人名毗目瞿沙","level":0},{"t":"(毗目瞿沙具云毗沙摩乌多罗菩提瞿娑言毗沙摩者此云无怖畏也乌多罗者<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />上也菩提瞿娑者出声也)。","level":0},{"t":"鲜荣","level":0},{"t":"(鲜新然反玉篇曰鲜是明也释名曰荣犹荣荣然照明之<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15032.gif\" alt=\"㒵\" title=\"㒵\" />也)。","level":0},{"t":"波咤罗树","level":0},{"t":"(其树正似此方楸树也然甚有香气其花紫色也)。","level":0},{"t":"尼拘律树","level":0},{"t":"(其树[葉-世+ㄊ]如此方柹[葉-世+ㄊ]子似枇杷子子承蒂如柿然其种类耐老诸树中<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />能高大)。","level":0},{"t":"领徒一[一/力]","level":0},{"t":"(孔安注书曰徒众也司马彪注<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />子曰徒谓弟子也)。","level":0},{"t":"编草","level":0},{"t":"(编蒱典反仓颉篇曰编织珠丛曰取物交织谓之编也字又作辫也)。","level":0},{"t":"髻环垂[肆-聿+((彰-章)/(實-毌+尸))]","level":0},{"t":"([肆-聿+((彰-章)/(實-毌+尸))]环谓盘髻如环垂环至[肆-聿+((彰-章)/(實-毌+尸))]故云也)。","level":0},{"t":"夷险道","level":0},{"t":"(孔安注书曰夷平也方言曰险高也)。","level":0},{"t":"险易","level":0},{"t":"(易羊豉反玉篇曰险难也郭璞注[迄-乙+小]雅曰易平也言道路或险或平)。","level":0},{"t":"阿<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12777.gif\" alt=\"𢈔\" title=\"𢈔\" />多","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12777.gif\" alt=\"𢈔\" title=\"𢈔\" />逾主反阿<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12777.gif\" alt=\"𢈔\" title=\"𢈔\" />多者当此方一兆之名也)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />由他","level":0},{"t":"(或曰<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12777.gif\" alt=\"𢈔\" title=\"𢈔\" />多当此方一亿名也)。","level":0},{"t":"聚落名伊沙<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />","level":0},{"t":"(伊沙<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />者此云长直也)。","level":0},{"t":"离诸难难","level":0},{"t":"(上难字<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />轮反谓八难也下难字者<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />乾反谓艰难之也)。","level":0},{"t":"伊<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />跋罗龙王","level":0},{"t":"(伊罗者树名此云臭气也跋罗此云极也谓此龙徃昔由[損-口+ㄙ]此极臭树[葉-世+ㄊ]故致头上生此臭也因即以为名耳)。","level":0},{"t":"难陁优波难陁","level":0},{"t":"(难陁此云欢喜也优波此云近也)。","level":0}],[{"t":"经卷第六十五","level":2},{"t":"入法界品之六","level":0},{"t":"[辰/肉]口丹絜如频婆果","level":0},{"t":"(丹赤也絜净也频婆果者其果似此方林檎极鲜明赤也)。","level":0},{"t":"於河渚中","level":0},{"t":"(渚支与反[迄-乙+小]雅曰水中可居者曰洲小洲曰渚小渚曰沚小沚曰坻人所居者曰潏沚音止坻音迟潏字决述二音)。","level":0},{"t":"商估","level":0},{"t":"(估公户郑注周礼曰行卖曰商坐卖曰估估字又作贾也)。","level":0},{"t":"贮","level":0},{"t":"(张吕反)。","level":0},{"t":"福德渊","level":0},{"t":"(渊乌玄反说文曰水洄曰渊毛诗传曰渊深也今谓福德深奥也)。","level":0},{"t":"挍饰","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />挍为饰故云挍饰也)。","level":0},{"t":"鹅王羽翮","level":0},{"t":"(翮茎隔反珠藂曰翮谓鸟羽之本也)。","level":0},{"t":"憩止","level":0},{"t":"(憩去例反珠藂曰憩息也)。","level":0},{"t":"禀善知识","level":0},{"t":"(禀彼锦反孔安注书曰禀受也字从米禀声古文作禀也)。","level":0},{"t":"靡不周瞻","level":0},{"t":"(瞻市熖反珠藂曰靡无也贾注国语曰周俻也汉书音义曰赡足也)。","level":0}],[{"t":"经卷第六十六","level":2},{"t":"入法界品之七","level":0},{"t":"游福德海","level":0},{"t":"(游似由以周二反说文曰浮於水上也今以喻言尓)。","level":0},{"t":"遽即徃[詣-匕+二]","level":0},{"t":"(遽渠预反贾注国语曰遽疾也玉篇曰遽急也)。","level":0},{"t":"何缘致此清净众会","level":0},{"t":"(致陟利反颜注汉书曰致谓引而至之也)。","level":0},{"t":"不惮","level":0},{"t":"(惮唐翰反郑笺诗曰惮难也谓忌难艰辛也难音<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />轮反)。","level":0},{"t":"雉揲崇峻","level":0},{"t":"(雉直尓反揲徒恊反公羊传曰五板为堵五堵为雉百雉为城何休注曰二万尺也周十一里三十三步二尺公侯之制也礼记云天子十雉盖受雉之城千百七十雉子男五十雉天子周城诸侯千城千城者[(垂-┴+山)*夬]其南面以受过也杜注左传曰堞女墙也崇高也揲字又作堞也)。","level":0},{"t":"风黄淡热","level":0},{"t":"(文字集略曰淡谓胷中液也骞师注方言曰淡字又作痰也)。","level":0},{"t":"辛头波罗香","level":0},{"t":"(辛头者河名也谓即阿耨达池西面金牛口出水流入信度国者是也波罗云岸也谓其香生彼河岸故以出处为名耳)。","level":0},{"t":"阿卢<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />跋底香","level":0},{"t":"(阿卢<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />卢此云赤色也跋底者有也或云极也谓此香极有赤色堪以练绯色甚鲜明故因名耳)。","level":0},{"t":"乌洛迦旃檀香","level":0},{"t":"(乌洛迦者西域虵名其虵常患毒热据此香树以身绕之毒热便息故因名也或曰此虵<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />毒螫人必死唯以旃檀能治故以为名耳)。","level":0},{"t":"城名多罗幢","level":0},{"t":"(多罗者义翻为明净谓如星之明净或曰精等明净也谓昔有王名明净眼幢创建此城故从之立名耳)。","level":0},{"t":"怡畅心","level":0},{"t":"(怡与脂反毛诗传曰怡恱也汉书传曰畅通也)。","level":0},{"t":"抚其孤弱","level":0},{"t":"(抚麸禹反汉书集注曰抚慰也郑注周礼曰抚安也杜注左传曰抚恤也)。","level":0},{"t":"阿<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />罗王","level":0},{"t":"(此云无猒足也或曰普可畏声言其王可畏声名普遍诸国也)。","level":0},{"t":"以为其<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />字冝从肉经本有作齐者[謵-白+尒]也)。","level":0},{"t":"十万猛卒","level":0},{"t":"(卒作没反方言曰南楚东海之闲呼[(上/天)*(企-止+米)]人给事者谓之卒也)。","level":0},{"t":"褊","level":0},{"t":"(方缅反字冝从衣作)。","level":0},{"t":"攘[辟-口+月]瞋目","level":0},{"t":"(攘如羊反孟子曰[辟-口+月]而下车<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />野王曰攘谓除去衣袂而出[辟-口+月]也袂音[弓*(乞-乙+小)]励反袖也)。","level":0},{"t":"挑","level":0},{"t":"(天雕反)。","level":0},{"t":"曾不<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />惧","level":0},{"t":"(广雅曰<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />眷也言不眷恋身命怖惧死也)。","level":0},{"t":"命之同坐","level":0},{"t":"(广雅曰命呼也)。","level":0},{"t":"承<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08073.gif\" alt=\"𣅀\" title=\"𣅀\" />","level":0},{"t":"(玉篇曰<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08073.gif\" alt=\"𣅀\" title=\"𣅀\" />意也)。","level":0},{"t":"富赡断其所作","level":0},{"t":"(断都管反说文曰断截也安注书曰断绝也)。","level":0},{"t":"靡不该练","level":0},{"t":"(珠藂曰靡无也广雅曰该咸也包也小雅曰该俻也珠丛曰镕金曰鍊煑丝令熟曰练也该字又作<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07202.gif\" alt=\"䀭\" title=\"䀭\" />练字镕金从金煑丝或从散水也)。","level":0},{"t":"伊罗婆拏大象王","level":0},{"t":"(伊罗谓伊陁罗即帝释名也婆拏云出声也言此大象时出美声娱乐帝释也或曰伊谓能出也罗婆拏声也娱乐如前说也)。","level":0},{"t":"修[辟-口+月]","level":0},{"t":"(毛诗传曰修长也案玉篇修饰修长字昔从彡唯修脯字从肉也)。","level":0},{"t":"如渔","level":0},{"t":"(渔御居疑据二反说文曰渔捕鱼也字又作<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09436.gif\" alt=\"𩼪\" title=\"𩼪\" />[敲-高+(虎-儿+魚)][敲-高+魚]三形者也)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00238.gif\" alt=\"㧌\" title=\"㧌\" />动","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00238.gif\" alt=\"㧌\" title=\"㧌\" />呼高反揽也)。","level":0},{"t":"城名无量都萨罗","level":0},{"t":"(都萨罗者都谓都罗此云喜也萨罗者此云出生也言此城中出生无量欢喜之事故名之)。","level":0}],[{"t":"经卷第六十七","level":2},{"t":"入法界品之八","level":0},{"t":"廛店隣里","level":0},{"t":"(廛除连反郑注礼曰廛谓市物<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01056.gif\" alt=\"𨚎\" title=\"𨚎\" />舍也谓停估客坊<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01056.gif\" alt=\"𨚎\" title=\"𨚎\" />尚书大传曰八家为隣三隣为明三明为里五里为邑此虞夏之制也廛字经本从厂作者[謵-白+尒]也)。","level":0},{"t":"岩巚","level":0},{"t":"(巚鱼偃反说文曰岩峰也郭璞注[迄-乙+小]雅曰岩谓山形如累重甑也字或作囐也)。","level":0},{"t":"鬻香","level":0},{"t":"(鬻与六反玉篇曰鬻卖也卖鬻从每羹鬻从米)。","level":0},{"t":"摩罗耶山","level":0},{"t":"(具云摩利伽罗耶其山在南天竺境摩利伽罗耶国南界而因国以主山名其山中多出白栴檀木)。","level":0},{"t":"香名先陁婆","level":0},{"t":"(先陁罗此云石塩其香似之故以名之耳)。","level":0},{"t":"舩师名婆施罗","level":0},{"t":"(此翻为自在也)。","level":0},{"t":"部多宫","level":0},{"t":"(部多此云自生谓此类从父母生者名夜叉化生者名部多也)。","level":0},{"t":"晨脯","level":0},{"t":"(尓雅曰晨早也玉篇曰脯加申也)。","level":0},{"t":"晷漏延促","level":0},{"t":"(晷音<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12017.gif\" alt=\"䡄\" title=\"䡄\" />李善注文选曰晷漏曰影也细分晷与漏别故周礼云表长八尺夏至曰晷长六寸日益南晷益长也文字集略曰漏刻谓以筒受水刻节昼夜百刻也)。","level":0},{"t":"理断","level":0},{"t":"(断都乱反郑注礼记曰断决也)。","level":0},{"t":"良久","level":0},{"t":"(玉篇曰良由长也长对於促非𫏐时也)。","level":0},{"t":"国名输<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />","level":0},{"t":"(输音冝借上声呼正曰输罗此翻为勇猛也)。","level":0},{"t":"城名迦陵迦林","level":0},{"t":"(以义翻之名相闘诤时此据因闘诤建国立名也)。","level":0},{"t":"波利质多罗树","level":0},{"t":"(具云波利耶怛罗拘陁罗此云香遍树谓此树根茎枝[葉-世+ㄊ]花实皆香能遍熏忉利天宫)。","level":0},{"t":"迦隣陁衣","level":0},{"t":"(细绵衣也)。","level":0},{"t":"迫窄","level":0},{"t":"(窄侧格反玉篇曰迫犹逼也广曰迫狭也窄隘也窄字经作迮者俗也)。","level":0},{"t":"婆楼<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />天","level":0},{"t":"(此云水天也)。","level":0},{"t":"良[泛-之+犮]田","level":0},{"t":"(良善也颜注汉书曰[泛-之+犮]溉灌也言其土地有溉灌利者也)。","level":0},{"t":"庵罗林","level":0},{"t":"(庵罗果名状貌似此土<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00178.gif\" alt=\"㮈\" title=\"㮈\" />其味如梨也)。","level":0},{"t":"波湏蜜多","level":0},{"t":"(此云世友亦曰天友或云宝亦曰财也)。","level":0}],[{"t":"经卷第六十八","level":2},{"t":"入法界品之九","level":0},{"t":"唇吻","level":0},{"t":"(吻无粉反苍颉玉篇曰吻谓唇两角头边也)。","level":0},{"t":"𰸒彼门阃","level":0},{"t":"(𰸒徒到反阃苦本反说文曰𰸒蹋也阃门限也阃字又作捆也)。","level":0},{"t":"居士名鞞瑟<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10325.gif\" alt=\"𦙘\" title=\"𦙘\" />罗","level":0},{"t":"(此翻为緾裹也或曰包摄谓现广大身可以含容国土也<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10325.gif\" alt=\"𦙘\" title=\"𦙘\" />字上声呼之)。","level":0},{"t":"[弓*(乞-乙+小)]勒","level":0},{"t":"(具云昧怛<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01233.gif\" alt=\"𭌆\" title=\"𭌆\" />曳此翻为慈氏也)。","level":0},{"t":"山名补怛洛迦","level":0},{"t":"(此翻为小花树山谓此山中多有小白花树其花甚香香气远及也)。","level":0},{"t":"泉流萦映","level":0},{"t":"(萦於营反珠藂曰荣卷之也字指曰映不明也案经意言泉流交络互相緾互相隐映故曰萦映也映字经本有作月边英者盖是胷臆)。","level":0},{"t":"树林蓊<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17632.gif\" alt=\"𬅕\" title=\"𬅕\" />","level":0},{"t":"(蓊乌孔反玉篇曰蓊<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17632.gif\" alt=\"𬅕\" title=\"𬅕\" />草木茂盛也蓊字汉书相如传从竹下翁也)。","level":0},{"t":"迁移","level":0},{"t":"(迁七延反郑注礼曰迁犹变改毛诗传曰迁犹去也)。","level":0},{"t":"城名堕罗钵底","level":0},{"t":"(此翻为门主或曰有门谓古者建立此城王之号也)。","level":0},{"t":"[穀-(一/禾)+(夕*ㄗ)]","level":0},{"t":"(苦角反经本有作[穀-(一/禾)+(夕*ㄗ)]者无不是字之也)。","level":0},{"t":"迦毗罗城","level":0},{"t":"(具云迦比罗皤窣都言迦比罗者此云黄色也皤窣都者所依处也谓上古有黄头仙人依此处修道故因名耳)。","level":0},{"t":"夜神婆[狦-(狂-王)+王]婆演底","level":0},{"t":"(具云婆伞多婆演底言婆伞多婆演底言婆伞多者此云春也婆演底主当也谓於春时此神主当守护众生及诸苗稼也或曰婆罗婆萨<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />此云依止无畏谓与众生作依止处令离怖畏又中天笁本云跋僧多云春主谓能生物善故借喻名耳)。","level":0},{"t":"伫立未久","level":0},{"t":"(伫除吕反李善注文选云伫立<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15032.gif\" alt=\"㒵\" title=\"㒵\" />也郭璞注尓雅曰伫企也谓举足竦望有所敬侍也)。","level":0},{"t":"方隅","level":0},{"t":"(隅语俱反郑玄注考工记曰隅角也方谓四方隅谓四维也)。","level":0},{"t":"慞惶","level":0},{"t":"(慞诸羊反切韵称慞惧也三仓曰惶恐也)。","level":0},{"t":"为作灵药","level":0},{"t":"(灵谓神灵也)。","level":0},{"t":"藤罗所[(ㄇ@(企-止))/ㄙ/月]","level":0},{"t":"(藤但登反[(ㄇ@(企-止))/ㄙ/月]古泫反切韵称卦也藤性缘物自织成罗也)。","level":0},{"t":"欲度沟洫","level":0},{"t":"(沟古侯反洫许域反苞氏注论语曰方里为井井闲有沟沟深四尺十里为城城闲有洫洫广深八尺之也)。","level":0},{"t":"令诸世事悉得宣叙","level":0},{"t":"(小雅曰宣示也说文曰叙次第也言显示得其次第也)。","level":0},{"t":"盗塔寺物","level":0},{"t":"(塔具云窣堵波谓置佛舍利处也寺名依梵本中呼为鞞诃罗此云游谓众生共游止之所也三苍曰寺馆舍也馆舍与游义称相近耳又风俗通曰寺司也匡之有法度者也今诸侯所止皆曰寺也释名曰寺嗣也治事者相継嗣於内也今若以义立名则佛弟子助佛扬化住持正法同后三说若直据梵本[敲-高+(嫡-女)]对而翻则如初释也)。","level":0},{"t":"夜久眠<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00895.gif\" alt=\"𥧌\" title=\"𥧌\" />","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00895.gif\" alt=\"𥧌\" title=\"𥧌\" />[弓*(乞-乙+小)]利反毛诗传曰<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00895.gif\" alt=\"𥧌\" title=\"𥧌\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/05/CB05903.gif\" alt=\"𥨊\" title=\"𥨊\" />也三篇曰<img class=\"gaiji\" src=\"asset://gaiji-CB/05/CB05903.gif\" alt=\"𥨊\" title=\"𥨊\" />谓偃卧熟也)。","level":0},{"t":"劝喻","level":0},{"t":"(仓颉篇曰喻谏)。","level":0}],[{"t":"经卷第六十九","level":2},{"t":"入法界品之十","level":0},{"t":"遽发是念","level":0},{"t":"(遽渠虑反玉篇曰遽急也)。","level":0},{"t":"被大精进甲","level":0},{"t":"(被皮义反)。","level":0},{"t":"悉苦无味","level":0},{"t":"(味犹乐也言皆是苦无可乐恋)。","level":0},{"t":"捶","level":0},{"t":"(之蘂反说文曰捶杖击也案捶守说文从手玉篇从木声类从竹耳)。","level":0},{"t":"其心泰然","level":0},{"t":"(珠藂曰泰通也凢离忧塞者心则通畅耳)。","level":0},{"t":"为现不乐世闲欲乐","level":0},{"t":"(上乐字五教反下乐字郎各反)。","level":0},{"t":"婴妄想","level":0},{"t":"(汉书集注曰婴绕也加也言为妄想之所緾绕也)。","level":0},{"t":"得此解脱其已久如","level":0},{"t":"(久谓久近如何故维摩观众生品云舍利弗问天曰天止此室其已久如荅曰如耆年解脱舍利弗言止此久耶天曰耆年解脱亦何如久今准此文如即是久近如何之问辞也)。","level":0},{"t":"嫔御有十亿","level":0},{"t":"(嫔婢人反贾注国语曰妾御曰嫔毛诗传曰嫔妇也郑注礼云嫔谓妇人有法度者之称也周礼有九嫔教九御蔡雍曰天子凡衣服加於身饮食入於口妃妾接以寝皆曰御御之所亲爱则曰幸之也)。","level":0},{"t":"我时寻觉","level":0},{"t":"(杜注左传曰寻续也)。","level":0},{"t":"金刚<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />佛","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />字从肉)。","level":0}],[{"t":"经卷第七十","level":2},{"t":"入法界品之十一","level":0},{"t":"不藉耕耘而生稻梁","level":0},{"t":"(耘于君反梁吕羊反毛诗传曰耘除草也说文曰梁米名也耘字经本作芸者乃是芸薹菜字非此所用梁字或亦从禾也)。","level":0},{"t":"良臣猛将","level":0},{"t":"(将即亮反谥法曰小心敬事曰良顺理习善曰良今谓止私存国良臣谋而后勇曰猛将也)。","level":0},{"t":"中[乏-之+犮]","level":0},{"t":"(中张仲反於矫反孔安注书曰小[〦/(口*口)/(┌/┌/一)]曰夭也)。","level":0},{"t":"陵蔑他人","level":0},{"t":"(蔑莫结反苍颉篇曰陵侵也玉篇曰陵慢也郑牋诗曰蔑轻也陵字说文单作麦又有从心作者俗通用也)。","level":0},{"t":"众景夺曜","level":0},{"t":"(说文曰景光也曜字又从光也)。","level":0},{"t":"大臣辅佐","level":0},{"t":"(佐臧个反郑注礼曰辅助也佐副也言臣之於君有副助变理之用)。","level":0},{"t":"无高倨心","level":0},{"t":"(倨居御反杜注左传曰倨[慢-(一/又)+万]郑注礼曰倨不敬也)。","level":0}],[{"t":"经卷第七十一","level":2},{"t":"入法界品之十二","level":0},{"t":"受种种如来命","level":0},{"t":"(郑笺诗曰命教令也)。","level":0},{"t":"高七多罗树","level":0},{"t":"(多罗树似此方椶榈树然西域者其高例十丈餘故经中<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />为定量)。","level":0},{"t":"波头摩花","level":0},{"t":"(或曰钵蹋忙此翻为赤莲花)。","level":0},{"t":"觉悟","level":0},{"t":"(觉古皂反字又作寤)。","level":0}],[{"t":"经卷第七十二","level":2},{"t":"入法界之十三","level":0},{"t":"莲花覆合","level":0},{"t":"(覆抚目反还也复也)。","level":0},{"t":"罢游观时","level":0},{"t":"(罢蒱解反玉篇曰罢止也休也)。","level":0},{"t":"杵破","level":0},{"t":"(杵昌与反打也字冝从手其掊杵字从木也)。","level":0},{"t":"苗稼不登","level":0},{"t":"(马融注论语曰树五谷曰稼也小雅曰登升也谓谷<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15756.gif\" alt=\"𠬧\" title=\"𠬧\" />则可升塲耳)。","level":0},{"t":"枯槁","level":0},{"t":"(槁苦老反说文曰槁木枯也郑玄注周礼曰槁木乾也槁正冝作槀其<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21911.gif\" alt=\"𣝩\" title=\"𣝩\" />音苦到反杜注左传槁乃劳义非经所用也)。","level":0},{"t":"衣裳弊<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />","level":0},{"t":"(弊毗例反说文曰衣败为弊玉篇曰蔽与敝同杜注左传曰敝衰坏也)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01899.gif\" alt=\"𭽫\" title=\"𭽫\" />裂","level":0},{"t":"(上七伦反下力哲反)。","level":0},{"t":"床搨","level":0},{"t":"(搨他盍反)。","level":0},{"t":"仁慈孝友","level":0},{"t":"(释名曰仁忍也好生<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />煞善<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />含忍也[迄-乙+小]雅曰善事父母为孝善事兄弟为友也)。","level":0},{"t":"瞻奉抚对","level":0},{"t":"(抚芳武反瞻视也奉承也汉书集注曰抚慰也恤也对谓抵对也)。","level":0},{"t":"婬佚","level":0},{"t":"(佚夷曰反仓颉篇曰佚畅也乐也愓音荡)。","level":0},{"t":"枯涸","level":0},{"t":"(涸何各反广疋曰涸尽也)。","level":0},{"t":"油云被八方","level":0},{"t":"(孟子曰天油然兴云沛然下雨则苗浡然而长也毛诗音义曰油云春云也言能润泽万物也)。","level":0},{"t":"大王临庶品","level":0},{"t":"(郑玄注周礼曰临谓尊适卑也贾注国语曰临治也治谓治理也庶众也品类也)。","level":0},{"t":"暴虐","level":0},{"t":"(暴蒲报反玉篇曰暴陵犯也虐灾也)。","level":0},{"t":"刑狱皆止措","level":0},{"t":"(措仓固反郑玄注考工记曰措犹顿也置也置谓废之也)。","level":0},{"t":"残<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10329.gif\" alt=\"𡧱\" title=\"𡧱\" />","level":0},{"t":"(颜注汉书曰残谓多所煞[戮-(彰-章)+小]也仓颉篇曰残伤也切也)。","level":0},{"t":"犬豚","level":0},{"t":"(豚徒<img class=\"gaiji\" src=\"asset://gaiji-CB/05/CB05943.gif\" alt=\"䰟\" title=\"䰟\" />反方言曰豚豕子也)。","level":0},{"t":"佥然备","level":0},{"t":"(佥七廉反[迄-乙+小]雅曰佥皆也小雅曰佥同也俻具也)。","level":0},{"t":"入池自抚鞠","level":0},{"t":"(鞠居六反王逸注楚辤曰抚持也鞠谓<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07955.gif\" alt=\"𢲻\" title=\"𢲻\" />之也<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07955.gif\" alt=\"𢲻\" title=\"𢲻\" />音[色-巴+(鹿-比+(ㄙ*ㄙ))]括反鞠字正冝从手)。","level":0},{"t":"夜叉","level":0},{"t":"(此云祠祭鬼谓俗闲祠祭以求恩福者也旧翻捷疾鬼之也)。","level":0},{"t":"毗舍阇","level":0},{"t":"(此云噉人精气鬼也)。","level":0},{"t":"中霄","level":0},{"t":"(中张仲反霄相遥反霄夜)。","level":0}],[{"t":"经卷第七十三","level":2},{"t":"入法界品之十四","level":0},{"t":"宿植","level":0},{"t":"(植承力反仓颉篇曰植种也)。","level":0},{"t":"囹圄","level":0},{"t":"(囹历丁反圄鱼举反郑注礼曰囹圄所以禁守系者若今之刑狱也说文曰囹圄谓之狱名也)。","level":0},{"t":"榜笞","level":0},{"t":"(榜普庚反笞<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30072.gif\" alt=\"𠡠\" title=\"𠡠\" />之反字书曰榜捶也说文曰笞击也榜字冝从手)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04372.gif\" alt=\"𬛜\" title=\"𬛜\" />割","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04372.gif\" alt=\"𬛜\" title=\"𬛜\" />蒲忍扶忍二反大戴礼曰人生暮而<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04372.gif\" alt=\"𬛜\" title=\"𬛜\" />生然后行也说文曰<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04372.gif\" alt=\"𬛜\" title=\"𬛜\" />膝骨也尚书大传曰决关梁逾城郭而略盗者其刑<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04372.gif\" alt=\"𬛜\" title=\"𬛜\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />野王曰谓断足之刑即吕刑之<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04685.gif\" alt=\"䠊\" title=\"䠊\" />周礼之则类也字从骨经本月作作者俗也)。","level":0},{"t":"宽宥","level":0},{"t":"(宥云救反杜注左传曰宥赦也)。","level":0},{"t":"盗入宫闱","level":0},{"t":"(闱于归反尓雅曰宫中门谓之闱其小者曰闺小闺曰合也)。","level":0},{"t":"王之宝祚","level":0},{"t":"(祚字故反宝谓大宝书曰大宝曰位玉篇曰祚位也)。","level":0},{"t":"赫然大怒","level":0},{"t":"(郑牋诗曰赫然怒<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15032.gif\" alt=\"㒵\" title=\"㒵\" />也毛诗传曰赫赤也谓人大怒则面色赤也)。","level":0},{"t":"毁形降服","level":0},{"t":"(降古巷反[迄-乙+小]雅曰降下也谓下其好服又可著下<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />衣服故也)。","level":0},{"t":"拘留孙","level":0},{"t":"(具云羯罗迦寸地此云所应断已断或障已断也)。","level":0},{"t":"萨遮尼乹","level":0},{"t":"(萨遮此云有也尼乹者云尼乹连陁言尼者不也乹连陁系也谓此类外道躶形自饿以为少欲不为衣食所系故也)。","level":0},{"t":"御群生","level":0},{"t":"(孔安注书曰御治也谓治理之也郑注礼云御劝也谓劝化之也)。","level":0},{"t":"园林名岚毗尼","level":0},{"t":"(岚卢含反或曰流[弓*(乞-乙+小)]尼此云乐胜圆光是昔天女之名因来此处遂以其处名耳)。","level":0}],[{"t":"经卷第七十四","level":2},{"t":"入法界品之十五","level":0},{"t":"被求一切智坚誓甲","level":0},{"t":"(被皮义反著也)。","level":0},{"t":"传来","level":0},{"t":"(传除缘反字从叀不从甫)。","level":0},{"t":"果从兜率","level":0},{"t":"(玉篇曰果遂也定也)。","level":0},{"t":"坈坎塠阜","level":0},{"t":"(坎口揽反塠都回反阜扶九反易曰坎陷也王逸注楚辞曰塠高土也[迄-乙+小]雅曰高平曰陆大陆曰阜塠字又作堆耳)。","level":0},{"t":"瓦砾荆<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00331.gif\" alt=\"𣗥\" title=\"𣗥\" />株杌","level":0},{"t":"(砾零击反说文曰小石曰砾也荆<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00331.gif\" alt=\"𣗥\" title=\"𣗥\" />草秽通语也说文曰株树根也杌谓<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02625.gif\" alt=\"𭃞\" title=\"𭃞\" />去枝柯者也)。","level":0},{"t":"毕洛叉树","level":0},{"t":"(或曰毕利又此云高显谓佛於降诞则为高胜名显人天故曰高显也或有处云佛於阿戍迦树下生者也)。","level":0},{"t":"诸佛<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />中","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />字从肉)。","level":0},{"t":"释女瞿波","level":0},{"t":"(瞿波或曰瞿夷此翻为守护地也)。","level":0}]]