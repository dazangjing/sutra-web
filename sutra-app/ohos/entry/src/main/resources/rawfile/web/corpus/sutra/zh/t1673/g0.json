[[{"t":"No. 1673 [Nos. 1672, 1674]劝发诸王要偈","level":0},{"t":"龙树菩萨撰","level":0},{"t":"宋天竺三藏僧伽跋摩译","level":0},{"t":"明胜功德王，我无餘求想，","level":0,"quote":true},{"t":"诸佛所说法，庄严要何义，","level":0,"quote":true},{"t":"略撰贤圣颂，大王所宜闻。","level":0,"quote":true},{"t":"如以众杂木，造立如来像，","level":0,"quote":true},{"t":"智者恭敬礼，依佛故尊视。","level":0,"quote":true},{"t":"我今以非辩，光宣真实藏，","level":0,"quote":true},{"t":"慧者应信乐，依法听所述。","level":0,"quote":true},{"t":"大王虽数闻，如来梵音说，","level":0,"quote":true},{"t":"胜悟由多闻，屡闻则深信，","level":0,"quote":true},{"t":"如日照素质，岂不增其鲜。","level":0,"quote":true},{"t":"三宝施戒天，最胜说六念，","level":0,"quote":true},{"t":"随顺诸功德，如实善观察。","level":0,"quote":true},{"t":"身口意常行，清净十业道，","level":0,"quote":true},{"t":"远酒不醉乱，离邪修正命。","level":0,"quote":true},{"t":"知财五家分，无常不牢固，","level":0,"quote":true},{"t":"惠施诸有德，贫苦及亲属。","level":0,"quote":true},{"t":"所生常随逐，布施为最胜，","level":0,"quote":true},{"t":"不断亦不灭，不离不望果。","level":0,"quote":true},{"t":"如是诸净戒，宜应善受持，","level":0,"quote":true},{"t":"是则为良田，生诸功德故，","level":0,"quote":true},{"t":"施戒忍精进，禅定无量慧，","level":0,"quote":true},{"t":"是诸波罗蜜，慧者当修习，","level":0,"quote":true},{"t":"能度三有海，逮得牟尼尊。","level":0,"quote":true},{"t":"若人孝父母，至心尽供养，","level":0,"quote":true},{"t":"是名礼教门，清净天胜族，","level":0,"quote":true},{"t":"名闻远流布，舍身生天上。","level":0,"quote":true},{"t":"离杀盗婬欺，饮酒及三枝，","level":0,"quote":true},{"t":"成就八分斋，随顺诸佛学，","level":0,"quote":true},{"t":"舍身生六天，所欲悉随意。","level":0,"quote":true},{"t":"悭谄幻伪慢，懈怠贪恚痴，","level":0,"quote":true},{"t":"族姓好容色，少壮多闻乐，","level":0,"quote":true},{"t":"如是诸迷惑，当视如怨家。","level":0,"quote":true},{"t":"若修不放逸，是则不死路，","level":0,"quote":true},{"t":"放逸为死径，世尊之所说，","level":0,"quote":true},{"t":"为增善法故，当修不放逸。","level":0,"quote":true},{"t":"若人先为恶，后能不放逸，","level":0,"quote":true},{"t":"是则照世间，云除月光显。","level":0,"quote":true},{"t":"忍辱无与等，不随瞋恚心，","level":0,"quote":true},{"t":"佛说能远离，是得不还道。","level":0,"quote":true},{"t":"有瞋如畫水，或如畫土石，","level":0,"quote":true},{"t":"若说超烦恼，初人则为胜，","level":0,"quote":true},{"t":"改恶修慈忍，第三则为上。","level":0,"quote":true},{"t":"最胜说众生，三种善恶语，","level":0,"quote":true},{"t":"初名引人心，美言如饴蜜，","level":0,"quote":true},{"t":"次名真实语，犹如妙华敷，","level":0,"quote":true},{"t":"后名不诚实，鄙浮如粪秽，","level":0,"quote":true},{"t":"慧者应分别，舍后修初二。","level":0,"quote":true},{"t":"从明明至终，从暗暗究竟，","level":0,"quote":true},{"t":"有从暗入明，或从明入冥，","level":0,"quote":true},{"t":"慧者应谛了，舍三升初明。","level":0,"quote":true},{"t":"有人生似熟，或复熟似生，","level":0,"quote":true},{"t":"或二俱生熟，明者谛分别。","level":0,"quote":true},{"t":"不视他妻色，视则母女想，","level":0,"quote":true},{"t":"如是犹生惑，当修不净观。","level":0,"quote":true},{"t":"心意善驰乱，当勤善守持，","level":0,"quote":true},{"t":"如人护胜闻，宝藏爱子命。","level":0,"quote":true},{"t":"当观五欲乐，犹如恶毒蛇，","level":0,"quote":true},{"t":"怨憎及刀火，方便修厌离。","level":0,"quote":true},{"t":"五欲生非义，犹如频婆果，","level":0,"quote":true},{"t":"覆相善欺诳，缚人住生死，","level":0,"quote":true},{"t":"智者当观察，弃舍勿染污。","level":0,"quote":true},{"t":"诸根常轻躁，驰散六尘境，","level":0,"quote":true},{"t":"若能善调伏，是则大勇健。","level":0,"quote":true},{"t":"是身为行厕，九道常流秽，","level":0,"quote":true},{"t":"穿漏难可满，薄皮隐不净，","level":0,"quote":true},{"t":"愚者为所欺，智士当厌离。","level":0,"quote":true},{"t":"如人病疥虫，向火欲除患，","level":0,"quote":true},{"t":"少乐后苦增，贪欲亦如是。","level":0,"quote":true},{"t":"能善知欲过，从是离众苦，","level":0,"quote":true},{"t":"欲见第一义，佛说观缘起，","level":0,"quote":true},{"t":"应当勤修习，最胜无过是。","level":0,"quote":true},{"t":"族姓身端严，多闻自缨络，","level":0,"quote":true},{"t":"若不修戒慧，此则非殊胜，","level":0,"quote":true},{"t":"能具二功德，无三犹奇特。","level":0,"quote":true},{"t":"利衰及毁誉，称讥与苦乐，","level":0,"quote":true},{"t":"八法不倾动，是则为圣王。","level":0,"quote":true},{"t":"莫为诸天神，沙门婆罗门，","level":0,"quote":true},{"t":"宗亲及宾客，害生造恶业，","level":0,"quote":true},{"t":"命终入地狱，独受彼不代。","level":0,"quote":true},{"t":"若人作恶业，不即受楚毒，","level":0,"quote":true},{"t":"命终受苦报，后悔将何及。","level":0,"quote":true},{"t":"信戒施多闻，智慧有惭愧，","level":0,"quote":true},{"t":"佛说不共财，餘财一切共。","level":0,"quote":true},{"t":"博弈大聚会，懒惰习恶友，","level":0,"quote":true},{"t":"饮酒纵昏荡，夜游无羞耻，","level":0,"quote":true},{"t":"此六污名称，智者应远离。","level":0,"quote":true},{"t":"知足为大财，世尊所称说，","level":0,"quote":true},{"t":"若能修知足，虽贫贱大富。","level":0,"quote":true},{"t":"譬如多头龙，多头则多苦，","level":0,"quote":true},{"t":"自性结恨深，是名怨家妇，","level":0,"quote":true},{"t":"傲慢不承顺，名为轻夫妇，","level":0,"quote":true},{"t":"费用夫主财，是则名贼妇，","level":0,"quote":true},{"t":"慎哉贤丈夫，宜远此三妇。","level":0,"quote":true},{"t":"随顺为姊妹，爱乐为善友，","level":0,"quote":true},{"t":"安慰则为母，随意为婢使，","level":0,"quote":true},{"t":"此四贤良妻，则是夫眷属。","level":0,"quote":true},{"t":"饮食为汤药，无贪恚痴服，","level":0,"quote":true},{"t":"唯为止身苦，勿为肥放逸。","level":0,"quote":true},{"t":"昼则勤修业，初后夜亦然，","level":0,"quote":true},{"t":"中夜亦正念，无令空梦过。","level":0,"quote":true},{"t":"慈悲喜舍心，日夜常修习，","level":0,"quote":true},{"t":"设未出世间，其福胜梵天。","level":0,"quote":true},{"t":"离欲觉欢喜，苦乐修四禅，","level":0,"quote":true},{"t":"梵光净果实，受此诸天乐。","level":0,"quote":true},{"t":"若人少行恶，广修无量善，","level":0,"quote":true},{"t":"如以一把盐，投之大恒水；","level":0,"quote":true},{"t":"若人多行恶，少修净功德，","level":0,"quote":true},{"t":"如以多恶毒，置之小器食。","level":0,"quote":true},{"t":"五阴暗冥贼，劫人善珍宝，","level":0,"quote":true},{"t":"信五根力士，是能善守护。","level":0,"quote":true},{"t":"生老病死苦，所爱者别离，","level":0,"quote":true},{"t":"沦没不超度，斯由自业过。","level":0,"quote":true},{"t":"求生天解脱，当勤修正见，","level":0,"quote":true},{"t":"邪见虽行善，一切得苦果。","level":0,"quote":true},{"t":"无常苦不净，应当善观察，","level":0,"quote":true},{"t":"若不正思惟，四倒盲慧眼。","level":0,"quote":true},{"t":"端正色非我，我色亦非主，","level":0,"quote":true},{"t":"四阴亦复然，唯是空苦聚。","level":0,"quote":true},{"t":"非时非无因，亦非自性有，","level":0,"quote":true},{"t":"非自在天生，无明爱业起。","level":0,"quote":true},{"t":"身见戒取疑，是三障解脱，","level":0,"quote":true},{"t":"圣慧开脱门，自力不由他。","level":0,"quote":true},{"t":"净戒学禅定，精勤修四禅，","level":0,"quote":true},{"t":"增上戒心慧，常当勤修学。","level":0,"quote":true},{"t":"诸戒智三昧，悉入三学中，","level":0,"quote":true},{"t":"身念处大力，佛说一乘道。","level":0,"quote":true},{"t":"常当系心念，方便善守护，","level":0,"quote":true},{"t":"若忘是正念，则失诸善法。","level":0,"quote":true},{"t":"身命极浮脆，喻风吹水泡，","level":0,"quote":true},{"t":"梦觉难可保，出息无必旋，","level":0,"quote":true},{"t":"倏忽成微尘，当知无坚固。","level":0,"quote":true},{"t":"大地须弥海，七日皆烧然，","level":0,"quote":true},{"t":"廓然无遗烬，况复危脆身。","level":0,"quote":true},{"t":"无常不可依，亦非覆护法，","level":0,"quote":true},{"t":"是身不可怙，如何不生厌？","level":0,"quote":true},{"t":"譬如海盲龟，值遇浮木孔，","level":0,"quote":true},{"t":"畜生复人身，难得复过是。","level":0,"quote":true},{"t":"如何人道中，不修胜果业，","level":0,"quote":true},{"t":"宝器盛粪秽，是则愚痴人。","level":0,"quote":true},{"t":"已得人身宝，而用造恶行，","level":0,"quote":true},{"t":"当知此士夫，极愚复过是。","level":0,"quote":true},{"t":"得生有道国，遭遇善知识，","level":0,"quote":true},{"t":"正见心成就，宿命有功德。","level":0,"quote":true},{"t":"四宝轮具足，能出生死路，","level":0,"quote":true},{"t":"亲近善知识，具足修梵行，","level":0,"quote":true},{"t":"佛说如是人，心常得寂灭。","level":0,"quote":true},{"t":"邪见三恶趣，不闻佛法音，","level":0,"quote":true},{"t":"边地暗冥处，聋痖长寿天。","level":0,"quote":true},{"t":"王已离八难，得此无碍身，","level":0,"quote":true},{"t":"宜应修善业，方便求泥洹。","level":0,"quote":true},{"t":"生死长夜中，无量种种苦，","level":0,"quote":true},{"t":"展转作六亲，尊卑无常序。","level":0,"quote":true},{"t":"永劫生死中，未曾不为子，","level":0,"quote":true},{"t":"计饮慈母乳，量喻四大海，","level":0,"quote":true},{"t":"凡夫方受生，所饮复过是，","level":0,"quote":true},{"t":"一人从本来，积骨高须弥。","level":0,"quote":true},{"t":"所经诸人天，大地微尘数，","level":0,"quote":true},{"t":"先作转轮王，后复为仆使，","level":0,"quote":true},{"t":"或上为帝释，诸天所奉事，","level":0,"quote":true},{"t":"下生粪土中，往反亦无数。","level":0,"quote":true},{"t":"或时生天上，婇女极娱乐，","level":0,"quote":true},{"t":"目眩众妙色，耳闻万种声，","level":0,"quote":true},{"t":"触身皆细软，快乐难可名。","level":0,"quote":true},{"t":"后堕地狱中，苦毒靡不经，","level":0,"quote":true},{"t":"若生剑林树，身首随刃零，","level":0,"quote":true},{"t":"或游须弥顶，升降随所念。","level":0,"quote":true},{"t":"与众天女俱，沐浴曼陀池，","level":0,"quote":true},{"t":"宝华列庄严，清凉极快乐，","level":0,"quote":true},{"t":"复入沸灰河，烹煮悉糜烂。","level":0,"quote":true},{"t":"六天五欲欢，梵世离欲乐，","level":0,"quote":true},{"t":"死入无择狱，备受众苦毒。","level":0,"quote":true},{"t":"或作日月天，光明照四域，","level":0,"quote":true},{"t":"后生黑暗狱，不自见其形。","level":0,"quote":true},{"t":"王当然慧灯，勿复随长冥。","level":0,"quote":true},{"t":"八大地狱中，烧炙屠裂苦，","level":0,"quote":true},{"t":"备经众楚毒，无量不可譬。","level":0,"quote":true},{"t":"若人随痴惑，具造众恶业，","level":0,"quote":true},{"t":"出息未反间，闻是诸大苦，","level":0,"quote":true},{"t":"其心不惊怖，是则木石人。","level":0,"quote":true},{"t":"眼见报应像，复闻智者说，","level":0,"quote":true},{"t":"披采佛经典，内心正思惟，","level":0,"quote":true},{"t":"则应大怖畏，何况身自经。","level":0,"quote":true},{"t":"一切受苦中，无择最大苦，","level":0,"quote":true},{"t":"一切受乐中，爱尽第一乐。","level":0,"quote":true},{"t":"日夜各三时，三百枪贯身，","level":0,"quote":true},{"t":"欲比无择苦，百千倍非譬。","level":0,"quote":true},{"t":"无量诸楚毒，求死不可得，","level":0,"quote":true},{"t":"受罪百千岁，恶业尽乃毕。","level":0,"quote":true},{"t":"不净苦果报，身口业为种，","level":0,"quote":true},{"t":"不种则不有，王宜断苦本。","level":0,"quote":true},{"t":"若堕畜生趣，系缚杀害苦，","level":0,"quote":true},{"t":"贪害狂乱心，怨结更相食。","level":0,"quote":true},{"t":"或为取珠宝，毛尾皮肉骨，","level":0,"quote":true},{"t":"由是丧身命，解剥断截痛。","level":0,"quote":true},{"t":"骏足有大力，穿颈服乘苦，","level":0,"quote":true},{"t":"狂逸不调驯，策勒而榜楚。","level":0,"quote":true},{"t":"饿鬼思饮食，所念未曾有，","level":0,"quote":true}],[{"t":"饥渴寒热迫，长夜无休息。","level":0,"quote":true},{"t":"或身如大山，咽口若针锋，","level":0,"quote":true},{"t":"饥渴内烧燃，对食食无从，","level":0,"quote":true},{"t":"或见粪脓唾，群走竞驰趣，","level":0,"quote":true},{"t":"到则自然灭，望绝增苦恼。","level":0,"quote":true},{"t":"饥渴煎其内，瘤瘿发痈疽，","level":0,"quote":true},{"t":"更共相撮搏，龃齚唼脓血。","level":0,"quote":true},{"t":"羸瘦皮骨连，裸形被长发，","level":0,"quote":true},{"t":"身长若枯木，炽焰从口出，","level":0,"quote":true},{"t":"还自焚其身，状烧多罗树。","level":0,"quote":true},{"t":"处夏希夜凉，月光增其热，","level":0,"quote":true},{"t":"在冬思昼温，日出逾氷结，","level":0,"quote":true},{"t":"向树果即消，趣河水辄竭，","level":0,"quote":true},{"t":"经万五千岁，业持命不绝。","level":0,"quote":true},{"t":"久受无量苦，斯由宿罪缘，","level":0,"quote":true},{"t":"种种诸恼逼，纯苦初无间，","level":0,"quote":true},{"t":"贪惜极悭著，佛说饿鬼因。","level":0,"quote":true},{"t":"生天虽快乐，福尽极大苦，","level":0,"quote":true},{"t":"斯非贤圣果，慧者所不怙。","level":0,"quote":true},{"t":"身体不光泽，不乐本所座，","level":0,"quote":true},{"t":"华冠卒萎落，尘垢忽著身，","level":0,"quote":true},{"t":"腋下流汗汁，当知死时至。","level":0,"quote":true},{"t":"善趣净业尽，复堕三恶道，","level":0,"quote":true},{"t":"或生阿修罗，贪嫉常苦恼，","level":0,"quote":true},{"t":"虽有智聪明，终不见真谛。","level":0,"quote":true},{"t":"生死六趣中，轮转常不息，","level":0,"quote":true},{"t":"胜法不受生，生者众苦器，","level":0,"quote":true},{"t":"假令顶火然，正意慎勿念，","level":0,"quote":true},{"t":"不受后有业，专心勤修习。","level":0,"quote":true},{"t":"戒品禅定慧，寂静调不动，","level":0,"quote":true},{"t":"当求涅槃道，究竟离生死。","level":0,"quote":true},{"t":"念择及精进，喜猗三昧舍，","level":0,"quote":true},{"t":"此七菩提分，清净甘露道。","level":0,"quote":true},{"t":"无智则不禅，无禅亦不智，","level":0,"quote":true},{"t":"是二俱成就，能出生死流，","level":0,"quote":true},{"t":"无边大苦海，视如牛迹水。","level":0,"quote":true},{"t":"十四无记论，佛说不应思，","level":0,"quote":true},{"t":"是非安隐道，亦非寂灭处。","level":0,"quote":true},{"t":"无明缘诸行，即缘彼生识，","level":0,"quote":true},{"t":"名色从识起，六入因名色，","level":0,"quote":true},{"t":"六入生六触，从触起诸受，","level":0,"quote":true},{"t":"诸受为爱因，从爱生四取，","level":0,"quote":true},{"t":"四取生三有，因有爱后生，","level":0,"quote":true},{"t":"从生致老死，忧悲诸苦恼，","level":0,"quote":true},{"t":"无量众苦聚，生尽则都灭。","level":0,"quote":true},{"t":"最胜所显示，甚深缘起法，","level":0,"quote":true},{"t":"若能正观察，真实见之上，","level":0,"quote":true},{"t":"如是真实见，是则为见佛。","level":0,"quote":true},{"t":"正见正思惟，正语正业命，","level":0,"quote":true},{"t":"正念正方便，及正三摩提，","level":0,"quote":true},{"t":"八分圣贤道，寂灭当修习。","level":0,"quote":true},{"t":"生为真谛苦，恩爱则是集，","level":0,"quote":true},{"t":"苦灭名解脱，到彼谓八道。","level":0,"quote":true},{"t":"为见彼真谛，常勤修正智，","level":0,"quote":true},{"t":"虽处五欲乐，慧者能出离。","level":0,"quote":true},{"t":"能证正法者，皆从凡夫起，","level":0,"quote":true},{"t":"不从虚空堕，亦不从地出。","level":0,"quote":true},{"t":"明哲无畏王，领要不待烦，","level":0,"quote":true},{"t":"宜修正法桥，越度生死渊。","level":0,"quote":true},{"t":"如上诸深法，出家犹难精，","level":0,"quote":true},{"t":"况复御世主，而能具足行，","level":0,"quote":true},{"t":"随时渐修习，勿令日空过。","level":0,"quote":true},{"t":"一切人修善，常生随喜心，","level":0,"quote":true},{"t":"自行三种业，正回向佛道，","level":0,"quote":true},{"t":"当於未来世，受此无量福，","level":0,"quote":true},{"t":"常生天人中，得为自在王，","level":0,"quote":true},{"t":"与大菩萨众，游戏诸神通，","level":0,"quote":true},{"t":"方便化众生，严净佛国土。","level":0,"quote":true},{"t":"施戒慧为种，往返人天中，","level":0,"quote":true},{"t":"无垢净名称，流布十方国。","level":0,"quote":true},{"t":"世间导人主，上生化天王，","level":0,"quote":true},{"t":"令舍五欲乐，远离诸放逸。","level":0,"quote":true},{"t":"众生迷正济，漂浪随四流，","level":0,"quote":true},{"t":"无量生死苦，度令至彼岸，","level":0,"quote":true},{"t":"缘此成佛道，究竟大涅槃。","level":0,"quote":true},{"t":"劝发诸王要偈","level":0}]]