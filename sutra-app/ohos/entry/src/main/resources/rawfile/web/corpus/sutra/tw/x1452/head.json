{"id":"x1452","title":"紫柏尊者全集","titleTrad":"紫柏尊者全集","byline":"匡山逸叟憨山釋　德清　著","bylineLabel":"著者·译者","dynasty":"","division":"诸宗部","canon":"X1452","canonName":"新纂卍續藏","volume":"X1452","juanCount":29,"textLength":440842,"imageCount":0,"summary":"","tags":["诸宗部","新纂卍續藏"],"order":2660,"guide":"","chunks":116,"toc":[{"level":3,"text":"紫栢老人集序"},{"level":3,"text":"紫栢大師集序"},{"level":3,"text":"紫栢大師全身舍利塔頌有序"},{"level":2,"text":"將三藏十二部五千四十八卷千七百"},{"level":3,"text":"紫栢老人圜中語錄序"},{"level":2,"text":"法語(卷一"},{"level":2,"text":"法語(卷二"},{"level":2,"text":"法語(卷三"},{"level":2,"text":"法語(卷四"},{"level":2,"text":"法語(卷五"},{"level":2,"text":"法語(卷六"},{"level":2,"text":"法語(卷七"},{"level":3,"text":"又此識見分第七識，計而為內，自我七識又為六識"},{"level":2,"text":"法語(卷八"},{"level":2,"text":"法語(卷九"},{"level":3,"text":"長松茹退序"},{"level":2,"text":"法語(卷十"},{"level":2,"text":"古。散一物為萬物，如片月在天，影臨萬水也。卷萬"},{"level":2,"text":"一字一言，一葉一卷，乃至十卷八十一"},{"level":3,"text":"序金剛經白文序金剛經白文序"},{"level":3,"text":"石門文字禪序"},{"level":3,"text":"重刻智證傳序"},{"level":3,"text":"麟禪人刺血跪書華嚴經序"},{"level":3,"text":"小板法華經序"},{"level":3,"text":"小板棱嚴經序"},{"level":3,"text":"重壽投子青和尚頌古集序"},{"level":3,"text":"遠公五論序"},{"level":3,"text":"重刻應庵和尚語錄序"},{"level":2,"text":"紫柏老人集卷十八"},{"level":2,"text":"之機在我，而不在造物也。理通則卷萬"}],"chunksPerFile":20}