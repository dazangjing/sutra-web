[[{"t":"小钞一卷","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21868.gif\" alt=\"𭂫\" title=\"𭂫\" />欲发起先知教至归三藏▆…▆多罗蔵(此云经藏)二毗柰耶蔵(此云律蔵▆…▆)。","level":0},{"t":"今此四分戒本三蔵之中▆毗尼蔵▆…▆。","level":0},{"t":"一名为戒(若就教释防非为戒若就▆…▆<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />为戒又单释防非止<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />名▆…▆律又释诠量轻重决断是非名之为律若就行释调伏刚镕以之为律)三▆…▆(若就教释此是解缚之法依而出家者▆…▆故云彼彼解脱也若就行释▆缚之心念念之中▆…▆▆羁缚念念离尘染名木叉)四名毗<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />(▆是▆…▆断除生死苦尽无为淡泊故名为灭又释灭除生死尽诸苦囙故云毗尼)","level":0},{"t":"此毗<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />蔵世尊▆…▆传临涅槃时以此律蔵付嘱优波离灭度▆…▆诃迦叶涅槃付嘱阿难灭度付嘱高▆…▆修涅槃付嘱优波毱多已上五大师佛法皆同一味后毱多有五弟子各<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15137.gif\" alt=\"𥪰\" title=\"𥪰\" />生异见遂分为五。","level":0},{"t":"一名[薩-產+(辛/工)]婆多即十诵律主是也二名昙无得即四分律主是三名弥沙塞即五分律主是也四名婆麁富那即僧祇律主是也五名迦叶毗律本未来汉地也","level":0},{"t":"今此四分律主即昙无徳部是此是梵语唐言法正部也。","level":0},{"t":"得戒有十种","level":0},{"t":"一自然得戒唯佛二自誓得戒谓大迦叶三见谛得戒谓五俱轮䓁五比丘四善来得戒谓耶舎䓁五三语得戒谓佛在世未制戒前但受三归即得具足六问荅得戒谓湏陁耶沙弥年始七岁佛问其义一具荅称可圣心便发具足七八敬得戒谓大爱道从阿难闻八法已欢喜顶受便发具足八敬者百骂举授忏请安自八遣使得戒谓半▆…▆有其难缘差使<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00855.gif\" alt=\"𠧒\" title=\"𠧒\" />戒即得具足九羯磨▆…▆十僧<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25577.gif\" alt=\"㑅\" title=\"㑅\" />法十边方五人授大戒","level":0},{"t":"已前九种▆…▆世羯磨一法教通<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21868.gif\" alt=\"𭂫\" title=\"𭂫\" />圣被及僧<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />说罗现未▆…▆法。","level":0},{"t":"问羯磨受戒具足几缘得名如法。","level":0},{"t":"荅依僧祇▆…▆囙缘。","level":0},{"t":"一年满廿三衣钵具二身无遮难三结界▆…▆四界内<img class=\"gaiji\" src=\"asset://gaiji-CB/16/CB16487.gif\" alt=\"𥁞\" title=\"𥁞\" />集五羯磨成就六十僧满足","level":0},{"t":"俻此▆…▆如法阙一不成。","level":0},{"t":"问界有几种。","level":0},{"t":"荅。","level":0},{"t":"一者<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25577.gif\" alt=\"㑅\" title=\"㑅\" />法界二者僧界","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25577.gif\" alt=\"㑅\" title=\"㑅\" />法有三。","level":0},{"t":"一者摄僧界二摄衣界三摄食界","level":0},{"t":"僧界有三种。","level":0},{"t":"一者大界二者界塲三者小界","level":0},{"t":"今▆▆之内又有三种谓。","level":0},{"t":"人法二同界法食二同界法同食别界","level":0},{"t":"若就自然界中者则分四别。","level":0},{"t":"一者谓聚落界二者兰若界三者道行界四者木界","level":0},{"t":"问羯磨有几种。","level":0},{"t":"荅有一百卅四种。","level":0},{"t":"单自羯磨有卅九白二羯磨有五十七自四羯磨卅八","level":0},{"t":"此三羯磨摄一切羯皆<img class=\"gaiji\" src=\"asset://gaiji-CB/16/CB16487.gif\" alt=\"𥁞\" title=\"𥁞\" />。","level":0},{"t":"明五篇法","level":0},{"t":"一波罗夷篇(盖是西音此云无餘若犯此戒永弃众外故曰无餘不得与僧同行布[薩-產+(辛/工)]羯磨弃在界外故云餘无)二僧伽婆尸沙篇(此云僧残若犯此戒行则毁缺不应在布[薩-產+(辛/工)]羯磨众中之<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08001.gif\" alt=\"𢿘\" title=\"𢿘\" />行类其人故名僧残)三名波逸提篇(此云方堕若犯此戒堕落地狱烧煑覆障故云堕也)四名波罗提提舎<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />篇(此云向彼悔若犯此戒事合可呵对手忏悔故云向彼悔)五名式叉迦罗<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />篇(此方云应当学威仪练行懃习方成故云应当学)","level":0},{"t":"此明七聚法","level":0},{"t":"一波罗夷聚二僧伽婆尸沙聚三偷兰遮聚(此是梵语唐言麁<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />亦云遮障偷言遮障兰言鄣若犯此罪大遮障圣道故云遮障法偷兰有四一五<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01618.gif\" alt=\"𨒫\" title=\"𨒫\" />偷兰应灭<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09665.gif\" alt=\"𣩵\" title=\"𣩵\" />不可除二初篇下重偷兰应八僧中悔三初篇下轻偷兰二篇下重偷兰应四僧中忏四独头兰遮及餘篇下偷兰应三僧中悔)四波逸提聚五波罗提提舎<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />聚六突吉罗聚七<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />说聚(突吉罗者义翻云<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />作突者名<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />吉罗名作<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />不止故名突吉罗所云蹉跦身作名<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />口作名说故云<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25577.gif\" alt=\"㑅\" title=\"㑅\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />说突吉罗此二聚罪若故犯者应对手忏若悮犯应责忏)","level":0},{"t":"问欲戒具几缘成犯。","level":0},{"t":"荅具四缘。","level":0},{"t":"一前境是女人二兴染心三起方便四与境合便犯","level":0},{"t":"问盗戒具几缘成犯。","level":0},{"t":"荅具六缘成犯。","level":0},{"t":"有一主<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />二有主想三有盗心四重<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />五兴方便六离本<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />便犯","level":0},{"t":"问煞戒具几缘。","level":0},{"t":"荅具五缘。","level":0},{"t":"一是人二人想三兴慜四起方便五断命根","level":0},{"t":"问大妄语戒具几缘。","level":0},{"t":"荅具八缘成犯。","level":0},{"t":"一前境是人二人想三事虚四知是虚事五有诳他心六自言已得七言辝了了八前人知解","level":0},{"t":"问僧有几种。","level":0},{"t":"荅四种。","level":0},{"t":"一者四人僧(除授戒自恣出罪铨一切羯磨应作)二者五人僧(除中国授戒出罪餘法得作)三者十人僧(除出罪餘法作)四者廿人僧(一切羯磨得作现复更多)","level":0},{"t":"问菩[薩-產+(辛/工)]戒中煞先[婬-壬+(工/山)]后何故声闻戒中[婬-壬+(工/山)]先煞后。","level":0},{"t":"荅菩[薩-產+(辛/工)]为大慈为本是以煞戒为初声闻以梵行为机是以欲戒为首。","level":0},{"t":"受衣法","level":0},{"t":"若不持三衣入聚落者得无量罪世世裸形无有衣服若不串钩细入俗人家家得罪若食饮时<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09727.gif\" alt=\"𠰸\" title=\"𠰸\" />得罪。","level":0},{"t":"问云何名为三衣六<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />。","level":0},{"t":"一名安陀会(有四种一割截二摄业三褋𦯧四缦作一长一短割截衣持餘三累此改持)二名欝多罗僧(有二种一割截二褋𦯧二长一短即是七条衣受割截衣持若餘衣准此)三名僧伽梨(此衣有十八种谓割截褋𦯧各九品若受上衣廿五条四长一短割截衣持若是褋𦯧条<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08001.gif\" alt=\"𢿘\" title=\"𢿘\" />准上褋𦯧衣持若中品三长一短若是下品二长一短)","level":0},{"t":"授衣文","level":0},{"t":"大徳一心念[禾*戈]比丘某甲此欝多罗僧七条衣受两长一短割截衣持(三说若是餘衣及褋𦯧𫌇𦯧䓁临事准改受文同上)。","level":0},{"t":"舍衣文","level":0},{"t":"大徳一心念[禾<em>戈]比丘某甲此僧伽梨是[禾</em>戈]三衣<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08001.gif\" alt=\"𢿘\" title=\"𢿘\" />先受持今舍(一说下二衣及<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />五衣䓁湏舍亦尓)。","level":0},{"t":"授药法","level":0},{"t":"药有四种。","level":0},{"t":"一时药(佉阇<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />食有五种谓𪎊乾饭鱼肉佉阇尼食梵音唐言枝𦯧花果细未食有五种一大净二刀净三疮净四鸟啄净五不中种净此中火净及子坏净得并子食餘三去子食是时药谓从旦至中前食若欲授者先知食体后知餘药准此)二非时药(谓八种浆梨枣[卄/(麩-夫+壬)]<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07404.gif\" alt=\"𤰇\" title=\"𤰇\" />㧐蜜▆石<img class=\"gaiji\" src=\"asset://gaiji-CB/22/CB22627.gif\" alt=\"㽞\" title=\"㽞\" />庵罗果䓁讨<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25577.gif\" alt=\"㑅\" title=\"㑅\" />浆若有病缘<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" />清水渧净加以授法得饮无病不得饮)三七日药(仏言苏油生苏蜜石蜜有病因缘加▆法<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" />七日眼授法者大徳一心念[禾*戈]比丘某甲今为热风冷病囙缘比七日药为欲宿眼故今於大徳边授（三说）餘二时药若有病患囙缘湏眼者临事旦小法准改授文同上)四尽形药(仏言一切咸著享不堪为食者乃至<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01926.gif\" alt=\"灰\" title=\"灰\" />土大小便䓁若有病缘<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15148.gif\" alt=\"𦘕\" title=\"𦘕\" />形眼亦湏手授加其口法得眼)","level":0},{"t":"安居法","level":0},{"t":"(从始及修揔有四法谓人有五众是法有四对手心念及界时有三前安居中安居后安居<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />有二<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25577.gif\" alt=\"㑅\" title=\"㑅\" />法界自然界)。","level":0},{"t":"对手安居法","level":0},{"t":"大徳一心念[禾*戈]比丘某甲依(某聚落某伽蓝随事称之)前三月夏安居房舎破修持故(三说)彼告言汝莫放逸(荅言授持)。","level":0},{"t":"问比丘义云何。","level":0},{"t":"荅有八种。","level":0},{"t":"一名字比丘二相似比丘三自称比丘四<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00855.gif\" alt=\"𠧒\" title=\"𠧒\" />求比丘五著割截衣比丘六破结使比丘七善来比丘八白四羯磨如法成就得<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />所比丘","level":0},{"t":"四依法","level":0},{"t":"一粪扫衣二常<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00855.gif\" alt=\"𠧒\" title=\"𠧒\" />食三树下坐四食腐烂药","level":0},{"t":"粪扫衣十种","level":0},{"t":"一牛嚼衣二鼠啮衣三火烧衣四水五立王衣六神庙衣若鸟衔风吹杂<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />七愿衣八冢间衣九产衣十往还衣","level":0},{"t":"僧物随事立名<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21868.gif\" alt=\"𭂫\" title=\"𭂫\" />有六种","level":0},{"t":"一者十方僧<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />(如僧家重<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />及供众受用食噉䓁<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />体通十方上至罗汉沙弥<img class=\"gaiji\" src=\"asset://gaiji-CB/16/CB16487.gif\" alt=\"𥁞\" title=\"𥁞\" />皆有分无有和合不淂卖买贷借与人及<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30678.gif\" alt=\"𥝠\" title=\"𥝠\" />己受用)二者常住僧<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />(谓众僧厨库寺舎园田▆便畜䓁体道十方不可分用言常▆在法<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />不可移动四方僧来此<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />受用从物为名故称常住)三者十方现前(如亡僧物五众依物未羯磨如前者十方现前僧若盗此物从十方僧结罪)四者现现前前(谓亡僧五众物作羯磨了及有施大众物法事声断差人守护众僧未分故云现前僧<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />)五招提僧<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />(谓檀越施田园与现前僧造<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30678.gif\" alt=\"𥝠\" title=\"𥝠\" />房四方僧来无安置<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />俗人见已就法房边更施田园中建立僧房与四方僧供给所湏由此房能招引四方僧故言招提僧<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />或先造房僧回己房及田园施四方僧亦云招提僧<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />)六者僧[肆-聿+((彰-章)/万)]<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />(谓僧园中有花或卖花或已花<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25577.gif\" alt=\"㑅\" title=\"㑅\" />[肆-聿+((彰-章)/万)]出卖得<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />从[肆-聿+((彰-章)/万)]澷<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />故名僧[肆-聿+((彰-章)/万)]<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />)","level":0},{"t":"有四种妄语","level":0},{"t":"一波罗夷妄语二僧残妄语三波逸提妄语四阿毗波罗妄语","level":0},{"t":"口有四威仪语","level":0},{"t":"一者常<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25577.gif\" alt=\"㑅\" title=\"㑅\" />法语二常<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25577.gif\" alt=\"㑅\" title=\"㑅\" />正直实语三常<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25577.gif\" alt=\"㑅\" title=\"㑅\" />和合语四常<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25577.gif\" alt=\"㑅\" title=\"㑅\" />柔软悦意语","level":0},{"t":"悭有五种","level":0},{"t":"一悭财二悭法三悭家四悭<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />五悭赞","level":0},{"t":"明四分义","level":0},{"t":"四者<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08001.gif\" alt=\"𢿘\" title=\"𢿘\" />也分者叚也世尊在世四度升座说此律故名四分又云梵夷四夹故名四分(此四分律通其六释今且明一解四分即律律即四分六释之中是▆<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08001.gif\" alt=\"𢿘\" title=\"𢿘\" />释也)今依律本。","level":0},{"t":"从初至僧戒末名为初分至尼戒终名为苐二分从安居徤度至房舎已前名为苐三分从房舎揵度至律本末名为苐四分","level":0},{"t":"持戒得十种利","level":0},{"t":"(一摄取於僧二令僧欢喜三令僧安乐四未信者令信五已信者令增长六难调者令调七渐块者安乐八断现在有漏九断未来有漏十令正法得久住)。","level":0},{"t":"十二头陁法","level":0},{"t":"(头者少欲陁名知足升薮烦恼离於住著故曰头陁)。","level":0},{"t":"一持粪扫衣二持三衣三持随衣四常<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00855.gif\" alt=\"𠧒\" title=\"𠧒\" />食五一𩠊食六一坐食七不作餘食法八树下坐九冢间坐十露地坐十一随<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />坐十二常坐不卧","level":0},{"t":"(法十二持衣有三食法有四<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />所有五行人於此衣食<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />所心无染著积缘进道更不思湏)。","level":0},{"t":"檀越施物<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21868.gif\" alt=\"𭂫\" title=\"𭂫\" />有八种","level":0},{"t":"一施比丘僧物(唯属比丘现前人分)二施比丘<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />物(唯属现前比丘<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08001.gif\" alt=\"𢿘\" title=\"𢿘\" />人分)三施二部僧<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />莫问人<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08001.gif\" alt=\"𢿘\" title=\"𢿘\" />多少分<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />作二分一分僧<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30246.gif\" alt=\"𭣣\" title=\"𭣣\" />一分付<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />众各於当部自<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08001.gif\" alt=\"𢿘\" title=\"𢿘\" />人分之四施四方僧得施<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />来者皆得应作羯磨分正不得与<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />同作羯磨若施招提僧不湏作法五界内僧得施物唯属住<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />僧入界皆得但取施主为<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />六施同羯磨僧得施<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />唯一<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />同作法者分之七施称名字僧得施若言施禅师法师律师呪愿师差病僧䓁不问亲踈八众中一僧得施<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21980.gif\" alt=\"𢪱\" title=\"𢪱\" />从上座行之随取者与","level":0},{"t":"随檀越所有舍施依此八法分之若无<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />分上座应问於何䓁施若不依此八法则不得施僧之福若不依此八法而受则轻损信施违犯<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />深应差五得分之好<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />相<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07694.gif\" alt=\"㕘\" title=\"㕘\" />令不见者掷筹餘人不得乱语利养难消贫富不在此莫生嫌恨盖人至行也出家之人不得回施入己若欲回者其罪甚重应如法施如法受如法求如法与如法用如法住。","level":0},{"t":"问律以何为宗以何为体。","level":0},{"t":"荅以戒为宗诸说不同依东塔<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00562.gif\" alt=\"䟽\" title=\"䟽\" />以戒为宗律以何为体者荅合是诸业为体任意取舍十一<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />中以法为体依经部以不相应为体依有部以色为体俱是法<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />摄。","level":0},{"t":"问律仪有几种。","level":0},{"t":"荅有四种。","level":0},{"t":"一静虑律仪是色界尸罗二无漏律仪为无漏身中所起尸罗三断律仪为断烦<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08974.gif\" alt=\"𢙉\" title=\"𢙉\" />名断律仪四别断解脱律仪为欲界尸罗为别别防非名别解脱律仪","level":0},{"t":"客旧相遇","level":0},{"t":"昔大师在日亲为教主客苾茤至自唱善来又复西方寺众多为制法凡见新来无论客旧及弟子门人旧人即湏迎前唱莎揭哆译曰善来客乃寻声即云窣莎揭哆译曰极善来如不说者壁牙一违寺制二准律有犯无问大小<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01556.gif\" alt=\"𢘻\" title=\"𢘻\" />皆如此即为<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30246.gif\" alt=\"𭣣\" title=\"𭣣\" />取瓶钵摇在壁牙随<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />安令其<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29801.gif\" alt=\"𢠾\" title=\"𢠾\" />息糿白屏<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />尊乃房前卑则敬上而熟搦其踹后及遍身尊乃抚下而频按其背不至<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01594.gif\" alt=\"𦝫\" title=\"𦝫\" />足齐年之类事无间然既解疲劳方澡手濯足次就尊所申其礼教但为一礼<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00562.gif\" alt=\"䟽\" title=\"䟽\" />而按足尊乃展其右手抚彼肩背若别非经久手抚不不为师乃问其安不弟子随事见荅然后在退一边恭敬而坐实无立法然西方轨则多坐小拈<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />皆露足东夏既无斯事执足礼不行怪说人而来至仏所顶礼双足退坐一靣即其仪矣然后释其时<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07419.gif\" alt=\"𠋫\" title=\"𠋫\" />恭给汤饮蘓蜜沙糖饮噉随意或餘八浆并湏罗滤澄清方饮如兼浊滓此<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />不开杏汤之流体是稠浊准依道理全非饮限律云凡浆净滤色如黄荻此谓西国师弟门徒客旧相遇逄<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02956.gif\" alt=\"𨒦\" title=\"𨒦\" />之礼岂冒寒创至触热新来或遍体汗流或手足皆冻放<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30037.gif\" alt=\"𨚫\" title=\"𨚫\" />衣襆急事和尚情状忩忙深乖轨式师乃立之闲问餘事诚<img class=\"gaiji\" src=\"asset://gaiji-CB/27/CB27329.gif\" alt=\"㦲\" title=\"㦲\" />太急将为绍隆言和尚者梵云畔睇或云畔惮南译为敬礼但为采语不真唤和南矣不能移旧且道和南的取正音应云畔睇又道行众集礼拜非仪合掌𠇓头口云畔睇故经云或复但合掌乃至小𠇓头即是<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25913.gif\" alt=\"𦤺\" title=\"𦤺\" />敬也南人不审依希合度向使改不审为畔睇斯乃全同律教矣。","level":0},{"t":"小钞一卷","level":0},{"t":"乹符贰年四月十七日纳色判官孙兴晟分配如后。","level":0},{"t":"炖煌莫高神沙平康洪池王开[赤/心]慈恵効谷","level":0}]]