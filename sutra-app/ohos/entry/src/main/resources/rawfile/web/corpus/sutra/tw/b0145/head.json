{"id":"b0145","title":"天目中峰廣錄","titleTrad":"天目中峰廣錄","byline":"","bylineLabel":"著者·译者","dynasty":"","division":"诸宗部","canon":"B0145","canonName":"大藏經補編","volume":"B0145","juanCount":30,"textLength":244919,"imageCount":0,"summary":"","tags":["诸宗部","大藏經補編"],"order":2034,"guide":"","chunks":17,"toc":[{"level":3,"text":"天目中峯和尚廣錄序"},{"level":3,"text":"重刊中峯和尚廣錄序"},{"level":3,"text":"卷第二十四序"},{"level":3,"text":"序"},{"level":3,"text":"序"},{"level":3,"text":"送宗遇上人省親序"},{"level":3,"text":"送明然上人居山序"},{"level":3,"text":"止止堂偈序"},{"level":3,"text":"設利偈序"},{"level":3,"text":"觀音菩薩補陀巖示現偈序"},{"level":3,"text":"觀音菩薩瑞相偈序"},{"level":3,"text":"無窮之信。此又非現宰官身說法而何。公甞囑余序"},{"level":3,"text":"示善助道者居山序"},{"level":3,"text":"一華五葉序"},{"level":3,"text":"幻無自性任其安立。使棄之却成實法流布也。請序"},{"level":3,"text":"一華五葉後序"}],"chunksPerFile":20}