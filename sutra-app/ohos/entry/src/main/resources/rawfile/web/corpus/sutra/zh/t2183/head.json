{"id":"t2183","title":"东域传灯目录","titleTrad":"東域傳燈目錄","byline":"弘经录一","bylineLabel":"著者·译者","dynasty":"","division":"目录部","canon":"T2183","canonName":"大正藏","volume":"T2183","juanCount":1,"textLength":12490,"imageCount":0,"summary":"","tags":["目录部","大正藏"],"order":3054,"guide":"","chunks":8,"toc":[{"level":2,"text":"注法华经七卷(或十卷齐南郡隐士刘虬注七卷经注右七卷八"},{"level":2,"text":"同经疏五卷(灵范师撰安祥寺录云四卷第四"},{"level":2,"text":"一乘诸经疏十五卷一"},{"level":2,"text":"同经疏三卷(义寂大夫殿目录云观无量寿经述记三卷二"},{"level":2,"text":"同经文疏二十八卷(或三十四卷亦三十七卷三十"},{"level":2,"text":"同经义卷四"},{"level":2,"text":"部异执论疏十卷(真谛或成四卷梵释寺东寺云义记四卷叡山楞严院吉祥院四卷十"}],"chunksPerFile":20}