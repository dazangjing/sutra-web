[[{"t":"百千颂大集经地藏菩萨请问法身赞","level":0},{"t":"开府仪同三司特进试鸿胪卿肃国公食邑三千户赐紫赠司空谥大鉴正号大广智大兴善寺三藏沙门不空奉　诏译","level":0},{"t":"归命礼法身，住於诸有情；","level":0,"quote":true},{"t":"彼由不遍知，轮回於三有。","level":0,"quote":true},{"t":"其性即生死，净时亦复然；","level":0,"quote":true},{"t":"清净是涅槃，亦即是法身。","level":0,"quote":true},{"t":"譬如乳相杂，醍醐不可得；","level":0,"quote":true},{"t":"如烦恼相杂，法界不可见。","level":0,"quote":true},{"t":"譬如净乳已，酥精妙无垢；","level":0,"quote":true},{"t":"如净其烦恼，法界极清净。","level":0,"quote":true},{"t":"如灯在其瓶，光耀无所有；","level":0,"quote":true},{"t":"如在烦恼瓶，法界不照耀。","level":0,"quote":true},{"t":"彼彼令一边，其瓶若得穴；","level":0,"quote":true},{"t":"由彼彼一边，光明而外出。","level":0,"quote":true},{"t":"以三摩地杵，破坏烦恼瓶；","level":0,"quote":true},{"t":"遍满於虚空，普遍光照耀。","level":0,"quote":true},{"t":"法界亦不生，亦不曾坏灭；","level":0,"quote":true},{"t":"一切时不染，初中常无垢。","level":0,"quote":true},{"t":"譬如吠瑠璃，常时极光明；","level":0,"quote":true},{"t":"石藏以覆蔽，彼光不照耀。","level":0,"quote":true},{"t":"如是烦恼覆，法界妙清净；","level":0,"quote":true},{"t":"不照於生死，於涅槃光明。","level":0,"quote":true},{"t":"有性若有功，则见於真金；","level":0,"quote":true},{"t":"无性若有功，困而无所获。","level":0,"quote":true},{"t":"如糠覆其上，不名为粳米；","level":0,"quote":true},{"t":"烦恼覆其上，亦不名为佛。","level":0,"quote":true},{"t":"若得离於糠，显现於粳米；","level":0,"quote":true},{"t":"远离於烦恼，法身得显现。","level":0,"quote":true},{"t":"世间作譬喻，芭蕉无坚实；","level":0,"quote":true},{"t":"而有贞实果，食味如甘露。","level":0,"quote":true},{"t":"如无实生死，流转烦恼海；","level":0,"quote":true},{"t":"其果即佛体，甘露施有施。","level":0,"quote":true},{"t":"如是於诸种，相似生其果；","level":0,"quote":true},{"t":"无种亦无果，智者必不信。","level":0,"quote":true},{"t":"种子则其性，诸法之所依；","level":0,"quote":true},{"t":"次第若能净，获得成佛位。","level":0,"quote":true},{"t":"日月常无垢，以五种覆蔽：","level":0,"quote":true},{"t":"云、雾与烟等，罗睺手及尘。","level":0,"quote":true},{"t":"如是心光明，覆蔽以五垢：","level":0,"quote":true},{"t":"贪爱、瞋恚、眠、掉举与疑惑。","level":0,"quote":true},{"t":"如火洗其衣，种种垢不净；","level":0,"quote":true},{"t":"若掷於火中，烧垢不烧衣。","level":0,"quote":true},{"t":"空类诸契经，所有如来说；","level":0,"quote":true},{"t":"一切断烦恼，不曾坏其性。","level":0,"quote":true},{"t":"譬如地下水，常住而清净；","level":0,"quote":true},{"t":"智隐於烦恼，清净亦复然。","level":0,"quote":true},{"t":"法界亦非我、非女亦非男；","level":0,"quote":true},{"t":"远离一切执，云何分别我？","level":0,"quote":true},{"t":"诸法无所著，女男不可得；","level":0,"quote":true},{"t":"贪盲调伏故，示现男女相。","level":0,"quote":true},{"t":"无常苦空性，心净虑有三；","level":0,"quote":true},{"t":"最胜心净虑，诸法无自性。","level":0,"quote":true},{"t":"如胞胎孕子，有之而不现；","level":0,"quote":true},{"t":"如烦恼所覆，法实不可见。","level":0,"quote":true},{"t":"分别有四种，所生大造者：","level":0,"quote":true},{"t":"分别我、我所、名想及境界。","level":0,"quote":true},{"t":"一切佛大愿，无所有无相；","level":0,"quote":true},{"t":"自觉相应故，诸佛常法性。","level":0,"quote":true},{"t":"如言兔有角，分别而非有；","level":0,"quote":true},{"t":"如是一切法，分别不可得。","level":0,"quote":true},{"t":"分析如微尘，分别不可得；","level":0,"quote":true},{"t":"如初后亦尔，智云何分别？","level":0,"quote":true},{"t":"如是和合生，和合亦灭坏；","level":0,"quote":true},{"t":"一法自不生，云何愚分别？","level":0,"quote":true},{"t":"兔、牛二角喻，此名遍计相；","level":0,"quote":true},{"t":"依住於中道，如善逝法性。","level":0,"quote":true},{"t":"如月及星宿，现於清水器；","level":0,"quote":true},{"t":"影像而显现，如是圆成相。","level":0,"quote":true},{"t":"初中亦为善，常恒不欺诳；","level":0,"quote":true},{"t":"彼无五种我，云何我分别？","level":0,"quote":true},{"t":"譬如热时水，故名为热水；","level":0,"quote":true},{"t":"是则其冷时，则名为冷水。","level":0,"quote":true},{"t":"覆蔽烦恼网，是则名为心；","level":0,"quote":true},{"t":"若离其烦恼，则名为等觉。","level":0,"quote":true},{"t":"眼识缘於色，影像极清净；","level":0,"quote":true},{"t":"不生亦不灭，法界无形相。","level":0,"quote":true},{"t":"耳识缘於声，清净识三种；","level":0,"quote":true},{"t":"以自分别闻，法界无形相。","level":0,"quote":true},{"t":"鼻依香而嗅，无色亦无形；","level":0,"quote":true},{"t":"鼻识是真如，法界应分别。","level":0,"quote":true},{"t":"舌界自性空，味界性远离；","level":0,"quote":true},{"t":"无依亦无识，法界自性故。","level":0,"quote":true},{"t":"清净身自性，所触和合相；","level":0,"quote":true},{"t":"远离於所缘，我说为法界。","level":0,"quote":true},{"t":"诸法意为最，离能、所分别；","level":0,"quote":true},{"t":"法界无自性，法界而分别。","level":0,"quote":true},{"t":"能见闻而嗅，是味及所触；","level":0,"quote":true},{"t":"瑜伽法是知，如是圆成相。","level":0,"quote":true},{"t":"眼、耳及与鼻，舌、身及末那；","level":0,"quote":true},{"t":"六处皆清净，如是彼之相。","level":0,"quote":true},{"t":"心见有二种：世间、出世间；","level":0,"quote":true},{"t":"我执为流转，自觉是真如。","level":0,"quote":true},{"t":"无尽是涅槃，若尽贪及痴；","level":0,"quote":true},{"t":"觉彼是佛体，有情归依处。","level":0,"quote":true},{"t":"一切於此身，有智及无智；","level":0,"quote":true},{"t":"系缚自分别，由悟得解脱。","level":0,"quote":true},{"t":"菩提不远近，不来亦不去；","level":0,"quote":true},{"t":"坏灭及显现，於此烦恼网。","level":0,"quote":true},{"t":"说於众契经，住於自思惟；","level":0,"quote":true},{"t":"照以智慧灯，即得最胜寂。","level":0,"quote":true},{"t":"菩提不远想，亦无隣近想；","level":0,"quote":true},{"t":"是六境影像，皆由如是知。","level":0,"quote":true},{"t":"如水与乳合，同在於一器；","level":0,"quote":true},{"t":"鹅饮尽其乳，其水如常在。","level":0,"quote":true},{"t":"如是烦恼杂，智在於一器；","level":0,"quote":true},{"t":"瑜伽者饮智，弃舍於烦恼。","level":0,"quote":true},{"t":"如是我、我执，乃至所取执；","level":0,"quote":true},{"t":"若见二无我，有种而灭坏。","level":0,"quote":true},{"t":"是佛般涅槃，常恒净无垢；","level":0,"quote":true},{"t":"愚夫二分别，无二瑜伽句。","level":0,"quote":true},{"t":"种种难行施，以戒摄有情；","level":0,"quote":true},{"t":"一切损忍辱，界增此为三。","level":0,"quote":true},{"t":"於诸法精进，静虑心加行；","level":0,"quote":true},{"t":"常习於智慧，复得菩提增。","level":0,"quote":true},{"t":"方便共为慧，以愿皆清净；","level":0,"quote":true},{"t":"以力妙坚智，界增为四种。","level":0,"quote":true},{"t":"不应礼菩萨，此为甚恶说；","level":0,"quote":true},{"t":"不亲於菩萨，不生其法身。","level":0,"quote":true},{"t":"增於甘蔗种，欲食於石蜜；","level":0,"quote":true},{"t":"若坏甘蔗种，无由石蜜生。","level":0,"quote":true},{"t":"若护甘蔗种，三种而可得：","level":0,"quote":true},{"t":"糖、半糖、石蜜，於中必得生。","level":0,"quote":true},{"t":"若护菩提心，三种而可得：","level":0,"quote":true},{"t":"罗汉、缘觉、佛，於中必得生。","level":0,"quote":true},{"t":"如护於稻芽，农夫必当护；","level":0,"quote":true},{"t":"如初胜解行，如来必作护。","level":0,"quote":true},{"t":"如白十五日，而见月轮形；","level":0,"quote":true},{"t":"如是胜解行，影现佛形相。","level":0,"quote":true},{"t":"如是初月轮，刹那刹那增；","level":0,"quote":true},{"t":"如是入地者，念念见增益。","level":0,"quote":true},{"t":"如白十五日，月轮得圆满；","level":0,"quote":true},{"t":"如是究竟地，法身而得生。","level":0,"quote":true},{"t":"胜解彼坚固，常当於佛法；","level":0,"quote":true},{"t":"能发如是心，得为不退转。","level":0,"quote":true},{"t":"染依得转依，得受为净依；","level":0,"quote":true},{"t":"由分得觉悟，名为极喜地。","level":0,"quote":true},{"t":"常时於染污，欲等种种垢；","level":0,"quote":true},{"t":"无垢得清净，名为离垢地。","level":0,"quote":true},{"t":"灭坏烦恼网，照耀得离垢；","level":0,"quote":true},{"t":"无量之暗瞑，离名发光地。","level":0,"quote":true},{"t":"清净常光明，远离世吉祥；","level":0,"quote":true},{"t":"围遶智慧焰，名为焰慧地。","level":0,"quote":true},{"t":"一切明工技，种种静虑饰；","level":0,"quote":true},{"t":"难胜於烦恼，得胜难胜地。","level":0,"quote":true},{"t":"於三种菩提，摄受令成就；","level":0,"quote":true},{"t":"生灭於甚深，名为现前地。","level":0,"quote":true},{"t":"游戏於光网，遍以帝释严；","level":0,"quote":true},{"t":"超越欲暴流，名为远行地。","level":0,"quote":true},{"t":"一切佛加持，预入於智海；","level":0,"quote":true},{"t":"自在无功用，不动於魔使。","level":0,"quote":true},{"t":"於诸无碍解，瑜伽到彼岸；","level":0,"quote":true},{"t":"於说法谈论，名为善慧地。","level":0,"quote":true},{"t":"身以智所成，如虚空无垢；","level":0,"quote":true},{"t":"诸佛皆所持，普遍如法云。","level":0,"quote":true},{"t":"佛法之所依，行果皆所持；","level":0,"quote":true},{"t":"所依皆得转，故名为法身。","level":0,"quote":true},{"t":"离不思议熏，及离流转习，","level":0,"quote":true},{"t":"如汝思思者，云何而得知？","level":0,"quote":true},{"t":"超过诸语境，一切根非境；","level":0,"quote":true},{"t":"意识所取者，如所有我体。","level":0,"quote":true},{"t":"次第而积集，佛子大名称；","level":0,"quote":true},{"t":"皆以法云智，微细见法性。","level":0,"quote":true},{"t":"尔时洗濯心，超渡生死海；","level":0,"quote":true},{"t":"彼以大莲花，安立为大座。","level":0,"quote":true},{"t":"无量宝叶光，宝光明为台；","level":0,"quote":true},{"t":"无量亿莲花，普遍为眷属。","level":0,"quote":true},{"t":"先以十种力，以无畏四种，","level":0,"quote":true},{"t":"餘佛不共法，大自在而坐。","level":0,"quote":true},{"t":"一切善皆集，福智以资粮；","level":0,"quote":true},{"t":"圆月在星宿，遍满而围遶。","level":0,"quote":true},{"t":"则以佛日手，以宝光无垢；","level":0,"quote":true},{"t":"灌顶於长子，普遍皆令灌。","level":0,"quote":true},{"t":"彼住大瑜伽，皆见以天眼；","level":0,"quote":true},{"t":"无明搅扰世，恶习苦怖畏。","level":0,"quote":true},{"t":"状如金光色，从彼瑜伽光；","level":0,"quote":true},{"t":"彼无知所覆，得开无明门。","level":0,"quote":true},{"t":"以福智感招，彼获无执定；","level":0,"quote":true},{"t":"随缘而圆寂，心得皆变化。","level":0,"quote":true},{"t":"诸法无自性，自性於境界；","level":0,"quote":true},{"t":"菩萨王妙见，法身妙无垢。","level":0,"quote":true},{"t":"皆以无垢身，安住於智海；","level":0,"quote":true},{"t":"即作众生利，如巧摩尼珠。","level":0,"quote":true},{"t":"一切瑜伽者，大瑜伽自在；","level":0,"quote":true},{"t":"佛影皆变化，遍满而流出。","level":0,"quote":true},{"t":"或有八臂者，三目炽盛身；","level":0,"quote":true},{"t":"彼皆瑜伽王，普遍而流出。","level":0,"quote":true},{"t":"皆以慈悲手，胜喜执持弓；","level":0,"quote":true},{"t":"射以般若箭，皆断细无明。","level":0,"quote":true},{"t":"以大力升进，执持智慧棒；","level":0,"quote":true},{"t":"一切无明<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00592.gif\" alt=\"㲉\" title=\"㲉\" />，普遍皆碎坏。","level":0,"quote":true},{"t":"强力诸有情，金刚炽盛身；","level":0,"quote":true},{"t":"调伏有情故，则为金刚手。","level":0,"quote":true},{"t":"自为作业者，示现种种果；","level":0,"quote":true},{"t":"教诫如教理，变为平等王。","level":0,"quote":true},{"t":"饥渴猛炽身，能施诸饮食；","level":0,"quote":true},{"t":"常患诸疾者，则为善医王。","level":0,"quote":true},{"t":"魔王於营从，魔女於庄严；","level":0,"quote":true},{"t":"菩萨作亲友，能施菩提场。","level":0,"quote":true},{"t":"由如日月形，彼光皆悦意；","level":0,"quote":true},{"t":"流出如电光，照曜俱胝刹。","level":0,"quote":true}],[{"t":"由以一灯故，遍照皆得然；","level":0,"quote":true},{"t":"若一灯灭尽，一切皆随尽。","level":0,"quote":true},{"t":"如是异熟佛，示现种种光；","level":0,"quote":true},{"t":"一化现涅槃，餘佛示归寂。","level":0,"quote":true},{"t":"一亦无灭度，日光岂作暗？","level":0,"quote":true},{"t":"常现於出没，示现刹土海。","level":0,"quote":true},{"t":"於无智暗世，能净智慧眼；","level":0,"quote":true},{"t":"往於俱胝刹，矜愍化有情。","level":0,"quote":true},{"t":"彼皆不疲倦，由彼大慈甲；","level":0,"quote":true},{"t":"一切於神足，瑜伽皆彼岸。","level":0,"quote":true},{"t":"皆观时、非时，令彼得流转；","level":0,"quote":true},{"t":"刚强於谄曲，暂时而弃舍。","level":0,"quote":true},{"t":"无量调有情，顿作令清净；","level":0,"quote":true},{"t":"无量佛变化，顿时得暂变。","level":0,"quote":true},{"t":"於三界海中，而掷调伏网；","level":0,"quote":true},{"t":"舒展妙法网，普遍令成熟。","level":0,"quote":true},{"t":"则以调伏网，普遍令成熟；","level":0,"quote":true},{"t":"普遍令举出，於中漂流者。","level":0,"quote":true},{"t":"则如千有情，普遍令度已；","level":0,"quote":true},{"t":"度已令觉悟，妙法不生疑。","level":0,"quote":true},{"t":"世尊妙法铃，普遍令得闻；","level":0,"quote":true},{"t":"由此振声故，除落烦恼尘。","level":0,"quote":true},{"t":"增上无明人，令净於一时；","level":0,"quote":true},{"t":"以日光明威，破坏众翳瞙。","level":0,"quote":true},{"t":"随从暗烦恼，及餘罪身者；","level":0,"quote":true},{"t":"令彼作利益，积渐令清净。","level":0,"quote":true},{"t":"彼彼人现化，安住如水月，","level":0,"quote":true},{"t":"烦恼搅扰心，不见於如来，","level":0,"quote":true},{"t":"如饿鬼於海，普遍见枯竭，","level":0,"quote":true},{"t":"如是少福者，无佛作分别。","level":0,"quote":true},{"t":"有情少福者，如来云何作？","level":0,"quote":true},{"t":"如於生盲手，安以最胜宝。","level":0,"quote":true},{"t":"云何而能见，无上之法身？","level":0,"quote":true},{"t":"俱胝日光身，光网以围遶。","level":0,"quote":true},{"t":"诸天以少善，不能而得见；","level":0,"quote":true},{"t":"上次於大天，云何而得见？","level":0,"quote":true},{"t":"彼色不能见，诸仙离烦恼；","level":0,"quote":true},{"t":"天、修罗、梵等，云何餘少慧？","level":0,"quote":true},{"t":"然以佛威力，清净自心故；","level":0,"quote":true},{"t":"能见如是类，获得一切盛。","level":0,"quote":true},{"t":"有情福端严，佛住彼人前；","level":0,"quote":true},{"t":"光明照耀身，三十二胜相。","level":0,"quote":true},{"t":"彼如是丈夫，当见如大海；","level":0,"quote":true},{"t":"不经於多时，即得智如海。","level":0,"quote":true},{"t":"世尊彼色身，安住於多劫；","level":0,"quote":true},{"t":"能调可调利，趣於戒种类。","level":0,"quote":true},{"t":"广寿大瑜伽，少寿何因故？","level":0,"quote":true},{"t":"多人俱胝餘，示现增减寿。","level":0,"quote":true},{"t":"无量俱胝劫，以命命增长；","level":0,"quote":true},{"t":"因缘皆无尽，获得无尽果。","level":0,"quote":true},{"t":"若有相应显此理，唯身以慧作分析；","level":0,"quote":true},{"t":"彼人生於净莲花，闻法所说无量寿。","level":0,"quote":true},{"t":"百千诵大集经地藏菩萨请问法身赞","level":0}]]