{"id":"d8942","title":"四家錄","titleTrad":"四家錄","byline":"元 釋海島編","bylineLabel":"著者·译者","dynasty":"","division":"史传部","canon":"D8942","canonName":"國圖善本佛典","volume":"D8942","juanCount":4,"textLength":39093,"imageCount":0,"summary":"","tags":["史传部","國圖善本佛典"],"order":2058,"guide":"","chunks":15,"toc":[{"level":3,"text":"天童宏智覺和尚頌古集序"},{"level":3,"text":"雪竇明覺和尚頌古集序"},{"level":3,"text":"新刊四家錄後序"},{"level":3,"text":"路直趣閫域敢祈大手茟裝󷓅為後序"},{"level":3,"text":"投子山青和尚頌古集序"},{"level":3,"text":"年四月望日龍眠李沖元序"},{"level":3,"text":"丹霞山淳禪師頌古集序"},{"level":3,"text":"後序丹霞山淳禪󷃪頌古序"},{"level":3,"text":"知音相證據。謹序"}],"chunksPerFile":20}