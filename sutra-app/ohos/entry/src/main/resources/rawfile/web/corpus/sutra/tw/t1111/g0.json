[[{"t":"青頸觀自在菩薩心陀羅尼經唐 不空注","level":0},{"t":"No. 1111 [cf. Nos. 1112, 1113]青頸觀自在菩薩心陀羅尼經","level":0},{"t":"爾時世尊於毘沙門天王宮，說觀自在菩薩","level":0,"quote":true},{"t":"往昔因緣：「過去無量無邊阿僧祇劫，有佛名","level":0,"quote":true},{"t":"觀照觀察如來，成佛道已，住二十七日說法。","level":0,"quote":true},{"t":"臨涅槃時，有一天子名曰越那羅延力。爾時","level":0,"quote":true},{"t":"如來為彼說此青頸觀自在菩薩心真言。時","level":0,"quote":true},{"t":"彼天子纔聞，獲得大悲三摩地，作是願言：『所","level":0,"quote":true},{"t":"有一切眾生，若有怖畏厄難，聞我名者皆得","level":0,"quote":true},{"t":"離苦解脫，速證無上正等菩提。寧一稱觀自","level":0,"quote":true},{"t":"在菩薩名字號，不稱百千諸恒沙如來名。』」","level":0,"quote":true},{"t":"爾時，世尊復告毘沙門天王言：「當知此天子，","level":0,"quote":true},{"t":"於我滅度後，以此心真言流轉，廣作佛事，利","level":0,"quote":true},{"t":"益無邊眾生，安置無上菩提之道。陀羅尼曰：","level":0,"quote":true},{"t":"「。」","level":0,"quote":true},{"t":"大興善寺三藏沙門大廣智不空奉","level":0,"quote":true},{"t":"詔注釋義","level":0,"quote":true},{"t":"「曩謨羅怛曩怛羅夜也曩莫阿里也嚩路枳帝濕嚩囉","level":0,"quote":true},{"t":"也冒地薩怛嚩也摩賀薩怛嚩也摩訶迦嚕抳迦也薩嚩滿馱曩","level":0,"quote":true},{"t":"砌娜曩迦羅也薩嚩婆嚩娑悶訥嚕醋灑拏迦羅也薩","level":0,"quote":true},{"t":"嚩弭也地鉢羅捨麼曩迦羅也","level":0,"quote":true},{"t":"薩吠底庾鉢捺囉嚩尾曩捨曩迦羅","level":0,"quote":true},{"t":"也薩嚩婆曳數怛囉拏","level":0,"quote":true},{"t":"也怛寫曩莫娑訖哩怛嚩伊娜麼","level":0,"quote":true},{"t":"哩也嚩路枳帝濕嚩羅","level":0,"quote":true},{"t":"多嚩<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />攞蹇綻曩摩紇哩乃也","level":0,"quote":true},{"t":"麼嚩多以灑弭薩嚩他","level":0,"quote":true},{"t":"娑馱南輸<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01215.gif\" alt=\"𠰢\" title=\"𠰢\" />阿逝問薩","level":0,"quote":true},{"t":"嚩步多南婆縛沫<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00069.gif\" alt=\"㗚\" title=\"㗚\" />誐尾戍馱劍","level":0,"quote":true},{"t":"怛儞也他唵阿路計","level":0,"quote":true},{"t":"阿路迦麼底路迦底訖󰪯帝","level":0,"quote":true},{"t":"呬呬賀<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00942.gif\" alt=\"㘑\" title=\"㘑\" />摩賀󰂛地薩怛嚩係󰂛","level":0,"quote":true},{"t":"地薩怛嚩鉢哩也󰂛地薩怛嚩","level":0,"quote":true},{"t":"係迦嚕抳迦娑麼羅訖哩","level":0,"quote":true},{"t":"乃閻呬呬賀<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00942.gif\" alt=\"㘑\" title=\"㘑\" />阿哩也嚩路","level":0,"quote":true},{"t":"枳帝濕嚩囉摩係濕嚩羅跛羅摩每怛羅唧多麼賀迦嚕抳","level":0,"quote":true},{"t":"迦矩嚕羯摩娑馱也娑馱也尾淰","level":0,"quote":true},{"t":"禰呬禰呬禰呬銘嚩<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00771.gif\" alt=\"㘕\" title=\"㘕\" />迦","level":0,"quote":true},{"t":"懵誐底尾怛誐麼尾誐麼悉","level":0,"quote":true},{"t":"馱裕儗濕嚩囉度嚕度嚕尾","level":0,"quote":true},{"t":"演底摩訶尾演底馱羅馱羅馱連","level":0,"quote":true},{"t":"捺連濕嚩囉左攞左攞尾","level":0,"quote":true},{"t":"麼攞麼攞沒<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00069.gif\" alt=\"㗚\" title=\"㗚\" />帝阿哩也","level":0,"quote":true},{"t":"嚩路枳帝濕嚩囉爾曩訖哩史拏","level":0,"quote":true},{"t":"惹吒<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03814.gif\" alt=\"𮂽\" title=\"𮂽\" />矩吒嚩覽摩鉢羅","level":0,"quote":true},{"t":"覽摩摩賀悉馱尾儞也馱羅","level":0,"quote":true},{"t":"摩羅摩羅摩賀摩羅沫羅沫羅","level":0,"quote":true},{"t":"摩賀沫羅左羅左羅摩賀左羅訖哩史拏󰽣囉拏訖哩史拏","level":0,"quote":true},{"t":"博乞灑涅伽多曩係","level":0,"quote":true},{"t":"摩賀鉢納麼賀娑多左羅左羅","level":0,"quote":true},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />舍左<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00942.gif\" alt=\"㘑\" title=\"㘑\" />濕嚩羅訖哩","level":0,"quote":true},{"t":"史拏薩波訖哩多演女跛尾","level":0,"quote":true},{"t":"多曀醯呬摩賀嚩囉賀穆佉底哩補囉娜賀寧濕嚩羅","level":0,"quote":true},{"t":"曩羅也拏嚕跛摩羅吠誐馱哩係<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />攞蹇<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01245.gif\" alt=\"𡛥\" title=\"𡛥\" />係摩賀賀","level":0,"quote":true},{"t":"攞賀攞尾灑涅哩爾多路羯寫囉誐尾灑尾曩捨曩","level":0,"quote":true},{"t":"謨賀尾灑尾曩捨曩戶嚕戶嚕摩羅","level":0,"quote":true},{"t":"戶嚕賀<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00942.gif\" alt=\"㘑\" title=\"㘑\" />摩賀鉢納摩曩婆薩羅薩羅悉哩悉哩蘇","level":0,"quote":true},{"t":"嚕蘇嚕沒地也沒地野󰂛駄野","level":0,"quote":true},{"t":"󰂛馱野弭帝係<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />羅蹇姹曀醯呬","level":0,"quote":true},{"t":"嚩麼娑體多僧賀穆佉賀","level":0,"quote":true},{"t":"娑賀娑悶左悶左摩賀吒吒賀","level":0,"quote":true},{"t":"娑<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03799.gif\" alt=\"𪳮\" title=\"𪳮\" />呬暴摩賀悉馱裕儗濕","level":0,"quote":true},{"t":"嚩羅婆拏婆拏嚩簪","level":0,"quote":true},{"t":"娑馱也娑馱也尾淰娑麼羅娑","level":0,"quote":true},{"t":"麼羅擔婆誐挽耽路枳多尾路枳耽","level":0,"quote":true},{"t":"怛他蘖耽娜娜呬銘薩嚩","level":0,"quote":true},{"t":"薩怛嚩喃捺囉捨曩迦末寫捺","level":0,"quote":true},{"t":"羅捨喃鉢羅賀羅娜也摩諾娑","level":0,"quote":true},{"t":"嚩賀悉馱也娑嚩賀","level":0,"quote":true},{"t":"摩賀悉馱也娑嚩賀悉馱裕儗濕嚩","level":0,"quote":true},{"t":"羅也娑嚩賀<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />羅蹇姹也","level":0,"quote":true},{"t":"娑嚩賀嚩羅賀穆佉也娑嚩","level":0,"quote":true},{"t":"賀悉馱尾儞也馱羅也娑","level":0,"quote":true},{"t":"嚩賀鉢納麼賀娑跢也娑","level":0,"quote":true},{"t":"嚩賀訖哩史拏薩跛訖哩","level":0,"quote":true},{"t":"多演女跛尾多也娑嚩賀摩賀羅矩吒馱羅也娑嚩賀","level":0,"quote":true},{"t":"斫訖羅庾馱也娑嚩賀賞佉","level":0,"quote":true},{"t":"攝娜<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />󰂛馱曩也娑嚩賀","level":0,"quote":true},{"t":"嚩麼娑蹇馱禰捨娑體多訖哩","level":0,"quote":true},{"t":"史拏爾曩也娑嚩賀尾","level":0,"quote":true},{"t":"也伽羅拶麼<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />嚩薩曩也娑嚩","level":0,"quote":true},{"t":"賀路計濕嚩羅也娑嚩賀薩嚩悉第濕嚩羅也娑嚩賀","level":0,"quote":true},{"t":"曩謨婆誐嚩帝阿哩也嚩路枳帝濕","level":0,"quote":true},{"t":"嚩羅也󰂛地薩怛嚩也摩訶薩","level":0,"quote":true},{"t":"怛嚩也摩賀迦嚕抳迦也悉鈿","level":0,"quote":true},{"t":"覩滿怛羅跛娜也娑嚩賀","level":0,"quote":true},{"t":"「次當說此青頸觀自在菩薩畫像法。其像三","level":0,"quote":true},{"t":"面，當前正面作慈悲凞怡貌，右邊作師子面，","level":0,"quote":true},{"t":"左邊作猪面。首戴寶冠，冠中有化無量壽佛。","level":0,"quote":true},{"t":"又有四臂，右第一臂執杖，第二臂執把蓮花，","level":0,"quote":true},{"t":"左第一執輪，左第二執螺。以虎皮為裙，以黑","level":0,"quote":true},{"t":"鹿皮於左膊角絡，被黑蛇以為神線。於八葉","level":0,"quote":true},{"t":"蓮花上立，瓔珞臂釧鐶珮光焰莊嚴其身，其","level":0,"quote":true},{"t":"神線從左膊角絡下。","level":0,"quote":true},{"t":"「其青頸印：","level":0,"quote":true},{"t":"「二手外相叉，左大母指插入掌，右大母指直","level":0,"quote":true},{"t":"竪，二中指作蓮花葉形，二無名指直竪，二小","level":0,"quote":true},{"t":"指左押大竪相叉。」","level":0,"quote":true},{"t":"時寬延二己巳年七月中旬一挍了，後哲得","level":0,"quote":true},{"t":"善本以質而令盡美矣！􄙖􄦽乘無等","level":0,"quote":true},{"t":"校注過婆數拏","level":0,"quote":true},{"t":"也反嚩<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01215.gif\" alt=\"𠰢\" title=\"𠰢\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03877.gif\" alt=\"𬿯\" title=\"𬿯\" />問劍志鉢敏<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00942.gif\" alt=\"㘑\" title=\"㘑\" />嚕禰呬底室怛麼攞哩合格吒<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03814.gif\" alt=\"𮂽\" title=\"𮂽\" />佛推摩賀觀女言燒<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01245.gif\" alt=\"𡛥\" title=\"𡛥\" />青慈曩花所弭帝係令麼來住舍也諾德嚩賀悉二合福池以薩鈿覩一十被左大時寬延二己巳年七月中旬一挍了，後哲得","level":0,"quote":true},{"t":"善本以質而令盡美矣！􄙖􄦽乘無等CBETA 校注大正藏 校注新增校注","level":0,"quote":true}]]