{"id":"x1107","title":"律宗新學名句","titleTrad":"律宗新學名句","byline":"宋 惟顯編","bylineLabel":"著者·译者","dynasty":"","division":"密教部","canon":"X1107","canonName":"新纂卍續藏","volume":"X1107","juanCount":3,"textLength":36702,"imageCount":0,"summary":"","tags":["密教部","新纂卍續藏"],"order":524,"guide":"","chunks":17,"toc":[{"level":3,"text":"紹聖改元前安居日　沙門懷顯於法華蘭若集序"},{"level":3,"text":"分第五半月十二日中後一人半影為耶舍犯故"},{"level":3,"text":"冬分第二半月十日食後二人半影則當此間九"},{"level":3,"text":"月十日也第三戒同是六年冬分第三半月九日"},{"level":3,"text":"四戒同年冬分第四半月十三日食後三人半影"},{"level":3,"text":"不得說十三可至四事七不得說四事可說戒序"},{"level":2,"text":"轉變六往來七卷八"}],"chunksPerFile":20}