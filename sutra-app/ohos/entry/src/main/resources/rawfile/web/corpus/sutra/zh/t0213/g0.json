[[{"t":"法集要颂经有为品第一","level":3},{"t":"尊者法救集","level":0},{"t":"西天中印度惹烂駄啰国密林寺三藏明教大师赐紫沙门臣天息灾奉　诏译","level":0},{"t":"能觉悟烦恼，宜发欢喜心，","level":0,"quote":true},{"t":"今听我所集，佛所宣法颂。","level":0,"quote":true},{"t":"如是佛世尊，一切智中师，","level":0,"quote":true},{"t":"慈悲为有情，广说真实语。","level":0,"quote":true},{"t":"一切行非常，皆是兴衰法，","level":0,"quote":true},{"t":"夫生辄还终，寂灭最安乐。","level":0,"quote":true},{"t":"如烛炽焰时，掷物在暗处，","level":0,"quote":true},{"t":"不使智灯寻，恒为烦恼覆。","level":0,"quote":true},{"t":"人身有形器，弃散在诸方，","level":0,"quote":true},{"t":"骸骨如鸽色，观斯有何乐？","level":0,"quote":true},{"t":"譬如人初夜，识托住母胎，","level":0,"quote":true},{"t":"日涉多迁变，逝而定不还。","level":0,"quote":true},{"t":"晨朝覩好事，夜至则不现，","level":0,"quote":true},{"t":"昨所瞻视者，今夕则或无。","level":0,"quote":true},{"t":"荣富焰炽盛，无常无时节，","level":0,"quote":true},{"t":"不拣择贵贱，常被死王降。","level":0,"quote":true},{"t":"或有在胎殒，或初诞亦亡，","level":0,"quote":true},{"t":"盛壮不免死，老耄甘心受。","level":0,"quote":true},{"t":"若老或少年，及与中年者，","level":0,"quote":true},{"t":"恒被死来侵，云何不怀怖？","level":0,"quote":true},{"t":"命如菓自熟，常恐会零落，","level":0,"quote":true},{"t":"生已必有终，谁能免斯者？","level":0,"quote":true},{"t":"譬如陶家师，埏埴作坏器，","level":0,"quote":true},{"t":"诸有悉破坏，人命亦如是。","level":0,"quote":true},{"t":"如人弹琴瑟，具足众妙音，","level":0,"quote":true},{"t":"弦断无少声，人命亦如是。","level":0,"quote":true},{"t":"如囚被系缚，拘牵诣都市，","level":0,"quote":true},{"t":"动则向死路，寿命亦如是。","level":0,"quote":true},{"t":"如河急驶流，往而悉不还，","level":0,"quote":true},{"t":"人生亦如是，逝者皆不回。","level":0,"quote":true},{"t":"诸患集成身，生多众苦恼，","level":0,"quote":true},{"t":"人命亦如是，为老死所伺。","level":0,"quote":true},{"t":"所造成功劳，永世获安乐，","level":0,"quote":true},{"t":"如杖击急水，暂开还却合。","level":0,"quote":true},{"t":"如人操杖行，牧牛饮饲者，","level":0,"quote":true},{"t":"人命亦如是，亦即养命去。","level":0,"quote":true},{"t":"夫人欲立德，昼夜勿空过，","level":0,"quote":true},{"t":"既获得人身，一心思命尽。","level":0,"quote":true},{"t":"不寐觉夜长，疲倦道路长，","level":0,"quote":true},{"t":"愚迷生死长，希闻於妙法。","level":0,"quote":true},{"t":"有子兼有财，悭惜遇散坏，","level":0,"quote":true},{"t":"愚夫不自观，何恃有财子？","level":0,"quote":true},{"t":"百千非算数，族姓富男女，","level":0,"quote":true},{"t":"积聚多财产，无不皆衰灭。","level":0,"quote":true},{"t":"富贵非圣财，恒为无常伺，","level":0,"quote":true},{"t":"犹如盲眼人，不能自观察。","level":0,"quote":true},{"t":"聚集还散坏，崇高必坠落，","level":0,"quote":true},{"t":"生者皆尽终，有情亦如是。","level":0,"quote":true},{"t":"行恶入地狱，修善则生天，","level":0,"quote":true},{"t":"若能修善者，漏尽得涅槃。","level":0,"quote":true},{"t":"诸佛与菩萨，缘觉及声闻，","level":0,"quote":true},{"t":"尚舍有为身，何况诸有情？","level":0,"quote":true},{"t":"非空非海中，非入山窟间，","level":0,"quote":true},{"t":"无有地方所，脱止不受死。","level":0,"quote":true},{"t":"若住现在世，过去及未来，","level":0,"quote":true},{"t":"一切有为事，终归於尽坏。","level":0,"quote":true},{"t":"智者能离系，恒正念观察，","level":0,"quote":true},{"t":"常思无漏道，是名真智者。","level":0,"quote":true},{"t":"如囚被系缚，所欲无能益，","level":0,"quote":true},{"t":"亦如朽故车，不久见破坏。","level":0,"quote":true},{"t":"色变为老耄，恋家如在狱，","level":0,"quote":true},{"t":"不觉死来侵，愚夫不能知。","level":0,"quote":true},{"t":"虽寿满百岁，亦被死相随，","level":0,"quote":true},{"t":"为老病所逼，患终至后际。","level":0,"quote":true},{"t":"老至苦缠身，昼夜多痛恼，","level":0,"quote":true},{"t":"辛楚有千般，如鱼入灰火。","level":0,"quote":true},{"t":"江河无停止，驶流去不回，","level":0,"quote":true},{"t":"保惜脓漏躯，虽恋不能住。","level":0,"quote":true},{"t":"四大聚集身，无常讵久留，","level":0,"quote":true},{"t":"地种散坏时，神识空何用？","level":0,"quote":true},{"t":"此身多障恼，脓漏恒疾患，","level":0,"quote":true},{"t":"愚迷贪爱著，不厌求寂灭。","level":0,"quote":true},{"t":"今岁虽云在，冬夏不久停，","level":0,"quote":true},{"t":"凡夫贪世乐，中间不惊怖。","level":0,"quote":true},{"t":"父母与兄弟，妻子并眷属，","level":0,"quote":true},{"t":"无常来牵引，无能救济者。","level":0,"quote":true},{"t":"如是诸有情，举动贪荣乐，","level":0,"quote":true},{"t":"无常老病侵，不觉生苦恼。","level":0,"quote":true},{"t":"剃发为苾刍，宜应修止观，","level":0,"quote":true},{"t":"魔罗不能伺，度生到彼岸。","level":0,"quote":true}],[{"t":"法集要颂经爱欲品第二","level":3},{"t":"欲我知汝根，意以思想生，","level":0,"quote":true},{"t":"我不思惟汝，则汝欲不有。","level":0,"quote":true},{"t":"因欲生烦恼，因欲生怖畏，","level":0,"quote":true},{"t":"离欲得解脱，无怖无烦恼。","level":0,"quote":true},{"t":"从爱生烦恼，从爱生怖畏，","level":0,"quote":true},{"t":"离爱得解脱，无怖无烦恼。","level":0,"quote":true},{"t":"菓先甜后苦，爱欲亦如斯，","level":0,"quote":true},{"t":"后受地狱苦，烧煮无数劫。","level":0,"quote":true},{"t":"愚迷贪爱欲，恋著於妻子，","level":0,"quote":true},{"t":"为爱染缠缚，坚固难出离。","level":0,"quote":true},{"t":"贤圣示爱欲，庄严诸眷属，","level":0,"quote":true},{"t":"远离於妻子，坚固能利益。","level":0,"quote":true},{"t":"贪欲难解脱，离欲真出家，","level":0,"quote":true},{"t":"不贪受快乐，智者无所欲。","level":0,"quote":true},{"t":"世间贪欲人，种种非思惟，","level":0,"quote":true},{"t":"若能调伏者，是名真离欲。","level":0,"quote":true},{"t":"若人恒贪欲，处缚难解脱，","level":0,"quote":true},{"t":"唯慧能分别，烦恼断不生。","level":0,"quote":true},{"t":"正念常兴起，寂静欲易除，","level":0,"quote":true},{"t":"自制以法戒，不犯善增长。","level":0,"quote":true},{"t":"常行贪欲人，愚者共狎习，","level":0,"quote":true},{"t":"念定不放逸，次第获无漏。","level":0,"quote":true},{"t":"刹那修止观，能离诸罪垢，","level":0,"quote":true},{"t":"我慢自消除，解脱获安乐。","level":0,"quote":true},{"t":"若人不断欲，如皮入火烧，","level":0,"quote":true},{"t":"刹那见燋坏，受罪无央数。","level":0,"quote":true},{"t":"苾刍慎欲乐，放逸多忧愁，","level":0,"quote":true},{"t":"若离於爱欲，正念受快乐。","level":0,"quote":true},{"t":"无厌有何足？不足何有乐？","level":0,"quote":true},{"t":"无乐有何忧？有爱有何乐？","level":0,"quote":true},{"t":"寂静智慧足，能长无漏道，","level":0,"quote":true},{"t":"贪爱若不足，非法受中夭。","level":0,"quote":true},{"t":"见色心迷惑，不自观无常，","level":0,"quote":true},{"t":"愚以为美善，不知其非真。","level":0,"quote":true},{"t":"愚以贪自缚，不求度彼岸，","level":0,"quote":true},{"t":"贪财为爱欲，害人亦自缚。","level":0,"quote":true},{"t":"世容众妙欲，此欲最味少，","level":0,"quote":true},{"t":"若比天上乐，迦哩洒跛拏。","level":0,"quote":true},{"t":"众山尽为金，犹如铁围山，","level":0,"quote":true},{"t":"此犹无厌足，正觉尽能知。","level":0,"quote":true},{"t":"世间苦果报，皆因於贪欲，","level":0,"quote":true},{"t":"智者善调伏，应依此中学。","level":0,"quote":true}],[{"t":"法集要颂经贪品第三","level":3},{"t":"极贪善显现，有情怀疑虑，","level":0,"quote":true},{"t":"若复增贪意，自作坚固缚。","level":0,"quote":true},{"t":"离贪善观察，疑虑得消除，","level":0,"quote":true},{"t":"弃舍彼贪爱，坚固缚自坏。","level":0,"quote":true},{"t":"以欲网自弊，以爱盖自覆，","level":0,"quote":true},{"t":"愚情自恣缚，如鱼入钓手，","level":0,"quote":true},{"t":"死命恒来逼，如犊逐爱母。","level":0,"quote":true},{"t":"贪著放逸者，如猿逢果树，","level":0,"quote":true},{"t":"贪意甚坚牢，趣而还复趣。","level":0,"quote":true},{"t":"夫贪爱润泽，思想为滋蔓，","level":0,"quote":true},{"t":"贪欲深无底，老死是用增。","level":0,"quote":true},{"t":"贪欲多虚诳，贪欲怀悋惜，","level":0,"quote":true},{"t":"若以慧分别，正观获安乐。","level":0,"quote":true},{"t":"由贪受生死，奔波乐向前，","level":0,"quote":true},{"t":"群生无慧眼，不能自观察。","level":0,"quote":true},{"t":"愚迷贪所执，沈沦岂觉知？","level":0,"quote":true},{"t":"若修瑜伽行，魔王不能伺。","level":0,"quote":true},{"t":"贪垢难消释，如犊恋爱母，","level":0,"quote":true},{"t":"离贪免沈沦，离贪得解脱。","level":0,"quote":true},{"t":"因贪增喧诤，因爱饶毁谤，","level":0,"quote":true},{"t":"苾刍修止观，证得寂静果。","level":0,"quote":true},{"t":"贪意如良田，遇风雨增长，","level":0,"quote":true},{"t":"若远离贪爱，烦恼不能侵。","level":0,"quote":true},{"t":"贪欲若薄劣，如水滴莲上，","level":0,"quote":true},{"t":"彼烦恼易除，可说为智者。","level":0,"quote":true},{"t":"伐树不伐根，虽伐犹增长，","level":0,"quote":true},{"t":"拔贪不尽根，虽伐还复生。","level":0,"quote":true},{"t":"贪欲如种田，耕之去杂秽，","level":0,"quote":true},{"t":"爱苗若不耘，善果不坚贞。","level":0,"quote":true},{"t":"贪心与爱心，分别本不二，","level":0,"quote":true},{"t":"造恶俱苦受，云何不生悔？","level":0,"quote":true},{"t":"贪性初为种，爱性受胞胎，","level":0,"quote":true},{"t":"有情恋不息，往来难出离。","level":0,"quote":true},{"t":"诸天及人民，依爱而止住，","level":0,"quote":true},{"t":"爱往众结随，刹那亦不停，","level":0,"quote":true},{"t":"时过复生忧，入狱方自觉。","level":0,"quote":true},{"t":"缘流爱不住，欲网覆疮根，","level":0,"quote":true},{"t":"枝蔓增饥渴，数数增苦受。","level":0,"quote":true},{"t":"譬如自造箭，还自伤其体，","level":0,"quote":true},{"t":"内箭亦如是，爱箭伤有情。","level":0,"quote":true},{"t":"能觉知是者，爱苦共生有，","level":0,"quote":true},{"t":"无欲无有想，苾刍真度世。","level":0,"quote":true}],[{"t":"法集要颂经放逸品第四","level":3},{"t":"戒为甘露道，放逸为死径，","level":0,"quote":true},{"t":"不贪则不死，失道乃自丧。","level":0,"quote":true},{"t":"智者守道胜，终不为迷醉，","level":0,"quote":true},{"t":"不贪致喜乐，从是得圣道。","level":0,"quote":true},{"t":"恒思修善法，自守常坚固，","level":0,"quote":true},{"t":"智者求寂静，吉祥无有上。","level":0,"quote":true},{"t":"迷醉如自禁，能去之为贤，","level":0,"quote":true},{"t":"已升智慧堂，去危乃获安。","level":0,"quote":true},{"t":"智者观愚人，譬如山与地，","level":0,"quote":true},{"t":"当念舍憍慢，智者习明慧。","level":0,"quote":true},{"t":"发行不放逸，约己调伏心，","level":0,"quote":true},{"t":"能善作智灯，黑暗自破坏。","level":0,"quote":true},{"t":"正念常兴起，意静易灭除，","level":0,"quote":true},{"t":"自制以法命，不犯善名称。","level":0,"quote":true},{"t":"专意莫放逸，习意牟尼戒，","level":0,"quote":true},{"t":"不亲卑漏法，不与放逸会。","level":0,"quote":true},{"t":"不种邪见根，不於世增恶，","level":0,"quote":true},{"t":"正见增上道，世俗智所察。","level":0,"quote":true},{"t":"历於百千生，终不堕地狱，","level":0,"quote":true},{"t":"修习放逸人，愚人所狎习。","level":0,"quote":true},{"t":"止观不散乱，如财主守藏，","level":0,"quote":true},{"t":"莫贪乐鬪诤，亦勿嗜欲乐。","level":0,"quote":true},{"t":"思念不放逸，可以获大安，","level":0,"quote":true},{"t":"不为时自恣，能制漏得尽。","level":0,"quote":true},{"t":"放逸魔得便，如师子搏鹿，","level":0,"quote":true},{"t":"放逸有四事，好犯他人妇，","level":0,"quote":true},{"t":"初狱二尠福，毁三睡眠四。","level":0,"quote":true},{"t":"无福利堕恶，畏而畏乐寡，","level":0,"quote":true},{"t":"王法加重罪，身死入地狱。","level":0,"quote":true},{"t":"本情不自造，情知不自为，","level":0,"quote":true},{"t":"不虑邪径路，愚者念力求。","level":0,"quote":true},{"t":"智者喻明灯，暗者从得烛，","level":0,"quote":true},{"t":"示导世间人，如目将无目。","level":0,"quote":true},{"t":"若所作不善，如彼无目人，","level":0,"quote":true},{"t":"涉道甚艰难，路险怀恐怖。","level":0,"quote":true},{"t":"善法若增长，魔罗不得便，","level":0,"quote":true},{"t":"漏尽证寂灭，可获真实果。","level":0,"quote":true},{"t":"恶法若增长，魔罗常伺便，","level":0,"quote":true},{"t":"失彼寂灭道，受苦无穷尽。","level":0,"quote":true},{"t":"所谓持法者，不必多诵习，","level":0,"quote":true},{"t":"若少有所闻，具足法身行。","level":0,"quote":true},{"t":"虽诵习多义，放逸不从正，","level":0,"quote":true},{"t":"如牧数他牛，难获沙门果。","level":0,"quote":true},{"t":"若闻恶而忍，说行人赞叹，","level":0,"quote":true},{"t":"消除贪瞋痴，彼获沙门性。","level":0,"quote":true},{"t":"赞叹不放逸，毁彼放逸人，","level":0,"quote":true},{"t":"恒获人天报，最上为殊胜。","level":0,"quote":true},{"t":"若人不放逸，智者所赞叹，","level":0,"quote":true},{"t":"所作善增长，能生诸善法。","level":0,"quote":true},{"t":"若行放逸者，现法无能益，","level":0,"quote":true},{"t":"安情如不动，尔乃说为智。","level":0,"quote":true},{"t":"苾刍怀谨慎，放逸多忧愆，","level":0,"quote":true},{"t":"如象拔淤泥，难救深海苦。","level":0,"quote":true},{"t":"苾刍怀谨慎，放逸多忧愆，","level":0,"quote":true},{"t":"抖擞诸罪尘，如风飘落叶。","level":0,"quote":true},{"t":"苾刍怀谨慎，放逸多忧愆，","level":0,"quote":true},{"t":"结使深缠缚，如火焚枯薪。","level":0,"quote":true},{"t":"苾刍怀谨慎，放逸多忧愆，","level":0,"quote":true},{"t":"各各顺次第，得尽诸结使。","level":0,"quote":true},{"t":"苾刍怀谨慎，放逸多忧愆，","level":0,"quote":true},{"t":"义解分别句，寂静永安宁。","level":0,"quote":true},{"t":"苾刍怀谨慎，放逸多忧愆，","level":0,"quote":true},{"t":"烦恼若消除，能得涅槃乐。","level":0,"quote":true},{"t":"放逸不发起，善法应须修，","level":0,"quote":true},{"t":"今世至后世，得行法快乐。","level":0,"quote":true},{"t":"放逸不发起，烦恼自然伏，","level":0,"quote":true},{"t":"善法坚习学，决定得涅槃。","level":0,"quote":true},{"t":"长行於放逸，刹那无暂息，","level":0,"quote":true},{"t":"命终入地狱，刹那亦无歇。","level":0,"quote":true},{"t":"放逸不忆念，亦不习威仪，","level":0,"quote":true},{"t":"耽睡不相应，此是戒障碍。","level":0,"quote":true},{"t":"常离不相应，使不坏其念，","level":0,"quote":true},{"t":"犹念恒调伏，尘垢得消除。","level":0,"quote":true},{"t":"苾刍怀谨慎，持戒勿破坏，","level":0,"quote":true},{"t":"善守护自心，今世及后世。","level":0,"quote":true},{"t":"苾刍勿放逸，舍家顺佛教，","level":0,"quote":true},{"t":"抖擞无常军，如象出莲池。","level":0,"quote":true},{"t":"依此毘尼法，不怀放逸行，","level":0,"quote":true},{"t":"消除生死轮，永得尽苦恼。","level":0,"quote":true}],[{"t":"法集要颂经爱乐品第五","level":3},{"t":"爱处生忧愁，爱处生怖畏，","level":0,"quote":true},{"t":"若无所爱乐，何愁何怖畏？","level":0,"quote":true},{"t":"由爱生忧愁，由爱生怖畏，","level":0,"quote":true},{"t":"若远离念爱，遂舍狂乱终。","level":0,"quote":true},{"t":"夫人怀忧愁，世苦无数量，","level":0,"quote":true},{"t":"斯由念恩爱，无念则无愁。","level":0,"quote":true},{"t":"是故不生念，念者是恶累，","level":0,"quote":true},{"t":"彼则无诸缚，无念无不念。","level":0,"quote":true},{"t":"念为求方便，非义不设权，","level":0,"quote":true},{"t":"权慧致大义，自致第一尊。","level":0,"quote":true},{"t":"莫与爱念会，亦莫不念俱，","level":0,"quote":true},{"t":"念爱不见苦，不爱念忧戚，","level":0,"quote":true},{"t":"於中生愁戚，消灭人善根。","level":0,"quote":true},{"t":"爱念就后世，朋友多亲眷，","level":0,"quote":true},{"t":"长夜忧愁恨，念离为甚苦。","level":0,"quote":true},{"t":"念色金色容，天身而别住，","level":0,"quote":true},{"t":"乐极而害至，为死王所录。","level":0,"quote":true},{"t":"若人处昼夜，消灭念爱色，","level":0,"quote":true},{"t":"自掘深根源，不越死径路。","level":0,"quote":true},{"t":"不善形善色，爱色言非爱，","level":0,"quote":true},{"t":"若谓乐著色，放逸之所使。","level":0,"quote":true},{"t":"夫自念欲者，不与恶共居，","level":0,"quote":true},{"t":"此则难获得，乐为恶根本。","level":0,"quote":true},{"t":"夫欲自念者，宜自善守护，","level":0,"quote":true},{"t":"如防护边城，乃牢固墙堑。","level":0,"quote":true},{"t":"夫欲自念者，藏己仍坚密，","level":0,"quote":true},{"t":"犹如防边城，内外悉牢固。","level":0,"quote":true},{"t":"当自善防护，后刹那虚悔，","level":0,"quote":true},{"t":"时过则生忧，须臾堕地狱。","level":0,"quote":true},{"t":"徧於诸方求，令心中间察，","level":0,"quote":true},{"t":"颇有斯等类，不爱乃爱彼。","level":0,"quote":true},{"t":"以己喻彼命，是故不害人，","level":0,"quote":true},{"t":"一切皆惧死，莫不畏刀杖，","level":0,"quote":true},{"t":"恕己可为喻，勿杀勿行杖。","level":0,"quote":true},{"t":"譬如久行人，从远吉却还，","level":0,"quote":true},{"t":"亲厚亦安和，归来怀庆悦。","level":0,"quote":true},{"t":"好福行善者，从此达於彼，","level":0,"quote":true},{"t":"自受多福祚，如亲厚来喜。","level":0,"quote":true},{"t":"起从至圣教，禁制不善心，","level":0,"quote":true},{"t":"近者则见爱，离道莫亲爱。","level":0,"quote":true},{"t":"近者与不近，所往皆有异，","level":0,"quote":true},{"t":"近道则生天，不近堕地狱。","level":0,"quote":true},{"t":"乐法戒成就，成信乐而习，","level":0,"quote":true},{"t":"能诫自身者，为人所爱敬。","level":0,"quote":true},{"t":"为人所敬故，皆由己所造，","level":0,"quote":true},{"t":"现世得名誉，后生於天上。","level":0,"quote":true},{"t":"教习使禀受，制止非法行，","level":0,"quote":true},{"t":"善者之所念，恶者当远离。","level":0,"quote":true},{"t":"善与不善者，此二俱不别，","level":0,"quote":true},{"t":"善者生天上，不善堕地狱。","level":0,"quote":true}],[{"t":"法集要颂经持戒品第六","level":3},{"t":"智者能护戒，福致三种报，","level":0,"quote":true},{"t":"现名闻得利，终后生天上。","level":0,"quote":true},{"t":"当见持戒者，护之为明智，","level":0,"quote":true},{"t":"得成真正见，彼获世安静。","level":0,"quote":true},{"t":"持戒得快乐，令身无烦恼，","level":0,"quote":true},{"t":"夜睡眠恬淡，寤则长喜悦。","level":0,"quote":true},{"t":"戒终老死安，戒善止亦宁，","level":0,"quote":true},{"t":"慧为人之宝，福德贼难脱。","level":0,"quote":true},{"t":"何法终为善？何法善安止？","level":0,"quote":true},{"t":"何法为人宝？何盗不能取？","level":0,"quote":true},{"t":"戒法终为安，戒法善安止，","level":0,"quote":true},{"t":"慧为人之宝，唯福不能盗。","level":0,"quote":true},{"t":"修戒行布施，作福为良田，","level":0,"quote":true},{"t":"从是至彼岸，常到安乐处。","level":0,"quote":true},{"t":"苾刍立戒德，守护诸根门，","level":0,"quote":true},{"t":"饮食知节量，寤寐意相应。","level":0,"quote":true},{"t":"意常生觉悟，昼夜精勤学，","level":0,"quote":true},{"t":"漏尽心明解，可致圆寂道。","level":0,"quote":true},{"t":"智者立禁戒，专心习智慧，","level":0,"quote":true},{"t":"苾刍无热恼，尽果诸苦除。","level":0,"quote":true},{"t":"以戒常伏心，守护正定意，","level":0,"quote":true},{"t":"内学修止观，无忘为正智。","level":0,"quote":true},{"t":"蠲除诸罪垢，尽慢勿生疑，","level":0,"quote":true},{"t":"终身求法戒，勿远离圣念。","level":0,"quote":true},{"t":"戒定慧解脱，应当善观察，","level":0,"quote":true},{"t":"彼已离尘垢，尽烦恼不生。","level":0,"quote":true},{"t":"集白净解脱，无智皆以尽，","level":0,"quote":true},{"t":"超越魔罗界，如日光明照。","level":0,"quote":true},{"t":"我慢及迷醉，苾刍应外避，","level":0,"quote":true},{"t":"戒定慧三行，求满勿远离。","level":0,"quote":true},{"t":"既不放自恣，诸有勿想念，","level":0,"quote":true},{"t":"是故舍阴盖，不生如是障。","level":0,"quote":true},{"t":"苾刍防禁戒，恒见学此者，","level":0,"quote":true},{"t":"直趣涅槃路，速得净如是。","level":0,"quote":true},{"t":"花香不逆风，芙蓉栴檀香，","level":0,"quote":true},{"t":"德香逆风薰，德人徧闻香。","level":0,"quote":true},{"t":"乌钵嚩哩史，多誐罗栴檀，","level":0,"quote":true},{"t":"如是等花香，勿比於戒香。","level":0,"quote":true},{"t":"若人能持戒，清净不放逸，","level":0,"quote":true},{"t":"正智得解脱，是名安乐处。","level":0,"quote":true},{"t":"此道无有上，消除禅定魔，","level":0,"quote":true},{"t":"贤圣德难量，得达八正路。","level":0,"quote":true}],[{"t":"法集要颂经善行品第七","level":3},{"t":"守护身恶行，自正护身行，","level":0,"quote":true},{"t":"守护身恶者，常修身善行。","level":0,"quote":true},{"t":"守护口恶行，自正护口行，","level":0,"quote":true},{"t":"守护口恶者，常修口善行。","level":0,"quote":true},{"t":"守护意恶行，自正护意行，","level":0,"quote":true},{"t":"守护意恶者，恒修意善行。","level":0,"quote":true},{"t":"身当弃恶行，及弃口恶行，","level":0,"quote":true},{"t":"意亦弃恶行，及诸秽恶法。","level":0,"quote":true},{"t":"身当修善行，修口善亦然，","level":0,"quote":true},{"t":"及修意善者，无欲尽诸漏。","level":0,"quote":true},{"t":"身当修善行，修口意亦尔，","level":0,"quote":true},{"t":"今世及后世，永得生善处。","level":0,"quote":true},{"t":"慈仁行不杀，常能善摄身，","level":0,"quote":true},{"t":"彼得无尽位，所适皆无患。","level":0,"quote":true},{"t":"不行杀为仁，常能慎过言，","level":0,"quote":true},{"t":"彼得无尽位，所适皆无患。","level":0,"quote":true},{"t":"过去身恶业，应当自悔恨，","level":0,"quote":true},{"t":"今身不放逸，智生罪除灭。","level":0,"quote":true},{"t":"过去口恶业，应当自悔恨，","level":0,"quote":true},{"t":"今若不妄语，智生罪除灭。","level":0,"quote":true},{"t":"过去意恶业，应当自悔恨，","level":0,"quote":true},{"t":"今意常清净，智生罪除灭。","level":0,"quote":true},{"t":"慎身为勇捍，慎口捍亦然，","level":0,"quote":true},{"t":"慎意为勇捍，一切结亦然。","level":0,"quote":true},{"t":"此处名不死，所适无忧患，","level":0,"quote":true},{"t":"护身为善哉，护口善亦然。","level":0,"quote":true},{"t":"护意为善哉，护一切亦然，","level":0,"quote":true},{"t":"苾刍护一切，能尽诸苦际。","level":0,"quote":true},{"t":"护口意清净，身终不为恶，","level":0,"quote":true},{"t":"能净此三业，是道大仙说。","level":0,"quote":true}],[{"t":"法集要颂经语言品第八","level":3},{"t":"妄语入地狱，作之言不作，","level":0,"quote":true},{"t":"二罪后俱受，是行自牵去。","level":0,"quote":true},{"t":"恒怀暴恶人，斧在口中出，","level":0,"quote":true},{"t":"所以自伤身，由其出恶言。","level":0,"quote":true},{"t":"说法自悦人，口出无量义，","level":0,"quote":true},{"t":"使我怀妊身，不惭此仪式。","level":0,"quote":true},{"t":"誉恶恶还誉，是二俱为恶，","level":0,"quote":true},{"t":"好以口快鬪，彼后皆无安。","level":0,"quote":true},{"t":"争为微少利，如掩失财宝，","level":0,"quote":true},{"t":"从彼致鬪诤，合意向恶道。","level":0,"quote":true},{"t":"百千尼罗浮，三十六五狱，","level":0,"quote":true},{"t":"诽谤贤圣者，口意发恶愿。","level":0,"quote":true},{"t":"无道堕恶道，自增地狱苦，","level":0,"quote":true},{"t":"远愚修忍意，念谛则无犯。","level":0,"quote":true},{"t":"若倚内宝藏，依贤圣活命，","level":0,"quote":true},{"t":"愚者堕恶道，犹愿邪见作。","level":0,"quote":true},{"t":"以失今良会，更立誓愿求，","level":0,"quote":true},{"t":"终不见圣谛，况欲见究竟？","level":0,"quote":true},{"t":"竹芦生实乾，还害其自躯，","level":0,"quote":true},{"t":"若吐言当善，不演恶法教。","level":0,"quote":true},{"t":"从善得解脱，为恶不得解，","level":0,"quote":true},{"t":"善解者为贤，是为脱恶趣。","level":0,"quote":true},{"t":"圣贤解不然，如彼愚得解，","level":0,"quote":true},{"t":"苾刍挹损意，不躁言得忠。","level":0,"quote":true},{"t":"义说如法说，所语言柔软，","level":0,"quote":true},{"t":"善说贤圣教，法说如法二，","level":0,"quote":true},{"t":"念说如念三，谛说如谛四。","level":0,"quote":true},{"t":"是以言语者，必使心无患，","level":0,"quote":true},{"t":"亦不尅有情，是为能善言。","level":0,"quote":true},{"t":"言使投意可，亦令得欢喜，","level":0,"quote":true},{"t":"不使至恶意，出言众悉可。","level":0,"quote":true},{"t":"至诚甘露说，说法无有上，","level":0,"quote":true},{"t":"谛说义如法，是为立道本。","level":0,"quote":true},{"t":"如说佛言者，是吉得灭度，","level":0,"quote":true},{"t":"为能断苦际，是谓言中上。","level":0,"quote":true}],[{"t":"法集要颂经业品第九","level":3},{"t":"应远离一法，所谓妄语人，","level":0,"quote":true},{"t":"无恶不经历，不免后世苦。","level":0,"quote":true},{"t":"宁吞热铁丸，渴饮洋铜汁，","level":0,"quote":true},{"t":"不以无戒身，食人信施物。","level":0,"quote":true},{"t":"犯戒放逸人，国中如肉团，","level":0,"quote":true},{"t":"无惭不畏罪，后受地狱殃。","level":0,"quote":true},{"t":"若人畏苦报，亦不乐行苦，","level":0,"quote":true},{"t":"勿造诸恶行，念寻生变悔。","level":0,"quote":true},{"t":"至诚为诸恶，自作教他作，","level":0,"quote":true},{"t":"不免於苦报，欲避有何益？","level":0,"quote":true},{"t":"非空非海中，非入山石间，","level":0,"quote":true},{"t":"莫能於此处，避免宿恶殃。","level":0,"quote":true},{"t":"众生有苦恼，不免於老死，","level":0,"quote":true},{"t":"唯有仁智者，能免缠缚罪。","level":0,"quote":true},{"t":"妄语求贿赂，自所行不正，","level":0,"quote":true},{"t":"怨谮良善人，以枉治善士，","level":0,"quote":true},{"t":"罪缠斯等人，没溺深险坑。","level":0,"quote":true},{"t":"夫士为行者，好之与暴恶，","level":0,"quote":true},{"t":"各自为己身，终以不败亡。","level":0,"quote":true},{"t":"动转屈身形，唯影恒亲附，","level":0,"quote":true},{"t":"或起或往来，不离其形影。","level":0,"quote":true},{"t":"不但影随形，形亦自随影，","level":0,"quote":true},{"t":"犹行善恶行，终不离自身。","level":0,"quote":true},{"t":"遂贪食毒味，不从吾往言，","level":0,"quote":true},{"t":"为毒之所害，后乃自觉悟。","level":0,"quote":true},{"t":"愚心不开悟，习恶不从吾，","level":0,"quote":true},{"t":"受地狱苦痛，后方悟其教。","level":0,"quote":true},{"t":"戏笑为其恶，已作身自受，","level":0,"quote":true},{"t":"号泣受罪报，随行而罪至。","level":0,"quote":true},{"t":"恶不即时受，如<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00014.gif\" alt=\"𤛓\" title=\"𤛓\" />牛湩汁，","level":0,"quote":true},{"t":"罪在於阴伺，譬如灰覆火。","level":0,"quote":true},{"t":"恶不即时受，如彼锋利剑，","level":0,"quote":true},{"t":"不虑於后世，当受其苦报。","level":0,"quote":true},{"t":"恶为恶所缚，为恶不自觉，","level":0,"quote":true},{"t":"至恶知恶至，受恶恶根源。","level":0,"quote":true},{"t":"如铁生翳垢，反食其自身，","level":0,"quote":true},{"t":"恶生於自心，还当坏其体。","level":0,"quote":true}],[{"t":"法集要颂经正信品第十","level":3},{"t":"信惭戒布施，上士誉此法，","level":0,"quote":true},{"t":"斯道明智说，得生於天界。","level":0,"quote":true},{"t":"愚不修天行，亦不赞布施，","level":0,"quote":true},{"t":"正直随喜施，彼得后世乐。","level":0,"quote":true},{"t":"信者真人长，念法所安住，","level":0,"quote":true},{"t":"近者应得上，智寿中中贤。","level":0,"quote":true},{"t":"人业何者上？何行致欢乐？","level":0,"quote":true},{"t":"何要出要者？何寿寿中上？","level":0,"quote":true},{"t":"信者真人长，念法所安住，","level":0,"quote":true},{"t":"实者意得上，智寿寿中贤。","level":0,"quote":true},{"t":"信财乃得道，自致法灭度，","level":0,"quote":true},{"t":"善闻从慧得，得脱一切缚。","level":0,"quote":true},{"t":"信之与戒法，慧意则能行，","level":0,"quote":true},{"t":"健夫度恚怒，从是得脱渊。","level":0,"quote":true},{"t":"信使戒成就，亦获寿及慧，","level":0,"quote":true},{"t":"在在则能行，处处见供养。","level":0,"quote":true},{"t":"施共与鬪集，此业智不处，","level":0,"quote":true},{"t":"施时非鬪时，速施何疑虑？","level":0,"quote":true},{"t":"此方出世利，慧信为智母，","level":0,"quote":true},{"t":"是财出世宝，家产则非常。","level":0,"quote":true},{"t":"欲见诸真者，乐听闻法教，","level":0,"quote":true},{"t":"能舍悭垢心，此乃为上信。","level":0,"quote":true},{"t":"信能渡有河，其福难侵夺，","level":0,"quote":true},{"t":"能禁止窃盗，闲静沙门乐。","level":0,"quote":true},{"t":"沙门恒来至，智者所见乐，","level":0,"quote":true},{"t":"及餘笃信者，闻则生欢喜。","level":0,"quote":true},{"t":"若人怀懊恼，贪他人衣食，","level":0,"quote":true},{"t":"彼人昼夜寐，不获三摩地。","level":0,"quote":true},{"t":"若人能断贪，如截多罗树，","level":0,"quote":true},{"t":"彼人则昼夜，及获三摩地。","level":0,"quote":true},{"t":"无信不修行，好剥正言说，","level":0,"quote":true},{"t":"如掘取清泉，掘泉扬其泥。","level":0,"quote":true},{"t":"智者习信行，乐仰清净流，","level":0,"quote":true},{"t":"如善取泉水，思冷不扰浊。","level":0,"quote":true},{"t":"信智不染他，惟智与贤仁，","level":0,"quote":true},{"t":"非好则远之，可好则近学。","level":0,"quote":true},{"t":"乐信与不乐，寂默自应思，","level":0,"quote":true},{"t":"远离无信者，信仁应行之。","level":0,"quote":true},{"t":"无常及欲、贪放逸与爱乐","level":0,"quote":true},{"t":"戒善、行、语言业、信为第十","level":0,"quote":true}],[{"t":"法集要颂经沙门品第十一","level":3},{"t":"断漏降伏他，离欲名梵行，","level":0,"quote":true},{"t":"不犯牟尼戒，无一愿不满。","level":0,"quote":true},{"t":"行力若缓慢，作善与不善，","level":0,"quote":true},{"t":"梵行不清净，不获於大果。","level":0,"quote":true},{"t":"所有缓慢业，劣意尽除之，","level":0,"quote":true},{"t":"修习清净行，获果尽无餘。","level":0,"quote":true},{"t":"譬如执利剑，执缓则伤手，","level":0,"quote":true},{"t":"沙门不禁制，地狱缚牵引。","level":0,"quote":true},{"t":"又如执利剑，执紧不伤手，","level":0,"quote":true},{"t":"沙门禁制戒，渐近涅槃路。","level":0,"quote":true},{"t":"难晓则难了，沙门少智慧，","level":0,"quote":true},{"t":"诸想多扰乱，愚者致苦恼。","level":0,"quote":true},{"t":"沙门为何行？如意不自禁，","level":0,"quote":true},{"t":"步步数黏著，但随思想走。","level":0,"quote":true},{"t":"学难舍罪难，居在家亦难，","level":0,"quote":true},{"t":"会止同利难，艰难不过是。","level":0,"quote":true},{"t":"袈裟在肩披，为恶不捐弃，","level":0,"quote":true},{"t":"常念行恶者，斯则堕恶道。","level":0,"quote":true},{"t":"畏罪怀惊惧，假名为沙门，","level":0,"quote":true},{"t":"身披僧伽胝，如刳娑罗皮。","level":0,"quote":true},{"t":"所谓长老者，不必以耆年，","level":0,"quote":true},{"t":"形熟鬓发白，愚憃不知罪。","level":0,"quote":true},{"t":"能知罪福者，身净修梵行，","level":0,"quote":true},{"t":"明远纯清洁，是名为长老。","level":0,"quote":true},{"t":"所谓沙门者，不必剃须发，","level":0,"quote":true},{"t":"妄语多贪爱，有欲如凡夫。","level":0,"quote":true},{"t":"世称名沙门，汝亦言沙门，","level":0,"quote":true},{"t":"形服似沙门，譬如鹤伺鱼。","level":0,"quote":true},{"t":"如离实不离，袈裟除不除，","level":0,"quote":true},{"t":"持钵实不持，非俗非沙门。","level":0,"quote":true},{"t":"所言沙门者，消除窣兔罗，","level":0,"quote":true},{"t":"守护微细愆，是名真梵行。","level":0,"quote":true},{"t":"所言沙门者，息心灭意想，","level":0,"quote":true},{"t":"秽垢尽消除，故说为出家。","level":0,"quote":true}],[{"t":"法集要颂经卷第二","level":2},{"t":"<strong>译者</strong>：尊者法救集","level":0},{"t":"西天中印度惹烂駄啰国密林寺三藏明教大师赐紫沙门臣天息灾奉　诏译","level":0}],[{"t":"法集要颂经正道品第十二","level":3},{"t":"正道四圣谛，智慧所观察，","level":0,"quote":true},{"t":"破坏爱轮回，如风吹尘散。","level":0,"quote":true},{"t":"能见圣谛者，寂静应观察，","level":0,"quote":true},{"t":"灭除烦恼见，如雨洒微尘。","level":0,"quote":true},{"t":"八正最上道，四谛为法迹，","level":0,"quote":true},{"t":"是道名无为，智灯照愚暗。","level":0,"quote":true},{"t":"道为八真妙，圣谛四句上，","level":0,"quote":true},{"t":"无欲法之最，明眼善观察。","level":0,"quote":true},{"t":"智为出世长，快乐证无为，","level":0,"quote":true},{"t":"知受正教者，永尽生老死。","level":0,"quote":true},{"t":"一切行无常，如慧所观察，","level":0,"quote":true},{"t":"若能觉此苦，行道净其迹。","level":0,"quote":true},{"t":"一切诸行苦，如慧之所见，","level":0,"quote":true},{"t":"若能觉此苦，行道净其迹。","level":0,"quote":true},{"t":"一切诸行空，如慧之所见，","level":0,"quote":true},{"t":"若能觉此苦，行道净其迹。","level":0,"quote":true},{"t":"一切法无我，如慧之所见，","level":0,"quote":true},{"t":"若能觉此苦，行道净其迹。","level":0,"quote":true},{"t":"吾已说道迹，爱箭而为射，","level":0,"quote":true},{"t":"宜以自勗励，谛受如来言。","level":0,"quote":true},{"t":"吾已说道迹，拔爱坚固刺，","level":0,"quote":true},{"t":"宜以自勗励，谛受如来言。","level":0,"quote":true},{"t":"此道无别法，见谛之所净，","level":0,"quote":true},{"t":"趣向灭众苦，能坏魔罗军。","level":0,"quote":true},{"t":"此道无有餘，见谛能证果，","level":0,"quote":true},{"t":"趣向灭众苦，能破魔罗军。","level":0,"quote":true},{"t":"是道更无过，一趣如渊流，","level":0,"quote":true},{"t":"如能仁入定，在众频演道，","level":0,"quote":true},{"t":"一入见生死，得道为祐助。","level":0,"quote":true},{"t":"此道度当度，截流至彼岸，","level":0,"quote":true},{"t":"究竟道清净，已尽生死源。","level":0,"quote":true},{"t":"辩才无边界，明见宣说道，","level":0,"quote":true},{"t":"可趣服甘露，前未闻法轮。","level":0,"quote":true},{"t":"转为哀众生。礼拜奉事者，","level":0,"quote":true},{"t":"化之度三有，三念可念善，","level":0,"quote":true},{"t":"三念当离恶。从念而有行，","level":0,"quote":true},{"t":"灭之为正断，三观为转念，","level":0,"quote":true},{"t":"逮获无上道。得三除三窟，","level":0,"quote":true},{"t":"无量修念待，能除三有垢，","level":0,"quote":true},{"t":"摄定用缚意，智慧禅定力，","level":0,"quote":true},{"t":"已定摄外乱。世间生灭法，","level":0,"quote":true},{"t":"一一彼无边，觉道获解脱，","level":0,"quote":true},{"t":"快乐无穷尽。积善得善行，","level":0,"quote":true},{"t":"赞叹得名誉，逮贤圣八品，","level":0,"quote":true},{"t":"修道甘露果。","level":0,"quote":true}],[{"t":"法集要颂经利养品第十三","level":3},{"t":"芭蕉以实死，竹芦实亦然，","level":0,"quote":true},{"t":"駏驉坐妊终，人为贪利丧。","level":0,"quote":true},{"t":"如是贪无利，当知从痴生，","level":0,"quote":true},{"t":"愚为此害贤，首落分于地。","level":0,"quote":true},{"t":"贪利不善性，苾刍勿羡之，","level":0,"quote":true},{"t":"住处多爱恋，希望他供养。","level":0,"quote":true},{"t":"在家及出家，族姓诸愚迷，","level":0,"quote":true},{"t":"贪利兴嫉心，我为降伏彼。","level":0,"quote":true},{"t":"愚为愚计想，欲慢日夜增，","level":0,"quote":true},{"t":"异哉得利养，圆寂趣不同。","level":0,"quote":true},{"t":"能论知足者，苾刍真佛子，","level":0,"quote":true},{"t":"不贪著名誉，喜悦是智人。","level":0,"quote":true},{"t":"不爱著一切，不谄於他人，","level":0,"quote":true},{"t":"不依他活命，当自守法行。","level":0,"quote":true},{"t":"自利尚无贪，岂贵他名誉？","level":0,"quote":true},{"t":"百味如膏车，支形得行道。","level":0,"quote":true},{"t":"苾刍贪利养，不得三摩地，","level":0,"quote":true},{"t":"知足常寂静，止观可成就。","level":0,"quote":true},{"t":"苾刍远利誉，常足不贪求，","level":0,"quote":true},{"t":"但三衣饮食，真活命快乐。","level":0,"quote":true},{"t":"苾刍不舍利，如毒蛇同室，","level":0,"quote":true},{"t":"坐卧睡寐畏，皆由贪活命。","level":0,"quote":true},{"t":"苾刍不舍利，下劣中劣喜，","level":0,"quote":true},{"t":"一法应观察，少智难得脱，","level":0,"quote":true},{"t":"谨慎常依戒，无贪智者赞。","level":0,"quote":true},{"t":"净行正根力，应当自思惟，","level":0,"quote":true},{"t":"具足得三明，解脱获无漏。","level":0,"quote":true},{"t":"寡智尠识人，无所忆念知，","level":0,"quote":true},{"t":"其於诸饮食，依於他人得，","level":0,"quote":true},{"t":"而有恶法生。由利养憎嫉，","level":0,"quote":true},{"t":"自利多结怨，徒服三法衣，","level":0,"quote":true},{"t":"但望美饮食，不奉诸佛教。","level":0,"quote":true},{"t":"当知是过失，利养为大怖，","level":0,"quote":true},{"t":"少智不审虑，苾刍应释心。","level":0,"quote":true},{"t":"苾刍说出家，三业应调伏，","level":0,"quote":true},{"t":"不邪命自活，心善常思惟。","level":0,"quote":true},{"t":"微细病难忍，利养最难离，","level":0,"quote":true},{"t":"供养心不动，天龙致礼拜。","level":0,"quote":true}],[{"t":"法集要颂经怨家品第十四","level":3},{"t":"不怨而兴怨，不谤而造业，","level":0,"quote":true},{"t":"愚迷受轮回，今世及后世。","level":0,"quote":true},{"t":"先自作漏业，然后害他人，","level":0,"quote":true},{"t":"彼此相兴害，如鸟堕罗网。","level":0,"quote":true},{"t":"破他还自破，冤家遇冤家，","level":0,"quote":true},{"t":"毁他还自毁，瞋他还自瞋。","level":0,"quote":true},{"t":"斯何沙门行，不知正法本，","level":0,"quote":true},{"t":"寿既获短促，舍冤复结冤。","level":0,"quote":true},{"t":"众相共毁谤，各发恚怒声，","level":0,"quote":true},{"t":"欢心平等忍，此忍最无比。","level":0,"quote":true},{"t":"断骨而命终，牛马死财失，","level":0,"quote":true},{"t":"国界则丧乱，聚集还复得。","level":0,"quote":true},{"t":"汝等不兴恶，此法得离怨，","level":0,"quote":true},{"t":"他怨能忍受，说之名为智。","level":0,"quote":true},{"t":"若知此说胜，愚迷求快乐，","level":0,"quote":true},{"t":"现在无怨意，未来亦无恨。","level":0,"quote":true},{"t":"不可怨以怨，终已得快乐，","level":0,"quote":true},{"t":"行忍怨自息，此名如来法。","level":0,"quote":true},{"t":"若人致毁骂，彼胜我不胜，","level":0,"quote":true},{"t":"快乐从意者，怨终得休息。","level":0,"quote":true},{"t":"若人亲善友，共游於世间，","level":0,"quote":true},{"t":"不积有冤餘，专念同其意。","level":0,"quote":true},{"t":"设不得善友，独游无伴侣，","level":0,"quote":true},{"t":"应观诸国土，独善不造恶。","level":0,"quote":true},{"t":"学无同伴侣，又不得亲友，","level":0,"quote":true},{"t":"宁独守善行，不与愚人偕。","level":0,"quote":true},{"t":"乐戒学法行，奚用伴侣为？","level":0,"quote":true},{"t":"如龙好深渊，如象乐旷野。","level":0,"quote":true}],[{"t":"法集要颂经忆念品第十五","level":3},{"t":"入息出息念，具满谛思惟，","level":0,"quote":true},{"t":"常依次第行，按如佛所说。","level":0,"quote":true},{"t":"是则照世间，如云开月现，","level":0,"quote":true},{"t":"起止觉思惟，坐卧不废忘。","level":0,"quote":true},{"t":"苾刍立是念，现利未来胜，","level":0,"quote":true},{"t":"始得终最胜，逝不覩生死。","level":0,"quote":true},{"t":"若见身所住，六触以为最，","level":0,"quote":true},{"t":"苾刍常一心，便自知圆寂。","level":0,"quote":true},{"t":"以有是诸念，自身恒逮行，","level":0,"quote":true},{"t":"若其不如是，终不得意行。","level":0,"quote":true},{"t":"是随本行者，如是度爱劳，","level":0,"quote":true},{"t":"若能寤意念，一心定欢喜。","level":0,"quote":true},{"t":"若能寤意念，解脱一心乐，","level":0,"quote":true},{"t":"应时等法行，得度生死地。","level":0,"quote":true},{"t":"苾刍寤意念，当令念相应，","level":0,"quote":true},{"t":"生死烦恼断，获得圆寂果。","level":0,"quote":true},{"t":"常当听妙法，自觉寤其意，","level":0,"quote":true},{"t":"能觉之为贤，终始无怖畏。","level":0,"quote":true},{"t":"以觉意得应，昼夜慕习学，","level":0,"quote":true},{"t":"解脱甘露要，决定得无漏。","level":0,"quote":true},{"t":"若人得善利，而来自归佛，","level":0,"quote":true},{"t":"是故当昼夜，一心常念佛。","level":0,"quote":true},{"t":"若人得善利，而来自归法，","level":0,"quote":true},{"t":"是故当昼夜，一心常念法。","level":0,"quote":true},{"t":"若人得善利，而来自归僧，","level":0,"quote":true},{"t":"是故当昼夜，一心常念僧。","level":0,"quote":true},{"t":"善知自觉者，是瞿昙声闻，","level":0,"quote":true},{"t":"应当於昼夜，一心恒念佛。","level":0,"quote":true},{"t":"善知自觉者，是瞿昙声闻，","level":0,"quote":true},{"t":"应当於昼夜，一心恒念法。","level":0,"quote":true},{"t":"善知自觉者，是瞿昙声闻，","level":0,"quote":true},{"t":"应当於昼夜，一心恒念僧。","level":0,"quote":true},{"t":"善知自觉者，是能仁弟子，","level":0,"quote":true},{"t":"应当於昼夜，一心恒念戒。","level":0,"quote":true},{"t":"善知自觉者，是能仁弟子，","level":0,"quote":true},{"t":"应当於昼夜，一心恒念施。","level":0,"quote":true},{"t":"善知自觉者，是能仁弟子，","level":0,"quote":true},{"t":"应当於昼夜，一心恒念天。","level":0,"quote":true},{"t":"善知自觉者，是能仁弟子，","level":0,"quote":true},{"t":"应当於昼夜，一心恒念身。","level":0,"quote":true},{"t":"善知自觉者，是能仁弟子，","level":0,"quote":true},{"t":"应当於昼夜，一心念静虑。","level":0,"quote":true},{"t":"善知自觉者，是能仁弟子，","level":0,"quote":true},{"t":"应当於昼夜，一心念不杀。","level":0,"quote":true},{"t":"善知自觉者，是能仁弟子，","level":0,"quote":true},{"t":"应当於昼夜，一心念不盗。","level":0,"quote":true},{"t":"善知自觉者，是能仁弟子，","level":0,"quote":true},{"t":"应当於昼夜，一心常念空。","level":0,"quote":true},{"t":"善知自觉者，是能仁弟子，","level":0,"quote":true},{"t":"应当於昼夜，一心念无相。","level":0,"quote":true},{"t":"善知自觉者，是能仁弟子，","level":0,"quote":true},{"t":"应当於昼夜，一心念无愿。","level":0,"quote":true},{"t":"善知自觉者，是能仁弟子，","level":0,"quote":true},{"t":"应当於昼夜，一心念出世。","level":0,"quote":true},{"t":"善知自觉者，是能仁弟子，","level":0,"quote":true},{"t":"应当於昼夜，一心念意乐。","level":0,"quote":true},{"t":"善知自觉者，是能仁弟子，","level":0,"quote":true},{"t":"应当於昼夜，一心念圆寂。","level":0,"quote":true}],[{"t":"法集要颂经清净品第十六","level":3},{"t":"当念自觉悟，作时勿虚妄，","level":0,"quote":true},{"t":"行要修亦安，所造时真实。","level":0,"quote":true},{"t":"人当求方便，自致获财宝，","level":0,"quote":true},{"t":"彼自观亦然，意愿即果之。","level":0,"quote":true},{"t":"坐卧求方便，发起於精进，","level":0,"quote":true},{"t":"如工鍊真金，除其尘垢冥。","level":0,"quote":true},{"t":"不为暗所蔽，永离老死患，","level":0,"quote":true},{"t":"不羞而反羞，反羞而不羞。","level":0,"quote":true},{"t":"不畏而现畏，畏现而不畏，","level":0,"quote":true},{"t":"生为人邪见，死定入地狱。","level":0,"quote":true},{"t":"人先为放逸，后止而不犯，","level":0,"quote":true},{"t":"是光照世间，如月现云消。","level":0,"quote":true},{"t":"人先为放逸，后止而不犯，","level":0,"quote":true},{"t":"以善而灭之，是光照世间。","level":0,"quote":true},{"t":"若人为罪恶，修善而能除，","level":0,"quote":true},{"t":"世间由乐著，而空念其义。","level":0,"quote":true},{"t":"少年而出家，求佛深妙法，","level":0,"quote":true},{"t":"是光照世间，如月晃云散。","level":0,"quote":true},{"t":"现世不施害，死而无忧戚，","level":0,"quote":true},{"t":"彼见道无畏，离苦获安隐。","level":0,"quote":true},{"t":"现世不施害，死而无忧戚，","level":0,"quote":true},{"t":"彼见道无畏，眷属中最胜。","level":0,"quote":true},{"t":"除断浊黑业，惟修白净行，","level":0,"quote":true},{"t":"度爱得清净，弃舍秽恶行。","level":0,"quote":true},{"t":"持戒常清净，清净晡沙他，","level":0,"quote":true},{"t":"三业恒清净，清净名出家。","level":0,"quote":true},{"t":"爱欲意为田，婬怒痴为种，","level":0,"quote":true},{"t":"故施度世者，得福无有量。","level":0,"quote":true},{"t":"犹如秽恶田，瞋恚滋蔓生，","level":0,"quote":true},{"t":"是故当离恚，施报无有量。","level":0,"quote":true},{"t":"犹如秽恶田，愚痴滋蔓生，","level":0,"quote":true},{"t":"是故当离愚，获报无有量。","level":0,"quote":true},{"t":"犹如秽恶田，憍慢滋蔓生，","level":0,"quote":true},{"t":"是故当离慢，获报无有量。","level":0,"quote":true},{"t":"犹如秽恶田，悭悋滋蔓生，","level":0,"quote":true},{"t":"是故当离悭，获报无有量。","level":0,"quote":true},{"t":"犹如秽恶田，爱乐滋蔓生，","level":0,"quote":true},{"t":"是故当离爱，获报无有量。","level":0,"quote":true},{"t":"六识王为主，爱染为眷属，","level":0,"quote":true},{"t":"无染则离爱，染著是愚痴。","level":0,"quote":true},{"t":"骨干以为城，肉血而涂饰，","level":0,"quote":true},{"t":"门根尽开张，结贼得纵逸。","level":0,"quote":true},{"t":"有缘则增苦，观彼二因缘，","level":0,"quote":true},{"t":"灭之由贤众，不从外愚除。","level":0,"quote":true}],[{"t":"法集要颂经水喻品第十七","level":3},{"t":"净心常忆念，无所有贪爱，","level":0,"quote":true},{"t":"已度愚痴渊，如鹅守枯池。","level":0,"quote":true},{"t":"彼心既弃舍，翱翔升虚空，","level":0,"quote":true},{"t":"修行出世间，能破魔罗众。","level":0,"quote":true},{"t":"少不修梵行，至老不积财，","level":0,"quote":true},{"t":"愚痴乐睡眠，由己不修善。","level":0,"quote":true},{"t":"少不修梵行，至老不积财，","level":0,"quote":true},{"t":"鸳鸯守空池，守故有何益？","level":0,"quote":true},{"t":"莫轻小恶罪，以为无殃报，","level":0,"quote":true},{"t":"水滴虽极微，渐盈於大器，","level":0,"quote":true},{"t":"恶业渐渐增，纤毫成广大。","level":0,"quote":true},{"t":"莫轻小善业，以为无福报，","level":0,"quote":true},{"t":"水滴虽极微，渐盈於大器，","level":0,"quote":true},{"t":"善业渐渐增，纤毫成广大。","level":0,"quote":true},{"t":"犹如人渡河，缚栰而牢固，","level":0,"quote":true},{"t":"彼谓度不度，聪叡乃谓度。","level":0,"quote":true},{"t":"佛世尊已度，梵志度当度，","level":0,"quote":true},{"t":"苾刍入渊池，声闻缚牢固。","level":0,"quote":true},{"t":"是泉而何用，水恒而停满，","level":0,"quote":true},{"t":"拔爱根本除，复欲何所望？","level":0,"quote":true},{"t":"水工调舟船，弓师能调角，","level":0,"quote":true},{"t":"巧匠乐调木，智者能调身。","level":0,"quote":true},{"t":"犹如深净泉，表里甚清彻，","level":0,"quote":true},{"t":"闻法得清净，智者生欢喜。","level":0,"quote":true},{"t":"犹如深净泉，表里甚清彻，","level":0,"quote":true},{"t":"智者闻妙法，欢喜无穷尽。","level":0,"quote":true},{"t":"忍心如大地，不动如虚空，","level":0,"quote":true},{"t":"闻法喻金刚，获味免轮回。","level":0,"quote":true}],[{"t":"法集要颂经华喻品第十八","level":3},{"t":"何人能择地？舍地狱取天，","level":0,"quote":true},{"t":"惟说善法句，如采善妙华。","level":0,"quote":true},{"t":"学人能择地，舍地狱取天，","level":0,"quote":true},{"t":"善说妙法句，能采众妙华。","level":0,"quote":true},{"t":"截林勿截树，因林生怖畏，","level":0,"quote":true},{"t":"截林而灭已，苾刍得圆寂。","level":0,"quote":true},{"t":"截林不断根，因林生怖畏，","level":0,"quote":true},{"t":"未断分毫间，令意生缠缚。","level":0,"quote":true},{"t":"截林勿断根，因林生怖畏，","level":0,"quote":true},{"t":"心缠最难离，如犊恋爱母。","level":0,"quote":true},{"t":"当自断爱恋，犹如枯莲池，","level":0,"quote":true},{"t":"息迹受正教，佛说圆寂乐。","level":0,"quote":true},{"t":"犹如可意华，色好而无香，","level":0,"quote":true},{"t":"巧言华如是，无果不获报。","level":0,"quote":true},{"t":"犹如可意华，色好而香洁，","level":0,"quote":true},{"t":"巧言善如是，必获其好报。","level":0,"quote":true},{"t":"犹如蜂采华，不坏色与香，","level":0,"quote":true},{"t":"但取味飞去，苾刍入聚然。","level":0,"quote":true},{"t":"不违他好恶，勿观作不作，","level":0,"quote":true},{"t":"但自观身行，若正若不正。","level":0,"quote":true},{"t":"如田粪秽沟，而近于大道，","level":0,"quote":true},{"t":"其中生莲华，香洁甚可悦。","level":0,"quote":true},{"t":"有生必有终，凡夫乐处边，","level":0,"quote":true},{"t":"慧人爱出离，真是佛声闻。","level":0,"quote":true},{"t":"多集众妙华，结鬘为步摇，","level":0,"quote":true},{"t":"有情积善根，后世转殊胜。","level":0,"quote":true},{"t":"如末哩妙华，末拘罗清净，","level":0,"quote":true},{"t":"贪欲瞋若除，苾刍净香洁。","level":0,"quote":true},{"t":"如人采妙华，专意不散乱，","level":0,"quote":true},{"t":"因眠遇水漂，俄被死王降。","level":0,"quote":true},{"t":"如人采妙华，专意不散乱，","level":0,"quote":true},{"t":"欲意无厌足，常为穷所困。","level":0,"quote":true},{"t":"如人采妙华，专意不散乱，","level":0,"quote":true},{"t":"未获真财宝，长为穷所困。","level":0,"quote":true},{"t":"若不见死王，慧照如净华，","level":0,"quote":true},{"t":"苾刍到彼岸，如蛇脱故皮。","level":0,"quote":true},{"t":"贪瞋痴若断，如弃毒华根，","level":0,"quote":true},{"t":"苾刍到彼岸，如蛇脱故皮。","level":0,"quote":true},{"t":"贪根若除断，如华水上浮，","level":0,"quote":true},{"t":"苾刍到彼岸，如蛇脱故皮。","level":0,"quote":true},{"t":"恚根若除断，如华水上浮，","level":0,"quote":true},{"t":"苾刍到彼岸，如蛇脱故皮。","level":0,"quote":true},{"t":"痴根若除断，如华水上浮，","level":0,"quote":true},{"t":"苾刍到彼岸，如蛇脱故皮。","level":0,"quote":true},{"t":"如人结花鬘，意乐贪无足，","level":0,"quote":true},{"t":"不尽现世毒，三根常缠缚。","level":0,"quote":true},{"t":"观身如坏器，幻法如野马，","level":0,"quote":true},{"t":"断魔华开敷，不覩死王路。","level":0,"quote":true},{"t":"是身如聚沫，知此幻化法，","level":0,"quote":true},{"t":"断魔华开敷，不覩死王路。","level":0,"quote":true},{"t":"我慢根除断，如华水上浮，","level":0,"quote":true},{"t":"苾刍到彼岸，如蛇脱故皮。","level":0,"quote":true},{"t":"悭悋根若断，如华水上浮，","level":0,"quote":true},{"t":"苾刍到彼岸，如蛇脱故皮。","level":0,"quote":true},{"t":"爱支根若断，如华水上浮，","level":0,"quote":true},{"t":"苾刍到彼岸，如蛇脱故皮。","level":0,"quote":true},{"t":"若无烦恼根，获报善因果，","level":0,"quote":true},{"t":"苾刍到彼岸，如蛇脱故皮。","level":0,"quote":true}],[{"t":"法集要颂经马喻品第十九","level":3},{"t":"譬马调能软，随意如所行，","level":0,"quote":true},{"t":"信戒及精进，定法要具足。","level":0,"quote":true},{"t":"获法第一义，利用故无穷，","level":0,"quote":true},{"t":"一心行和忍，得免轮回苦。","level":0,"quote":true},{"t":"忍和意得定，能断诸苦恼，","level":0,"quote":true},{"t":"从是得住定，如马善调御。","level":0,"quote":true},{"t":"断恚获无漏，如马能自调，","level":0,"quote":true},{"t":"弃恶至平坦，后受生天乐。","level":0,"quote":true},{"t":"不恣在放恣，於眠多觉悟，","level":0,"quote":true},{"t":"如羸马比良，弃恶乃为贤。","level":0,"quote":true},{"t":"若人有惭愧，智慧可成就，","level":0,"quote":true},{"t":"是故易诱进，如策於良马。","level":0,"quote":true},{"t":"譬马若调平，可堪王乘骑，","level":0,"quote":true},{"t":"能调为人贤，乃受诚信语。","level":0,"quote":true},{"t":"虽为常调伏，如彼新驰马，","level":0,"quote":true},{"t":"亦如善龙象，不如自调者。","level":0,"quote":true},{"t":"彼人不能乘，人所亦不至，","level":0,"quote":true},{"t":"惟自调伏者，乃到调方所。","level":0,"quote":true},{"t":"彼人不能乘，人所亦不至，","level":0,"quote":true},{"t":"惟自调伏者，乃灭一切苦。","level":0,"quote":true},{"t":"彼人不能乘，人所亦不至，","level":0,"quote":true},{"t":"惟自调伏者，得至圆寂路。","level":0,"quote":true},{"t":"应常自调伏，亦如止奔马，","level":0,"quote":true},{"t":"能自防制者，念度苦原际。","level":0,"quote":true},{"t":"如马可王乘，彼地希有生，","level":0,"quote":true},{"t":"苾刍善调伏，解脱一切苦。","level":0,"quote":true},{"t":"惟自调伏者，善意如良马，","level":0,"quote":true},{"t":"亦如大象龙，自调最为上。","level":0,"quote":true},{"t":"如王乘智马，国中所希有，","level":0,"quote":true},{"t":"苾刍善调伏，能断於缠缚。","level":0,"quote":true},{"t":"惟自调伏者，此善最无比，","level":0,"quote":true},{"t":"亦如善象龙，意念到彼岸。","level":0,"quote":true},{"t":"自师自卫护，自归求自度，","level":0,"quote":true},{"t":"是故躬谨慎，如商贾智马。","level":0,"quote":true}]]