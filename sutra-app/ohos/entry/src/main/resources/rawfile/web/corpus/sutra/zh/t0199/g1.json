[[{"t":"禅承迦叶品第二十(十一偈)","level":3},{"t":"「有诸比丘僧，终竟于七岁，","level":0,"quote":true},{"t":"时国谷米贵，饥饿大恐惧。","level":0,"quote":true},{"t":"我分得一人，摩竭妙道人，","level":0,"quote":true},{"t":"缘一觉之尊，清凉无有漏。","level":0,"quote":true},{"t":"彼时我兴发，起意之为恶，","level":0,"quote":true},{"t":"『我当持何用，施饲是比丘？』","level":0,"quote":true},{"t":"时停置饭食，令生虫臭恶，","level":0,"quote":true},{"t":"往观诸作使，然后供养之。","level":0,"quote":true},{"t":"以是所作罪，寿终堕地狱，","level":0,"quote":true},{"t":"合会烧炙之，苦痛不可言。","level":0,"quote":true},{"t":"从地狱得出，世世所生处，","level":0,"quote":true},{"t":"作若干方便，求饭食难得。","level":0,"quote":true},{"t":"是为最后世，来还生人间，","level":0,"quote":true},{"t":"逮见等正觉，无上之导师。","level":0,"quote":true},{"t":"以信故出家，除害诸漏尽，","level":0,"quote":true},{"t":"已得无所著，清凉而灭度。","level":0,"quote":true},{"t":"仁者吾於是，神足常自在，","level":0,"quote":true},{"t":"求食设方便，若干不能得。","level":0,"quote":true},{"t":"远行避道路，疲劳不可言，","level":0,"quote":true},{"t":"既乃得所侥，饭食诸供具。」","level":0,"quote":true},{"t":"承伽迦叶尊，大通名所作，","level":0,"quote":true},{"t":"於阿耨达池，自说本所作。","level":0,"quote":true}],[{"t":"朱利般特品第二十一(八偈)","level":3},{"t":"「昔我先世时，曾为养猪者，","level":0,"quote":true},{"t":"在於江水傍，系<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02538.gif\" alt=\"𢴲\" title=\"𢴲\" />众猪口。","level":0,"quote":true},{"t":"欲济至江半，身独由得渡，","level":0,"quote":true},{"t":"猪不得喘息，中流皆溺死。","level":0,"quote":true},{"t":"尔时我治生，亡遗无所依，","level":0,"quote":true},{"t":"仙人来至彼，从顶有慈哀。","level":0,"quote":true},{"t":"便劝教化我，剃除吾须发，","level":0,"quote":true},{"t":"解喻诲善律，行无相三昧。","level":0,"quote":true},{"t":"於彼寿终后，便得生天上，","level":0,"quote":true},{"t":"天寿复竟尽，即还为道人。","level":0,"quote":true},{"t":"逮见等正觉，舍家为寂志，","level":0,"quote":true},{"t":"所在意曚暝，受经寻辄忘。","level":0,"quote":true},{"t":"我讽学一偈，三月乃谙知，","level":0,"quote":true},{"t":"习读诵四句，断绝诸爱欲。」","level":0,"quote":true},{"t":"世尊时问之，朱利般特说，","level":0,"quote":true},{"t":"从来善恶事，於阿耨达池。","level":0,"quote":true}],[{"t":"醍醐施品第二十二(二十七偈)","level":3},{"t":"「迦叶佛灭度，我为后弟子，","level":0,"quote":true},{"t":"博闻知三世，常秘惜经法。","level":0,"quote":true},{"t":"不为比丘说，不肯示与人，","level":0,"quote":true},{"t":"傥餘乞本知，便当与我等。","level":0,"quote":true},{"t":"设有比丘来，至我所问事，","level":0,"quote":true},{"t":"吾则欺诈之，不解意结恨。","level":0,"quote":true},{"t":"众道人恚还，忧恚骂詈言：","level":0,"quote":true},{"t":"『何嫉不说法？仁者岂为往？』","level":0,"quote":true},{"t":"临欲寿终时，心即自悔责，","level":0,"quote":true},{"t":"未曾讲论法，是为大不善。","level":0,"quote":true},{"t":"自知寿向尽，餘过有七日，","level":0,"quote":true},{"t":"聚会众僧类，应时为说法。","level":0,"quote":true},{"t":"昼夜讲诸要，蠲除贪嫉妬，","level":0,"quote":true},{"t":"说法未竟毕，於彼便命过。","level":0,"quote":true},{"t":"如我所分别，闻者极妙快，","level":0,"quote":true},{"t":"受教思惟义，展转相劝化。","level":0,"quote":true},{"t":"所说法尠少，聚会人七日，","level":0,"quote":true},{"t":"用是得生天，天伎以自娱。","level":0,"quote":true},{"t":"天上寿终下，来还受人身，","level":0,"quote":true},{"t":"在迦惟罗卫，生释国王家。","level":0,"quote":true},{"t":"端正见者敬，为众所爱乐，","level":0,"quote":true},{"t":"大财无极宝，普以度无极。","level":0,"quote":true},{"t":"见诸族姓子，来者皆弃家，","level":0,"quote":true},{"t":"我羡为寂志，捐家爱欲财。","level":0,"quote":true},{"t":"世尊无等人，慈念愍哀我，","level":0,"quote":true},{"t":"屡数率励我，劝导令出家。","level":0,"quote":true},{"t":"吾便敬遵佛，无上之喜教，","level":0,"quote":true},{"t":"唯仁者我身，七年行布施。","level":0,"quote":true},{"t":"於是惠与已，终竟于七岁，","level":0,"quote":true},{"t":"然后作寂志，受胜智慧诲。","level":0,"quote":true},{"t":"七年为长久，人命为甚短，","level":0,"quote":true},{"t":"今日便布施，谁能保身命？","level":0,"quote":true},{"t":"用尊是往故，即时作寂志，","level":0,"quote":true},{"t":"唯仁我七日，出家除须发。","level":0,"quote":true},{"t":"信故为沙门，修行佛法身，","level":0,"quote":true},{"t":"二十五岁中，寂定心如水。","level":0,"quote":true},{"t":"於是弊恶道，起念著家事，","level":0,"quote":true},{"t":"奉行捐损业，亦不用甘露。","level":0,"quote":true},{"t":"於彼甚惭愧，发求无极利，","level":0,"quote":true},{"t":"毁辱于亲属，悉当见仇憎。","level":0,"quote":true},{"t":"作是为不可，亦不所侥恨，","level":0,"quote":true},{"t":"已出志守寂，岂复返怀居？","level":0,"quote":true},{"t":"兴家种姓意，财利之所欲，","level":0,"quote":true},{"t":"当能断斯著，终不舍离戒。","level":0,"quote":true},{"t":"宁令我身没，其寿所憎恶，","level":0,"quote":true},{"t":"我当捉大刀，安用此命为？","level":0,"quote":true},{"t":"便执利刀剑，除割所因缘，","level":0,"quote":true},{"t":"刈截垢浊已，然后心解脱。","level":0,"quote":true},{"t":"一心便解度，稍数令人寂，","level":0,"quote":true},{"t":"我於慈果实，速值法光明。","level":0,"quote":true},{"t":"我寿向终时，讲说尊妙法，","level":0,"quote":true},{"t":"缘是所可行，定意度无极。」","level":0,"quote":true},{"t":"释子大神足，弱根萨波达，","level":0,"quote":true},{"t":"於阿耨达池，自说本所作。","level":0,"quote":true}],[{"t":"阿那律品第二十三(无猎九偈)","level":3},{"t":"「昔我曾不食，彼世时施与，","level":0,"quote":true},{"t":"遭遇见沙门，大通和莅咤。","level":0,"quote":true},{"t":"以故生释种，号曰阿那律，","level":0,"quote":true},{"t":"功德自娱乐，俳伎之所娱。","level":0,"quote":true},{"t":"时见等正觉，即喜慕世尊，","level":0,"quote":true},{"t":"覩之心踊跃，舍家为寂志。","level":0,"quote":true},{"t":"宿世行精进，方便常坚彊，","level":0,"quote":true},{"t":"已脱三达智，具足如佛教。","level":0,"quote":true},{"t":"自识本宿命，造行所更历，","level":0,"quote":true},{"t":"於忉利天上，积七世在彼。","level":0,"quote":true},{"t":"七返还人间，人间转势尊，","level":0,"quote":true},{"t":"富贵君子家，金珠宝自然。","level":0,"quote":true},{"t":"於是七彼七，生死凡十四，","level":0,"quote":true},{"t":"本悉识知之，前世之所行。","level":0,"quote":true},{"t":"如是所与果，曾无悭嫉意，","level":0,"quote":true},{"t":"世世所生处，常求不生死。」","level":0,"quote":true},{"t":"时尊阿那律，处于众僧中，","level":0,"quote":true},{"t":"於阿耨达池，自说本所作。","level":0,"quote":true}],[{"t":"弥迦弗品第二十四(鹿子十四偈)","level":3},{"t":"「昔我逐勇狗，往诣药肆上，","level":0,"quote":true},{"t":"缘一觉之尊，身体得不豫。","level":0,"quote":true},{"t":"给之以医药，瞻养至七日，","level":0,"quote":true},{"t":"尊人过七日，便飞升虚空。","level":0,"quote":true},{"t":"我时见告语，家之仆童客，","level":0,"quote":true},{"t":"众祐已来臻，如是出家学。","level":0,"quote":true},{"t":"我闻仆所说，辟支佛飞行，","level":0,"quote":true},{"t":"其志踊跃喜，一意叉手向。","level":0,"quote":true},{"t":"缘是喜悦意，布施医药故，","level":0,"quote":true},{"t":"在天上人间，功德自然见。","level":0,"quote":true},{"t":"於今最后世，复还得人身，","level":0,"quote":true},{"t":"值见等正觉，导师无有上。","level":0,"quote":true},{"t":"於释师子所，出家为寂志，","level":0,"quote":true},{"t":"已得无所著，清凉而灭度。","level":0,"quote":true},{"t":"於昔吾於是，得供甚众多，","level":0,"quote":true},{"t":"衣被及饮食，床卧所安具。","level":0,"quote":true},{"t":"为其缝衣服，从施医药故，","level":0,"quote":true},{"t":"四方给诸药，所安无所乏。","level":0,"quote":true},{"t":"天人往告语，蓱沙之国王，","level":0,"quote":true},{"t":"卿当以医药，施与弥迦弗。","level":0,"quote":true},{"t":"仁国当兴利，众药大炽盛，","level":0,"quote":true},{"t":"遣耆域医王，擎药与鹿子。","level":0,"quote":true},{"t":"四面医药来，皆悉归趣我，","level":0,"quote":true},{"t":"彼时王蓱沙，施遣大神通。","level":0,"quote":true},{"t":"於是来授我，具足柔软堂，","level":0,"quote":true},{"t":"悉遍比丘僧，千二百五十。」","level":0,"quote":true},{"t":"其鹿子比丘，六通大神足，","level":0,"quote":true},{"t":"於阿耨达池，自说本所作。","level":0,"quote":true}],[{"t":"罗云品第二十五(十偈)","level":3},{"t":"「我昔曾为王，典主摩竭国，","level":0,"quote":true},{"t":"人民甚众多，决事以义理。","level":0,"quote":true},{"t":"尔时有仙人，饮他沟中水，","level":0,"quote":true},{"t":"即来诣我所，前语我如是：","level":0,"quote":true},{"t":"『大王我为贼，乏饮不与水，","level":0,"quote":true},{"t":"便当谪罚我，如拷盗窃者。』","level":0,"quote":true},{"t":"我时即报言：『仙人持法药，","level":0,"quote":true},{"t":"我恣听仁者，便去随其欲。』","level":0,"quote":true},{"t":"『大王我狐疑，咎结不得除，","level":0,"quote":true},{"t":"便当谪罚我，今乃消殃罪。』","level":0,"quote":true},{"t":"即勅著后园，忘之至六日，","level":0,"quote":true},{"t":"过六日已后，亦不得饮食。","level":0,"quote":true},{"t":"坐是因缘故，未曾有恶意，","level":0,"quote":true},{"t":"堕烧炙黑绳，更历六万岁。","level":0,"quote":true},{"t":"毕是有餘殃，於今最后生，","level":0,"quote":true},{"t":"处在母腹中，六年乃得生。","level":0,"quote":true},{"t":"未曾起乱意，身口不犯罪，","level":0,"quote":true},{"t":"乃值得果实，罪福不可离。」","level":0,"quote":true},{"t":"如是罗云尊，在於比丘僧，","level":0,"quote":true},{"t":"於阿耨达池，自说本所作。","level":0,"quote":true}],[{"t":"难提品第二十六(十四偈)","level":3},{"t":"「昔惟卫佛世，我施煖浴室，","level":0,"quote":true},{"t":"一洗比丘僧，便自发愿言：","level":0,"quote":true},{"t":"『令我与是等，尊众共集会，","level":0,"quote":true},{"t":"世世得清凉，离欲无垢尘。","level":0,"quote":true},{"t":"端正常徐好，清净若妙花。』","level":0,"quote":true},{"t":"於彼寿终后，便得生天上。","level":0,"quote":true},{"t":"在天上人间，颜色好端正，","level":0,"quote":true},{"t":"世世所生处，所住大势尊。","level":0,"quote":true},{"t":"於彼寿终后，来还生人间，","level":0,"quote":true},{"t":"诸天及人民，见我无厌足。","level":0,"quote":true},{"t":"见辟支佛塔，缮治泥整顿，","level":0,"quote":true},{"t":"圣饰令鲜白，於上悬幡盖。","level":0,"quote":true},{"t":"我时自发愿，欲求得相好，","level":0,"quote":true},{"t":"金体紫磨色，端严无有比。","level":0,"quote":true},{"t":"因是所作福，生波罗<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00178.gif\" alt=\"㮈\" title=\"㮈\" />国，","level":0,"quote":true},{"t":"於脂惟尼生，作子无恚害。","level":0,"quote":true},{"t":"见迦叶佛塔，其心为欢喜，","level":0,"quote":true},{"t":"辄诣其寺中，竖立承露槃。","level":0,"quote":true},{"t":"用是施塔故，及治圣饰塔，","level":0,"quote":true},{"t":"兴建刹柱槃，受福不可量。","level":0,"quote":true},{"t":"从彼有餘福，於是最后世，","level":0,"quote":true},{"t":"生释氏王家，便为佛之弟。","level":0,"quote":true},{"t":"我身自然有，大人之相好，","level":0,"quote":true},{"t":"庄严成罗羼，平等布三十。","level":0,"quote":true},{"t":"佛普见说我，端正最第一，","level":0,"quote":true},{"t":"已除尽诸漏，逮得甘露句。」","level":0,"quote":true},{"t":"难提父母子，於比丘僧中，","level":0,"quote":true},{"t":"於阿耨达池，自说本所作。","level":0,"quote":true}],[{"t":"𩙥提品第二十七(十九偈)","level":3},{"t":"「昔世谷米贵，饥饿大恐惧，","level":0,"quote":true},{"t":"比丘有五百，求食则施与。","level":0,"quote":true},{"t":"一切诸长者，惠施众道术，","level":0,"quote":true},{"t":"分卫得饭食，便持来授我。","level":0,"quote":true},{"t":"虽得粗细食，常分以与身，","level":0,"quote":true},{"t":"亦不能知我，每随用我语。","level":0,"quote":true},{"t":"诸人民来趣，行求饭食具，","level":0,"quote":true},{"t":"我尔时自力，从彼便出去。","level":0,"quote":true},{"t":"是时各驰走，孚远相求索，","level":0,"quote":true},{"t":"尽力从后追，不能及逮我。","level":0,"quote":true},{"t":"即渡於流河，便却坐一面，","level":0,"quote":true},{"t":"周匝四向视，得静无来人。","level":0,"quote":true},{"t":"『我今日独食，柔软美且香，","level":0,"quote":true},{"t":"饱满意盈足，终慕获安隐。』","level":0,"quote":true},{"t":"於是有比丘，则缘觉世尊，","level":0,"quote":true},{"t":"威神大巍巍，生死除无餘。","level":0,"quote":true},{"t":"意虑常念言，穷贱甚苦剧，","level":0,"quote":true},{"t":"本不修功德，是故令我贫。","level":0,"quote":true},{"t":"即兴清净心，欢踊意念言，","level":0,"quote":true},{"t":"当施与比丘，是本众祐者。","level":0,"quote":true},{"t":"时世尊便受，则於彼饭食，","level":0,"quote":true},{"t":"用怜愍伤我，便飞在虚空。","level":0,"quote":true},{"t":"我时即发愿：『莫复令我贫，","level":0,"quote":true},{"t":"后生势富家，端正如妙华。","level":0,"quote":true},{"t":"与如是等尊，世世共会遇，","level":0,"quote":true},{"t":"使我承此法，如仁者所得。』","level":0,"quote":true},{"t":"缘是所作德，受安长且久，","level":0,"quote":true},{"t":"於天上人间，所作德自见。","level":0,"quote":true},{"t":"亦得为国王，天人无数反，","level":0,"quote":true},{"t":"未曾堕恶道，亦无有罪殃。","level":0,"quote":true},{"t":"从彼有餘福，於是最后世，","level":0,"quote":true},{"t":"来生势富家，释种大姓生。","level":0,"quote":true},{"t":"尔时佛世尊，来诣所生地，","level":0,"quote":true},{"t":"我即为寂志，并与亲属俱。","level":0,"quote":true},{"t":"我本所立愿，辄如意具足，","level":0,"quote":true},{"t":"已得无所著，清凉且灭度。」","level":0,"quote":true},{"t":"舍势为沙门，𩙥提受佛教，","level":0,"quote":true},{"t":"於阿耨达池，自说本所作。","level":0,"quote":true}],[{"t":"罗槃𩙥提品第二十八(十四偈)","level":3},{"t":"「拘楼秦佛时，昔有起塔者，","level":0,"quote":true},{"t":"我时在彼住，其寺甚高大。","level":0,"quote":true},{"t":"兴造此塔寺，我口呵谴之：","level":0,"quote":true},{"t":"『是塔甚太大，何日当成就？","level":0,"quote":true},{"t":"可稍作功德，如是自立办，","level":0,"quote":true},{"t":"既不多劳烦，塔寺亦速讫。』","level":0,"quote":true},{"t":"用口说窭言，坐犯语罪报，","level":0,"quote":true},{"t":"命尽寿终后，便堕地狱中。","level":0,"quote":true},{"t":"从地狱得出，短小身玄丑，","level":0,"quote":true},{"t":"世世所生处，为众所轻邈。","level":0,"quote":true},{"t":"迦叶佛世时，为乌鸟赤<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00047.gif\" alt=\"𭉨\" title=\"𭉨\" />，","level":0,"quote":true},{"t":"波罗<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00178.gif\" alt=\"㮈\" title=\"㮈\" />中道，翱翔丛树间。","level":0,"quote":true},{"t":"瞻见世光曜，比丘所围绕，","level":0,"quote":true},{"t":"即顺佛为礼，口出悲音声。","level":0,"quote":true},{"t":"佛世尊所游，波罗<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00178.gif\" alt=\"㮈\" title=\"㮈\" />国时，","level":0,"quote":true},{"t":"每随行出入，常绕向悲鸣。","level":0,"quote":true},{"t":"缘是所作德，来还得人身，","level":0,"quote":true},{"t":"逮见等正觉，无上之导师。","level":0,"quote":true},{"t":"得出为寂志，於释师子所，","level":0,"quote":true},{"t":"已为无所著，清凉而灭度。","level":0,"quote":true},{"t":"罗汉得自在，六通大神足，","level":0,"quote":true},{"t":"名曰为持法，正真有辩才。","level":0,"quote":true},{"t":"一切众聚会，听闻我音声，","level":0,"quote":true},{"t":"诸天及人民，一切皆欢喜。","level":0,"quote":true},{"t":"我作罪少耳，作福亦不多，","level":0,"quote":true},{"t":"皆获其果实，所为二罪福。」","level":0,"quote":true},{"t":"罗槃𩙥提尊，在於比丘僧，","level":0,"quote":true},{"t":"於阿耨达池，自说本所作。","level":0,"quote":true}],[{"t":"摩头惒律致品第二十九(二十一偈)","level":3},{"t":"「昔於惟耶离，身为大猕猴，","level":0,"quote":true},{"t":"趣往取佛钵，比丘见被呵：","level":0,"quote":true},{"t":"『得无坏佛钵。』世尊告比丘：","level":0,"quote":true},{"t":"『比丘勿得呵，是终不坏钵。』","level":0,"quote":true},{"t":"我时取佛钵，徐徐持上树，","level":0,"quote":true},{"t":"盛以满钵蜜，便则从树下。","level":0,"quote":true},{"t":"手擎满钵蜜，以奉上世尊，","level":0,"quote":true},{"t":"蜜中有虫秽，正觉不肯受。","level":0,"quote":true},{"t":"佛见其钵中，死蜂与蜜杂，","level":0,"quote":true},{"t":"寻好择出之，复擎重上佛。","level":0,"quote":true},{"t":"时佛世光𤈷，复更不听受，","level":0,"quote":true},{"t":"我以水净洗，仍前稽首上。","level":0,"quote":true},{"t":"以水洒其上，更盛异钵中，","level":0,"quote":true},{"t":"供养佛尊已，心踊跃欢喜。","level":0,"quote":true},{"t":"世尊无等人，彼时度死蜂，","level":0,"quote":true},{"t":"受此一钵蜜，服食及弟子。","level":0,"quote":true},{"t":"我时甚踊悦，叉手而向佛，","level":0,"quote":true},{"t":"专住法王前，其心常精进。","level":0,"quote":true},{"t":"在彼发愿言：『令我得人身，","level":0,"quote":true},{"t":"来值世尊世，使得最上义。』","level":0,"quote":true},{"t":"缘是所作德，因用得人身，","level":0,"quote":true},{"t":"逮得等正觉，无上之导师。","level":0,"quote":true},{"t":"得出为沙门，给侍释师子，","level":0,"quote":true},{"t":"已为无所著，清凉而灭度。","level":0,"quote":true},{"t":"得自在罗汉，六通大神足，","level":0,"quote":true},{"t":"名曰为出蜜，诸比丘亦知。","level":0,"quote":true},{"t":"知前所作福，於今得恭敬，","level":0,"quote":true},{"t":"与数百比丘，共游行周旋。","level":0,"quote":true},{"t":"设在穷乏路，比丘僧饥渴，","level":0,"quote":true},{"t":"心适自发愿：『我欲得蜜浆。』","level":0,"quote":true},{"t":"知我心所念，众人即远来，","level":0,"quote":true},{"t":"赍持蜜美食，以用奉上我。","level":0,"quote":true},{"t":"我寻便受之，自然极美多，","level":0,"quote":true},{"t":"以施比丘僧，可意甚饱满。","level":0,"quote":true},{"t":"我应时生已，猕猴所作行，","level":0,"quote":true},{"t":"度脱无径路，便得甘露句。","level":0,"quote":true},{"t":"如我本所愿，辄得如其意，","level":0,"quote":true},{"t":"供养佛世尊，所求则具足。","level":0,"quote":true},{"t":"唯仁每悉念，我所作功德，","level":0,"quote":true},{"t":"悉获其果实，可意安隐吉。」","level":0,"quote":true},{"t":"如是出蜜尊，在比丘僧中，","level":0,"quote":true},{"t":"於阿耨达池，自说本所作。","level":0,"quote":true}],[{"t":"世尊品第三十(五十偈)","level":3},{"t":"一切胜普明，一切世间最，","level":0,"quote":true},{"t":"得除尽诸垢，降一切众会。","level":0,"quote":true},{"t":"诸通慧普见，大人一切畅，","level":0,"quote":true},{"t":"度诸怨恐惧，法船济彼岸。","level":0,"quote":true},{"t":"晓了众所化，欣然愍世间，","level":0,"quote":true},{"t":"矜伤脱众生，以义一切救。","level":0,"quote":true},{"t":"除去一切人，悉解诸系缚，","level":0,"quote":true},{"t":"一切人中最，说法为众眼。","level":0,"quote":true},{"t":"大人无极慧，大雄极名闻，","level":0,"quote":true},{"t":"大光无极法，以度於最法。","level":0,"quote":true},{"t":"大力化无黠，开化大明慧，","level":0,"quote":true},{"t":"欢劝大众人，大医多所兼。","level":0,"quote":true},{"t":"世尊坏众恐，无上除诸忧，","level":0,"quote":true},{"t":"佛仁为度脱，大牢狱闭系。","level":0,"quote":true},{"t":"大龙大师子，无著大比丘，","level":0,"quote":true},{"t":"大智慧世尊，救济众尘劳。","level":0,"quote":true},{"t":"精进有大力，方便大坚彊，","level":0,"quote":true},{"t":"降伏众天民，大道寂静安。","level":0,"quote":true},{"t":"佛大天中天，一切诸鬼神，","level":0,"quote":true},{"t":"悉礼智慧足，佛出哀世间。","level":0,"quote":true},{"t":"恒在大生死，坏决羂罗网，","level":0,"quote":true},{"t":"神通无极哀，度脱大牢狱。","level":0,"quote":true},{"t":"大龙大天人，於众会最先，","level":0,"quote":true},{"t":"广施无极施，已逮弘寂迹。","level":0,"quote":true},{"t":"尊长士仙人，已度诸尊法，","level":0,"quote":true},{"t":"成就大弟子，导师德极尊。","level":0,"quote":true},{"t":"众祐中最上，无上除愁忧，","level":0,"quote":true},{"t":"诸所度脱胜，一切相好尊。","level":0,"quote":true},{"t":"断绝诸色欲，拔济诸恩爱，","level":0,"quote":true},{"t":"时游在龙王，阿耨达大池。","level":0,"quote":true},{"t":"一切所作办，踊在虚空中，","level":0,"quote":true},{"t":"弟子众围绕，寂然有五百。","level":0,"quote":true},{"t":"愍伤有极哀，慈护一切人，","level":0,"quote":true},{"t":"观察比丘众，便自说是言：","level":0,"quote":true},{"t":"「明听我所语，前世之所造，","level":0,"quote":true},{"t":"身始有所作，今所获餘殃。","level":0,"quote":true},{"t":"吾昔宿命时，作人名文罗，","level":0,"quote":true},{"t":"诽谤无瑕秽，善妙辟支佛。","level":0,"quote":true},{"t":"众人大来会，缚束善妙士，","level":0,"quote":true},{"t":"著杻械闭系，须出如死囚。","level":0,"quote":true},{"t":"吾时见沙门，得缚束苦恼，","level":0,"quote":true},{"t":"其心发慈哀，身则为救解。","level":0,"quote":true},{"t":"用是罪殃故，堕地狱甚久，","level":0,"quote":true},{"t":"后来生人间，常为人所谤。","level":0,"quote":true},{"t":"用是有餘殃，於此最后世，","level":0,"quote":true},{"t":"须陀利异道，共议诬谤我。","level":0,"quote":true},{"t":"曾为婆罗门，博闻持道术，","level":0,"quote":true},{"t":"有五百学志，讲术藂树间。","level":0,"quote":true},{"t":"时有大神力，五通比丘来，","level":0,"quote":true},{"t":"我见道人至，诽谤扬其恶。","level":0,"quote":true},{"t":"仙人深爱欲，自高处树间，","level":0,"quote":true},{"t":"诸摩纳闻之，便共效我宣。","level":0,"quote":true},{"t":"时一切学志，家家行乞匃，","level":0,"quote":true},{"t":"大众中诽谤，仙人有垢欲。","level":0,"quote":true},{"t":"缘是所犯罪，须陀利女人，","level":0,"quote":true},{"t":"佛五百弟子，悉共被诽谤。","level":0,"quote":true},{"t":"佛为一切明，有虚妄之谤，","level":0,"quote":true},{"t":"知世咤弟子，是为沙门耶？","level":0,"quote":true},{"t":"犯是罪殃已，便堕恶道中，","level":0,"quote":true},{"t":"生在太山狱，勤苦甚酷毒。","level":0,"quote":true},{"t":"以此有餘殃，旃遮摩尼女，","level":0,"quote":true},{"t":"在大众会中，虚妄掩杀佛。","level":0,"quote":true},{"t":"曾为三兄弟，而共诤钱财，","level":0,"quote":true},{"t":"推扑坠深谷，石抬以杀之。","level":0,"quote":true},{"t":"以是所犯罪，堕太山地狱，","level":0,"quote":true},{"t":"烧炙在黑绳，毒痛甚酷苦。","level":0,"quote":true},{"t":"以此有餘殃，调达石所抬，","level":0,"quote":true},{"t":"於是石堕落，中伤佛足指。","level":0,"quote":true},{"t":"乘船入江海，俱欲渡深水，","level":0,"quote":true},{"t":"时共载船上，拔刀杀贾人。","level":0,"quote":true},{"t":"用犯此罪故，身堕地狱中，","level":0,"quote":true},{"t":"以是餘殃故，铁刺见佛前。","level":0,"quote":true},{"t":"曾在捕鱼肆，生为渔者子，","level":0,"quote":true},{"t":"有捕杀鱼者，我尔时生心。","level":0,"quote":true},{"t":"从是所犯罪，堕太山地狱，","level":0,"quote":true},{"t":"烧炙在黑绳，勤苦甚毒痛。","level":0,"quote":true},{"t":"随楼勒国王，伤杀释子时，","level":0,"quote":true},{"t":"以是有餘殃，於今得头痛。","level":0,"quote":true},{"t":"惟卫世尊时，骂詈其弟子，","level":0,"quote":true},{"t":"不应食粳米，当令噉生麦。","level":0,"quote":true},{"t":"用是所犯罪，坐口出恶言，","level":0,"quote":true},{"t":"堕於黑绳狱，受苦不可计。","level":0,"quote":true},{"t":"以此有餘殃，怨结婆罗门，","level":0,"quote":true},{"t":"请我终一时，三月中噉麦。","level":0,"quote":true},{"t":"曾为治病医，时疗尊者子，","level":0,"quote":true},{"t":"合药分倒错，令疾转增剧。","level":0,"quote":true},{"t":"用犯此罪故，堕地狱甚苦，","level":0,"quote":true},{"t":"以此有餘殃，是故得下利。","level":0,"quote":true},{"t":"吾昔前世时，曾为手搏师，","level":0,"quote":true},{"t":"与力士相扑，害杀有佛子。","level":0,"quote":true},{"t":"用犯此罪故，受苦难訾量，","level":0,"quote":true},{"t":"以此餘殃故，胁肋为之痛。","level":0,"quote":true},{"t":"谓难提和罗，轻毁迦叶佛，","level":0,"quote":true},{"t":"用见此沙门，言不得佛道。」","level":0,"quote":true},{"t":"佛五百弟子自说本起经","level":0}]]