[[{"t":"赞法界颂","level":0},{"t":"圣龙树菩萨造","level":0},{"t":"西天北印度乌填曩国帝释宫寺三藏传法大师赐紫沙门臣施护奉　诏译","level":0},{"t":"归命十方佛，法身及报化，","level":0,"quote":true},{"t":"愿共诸众生，速成法界性。","level":0,"quote":true},{"t":"轮回三恶道，法界理凝然，","level":0,"quote":true},{"t":"本来常清净，诸相不能迁；","level":0,"quote":true},{"t":"寂静如虚空，处处悉周遍，","level":0,"quote":true},{"t":"体皆离彼此，非深复非浅。","level":0,"quote":true},{"t":"乳未转变时，酥醍醐不见，","level":0,"quote":true},{"t":"烦恼未伏除，法界无由显；","level":0,"quote":true},{"t":"如酥处乳中，酥本妙光莹，","level":0,"quote":true},{"t":"法界烦恼覆，圆满体清净。","level":0,"quote":true},{"t":"如灯被障碍，非能照餘物，","level":0,"quote":true},{"t":"无明恒覆心，法界非明了；","level":0,"quote":true},{"t":"如灯离障碍，处处物能照，","level":0,"quote":true},{"t":"烦恼破坏时，真如恒显现。","level":0,"quote":true},{"t":"初中及最后，二障不能扰，","level":0,"quote":true},{"t":"如净瑠璃珠，恒时光照曜；","level":0,"quote":true},{"t":"光明物所障，被障明非见，","level":0,"quote":true},{"t":"法界烦恼覆，真如理难显。","level":0,"quote":true},{"t":"圆寂体光洁，轮回不能染，","level":0,"quote":true},{"t":"懃求趣法界，轮回非能揜。","level":0,"quote":true},{"t":"如米糠缠裹，谷体米非无，","level":0,"quote":true},{"t":"烦恼覆真如，真如烦恼有；","level":0,"quote":true},{"t":"如谷去其糠，米体自然见，","level":0,"quote":true},{"t":"若离烦恼糠，法界理方显。","level":0,"quote":true},{"t":"妄执有世间，芭蕉终无实，","level":0,"quote":true},{"t":"法界非世间，亦非虚妄见。","level":0,"quote":true},{"t":"如人饮甘露，热恼悉皆除，","level":0,"quote":true},{"t":"若证法界性，烦恼热皆弃。","level":0,"quote":true},{"t":"灭除烦恼焰，法界甘露现，","level":0,"quote":true},{"t":"一切有情中，高下皆平等。","level":0,"quote":true},{"t":"体实果不生，执种果非有，","level":0,"quote":true},{"t":"智慧出生时，有为非法界。","level":0,"quote":true},{"t":"法界本无处，究竟方可证，","level":0,"quote":true},{"t":"清净恒光洁，日月皆莹净。","level":0,"quote":true},{"t":"法界无垢染，如龙夜雨尘，","level":0,"quote":true},{"t":"况似罗睺面，光明恒灿然。","level":0,"quote":true},{"t":"譬如火浣布，处火能离染，","level":0,"quote":true},{"t":"垢去布犹存，光明转莹净。","level":0,"quote":true},{"t":"贪爱令心染，虚妄有轮回，","level":0,"quote":true},{"t":"亦如火浣布，真空妄非有。","level":0,"quote":true},{"t":"三毒生死本，智慧火能烧，","level":0,"quote":true},{"t":"法界体常有，朗然恒照曜。","level":0,"quote":true},{"t":"烦恼染称垢，世尊恒所宣，","level":0,"quote":true},{"t":"垢灭真如显，如汲地中泉。","level":0,"quote":true},{"t":"法界体无垢，根随能覆藏，","level":0,"quote":true},{"t":"若除烦恼尽，莹净叵难量。","level":0,"quote":true},{"t":"法界本无我，二形及女男，","level":0,"quote":true},{"t":"体无虚妄执，何处更思惟？","level":0,"quote":true},{"t":"法界离憎爱，根尘境本无，","level":0,"quote":true},{"t":"虚妄执为因，差别从此生。","level":0,"quote":true},{"t":"真空非苦恼，贪爱苦恼因，","level":0,"quote":true},{"t":"耽染由妄想，三界乃轮回。","level":0,"quote":true},{"t":"怀孕在於腹，婴子未言见，","level":0,"quote":true},{"t":"二障覆真如，法界不能证。","level":0,"quote":true},{"t":"种种生疑虑，见慢及恚痴，","level":0,"quote":true},{"t":"妄计有真实，真实计非有。","level":0,"quote":true},{"t":"兔角体非有，妄执令真实，","level":0,"quote":true},{"t":"法界离妄执，妄执真非有。","level":0,"quote":true},{"t":"如色必破坏，微尘犹可知，","level":0,"quote":true},{"t":"法界非破坏，三时不能得。","level":0,"quote":true},{"t":"有生还有灭，荣辱亦皆随，","level":0,"quote":true},{"t":"法界非生灭，云何言所知？","level":0,"quote":true},{"t":"兔角本非有，三世犹可思，","level":0,"quote":true},{"t":"真空非兔角，思虑不能知。","level":0,"quote":true},{"t":"真空称善逝，色相悉皆亡，","level":0,"quote":true},{"t":"应化随缘有，修因离执非。","level":0,"quote":true},{"t":"圆通如日月，水现影皆同，","level":0,"quote":true},{"t":"色声双泯绝，差别云何有？","level":0,"quote":true},{"t":"三世可寻思，生缘时决定，","level":0,"quote":true},{"t":"若悟己身法，己身云何有？","level":0,"quote":true},{"t":"如水居热际，处热觉悟非，","level":0,"quote":true},{"t":"寒际理亦然，圆通皆如是。","level":0,"quote":true},{"t":"心恒烦恼覆，迷惑不能了，","level":0,"quote":true},{"t":"若离烦恼缠，觉悟而非有。","level":0,"quote":true},{"t":"如眼观诸色，离障能照曜，","level":0,"quote":true},{"t":"真空理亦然，照曜离生灭。","level":0,"quote":true},{"t":"耳识闻於声，离妄及分别，","level":0,"quote":true},{"t":"法界性亦然，分别妄非有。","level":0,"quote":true},{"t":"鼻能嗅诸香，妄执性非有，","level":0,"quote":true},{"t":"色相二俱亡，真空亦如是。","level":0,"quote":true},{"t":"舌根自性空，味界恒远离，","level":0,"quote":true},{"t":"识空体亦然，法界理如是。","level":0,"quote":true},{"t":"身根自性净，冷煖触非有，","level":0,"quote":true},{"t":"法界理亦然，触处常远离。","level":0,"quote":true},{"t":"意缘法称最，自性恒远离，","level":0,"quote":true},{"t":"诸法性本空，圆通理如是。","level":0,"quote":true},{"t":"见闻及觉知，相应法亦空，","level":0,"quote":true},{"t":"了绝诸妄想，见闻理亦非。","level":0,"quote":true},{"t":"根尘起妄执，清净体源无，","level":0,"quote":true},{"t":"迷执有根尘，根尘理非有。","level":0,"quote":true},{"t":"世间并出世，空性本无差，","level":0,"quote":true},{"t":"我法由迷起，遍计自轮回。","level":0,"quote":true},{"t":"法界理清净，贪瞋痴本无，","level":0,"quote":true},{"t":"迷悟从心起，三毒法假名。","level":0,"quote":true},{"t":"迷执自缠缚，了达假名智，","level":0,"quote":true},{"t":"菩提非近远，三世理非有。","level":0,"quote":true},{"t":"烦恼笼迷执，世尊经所宣，","level":0,"quote":true},{"t":"智生惑染灭，妄执勿相缠。","level":0,"quote":true},{"t":"去来执最胜，体空犹可思，","level":0,"quote":true},{"t":"菩提非妄执，正证亦知非。","level":0,"quote":true},{"t":"水乳同一处，鹅饮乳非杂，","level":0,"quote":true},{"t":"生空烦恼离，二障亦非杂。","level":0,"quote":true},{"t":"妄执我非无，了达本非有，","level":0,"quote":true},{"t":"涅盘清净理，二我俱非立。","level":0,"quote":true},{"t":"三檀齐修施，尸罗离过非，","level":0,"quote":true},{"t":"忍因端正果，精进勇懃依，","level":0,"quote":true},{"t":"静虑令心止，般若用无疑，","level":0,"quote":true},{"t":"愿兼方便力，安住胜菩提。","level":0,"quote":true},{"t":"菩提离妄执，真空生灭无，","level":0,"quote":true},{"t":"了达空本性，二相亦非有。","level":0,"quote":true},{"t":"乳糖离甘蔗，离蔗糖非有，","level":0,"quote":true},{"t":"三乘趣菩提，离种体非有。","level":0,"quote":true},{"t":"守护稻谷种，芽茎必得生，","level":0,"quote":true},{"t":"守护菩提种，菩提从此起。","level":0,"quote":true},{"t":"譬如於黑月，光明未能见，","level":0,"quote":true},{"t":"有情烦恼缠，真如未明显。","level":0,"quote":true},{"t":"月初光虽有，渐渐而增长，","level":0,"quote":true},{"t":"初地证菩提，菩提未圆满。","level":0,"quote":true},{"t":"十五月圆满，处处光皎洁，","level":0,"quote":true},{"t":"解脱显法身，法身理无缺。","level":0,"quote":true},{"t":"染污意相应，缠缚俱生灭，","level":0,"quote":true},{"t":"解脱一切障，三世悟非有。","level":0,"quote":true},{"t":"初大僧祇满，三檀普遍修，","level":0,"quote":true},{"t":"断除分别障，欢喜智难俦。","level":0,"quote":true},{"t":"三业悮兼犯，防非重及轻，","level":0,"quote":true},{"t":"尸罗圆满戒，离垢独标名。","level":0,"quote":true},{"t":"二障恒时染，俱空慧刃除，","level":0,"quote":true},{"t":"发光能照曜，破灭渐无餘。","level":0,"quote":true},{"t":"远离根随染，渐增焰慧威，","level":0,"quote":true},{"t":"菩提称最胜，烧照转光辉。","level":0,"quote":true},{"t":"真俗称二智，相应互起违，","level":0,"quote":true},{"t":"合令无所碍，难胜事恒时。","level":0,"quote":true},{"t":"十二缘生智，巡环理趣全，","level":0,"quote":true},{"t":"甚深称最胜，般若现於前。","level":0,"quote":true},{"t":"世俗二乘行，久修道已明，","level":0,"quote":true},{"t":"相无功用满，最后称远行。","level":0,"quote":true},{"t":"智用无分别，恒时任运成，","level":0,"quote":true},{"t":"众魔降退散，不动独彰名。","level":0,"quote":true},{"t":"善慧名无碍，十方演法希，","level":0,"quote":true},{"t":"身云甘露雨，应物最堪依。","level":0,"quote":true},{"t":"众德犹如水，虚空喻似身，","level":0,"quote":true},{"t":"重麁皆蔽塞，大法智称云。","level":0,"quote":true},{"t":"审谛轮回事，孰能免业牵？","level":0,"quote":true},{"t":"要知无苦恼，净土勿相缠。","level":0,"quote":true},{"t":"归命佛真子，位登智慧云，","level":0,"quote":true},{"t":"细微皆断尽，超苦离诸尘。","level":0,"quote":true},{"t":"灌顶诸光照，根尘普遍身，","level":0,"quote":true},{"t":"金刚寂大定，众苦勿相亲。","level":0,"quote":true},{"t":"大宝花王座，俱胝众妙成，","level":0,"quote":true},{"t":"庄严皆普遍，功德实难思。","level":0,"quote":true},{"t":"十力兼无畏，三身四智圆，","level":0,"quote":true},{"t":"六通恒自在，应物化机缘。","level":0,"quote":true},{"t":"照曜如圆月，恒时焰炽燃，","level":0,"quote":true},{"t":"十方无不遍，灿烂转光鲜。","level":0,"quote":true},{"t":"永绝缘生染，恒时处涅盘，","level":0,"quote":true},{"t":"菩提称最胜，化益物情欢。","level":0,"quote":true},{"t":"智用深如海，随机现应身，","level":0,"quote":true},{"t":"水清来月影，处处度迷津。","level":0,"quote":true},{"t":"况似颇胝宝，随缘现影同，","level":0,"quote":true},{"t":"物情根有感，周普事无穷。","level":0,"quote":true},{"t":"饿鬼恒饥渴，不能见水泉，","level":0,"quote":true},{"t":"众生无少信，宿业自萦缠。","level":0,"quote":true},{"t":"化现身诸相，光明皆灿然，","level":0,"quote":true},{"t":"佛虽恒在世，不覩宿无缘。","level":0,"quote":true},{"t":"晓了尘沙界，根随染久无，","level":0,"quote":true},{"t":"二空殊胜智，妙用化童愚。","level":0,"quote":true},{"t":"清净绝诸垢，自他受用身，","level":0,"quote":true},{"t":"恒居色究竟，利益五乘人。","level":0,"quote":true},{"t":"救护众生苦，俱胝寿命长，","level":0,"quote":true},{"t":"二严无有尽，功德叵难量。","level":0,"quote":true},{"t":"佛演一乘法，随机悟浅深，","level":0,"quote":true},{"t":"莲花无垢染，玉本绝瑕侵。","level":0,"quote":true},{"t":"少分而称赞，广宣理趣玄，","level":0,"quote":true},{"t":"愿将诸功德，普利施人天。","level":0,"quote":true},{"t":"赞法界颂","level":0}]]