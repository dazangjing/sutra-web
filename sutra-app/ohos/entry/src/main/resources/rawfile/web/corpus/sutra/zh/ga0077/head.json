{"id":"ga0077","title":"九华山志","titleTrad":"九華山志","byline":"归依弟子许止净顶礼敬述","bylineLabel":"著者·译者","dynasty":"","division":"","canon":"GA0077","canonName":"佛寺志汇刊","volume":"GA0077","juanCount":8,"textLength":149349,"imageCount":0,"summary":"","tags":["佛寺志汇刊"],"order":3308,"guide":"","chunks":37,"toc":[{"level":3,"text":"重新编修九华山志发刊流通序"},{"level":3,"text":"民国甲戌重新鉴订九华山志序"},{"level":3,"text":"民国二十三年岁次甲戌，江西彭泽菩萨戒弟子许止净敬序"},{"level":3,"text":"明嘉靖修山志陈序"},{"level":3,"text":"明万历修山志苏序"},{"level":3,"text":"万历七年己卯仲夏之吉，知青阳县事．江陵苏万民序"},{"level":3,"text":"明崇祯修山志郑序"},{"level":3,"text":"明崇祯修山志王序"},{"level":3,"text":"明崇祯修山志顾序"},{"level":3,"text":"崇祯己巳仲春下浣，西吴顾元镜序"},{"level":3,"text":"清康熙修山志李序"},{"level":2,"text":"九华山志卷一"},{"level":2,"text":"九华山志卷二"},{"level":2,"text":"九华山志卷四"},{"level":2,"text":"九华山志卷五"},{"level":3,"text":"赞礼地藏菩萨忏愿仪后自序"},{"level":3,"text":"为警心居士持《地藏本愿经》兼劝人序"},{"level":2,"text":"九华山志卷六"},{"level":2,"text":"九华山志卷七"},{"level":2,"text":"九华山志卷八"}],"chunksPerFile":20}