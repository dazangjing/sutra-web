{"id":"d8914","title":"釋淨土群疑論探要記","titleTrad":"釋淨土群疑論探要記","byline":"","bylineLabel":"著者·译者","dynasty":"","division":"经疏部","canon":"D8914","canonName":"國圖善本佛典","volume":"D8914","juanCount":14,"textLength":315488,"imageCount":0,"summary":"","tags":["经疏部","國圖善本佛典"],"order":980,"guide":"","chunks":19,"toc":[{"level":2,"text":"釋淨土群疑論探要記卷第一"},{"level":2,"text":"釋淨土群疑論探要記卷第二"},{"level":2,"text":"釋淨土群疑論探要記卷第三"},{"level":2,"text":"釋淨土群疑論探要記卷第四"},{"level":2,"text":"釋淨土群疑論探要記卷第五"},{"level":2,"text":"釋淨土群疑論探要記卷第六"},{"level":2,"text":"釋淨土群疑論探要記卷第八"},{"level":2,"text":"釋淨土群疑論探要記卷第九"},{"level":3,"text":"生一分第六識俱身見等攝下品故不作意緣故"},{"level":3,"text":"為󷓥猛名上品第六識中獨頭貪等名中品通不善"},{"level":2,"text":"釋淨土群疑論探要記卷第十"},{"level":3,"text":"當果故名為順例如彼言順解󷑆分順󷪘択分第三"},{"level":2,"text":"釋淨土群疑論探要記卷第十一"},{"level":3,"text":"𭩮論序云披󲰥决定藏以釈攝大乗唐親攝論序"},{"level":2,"text":"釋淨土群疑論探要記卷第十二"},{"level":2,"text":"釋淨土群疑論探要記卷第十三"},{"level":3,"text":"心體性故見相二分第三分用不離躰故能緣見分"},{"level":2,"text":"釋淨土群疑論探要記卷第十四"}],"chunksPerFile":20}