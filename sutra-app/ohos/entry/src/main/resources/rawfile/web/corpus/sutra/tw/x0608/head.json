{"id":"x0608","title":"法華經知音","titleTrad":"法華經知音","byline":"姚秦三藏法師","bylineLabel":"著者·译者","dynasty":"","division":"法华部","canon":"X0608","canonName":"新纂卍續藏","volume":"X0608","juanCount":7,"textLength":215941,"imageCount":0,"summary":"","tags":["法华部","新纂卍續藏"],"order":3736,"guide":"","chunks":73,"toc":[{"level":3,"text":"妙法蓮華經知音序"},{"level":2,"text":"現耳。故題喻蓮華者此也。若經卷第一"},{"level":3,"text":"循流得源，俱依品目次序，而辭理曆明易知，故序"},{"level":3,"text":"妙法蓮華經弘傳序"},{"level":2,"text":"妙法蓮華經知音卷第一"},{"level":3,"text":"妙法蓮華經序品第一"},{"level":3,"text":"方便品第二"},{"level":2,"text":"妙法蓮華經知音卷第二"},{"level":3,"text":"譬喻品第三"},{"level":3,"text":"一乘之記，同作佛也。此配方便品第八節，舍利弗"},{"level":3,"text":"信解品第四"},{"level":3,"text":"便品第九節非阿羅漢非辟支佛等文。世尊大恩"},{"level":2,"text":"妙法蓮華經知音卷第三"},{"level":3,"text":"藥草喻品第五"},{"level":3,"text":"授記品第六"},{"level":3,"text":"化城喻品第七"},{"level":2,"text":"妙法蓮華經知音卷第四"},{"level":3,"text":"五百弟子受記品第八"},{"level":3,"text":"授學無學人記品第九"},{"level":3,"text":"法師品第十"},{"level":3,"text":"見寶塔品第十一"},{"level":3,"text":"提婆達多品第十二"},{"level":3,"text":"持品第十三"},{"level":2,"text":"妙法蓮華經知音卷第五"},{"level":3,"text":"安樂行品第十四"},{"level":3,"text":"從地涌出品第十五"},{"level":3,"text":"如來壽量品第十六"},{"level":3,"text":"佛也。餘失下，喻鈍根懈怠者，如五千退席，初於序"},{"level":3,"text":"分別功德品第十七"},{"level":2,"text":"妙法蓮華經知音卷第六"},{"level":3,"text":"隨喜功德品第十八"},{"level":3,"text":"法師功德品第十九"},{"level":3,"text":"常不輕菩薩品第二十"},{"level":3,"text":"如來神力品第二十一"},{"level":3,"text":"囑累品第二十二"},{"level":3,"text":"藥王菩薩本事品第二十三"},{"level":2,"text":"妙法蓮華經知音卷第七"},{"level":3,"text":"妙音菩薩品第二十四"},{"level":3,"text":"觀世音菩薩普門品第二十五"},{"level":3,"text":"陀羅尼品第二十六"},{"level":3,"text":"妙莊嚴王本事品第二十七"},{"level":3,"text":"普賢菩薩勸發品第二十八"}],"chunksPerFile":20}