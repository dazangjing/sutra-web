[[{"t":"分别业报略经","level":0},{"t":"大勇菩萨撰","level":0},{"t":"宋天竺三藏僧伽跋摩译","level":0},{"t":"最胜无上尊，知见悉具足，","level":0,"quote":true},{"t":"是故稽首礼，及法应真僧。","level":0,"quote":true},{"t":"我今撰安住，知见具足说，","level":0,"quote":true},{"t":"五趣所缘起，由净不净业。","level":0,"quote":true},{"t":"普为诸世间，开示契经义，","level":0,"quote":true},{"t":"随智力所及，分别业果报。","level":0,"quote":true},{"t":"佛以法自觉，诸天咸劝请，","level":0,"quote":true},{"t":"即至波罗<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00178.gif\" alt=\"㮈\" title=\"㮈\" />，演畅真谛义。","level":0,"quote":true},{"t":"谓苦及苦因，苦集究竟灭，","level":0,"quote":true},{"t":"八正悉具足，尽苦清净道。","level":0,"quote":true},{"t":"无上人中尊，说苦业果报，","level":0,"quote":true},{"t":"从是转相生，烦恼及诸业。","level":0,"quote":true},{"t":"种种相烦恼，无量诸业行，","level":0,"quote":true},{"t":"次第略分别，随顺大仙说。","level":0,"quote":true},{"t":"契经所显示，不违诸法相，","level":0,"quote":true},{"t":"真实决定义，慧者当受持。","level":0,"quote":true},{"t":"非自在所作，果报非无因，","level":0,"quote":true},{"t":"亦非自性起，亦不从时生。","level":0,"quote":true},{"t":"自在天无因，自性及与时，","level":0,"quote":true},{"t":"以果有胜劣，当知彼非因。","level":0,"quote":true},{"t":"无知生烦恼，从是起诸业，","level":0,"quote":true},{"t":"因业开众趣，今当说差别。","level":0,"quote":true},{"t":"造诸不善业，随业入恶道，","level":0,"quote":true},{"t":"彼诸罪众生，阎王慈哀说：","level":0,"quote":true},{"t":"生老病死苦，王法所拘执，","level":0,"quote":true},{"t":"汝见彼天使，何不生胜觉！","level":0,"quote":true},{"t":"惠施清净戒，能调身口意，","level":0,"quote":true},{"t":"汝为何所求，而不发上愿！","level":0,"quote":true},{"t":"不幸遇恶友，唯闻非法事，","level":0,"quote":true},{"t":"增我贪恚痴，何由起净业？","level":0,"quote":true},{"t":"汝曾不修善，但作诸恶行，","level":0,"quote":true},{"t":"不觉罪报至，今来入地狱。","level":0,"quote":true},{"t":"尔时诸狱卒，即执罪众生，","level":0,"quote":true},{"t":"驱向地狱门，恐怖身毛竖。","level":0,"quote":true},{"t":"等活若黑绳，众合二叫呼，","level":0,"quote":true},{"t":"无择大地狱，烧热及大热，","level":0,"quote":true},{"t":"土海及粪池，锋利剑叶林，","level":0,"quote":true},{"t":"刀道剑枝树，灰河铁镬狱，","level":0,"quote":true},{"t":"造诸恶业者，生此泥黎中。","level":0,"quote":true},{"t":"今当说彼业，苦报差别相。","level":0,"quote":true},{"t":"等活死复生，经历亿千劫，","level":0,"quote":true},{"t":"今闻结怨憎，互相伤害故。","level":0,"quote":true},{"t":"陷人以非道，两舌离亲友，","level":0,"quote":true},{"t":"谗谤及妄语，死堕黑绳狱。","level":0,"quote":true},{"t":"屠捕及餘杀，死入众合狱，","level":0,"quote":true},{"t":"诸山所磨切，身碎血髓流。","level":0,"quote":true},{"t":"为政无慈恻，峻法多因缘，","level":0,"quote":true},{"t":"广设诸方便，种种加楚毒，","level":0,"quote":true},{"t":"亦入众合狱，随业受苦报。","level":0,"quote":true},{"t":"轮转崩山芒，铁石所磨捣，","level":0,"quote":true},{"t":"随贪恚痴怖，听讼违抂直，","level":0,"quote":true},{"t":"亦入众合狱，铁轮断其身。","level":0,"quote":true},{"t":"自恃强力势，崄暴陵孤弱，","level":0,"quote":true},{"t":"亦入众合狱，黑象竞来践。","level":0,"quote":true},{"t":"逼迫多人众，令彼大呼泣，","level":0,"quote":true},{"t":"死堕叫呼狱，举身常洞燃。","level":0,"quote":true},{"t":"斗秤欺诳人，心恶而口善，","level":0,"quote":true},{"t":"言行无诚实，入大叫呼狱。","level":0,"quote":true},{"t":"呼哉大呼狱，见者身毛竖，","level":0,"quote":true},{"t":"於中受剧苦，寄付不还故。","level":0,"quote":true},{"t":"非法言是法，见法言非法，","level":0,"quote":true},{"t":"邪见无因果，侮傲谤贤圣，","level":0,"quote":true},{"t":"如是诸人等，死入无择狱。","level":0,"quote":true},{"t":"父母贤善人，沙门婆罗门，","level":0,"quote":true},{"t":"犯忤令忧恼，死入热地狱。","level":0,"quote":true},{"t":"父母贤善人，沙门婆罗门，","level":0,"quote":true},{"t":"恶心加苦痛，死入大热狱。","level":0,"quote":true},{"t":"出家修净行，亏犯律仪戒，","level":0,"quote":true},{"t":"展转相形毁，死入热土狱。","level":0,"quote":true},{"t":"越禁舍正命，邪谄营秽生，","level":0,"quote":true},{"t":"死入热粪池，毒虫贯骨髓。","level":0,"quote":true},{"t":"田猎焚林泽，烧害陆众生，","level":0,"quote":true},{"t":"死入火剑狱，烧剥断支节。","level":0,"quote":true},{"t":"诱取诸众生，诈亲害其命，","level":0,"quote":true},{"t":"乌鵄群饿狗，竞来食其肉。","level":0,"quote":true},{"t":"毁坏正法桥，导人非法行，","level":0,"quote":true},{"t":"死经利刀道，截足断肌骨。","level":0,"quote":true},{"t":"长身百足虫，貌像端正女，","level":0,"quote":true},{"t":"缠身唼髓脑，由彼邪婬故。","level":0,"quote":true},{"t":"於他妇女身，摩触深染著，","level":0,"quote":true},{"t":"驱上剑枝树，往还贯身体。","level":0,"quote":true},{"t":"种种设方便，杀诸水虫类，","level":0,"quote":true},{"t":"死入沸灰河，举身悉糜烂。","level":0,"quote":true},{"t":"吞食热铁丸，融铜灌其口，","level":0,"quote":true},{"t":"铁钉钉其身，盗窃他财故。","level":0,"quote":true},{"t":"增上十不善，神逝入地狱，","level":0,"quote":true},{"t":"次罪堕畜生，餘则入饿鬼。","level":0,"quote":true},{"t":"恚憎不善行，心常乐恶法，","level":0,"quote":true},{"t":"见他苦随喜，死作阎罗卒。","level":0,"quote":true},{"t":"已说诸业行，重者入地狱，","level":0,"quote":true},{"t":"今当说畜生，饿鬼业果报。","level":0,"quote":true},{"t":"身三口四过，及意三不善，","level":0,"quote":true},{"t":"此业若非增，死堕畜生趣。","level":0,"quote":true},{"t":"多欲生鹅鸽，孔雀鸳鸯鸟；","level":0,"quote":true},{"t":"愚痴业所生，蛆蚁飞蛾等。","level":0,"quote":true},{"t":"无智好打缚，报生象马中，","level":0,"quote":true},{"t":"或复作牛羊，麞鹿诸野兽。","level":0,"quote":true},{"t":"瞋恨作虺蛇，蜂蝎毒虫类，","level":0,"quote":true},{"t":"憍慢自矜高，恶心密怀害，","level":0,"quote":true},{"t":"报生合罗婆(八脚兽)，","level":0,"quote":true},{"t":"及作虎师子。虚傲踈崄报，","level":0,"quote":true},{"t":"猪狗驴狐狼。悭悋不惠施，","level":0,"quote":true},{"t":"疾忌多憎恶，轻躁心不住，","level":0,"quote":true},{"t":"死堕猿猴中。强颜少羞耻，","level":0,"quote":true},{"t":"无节多言说，随业获果报，","level":0,"quote":true},{"t":"后受乌鸟身。邪贪无厌足，","level":0,"quote":true},{"t":"两舌离亲友，后受猫狸身，","level":0,"quote":true},{"t":"或作熊罴身。修行大布施，","level":0,"quote":true},{"t":"急性多瞋怒，不依正忆念，","level":0,"quote":true},{"t":"后作大力龙。能修大布施，","level":0,"quote":true},{"t":"高心<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00654.gif\" alt=\"𣣋\" title=\"𣣋\" />蔑人，由斯业行生，","level":0,"quote":true},{"t":"大力金翅鸟。劫盗贤善人，","level":0,"quote":true},{"t":"饮食诸肴饍，堕富单那鬼，","level":0,"quote":true},{"t":"食粪及死尸。欺怖愚尫劣，","level":0,"quote":true},{"t":"疾病诸贫乞，后作富提鬼，","level":0,"quote":true},{"t":"常食诸胎网。颦蹙鄙陋行，","level":0,"quote":true},{"t":"悭惜多贪求，死作贱饿鬼，","level":0,"quote":true},{"t":"形体甚黑瘦。悭贪不布施，","level":0,"quote":true},{"t":"或施还自毁，死堕食吐鬼，","level":0,"quote":true},{"t":"唯膳脓涕唾。自不修福慧，","level":0,"quote":true},{"t":"毁他行布施，悭惜甘麁澁，","level":0,"quote":true},{"t":"乐习鄙秽行，居伏窦下流，","level":0,"quote":true},{"t":"恒食诸不净。常希他人物，","level":0,"quote":true},{"t":"有财不食用，宁弃不行施，","level":0,"quote":true},{"t":"死堕瞋饿鬼。好发他阴私，","level":0,"quote":true},{"t":"害人取财物，餘罪堕饿鬼，","level":0,"quote":true},{"t":"常食人精气。麁言触恼人，","level":0,"quote":true},{"t":"好发他阴私，刚强难调伏，","level":0,"quote":true},{"t":"生焰口饿鬼。炽然他鬪讼，","level":0,"quote":true},{"t":"积财常恐尽，无慈性刚强，","level":0,"quote":true},{"t":"后作食虫鬼，常噉诸蛾蚁，","level":0,"quote":true},{"t":"举身皆火然。抑止他人施，","level":0,"quote":true},{"t":"有财不肯舍，生作巨身鬼。","level":0,"quote":true},{"t":"腹大咽如针。不施不自食，","level":0,"quote":true},{"t":"积聚为子孙，以此业缘故，","level":0,"quote":true},{"t":"后生轻饿鬼。子孙为修福，","level":0,"quote":true},{"t":"因是得信食。若为聚落主，","level":0,"quote":true},{"t":"逼取他财施，死作鸠槃荼，","level":0,"quote":true},{"t":"饮食常随意。若多杀众生，","level":0,"quote":true},{"t":"以肉为施惠，餘罪作罗刹，","level":0,"quote":true},{"t":"常得众美食。微恚少忧戚，","level":0,"quote":true},{"t":"常作修布施，香华自严身，","level":0,"quote":true},{"t":"好作诸伎乐，后作乾闼婆，","level":0,"quote":true},{"t":"为天执乐神。为利而行施，","level":0,"quote":true},{"t":"多瞋好两舌，后作毘舍阇，","level":0,"quote":true},{"t":"其身甚丑陋，髼发而赤眼，","level":0,"quote":true},{"t":"利爪长牙齿。逼他取财物，","level":0,"quote":true},{"t":"而以广行施，性乐心轻躁，","level":0,"quote":true},{"t":"生为负多鬼。多瞋性难满，","level":0,"quote":true},{"t":"好乐修布施，嗜酒喜歌舞，","level":0,"quote":true},{"t":"后生作地神。舆乘献父母，","level":0,"quote":true},{"t":"给施亲善人，禀性多悭悋，","level":0,"quote":true},{"t":"生作游空神。宅舍乘饮食，","level":0,"quote":true},{"t":"以此修惠施，生作虚空神，","level":0,"quote":true},{"t":"常与宫殿俱。我已略分别，","level":0,"quote":true},{"t":"畜生饿鬼趣；今当次第说，","level":0,"quote":true},{"t":"善道人天果。修种种净行，","level":0,"quote":true},{"t":"后生善趣中，随业受果报，","level":0,"quote":true},{"t":"今当如实说。天人阿修罗，","level":0,"quote":true},{"t":"欲求长寿者，不害生为本，","level":0,"quote":true},{"t":"慧者应当知。慈愍不害生，","level":0,"quote":true},{"t":"乐修诸功德，坚固不倾动，","level":0,"quote":true},{"t":"所生离诸难。於诸群生类，","level":0,"quote":true},{"t":"不捶打系缚，由斯不恼业，","level":0,"quote":true},{"t":"所生常无病。未曾修布施，","level":0,"quote":true},{"t":"亦不盗他财，所生常短乏，","level":0,"quote":true},{"t":"多求而少获。能广行布施，","level":0,"quote":true},{"t":"而复夺他物，所生常得财，","level":0,"quote":true},{"t":"随得寻复失。常不盗他物，","level":0,"quote":true},{"t":"时复行少施，方便获财利，","level":0,"quote":true},{"t":"所得恒不失。常不盗他物，","level":0,"quote":true},{"t":"兼复广行施，所生辄大富，","level":0,"quote":true},{"t":"得财常不失。决定修斋戒，","level":0,"quote":true},{"t":"所生遇正法，众见悉爱乐，","level":0,"quote":true},{"t":"名闻普流布。身心常安乐，","level":0,"quote":true},{"t":"易满知止足，夷泰无忧恼，","level":0,"quote":true},{"t":"质直修正行。欲报所生恩，","level":0,"quote":true},{"t":"信心修福业，随其所生处，","level":0,"quote":true},{"t":"常得父餘财。若以饮食施，","level":0,"quote":true},{"t":"长寿好色力，辩慧多财宝，","level":0,"quote":true},{"t":"无病心安乐。施衣得惭愧，","level":0,"quote":true},{"t":"神仪高胜尊，人相悉具足，","level":0,"quote":true},{"t":"覩者莫不欣，其身常安隐，","level":0,"quote":true},{"t":"心适恒喜欢。","level":0,"quote":true},{"t":"施屋得舍宅，宫殿极严丽，","level":0,"quote":true},{"t":"宝藏悉盈满，众具随所欲。","level":0,"quote":true},{"t":"若施井浴池，及与净水浆，","level":0,"quote":true},{"t":"生生无渴乏，所欲常随意。","level":0,"quote":true},{"t":"桥船济未渡，履屣施徒跣，","level":0,"quote":true},{"t":"常得象马车，是则人中天。","level":0,"quote":true},{"t":"若以园林施，常获胜妙果，","level":0,"quote":true},{"t":"一切所依荫，心安无热恼，","level":0,"quote":true},{"t":"众人所爱乐，眷属悉具足。","level":0,"quote":true},{"t":"若人施医药，后生得无病，","level":0,"quote":true},{"t":"长寿常安乐，具足色力财；","level":0,"quote":true},{"t":"无量百千世，不经疫疾劫，","level":0,"quote":true},{"t":"终遇法医王，永拔生死根。","level":0,"quote":true}],[{"t":"造厕除众秽，后无便利患，","level":0,"quote":true},{"t":"身心常清净，见者莫不欢，","level":0,"quote":true},{"t":"缘是离诸垢，究竟获大安。","level":0,"quote":true},{"t":"若为生天上，或复求名闻，","level":0,"quote":true},{"t":"酬恩及望报，恐怖故行施，","level":0,"quote":true},{"t":"获果不清净，所受多麁澁。","level":0,"quote":true},{"t":"祖先建立施，子孙续不绝，","level":0,"quote":true},{"t":"所生蒙遗庆，无量餘财宝。","level":0,"quote":true},{"t":"常叹施功德，有财而不舍，","level":0,"quote":true},{"t":"所生恒贫匮，欲施无财物。","level":0,"quote":true},{"t":"常叹布施德，愍念常周恤，","level":0,"quote":true},{"t":"所生得大富。不乐修福业，","level":0,"quote":true},{"t":"常乐修智慧，而不行布施，","level":0,"quote":true},{"t":"所生常聪哲，贫窭无财产。","level":0,"quote":true},{"t":"唯乐行布施，而不修智慧，","level":0,"quote":true},{"t":"所生得大财，愚暗无知见。","level":0,"quote":true},{"t":"施慧二俱修，所生具财智；","level":0,"quote":true},{"t":"二俱不修者，长夜处贫暗。","level":0,"quote":true},{"t":"布施无正信，后得饶财物，","level":0,"quote":true},{"t":"所受悉麁澁，其心常乐著。","level":0,"quote":true},{"t":"深信行施惠，生得上财宝，","level":0,"quote":true},{"t":"所受皆庄严，其心常爱乐。","level":0,"quote":true},{"t":"善知良福田，恭敬欢喜施，","level":0,"quote":true},{"t":"所生眷属和，俱受安乐报。","level":0,"quote":true},{"t":"心常轻布施，慢意供福田，","level":0,"quote":true},{"t":"后生多财物，虽得不能用，","level":0,"quote":true},{"t":"凡品无异闻，众所不敬慕。","level":0,"quote":true},{"t":"心不轻布施，恭敬修福慧，","level":0,"quote":true},{"t":"生得殊胜财，亲族悉宗敬。","level":0,"quote":true},{"t":"随所应惠施，其心常欢喜，","level":0,"quote":true},{"t":"生得如意财，以道而受用。","level":0,"quote":true},{"t":"乘理获财物，智慧修布施，","level":0,"quote":true},{"t":"财宝自然至，所得皆不失。","level":0,"quote":true},{"t":"时施无留难，明解修福惠，","level":0,"quote":true},{"t":"少求多所获，常得应时物。","level":0,"quote":true},{"t":"若人修净行，远离他所爱，","level":0,"quote":true},{"t":"生得贤良妻，容德悉具足。","level":0,"quote":true},{"t":"慧者常远离，非处非时行，","level":0,"quote":true},{"t":"心安身无过，具足丈夫法，","level":0,"quote":true},{"t":"清净修梵行，贤圣所称赞，","level":0,"quote":true},{"t":"受身常鲜洁，令闻远流布，","level":0,"quote":true},{"t":"众人所瞻仰，诸天咸供养。","level":0,"quote":true},{"t":"若人於此世，远酒离迷乱，","level":0,"quote":true},{"t":"强志不忘误，义辩得无异。","level":0,"quote":true},{"t":"若人不妄语，至诚不虚欺，","level":0,"quote":true},{"t":"受身悉具足，不染恶名称。","level":0,"quote":true},{"t":"若人不两舌，方便善和诤，","level":0,"quote":true},{"t":"生为人中尊，眷属常不坏。","level":0,"quote":true},{"t":"若人不恶口，美言悦众听，","level":0,"quote":true},{"t":"恒闻清净音，宣扬胜妙法。","level":0,"quote":true},{"t":"若人於此世，远离无义语，","level":0,"quote":true},{"t":"诚实及应时，知量饶益说，","level":0,"quote":true},{"t":"后生言常正，闻者乐信行。","level":0,"quote":true},{"t":"若不贪他物，未曾起求想，","level":0,"quote":true},{"t":"所生心安乐，常得天胜财。","level":0,"quote":true},{"t":"若不起瞋恚，打缚恼逼心，","level":0,"quote":true},{"t":"常好修慈忍，后生升梵天。","level":0,"quote":true},{"t":"若人於今世，深信具正见，","level":0,"quote":true},{"t":"有无真实说，习近善知识，","level":0,"quote":true},{"t":"后生天中天，慧光逾日月。","level":0,"quote":true},{"t":"如上所宣说，无量清净业，","level":0,"quote":true},{"t":"随行各受生，世间种种报。","level":0,"quote":true},{"t":"若欲求大利，名称生天乐，","level":0,"quote":true},{"t":"无常求坚固，当勤修德本。","level":0,"quote":true},{"t":"作净不净业，庄严种种果，","level":0,"quote":true},{"t":"若生人道中，杂受黑白报。","level":0,"quote":true},{"t":"童子及盛壮，中年衰老时，","level":0,"quote":true},{"t":"斯各随本缘，迭受苦乐报。","level":0,"quote":true},{"t":"诸业作已增，是则次第受，","level":0,"quote":true},{"t":"虽作不增长，久乃获果报。","level":0,"quote":true},{"t":"若人施不恒，中间致贫匮；","level":0,"quote":true},{"t":"若常修惠施，富乐无穷已。","level":0,"quote":true},{"t":"若人多瞋恚，后生恒丑陋；","level":0,"quote":true},{"t":"慈忍无忿怒，受身常端正。","level":0,"quote":true},{"t":"若人不修慧，所生痴暗冥；","level":0,"quote":true},{"t":"好智习多闻，明哲遇贤圣。","level":0,"quote":true},{"t":"若能伏憍慢，转身生胜族；","level":0,"quote":true},{"t":"愚惑自矜高，常生卑贱中。","level":0,"quote":true},{"t":"谄谀致身曲，讹言形矬陋；","level":0,"quote":true},{"t":"见圣心不喜，","level":0,"quote":true},{"t":"所生常愚憃；瘖痖不能言，","level":0,"quote":true},{"t":"目盲无所见。尊长师善友，","level":0,"quote":true},{"t":"慈心安慰说，厌舍不听受，","level":0,"quote":true},{"t":"所生当聋聩。洗浴诸有德，","level":0,"quote":true},{"t":"供养妙香花，斯人所受生，","level":0,"quote":true},{"t":"身相悉端严，肌体极柔软，","level":0,"quote":true},{"t":"净如炼真金。污所不应污，","level":0,"quote":true},{"t":"邪行犯非处，害形毁众生，","level":0,"quote":true},{"t":"由斯受阉身。若人於今世，","level":0,"quote":true},{"t":"爱欲心炽然，身口及诸根，","level":0,"quote":true},{"t":"尽习妇人法，后常受女身，","level":0,"quote":true},{"t":"多欲不聪慧。若人施灯烛，","level":0,"quote":true},{"t":"演说清净道，迷者示正路，","level":0,"quote":true},{"t":"等爱视众生，后得清净眼，","level":0,"quote":true},{"t":"明彻无障碍。子爱视众生，","level":0,"quote":true},{"t":"哀愍诸贫病，所生多子孙，","level":0,"quote":true},{"t":"如月在众星。慈母乳婴儿，","level":0,"quote":true},{"t":"奉斋修净行，怀姙他所爱，","level":0,"quote":true},{"t":"一切悉不犯；由斯净业故，","level":0,"quote":true},{"t":"生得多婇女，围绕自娱乐，","level":0,"quote":true},{"t":"犹如天帝释。爱敬礼父母，","level":0,"quote":true},{"t":"恭肃诸所尊，后生常高贵，","level":0,"quote":true},{"t":"身体极柔软。若人於今世，","level":0,"quote":true},{"t":"坚固持律行，后得不动财，","level":0,"quote":true},{"t":"犹如雪山王。若人於今世，","level":0,"quote":true},{"t":"常不越仪法，若彼求不求，","level":0,"quote":true},{"t":"等施令满足，后生得妙相，","level":0,"quote":true},{"t":"师子方颊车，具足无尽财，","level":0,"quote":true},{"t":"如海珍宝渚。身口意清净，","level":0,"quote":true},{"t":"兼复行布施，於他无嫉心，","level":0,"quote":true},{"t":"己财不守护，由斯业行报，","level":0,"quote":true},{"t":"后生欝单越。","level":0,"quote":true},{"t":"若人慕名闻，及求生天乐，","level":0,"quote":true},{"t":"依凭善师学，身口意清净。","level":0,"quote":true},{"t":"所有诸财物，爱乐加守护，","level":0,"quote":true},{"t":"由斯业缘故，后生四王家。","level":0,"quote":true},{"t":"若人於今世，志强不随人，","level":0,"quote":true},{"t":"所行多幻伪，亦修诸善法，","level":0,"quote":true},{"t":"乐观他鬪讼，兼行好布施，","level":0,"quote":true},{"t":"由斯业缘故，后作阿修罗。","level":0,"quote":true},{"t":"孝顺净供养，父母诸尊长，","level":0,"quote":true},{"t":"忍辱少瞋恨，不乐观鬪讼，","level":0,"quote":true},{"t":"由斯业缘故，后生忉利天。","level":0,"quote":true},{"t":"若人自不鬪，亦不观他诤，","level":0,"quote":true},{"t":"精勤修善法，得作夜摩天。","level":0,"quote":true},{"t":"於身善观察，好学集多闻，","level":0,"quote":true},{"t":"专精思惟义，乐修净功德，","level":0,"quote":true},{"t":"由斯业缘故，后生兜率天。","level":0,"quote":true},{"t":"修习胜布施，乐诵诸经典，","level":0,"quote":true},{"t":"方便行善法，自力不由他，","level":0,"quote":true},{"t":"慇懃精进故，后生化乐天。","level":0,"quote":true},{"t":"修行胜布施，善摄护诸根，","level":0,"quote":true},{"t":"精勤不退转，欣乐他功德，","level":0,"quote":true},{"t":"由斯业缘故，后生他化天。","level":0,"quote":true},{"t":"舍离炽然欲，修习四梵行，","level":0,"quote":true},{"t":"离生欣乐俱，转身生梵宫。","level":0,"quote":true},{"t":"又离觉观心，亦度离生喜，","level":0,"quote":true},{"t":"定生喜乐俱，上生光音天。","level":0,"quote":true},{"t":"离定生喜乐，一向与乐俱，","level":0,"quote":true},{"t":"舍念三摩提，生彼遍净天。","level":0,"quote":true},{"t":"悉已度苦乐，不苦不乐俱，","level":0,"quote":true},{"t":"舍及清净念，得生广果天。","level":0,"quote":true},{"t":"觉知离想过，及厌五种有，","level":0,"quote":true},{"t":"深爱著无想，生彼无想天。","level":0,"quote":true},{"t":"世俗及无漏，修习诸熏禅，","level":0,"quote":true},{"t":"熏禅正受力，生五净居天。","level":0,"quote":true},{"t":"修习软中品，无烦无热天；","level":0,"quote":true},{"t":"修习上三品，次生三净天。","level":0,"quote":true},{"t":"如是次第上，乃至色究竟。","level":0,"quote":true},{"t":"依色无常想，超修无量空；","level":0,"quote":true},{"t":"次观无量识，舍至无所有，","level":0,"quote":true},{"t":"又离无所有，乃至非非想。","level":0,"quote":true},{"t":"我已说生死，有有果报等，","level":0,"quote":true},{"t":"於彼业果报，慧者当观察。","level":0,"quote":true},{"t":"应修清净业，离苦疾受乐，","level":0,"quote":true},{"t":"已说诸生死，种种业差别。","level":0,"quote":true},{"t":"非自在天生，亦非自然有，","level":0,"quote":true},{"t":"非时非无因，唯从烦恼起。","level":0,"quote":true},{"t":"观彼有无常，慧者不染著，","level":0,"quote":true},{"t":"出离诸系缚，永到安隐处。","level":0,"quote":true},{"t":"分别业报略经","level":0}]]