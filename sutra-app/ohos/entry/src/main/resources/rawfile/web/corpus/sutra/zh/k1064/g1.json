[[{"t":"经卷第二十","level":2},{"t":"十行品之二","level":0},{"t":"无所<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />恋","level":0},{"t":"(广雅曰<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />眷也)。","level":0},{"t":"毗<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />","level":0},{"t":"(正云毗奈耶此曰调伏谓调身语七种非故或调三业令不造<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />)。","level":0},{"t":"无聡敏","level":0},{"t":"(聡犹忩速谓记览疾也杜注左传曰敏达也)。","level":0},{"t":"顽嚚","level":0},{"t":"(顽五鳏反嚚鱼巾反广雅曰顽钝也苍颉篇曰嚚<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />也)。","level":0},{"t":"匪懈","level":0},{"t":"(匪方尾反孝经曰夙夜匪懈以事一人郑注匪非也懈惰也按非犹不也无也)。","level":0},{"t":"至法渊底","level":0},{"t":"(渊乌玄反毛诗曰渊深也)。","level":0},{"t":"无所适莫","level":0},{"t":"(适丁历反蜀志诸葛亮曰事以覆踈易夺为益无适无莫为平人情苦亲亲而踈踈故适莫之道废人皆乐人从己不乐己从人故易夺之义癈也论语云子曰君子之於天下无适无莫也汉书注曰适主也[迄-乙+小]雅曰莫定也谓普於一切无偏主亲无偏定踈也)。","level":0},{"t":"冀望","level":0},{"t":"(珠丛曰冀谓心有所希求也)。","level":0},{"t":"缕","level":0},{"t":"(力主反)。","level":0},{"t":"不迁身","level":0},{"t":"(迁七延反郑注礼记曰迁变改也)。","level":0},{"t":"暨于法界","level":0},{"t":"(上渠噐反珠丛曰暨谓及頼也)。","level":0},{"t":"该","level":0},{"t":"(广雅曰该包也)。","level":0},{"t":"未尝","level":0},{"t":"(玉篇曰尝谓昔暂为之也今此云未尝者即是未尝为之也)。","level":0},{"t":"聡哲","level":0},{"t":"(书曰知人则哲[迄-乙+小]雅曰哲智也)。","level":0},{"t":"靡所俦","level":0},{"t":"(俦直由反珠丛曰俦玉篇曰俦类也)。","level":0}],[{"t":"经卷第二十一","level":2},{"t":"十无尽藏品","level":0},{"t":"分减施","level":0},{"t":"(分方云反减间斩反)。","level":0},{"t":"不非先制","level":0},{"t":"(说文曰非违也)。","level":0},{"t":"贡高","level":0},{"t":"(广雅曰贡上也谓受贡上之国自恃尊高则轻易附庸之国今有自高陵物欲人[實-毌+尸]伏者则亦谓之贡高也)。","level":0},{"t":"陵夺","level":0},{"t":"(苍颉篇曰陵侵也夺字有作夺者俗)。","level":0},{"t":"启导","level":0},{"t":"(说文曰启开也教也导引也)。","level":0},{"t":"辍己","level":0},{"t":"(己居里反珠丛曰辍止也谓止却自用回与人也)。","level":0},{"t":"夭命","level":0},{"t":"(夭於矫反孔安注书云少丧曰夭也字有作夭者不是字也)。","level":0},{"t":"身婴重疾","level":0},{"t":"(婴於盈反汉书集注曰婴绕也谓带<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11042.gif\" alt=\"𤵜\" title=\"𤵜\" />疾犹物之緾绕人也)。","level":0},{"t":"年方","level":0},{"t":"(玉篇曰方始也正也)。","level":0},{"t":"焭独<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07710.gif\" alt=\"𮊵\" title=\"𮊵\" />顿","level":0},{"t":"(焭渠营反孔安注书曰焭单也玉篇云无兄弟曰焭无子曰独文字集略曰顿[損-口+ㄙ]也焭字又作焭惸嬛<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09241.gif\" alt=\"𡞦\" title=\"𡞦\" />三躰)。","level":0},{"t":"冝时疾舍","level":0},{"t":"(时速也此盖蒲板方俗之言)。","level":0},{"t":"王四天下","level":0},{"t":"(王于诳反韩康注易曰主盛也威德之至王天下)。","level":0},{"t":"我今贫𪧘","level":0},{"t":"(𪧘其矩反苍颉篇云无财曰贫无财俻礼谓之𪧘也)。","level":0},{"t":"特垂矜念","level":0},{"t":"(汉书集注曰特独也毛诗传曰矜怜也谓偏独忧怜也)。","level":0},{"t":"以赡於我","level":0},{"t":"(赡时燄反小雅曰赡足也声类曰赡助也)。","level":0},{"t":"我等钦风","level":0},{"t":"(孔安注书曰钦敬也风教也郑玄注周礼曰风者圣贤治道之遗化也今谓敬用其教令也)。","level":0},{"t":"都不可得","level":0},{"t":"(汉书拾遗曰都捴也)。","level":0},{"t":"我身薄祜","level":0},{"t":"(祜胡古反郑牋诗曰祜福也言宜从示边古经本有示边作右音尤救反孔子述易曰祐者助也按经本意明不具足身由薄福所致非関见在人天助故不从右也)。","level":0},{"t":"诸根残[(垂-┴+山)*夬]","level":0},{"t":"([(垂-┴+山)*夬]倾雪反苍颉篇曰残伤也)。","level":0},{"t":"不净微形","level":0},{"t":"(毛诗传曰微疡也疡音移益反郭注[迄-乙+小]雅曰疡疮也言身之不净如疮也又王注书曰微贱也言此不净之身非可贵重也疡微从彳贱微从亻也)。","level":0},{"t":"胞[(暇-日)-(己-(乳-孚))+口]","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01008.gif\" alt=\"𫨻\" title=\"𫨻\" />徒玩反胞胎分<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01008.gif\" alt=\"𫨻\" title=\"𫨻\" />故云胞<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01008.gif\" alt=\"𫨻\" title=\"𫨻\" />)。","level":0},{"t":"祇夜","level":0},{"t":"(此云讽诵)。","level":0},{"t":"伽陁","level":0},{"t":"(此云讽重诵)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />陁<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />","level":0},{"t":"(此云因缘然有三类一因请而说二因犯制戒三因事说法也)。","level":0},{"t":"优陁<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />","level":0},{"t":"(此云无问自说也)。","level":0},{"t":"娆乱","level":0},{"t":"(娆乃乌反三苍曰挠扰也孔安注书曰扰烦也)。","level":0},{"t":"过咎","level":0},{"t":"(咎渠久反玉篇曰咎罪也孔安注书曰咎<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />也)。","level":0}],[{"t":"经卷第二十二","level":2},{"t":"升兜率天宫品","level":0},{"t":"绮焕","level":0},{"t":"(焕呼换反张载注灵光殿赋云绮文也何晏注论语曰焕明也言也文彩分明也)。","level":0},{"t":"频婆帐","level":0},{"t":"(频婆此云身影质谓此帐上<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />严具中能现一切外质之影也或曰频婆鲜赤果名此帐似之故以名也)。","level":0},{"t":"彰施","level":0},{"t":"(孔安注书曰彰明也施犹发也言以妙宝发明於妙色也)。","level":0},{"t":"频婆罗香","level":0},{"t":"(或色鲜赤或能现影准前帐释)。","level":0},{"t":"香气发越","level":0},{"t":"(汉书集注曰发越谓香气射散也言香气才发四散著人如箭射速中也)。","level":0},{"t":"阿楼<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />香","level":0},{"t":"(红赤色香色一如日欲出前之红赤相即梵语中呼彼赤相为阿楼那也)。","level":0},{"t":"拘苏摩华","level":0},{"t":"(此之一名有通有别谓但果木诸花通名拘苏摩又有一花独名拘苏摩其花大小如钱色甚鲜白众多细[葉-世+ㄊ]圆集共成乍如此方白菊花也)。","level":0},{"t":"楼阁延袤","level":0},{"t":"(袤莫搆反[迄-乙+小]雅曰延长也切韵称袤广也声类云袤长也史记曰蒙恬筑长城延袤[一/力]餘里是也说文亦同此释也)。","level":0},{"t":"鲜白衣","level":0},{"t":"(鲜斯延反玉篇曰鲜好也明也)。","level":0},{"t":"天牟陁罗","level":0},{"t":"(牟陁罗者三面鼓也)。","level":0},{"t":"因於抚击","level":0},{"t":"(抚孚武反字正冝作拊广雅曰拊击也释名曰敷也敷以手拍之拍搏也经本作抚字者此乃抚育按抚之字也)。","level":0},{"t":"克谐众乐","level":0},{"t":"([迄-乙+小]雅曰克能也孔安注书曰谐和也言能以众多音乐和合成诸歌曲也)。","level":0},{"t":"稽首作礼","level":0},{"t":"(周礼大祝辩九拜之仪一曰稽首再拜头至地也二曰顿首再拜头叩地也三曰空首再拜头至手也四曰振首战动拜也五曰吉祥拜<img class=\"gaiji\" src=\"asset://gaiji-CB/05/CB05861.gif\" alt=\"𪗋\" title=\"𪗋\" />缞不拜也下拜六[凵@又]拜稽颡而后拜谓三年服者七曰奇拜谓一拜八曰褒拜谓报拜也九曰肃拜谓但俯而下手也)。","level":0},{"t":"不瞬","level":0},{"t":"(瞬舒闻反说文曰瞬谓目开閇数摇也字正体作瞚今并随俗作瞬也)。","level":0},{"t":"阿迦<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />咤天","level":0},{"t":"(具云阿迦<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />瑟咤言阿迦者色也<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />瑟咤究竟也言其色界十八天中此最终极也又云阿无也迦尼瑟咤小也谓色界十八天中<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />下一天唯小无大餘十六天上下<img class=\"gaiji\" src=\"asset://gaiji-CB/28/CB28575.gif\" alt=\"㸦\" title=\"㸦\" />望亦大亦小此之一天唯大无小故以名)。","level":0},{"t":"如是仪则","level":0},{"t":"([迄-乙+小]雅曰仪法也)。","level":0},{"t":"恱豫","level":0},{"t":"(豫余据反珠丛曰心安和悦谓之豫也)。","level":0}],[{"t":"经卷第二十三","level":2},{"t":"兜率天宫偈赞品","level":0},{"t":"良沃田","level":0},{"t":"(沃乌鹄反汉书集注曰沃溉灌也言其土地有溉灌之利也今谓溉灌之田复加肥善故曰良沃田也)。","level":0},{"t":"十回向品","level":0},{"t":"瞋佷","level":0},{"t":"(佷何垦反杜注左传曰佷戾也说文曰佷不听从也按玉篇佷字在彳部今多从立亻盖是时俗共行也)。","level":0},{"t":"崇岩邃谷","level":0},{"t":"(邃辛酔反郑注考工记曰崇高也说文曰邃深也邃字从遂韵也)。","level":0},{"t":"入苦笼槛","level":0},{"t":"(槛胡黤反笼字正冝作拢三苍曰栊所以宬禽狩阑槛也说文曰拢牢也郭璞注山海经曰槛阑也谓穿地为坈上櫺子以阑禽狩也今经意谓三界皆苦如彼拢槛囚系众生也或谓三途剧苦名苦拢槛者也)。","level":0},{"t":"众苦大壑","level":0},{"t":"(壑呵各反兼名苑曰东海有大燋石一名沃燋方圆三万里水沃之则消尽过此有大壑一名尾闾深莫测其涯海水常澍不知其所之也今经意谓生死海中三苦八苦无有涯底如彼大壑故借喻言耳)。","level":0},{"t":"五欲所致","level":0},{"t":"(颜注汉书曰致谓引而至之也)。","level":0},{"t":"志独无侣","level":0},{"t":"(郑注礼记曰志意也侣伴也谓广心独济不待伴也)。","level":0},{"t":"顾复一切众生","level":0},{"t":"(复扶福反诗云父兮生我母兮掬我拊我畜我长我育我<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />我复我出入复我郑玄牋曰<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />视也复反也言去子虽近犹步步反视也又牋诗曰是复者<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />念而重复之也今经意菩萨於众生亦然矣)。","level":0}],[{"t":"经卷第二十四","level":2},{"t":"回向品之二","level":0},{"t":"供养瞻待","level":0},{"t":"(毛诗传曰瞻视也郑注周礼曰待给也谓看视供给之也)。","level":0},{"t":"宝珰树","level":0},{"t":"(珰得郎反释名曰穿耳施珠曰珰按其一当乃用数种[玝-十+小]贯穿重悬之也)。","level":0},{"t":"萨婆若","level":0},{"t":"(具云萨婆若囊萨婆此云一切也若囊智也)。","level":0},{"t":"轩槛","level":0},{"t":"(轩许言反槛胡黤反汉书音义曰轩谓槛上板也珠丛曰槛谓殿之阑也汉书集注曰槛谓轩前阑板也)。","level":0},{"t":"澡漱","level":0},{"t":"(澡子老反漱史救反苍颉篇曰澡盥也盥音古满反珠丛曰盥洗手也说文曰漱荡口者也)。","level":0},{"t":"群萌","level":0},{"t":"(萌莫耕反汉书集注曰萌谓草木初生也毛诗传曰群众也言童蒙凡夫犹彼众小草也又或字冝作氓毛诗传曰氓民氓音与萌同也)。","level":0},{"t":"无躁<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15137.gif\" alt=\"𥪰\" title=\"𥪰\" />心","level":0},{"t":"(躁则到反贾逵注国语曰躁扰也郑注论语曰躁谓不安静也有见为二二则为<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15137.gif\" alt=\"𥪰\" title=\"𥪰\" />则是动不安静也)。","level":0}],[{"t":"经卷第二十五","level":2},{"t":"回向品之三","level":0},{"t":"忏除","level":0},{"t":"(忏梵音也具云忏摩此云请忍谓请贤圣或清净僧忍受悔过)。","level":0},{"t":"恬然宴寂","level":0},{"t":"(恬田盐反宴於见反方言曰恬然静也汉书音义曰宴安居也寂无声也)。","level":0},{"t":"超然出现","level":0},{"t":"(郑注书曰超出前也方言曰超远也谓独出高远也)。","level":0},{"t":"其心[弓*(乞-乙+小)]广","level":0},{"t":"(郭注[迄-乙+小]雅曰[弓*(乞-乙+小)]极意也言心极广大耳)。","level":0},{"t":"临御大国","level":0},{"t":"(贾注国语曰临治也郑注礼记曰御主也谓主领而治理之也)。","level":0},{"t":"名振天下","level":0},{"t":"(振之刃反说文曰振举也杜注左传曰振发也谓加名远发起也)。","level":0},{"t":"发号施令","level":0},{"t":"(广雅曰号告也施设也令教也谓发言告云设教使行之也)。","level":0},{"t":"溥荫万方","level":0},{"t":"(溥潘补反珠丛曰溥遍也今并作普字也)。","level":0},{"t":"感德从化","level":0},{"t":"([迄-乙+小]雅曰感动也毛诗传曰从随也说文曰依教行曰化也言德能动之谓教令也)。","level":0},{"t":"一切周给","level":0},{"t":"(谓周帀供给故云周给也)。","level":0},{"t":"被[戮-(彰-章)+小]","level":0},{"t":"(隆育反贾逵注国语曰[戮-(彰-章)+小]煞也)。","level":0},{"t":"僧坊","level":0},{"t":"(坊甫良反韵林曰坊区也谓区院也)。","level":0},{"t":"揣食","level":0},{"t":"(揣字正冝抟音徒鸾反字从专声非从甫韵流俗不能别兹两形遂用揣字揣初委反此乃揣量之字也)。","level":0},{"t":"咽咀","level":0},{"t":"(咽於见反咀才与反广雅曰咀嚼也)。","level":0},{"t":"不欬","level":0},{"t":"(欬克代反玉篇曰欬上欶也欶音<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04973.gif\" alt=\"𮓁\" title=\"𮓁\" />豆反)。","level":0},{"t":"芬馥","level":0},{"t":"(馥扶福反郑注[迄-乙+小]雅曰芬香气调也字林曰馥香气盛也)。","level":0},{"t":"覆育","level":0},{"t":"(贾注国语曰育生也言如天覆如地生也)。","level":0},{"t":"车<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00006.gif\" alt=\"𤦲\" title=\"𤦲\" />","level":0},{"t":"(梵音正云牟娑罗揭婆言牟婆罗者此云胜也揭婆藏也旧名为车<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00006.gif\" alt=\"𤦲\" title=\"𤦲\" />者所未详也)。","level":0},{"t":"[狦-(狂-王)+王]瑚","level":0},{"t":"(梵本正云钵攞婆褐罗宝树之名其树身干枝条叶皆红色又按说文云珊瑚色亦生之於海或出山中也)。","level":0}],[{"t":"经卷第二十六","level":2},{"t":"回向品之四","level":0},{"t":"贫穷孤露","level":0},{"t":"(孤焭裸露故云孤露)。","level":0},{"t":"驾以骏马","level":0},{"t":"(骏将闻反驾<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00501.gif\" alt=\"䭾\" title=\"䭾\" />也说文曰骏谓马之良才也又音私闰反毛诗传曰骏俊也两义俱通)。","level":0},{"t":"牵御","level":0},{"t":"(御鱼据反广雅曰御侍也进也)。","level":0},{"t":"驾驭","level":0},{"t":"(驭鱼据反玉篇曰驭即古之御字也今按诸书装鞁为驾牵御为驭也)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />严岠丽","level":0},{"t":"(巨字古作岠珠丛曰岠至也王逸注楚辝曰丽美好也谓至极美好者也)。","level":0},{"t":"翼从","level":0},{"t":"(孔安注书曰翼辅也毛诗传曰翼敬也)。","level":0},{"t":"疲<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01076.gif\" alt=\"䪺\" title=\"䪺\" />","level":0},{"t":"(文字集略曰<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01076.gif\" alt=\"䪺\" title=\"䪺\" />[損-口+ㄙ]也谓劳倦者[損-口+ㄙ]力也)。","level":0},{"t":"柔明","level":0},{"t":"(孔安注书曰柔谓和柔也言其行调柔识明利也)。","level":0},{"t":"袨服<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />严","level":0},{"t":"(袨胡练反切韵称好衣曰袨服虔注汉书曰袨服大盛玄黄之服也)。","level":0},{"t":"年齿","level":0},{"t":"(杜注左传曰齿列也谓与己同行列也司马彪注<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />子曰齿数也谓年寿之数也)。","level":0},{"t":"奉养","level":0},{"t":"(养余亮反说文曰奉承也谓承事供养也)。","level":0},{"t":"其心旷然","level":0},{"t":"(旷苦谤反河上公注老子经曰旷广大也说文曰旷明也)。","level":0},{"t":"[玝-十+小]竒万计","level":0},{"t":"(说文曰计筭也谓筭计有[一/力]故曰万计也)。","level":0},{"t":"周帀填饰","level":0},{"t":"(填唐贤反贾注国语曰填加也言加之以饰又字或冝作钿音与填同文字集略云钿谓金花也)。","level":0},{"t":"万邦遵奉","level":0},{"t":"(郑玄注周礼曰大曰邦小曰国邦之所居亦曰国也三苍曰遵习也[迄-乙+小]雅曰导从也说文曰奉承也言从命承禀也)。","level":0},{"t":"享灌顶位","level":0},{"t":"(享虚两反玉篇曰享当也杜注左传曰享受也)。","level":0},{"t":"庇荫","level":0},{"t":"(庇必至反郑注礼记曰庇荫者也)。","level":0},{"t":"光逾曒日","level":0},{"t":"(曒经了反埤苍曰曒明也声韵作晈)。","level":0},{"t":"首冠十力<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />严之冠","level":0},{"t":"(上<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10119.gif\" alt=\"𭁺\" title=\"𭁺\" />字音古乱反郑注礼记曰著<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10119.gif\" alt=\"𭁺\" title=\"𭁺\" />为<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10119.gif\" alt=\"𭁺\" title=\"𭁺\" />也下<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10119.gif\" alt=\"𭁺\" title=\"𭁺\" />字音古及反)。","level":0},{"t":"捡系其身","level":0},{"t":"(汉书音义曰捡局也谓系缚局也)。","level":0},{"t":"永诀","level":0},{"t":"(诀古穴反切韵称诀别也)。","level":0},{"t":"砧","level":0},{"t":"(陟林反斫剉之机也字又作碪)。","level":0},{"t":"屠割","level":0},{"t":"(玉篇曰屠谓分割牲肉也)。","level":0},{"t":"木枪","level":0},{"t":"(枪七羊反苍颉篇曰枪谓木两头<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07536.gif\" alt=\"𨦣\" title=\"𨦣\" />者也又音楚庚反非此所用也经本有作锵者此乃铿锵之字深为差[謵-白+尒]失经意也)。","level":0},{"t":"贯","level":0},{"t":"(古瓦反)。","level":0},{"t":"阿逸多","level":0},{"t":"(正云阿制多此曰无能胜也)。","level":0},{"t":"语主者言","level":0},{"t":"(广雅曰主也谓守当者也)。","level":0},{"t":"记莂","level":0},{"t":"(莂彼列反本作别字者误)。","level":0}],[{"t":"经卷第二十七","level":2},{"t":"回向品之五","level":0},{"t":"密致发","level":0},{"t":"(致直利反经本有作稚字者此乃幼稚之字深为谬)。","level":0},{"t":"光明鉴彻","level":0},{"t":"(鉴古忏反广雅曰鉴照也)。","level":0},{"t":"聋聩耳","level":0},{"t":"(聩五<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03890.gif\" alt=\"𪫦\" title=\"𪫦\" />反韦昭注国语曰耳不别五乐之和谓之聋从生即聋谓之聩字又作[蔽/耳]二形)。","level":0},{"t":"蒙昧","level":0},{"t":"(郑玄注周礼曰蒙冒也苍颉篇曰昧冥也言昏冒暗冥也)。","level":0},{"t":"辍身要用","level":0},{"t":"(珠丛曰辍止也谓止绝已之要用也)。","level":0},{"t":"铦白牙齿","level":0},{"t":"(铦斯<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21892.gif\" alt=\"𥂁\" title=\"𥂁\" />反汉书音义铦利也字从舌声也)。","level":0},{"t":"迦尸国","level":0},{"t":"(迦尸者西域竹名也其竹堪为箭干然以其国多出此竹故立斯名其国即在中天竺境憍萨罗国之北隣乃是十六大国之一数也)。","level":0},{"t":"寻即败坏","level":0},{"t":"(杜注左传曰寻续也言绝成已续即坏也)。","level":0},{"t":"逄<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02956.gif\" alt=\"𨒦\" title=\"𨒦\" />引纳","level":0},{"t":"(方言曰逄谓逆迎也纳入也谓逆首迎之引入住处也)。","level":0},{"t":"不尚","level":0},{"t":"(杜注左传曰尚上也今谓不以之为上也)。","level":0},{"t":"佣","level":0},{"t":"(丑恭反又音与恭反非此所用字又作<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00166.gif\" alt=\"𦟛\" title=\"𦟛\" />)。","level":0},{"t":"七仞","level":0},{"t":"(汝胤反何承纂要云七尺曰仞小雅曰四尺曰仞)。","level":0},{"t":"慈仁莅物","level":0},{"t":"(莅力至反毛诗传曰莅临也)。","level":0},{"t":"心怀残忍","level":0},{"t":"(汉书集注曰残谓多所煞[戮-(彰-章)+小]也今谓忍於煞[戮-(彰-章)+小]故云残忍者也)。","level":0},{"t":"众罪由生","level":0},{"t":"([迄-乙+小]雅曰由从也)。","level":0},{"t":"一切宗信","level":0},{"t":"(白虎通曰宗尊言尊重信受也)。","level":0}],[{"t":"经卷第二十八","level":2},{"t":"回向品之六","level":0},{"t":"造立精舍","level":0},{"t":"(艺文类聚云精舍者非以舍之精妙名为舍由其精练行者之所居故谓之精舍也)。","level":0},{"t":"资生什物","level":0},{"t":"(汉书集注曰什物者为生之具三苍曰什聚也杂也吴楚闲谓资生杂具为什物也)。","level":0},{"t":"恭恪","level":0},{"t":"(恪康鸖反孔安注书曰恪敬也)。","level":0},{"t":"不匮","level":0},{"t":"(匮其位反汉书音曰匮空也广雅曰匮乏也)。","level":0},{"t":"王京都","level":0},{"t":"(公羊传曰京师者何天子之居也京者大也师者众也天子之居以众大之辤言之也左氏传曰邑有宗庿先君之主曰都元者曰邑广雅曰都国也风俗通曰天子治居之域旧曰都曰邑者也)。","level":0},{"t":"関防","level":0},{"t":"(防浮妄反)。","level":0},{"t":"妓侍众女","level":0},{"t":"(妓奇绮反埤苍曰妓美女也为侍谓之妓侍也或曰妓女乐也美女为乐亦云妓乐或有作伎者言支义反伤<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10329.gif\" alt=\"𡧱\" title=\"𡧱\" />也非此所用也)。","level":0},{"t":"罄所[玝-十+小]","level":0},{"t":"(毛诗传曰罄尽杜注左传曰[玝-十+小]宝也)。","level":0},{"t":"中悔","level":0},{"t":"(中陟仲反)。","level":0},{"t":"[弓*(乞-乙+小)]宣正法","level":0},{"t":"(刘𤩽注易曰[弓<em>(乞-乙+小)]广也郭璞注[迄-乙+小]雅曰[弓</em>(乞-乙+小)]极意也[迄-乙+小]雅曰宣明者也)。","level":0},{"t":"无毒虐","level":0},{"t":"(孔安注书曰虐暴也言无毒<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />猝暴之性也)。","level":0},{"t":"率土","level":0},{"t":"(玉篇曰率遵也用也谓遵用教命之处也)。","level":0},{"t":"床蓐","level":0},{"t":"(蓐如欲反声类曰蓐荐也郭璞注[迄-乙+小]雅曰蓐席也案古者荐席通称谓之蓐也然本别有厚氊衣以表里亦谓之褥其字正冝从衣边作辱也)。","level":0}],[{"t":"经卷第二十九","level":2},{"t":"回向品之七","level":0},{"t":"己头充满","level":0},{"t":"(己基理反)。","level":0},{"t":"僮<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03878.gif\" alt=\"㒒\" title=\"㒒\" />作使","level":0},{"t":"(作则各反使所吏反按玉篇古之用字幼童为僮<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03878.gif\" alt=\"㒒\" title=\"㒒\" />为与今一倍别也郑注礼记曰<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03878.gif\" alt=\"㒒\" title=\"㒒\" />谓贱伇之人也)。","level":0},{"t":"发言诚谛","level":0},{"t":"(河上公注老子曰诚实也方言曰谛审也谓所出言教真实审定也)。","level":0},{"t":"庶品","level":0},{"t":"(庶众也品类也众多流类谓之众类也)。","level":0}],[{"t":"经卷第三十","level":2},{"t":"回向品之八","level":0},{"t":"若专励","level":0},{"t":"(励力制反杜注左传曰励劝也玉篇曰励勉也谓自强筞勤也)。","level":0},{"t":"若起行","level":0},{"t":"(行遐孟反)。","level":0}],[{"t":"经卷第三十一","level":2},{"t":"回向品之九","level":0},{"t":"周闻","level":0},{"t":"(闻无运反)。","level":0},{"t":"