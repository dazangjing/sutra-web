{"id":"t2059","title":"高僧傳","titleTrad":"高僧傳","byline":"梁會稽嘉祥寺沙門釋慧皎撰、CBETA 校注大正藏 校注新增校注","bylineLabel":"著者·译者","dynasty":"","division":"史传部","canon":"T2059","canonName":"大正藏","volume":"T2059","juanCount":14,"textLength":176296,"imageCount":0,"summary":"","tags":["史传部","大正藏"],"order":2812,"guide":"","chunks":20,"toc":[{"level":2,"text":"高僧傳卷第一"},{"level":2,"text":"高僧傳卷第二"},{"level":2,"text":"高僧傳卷第三"},{"level":2,"text":"高僧傳卷第四"},{"level":2,"text":"高僧傳卷第五"},{"level":3,"text":"暫往，朱序西鎮，復請還襄陽，深相結納，序"},{"level":3,"text":"以輔朕躬。」後遣符丕南攻襄陽，安與朱序"},{"level":2,"text":"高僧傳卷第六"},{"level":2,"text":"高僧傳卷第七"},{"level":2,"text":"高僧傳卷第八"},{"level":3,"text":"年初，勅亮撰《涅槃義疏》十餘萬言。上為之序"},{"level":2,"text":"高僧傳卷第九"},{"level":2,"text":"高僧傳卷第十"},{"level":2,"text":"高僧傳卷第十一"},{"level":2,"text":"高僧傳卷第十二"},{"level":2,"text":"高僧傳卷第十三"},{"level":2,"text":"一往以貌輕之。及聞披卷三"},{"level":2,"text":"高僧傳序錄卷第十四"},{"level":2,"text":"山，遇見時事，聊記之云爾。序錄高僧傳序錄卷第十四"}],"chunksPerFile":20}