[[{"t":"佛说六道伽陀经","level":0},{"t":"西天中印度摩伽陀国那烂陀寺三藏传教大师赐紫沙门臣法天奉　诏译","level":0},{"t":"归命一切佛，及诸菩萨众，","level":0,"quote":true},{"t":"愿开正智慧，忆念佛功德。","level":0,"quote":true},{"t":"归依三界尊，身口意三业，","level":0,"quote":true},{"t":"所作善不善，为彼作分别。","level":0,"quote":true},{"t":"彼人受果报，无有主宰者，","level":0,"quote":true},{"t":"三界天中尊，愿起於悲智，","level":0,"quote":true},{"t":"广为世间说，我今闻彼说。","level":0,"quote":true},{"t":"如依於轮回，观察业果报，","level":0,"quote":true},{"t":"佛说恶道因，贪瞋痴为本。","level":0,"quote":true},{"t":"若人行杀害，彼业随缠缚，","level":0,"quote":true},{"t":"决定堕等活，五百岁方出。","level":0,"quote":true},{"t":"彼彼等活者，重重受生死，","level":0,"quote":true},{"t":"是故说等活。父母及亲姻，","level":0,"quote":true},{"t":"眷属善知识，欺慢若憎嫌，","level":0,"quote":true},{"t":"堕落於黑绳。炽焰麁澁绳，","level":0,"quote":true},{"t":"缠缚有情体，如锯解树木，","level":0,"quote":true},{"t":"是故名黑绳。若堕於炎热，","level":0,"quote":true},{"t":"猛火竞来烧，焰焰相接续，","level":0,"quote":true},{"t":"令彼罪业人，奔聚都一处，","level":0,"quote":true},{"t":"烧燃苦恼深，是故说炎热。","level":0,"quote":true},{"t":"修习非法行，恼乱於大众，","level":0,"quote":true},{"t":"说彼无有尽，堕彼极炎热。","level":0,"quote":true},{"t":"入此恶道已，炽极火烧煮，","level":0,"quote":true},{"t":"热苦受长时，是名极炎热。","level":0,"quote":true},{"t":"猪羊狼兔等，及餘诸物命，","level":0,"quote":true},{"t":"如是行杀害，而堕於众合。","level":0,"quote":true},{"t":"堕彼恶趣已，众山合身碎，","level":0,"quote":true},{"t":"痛苦不可当，故得名众合。","level":0,"quote":true},{"t":"若起身口意，而发诸烦恼，","level":0,"quote":true},{"t":"欺诳於有情，堕落於号叫。","level":0,"quote":true},{"t":"入彼恶道已，暴恶火烧身，","level":0,"quote":true},{"t":"叫苦声不绝，是故名号叫。","level":0,"quote":true},{"t":"圣贤净行师，所有财宝等，","level":0,"quote":true},{"t":"若贪若偷盗，而堕大号叫。","level":0,"quote":true},{"t":"若诸偷盗业，感大火烧身，","level":0,"quote":true},{"t":"叫唤出大声，是名大号叫。","level":0,"quote":true},{"t":"作大功德人，及与父母等，","level":0,"quote":true},{"t":"毁谤而返恩，决定堕无间。","level":0,"quote":true},{"t":"持罚骨髓碎，受苦纯无间，","level":0,"quote":true},{"t":"身命报等尔，是故名无间。","level":0,"quote":true},{"t":"互相爱憎嫉，并及相杀害，","level":0,"quote":true},{"t":"感彼恶趣身，手生锋刃甲，","level":0,"quote":true},{"t":"如是铁爪甲，甲长十六指，","level":0,"quote":true},{"t":"暴恶炽焱身，抓擭相损害，","level":0,"quote":true},{"t":"故名锋刃甲。愚痴邪婬者，","level":0,"quote":true},{"t":"登彼铁叉树，大身铁牙鬼，","level":0,"quote":true},{"t":"丑恶身炎炽，逼恼恒无尽。","level":0,"quote":true},{"t":"复有铁乌鸟，獯狐诸恶兽，","level":0,"quote":true},{"t":"食啗彼有情。复生剑叶林，","level":0,"quote":true},{"t":"割截於罪人，叫唤出恶声，","level":0,"quote":true},{"t":"痛苦不可忍。谄诳妄言者，","level":0,"quote":true},{"t":"吞食热铁丸，而复饮洋铜，","level":0,"quote":true},{"t":"重重无暂住。轻慢若欺他，","level":0,"quote":true},{"t":"铁牙恶兽等，来食身上肉，","level":0,"quote":true},{"t":"受苦俱胝岁。爱行非法行，","level":0,"quote":true},{"t":"堕入洋铜河，大炽洋铜汁，","level":0,"quote":true},{"t":"烧煮或浮沈。又复自愚迷，","level":0,"quote":true},{"t":"劝作非法行，往彼铁轮狱，","level":0,"quote":true},{"t":"而被铁火轮，碾拶身无数，","level":0,"quote":true},{"t":"或以铁磨磨，或上刀山等。","level":0,"quote":true},{"t":"若人说邪道，破正法为非，","level":0,"quote":true},{"t":"满道排锋刃，令彼往来行，","level":0,"quote":true},{"t":"业力令身大，驱逐聚一处，","level":0,"quote":true},{"t":"四面山石合，如指甲拶虱。","level":0,"quote":true},{"t":"若坏修习行，远离正等因，","level":0,"quote":true},{"t":"僻执心意邪，定入由增狱。","level":0,"quote":true},{"t":"暴恶蛆虫类，恒居粪秽中，","level":0,"quote":true},{"t":"罪者游履时，食啗於双足。","level":0,"quote":true},{"t":"种植压油等，蠕动多伤杀，","level":0,"quote":true},{"t":"重重卧铁槽，热铁棒捶打。","level":0,"quote":true},{"t":"若起极瞋怒，造彼诸恶罪，","level":0,"quote":true},{"t":"死堕焰魔刹，具受一切苦。","level":0,"quote":true},{"t":"破结善种子，身口意俱罪，","level":0,"quote":true},{"t":"智者勿作罪，地狱相如是。","level":0,"quote":true},{"t":"地狱品颂竟。","level":0},{"t":"牛驴猿猴等，鸠鸽鹅鸭身，","level":0,"quote":true},{"t":"行恚与贪婬，获报斯如是。","level":0,"quote":true},{"t":"犲狼猛虎犳，蝮蝎及毒蛇，","level":0,"quote":true},{"t":"瞋忿我慢深，获报斯如是。","level":0,"quote":true},{"t":"乌鹊雕鹫等，蜈蚣路多虫，","level":0,"quote":true},{"t":"罴熊猫牛马，龙鱼<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00859.gif\" alt=\"㜸\" title=\"㜸\" />路荼，","level":0,"quote":true},{"t":"如是傍生等，增益恶三业，","level":0,"quote":true},{"t":"坠堕焰魔界，获报斯如是。","level":0,"quote":true},{"t":"傍生品颂竟。","level":0},{"t":"障他布施福，偷盗於饮食，","level":0,"quote":true},{"t":"堕在布怛那，饥虚为饿鬼。","level":0,"quote":true},{"t":"愚痴悭鄙人，我慢乏礼乐，","level":0,"quote":true},{"t":"求食又无惭，死为大瘿鬼。","level":0,"quote":true},{"t":"自不行檀度，劝他作悭贪，","level":0,"quote":true},{"t":"而堕饿鬼中，腹大咽如针。","level":0,"quote":true},{"t":"悭贪深厚者，护财如眼睛，","level":0,"quote":true},{"t":"贫病与佛僧，不能施少分，","level":0,"quote":true},{"t":"亦复不自用，父母莫能得，","level":0,"quote":true},{"t":"死堕饿鬼身，浆饮永不遇。","level":0,"quote":true},{"t":"若盗他财物，施已心生悔，","level":0,"quote":true},{"t":"亦堕饿鬼身，常食於脓唾。","level":0,"quote":true},{"t":"口出恶言语，谤毁於贤善，","level":0,"quote":true},{"t":"堕彼饿鬼中，口生於火炬。","level":0,"quote":true},{"t":"悭贪与诤讼，恶意窥他财，","level":0,"quote":true},{"t":"堕彼饿鬼中，微获祭祀食，","level":0,"quote":true},{"t":"或入聚落处，见彼遗弃食，","level":0,"quote":true},{"t":"呕吐涎唾等，而恒为美馔。","level":0,"quote":true},{"t":"自行悭障碍，离间他行施，","level":0,"quote":true},{"t":"为鬼恭槃荼，恶形生脓血。","level":0,"quote":true},{"t":"伤杀群生类，自食与他食，","level":0,"quote":true},{"t":"堕鬼罗刹娑，爱食鬘香粖。","level":0,"quote":true},{"t":"虽然施饮食，少分怀瞋恚，","level":0,"quote":true},{"t":"堕鬼健闼婆，作乐诸天爱。","level":0,"quote":true},{"t":"若爱於两舌，鬪乱行瞋恚，","level":0,"quote":true},{"t":"堕鬼毕舍佐，头面而丑恶。","level":0,"quote":true},{"t":"虽爱行檀施，而恒苦恼人，","level":0,"quote":true},{"t":"堕彼恶趣中，为彼母驮鬼。","level":0,"quote":true},{"t":"自行猛利杀，教他猛利杀，","level":0,"quote":true},{"t":"堕彼药叉身，亦复恶猛利。","level":0,"quote":true},{"t":"父母师长等，所欲多违背，","level":0,"quote":true},{"t":"堕彼药叉宫，勇健行暴恶。","level":0,"quote":true},{"t":"悭贪瞋果报，饿鬼药叉等，","level":0,"quote":true},{"t":"苦乐随自因，诸恶不须作。","level":0,"quote":true},{"t":"饿鬼品颂竟。","level":0},{"t":"天及修罗人，福寿有差等，","level":0,"quote":true},{"t":"乐求生天者，坚持八斋戒，","level":0,"quote":true},{"t":"快乐寿命长，远离疾病苦。","level":0,"quote":true},{"t":"於禁若破犯，少分乐生天，","level":0,"quote":true},{"t":"而堕於修罗，部多为眷属。","level":0,"quote":true},{"t":"虽不盗他财，纤毫不行施，","level":0,"quote":true},{"t":"悋惜广悭贪，而为守财鬼。","level":0,"quote":true},{"t":"不盗亦不施，不悭亦不贪，","level":0,"quote":true},{"t":"决定得人身，衣食多辛苦。","level":0,"quote":true},{"t":"不盗不贪瞋，守分而安住，","level":0,"quote":true},{"t":"美味施圣贤，彼得生人世，","level":0,"quote":true},{"t":"寿命具色力，吉祥而无病。","level":0,"quote":true},{"t":"恒时行施食，净信具惭愧，","level":0,"quote":true},{"t":"得富贵端严，广饶资畜等。","level":0,"quote":true},{"t":"若施田宅等，及造僧伽蓝，","level":0,"quote":true},{"t":"令彼心欢喜，於自彼身中，","level":0,"quote":true},{"t":"一切随所欲，若施於鞋履，","level":0,"quote":true},{"t":"供养佛僧等，游行得安乐，","level":0,"quote":true},{"t":"常获车骑乘。若於旷野中，","level":0,"quote":true},{"t":"施水作泉井，而复作阴凉，","level":0,"quote":true},{"t":"令彼无疲渴，当获於妙花，","level":0,"quote":true},{"t":"吉祥广严饰，柔软身圆满。","level":0,"quote":true},{"t":"若於传法人，舍施童子等，","level":0,"quote":true},{"t":"后复得为人，聪明多智慧。","level":0,"quote":true},{"t":"若施於药饵，当离一切病，","level":0,"quote":true},{"t":"若施於灯明，眼目长清净，","level":0,"quote":true},{"t":"若施於音乐，口生美妙音，","level":0,"quote":true},{"t":"若施卧具等，当感身安乐，","level":0,"quote":true},{"t":"若施傍类食，长寿多色力，","level":0,"quote":true},{"t":"若放女出家，眷属获增长，","level":0,"quote":true},{"t":"若以田地施，得花菓流泉。","level":0,"quote":true},{"t":"若怖於轮回，亲觐於贤圣，","level":0,"quote":true},{"t":"所须随供养，精进常恭敬，","level":0,"quote":true},{"t":"善破於烦恼，当得安乐果。","level":0,"quote":true},{"t":"悲愍不悭悋，辍己而施他，","level":0,"quote":true},{"t":"定感富饶果，衣食自丰足。","level":0,"quote":true},{"t":"如彼四时中，随时行布施，","level":0,"quote":true},{"t":"崇重具仪式，当获一切福。","level":0,"quote":true},{"t":"偷盗他财物，自己作所须，","level":0,"quote":true},{"t":"违背於真空，烦恼不舍离。","level":0,"quote":true},{"t":"不作有相心，依如行布施，","level":0,"quote":true},{"t":"如是布施果，无为大安乐。","level":0,"quote":true},{"t":"如人离婬欲，童男等不生，","level":0,"quote":true},{"t":"远出至他方，无思无罣碍。","level":0,"quote":true},{"t":"若人著婬欲，心行无返复，","level":0,"quote":true},{"t":"狂乱自耽著，永堕於三涂。","level":0,"quote":true},{"t":"嫌弃於女人，修戒薄痴爱，","level":0,"quote":true},{"t":"复至命终时，犹如破毒气。","level":0,"quote":true},{"t":"若行正等因，不舍於梵行，","level":0,"quote":true},{"t":"精进得吉祥，天人恒供养。","level":0,"quote":true},{"t":"坚固不迷乱，无饮酒妄言，","level":0,"quote":true},{"t":"出语常真实，获名闻安乐。","level":0,"quote":true},{"t":"种种造饮食，供养和合众，","level":0,"quote":true},{"t":"当感善眷属，同生不动国。","level":0,"quote":true},{"t":"互相作承事，欢喜意无违，","level":0,"quote":true},{"t":"观察谛理空，不欺不颠倒，","level":0,"quote":true},{"t":"苦恼永已尽，安乐而解脱。","level":0,"quote":true},{"t":"若好於戏论，歌舞著顽愚，","level":0,"quote":true},{"t":"我慢恃端严，欺𪌒於贫贱，","level":0,"quote":true},{"t":"当受背伛身，瘖痖形痤陋，","level":0,"quote":true},{"t":"疾病镇缠缚，语言而不逊，","level":0,"quote":true},{"t":"罪苦转弥深，无因得安乐。","level":0,"quote":true},{"t":"寂静心恬澹，一切善出生，","level":0,"quote":true},{"t":"报应果不虚，速成离苦道。","level":0,"quote":true},{"t":"人趣品颂竟。","level":0},{"t":"谄诳行毁禁，毒害鬪诤深，","level":0,"quote":true},{"t":"广纵於无明，必堕修罗趣。","level":0,"quote":true},{"t":"修罗品颂竟。","level":0},{"t":"弃名利欢乐，远离於亲眷，","level":0,"quote":true},{"t":"持禁中下品，生彼四王天。","level":0,"quote":true},{"t":"父母亲族等，种种作供养，","level":0,"quote":true},{"t":"远诤奉律仪，获生忉利天。","level":0,"quote":true},{"t":"慈喜无伤杀，和颜离爱憎，","level":0,"quote":true},{"t":"纯善守尸罗，得生夜摩界。","level":0,"quote":true},{"t":"多闻持法教，修慧求解脱，","level":0,"quote":true},{"t":"积德具威仪，获生於覩史。","level":0,"quote":true},{"t":"若人自出家，布施坚持戒，","level":0,"quote":true},{"t":"令彼大安乐，得生变化天。","level":0,"quote":true},{"t":"上根有情类，持戒亦最上，","level":0,"quote":true}],[{"t":"功德超越前，生他化自在。","level":0,"quote":true},{"t":"持戒生天上，禅定亦如是，","level":0,"quote":true},{"t":"智慧若薰修，牵引复生慧，","level":0,"quote":true},{"t":"善恶业果报，我说无虚谬。","level":0,"quote":true},{"t":"由善得安乐，作恶获苦恼，","level":0,"quote":true},{"t":"老病死轮转，果报自如是。","level":0,"quote":true},{"t":"审观此三种，勿爱须弃舍，","level":0,"quote":true},{"t":"求福远离罪，了绝於色声，","level":0,"quote":true},{"t":"通达真实义，必至大解脱。","level":0,"quote":true},{"t":"佛说六道伽陀经","level":0}]]