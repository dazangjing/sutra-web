[[{"t":"佛说救护身命经","level":0},{"t":"尒时佛在娑罗双树间临般泥洹时舍利弗阿难及无量诸大菩萨摩诃萨诸大弟子一切天人皆来集会佛还正坐告阿难言吾当入般涅槃我灭度后一切众生当为<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />魔众邪蛊道夺人精气者求人短者横来煞者阿难汝好懃心流布此经令<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />世中众生无有病苦无有横死众邪蛊道<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17575.gif\" alt=\"𭜧\" title=\"𭜧\" />皆消灭。","level":0},{"t":"阿难我所嘱累唯有此经若有众生无男无女有能读诵此经一句一偈者众邪<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />鬼不得▆近若在旷野中若在急难中若在大水中若在大火中常当读诵是经能<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17575.gif\" alt=\"𭜧\" title=\"𭜧\" />断除何以故此经有大威神力故常读之若不读者但当着怀中至心受持是经者则持过去未来现在诸佛神力若欲远行常当持去<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />村落一心为人演说有能湏<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13376.gif\" alt=\"㬰\" title=\"㬰\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" />者所愿<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17575.gif\" alt=\"𭜧\" title=\"𭜧\" />得。","level":0},{"t":"阿难佛不虚言此经佛所秘要甚难可得譬如妙药能愈毒病能辟毒气能断<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />毒有人持行诸恶毒<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01961.gif\" alt=\"䖝\" title=\"䖝\" />众邪蛊道欲来争▆闻此经法<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />▆药气四向散去不敢回视此经亦<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />如是有疾病者当净洗浴一心读诵众患除愈。","level":0},{"t":"佛告阿难若有<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />魔蛊道不随我语者我当使此魔众邪蛊道如押油快<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17575.gif\" alt=\"𭜧\" title=\"𭜧\" />皆消灭无有遗餘佛即举七佛名字苐一维卫佛苐二式佛苐三随叶佛苐四拘楼秦佛苐五拘那含牟<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />佛苐六迦叶佛苐七<img class=\"gaiji\" src=\"asset://gaiji-CB/18/CB18232.gif\" alt=\"𥼶\" title=\"𥼶\" />迦文佛。","level":0},{"t":"若有苦厄病痛者便当读诵此七佛名字诸<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />蛊道<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17575.gif\" alt=\"𭜧\" title=\"𭜧\" />皆消灭无能侵近。","level":0},{"t":"佛说此经已<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />告阿难我今怜愍众生故便当更说六神名字一名波奈罗二名迦奈罗三名禅咤迦四名懃迦五名摩头六名摩祁此是六神名字阿难若有众生无男无女无贵无贱有苦厄者皆当称说六神名字所患消除众▆<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />气皆不得近一切灭尽无有遗餘。","level":0},{"t":"佛告无量无边菩萨摩诃萨及天神王一切天人我灭度后若有受持我所嘱法者汝䓁常当昼夜拥护令得安隐。","level":0},{"t":"文殊师利菩萨白佛言世尊我当於佛灭后将廿五菩萨於<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />世中有读诵此经<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />我䓁昼夜在其左右拥护是人众邪魍魉不得来近常使是人卧安觉安修行善法佛赞文殊师利善<img class=\"gaiji\" src=\"asset://gaiji-CB/26/CB26210.gif\" alt=\"㢤\" title=\"㢤\" />善<img class=\"gaiji\" src=\"asset://gaiji-CB/26/CB26210.gif\" alt=\"㢤\" title=\"㢤\" />汝能拥护我百千万刧所可修集阿耨多罗三<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01505.gif\" alt=\"𦴭\" title=\"𦴭\" />三菩提。","level":0},{"t":"尒时四天神王偏袒右肩右膝著地一心合掌白佛言世尊我当於如来灭后各将眷属按行国界有能读诵书写受持是经我䓁眷属常来随逐是人昼夜拥护令不见<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />是人欲行旷野中我常随逐导从懃心拥护是人不令<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />鬼妄来侵近常得充足不令饥渴所欲求者我䓁神王<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17575.gif\" alt=\"𭜧\" title=\"𭜧\" />令供给如其所愿无所之少何以故是人能令流布此经修行善法供养三宝令不断绝。","level":0},{"t":"尒时乾闼婆王阿修罗迦楼罗紧那罗摩睺罗伽人非人䓁各各胡跪於如来前一心合掌白佛言世尊我䓁天人常当飞行於<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />世中间有读诵书写昼夜受持是经者我䓁天人各与眷属共到是人所住之<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />听受此经常当守护昼夜不离在其四面拥护是人众魔<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />鬼不得侵近不得<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03033.gif\" alt=\"𡙸\" title=\"𡙸\" />其精气不得横来娆<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10329.gif\" alt=\"𡧱\" title=\"𡧱\" />不得求其长短不得触猒令毒气不行我䓁眷属常来在是人所住於空中是人若遇大火我䓁眷属随其方便救护其身不令火烧若遇大水急𫘝<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00579.gif\" alt=\"㵱\" title=\"㵱\" />去我䓁眷属即於空中来接是人令不见溺水即还住得渡水难若遇大贼我於四面护持是人能令贼心刀杖不举即发慈心若遇官法系缚枷鏁昼夜愁苦我䓁眷属於虚空中能令其官心生欢喜<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17575.gif\" alt=\"𭜧\" title=\"𭜧\" />令放赦皆得解脱我䓁眷属一心救护不令他人而得扰乱於无量无边刧中常念是经何以故此经世尊慇懃所属之法令久流布。","level":0},{"t":"佛<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />赞诸天人善<img class=\"gaiji\" src=\"asset://gaiji-CB/26/CB26210.gif\" alt=\"㢤\" title=\"㢤\" />善<img class=\"gaiji\" src=\"asset://gaiji-CB/26/CB26210.gif\" alt=\"㢤\" title=\"㢤\" />汝䓁眷属曾於阿僧祇刧中值遇百千万亿刧诸佛令拥护我百千亿刧中弟子能令流布此法读诵书写方便救济不令见<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />常行善心。","level":0},{"t":"尒时乹闼婆各与眷属顶礼佛足一心奉行。","level":0},{"t":"佛告阿难吾以手摩汝顶上汝好用心吾所嘱累唯有此经阿难懃心流布此经令一切众生<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17575.gif\" alt=\"𭜧\" title=\"𭜧\" />得闻知阿难汝最是吾心中弟子我所出法<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17575.gif\" alt=\"𭜧\" title=\"𭜧\" />付嘱汝吾今怜愍一切众生故欲令觧脱故。","level":0},{"t":"还正坐付嘱此经阿难此经尊猛极有威神劝令一切族姓男女供养香华杂彩幡盖燃灯续明<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />能转读诵习救人疾病苦厄之者现在安吉将来往生无量寿国即生莲华軆体金色身相具足智慧勇健如上軰者功德如是不可称计阿难当用好纸好笔好墨至心书写我所出法上下句偈如佛所说令无妄失一畫一点阿难我怜愍众生故唯嘱此法皆令一切有形之类<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17575.gif\" alt=\"𭜧\" title=\"𭜧\" />得闻知心开意解常行善心。","level":0},{"t":"尒时阿难在世尊前一心合掌身毛<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17575.gif\" alt=\"𭜧\" title=\"𭜧\" />竖战战兢兢一心谛听佛语不敢忘失一句一偈流泪而言世尊所嘱至心受持广令流布阿难<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />言受天尊教顶礼佛足一心奉行。","level":0}]]