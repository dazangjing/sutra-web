[[{"t":"經卷第四十四","level":2},{"t":"十通品〈十通品〉閻魔王十忍品〈十忍品〉舍支無方無隅不捨眾善軛徒令","level":0}],[{"t":"經卷第四十五","level":2},{"t":"阿僧祇品〈阿僧祇品〉一百洛叉為一俱<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04447.gif\" alt=\"𦙁\" title=\"𦙁\" />矜羯摩婆󳇐伽攞毗佉擔󰍞攞陁阿麼勃翳薜窣睥<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12695.gif\" alt=\"䛧\" title=\"䛧\" />荼壽量品〈壽量品〉娑婆釋迦牟尼阿󳇐陁佛諸菩薩住處品〈諸菩薩住處品〉支提山毗舍離度度羅城俱󳏃<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />城目真隣陁窟摩蘭陀國甘菩遮國震旦國<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />羅延<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00562.gif\" alt=\"䟽\" title=\"䟽\" />勒國迦葉󳇐羅國菴浮梨摩國<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00371.gif\" alt=\"𠃵\" title=\"𠃵\" />陁羅國苫婆羅窟","level":0}],[{"t":"經卷第四十六","level":2},{"t":"佛不思議法品之上〈佛不思議法品〉之上寂漠无言逮十力地譏謗","level":0}],[{"t":"經卷第四十七","level":2},{"t":"佛不思議法品之下〈佛不思議法品〉之下人王都邑毗舍闍王倮一切樂器不鼓自鳴舍利誠敬靡不驚懾信樂不回","level":0}],[{"t":"經卷第四十八","level":2},{"t":"如來十身相海品〈如來十身相海品〉熙怡微笑炳然顯現洞徹其掌安平玩味不忘上咢右輔下牙󳇐盧藏雲紺蒱成就󳇐布十方左臋其<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00170.gif\" alt=\"䏶\" title=\"䏶\" />與膊伊尼延鹿王腨舉足將步足跟因陁羅尼羅","level":0}],[{"t":"如來隨好光明功德品〈如來隨好光明功德品第三十五〉","level":3},{"t":"隨好摩耶夫人懺悔","level":0}],[{"t":"經卷第四十九","level":2},{"t":"普賢行品〈普賢行品〉第三十六樂近凢庸習童蒙法口如啞羊障洎于法界充洽工幻師","level":0}],[{"t":"經卷第五十","level":2},{"t":"如來出現品之一〈如來出現品〉第三十七之一偏祖右跽如我惟忖瞻仰如來仁及我佉陁羅山尼民陁羅山目真隣陁山水族眾生大雨名洪霔變溼令燥廓徹虛空普照無私","level":0},{"t":"如來出現品之二〈如來出現品〉之二作務或牟薩羅哮吼洞然","level":0},{"t":"如來出現品之三〈如來出現品〉之三優波尼沙陁分鼓楊海水則便謝積同須彌如乾草<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00036.gif\" alt=\"𧂐\" title=\"𧂐\" />","level":0},{"t":"離世閒品之一〈離世閒品〉第三十八之一知諸稱謂知諸制令長嬰疾苦","level":0},{"t":"離世閒品之二〈離世閒品之二〉啟一切眾生心意閒无空處","level":0},{"t":"離世閒品之三〈離世閒品〉之三善言開喻棒打屠割誓期自勉撾打楚撻挑或級其頭無央數劫","level":0}],[{"t":"經卷第五十六","level":2},{"t":"離世閒品之四〈離世閒品〉之四迫隘無所觸嬈悉稱補特伽羅心恒<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />復嬉戲","level":0}],[{"t":"經卷第五十七","level":2},{"t":"離世閒品之五〈離世閒品〉之五得預菩提薩埵不<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06114.gif\" alt=\"㢮\" title=\"㢮\" />無險詖故身心憺怕慣習癡󲠕","level":0}],[{"t":"經卷第五十八","level":2},{"t":"離世閒品之六〈離世閒品〉之六殘毀無中息難處受生捨一切烏波提涅󰒭法樂法樂義以法為樂如虹蜺色無主無待無著無行無有瘡疣瘢痕解因自悟而強為說志尚涅󰒭求其罪舋或以妙義授非其人嚬蹙不喜伺其過失頑佷我󶔲所吞醒悟天魔波旬悉知將有徙置侍衛","level":0}],[{"t":"經卷第五十九","level":2},{"t":"離世閒品之七〈離世閒品〉之七免濟欣慰圖書󵕿璽弧<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08703.gif\" alt=\"𠂕\" title=\"𠂕\" />劒<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02455.gif\" alt=\"㦸\" title=\"㦸\" />博弈嬉戲親戚能忍劬勞正法盈洽菩薩無<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01002.gif\" alt=\"㝵\" title=\"㝵\" />乘巾之出三界宴然皎鏡馳逐菡󵕶花娛樂","level":0}],[{"t":"經卷第六十","level":2},{"t":"入法界品之一〈入法界品〉第三十九之一室羅筏國逝多林<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />藏菩薩師子頻申三昧危樓逈帶棟宇階墀軒㩜階隥欄楯湍激洄澓芬敷舍利弗大目<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00371.gif\" alt=\"𠃵\" title=\"𠃵\" />連摩訶迦葉離波多湏菩提阿<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00145.gif\" alt=\"㝹\" title=\"㝹\" />樓<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00501.gif\" alt=\"䭾\" title=\"䭾\" />難陁刧󰠢<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />迦旃延富樓<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />不能遊履舉體燋然烏鷲瞖膜捕獵放牧振<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00421.gif\" alt=\"䘏\" title=\"䘏\" />均贍舉世孰有凢夫嬰妄惑難稱欽歎曉悟","level":0},{"t":"入法界品之二〈入法界品〉之二因陁羅󱶈舟明練君慧比丘","level":0}],[{"t":"經卷第六十二","level":2},{"t":"入法界品之三〈入法界品之三〉娑羅林湏達多婆湏達多威光赫弈徽纆󶖨勒𱞽盈令我載此乘茵蓐羈鞅周挍四維玩好之物等祐一切頗有因陁羅尼羅分敷布濩辯析深入法旋澓行至楞伽道激電<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09400.gif\" alt=\"𠛴\" title=\"𠛴\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />羅婆牟呼栗多國名達利鼻荼󳇐伽","level":0}],[{"t":"經卷第六十三","level":2},{"t":"入法界品之四〈入法界品〉之四市肆善財言唯遽即下則為不断菩薩為一切眾生恃怙長者涕泗悲泣拔猶豫箭坦蕩自心。有一國土名摩利伽羅梵行之道衝優婆夷名<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09109.gif\" alt=\"𠇲\" title=\"𠇲\" />捨咨嗟戀慕想其容止","level":0}],[{"t":"經卷第六十四","level":2},{"t":"入法界品之五〈入法界品〉之五善知識者是我師傅毗盧遮<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />摩尼寶鳬󳒙俱抧羅鳥寶多羅樹徐搖挾閣阿盧<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />香挂釧耳璫婆樓<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />天佛國土名<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />羅素仙人名毗目瞿沙鮮榮波吒羅樹尼拘律樹領徒一萬編草髻環垂󵕻夷險道險易阿<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12777.gif\" alt=\"𢈔\" title=\"𢈔\" />多<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />由他聚落名伊沙<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />離諸難難伊<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />跋羅龍王難陁優波難陁","level":0}],[{"t":"經卷第六十五","level":2},{"t":"入法界品之六〈入法界品〉之六󲃦口丹潔如頻婆果於河渚中商估貯福德淵挍飾鵝王羽翮憩止稟善知識靡不周贍","level":0}],[{"t":"經卷第六十六","level":2},{"t":"入法界品之七〈入法界品〉之七游福德海遽即徃諸何緣致此清淨眾會不憚雉揲崇峻風黃淡熱辛頭波羅香阿盧<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />跋底香烏洛迦旃檀香城名多羅幢怡暢心撫其孤弱阿<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />羅王以為其<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />十万猛卒楄攘臂瞋目挑曾不<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />懼命之同坐承旨富贍断其所作靡不該練伊羅婆拏大象王脩臂如漁<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00238.gif\" alt=\"㧌\" title=\"㧌\" />動城名無量都薩羅","level":0}],[{"t":"經卷第六十七","level":2},{"t":"入法界品之八〈入法界品〉之八廛店隣里巖巚鬻香摩羅耶山香名先陁婆舩師名婆施羅部多宮晨脯晷漏延促理断良久國名輸<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />城名迦陵迦林波利質多羅樹迦隣陁衣迫窄婆樓<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />天良󵕹田菴羅林波湏蜜多","level":0}],[{"t":"經卷第六十八","level":2},{"t":"入法界品之九〈入法界品〉之九脣吻蹈彼門閫居士名鞞瑟<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04447.gif\" alt=\"𦙁\" title=\"𦙁\" />羅󳇐勒山名補怛洛迦泉流縈映樹林蓊欝遷移城名墮羅鉢底󲠕迦毗羅城夜神婆󱸡婆演底佇立未久方隅慞惶為作靈藥藤羅所胃欲度溝洫令諸世事悉得宣敘盜塔寺物夜久眠<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00895.gif\" alt=\"𥧌\" title=\"𥧌\" />勸喻","level":0}]]