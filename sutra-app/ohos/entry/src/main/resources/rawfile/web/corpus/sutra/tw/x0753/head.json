{"id":"x0753","title":"十地經論義記","titleTrad":"十地經論義記","byline":"淨影釋","bylineLabel":"著者·译者","dynasty":"","division":"经疏部","canon":"X0753","canonName":"新纂卍續藏","volume":"X0753","juanCount":4,"textLength":235218,"imageCount":0,"summary":"","tags":["经疏部","新纂卍續藏"],"order":1685,"guide":"","chunks":55,"toc":[{"level":3,"text":"刻十地義記序"},{"level":2,"text":"卷第一　卷第一"},{"level":2,"text":"卷第三　卷第二"},{"level":2,"text":"卷第五　卷第三"},{"level":2,"text":"卷第七　卷第四"},{"level":2,"text":"佚失論卷第六"},{"level":2,"text":"第一本十地義記卷第一"},{"level":3,"text":"若言經後，則無序義。若如來序是佛說經前，阿難序"},{"level":3,"text":"初段經中總要為三、別以為十。言總三者，一經家序"},{"level":2,"text":"第二本十地義記卷第二"},{"level":2,"text":"第三本十地義記卷第三"},{"level":2,"text":"第四本十地義記卷第四"}],"chunksPerFile":20}