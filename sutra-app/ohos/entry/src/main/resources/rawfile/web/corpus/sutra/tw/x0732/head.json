{"id":"x0732","title":"四分律搜玄錄","titleTrad":"四分律搜玄錄","byline":"吳郡雙林寺沙門釋","bylineLabel":"著者·译者","dynasty":"","division":"律部","canon":"X0732","canonName":"新纂卍續藏","volume":"X0732","juanCount":3,"textLength":148030,"imageCount":0,"summary":"","tags":["律部","新纂卍續藏"],"order":617,"guide":"","chunks":40,"toc":[{"level":3,"text":"終南山四分律鈔搜玄錄序"},{"level":2,"text":"錄卷第一"},{"level":3,"text":"二、明廣解，分二：初之十字，舉能貫一部之通稱；二序"},{"level":3,"text":"之一字，攝兩序之別標。此是前科於上略釋，須著序"},{"level":2,"text":"以標上卷一十二"},{"level":2,"text":"下卷一十四"},{"level":2,"text":"以十門為條流，今取花嚴三十篇也。謂上三卷三十"},{"level":2,"text":"正云：中卷四"},{"level":2,"text":"一十二篇為綱，攝持中下二卷，教網上卷一十二"},{"level":2,"text":"周整。問：前分中卷四"},{"level":2,"text":"連提那舍譯。又有一卷十"},{"level":3,"text":"要不就借，輕他通用也。以他名字者，如下四分第十"},{"level":3,"text":"亦同四分第七寄物取也。除出息者，謂對面斷，當情"},{"level":3,"text":"五分第二云：因有比丘夢失不淨，疑，犯殘，白佛。佛呵"}],"chunksPerFile":20}