{"id":"ga0025","title":"云居圣水寺志","titleTrad":"雲居聖水寺志","byline":"顺治六年冬十月豫章周汉杰拜撰","bylineLabel":"著者·译者","dynasty":"","division":"史传部","canon":"GA0025","canonName":"佛寺志汇刊","volume":"GA0025","juanCount":7,"textLength":67063,"imageCount":0,"summary":"","tags":["史传部","佛寺志汇刊"],"order":2748,"guide":"","chunks":29,"toc":[{"level":3,"text":"云居圣水禅寺志序"},{"level":3,"text":"时乾隆癸巳四月初吉仁和七十八岁老人陆宗楷凫川氏序"},{"level":3,"text":"序"},{"level":3,"text":"序"},{"level":3,"text":"序"},{"level":3,"text":"序"},{"level":2,"text":"圣水寺志卷一"},{"level":2,"text":"圣水寺志卷二"},{"level":3,"text":"字房仲江西人官副使寓居年餘著有蘧庵集为本寺作志序"},{"level":2,"text":"圣水寺志卷三"},{"level":2,"text":"圣水寺志卷四"},{"level":3,"text":"古峰长老住持本山序"},{"level":3,"text":"弘泉禅师六十寿序"},{"level":3,"text":"达方上人七十寿序"},{"level":3,"text":"达方禅师八十大寿序"},{"level":2,"text":"圣水寺志卷五"},{"level":2,"text":"圣水寺志卷六"},{"level":3,"text":"洪武二十年岁次丁卯四月佛诞日杭州府儒学教授天台徐一夔序"},{"level":3,"text":"后序"}],"chunksPerFile":20}