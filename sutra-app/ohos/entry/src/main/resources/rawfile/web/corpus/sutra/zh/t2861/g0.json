[[{"t":"泉州千佛新著诸祖师颂","level":0}],[{"t":"终南山僧　慧观撰序","level":3},{"t":"南岳泰公著五赞十颂。当时称之以美谈。及乐浦香严尤长厥颂。斯则助道之端耳。自祖灯相嘱始迦叶终曹溪。凡三十三祖信衣之后迨数人。先贤之所未赞者。愚且病焉。虽宝林祖述其事阅而可委。奈何忘机。尚懒者或陋其系远残秋之夕。愚得以前意请於　千佛僜禅师虽罕让而弗获免。未信宿而成盖辞理生　千佛之笔当时问答奇句或糅。其间约字虽则未多。此识者历观诸圣之作於是乎在矣。亦犹纳须弥於芥子其橙一也。是以命牋染翰为之序云。西国二十八代祖师及唐土六祖师。后[枯-十+儿]庆明觉大师述。","level":0},{"t":"初祖大迦叶尊者","level":0},{"t":"伟哉迦叶密传佛心身依一纳","level":0,"quote":true},{"t":"口海千寻威仪庠序化道幽深","level":0,"quote":true},{"t":"未逢慈氏且定鸡岑","level":0,"quote":true},{"t":"第二祖阿难尊者","level":0},{"t":"多闻庆喜高建法幢传佛金偈","level":0,"quote":true},{"t":"继祖银釭慈悲第一智慧无双","level":0,"quote":true},{"t":"饮光后<img class=\"gaiji\" src=\"asset://gaiji-CB/27/CB27427.gif\" alt=\"𨅛\" title=\"𨅛\" />月印秋江","level":0,"quote":true},{"t":"第三祖商那和修尊者","level":0},{"t":"胎衣尊者暗室明灯人天耳目","level":0,"quote":true},{"t":"佛法股肱非心非色无减无增","level":0,"quote":true},{"t":"良哉至理觉海大鹏","level":0,"quote":true},{"t":"第四祖优波毱多尊者","level":0},{"t":"优波鞠多辩泻玄河法山崷崪","level":0,"quote":true},{"t":"道树婆娑筹盈石室尸系天魔","level":0,"quote":true},{"t":"性非十七悟在刹那","level":0,"quote":true},{"t":"第五祖提多迦尊者","level":0},{"t":"多迦大士无我出家了根达境","level":0,"quote":true},{"t":"兔月空花体非形相理出齿牙","level":0,"quote":true},{"t":"随方利物岂有瓟瓜(薄交反以瓠可为饮瓜亦又音雹瓜雹也)","level":0,"quote":true},{"t":"第六祖弥遮迦","level":0},{"t":"弥遮加祖习五通仙遇师正法","level":0,"quote":true},{"t":"看我心偏悟如未悟玄之又玄","level":0,"quote":true},{"t":"神通示灭八部潜然","level":0,"quote":true},{"t":"第七祖婆须蜜尊者","level":0},{"t":"祖婆须蜜入弥遮室迷悟本如","level":0,"quote":true},{"t":"物我冥一平携酒器项擎佛曰","level":0,"quote":true},{"t":"奚是奚非谁得谁失","level":0,"quote":true},{"t":"第八祖佛陀难提尊者","level":0},{"t":"佛陀难提大化群迷心无心外","level":0,"quote":true},{"t":"法理高位五天论将三界云梯","level":0,"quote":true},{"t":"卓然真气南北东西","level":0,"quote":true},{"t":"第九祖伏陀蜜多尊者","level":0},{"t":"伏陀蜜多大器晚成五十不语","level":0,"quote":true},{"t":"五十不行我逢达士倐契无生","level":0,"quote":true},{"t":"崖松有操秋鸡无程","level":0,"quote":true},{"t":"第十祖脇尊者","level":0},{"t":"脇大尊者爱憎网<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03385.gif\" alt=\"𭫠\" title=\"𭫠\" />量等虚空","level":0,"quote":true},{"t":"道准箫洒真体自然因真舒凭","level":0,"quote":true},