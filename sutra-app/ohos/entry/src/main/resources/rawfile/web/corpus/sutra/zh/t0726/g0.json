[[{"t":"六趣轮回经","level":0},{"t":"马鸣菩萨集","level":0},{"t":"西天译经三藏朝散大夫试鸿胪少卿宣梵大师赐紫沙门臣日称等奉　诏译","level":0},{"t":"归命三世尊，正等觉所说，","level":0,"quote":true},{"t":"常行於利他，积集诸功德。","level":0,"quote":true},{"t":"若自身口意，所作善恶业，","level":0,"quote":true},{"t":"感果定非差，无别造作者。","level":0,"quote":true},{"t":"最胜之导师，现证垂慈愍，","level":0,"quote":true},{"t":"普为诸有情，说随业受报。","level":0,"quote":true},{"t":"此相应正理，闻已当领受，","level":0,"quote":true},{"t":"作业皆自心，为因驰六趣。","level":0,"quote":true},{"t":"由三毒怖畏，贩卖诸物命，","level":0,"quote":true},{"t":"养已杀於他，当堕等活狱；","level":0,"quote":true},{"t":"彼寿百千岁，加刀杖捶打，","level":0,"quote":true},{"t":"死已更复生，受如是苦报。","level":0,"quote":true},{"t":"於父母朋属，而生於损害，","level":0,"quote":true},{"t":"起妄语欺诳，当堕黑线狱；","level":0,"quote":true},{"t":"黑线絣其身，如世间解木，","level":0,"quote":true},{"t":"锯发焰炽然，受如是苦报。","level":0,"quote":true},{"t":"以火焚山川，林木及原野，","level":0,"quote":true},{"t":"烧害诸有情，当堕炎热狱；","level":0,"quote":true},{"t":"火焰遍烧然，苦叫声不绝，","level":0,"quote":true},{"t":"两目无有明，受如是苦报。","level":0,"quote":true},{"t":"谓法说非法，无根而诽谤，","level":0,"quote":true},{"t":"令他生热恼，堕极炎热狱；","level":0,"quote":true},{"t":"是诸罪众生，为大火逼切，","level":0,"quote":true},{"t":"烧然不暂停，受如是苦报。","level":0,"quote":true},{"t":"於猪羊狐兔，及餘生类等，","level":0,"quote":true},{"t":"杀害彼无边，当堕众合狱；","level":0,"quote":true},{"t":"生彼地狱已，备受诸楚毒，","level":0,"quote":true},{"t":"拷掠灭还生，受如是苦报。","level":0,"quote":true},{"t":"起恶身语意，谗构相离间，","level":0,"quote":true},{"t":"如是罪众生，当堕号叫狱；","level":0,"quote":true},{"t":"彼炽猛火焰，烧然无休息，","level":0,"quote":true},{"t":"常发大恶声，受如是苦报。","level":0,"quote":true},{"t":"若於佛法僧，及诸贫乏者，","level":0,"quote":true},{"t":"剽窃彼财物，堕大号叫狱；","level":0,"quote":true},{"t":"为火所烧炙，受最极热恼，","level":0,"quote":true},{"t":"出大猛恶声，受如是苦报。","level":0,"quote":true},{"t":"於父母师长，及有德贤者，","level":0,"quote":true},{"t":"起增上杀害，定堕无间狱；","level":0,"quote":true},{"t":"炎炽大火聚，洞然彻骨髓，","level":0,"quote":true},{"t":"长时受极苦，决定无暂乐。","level":0,"quote":true},{"t":"起冤敌鬪诤，戈戟相残害，","level":0,"quote":true},{"t":"死堕铜爪狱，其状极锋利，","level":0,"quote":true},{"t":"互相而擘裂，或变为刀杖，","level":0,"quote":true},{"t":"竞斫刺其身，受如是苦报。","level":0,"quote":true},{"t":"强暴侵他色，后堕铁刺狱，","level":0,"quote":true},{"t":"刺长十六指，削肉而穿骨；","level":0,"quote":true},{"t":"复有大铁女，焰牙甚可怖，","level":0,"quote":true},{"t":"噉顶至其踵，受如是苦报。","level":0,"quote":true},{"t":"若阴谋害他，堕彼剑叶林，","level":0,"quote":true},{"t":"猘狗及雕鹫，奔逐竞分食。","level":0,"quote":true},{"t":"若劫夺他财，当受其极苦，","level":0,"quote":true},{"t":"常吞热铁丸，复灌以铜汁。","level":0,"quote":true},{"t":"无辜害众生，当堕铁鹰狱，","level":0,"quote":true},{"t":"利爪而搏击，长时受苦恼。","level":0,"quote":true},{"t":"若人好伤杀，水族诸物命，","level":0,"quote":true},{"t":"后堕镕铜河，为业火烧煮。","level":0,"quote":true},{"t":"若自贪盛事，而掩斥他善，","level":0,"quote":true},{"t":"堕彼铁磨狱，悲号无救度。","level":0,"quote":true},{"t":"若人不饶益，当受多种形，","level":0,"quote":true},{"t":"两山夹其身，逼切复加<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00249.gif\" alt=\"㨝\" title=\"㨝\" />。","level":0,"quote":true},{"t":"若人说非法，破坏於桥梁，","level":0,"quote":true},{"t":"锋刃以为路，驱彼而来往。","level":0,"quote":true},{"t":"以甲伤蚤虱，堕二羺头山，","level":0,"quote":true},{"t":"相击死还生，展转而受苦。","level":0,"quote":true},{"t":"依止出离道，而不护禁戒，","level":0,"quote":true},{"t":"堕煻煨狱中，肢体皆消烂。","level":0,"quote":true},{"t":"矫现诸威仪，苟求邪活命，","level":0,"quote":true},{"t":"堕尸粪狱中，为蛆虫<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00045.gif\" alt=\"𠯗\" title=\"𠯗\" />食。","level":0,"quote":true},{"t":"见五谷中虫，不择而砻伐，","level":0,"quote":true},{"t":"堕铁碓狱中，常为彼舂捣。","level":0,"quote":true},{"t":"见他苦生喜，谄曲多疑惑，","level":0,"quote":true},{"t":"常怀忿恶心，作焰摩罗卒。","level":0,"quote":true},{"t":"诸苦果种子，少略而分别，","level":0,"quote":true},{"t":"清净身语心，毕竟常远离。","level":0,"quote":true},{"t":"地狱趣竟。","level":0},{"t":"若人不乐施，复盗众饮食，","level":0,"quote":true},{"t":"堕大瘿鬼中，常噉诸粪秽。","level":0,"quote":true},{"t":"若障人布施，於己物生悋，","level":0,"quote":true},{"t":"堕针口鬼中，腹大常饥渴。","level":0,"quote":true},{"t":"无嗣悭财物，不舍不受用，","level":0,"quote":true},{"t":"堕匮乏鬼中，得他享残弃。","level":0,"quote":true},{"t":"希望他施惠，自少施生悔，","level":0,"quote":true},{"t":"堕下劣鬼中，常食於涎吐。","level":0,"quote":true},{"t":"乐闻他过失，加恶语宣传，","level":0,"quote":true},{"t":"堕焰口鬼中，长受诸苦恼。","level":0,"quote":true},{"t":"好起诸鬪诤，无少慈愍心，","level":0,"quote":true},{"t":"堕疲极鬼中，食蜎蠕虫类。","level":0,"quote":true},{"t":"恐愶取他财，得已或少施，","level":0,"quote":true},{"t":"堕极丑鬼中，他怖获微祀。","level":0,"quote":true},{"t":"若人多䜩乐，广杀诸物命，","level":0,"quote":true},{"t":"自食复与他，后堕罗刹鬼。","level":0,"quote":true},{"t":"於供养香花，或嗅或私取，","level":0,"quote":true},{"t":"由起少贪心，后作寻香鬼。","level":0,"quote":true},{"t":"若人相崇奉，於己有所求，","level":0,"quote":true},{"t":"怒色希彼财，后作猛恶鬼。","level":0,"quote":true},{"t":"若人於他娶，常乐作媒伐，","level":0,"quote":true},{"t":"后怀恶相离，死作步多鬼。","level":0,"quote":true},{"t":"若人乐饮酒，过量复颠酗，","level":0,"quote":true},{"t":"或持劝他人，后作药叉鬼。","level":0,"quote":true},{"t":"於父母师长，所欲相违背，","level":0,"quote":true},{"t":"后生药叉宫，勇健多卒暴。","level":0,"quote":true},{"t":"彼悭贪过失，常生饿鬼中，","level":0,"quote":true},{"t":"苦乐随自因，是故勿复造。","level":0,"quote":true},{"t":"饿鬼趣竟。","level":0},{"t":"人天三恶趣，唯自能救拔，","level":0,"quote":true},{"t":"奔驰六趣中，如梦境和合。","level":0,"quote":true},{"t":"覩自他眷属，伤叹岂长久，","level":0,"quote":true},{"t":"如彼俳优人，数数易形色。","level":0,"quote":true},{"t":"受地狱苦毕，或生於天中，","level":0,"quote":true},{"t":"福尽复沈沦，堕彼畜生趣。","level":0,"quote":true},{"t":"受种种形色，后得生人间，","level":0,"quote":true},{"t":"贫苦极艰辛，譬车轮旋转。","level":0,"quote":true},{"t":"畜生趣竟。","level":0},{"t":"彼人趣寿命，分量本长远，","level":0,"quote":true},{"t":"多造杀生因，由此而减少。","level":0,"quote":true},{"t":"萦缠诸病苦，癞瘦时疫等，","level":0,"quote":true},{"t":"为鬼魅所著，及王法捶打。","level":0,"quote":true},{"t":"若人於财利，劳役广希求，","level":0,"quote":true},{"t":"无少惠施心，后作守财鬼。","level":0,"quote":true},{"t":"若人盗他财，用已或能施，","level":0,"quote":true},{"t":"后堕鬼趣中，随得随散失。","level":0,"quote":true},{"t":"若人於己财，随分而行施，","level":0,"quote":true},{"t":"当获於富饶，不为他侵损。","level":0,"quote":true},{"t":"若人以净财，离悭广行施，","level":0,"quote":true},{"t":"得上妙饮食，所欲皆如意。","level":0,"quote":true},{"t":"若人以珍馔，净心而奉施，","level":0,"quote":true},{"t":"其所得福报，色力命安隐。","level":0,"quote":true},{"t":"若人以衣施，彼得生爱乐，","level":0,"quote":true},{"t":"获色相端严，具惭愧衣服。","level":0,"quote":true},{"t":"若人造僧坊，欢喜而用施，","level":0,"quote":true},{"t":"感宫殿庄严，五欲皆具足。","level":0,"quote":true},{"t":"若人建桥梁，及车乘等施，","level":0,"quote":true},{"t":"得最上安隐，珍宝之辇舆。","level":0,"quote":true},{"t":"若人於旷野，施池井泉流，","level":0,"quote":true},{"t":"於在所生处，无渴乏热恼。","level":0,"quote":true},{"t":"若人以嬖妾，严饰而为施，","level":0,"quote":true},{"t":"彼所得果报，具欲乐富贵。","level":0,"quote":true},{"t":"若人以经教，及世俗文典，","level":0,"quote":true},{"t":"能持施於他，感博学大智。","level":0,"quote":true},{"t":"若人以医药，及以无畏施，","level":0,"quote":true},{"t":"彼所得果报，安乐离恐怖。","level":0,"quote":true},{"t":"若施以灯明，其眼常清净；","level":0,"quote":true},{"t":"若施以音乐，得其声美妙；","level":0,"quote":true},{"t":"若施以卧具，获安隐快乐；","level":0,"quote":true},{"t":"若施以僮仆，营从常围绕；","level":0,"quote":true},{"t":"施乳牛等物，得色力寿命；","level":0,"quote":true},{"t":"若施以良田，得仓库盈溢。","level":0,"quote":true},{"t":"如彼彼求者，各各随所欲，","level":0,"quote":true},{"t":"花果及清泉，爱语善安慰。","level":0,"quote":true},{"t":"复有虽行施，役他而少与，","level":0,"quote":true},{"t":"因恐怖发心，及希他赞誉；","level":0,"quote":true},{"t":"或求现富贵，生天受快乐，","level":0,"quote":true},{"t":"如是等行施，获福极微少。","level":0,"quote":true},{"t":"若乐行利他，不惜於身命，","level":0,"quote":true},{"t":"常怀悲愍心，圣果不难得。","level":0,"quote":true},{"t":"诸有来乞者，依时而给与，","level":0,"quote":true},{"t":"令彼生忻悦，感果得如意。","level":0,"quote":true},{"t":"施彼若艰难，受报时亦尔，","level":0,"quote":true},{"t":"辍己惠於他，最上安乐法。","level":0,"quote":true},{"t":"施为诸乐本，如种生其果，","level":0,"quote":true},{"t":"愍彼来希求，随与无空返。","level":0,"quote":true},{"t":"慎勿侵外色，视之如己子，","level":0,"quote":true},{"t":"设复於自妻，举心即令止。","level":0,"quote":true},{"t":"若人於欲境，系心而乐著，","level":0,"quote":true},{"t":"后生於世间，定受女身报。","level":0,"quote":true},{"t":"若人厌女身，舍欲持净戒，","level":0,"quote":true},{"t":"发生坚固心，转身作男子。","level":0,"quote":true},{"t":"若人修梵行，则无诸损恼，","level":0,"quote":true},{"t":"具福德威神，天人常恭敬。","level":0,"quote":true},{"t":"若人不饮酒，安住於正念，","level":0,"quote":true},{"t":"常出真实言，现获於安隐。","level":0,"quote":true},{"t":"若见他相违，劝喻令和悦，","level":0,"quote":true},{"t":"感眷属广多，无别离苦恼。","level":0,"quote":true},{"t":"於师长教勅，常欢喜听受，","level":0,"quote":true},{"t":"损益更筹量，则具善巧智。","level":0,"quote":true},{"t":"贫窭执役者，好行於捶打，","level":0,"quote":true},{"t":"无过而恼他，己苦更加苦。","level":0,"quote":true},{"t":"若人具形色，恃之而起慢，","level":0,"quote":true},{"t":"戏弄於他人，当获矬伛报。","level":0,"quote":true},{"t":"若人性悭鄙，善诱佯不闻，","level":0,"quote":true},{"t":"彼极重愚痴，当获聋痖报。","level":0,"quote":true},{"t":"行善有餘庆，积恶招苦恼，","level":0,"quote":true},{"t":"各成辨彼因，随业定当受。","level":0,"quote":true},{"t":"人趣报竟。","level":0},{"t":"常行於谄诳，乐忿恚鬪诤，","level":0,"quote":true},{"t":"由昔行施故，而作修罗主。","level":0,"quote":true},{"t":"修罗趣竟。","level":0},{"t":"乐修十善因，於他无损害，","level":0,"quote":true},{"t":"诸天常护持，得生四王天。","level":0,"quote":true},{"t":"於父母三宝，恭敬随能施，","level":0,"quote":true},{"t":"具忍辱柔和，得生忉利天。","level":0,"quote":true},{"t":"自不乐忿诤，劝他令和顺，","level":0,"quote":true},{"t":"纯善修净因，得生焰摩天。","level":0,"quote":true},{"t":"乐多闻正法，专修解脱惠，","level":0,"quote":true},{"t":"喜赞他功德，得生兜率天。","level":0,"quote":true},{"t":"於施戒诸行，自性常爱乐，","level":0,"quote":true},{"t":"起精进勇猛，得生变化天。","level":0,"quote":true}],[{"t":"是最上有情，具沙门梵行，","level":0,"quote":true},{"t":"增长解脱因，得生他化天。","level":0,"quote":true},{"t":"以戒定熏修，普资於愿力，","level":0,"quote":true},{"t":"生天上人间，达真如实际。","level":0,"quote":true},{"t":"如是善恶报，已分明显示，","level":0,"quote":true},{"t":"作善招人天，造恶萦极苦。","level":0,"quote":true},{"t":"老病死未至，勤思求正法，","level":0,"quote":true},{"t":"自果报一来，所爱皆离别。","level":0,"quote":true},{"t":"彼贪等过失，深可生厌患，","level":0,"quote":true},{"t":"智者善思惟，是故当远离。","level":0,"quote":true},{"t":"若常行利他，则无诸障恼，","level":0,"quote":true},{"t":"罪福定无差，略说宜谛听。","level":0,"quote":true},{"t":"六趣轮回经","level":0}]]