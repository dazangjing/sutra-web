{"id":"x1574","title":"增集續傳燈錄","titleTrad":"增集續傳燈錄","byline":"徑山興聖萬壽禪寺前住持比丘吳郡文琇集","bylineLabel":"著者·译者","dynasty":"","division":"史传部","canon":"X1574","canonName":"新纂卍續藏","volume":"X1574","juanCount":6,"textLength":170099,"imageCount":0,"summary":"","tags":["史传部","新纂卍續藏"],"order":2891,"guide":"","chunks":40,"toc":[{"level":3,"text":"增集續傳燈錄序"},{"level":3,"text":"增集續傳燈錄序"},{"level":2,"text":"增集續傳燈錄卷第一"},{"level":3,"text":"而返。至龍翔柏堂，遽分第一座，識者偉栢堂知人。開"},{"level":2,"text":"增集續傳燈錄卷第二"},{"level":2,"text":"增集續傳燈錄卷第三"},{"level":2,"text":"增集續傳燈錄卷第四"},{"level":2,"text":"要坐便坐。也不精進，也不懶惰。一卷三"},{"level":2,"text":"增集續傳燈錄卷第五"},{"level":3,"text":"隱，又往參謁，遂分第二座。從游既久，盡得其末後一"},{"level":2,"text":"增集續傳燈錄卷第六"},{"level":3,"text":"虗谷陵，選為後堂首座。佛性遷建業保寧，分第一座"},{"level":3,"text":"性學指要十卷，宛陵注。叔志古汴、段天祐吉甫皆序"}],"chunksPerFile":20}