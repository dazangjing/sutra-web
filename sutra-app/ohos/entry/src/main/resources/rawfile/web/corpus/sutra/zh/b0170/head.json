{"id":"b0170","title":"朝鲜佛教通史","titleTrad":"朝鮮佛教通史","byline":"著者识","bylineLabel":"著者·译者","dynasty":"","division":"事汇部","canon":"B0170","canonName":"大藏经补编","volume":"B0170","juanCount":3,"textLength":1038079,"imageCount":0,"summary":"","tags":["事汇部","大藏经补编"],"order":3202,"guide":"","chunks":68,"toc":[{"level":3,"text":"朝鲜佛教通史序"},{"level":3,"text":"序"},{"level":3,"text":"自序"},{"level":3,"text":"【备考】有唐新罗国故康州智异山双溪寺教谥真鉴国师碑铭并序"},{"level":3,"text":"【备考】武州桐里山大安寺寂忍禅师碑颂并序"},{"level":3,"text":"天顺三年己卯七月七日序"},{"level":3,"text":"天监十一年(佛纪一五三九年)勅沙门宝亮。撰涅槃经。帝为制序"},{"level":3,"text":"太古语录序"},{"level":3,"text":"重刊缁门警训序"},{"level":3,"text":"(附)普济尊者语录序"},{"level":3,"text":"苍龙己未八月既望韩山君李穑序"},{"level":3,"text":"禅家龟鉴序"},{"level":3,"text":"密教大藏序"},{"level":3,"text":"梵音族派序"},{"level":2,"text":"(附)新罗高丽时代佛教的遗迹（关野贞演述(密教第三卷第一"},{"level":3,"text":"华严宗主某禅师碑铭并序"},{"level":3,"text":"御制训民正音序"},{"level":3,"text":"○黄州郡正方山兼千圣山成佛寺事迹碑铭并序"},{"level":3,"text":"报恩郡俗离山法住寺世尊舍利碑铭并序"},{"level":3,"text":"○总会顺序"}],"chunksPerFile":20}