[[{"t":"经卷第七十五","level":2},{"t":"入法界品之十六","level":0},{"t":"爱念情至","level":0},{"t":"(至犹极也)。","level":0},{"t":"为其安立","level":0},{"t":"(为于伪反)。","level":0},{"t":"十方无闲","level":0},{"t":"(颜注汉书曰闲空也谓无空隟之处也又音古闲反文纪传注曰容也谓更无有容受处也)。","level":0},{"t":"足趺隆起","level":0},{"t":"(小雅曰隆高也)。","level":0},{"t":"身上分","level":0},{"t":"(分符问反)。","level":0},{"t":"颊","level":0},{"t":"(兼<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11426.gif\" alt=\"𭜴\" title=\"𭜴\" />反)。","level":0},{"t":"鲜白","level":0},{"t":"(鲜相延反玉篇曰鲜明也)。","level":0},{"t":"睫","level":0},{"t":"(煎叶反又作𥅴)。","level":0},{"t":"身上靡","level":0},{"t":"(靡亡彼反汉书拾遗曰靡倾也倾谓偃卧也)。","level":0},{"t":"翊从","level":0},{"t":"(翊以力反尚书大传曰翊辅也毛诗曰翊敬也字又作翼翼与翊义古别今作翼)。","level":0},{"t":"洪纤得所","level":0},{"t":"(纤相监反蔡雍注班固典引曰洪大纤细也)。","level":0},{"t":"修短合度","level":0},{"t":"(修长也郑玄注周礼曰度谓尺丈之数也言其长短合折中之节度)。","level":0},{"t":"先太子行","level":0},{"t":"(先谓於先行也)。","level":0},{"t":"讽咏","level":0},{"t":"(郑注礼曰背文诵曰讽也)。","level":0},{"t":"殒灭","level":0},{"t":"(殒为愍反声类曰殒没也)。","level":0},{"t":"非其匹偶","level":0},{"t":"(偶吾苟反毛诗传曰匹配也杜注左传曰匹敌也玉篇曰偶谓不羁只也贾注国语曰偶对也玉篇曰耦对之耦从耒偶尓之偶从立人也)。","level":0},{"t":"暂时假<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00895.gif\" alt=\"𥧌\" title=\"𥧌\" />","level":0},{"t":"(寐蜜二反毛诗传曰寐寝也毛诗曰假寐永勤笺曰不脱衣而眠谓之假寐玉篇曰假寐衣冠坐而眠熟也)。","level":0},{"t":"为谁守护","level":0},{"t":"(护谓三护亦曰三监女人志弱故藉三护幼小父母护适人夫聟护老迈儿子护今此通问故言谁也监护之文经书悬合耳)。","level":0},{"t":"开剖","level":0},{"t":"(剖潘补反玉篇曰剖破也仓颉曰剖折也)。","level":0},{"t":"巧断","level":0},{"t":"(断都乱反)。","level":0},{"t":"冠以妙藏","level":0},{"t":"(冠古乱反)。","level":0},{"t":"被以火燄","level":0},{"t":"(被皮义反)。","level":0},{"t":"无讥丑","level":0},{"t":"(郑注礼曰讥呵察也毛诗传曰丑<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />也言可呵毁猥<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />之事)。","level":0},{"t":"天缯纩","level":0},{"t":"(缯疾绫反纩苦谤反说文曰缯帛也纩绵也小雅曰絮之细者曰纩也)。","level":0},{"t":"芬馨","level":0},{"t":"(馨显形反郭注[迄-乙+小]雅曰芬谓香气调和也说文曰馨谓香之远闻也)。","level":0},{"t":"尊宿","level":0},{"t":"(宿谓旧也)。","level":0},{"t":"下车步进","level":0},{"t":"(王逸注楚辤步徐行也进向前也)。","level":0},{"t":"立佛支提","level":0},{"t":"(支堤者具云制底耶谓於佛阇维处置坟及安佛所说经台阁之名也此翻为积集谓是人天积集无量福善之所也又或翻为生净信处)。","level":0},{"t":"竟不可得","level":0},{"t":"(郑笺诗曰竟终也)。","level":0},{"t":"愿得俻瞻侍","level":0},{"t":"(说文曰俻具也<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />野王曰俻谓豫早为之也孔安注书瞻视也谓看视)。","level":0},{"t":"毛孔量","level":0},{"t":"(量力仗反谓分位也)。","level":0}],[{"t":"经卷第七十六","level":2},{"t":"入法界品之十七","level":0},{"t":"御扞","level":0},{"t":"(御鱼举反杆何干反郑注[迄-乙+小]雅曰御谓禁制之也杜注左传曰御正也杆修也蔽谓遮塞之也杆字声类作捍也)。","level":0},{"t":"廓彻心城","level":0},{"t":"(方言曰张小使大谓之廓也[迄-乙+小]雅曰廓大也通俗文曰廓宽也说文曰彻通也此中经意谓以理融事小遍法界故曰张小使大)。","level":0},{"t":"严肃","level":0},{"t":"(毛诗传曰严威也肃缩也缩谓高限者令缩退也言其有威德肃物也)。","level":0},{"t":"逐诸<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />法","level":0},{"t":"(玉篇曰逐駈也)。","level":0},{"t":"莹彻心城","level":0},{"t":"(仓颉篇曰莹治也贾注国语曰彻明也说文曰彻通也今谓治理心城使其通达无所拥塞也)。","level":0},{"t":"部分心城","level":0},{"t":"(分苻问反谓有部类有分齐者也)。","level":0},{"t":"罗<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09400.gif\" alt=\"𠛴\" title=\"𠛴\" />鬼王","level":0},{"t":"(罗<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09400.gif\" alt=\"𠛴\" title=\"𠛴\" />具云罗<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09400.gif\" alt=\"𠛴\" title=\"𠛴\" />娑此翻为可畏也言王者谓即毗沙门也)。","level":0},{"t":"悉达太子","level":0},{"t":"(悉达者具云萨缚頞他悉地地字应平声呼言萨缚者此云一切也頞他事也悉地成也言其於一切所应作事皆已成就也)。","level":0},{"t":"虽不逾本","level":0},{"t":"(字林曰逾越也)。","level":0},{"t":"楼至如来","level":0},{"t":"(楼至具云噜支此翻为爱乐也)。","level":0},{"t":"造僧伽蓝","level":0},{"t":"(具云僧伽罗摩言僧伽者此云众也罗摩院也)。","level":0},{"t":"营办什物","level":0},{"t":"(颜注汉书曰什物谓为生之具也三苍曰什聚也杂也吴楚之闲资生虽具通谓之什物有数十事物为什物者此盖少知之说也)。","level":0},{"t":"拖","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00501.gif\" alt=\"䭾\" title=\"䭾\" />之轻声)。","level":0},{"t":"婆","level":0},{"t":"(婆之上声)。","level":0},{"t":"荼","level":0},{"t":"(荼之上声)。","level":0},{"t":"沙","level":0},{"t":"(史我反)。","level":0},{"t":"缚","level":0},{"t":"(房我反)。","level":0},{"t":"哆","level":0},{"t":"(哆之上声)。","level":0},{"t":"也","level":0},{"t":"(夷我反)。","level":0},{"t":"娑","level":0},{"t":"(娑之上声)。","level":0},{"t":"麼","level":0},{"t":"(莫我反)。","level":0},{"t":"众峰齐峙","level":0},{"t":"(峙持止反广雅曰峙止也齐齐然止立也)。","level":0},{"t":"字","level":0},{"t":"(冝从止者[謵-白+尒]也)。","level":0},{"t":"伽","level":0},{"t":"(伽之上声轻呼)。","level":0},{"t":"他","level":0},{"t":"(他之上声)。","level":0},{"t":"奢","level":0},{"t":"(尸何反借音也)。","level":0},{"t":"叉","level":0},{"t":"(楚我反)。","level":0},{"t":"娑哆","level":0},{"t":"(娑乘[糸*(占-口+乙)]反哆当我反)。","level":0},{"t":"婆","level":0},{"t":"(婆之上声)。","level":0},{"t":"车","level":0},{"t":"(昌野反)。","level":0},{"t":"娑麼","level":0},{"t":"(娑来我反)。","level":0},{"t":"诃婆","level":0},{"t":"(并上声呼)。","level":0},{"t":"縒","level":0},{"t":"(仓我反)。","level":0},{"t":"伽","level":0},{"t":"(伽之上声)。","level":0},{"t":"咤","level":0},{"t":"(陟加反)。","level":0},{"t":"拏","level":0},{"t":"(搦可反)。","level":0},{"t":"娑颇","level":0},{"t":"(娑乘[糸*(占-口+乙)]反)。","level":0},{"t":"娑","level":0},{"t":"(并上声呼)。","level":0},{"t":"也娑","level":0},{"t":"(也夷我反娑字上声呼之)。","level":0},{"t":"侘","level":0},{"t":"(耻加反)。","level":0},{"t":"咸综无遗","level":0},{"t":"(综子贡反三苍曰综理经经谓整理经纬之都本也)。","level":0},{"t":"蕰其深解","level":0},{"t":"(蕰於殒反杜注左传曰蕴蓄也方言曰蕴积也马融注论语曰蕰藏也)。","level":0},{"t":"呪诅","level":0},{"t":"(诅侧预反郑玄注周礼曰诅谓祝使其败露也)。","level":0},{"t":"痊愈","level":0},{"t":"(痊七缘反愈逾矩反郭象注庄子曰痊谓病除也玉篇曰病差曰愈字又作瘉也)。","level":0},{"t":"别知","level":0},{"t":"(别彼列反)。","level":0},{"t":"珠贝","level":0},{"t":"(案西域以贝为钱故列在宝类)。","level":0},{"t":"鸡萨罗","level":0},{"t":"(师子身毛旋父呼为鸡萨罗西域有宝旋文恰如师子毛旋形故从其为名耳也)。","level":0},{"t":"城名婆怛[邱-丘+(白-日+(丹-、+十))]","level":0},{"t":"(具云难陁婆怛<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />言难陁者此云喜也婆怛<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />者增益也其城在摩竭国内如经本中说)。","level":0}],[{"t":"经卷第七十七","level":2},{"t":"入法界品之十八","level":0},{"t":"涸无量爱欲海","level":0},{"t":"(广雅曰涸尽也谓令其竭尽也)。","level":0},{"t":"杜绝诸<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />道","level":0},{"t":"(贾注国语曰杜塞也说文曰杜塞閇也说文字乃作[度*支]也)。","level":0},{"t":"如济客","level":0},{"t":"(毛诗传曰济渡也案客谓寄居之称故采樵寄山济渡中水饮士寄醉贾人寄屋皆谓之客也)。","level":0},{"t":"重任","level":0},{"t":"(重直勇反任如禁反)。","level":0},{"t":"佣作","level":0},{"t":"(佣与恭反作则各反玉篇曰慵谓伇力也受直也谷梁传曰作为也)。","level":0},{"t":"[伭-〦+一]下","level":0},{"t":"([伭-〦+一]下奚反)。","level":0},{"t":"旃荼罗","level":0},{"t":"(此云暴<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />人也)。","level":0},{"t":"犗牛","level":0},{"t":"(犗加迈反切韵称犗犍牛也)。","level":0},{"t":"舟艥","level":0},{"t":"(艥秦业资业二反通俗文曰曜谓之檝释名曰擑值也拨水使舟倢疾也又案<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12275.gif\" alt=\"𢴠\" title=\"𢴠\" />字不著戈音乃资叶反然训义无别也)。","level":0},{"t":"良工","level":0},{"t":"(良善也工技也)。","level":0},{"t":"捃拾","level":0},{"t":"(捃居韵居运二反汉书集注曰捃<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15756.gif\" alt=\"𠬧\" title=\"𠬧\" />也)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10119.gif\" alt=\"𭁺\" title=\"𭁺\" />王<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10119.gif\" alt=\"𭁺\" title=\"𭁺\" />","level":0},{"t":"(上<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10119.gif\" alt=\"𭁺\" title=\"𭁺\" />字古乱反下<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10119.gif\" alt=\"𭁺\" title=\"𭁺\" />字古端反)。","level":0},{"t":"[損-口+ㄙ]耗","level":0},{"t":"(耗呼告反灭也)。","level":0},{"t":"善知识之所致耳","level":0},{"t":"(颜注汉书曰致谓引而至之也)。","level":0},{"t":"此善渔人","level":0},{"t":"(渔语居语据二反二伐於事曰善也说文曰渔捕鱼也大篆字又作<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09436.gif\" alt=\"𩼪\" title=\"𩼪\" />声类作䲣<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00905.gif\" alt=\"䰻\" title=\"䰻\" />二体)。","level":0},{"t":"过尒燄海","level":0},{"t":"(尓燄者此云所知谓智所知境非预识境由其转若南声为尓塩故非转毗若南声也)。","level":0},{"t":"哽噎","level":0},{"t":"(哽加杏反说文曰哽谓食内膏骨在喉内也悲忧咽塞者似其膏骨在喉故借喻言之耳)。","level":0},{"t":"自盈其手","level":0},{"t":"(韩康注易云盈满也)。","level":0}],[{"t":"经卷第七十八","level":2},{"t":"入法界品之十九","level":0},{"t":"曩於福城","level":0},{"t":"(曩<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />朗反[迄-乙+小]雅曰曩向也珠丛曰向谓往时也向音虚鞅反)。","level":0},{"t":"擐大悲甲","level":0},{"t":"(擐胡串反杜注左传曰擐贯也贾注国语曰擐衣甲也衣音意)。","level":0},{"t":"断贪鞅","level":0},{"t":"(鞅於仰鞅谓切牛颈下绳牛以此绳不能重载凢夫由其贪之能断生死之鞅绳也)。","level":0},{"t":"撒睡盖","level":0},{"t":"(撤除列诸列二反字书曰撤除也去也)。","level":0},{"t":"四流漂汩者","level":0},{"t":"(汩荣笔反珠丛云汨流<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15032.gif\" alt=\"㒵\" title=\"㒵\" />也又音古没反尚书大传曰汩乱也汉书集注曰汩流急<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15032.gif\" alt=\"㒵\" title=\"㒵\" />今取流<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />也)。","level":0},{"t":"饮以甘露","level":0},{"t":"(饮於禁反饮<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04424.gif\" alt=\"𩚅\" title=\"𩚅\" />水也)。","level":0},{"t":"住邪济者","level":0},{"t":"(毛诗传曰济渡也谓行异道如度者求於异津故此借喻名耳)。","level":0},{"t":"晓诲","level":0},{"t":"(说文曰晓说也音税)。","level":0},{"t":"犷<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00128.gif\" alt=\"㑦\" title=\"㑦\" />","level":0},{"t":"(犷古猛反<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00128.gif\" alt=\"㑦\" title=\"㑦\" />零计反)。","level":0},{"t":"坑穽","level":0},{"t":"(穽疾政反郑玄注周礼曰穽谓穿地为堑所以捕狩其超逾者则陷焉案籀文作阱蔽古文作汬者也)。","level":0},{"t":"苦的","level":0},{"t":"(的谓准的鹿<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00685.gif\" alt=\"䐡\" title=\"䐡\" />也)。","level":0},{"t":"箧","level":0},{"t":"(牵恊反郑注礼记曰盛私物凾曰箧也)。","level":0},{"t":"贮","level":0},{"t":"(陟吕反)。","level":0},{"t":"毗笈摩药","level":0},{"t":"(毗笈摩者此云普去谓能普去一切疾病也)。","level":0},{"t":"周给","level":0},{"t":"(周帀供给故云周给)。","level":0},{"t":"利矛","level":0},{"t":"(矛莫胡反)。","level":0},{"t":"兵仗","level":0},{"t":"(仗除亮反风俗通曰仗者刀<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02455.gif\" alt=\"㦸\" title=\"㦸\" />之惣名也)。","level":0},{"t":"钳鋷","level":0},{"t":"(鋷尼輙反玉篇曰鋷谓拔去<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00263.gif\" alt=\"𥇒\" title=\"𥇒\" />[肆-聿+((彰-章)/犮)]也经本有作鋷者此乃车轴端<img class=\"gaiji\" src=\"asset://gaiji-CB/05/CB05033.gif\" alt=\"䥫\" title=\"䥫\" />非经所用)。","level":0},{"t":"阿伽陁药","level":0},{"t":"(此云无病药也谓有药处必无有病也)。","level":0},{"t":"婆楼[邱-丘+(白-日+(丹-、+十))]风","level":0},{"t":"(此云迅猛风也其风坚密如持世界风轮也)。","level":0},{"t":"毒不能中","level":0},{"t":"(中陟仲反中犹著也)。","level":0},{"t":"大应伽药","level":0},{"t":"(应伽此云身身有四名一曰迦耶二曰没理罗三曰弟河四曰应加亦云分谓支分也)。","level":0},{"t":"药树名[狦-(狂-王)+王]陁<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />","level":0},{"t":"([狦-(狂-王)+王]陁<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />者此云和合或云续断谓此药能令已断伤者再续和合也)。","level":0},{"t":"初无所[損-口+ㄙ]","level":0},{"t":"(言从初已来不增损也)。","level":0},{"t":"药名阿蓝婆","level":0},{"t":"(此云汁药其药出香山及雪山中天生在石臼内或云得喜谓得此药者皆生欢喜之者)。","level":0},{"t":"波利质多罗树","level":0},{"t":"(波利此曰遍也亦曰周帀质多罗云闲错<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />严也言此树泉杂色花周帀严饰或曰圆妙<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />严也)。","level":0},{"t":"婆师迦花","level":0},{"t":"(具云婆利史迦言婆利史者此云雨也迦谓迦罗此云时也西域呼夏为雨其花生於夏时故名也)。","level":0},{"t":"瞻卜迦花","level":0},{"t":"(此云黄色花有香气而形似支子花)。","level":0},{"t":"苏摩[邱-丘+(白-日+(丹-、+十))]花","level":0},{"t":"(此云恱意花其花形色俱媚令见者心恱故名之也)。","level":0},{"t":"海岛","level":0},{"t":"(岛当老反孔安注书曰曲谓之岛说文曰海中往往有山可止曰岛也)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/14/CB14573.gif\" alt=\"㭨\" title=\"㭨\" />子","level":0},{"t":"(捓余遮反)。","level":0},{"t":"药汁名诃宅迦","level":0},{"t":"(此云金色水甚於九转还丹之力者也)。","level":0},{"t":"灯炷","level":0},{"t":"(炷之遇之<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12777.gif\" alt=\"𢈔\" title=\"𢈔\" />二反)。","level":0},{"t":"筋","level":0},{"t":"(居欣反字冝从肉经本有从角者谬也)。","level":0},{"t":"迦陵频伽鸟","level":0},{"t":"(此云美音鸟或曰妙声鸟此鸟本出雪山在[穀-(一/禾)+(夕*ㄗ)]中即能鸣其音和雅听者无猒也)。","level":0},{"t":"飞则劲[擴-黃+(建-干+├)]","level":0},{"t":"(劲甄盛反捷钱叶反说文曰劲强王逸注楚辤曰[擴-黃+(建-干+├)]疾也劲字从力捷字本从人今俗也)。","level":0},{"t":"摩诃[邱-丘+(白-日+(丹-、+十))]伽","level":0},{"t":"(此云龙亦曰象今此力士力如龙象故其名也)。","level":0},{"t":"射师","level":0},{"t":"(上食夜反)。","level":0},{"t":"摩竭鱼","level":0},{"t":"(此云大体也谓即此方巨鳌鱼其两眼如日张口如暗谷吞舟凡出𣸣流如潮若欲欱水壑高下如山大者可长二百里餘也)。","level":0},{"t":"安缮<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />药","level":0},{"t":"(缮时战反其[葉-世+ㄊ]色以青黛可以合和眼药然今所明自据别法也)。","level":0},{"t":"延龄药","level":0},{"t":"(龄历丁反[迄-乙+小]雅曰延长也广雅曰龄年也礼记曰古之谓年为龄也)。","level":0},{"t":"揳","level":0},{"t":"(先结反案说文作<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00249.gif\" alt=\"㨝\" title=\"㨝\" />古作相形者也)。","level":0},{"t":"𰝂漏","level":0},{"t":"(𰝂所禁反水潜没也字冝作<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07694.gif\" alt=\"㕘\" title=\"㕘\" />经本有从喿者音早非经所用也)。","level":0}],[{"t":"经卷第七十九","level":2},{"t":"入法界品之二十","level":0},{"t":"醉傲","level":0},{"t":"(傲五告杜注左传曰傲不敬也广雅曰傲[慢-(一/又)+万]也案诸字书傲字皆从立人今经本从竖心者[謵-白+尒]也)。","level":0},{"t":"陁<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />婆王","level":0},{"t":"(阿修罗之别名未详其义)。","level":0},{"t":"兜沙罗色","level":0},{"t":"(具云兜沙兜罗色言兜沙者此云霜也兜罗水也或有经本云兜罗沙者准知也)。","level":0},{"t":"狱卒","level":0},{"t":"(卒则没反)。","level":0},{"t":"长者子瞿波罗","level":0},{"t":"(案西方训字瞿有九义此中但取地白义波罗此云守护也谓守护心地或守护白法也)。","level":0},{"t":"摩罗提国","level":0},{"t":"(具云拘罗耶提数此云鬘陁或曰摩罗耶者山名也提数中也言此国中央有摩罗耶山故因名也)。","level":0},{"t":"拘咤聚落","level":0},{"t":"(具云拘咤迦此云小舍或曰多家亦曰多多楼观以此聚落中楼阁多也)。","level":0}],[{"t":"经卷第八十","level":2},{"t":"入法界品之二十一","level":0},{"t":"优昙花","level":0},{"t":"(优昙此云希有也此花多时乃一开也)。","level":0},{"t":"俨然坐","level":0},{"t":"(俨鱼俭反)。","level":0},{"t":"加被","level":0},{"t":"(被皮义反杜注左传曰加益也孔安注书曰被及也谓以益相及也又珠聚曰从加恩谓之被也)。","level":0},{"t":"誓众宣威","level":0},{"t":"(誓谓戒誓主与军旅为要约也故郑玄注周礼云戒誓要之以刑也毛诗传曰宣示也)。","level":0},{"t":"听讼断狱","level":0},{"t":"(听他寗反断都乱反孔安注书曰听谓察是非也周礼曰狱讼者听而断之郑玄注云争罪曰狱争财曰讼玉篇曰断谓裁制分决之也)。","level":0},{"t":"辅弼","level":0},{"t":"(弼皮笔反尚书大传曰天子必有四隣前仪后丞左辅右弼直立而敢断广心而从欲辅善而相承谓之辅廉洁而切谓之弼戴礼曰弼者拂拂天子之过常立於左洁廉而切直匡过而谏邪谓之弼也)。","level":0},{"t":"阿迦尼咤天","level":0},{"t":"(具云阿迦尼瑟咤天此云色究竟天也广释如上苐二十二卷中)。","level":0},{"t":"沾洽","level":0},{"t":"(广雅曰沾渍也玉篇曰洽濡也濡润也沾字或通作沾也)。","level":0},{"t":"炎热","level":0},{"t":"(炎于严反尓雅曰炎熏也郭璞云旱气熏灼人也)。","level":0},{"t":"新译大方广佛华严经音义卷下","level":0},{"t":"甲辰岁高丽国大藏都监奉<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30072.gif\" alt=\"𠡠\" title=\"𠡠\" />雕造","level":0}]]