[[{"t":"佛頂尊勝陀羅尼注義大興善寺三藏沙門大廣智 不空奉 詔譯","level":0},{"t":"No. 974D佛頂尊勝陀羅尼注義","level":0},{"t":"大興善寺三藏沙門大廣智不空奉　詔譯曩謨婆誐嚩帝怛𡃤路枳也鉢囉底尾始瑟吒野沒馱也婆誐嚩帝怛儞也他唵尾戍馱也尾戍馱也娑摩娑摩三滿多嚩婆娑娑頗囉拏<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03442.gif\" alt=\"𮓌\" title=\"𮓌\" />底誐訶曩娑嚩婆嚩尾舜弟阿毘詵者覩<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00805.gif\" alt=\"𤚥\" title=\"𤚥\" />素<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03442.gif\" alt=\"𮓌\" title=\"𮓌\" />多嚩囉嚩者曩阿蜜哩多毘灑罽阿訶囉阿訶囉阿欲散馱囉抳戍馱也戍馱也誐誐曩尾戍第鄔瑟膩沙尾惹也尾舜第娑訶娑囉囉濕弭散祖儞帝薩嚩怛他<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03442.gif\" alt=\"𮓌\" title=\"𮓌\" />多地瑟吒曩地瑟恥多摩訶母捺哩嚩日囉迦也僧訶多曩尾舜第薩嚩嚩囉拏播野訥<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03442.gif\" alt=\"𮓌\" title=\"𮓌\" />底跛哩尾舜弟鉢羅底儞靺多也阿欲舜第三麼耶地瑟恥帝麼抳麼抳摩訶麼抳怛他多步多句致跛哩舜第尾薩普吒沒地舜第惹也惹也尾惹也尾惹也娑麼囉娑麼囉薩嚩沒馱地瑟恥多舜第嚩曰<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00942.gif\" alt=\"㘑\" title=\"㘑\" />嚩日囉<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03442.gif\" alt=\"𮓌\" title=\"𮓌\" />陛嚩曰覽婆嚩覩麼麼設哩嚂薩嚩薩怛嚩難者迦也尾舜弟薩嚩<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03442.gif\" alt=\"𮓌\" title=\"𮓌\" />底跛哩舜第薩嚩怛他<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03442.gif\" alt=\"𮓌\" title=\"𮓌\" />多三麼濕嚩娑地瑟恥帝沒<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00833.gif\" alt=\"𠆙\" title=\"𠆙\" />沒<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00833.gif\" alt=\"𠆙\" title=\"𠆙\" />󰂛馱也舜第薩嚩怛他<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03442.gif\" alt=\"𮓌\" title=\"𮓌\" />多地瑟曩地瑟恥多摩訶母怛<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03272.gif\" alt=\"𭋸\" title=\"𭋸\" />娑嚩訶者，涅槃義。所謂四涅槃：一自性清淨涅槃、二有餘依涅槃、三無餘依涅槃、四無住處涅槃。如上所譯，唐梵敵對，顯句標釋。","level":0},{"t":"寶永二年冬十二月十三日以如來藏","level":0,"quote":true},{"t":"本書寫竟兜率谷雞頭院闍梨嚴覺","level":0,"quote":true},{"t":"享保三歲戊戌九月令得忍寫校正了","level":0,"quote":true},{"t":"慈泉","level":0,"quote":true},{"t":"文政六年癸未六月以東叡山真如院本令","level":0,"quote":true},{"t":"他寫自校之了龍肝","level":0,"quote":true},{"t":"校注十日切三六昧勝勝待相日或清命CBETA 校注大正藏 校注新增校注","level":0,"quote":true}]]