{"id":"x1549","title":"淨土聖賢錄","titleTrad":"淨土聖賢錄","byline":"清 彭希涑述","bylineLabel":"著者·译者","dynasty":"","division":"史传部","canon":"X1549","canonName":"新纂卍續藏","volume":"X1549","juanCount":9,"textLength":165526,"imageCount":0,"summary":"","tags":["史传部","新纂卍續藏"],"order":2886,"guide":"","chunks":40,"toc":[{"level":2,"text":"淨土聖賢錄卷一"},{"level":2,"text":"淨土聖賢錄卷二"},{"level":2,"text":"淨土聖賢錄卷三"},{"level":3,"text":"安養。平生所得，唯二法門。嘗集淨業禮懺儀，自為序"},{"level":2,"text":"淨土聖賢錄卷四"},{"level":2,"text":"淨土聖賢錄卷五"},{"level":2,"text":"淨土聖賢錄卷六"},{"level":2,"text":"淨土聖賢錄卷七"},{"level":2,"text":"淨土聖賢錄卷八"},{"level":3,"text":"徧參講席。晚年專修念佛三昧。述淨土自信錄，其序"},{"level":2,"text":"淨土聖賢錄卷九"}],"chunksPerFile":20}