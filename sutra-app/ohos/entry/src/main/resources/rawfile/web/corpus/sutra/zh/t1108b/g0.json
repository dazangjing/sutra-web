[[{"t":"救度佛母二十一种礼赞经","level":0},{"t":"纳摩阿(阿喇)鸦答(阿)喇叶","level":0},{"t":"敬礼圣大悲藏观自在菩萨","level":0},{"t":"波答拉胜境，绿色答(嘛)字生，","level":0,"quote":true},{"t":"三世佛业母，顶严无量光，","level":0,"quote":true},{"t":"祈并眷属临。","level":0,"quote":true},{"t":"诸天非天顶髻严，恭敬跪捧两足莲，","level":0,"quote":true},{"t":"度诸穷苦中之母，致礼救度佛母前。","level":0,"quote":true},{"t":"唵敬礼尊圣救度母","level":0},{"t":"绿色","level":0},{"t":"<img src=\"asset://figures/T/T20p0479_01.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"唵敬礼多哩速疾勇，咄多哩者除怖畏，","level":0,"quote":true},{"t":"咄哩能授诸胜义，具莎诃字我赞礼。","level":0,"quote":true},{"t":"赤色","level":0},{"t":"<img src=\"asset://figures/T/T20p0480_01.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼救度速勇母，目如刹那电光照，","level":0,"quote":true},{"t":"三世界尊莲华面，从妙华中现端严。","level":0,"quote":true},{"t":"白色","level":0},{"t":"<img src=\"asset://figures/T/T20p0480_02.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼百秋朗月母，普遍圆照无垢面，","level":0,"quote":true},{"t":"如千星宿俱时聚，殊胜威光超於彼。","level":0,"quote":true},{"t":"黄色","level":0},{"t":"<img src=\"asset://figures/T/T20p0480_03.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼紫磨金色母，妙莲华手胜庄严，","level":0,"quote":true},{"t":"施精勤行柔善静，忍辱禅定性无境。","level":0,"quote":true},{"t":"黄色","level":0},{"t":"<img src=\"asset://figures/T/T20p0480_04.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼如来顶髻母，最胜能满无边行，","level":0,"quote":true},{"t":"德到彼岸尽无餘，胜势佛子极所爱。","level":0,"quote":true},{"t":"金色","level":0},{"t":"<img src=\"asset://figures/T/T20p0480_05.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼怛啰吽字母，声爱方所满虚空，","level":0,"quote":true},{"t":"运足遍履七世界，悉能钩召摄无餘。","level":0,"quote":true},{"t":"赤色","level":0},{"t":"<img src=\"asset://figures/T/T20p0480_06.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼释梵火天母，风神自在众俱集，","level":0,"quote":true},{"t":"部多起尸寻香等，诸药叉众作称叹。","level":0,"quote":true},{"t":"青色","level":0},{"t":"<img src=\"asset://figures/T/T20p0481_01.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼特啰胝发母，於他加行极摧坏，","level":0,"quote":true},{"t":"展左踡右作足踏，顶髻炽盛极明耀。","level":0,"quote":true},{"t":"红色","level":0},{"t":"<img src=\"asset://figures/T/T20p0481_02.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼都哩大紧母，勇猛能摧怨魔类，","level":0,"quote":true},{"t":"於莲华面作频眉，摧坏一切冤家众。","level":0,"quote":true},{"t":"红色","level":0},{"t":"<img src=\"asset://figures/T/T20p0481_03.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼三宝严印母，手指当心威严相，","level":0,"quote":true},{"t":"严饰方轮尽无餘，自身炽盛光聚种。","level":0,"quote":true},{"t":"红色","level":0},{"t":"<img src=\"asset://figures/T/T20p0481_04.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼威德欢悦母，宝光珠鬘众光饰，","level":0,"quote":true},{"t":"最极喜笑覩怛哩，镇世间魔作摄伏。","level":0,"quote":true},{"t":"青色","level":0},{"t":"<img src=\"asset://figures/T/T20p0481_05.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼守护众地母，亦能钩召诸神众，","level":0,"quote":true},{"t":"摇颦眉面吽声字，一切衰败令度脱。","level":0,"quote":true},{"t":"金色","level":0},{"t":"<img src=\"asset://figures/T/T20p0481_06.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼顶冠月相母，冠中现胜妙严光，","level":0,"quote":true},{"t":"阿弥陀佛髻中现，常放众妙宝光明。","level":0,"quote":true},{"t":"赤色","level":0},{"t":"<img src=\"asset://figures/T/T20p0482_01.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼如尽劫火母，安住炽盛顶髻中，","level":0,"quote":true},{"t":"普遍喜悦半趺坐，能摧灭坏恶冤轮。","level":0,"quote":true},{"t":"青色","level":0},{"t":"<img src=\"asset://figures/T/T20p0482_02.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼手按大地母，以足践蹋作镇压，","level":0,"quote":true},{"t":"现颦眉面作吽声，能破七险镇降伏。","level":0,"quote":true},{"t":"白色","level":0},{"t":"<img src=\"asset://figures/T/T20p0482_03.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼安隐柔善母，涅槃寂灭最乐境，","level":0,"quote":true},{"t":"莎诃命种以相应，善能消灭大灾祸。","level":0,"quote":true},{"t":"白色","level":0},{"t":"<img src=\"asset://figures/T/T20p0482_04.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼普遍极喜母，诸怨支体令脱离，","level":0,"quote":true},{"t":"十字呪句妙严布，明呪吽声常朗耀。","level":0,"quote":true},{"t":"黄色","level":0},{"t":"<img src=\"asset://figures/T/T20p0482_05.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼都哩巴帝母，足蹑相势吽字种，","level":0,"quote":true},{"t":"弥噜曼陀结辣萨，於此三处能摇动。","level":0,"quote":true},{"t":"黄色","level":0},{"t":"<img src=\"asset://figures/T/T20p0482_06.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼萨啰天海母，手中执住神兽像，","level":0,"quote":true},{"t":"诵二怛啰作发声，能灭诸毒尽无餘。","level":0,"quote":true},{"t":"金色","level":0},{"t":"<img src=\"asset://figures/T/T20p0483_01.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼诸天集会母，天紧那罗所依爱，","level":0,"quote":true},{"t":"威德欢悦若坚铠，灭除鬪诤及恶梦。","level":0,"quote":true},{"t":"黄色","level":0},{"t":"<img src=\"asset://figures/T/T20p0483_02.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼日月广圆母，目覩犹胜普光照，","level":0,"quote":true},{"t":"诵二喝啰咄怛哩，善除恶毒瘟热病。","level":0,"quote":true},{"t":"青色","level":0},{"t":"<img src=\"asset://figures/T/T20p0483_03.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"敬礼具三真实母，善静威力皆具足，","level":0,"quote":true},{"t":"药叉执魅尾怛辣，都哩最极除灾祸。","level":0,"quote":true},{"t":"若有智者勤精进，至心诵此二十一，","level":0,"quote":true},{"t":"救度尊处诚信礼，是故赞叹根本呪。","level":0,"quote":true},{"t":"每晨早起夕时礼，忆念施诸胜无畏，","level":0,"quote":true},{"t":"一切罪业尽消除，悉能超越诸恶趣。","level":0,"quote":true},{"t":"此等速能得聪慧，七俱胝佛所灌顶，","level":0,"quote":true},{"t":"现世富贵寿延安，当来趣向诸佛位。","level":0,"quote":true},{"t":"有时误服诸毒物，或自然生或合成，","level":0,"quote":true},{"t":"忆念圣尊真实力，诸恶毒药尽消灭。","level":0,"quote":true},{"t":"或见他人遭鬼魅，或发热病受诸苦，","level":0,"quote":true},{"t":"若转此赞二三七，彼诸苦恼悉蠲除。","level":0,"quote":true},{"t":"欲乞男女得男女，求财宝位获富饶，","level":0,"quote":true},{"t":"善能圆满随意愿，一切障碍不能侵。","level":0,"quote":true},{"t":"佛母尊圣救度母，及诸十方三世中，","level":0,"quote":true},{"t":"所有诸佛并弟子，我今一心敬赞礼。","level":0,"quote":true},{"t":"花香灯烛及香水，妙食妓乐等供养，","level":0,"quote":true},{"t":"实献即於意所现，皆愿众圣乐纳受。","level":0,"quote":true},{"t":"自从无始直至今，十不善及五无间，","level":0,"quote":true},{"t":"由心烦恼故所造，一切罪恶皆忏悔。","level":0,"quote":true},{"t":"声闻缘觉诸菩萨，乃至凡夫诸有情，","level":0,"quote":true},{"t":"三世所积诸福善，我皆随喜尽无餘。","level":0,"quote":true},{"t":"随诸有情一切愿，宜其种种差别智，","level":0,"quote":true},{"t":"应其大小通常类，劝转一切妙法轮。","level":0,"quote":true},{"t":"从今直至轮回空，请常住世不涅槃，","level":0,"quote":true},{"t":"为苦海中诸众生，悉愿圣母慈眼观。","level":0,"quote":true},{"t":"我今所集诸福善，皆成无上菩提因，","level":0,"quote":true},{"t":"惟愿不久於众生，证得无上引导师。","level":0,"quote":true},{"t":"尊圣佛母具大悲，於我一切诸众生，","level":0,"quote":true},{"t":"速净诸障满资粮，愿令获得证菩提。","level":0,"quote":true},{"t":"直至无上菩提位，世世获得常安乐，","level":0,"quote":true},{"t":"於修菩提一切处，一切间断诸魔祟。","level":0,"quote":true},{"t":"疾病一切天寿类，并诸恶梦不利相，","level":0,"quote":true},{"t":"八怖一切恼害事，愿令急速尽消除。","level":0,"quote":true},{"t":"世间及於出世间，一切善乐於丰足，","level":0,"quote":true},{"t":"增盛一切饶益事，愿令获得自然成。","level":0,"quote":true},{"t":"精进修行法增盛，修汝常得见圣颜，","level":0,"quote":true},{"t":"悟入空义菩提意，愿令暂如朔月增。","level":0,"quote":true},{"t":"彼佛众会咸清净，我时於胜莲华生，","level":0,"quote":true},{"t":"亲睹如来无量光，现前受我菩提记。","level":0,"quote":true},{"t":"我从住世所修佛，三世一切佛业母，","level":0,"quote":true},{"t":"一面二臂身绿色，愿执优婆花吉祥。","level":0,"quote":true},{"t":"佛母体微妙云何，及於眷属共寿量，","level":0,"quote":true},{"t":"境界及於号云何，愿我等皆亦复然。","level":0,"quote":true},{"t":"赞祝尔尊微善力，我等随方所在处，","level":0,"quote":true},{"t":"病魔贫争尽消除，善祥增长祈皆赐。","level":0,"quote":true},{"t":"礼供世尊母，我以所积善，","level":0,"quote":true},{"t":"世界诸众生，皆生极乐界。","level":0,"quote":true},{"t":"弃身过庄严相好，弃语过获频伽音，","level":0,"quote":true},{"t":"弃意过证一切智，成胜吉祥功德瑞。","level":0,"quote":true},{"t":"圣救度佛母二十一种礼赞经竟","level":0}]]