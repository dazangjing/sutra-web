{"id":"x0600","title":"法華經入疏","titleTrad":"法華經入疏","byline":"姚秦三藏法師","bylineLabel":"著者·译者","dynasty":"","division":"经疏部","canon":"X0600","canonName":"新纂卍續藏","volume":"X0600","juanCount":12,"textLength":401901,"imageCount":0,"summary":"","tags":["经疏部","新纂卍續藏"],"order":1604,"guide":"","chunks":140,"toc":[{"level":3,"text":"序序品第一"},{"level":3,"text":"方便品第二"},{"level":3,"text":"譬喻品第三"},{"level":3,"text":"信解品第四"},{"level":3,"text":"藥草喻品第五"},{"level":3,"text":"授記品第七"},{"level":3,"text":"五百弟子授記品第九"},{"level":3,"text":"法師品第十一"},{"level":3,"text":"提婆達多品第十三"},{"level":3,"text":"安樂行品第十四"},{"level":3,"text":"從地涌出品第十六"},{"level":3,"text":"分別功德品第十七"},{"level":3,"text":"隨喜功德品第十九"},{"level":3,"text":"常不輕菩薩品第二十"},{"level":3,"text":"如來神力品第二十一"},{"level":3,"text":"囑累品第二十二"},{"level":3,"text":"藥王菩薩本事品第二十三"},{"level":3,"text":"妙音菩薩品第二十四"},{"level":3,"text":"觀世音菩薩普門品第二十五"},{"level":3,"text":"陀羅尼品第二十七"},{"level":3,"text":"普賢菩薩勸發品第二十八"},{"level":3,"text":"刻法華入疏序"},{"level":2,"text":"妙法蓮華經入疏卷第一"},{"level":3,"text":"序品第一"},{"level":3,"text":"名通序。通冠經首，故曰次序也。二、由序者，即別序"},{"level":3,"text":"此廣結同嘉會也。始從如是直下止此俱名通序"},{"level":2,"text":"妙法蓮華經入疏卷第二"},{"level":3,"text":"方便品第二"},{"level":2,"text":"妙法蓮華經入疏卷第三"},{"level":3,"text":"譬喻品第三"},{"level":3,"text":"此去訖品第二，重頌上文。偈有一百六十五行，分"},{"level":2,"text":"玅法蓮華經入疏卷第四"},{"level":3,"text":"信解品第四"},{"level":2,"text":"妙法蓮華經入疏卷第五"},{"level":3,"text":"藥草喻品第五"},{"level":2,"text":"玅法蓮華經入疏卷第六"},{"level":3,"text":"授記品第六"},{"level":3,"text":"化城喻品第七"},{"level":2,"text":"玅法蓮華經入疏卷第七"},{"level":3,"text":"五百弟子受記品第八"},{"level":3,"text":"二：一授滿願，二授千二百。初滿願復二：一經家序"},{"level":3,"text":"授學無學人記品第九"},{"level":3,"text":"法師品第十"},{"level":3,"text":"見寶塔品第十一"},{"level":2,"text":"妙法蓮華經入疏卷第八"},{"level":3,"text":"提婆達多品第十二"},{"level":3,"text":"勸持品第十三"},{"level":2,"text":"玅法蓮華經入疏卷第九"},{"level":3,"text":"安樂行品第十四"},{"level":2,"text":"玅法蓮華經入疏卷第十"},{"level":3,"text":"從地涌出品第十五"},{"level":3,"text":"門單流通段也。此乃本門序、正、流通三分。此本序"},{"level":3,"text":"如來壽量品第十六"},{"level":3,"text":"分別功德品第十七"},{"level":2,"text":"妙法蓮華經入疏卷第十一"},{"level":3,"text":"隨喜功德品第十八"},{"level":3,"text":"法師功德品第十九"},{"level":3,"text":"常不輕菩薩品第二十"},{"level":3,"text":"如來神力品第二十一"},{"level":3,"text":"囑累品第二十二"},{"level":3,"text":"藥王菩薩本事品第二十三"},{"level":2,"text":"妙法蓮華經入疏卷第十二"},{"level":3,"text":"妙音菩薩品第二十四"},{"level":3,"text":"觀世音菩薩普門品第二十五"},{"level":3,"text":"陀羅尼品第二十六"},{"level":3,"text":"此品第二、藥王下五品，約化他勸流通中第三、陀"},{"level":3,"text":"妙莊嚴王本事品第二十七"},{"level":3,"text":"普賢菩薩勸發品第二十八"}],"chunksPerFile":20}