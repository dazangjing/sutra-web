[[{"t":"一百五十赞佛颂","level":0},{"t":"尊者摩咥里制咤造","level":0},{"t":"大唐沙门义净於那烂陀寺译","level":0},{"t":"世尊最殊胜，善断诸惑种，","level":0,"quote":true},{"t":"无量胜功德，总集如来身。","level":0,"quote":true},{"t":"唯佛可归依，可赞可承事，","level":0,"quote":true},{"t":"如理思惟者，宜应住此教。","level":0,"quote":true},{"t":"诸恶烦恼习，护世者已除，","level":0,"quote":true},{"t":"福智二俱圆，唯尊不退没。","level":0,"quote":true},{"t":"纵生恶见者，於尊起嫌恨，","level":0,"quote":true},{"t":"伺求身语业，无能得瑕隙。","level":0,"quote":true},{"t":"记我得人身，闻法生欢喜，","level":0,"quote":true},{"t":"譬如巨海内，盲龟遇楂穴。","level":0,"quote":true},{"t":"妄念恒随逐，惑业堕深坑，","level":0,"quote":true},{"t":"故我以言词，叹佛实功德。","level":0,"quote":true},{"t":"牟尼无量境，圣德无边际，","level":0,"quote":true},{"t":"为求自利故，我今赞少分。","level":0,"quote":true},{"t":"敬礼无师智，希有众事性，","level":0,"quote":true},{"t":"福慧及威光，谁能知数量？","level":0,"quote":true},{"t":"如来德无限，无等无能说，","level":0,"quote":true},{"t":"我今求福利，假赞以名言。","level":0,"quote":true},{"t":"我智力微浅，佛德无崖际，","level":0,"quote":true},{"t":"唯愿大慈悲，拯我无归处。","level":0,"quote":true},{"t":"怨亲悉平等，无缘起大悲，","level":0,"quote":true},{"t":"普於众生界，恒作真善友。","level":0,"quote":true},{"t":"内财尚能舍，何况於外财，","level":0,"quote":true},{"t":"尊无悋惜心，求者满其愿。","level":0,"quote":true},{"t":"以身护彼身，以命赎他命，","level":0,"quote":true},{"t":"全躯救一鸽，欢喜无悭悋。","level":0,"quote":true},{"t":"尊不畏恶道，亦不贪善趣，","level":0,"quote":true},{"t":"但为心澄洁，尸罗由此成。","level":0,"quote":true},{"t":"常离诸邪曲，恒亲质直者，","level":0,"quote":true},{"t":"诸业本性空，唯居第一义。","level":0,"quote":true},{"t":"众苦逼其身，尊能善安虑，","level":0,"quote":true},{"t":"正智断诸惑，有过悉兴悲。","level":0,"quote":true},{"t":"殉命济他难，生无量欢喜，","level":0,"quote":true},{"t":"如死忽重苏，此喜过於彼。","level":0,"quote":true},{"t":"怨对害其身，一切时恒恼，","level":0,"quote":true},{"t":"不观其过恶，常起大悲心。","level":0,"quote":true},{"t":"正遍菩提种，心恒所珍玩，","level":0,"quote":true},{"t":"大雄难胜智，无有能及者。","level":0,"quote":true},{"t":"无等菩提果，苦行是其因，","level":0,"quote":true},{"t":"由此不顾身，勤修诸胜品。","level":0,"quote":true},{"t":"豪贵与贫贱，等引以大悲，","level":0,"quote":true},{"t":"於诸差别中，而无高下想。","level":0,"quote":true},{"t":"胜乐等持果，心无有贪著，","level":0,"quote":true},{"t":"普济诸群生，大悲无间断。","level":0,"quote":true},{"t":"尊虽遭极苦，於乐不悕求，","level":0,"quote":true},{"t":"妙智诸功德，殊胜无能共。","level":0,"quote":true},{"t":"染净诸杂法，简伪取其真，","level":0,"quote":true},{"t":"如清净鹅王，饮乳弃其水。","level":0,"quote":true},{"t":"於无量亿劫，勇猛趣菩提，","level":0,"quote":true},{"t":"於彼生生中，丧身求妙法。","level":0,"quote":true},{"t":"三僧祇数量，精勤无懈惓，","level":0,"quote":true},{"t":"持此为胜伴，以证妙菩提。","level":0,"quote":true},{"t":"尊无嫉姤心，於劣除轻想，","level":0,"quote":true},{"t":"平等无乖诤，胜行悉圆成。","level":0,"quote":true},{"t":"尊唯重因行，非求果位圆，","level":0,"quote":true},{"t":"遍修诸胜业，众德自成满。","level":0,"quote":true},{"t":"勤修出离法，超升众行顶，","level":0,"quote":true},{"t":"坐卧经行处，无非胜福田。","level":0,"quote":true},{"t":"拔除众过染，增长清净德，","level":0,"quote":true},{"t":"斯由积行成，唯尊最无上。","level":0,"quote":true},{"t":"众福皆圆满，诸过悉蠲除，","level":0,"quote":true},{"t":"如来净法身，尘习皆已断。","level":0,"quote":true},{"t":"资粮集更集，功归调御身，","level":0,"quote":true},{"t":"欲求於譬类，无能与佛等。","level":0,"quote":true},{"t":"遍观诸世间，灾横多障恼，","level":0,"quote":true},{"t":"纵有少分善，易得为比对；","level":0,"quote":true},{"t":"远离诸过患，湛然安不动，","level":0,"quote":true},{"t":"最胜诸善根，无能为譬喻。","level":0,"quote":true},{"t":"如来智深远，无底无边际，","level":0,"quote":true},{"t":"世事喻佛身，牛迹方大海。","level":0,"quote":true},{"t":"深仁荷一切，世间无有比，","level":0,"quote":true},{"t":"大地持重担，喻此实为轻。","level":0,"quote":true},{"t":"愚痴暗已除，牟尼光普照，","level":0,"quote":true},{"t":"世智非能譬，如萤对日光。","level":0,"quote":true},{"t":"如来三业净，秋月皎空池，","level":0,"quote":true},{"t":"世洁喻佛身，俱成尘浊性。","level":0,"quote":true},{"t":"如上诸所引，世中殊胜事，","level":0,"quote":true},{"t":"佛法逈超过，俗事可哀愍。","level":0,"quote":true},{"t":"圣法珍宝聚，佛最居其顶，","level":0,"quote":true},{"t":"无上无比中，唯佛与佛等。","level":0,"quote":true},{"t":"如来圣智海，随乐叹少分，","level":0,"quote":true},{"t":"鄙词赞胜德，对此实多惭。","level":0,"quote":true},{"t":"时俗覩降魔，一切咸归伏，","level":0,"quote":true},{"t":"观彼同真性，我谓等轻毛。","level":0,"quote":true},{"t":"假令大战阵，智勇能摧伏，","level":0,"quote":true},{"t":"圣德超世间，降彼非为喻。","level":0,"quote":true},{"t":"隣次降魔后，於夜后分中，","level":0,"quote":true},{"t":"断诸烦恼习，胜德皆圆满。","level":0,"quote":true},{"t":"圣智除众暗，超过千日光，","level":0,"quote":true},{"t":"摧伏诸邪宗，希有无能比。","level":0,"quote":true},{"t":"三善根圆满，永灭贪恚痴，","level":0,"quote":true},{"t":"种习悉已除，清净无能喻。","level":0,"quote":true},{"t":"妙法尊恒赞，不正法恒非，","level":0,"quote":true},{"t":"於斯邪正处，心无有憎爱。","level":0,"quote":true},{"t":"於圣弟子众，及外道师徒，","level":0,"quote":true},{"t":"於彼违顺中，佛心初无二。","level":0,"quote":true},{"t":"於德情无著，德者亦非贪，","level":0,"quote":true},{"t":"善哉极无垢，圣智恒圆洁。","level":0,"quote":true},{"t":"诸根常湛寂，永离迷妄心，","level":0,"quote":true},{"t":"於诸境界中，现量由亲覩。","level":0,"quote":true},{"t":"念慧穷真际，非凡愚所测，","level":0,"quote":true},{"t":"善安立语言，证彼亡言处。","level":0,"quote":true},{"t":"寂静无碍光，皎洁逾辉映，","level":0,"quote":true},{"t":"妙色世希有，孰不怀敬心？","level":0,"quote":true},{"t":"若有暂初观，或复恒瞻覩，","level":0,"quote":true},{"t":"妙相曾无二，前后悉同欢。","level":0,"quote":true},{"t":"最胜威德身，观者心无厌，","level":0,"quote":true},{"t":"纵经无量劫，欣仰似初观。","level":0,"quote":true},{"t":"所依之德体，能依之德心，","level":0,"quote":true},{"t":"性相二俱融，能所初无异。","level":0,"quote":true},{"t":"如斯善逝德，总集如来躬，","level":0,"quote":true},{"t":"离佛相好身，餘非所安处。","level":0,"quote":true},{"t":"我因先世福，幸遇调御师，","level":0,"quote":true},{"t":"仰赞功德山，远酬尊所记。","level":0,"quote":true},{"t":"一切有情类，皆因烦恼持，","level":0,"quote":true},{"t":"唯佛能善除，由悲久住世。","level":0,"quote":true},{"t":"谁当先敬礼，唯佛大悲尊，","level":0,"quote":true},{"t":"圣德超世间，悲愿处生死。","level":0,"quote":true},{"t":"尊居寂静乐，处浊为群生，","level":0,"quote":true},{"t":"永劫久精勤，慈心为一切。","level":0,"quote":true},{"t":"从真还利俗，由悲所引生，","level":0,"quote":true},{"t":"如呪出潜龙，兴云注甘雨。","level":0,"quote":true},{"t":"恒居胜定位，等观以怨亲，","level":0,"quote":true},{"t":"凶崄倡聒人，投身归圣德。","level":0,"quote":true},{"t":"神通师子吼，宣言三界尊，","level":0,"quote":true},{"t":"久已厌名闻，由悲自称赞。","level":0,"quote":true},{"t":"常修利他行，曾无自利心，","level":0,"quote":true},{"t":"慈念遍众生，於己偏无爱。","level":0,"quote":true},{"t":"悲愿无边际，逐器化群生，","level":0,"quote":true},{"t":"随处皆饶益，犹如散祭食。","level":0,"quote":true},{"t":"深心念一切，恒不舍须臾，","level":0,"quote":true},{"t":"利彼反遭辱，由咎非佛作。","level":0,"quote":true},{"t":"慈音演妙义，诚谛非虚说，","level":0,"quote":true},{"t":"广略任机缘，半满随时转。","level":0,"quote":true},{"t":"若闻尊演说，孰不叹希奇，","level":0,"quote":true},{"t":"纵令怀恶心，有智咸归信。","level":0,"quote":true},{"t":"义词恒善巧，或复出麁言，","level":0,"quote":true},{"t":"利益悉不虚，故并成真妙。","level":0,"quote":true},{"t":"柔软及麁犷，随事化众生，","level":0,"quote":true},{"t":"圣智无碍心，一味皆平等。","level":0,"quote":true},{"t":"胜哉无垢业，善巧喻良工，","level":0,"quote":true},{"t":"成此微妙身，演斯珍宝句。","level":0,"quote":true},{"t":"覩者皆欢喜，闻说并心开，","level":0,"quote":true},{"t":"美颜宣妙词，如月流甘露。","level":0,"quote":true},{"t":"慈云洒法雨，能清染欲尘，","level":0,"quote":true},{"t":"如彼金翅王，吞灭诸龙毒，","level":0,"quote":true},{"t":"能殄无明暗，喻如千日光，","level":0,"quote":true},{"t":"摧碎我慢山，譬犹天帝杵。","level":0,"quote":true},{"t":"现证非虚谬，静虑除乱心，","level":0,"quote":true},{"t":"如实善修行，三事皆圆满。","level":0,"quote":true},{"t":"创闻佛所说，心喜已开明，","level":0,"quote":true},{"t":"从此善思惟，消除诸垢染。","level":0,"quote":true},{"t":"遭苦能安慰，放逸令生怖，","level":0,"quote":true},{"t":"著乐劝厌心，随事皆开诱。","level":0,"quote":true},{"t":"上智证法喜，中根胜解生，","level":0,"quote":true},{"t":"浅劣发信心，尊言遍饶益。","level":0,"quote":true},{"t":"善拔诸邪见，引之趣涅槃，","level":0,"quote":true},{"t":"罪垢能洗除，由尊降法雨。","level":0,"quote":true},{"t":"一切智无碍，恒住正念中，","level":0,"quote":true},{"t":"如来所记莂，一向非虚谬。","level":0,"quote":true},{"t":"无非处非时，亦无非器转，","level":0,"quote":true},{"t":"尊言不虚发，闻者悉勤修。","level":0,"quote":true},{"t":"一路胜方便，无杂可修学，","level":0,"quote":true},{"t":"初中后尽善，餘教所皆无。","level":0,"quote":true},{"t":"如斯一向善，狂愚起谤心，","level":0,"quote":true},{"t":"此教若生嫌，无怨与斯等。","level":0,"quote":true},{"t":"历劫为群迷，备经众苦毒，","level":0,"quote":true},{"t":"此教纵非善，念佛尚应修。","level":0,"quote":true},{"t":"况能大饶益，复宣深妙义，","level":0,"quote":true},{"t":"纵使头被焚，先应救此教。","level":0,"quote":true},{"t":"自在菩提乐，圣德恒淡然，","level":0,"quote":true},{"t":"皆由此教生，证彼亡言处。","level":0,"quote":true},{"t":"世雄真实教，邪宗闻悉惊，","level":0,"quote":true},{"t":"魔王怀恼心，人天生胜喜。","level":0,"quote":true},{"t":"大地无分别，平等普能持，","level":0,"quote":true},{"t":"圣教利群生，邪正俱蒙益。","level":0,"quote":true},{"t":"暂闻佛所说，金刚种已成，","level":0,"quote":true},{"t":"纵未出樊笼，终超死行处。","level":0,"quote":true},{"t":"闻法方思义，如实善修行，","level":0,"quote":true},{"t":"次第三慧圆，餘教皆无此。","level":0,"quote":true},{"t":"唯独牛王仙，妙契真圆理，","level":0,"quote":true},{"t":"斯教不勤修，宁有怨过此？","level":0,"quote":true},{"t":"暂闻除渴爱，邪见信心生，","level":0,"quote":true},{"t":"听者发喜心，依斯具净戒。","level":0,"quote":true},{"t":"诞应时咸喜，成长世皆欢，","level":0,"quote":true},{"t":"大化利群生，示灭兴悲感。","level":0,"quote":true},{"t":"赞咏除众毒，忆念招欣庆，","level":0,"quote":true},{"t":"寻求发慧明，解悟心圆洁。","level":0,"quote":true},{"t":"遇者令尊贵，恭侍胜心生，","level":0,"quote":true},{"t":"承事感福因，亲奉除忧苦。","level":0,"quote":true},{"t":"尸罗具清洁，静虑心澄寂，","level":0,"quote":true},{"t":"般若圆智融，恒沙福所集。","level":0,"quote":true},{"t":"尊容及尊教，及尊所证法，","level":0,"quote":true},{"t":"见闻思觉中，此宝最殊胜。","level":0,"quote":true},{"t":"漂流作洲渚，害己恒为护，","level":0,"quote":true},{"t":"怖者作归依，引之令解脱。","level":0,"quote":true},{"t":"净戒成妙器，良田生胜果，","level":0,"quote":true}],[{"t":"善友能饶益，慧命由此成。","level":0,"quote":true},{"t":"行恩及和忍，见者咸欣悦，","level":0,"quote":true},{"t":"广集仁慈心，功德无边际。","level":0,"quote":true},{"t":"身口无过恶，爱敬由之生，","level":0,"quote":true},{"t":"吉祥众义利，咸依善逝德。","level":0,"quote":true},{"t":"导师能善诱，堕慢使翘勤，","level":0,"quote":true},{"t":"等持调曲心，迷途归正道。","level":0,"quote":true},{"t":"善根成熟者，驾驭以三乘，","level":0,"quote":true},{"t":"𢘙悷不调人，由悲故暂舍。","level":0,"quote":true},{"t":"於遭厄能设，安乐劝善修，","level":0,"quote":true},{"t":"悲愍苦众生，利乐诸群品。","level":0,"quote":true},{"t":"违害兴慈念，失行者生忧，","level":0,"quote":true},{"t":"暴虐起悲心，圣德无能赞。","level":0,"quote":true},{"t":"恩深於罔极，举世所咸知，","level":0,"quote":true},{"t":"於此返生怨，尊恒起慈愍。","level":0,"quote":true},{"t":"亡身救一切，自事不生忧，","level":0,"quote":true},{"t":"於诸崩堕人，亲能为援护。","level":0,"quote":true},{"t":"二世行恩造，超过诸世间，","level":0,"quote":true},{"t":"於暗常照明，尊为慧灯炷。","level":0,"quote":true},{"t":"人天所受用，随类有差殊，","level":0,"quote":true},{"t":"唯尊正法味，平等无差别。","level":0,"quote":true},{"t":"不观於氏族，色力及年华，","level":0,"quote":true},{"t":"随有善根人，求者皆蒙遂。","level":0,"quote":true},{"t":"广现诸希有，无缘起大慈，","level":0,"quote":true},{"t":"圣众及人天，合掌咸亲近。","level":0,"quote":true},{"t":"呜呼生死畏，佛出乃光晖，","level":0,"quote":true},{"t":"饶益诸众生，皆能满其愿。","level":0,"quote":true},{"t":"恶人与共处，推乐取忧危，","level":0,"quote":true},{"t":"谤恼害其身，犹如受胜德。","level":0,"quote":true},{"t":"为物行勤苦，曾无染著心，","level":0,"quote":true},{"t":"世尊希有德，难以名言说。","level":0,"quote":true},{"t":"尊游崄恶道，马麦及牛锵，","level":0,"quote":true},{"t":"苦行经六年，安受心无退。","level":0,"quote":true},{"t":"尊居最胜位，悲愍化群生，","level":0,"quote":true},{"t":"纵遇轻贱人，身语逾谦敬，","level":0,"quote":true},{"t":"或位尊贵主，曾无憍慢心，","level":0,"quote":true},{"t":"屈己事众生，卑恭如仆使。","level":0,"quote":true},{"t":"机情亿万种，论难百千端，","level":0,"quote":true},{"t":"如来慈善音，一答疑皆断。","level":0,"quote":true},{"t":"恩深过覆载，背德起深怨，","level":0,"quote":true},{"t":"尊观怨极境，犹如极重恩。","level":0,"quote":true},{"t":"怨於尊转害，尊於怨转亲，","level":0,"quote":true},{"t":"彼恒求佛过，佛以彼为恩。","level":0,"quote":true},{"t":"邪宗妬心请，毒饭与火坑，","level":0,"quote":true},{"t":"悲愿化清池，变毒成甘露。","level":0,"quote":true},{"t":"以忍调恚怒，真言销谤毁，","level":0,"quote":true},{"t":"慈力伏魔怨，正智降邪毒。","level":0,"quote":true},{"t":"群迷从旷劫，习恶以性成，","level":0,"quote":true},{"t":"唯尊妙行圆，一念翻令善。","level":0,"quote":true},{"t":"温柔降暴虐，惠施破悭贪，","level":0,"quote":true},{"t":"善语伏麁言，唯尊胜方便。","level":0,"quote":true},{"t":"难提摧巨慢，鸯掘起慈心，","level":0,"quote":true},{"t":"难调能善调，谁不赞希有？","level":0,"quote":true},{"t":"唯尊圣弟子，法味自怡神，","level":0,"quote":true},{"t":"草座以为安，金床非所贵。","level":0,"quote":true},{"t":"善知根欲性，摄化任机缘，","level":0,"quote":true},{"t":"或有待其请，或无问自说。","level":0,"quote":true},{"t":"初陈施戒等，渐次净心生，","level":0,"quote":true},{"t":"后谈真实法，究竟令圆证。","level":0,"quote":true},{"t":"怖畏漂流处，唯佛可归依，","level":0,"quote":true},{"t":"勇猛大悲尊，拯济诸群品。","level":0,"quote":true},{"t":"身云遍法界，法雨洒尘方，","level":0,"quote":true},{"t":"应现各不同，随机故有异。","level":0,"quote":true},{"t":"善净无违诤，唯尊可承奉，","level":0,"quote":true},{"t":"广利诸人天，咸应兴供养。","level":0,"quote":true},{"t":"身口无起作，善化遍群方，","level":0,"quote":true},{"t":"所说妙相应，此德唯尊有。","level":0,"quote":true},{"t":"久修三业净，妙瑞现无边，","level":0,"quote":true},{"t":"普观诸世间，曾无此胜德。","level":0,"quote":true},{"t":"况於极恶者，纯行最上悲，","level":0,"quote":true},{"t":"广利诸众生，勇猛勤精进。","level":0,"quote":true},{"t":"声闻知法者，於尊恒奉事，","level":0,"quote":true},{"t":"设使证涅槃，终名为负债。","level":0,"quote":true},{"t":"彼等诸圣众，为己而修学，","level":0,"quote":true},{"t":"由舍利生心，不名还债者。","level":0,"quote":true},{"t":"无明睡已觉，悲观遍群方，","level":0,"quote":true},{"t":"荷负起翘勤，圣善宜亲近。","level":0,"quote":true},{"t":"魔怨兴恼害，佛力已能除，","level":0,"quote":true},{"t":"无畏功德中，斯但显少分。","level":0,"quote":true},{"t":"悲心化一切，圣意绝希求，","level":0,"quote":true},{"t":"利乐无不施，能事斯皆毕。","level":0,"quote":true},{"t":"如来胜妙法，若或可迁移，","level":0,"quote":true},{"t":"调达与善星，不应投此教。","level":0,"quote":true},{"t":"无始流转中，互为不饶益，","level":0,"quote":true},{"t":"由斯佛出世，开示化众生。","level":0,"quote":true},{"t":"鹿苑度俱隣，坚林化须跋，","level":0,"quote":true},{"t":"此土根缘尽，更无餘债牵。","level":0,"quote":true},{"t":"法轮久已转，觉悟诸群迷，","level":0,"quote":true},{"t":"恒沙受学人，皆能利三有。","level":0,"quote":true},{"t":"以胜金刚定，自碎坚牢身，","level":0,"quote":true},{"t":"不舍於大悲，自化犹分布。","level":0,"quote":true},{"t":"二利行已满，色法两身圆，","level":0,"quote":true},{"t":"救摄一阐提，双林显佛性。","level":0,"quote":true},{"t":"悲心贯三有，色像应群方，","level":0,"quote":true},{"t":"粟粒以分身，尔乃居圆寂。","level":0,"quote":true},{"t":"善哉奇特行，希有功德身，","level":0,"quote":true},{"t":"大觉诸法门，世所未曾有。","level":0,"quote":true},{"t":"流恩遍含识，身语恒寂然，","level":0,"quote":true},{"t":"凡愚背圣恩，於尊兴谤怒。","level":0,"quote":true},{"t":"法聚宝藏真无际，德源福海实难量，","level":0,"quote":true},{"t":"若有众生曾礼尊，礼彼亦名为善礼。","level":0,"quote":true},{"t":"圣德神功无有尽，我今智劣喻微尘，","level":0,"quote":true},{"t":"欲赞如来功德山，望崖怯退由斯止。","level":0,"quote":true},{"t":"无量无数无边境，难思难见难证理，","level":0,"quote":true},{"t":"唯佛圣智独了知，岂是凡愚所能赞。","level":0,"quote":true},{"t":"一毫一相充法界，一行一德遍心源，","level":0,"quote":true},{"t":"清净广大喻芳池，能疗众生烦恼渴。","level":0,"quote":true},{"t":"我赞牟尼功德海，凭斯善业趣菩提，","level":0,"quote":true},{"t":"普愿含生发胜心，永离凡愚虚妄识。","level":0,"quote":true},{"t":"一百五十赞佛颂","level":0}]]