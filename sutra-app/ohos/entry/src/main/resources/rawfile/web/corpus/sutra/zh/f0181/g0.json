[[{"t":"大般<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />波罗蜜多经卷苐一百三十六　初分挍量功德品苐卅五之卅四","level":0},{"t":"尒时天帝<img class=\"gaiji\" src=\"asset://gaiji-CB/18/CB18232.gif\" alt=\"𥼶\" title=\"𥼶\" />白佛言世尊云何名说相似般<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />静虑精进安忍净戒布施波罗蜜多佛言𱞽尸迦<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />善男子善女人䓁说有所得般<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />静虑精进安忍净戒布施波罗蜜多如是名说相似般<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />静虑精进安忍净戒布施波罗蜜多。","level":0},{"t":"时天帝<img class=\"gaiji\" src=\"asset://gaiji-CB/18/CB18232.gif\" alt=\"𥼶\" title=\"𥼶\" />复白佛言世尊云何诸善男子善女人䓁说有所得般<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />波罗蜜多名说相似般<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />波罗蜜多。","level":0},{"t":"复次佛言𱞽尸迦<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />善男子善女人䓁为发无上菩提心者说色　<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />常　<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />无常　<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />乐　<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />苦　<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />我无我　说受相行识　<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />常　<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />无常　<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />乐　<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />苦　<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30132.gif\" alt=\"𠰥\" title=\"𠰥\" />我无我　<img class=\"gaiji\" src=\"as