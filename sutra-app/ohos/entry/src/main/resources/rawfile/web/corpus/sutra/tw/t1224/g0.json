[[{"t":"金剛童子持念經","level":0},{"t":"No. 1224金剛童子持念經","level":0},{"t":"淨三業真言：","level":0,"quote":true},{"t":"「唵<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02122.gif\" alt=\"秫\" title=\"秫\" />弟<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00803.gif\" alt=\"䅶\" title=\"䅶\" />戍馱曩野娑嚩賀」","level":0,"quote":true},{"t":"二羽蓮花合掌，誦前真言七遍，加持身心三","level":0,"quote":true},{"t":"業，妄念諸過悉皆清淨。","level":0,"quote":true},{"t":"次結普禮一切如來印。右膝著地，二羽左覆","level":0,"quote":true},{"t":"右，仰背相著，以二信二惠反相叉安於頂上。","level":0,"quote":true},{"t":"口誦彼真言，身住此儀相，心想自身滿於法","level":0,"quote":true},{"t":"界，二佛菩薩前有己身至誠作禮。真言：","level":0,"quote":true},{"t":"「唵嚩日囉尾多」","level":0,"quote":true},{"t":"如是以三業齊運，禮觀一切聖眾及曼茶羅","level":0,"quote":true},{"t":"本尊像已，即結加趺坐或半加坐，澄定身心，","level":0,"quote":true},{"t":"結佛部三昧耶印。二羽芙蓉合掌，開手如掬","level":0,"quote":true},{"t":"物勢，以二定輔於二念上節文側，二惠捻二","level":0,"quote":true},{"t":"定下第一文即成。即念佛部三昧耶真言：","level":0,"quote":true},{"t":"「唵怛他<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03004.gif\" alt=\"𧃯\" title=\"𧃯\" />姤<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03315.gif\" alt=\"𠺶\" title=\"𠺶\" />婆嚩野娑嚩賀」","level":0,"quote":true},{"t":"以印安於頂上，誦真言三遍，想印如佛形像。","level":0,"quote":true},{"t":"次結蓮花部三昧耶印。二羽如前合掌微開，","level":0,"quote":true},{"t":"中間二進二念二定六指微曲，頭相去各一","level":0,"quote":true},{"t":"寸許，二信二惠各并竪，如開敷蓮花形。誦真","level":0,"quote":true},{"t":"言三遍，舉印安於頂右右耳之上，想如觀自","level":0,"quote":true},{"t":"在菩薩。蓮花三昧耶真言曰：","level":0,"quote":true},{"t":"「唵鉢納謨納婆嚩野娑嚩賀」","level":0,"quote":true},{"t":"次結金剛部三昧耶印。如前遍禮印安於心","level":0,"quote":true},{"t":"上，誦真言三遍，舉印安於頂左左耳之上，想","level":0,"quote":true},{"t":"如金剛藏菩薩。金剛部三昧耶真言曰：","level":0,"quote":true},{"t":"「唵嚩曰嚧納婆嚩野娑嚩賀」","level":0,"quote":true},{"t":"以結護身印。二羽右押左，內相叉直竪，二念","level":0,"quote":true},{"t":"頭相柱，二定微曲於二念背不令相著，如三","level":0,"quote":true},{"t":"股杵形，二惠并竪，掌中押二進二信上即成。","level":0,"quote":true},{"t":"本經中或用根本印亦得，今取蘇悉地經中","level":0,"quote":true},{"t":"通法真言即不<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04219.gif\" alt=\"𫔻\" title=\"𫔻\" />。護身真言：","level":0,"quote":true},{"t":"「唵薩嚩訥瑟吒嚩餉羯囉迦抳矩嚕","level":0,"quote":true},{"t":"馱囉乞灑囉乞灑<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00805.gif\" alt=\"𤚥\" title=\"𤚥\" />娑嚩賀」","level":0,"quote":true},{"t":"由結此印誦前真言，加持自身五處，先印額、","level":0,"quote":true},{"t":"次右肩、左肩、心、喉，是為五處。以真言威力加","level":0,"quote":true},{"t":"持自身，即成被金剛甲冑。","level":0,"quote":true},{"t":"次結辟除諸障繫縛毘那夜迦印。二羽十度","level":0,"quote":true},{"t":"內相叉以，屈二惠入掌甲相背，各捻二念指","level":0,"quote":true},{"t":"面，急握拳。心想毘那夜迦，作障難者皆被五","level":0,"quote":true},{"t":"繫縛之。辟除真言曰：","level":0,"quote":true},{"t":"「唵度曩尾度曩怛羅娑野戍灑野薩嚩","level":0,"quote":true},{"t":"尾曩野迦南吽撥吒娑嚩","level":0,"quote":true},{"t":"賀」","level":0,"quote":true},{"t":"次結被金剛甲冑印，即前印以二定直竪頭","level":0,"quote":true},{"t":"相柱，以二惠各捻二定下第一文即成。以","level":0,"quote":true},{"t":"印如前加持自身五處，遍身自然被金剛鎧","level":0,"quote":true},{"t":"甲，光明赫奕。真言曰：","level":0,"quote":true},{"t":"「唵紇哩迦抳野麼娜賀吽撥吒娑嚩","level":0,"quote":true},{"t":"賀」","level":0,"quote":true},{"t":"次結金剛牆印。即前甲冑印，開二定頭相去","level":0,"quote":true},{"t":"一寸許，開掌如牆形即成。真言曰：","level":0,"quote":true},{"t":"「唵紇哩迦抳諾賀諾賀鉢左鉢左吽撥吒","level":0,"quote":true},{"t":"娑嚩賀」","level":0,"quote":true},{"t":"以印頂上空中右旋三匝，兼誦真言三遍。以","level":0,"quote":true},{"t":"此加持威神力故，周匝四方隨心遠近結成","level":0,"quote":true},{"t":"金剛牆。界界光明照曜，一切諸魔不敢輔","level":0,"quote":true},{"t":"近。","level":0,"quote":true},{"t":"次結迎請聖尊印。二羽內相叉直竪，二定頭","level":0,"quote":true},{"t":"柱，以二惠向身招之。請尊真言曰：","level":0,"quote":true},{"t":"「唵度<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />婆誐鑁迦<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />短嚕馱翳<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03588.gif\" alt=\"𮠴\" title=\"𮠴\" />","level":0,"quote":true},{"t":"呬吽撥吒」","level":0,"quote":true},{"t":"不改此印，便誦後真言，迎請聖尊者眷屬。真","level":0,"quote":true},{"t":"言：","level":0,"quote":true},{"t":"「唵娑跛哩嚩囉麼嚩賀野婆誐鑁","level":0,"quote":true},{"t":"迦<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />矩嚕馱三麼耶麼努娑麼囉娑","level":0,"quote":true},{"t":"嚩賀」","level":0,"quote":true},{"t":"次結都明王忿怒軍吒利印，辟除諸魔，恐隨","level":0,"quote":true},{"t":"聖眾潛隱在其中。以明王威神，搜棟發遣作","level":0,"quote":true},{"t":"障難者，唯留聖者及自眷屬。其印以二信右","level":0,"quote":true},{"t":"押左內相交，以二進雙屈並押二信交上，以","level":0,"quote":true},{"t":"二念直竪頭柱，以二定各微曲於二念背後","level":0,"quote":true},{"t":"不相著如三股金剛杵形，二惠並竪押二進","level":0,"quote":true},{"t":"上即成。隨誦真言，以印空中左旋三匝，辟除","level":0,"quote":true},{"t":"姦魔棟擇發遣。便即右旋三匝，結成金剛光","level":0,"quote":true},{"t":"明堅固大界，一切凡聖不合越此界故。違越","level":0,"quote":true},{"t":"者化三昧耶決定不安，眾聖陰罰違越，眾聖","level":0,"quote":true},{"t":"言誓故也。即誦軍吒利真言曰：","level":0,"quote":true},{"t":"「曩謨囉怛曩怛囉夜野娜莫室戰","level":0,"quote":true},{"t":"嚩日囉播緊曳摩賀藥叉細曩","level":0,"quote":true},{"t":"鉢多曳唵阿密<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00069.gif\" alt=\"㗚\" title=\"㗚\" />多軍<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00997.gif\" alt=\"䋈\" title=\"䋈\" />里却却佉","level":0,"quote":true},{"t":"呬佉呬底瑟咤底瑟姹","level":0,"quote":true},{"t":"滿馱滿馱賀曩賀曩<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03004.gif\" alt=\"𧃯\" title=\"𧃯\" />惹<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03004.gif\" alt=\"𧃯\" title=\"𧃯\" />惹尾颯普吒","level":0,"quote":true},{"t":"野尾颯普吒野薩嚩尾近曩尾曩野","level":0,"quote":true},{"t":"迦摩賀誐<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00997.gif\" alt=\"䋈\" title=\"䋈\" />鉢底爾尾<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04132.gif\" alt=\"𮧊\" title=\"𮧊\" />得迦囉","level":0,"quote":true},{"t":"野吽撥吒」","level":0,"quote":true},{"t":"便結上方金剛網印。即前牆印，以二惠開散","level":0,"quote":true},{"t":"直竪即成。以印頂上右旋三匝，誦真言三遍，","level":0,"quote":true},{"t":"即成金剛網遍覆其上。真言曰：","level":0,"quote":true},{"t":"「唵嚩日囉半惹囉吽撥吒」","level":0,"quote":true},{"t":"次獻閼伽香水浴聖尊印。用前迎請印，以二","level":0,"quote":true},{"t":"惠各捻二定根下第一文，以印當心平舒如","level":0,"quote":true},{"t":"羸盃形，舉印當額奉獻。若有香水器，即以此","level":0,"quote":true},{"t":"印按之，加持三遍或一遍，然後捧而獻之。真","level":0,"quote":true},{"t":"言曰：","level":0,"quote":true},{"t":"「唵嚩曰嚕娜迦吽」","level":0,"quote":true},{"t":"次結寶山印。以獨股杵印，<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04238.gif\" alt=\"𮙏\" title=\"𮙏\" />上節令平如上","level":0,"quote":true},{"t":"頂形，以二惠並竪押掌中諸度上即成。誦寶","level":0,"quote":true},{"t":"山真言曰：","level":0,"quote":true},{"t":"「唵阿左羅吽」","level":0,"quote":true},{"t":"次獻蓮花座印。即以前閼伽印，二惠頭向外","level":0,"quote":true},{"t":"開竪相去半寸許如蓮花形。真言曰：","level":0,"quote":true},{"t":"「唵嚩日羅尾囉野娑嚩賀」","level":0,"quote":true},{"t":"次獻五供養，先結塗香印。即前獨股杵印，以","level":0,"quote":true},{"t":"二惠微屈捻二定下第一文，相去一寸許即","level":0,"quote":true},{"t":"成。塗香真言曰：","level":0,"quote":true},{"t":"「唵迦抳矩嚕馱　薩嚩薩怛嚩婆孕","level":0,"quote":true},{"t":"迦囉囉乞灑囉乞灑　薩嚩彥<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04252.gif\" alt=\"𮣺\" title=\"𮣺\" />","level":0,"quote":true},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />娑嚩賀」","level":0,"quote":true},{"t":"次結獻花印。即前獨股杵印，出右惠即成。誦","level":0,"quote":true},{"t":"獻花真言曰：","level":0,"quote":true},{"t":"「唵迦抳補澁波母納婆嚩吽」","level":0,"quote":true},{"t":"次結燒香印。即前獨股印，出左惠即成。誦燒","level":0,"quote":true},{"t":"香真言曰：","level":0,"quote":true},{"t":"「唵迦抳矩嚕馱塢<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03442.gif\" alt=\"𮓌\" title=\"𮓌\" />囉能瑟吒嚕","level":0,"quote":true},{"t":"得羯吒佩囉嚩仡哩恨拏仡","level":0,"quote":true},{"t":"哩恨拏度奔娑嚩賀」","level":0,"quote":true},{"t":"次結獻食印。準前獨<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01263.gif\" alt=\"𦙶\" title=\"𦙶\" />杵印，出二惠及二信","level":0,"quote":true},{"t":"頭相柱，餘四度內相叉作拳即成。真言曰：","level":0,"quote":true},{"t":"「唵迦抳吽吽娑嚩賀」","level":0,"quote":true},{"t":"次結燈明印。即前獨股杵印，二惠向身並竪","level":0,"quote":true},{"t":"即成。誦燈明真言曰：","level":0,"quote":true},{"t":"「唵迦抳儞波儞簸野吽撥吒娑嚩","level":0,"quote":true},{"t":"賀」","level":0,"quote":true},{"t":"次結普供養印。二手合掌右押左叉交上一","level":0,"quote":true},{"t":"節即是。想從此印流出種種供養雲海，化成","level":0,"quote":true},{"t":"七寶宮殿樓閣、衣服飲食、上好天樂充滿法","level":0,"quote":true},{"t":"界，供養一切聖眾。今略舉一二，若廣說者一","level":0,"quote":true},{"t":"如《花嚴經》中所說供養。即誦是供真言三遍","level":0,"quote":true},{"t":"或七遍。真言曰：","level":0,"quote":true},{"t":"「唵阿謨伽麼抳鉢納麼入嚩羅鉢","level":0,"quote":true},{"t":"囉<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02594.gif\" alt=\"𮧬\" title=\"𮧬\" />多耶吽」","level":0,"quote":true},{"t":"暨如上諸供養已，以右手輪擲金剛杵，誦本","level":0,"quote":true},{"t":"真言，於眾聖前心想如對至尊，作踏舞之勢，","level":0,"quote":true},{"t":"倣像金剛薩埵於如來前擲弄其杵，因便加","level":0,"quote":true},{"t":"持自身五處。左手執取金剛鈴，於額前三度","level":0,"quote":true},{"t":"搖振，表以天樂音聲供養聖眾令其悅喜。亦","level":0,"quote":true},{"t":"誦本真言，心住薩埵妙三昧地。","level":0,"quote":true},{"t":"修行者又慮恐承事供養之中或有忘誤疎、","level":0,"quote":true},{"t":"遺犯三昧耶禁，或有多生宿業罪障由未消","level":0,"quote":true},{"t":"除，誦金剛部百字真言以補前潛滅除諸","level":0,"quote":true},{"t":"過，得身心清淨與法相應。百字真言曰：","level":0,"quote":true},{"t":"「唵嚩日囉薩多嚩　三摩野麼","level":0,"quote":true},{"t":"播攞野　嚩日囉薩多嚩　怛<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01511.gif\" alt=\"㕹\" title=\"㕹\" />","level":0,"quote":true},{"t":"努跛底瑟姹　揑哩濯銘婆","level":0,"quote":true},{"t":"嚩　素姤數銘婆嚩　阿努囉訖姤","level":0,"quote":true},{"t":"銘娑嚩　素布數銘婆嚩　薩嚩悉","level":0,"quote":true},{"t":"地淫銘鉢囉曳蹉　薩嚩羯磨素","level":0,"quote":true},{"t":"左銘　郎多室哩藥矩嚕　吽　賀賀","level":0,"quote":true},{"t":"賀賀斛　娑誐鑁薩嚩怛他<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03442.gif\" alt=\"𮓌\" title=\"𮓌\" />多　嚩","level":0,"quote":true},{"t":"日囉麼<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02755.gif\" alt=\"𭤶\" title=\"𭤶\" />悶左　嚩曰哩婆","level":0,"quote":true},{"t":"嚩　摩賀三麼耶薩多嚩惡」","level":0,"quote":true},{"t":"其印二手右押左外相叉作拳，直竪二中指","level":0,"quote":true},{"t":"相合，此名三昧耶印。由結此印加身四處，心、","level":0,"quote":true},{"t":"額、喉、頂，及誦百字真言，能除無始已來一切","level":0,"quote":true},{"t":"重罪，破四重禁、五無間業罪、謗方等經如是","level":0,"quote":true},{"t":"等罪悉皆消滅，何況誤失小過而不清淨。即","level":0,"quote":true},{"t":"結本尊印。二手合掌，以二無名左安前居下、","level":0,"quote":true},{"t":"右安後居上押左名指背，交指於二中指背","level":0,"quote":true},{"t":"後，以二頭指各鉤取二名指頭，二中指並竪","level":0,"quote":true},{"t":"合，二大指亦並竪捻二中指中節，二小指合","level":0,"quote":true},{"t":"竪即成。誦根本真言，以印加身四處。真言","level":0,"quote":true},{"t":"曰：","level":0,"quote":true},{"t":"「曩謨囉怛曩　怛野野曩莫室戰","level":0,"quote":true},{"t":"拏嚩日囉播拏曳摩賀藥叉細","level":0,"quote":true},{"t":"曩鉢多曳怛儞也他唵加抳度<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />吽","level":0,"quote":true},{"t":"撥吒娑嚩賀」","level":0,"quote":true},{"t":"又結第二根本印。即前最初護身印，是亦名","level":0,"quote":true},{"t":"獨股杵印，此與多羅菩薩印同。第二根本真","level":0,"quote":true},{"t":"言曰：","level":0,"quote":true},{"t":"「曩謨囉怛曩夜野娜莫室戰拏嚩","level":0,"quote":true},{"t":"日囉播拏曳摩賀藥叉細曩鉢","level":0,"quote":true},{"t":"多曳怛他也他唵度曩尾度曩迦抳","level":0,"quote":true},{"t":"矩嚕馱薩嚩演怛囉抳吽」","level":0,"quote":true},{"t":"次結頭印。即前獨股杵印，以二大指各鉤二","level":0,"quote":true},{"t":"無名指頭，於掌中捻其上節內即成。真言","level":0,"quote":true},{"t":"曰：","level":0,"quote":true},{"t":"「唵吽吽麼麼撥吒」","level":0,"quote":true},{"t":"次結頂印。即前獨股杵印，以二大指直竪相","level":0,"quote":true},{"t":"柱即成。真言曰：","level":0,"quote":true},{"t":"「唵紇哩　戰拏迦抳　諾賀鉢左　吽撥","level":0,"quote":true},{"t":"吒娑嚩賀」","level":0,"quote":true},{"t":"次結心印。即前根本印，安於心上，以心真言","level":0,"quote":true},{"t":"加持一遍。真言曰：","level":0,"quote":true},{"t":"「唵迦<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />吽撥吒」","level":0,"quote":true},{"t":"次捧念珠當心，以隨心真言加持七遍。真言","level":0,"quote":true},{"t":"曰：","level":0,"quote":true},{"t":"「唵迦抳度麼吽撥吒」","level":0,"quote":true},{"t":"二手當心持珠念誦，身端正坐儼然苦思，心","level":0,"quote":true},{"t":"住本尊威德妙觀，即與畫像如鏡照形，不一","level":0,"quote":true},{"t":"不異、淨無瑕穢。外想威光，心住慈悲妙觀，","level":0,"quote":true},{"t":"愍念六道諸類四生輪迴不息，我今發猛利","level":0,"quote":true},{"t":"勇信之心，至誠誦念神妙章句，心住本尊瑜","level":0,"quote":true},{"t":"伽觀智。今我身心既得清淨，迴此功德神力","level":0,"quote":true},{"t":"加被遍用法界，普濟有情。蒙此加持，皆如我","level":0,"quote":true},{"t":"身外。若依本經，更有十五餘道真言及以印","level":0,"quote":true},{"t":"契，總合誦習令便精熟，待至事相應時棟取","level":0,"quote":true},{"t":"用之，以備臨事急難補其不足，亦非常用。具","level":0,"quote":true},{"t":"在大經中說，此不重敘。臨事若要，自撿取用","level":0,"quote":true}],[{"t":"之。","level":0,"quote":true},{"t":"大忿怒金剛童子念誦供養儀軌","level":0,"quote":true},{"t":"曆應三年七月之比，借他筆寫之，為令法久","level":0,"quote":true},{"t":"住也。","level":0,"quote":true},{"t":"一交了悉地金剛經嚴","level":0,"quote":true},{"t":"校注日日日日日日日日日大正藏 校注新增校注","level":0,"quote":true}]]