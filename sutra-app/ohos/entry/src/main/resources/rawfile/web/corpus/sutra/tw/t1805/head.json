{"id":"t1805","title":"四分律行事鈔資持記","titleTrad":"四分律行事鈔資持記","byline":"大宋餘杭沙門釋元照撰","bylineLabel":"著者·译者","dynasty":"","division":"律疏部","canon":"T1805","canonName":"大正藏","volume":"T1805","juanCount":3,"textLength":502087,"imageCount":0,"summary":"","tags":["律疏部","大正藏"],"order":1926,"guide":"","chunks":10,"toc":[{"level":2,"text":"約諸篇細分諸事。上卷十二"},{"level":2,"text":"事下卷十四"},{"level":3,"text":"根源，正教詮宗骨。反光九代，斯言不虛。故序"},{"level":3,"text":"餘絲可理；學者觀序，則諸篇可求，此謂由序"},{"level":2,"text":"別眾食等。下卷二"},{"level":3,"text":"人通作一切。又須精簡足數別眾，即人有序"},{"level":3,"text":"知通後也。三中。此出《僧祇》。未說序"},{"level":2,"text":"上下諸篇，皆宗羯磨；此卷四"},{"level":2,"text":"一切諸戒。若通今鈔，即是三卷三"}],"chunksPerFile":20}