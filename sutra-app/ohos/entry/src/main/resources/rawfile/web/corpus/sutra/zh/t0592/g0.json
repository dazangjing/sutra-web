[[{"t":"天请问经","level":0},{"t":"大唐三藏法师玄奘奉　诏译","level":0},{"t":"如是我闻：","level":0},{"t":"一时薄伽梵在室罗筏国，住誓多林给孤独园。时有一天，颜容殊妙，过於夜分，来诣佛所，顶礼佛足，却住一面。是天威光，甚大赫奕，周遍照曜誓多园林。","level":0},{"t":"尔时彼天以妙伽他而请佛曰：","level":0},{"t":"「云何利刀剑？云何碜毒药？","level":0,"quote":true},{"t":"云何炽盛火？云何极重暗？」","level":0,"quote":true},{"t":"尔时世尊亦以伽他告彼天曰：","level":0},{"t":"「麁言利刀剑，贪欲碜毒药，","level":0,"quote":true},{"t":"瞋恚炽盛火，无明极重暗。」","level":0,"quote":true},{"t":"天复请曰：","level":0},{"t":"「何人名得利？何人名失利？","level":0,"quote":true},{"t":"何者坚钾胄？何者利刀杖？」","level":0,"quote":true},{"t":"世尊告曰：","level":0},{"t":"「施者名得利，受者名失利，","level":0,"quote":true},{"t":"忍为坚钾胄，慧为利刀杖。」","level":0,"quote":true},{"t":"天复请曰：","level":0},{"t":"「云何为盗贼？云何智者财？","level":0,"quote":true},{"t":"谁於天世间，说名能劫盗？」","level":0,"quote":true},{"t":"世尊告曰：","level":0},{"t":"「邪思为盗贼，尸罗智者财，","level":0,"quote":true},{"t":"於诸天世间，犯戒能劫盗。」","level":0,"quote":true},{"t":"天复请曰：","level":0},{"t":"「谁为最安乐？谁为大富贵？","level":0,"quote":true},{"t":"谁为恒端严？谁为常丑陋？」","level":0,"quote":true},{"t":"世尊告曰：","level":0},{"t":"「少欲最安乐，知足大富贵，","level":0,"quote":true},{"t":"持戒恒端严，破戒常丑陋。」","level":0,"quote":true},{"t":"天复请曰：","level":0},{"t":"「谁为善眷属？谁为恶心怨？","level":0,"quote":true},{"t":"云何极重苦？云何第一乐？」","level":0,"quote":true},{"t":"世尊告曰：","level":0},{"t":"「福为善眷属，罪为恶心怨，","level":0,"quote":true},{"t":"地狱极重苦，无生第一乐。」","level":0,"quote":true},{"t":"天复请曰：","level":0},{"t":"「何者爱非宜？何者宜非爱？","level":0,"quote":true},{"t":"何者极热病？谁是大良医？」","level":0,"quote":true},{"t":"世尊告曰：","level":0},{"t":"「诸欲爱非宜，解脱宜非爱，","level":0,"quote":true},{"t":"贪为极热病，佛是大良医。」","level":0,"quote":true},{"t":"天复请曰：","level":0},{"t":"「谁能覆世间？世间谁所魅？","level":0,"quote":true},{"t":"谁令舍亲友？谁复障生天？」","level":0,"quote":true},{"t":"世尊告曰：","level":0},{"t":"「无智覆世间，世间痴所魅，","level":0,"quote":true},{"t":"悭贪舍亲友，染著障生天。」","level":0,"quote":true},{"t":"天复请曰：","level":0},{"t":"「何物火不烧，风亦不能碎，","level":0,"quote":true},{"t":"非水所能烂，能浮持世间？","level":0,"quote":true},{"t":"谁能与王贼，勇猛相抗敌，","level":0,"quote":true},{"t":"不为人非人，之所来侵夺？」","level":0,"quote":true},{"t":"世尊告曰：","level":0},{"t":"「福非火所烧，风亦不能碎，","level":0,"quote":true},{"t":"福非水所烂，能浮持世间。","level":0,"quote":true},{"t":"福能与王贼，勇猛相抗敌，","level":0,"quote":true},{"t":"不为人非人，之所来侵夺。」","level":0,"quote":true},{"t":"天复请曰：","level":0},{"t":"「我今犹有疑，请佛为除断。","level":0,"quote":true},{"t":"今世往后世，谁极自欺诳？」","level":0,"quote":true},{"t":"世尊告曰：","level":0},{"t":"「若多有珍财，而不能修福，","level":0,"quote":true},{"t":"今世往后世，彼极自欺诳。」","level":0,"quote":true},{"t":"尔时彼天闻佛世尊说是经已，欢喜踊跃，叹未曾有，顶礼佛足，即於佛前欻然不现。","level":0},{"t":"天请问经","level":0}]]