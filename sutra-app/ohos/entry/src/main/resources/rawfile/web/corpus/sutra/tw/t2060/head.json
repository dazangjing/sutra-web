{"id":"t2060","title":"續高僧傳","titleTrad":"續高僧傳","byline":"大唐西明寺沙門釋道宣撰","bylineLabel":"著者·译者","dynasty":"","division":"史传部","canon":"T2060","canonName":"大正藏","volume":"T2060","juanCount":30,"textLength":473845,"imageCount":0,"summary":"","tags":["史传部","大正藏"],"order":2813,"guide":"","chunks":10,"toc":[{"level":3,"text":"續高僧傳序"},{"level":3,"text":"聞。有勅賜帛百匹衣服一具。賾又著論序"},{"level":3,"text":"稱序品第一。未審序第何分。淨曰。如來入"},{"level":3,"text":"盛氣接成陰。皇太子述上所作三藏聖教序"},{"level":3,"text":"義精悉。四眾推服。聽者八百餘人。陳心序"},{"level":3,"text":"嚴設都無畏憚。直入講會人不敢遮。揉序"},{"level":3,"text":"置十大德用清朝寄。時大集僧眾標名序"},{"level":3,"text":"見期。二生在邊表長逢離亂。身闇庠序"},{"level":3,"text":"樹白塔。勒銘誌之。行路望者知便下淚。序"}],"chunksPerFile":20}