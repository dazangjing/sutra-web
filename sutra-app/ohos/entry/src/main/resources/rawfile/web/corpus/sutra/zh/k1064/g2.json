[[{"t":"经卷第四十","level":2},{"t":"十定品之一","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />伽慧","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />伽此云龙也)。","level":0},{"t":"而竟不覩","level":0},{"t":"(郑牋诗曰竟终也覩见也)。","level":0},{"t":"南无","level":0},{"t":"(正云萳忙此曰敬礼)。","level":0},{"t":"摩纳婆","level":0},{"t":"(此云儒童也)。","level":0},{"t":"新译大方广佛华严经音义卷上","level":0},{"t":"甲辰岁高丽国大藏都监奉<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30072.gif\" alt=\"𠡠\" title=\"𠡠\" />雕造","level":0},{"t":"新译大方广佛花严经音义卷下","level":0},{"t":"京兆静法寺沙门慧<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10349.gif\" alt=\"𮏑\" title=\"𮏑\" />述","level":0}],[{"t":"经卷第四十一","level":2},{"t":"十定品之二","level":0},{"t":"不处於陆","level":0},{"t":"(毛诗传曰高厚广平曰陆)。","level":0},{"t":"近之","level":0},{"t":"(近渠靳反就也)。","level":0},{"t":"诸心乐次第","level":0},{"t":"(乐牙教反谓欲乐也)。","level":0},{"t":"歌罗逻","level":0},{"t":"(此云薄酪谓初入胎如薄酪也)。","level":0},{"t":"白分义","level":0},{"t":"(分浮问反)。","level":0},{"t":"圆光一寻","level":0},{"t":"(何<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09109.gif\" alt=\"𠇲\" title=\"𠇲\" />[莫/糸]要云八寸曰咫三尺曰武五尺曰墨六尺曰步七尺曰承八尺曰寻十尺曰丈丈六曰常小雅曰四尺曰仞倍仞曰寻倍寻曰常)。","level":0},{"t":"其量七肘","level":0},{"t":"(佛本行集云肘谓二尺也)。","level":0},{"t":"一俱卢舍","level":0},{"t":"(依毗昙中一尺五寸为一肘四肘为一弓三百弓为一里四里为一俱卢合准计一里三百六十步则一俱卢舍有一千四百四十步也依俱舍论苐十二云分扸诸色至一极微故一极微为色七极微为一微量积微至七为一金尘七金尘为一水尘量水积七为一兔毛尘积七兔毛尘为一羊毛尘量积羊毛尘七为一牛毛尘积七牛毛尘为隟游尘量隟尘七为一虮七虮为一虱七虱为穬麦七麦为一指节二十四指撗布为肘竖四肘为弓竖积五百弓为一俱卢舍即是从肘至阿练若中间量者也)。","level":0},{"t":"半由旬量","level":0},{"t":"(由旬梵言具云逾缮<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />此曰和合谓以多俱卢舍和合成故案佛本行集苐十二云七微尘成一<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08729.gif\" alt=\"䆫\" title=\"䆫\" />牖尘七<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08729.gif\" alt=\"䆫\" title=\"䆫\" />尘成一兔毛头尘七兔毛尘成一羊毛头尘七羊毛成一牛毛头尘七牛毛尘成一虮七虮成一虱七虱成一芥子七芥子成一大麦七大麦成一指节七指节成半尺二尺成一肘四肘成一弓五弓成一杖二十杖名一息八十息名一俱卢舍八俱卢舍成一由旬准此方尺量二里餘八十步当一俱卢舍计一由旬合有一十七里餘二百八十步或曰一由旬如此方一驿地也)。","level":0}],[{"t":"经卷第四十二","level":2},{"t":"十定品之三","level":0},{"t":"北俱卢","level":0},{"t":"(具云<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17632.gif\" alt=\"𬅕\" title=\"𬅕\" />怛罗句卢此翻为高上也)。","level":0},{"t":"东毗提诃","level":0},{"t":"(毗此云胜提诃曰身也又毗云种种提诃与也)。","level":0},{"t":"种种稼穑","level":0},{"t":"(稼音稼穑音色马融注论语曰树五谷曰稼毛诗传曰种之曰稼<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00866.gif\" alt=\"𣫍\" title=\"𣫍\" />之曰穑案郑玄注周礼云稼穑为言其犹嫁穑谓种子相生贪苗实之利也)。","level":0},{"t":"修罗退衂","level":0},{"t":"(衂女六如育二反玉篇云衂折挫也)。","level":0},{"t":"入藕丝孔","level":0},{"t":"(藕五苟反字冝从耒)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00371.gif\" alt=\"𠃵\" title=\"𠃵\" />闼婆城","level":0},{"t":"(此云寻香城也谓十宝山间有音乐神名<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00371.gif\" alt=\"𠃵\" title=\"𠃵\" />闼婆忉利诸天湏音乐时此神身有异相即知天意徃彼娱乐因此以事西域谓诸乐儿亦曰<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00371.gif\" alt=\"𠃵\" title=\"𠃵\" />闼婆然西域乐儿多为幻伎幻作城郭湏[更-一]如故因即谓龙所现城郭为<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00371.gif\" alt=\"𠃵\" title=\"𠃵\" />闼婆城也忽有忽无自在传变也谓辝诸法之性无有之间自在亦复如是)。","level":0},{"t":"恒伽河","level":0},{"t":"(准经香山顶上有阿耨达池其池四面各流出一河东面私陁河从金刚师子口流出其沙金刚东流入震旦国便入东海南面恒伽河从银象口流出其沙白银流入东印度便入南海西面信度河从金牛口流出其沙黄金便入西海北面缚𫇴河从琉璃马口流出其沙是琉璃流入波斯佛林便入北海其池纵广五十由旬四面口各一由旬也)。","level":0},{"t":"光明鉴彻","level":0},{"t":"(鉴照也彻通也言光照内外通现也)。","level":0},{"t":"澒涌奔驰","level":0},{"t":"(澒胡动反涌字正冝作溶故楚辞注云澒溶水大<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15032.gif\" alt=\"㒵\" title=\"㒵\" />汉书高纪传集注云澒溶竦溶也经本作涌者误也)。","level":0},{"t":"奇香发越","level":0},{"t":"(汉书集注曰发起香气射散也谓香气速疾遍布著人也)。","level":0},{"t":"皆得润洽","level":0},{"t":"(洽侠夹反广雅曰洽渎也)。","level":0},{"t":"阿[邱-丘+(白-日+(丹-、+十))]婆达多龙王","level":0},{"t":"(阿无也[邱-丘+(白-日+(丹-、+十))]婆达多热<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08974.gif\" alt=\"𢙉\" title=\"𢙉\" />也诸龙皆受热沙之苦此龙无故立其名耳)。","level":0}],[{"t":"经卷第四十三","level":2},{"t":"十定品之四","level":0},{"t":"无替","level":0},{"t":"([迄-乙+小]疋曰替废也)。","level":0},{"t":"从诸善友而得出生","level":0},{"t":"(友字经本有作支字深为[謵-白+尒]也)。","level":0},{"t":"终不匮止","level":0},{"t":"(匮渠位反广雅匮少也汉书音义曰匮空乏也)。","level":0},{"t":"摩[邱-丘+(白-日+(丹-、+十))]斯龙王","level":0},{"t":"(摩[邱-丘+(白-日+(丹-、+十))]意也斯夜也流出也言此龙王凢兴云雨皆从慈心出也)。","level":0},{"t":"嶷然高出","level":0},{"t":"(嶷谓崱嶷也字指曰崱嶷山峰<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15032.gif\" alt=\"㒵\" title=\"㒵\" />也)。","level":0},{"t":"伊<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />钵<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />象王住金胁山","level":0},{"t":"(伊<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />钵<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />此云香[葉-世+ㄊ]其象身长九由旬高三由旬常住苐一金山之胁即是<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />初计都末底山也)。","level":0}],[{"t":"经卷第四十四","level":2},{"t":"十通品","level":0},{"t":"阎魔王","level":0},{"t":"(正云琰魔逻阎此曰遮止谓诫勗罪人之也)。","level":0},{"t":"十忍品","level":0},{"t":"舍支","level":0},{"t":"(正云设施谓月之别名帝释夫人取为号也)。","level":0},{"t":"无方无隅","level":0},{"t":"(方谓四方也郑玄注考工记曰隅角也)。","level":0},{"t":"不舍众善轭","level":0},{"t":"(轭於革反珠丛曰轭谓辕端撗木也今此谓驾担众善勒行不舍如牛驾重长途力进也)。","level":0},{"t":"徒令","level":0},{"t":"(刘熙曰徒犹独也)。","level":0}],[{"t":"经卷第四十五","level":2},{"t":"阿僧祇品","level":0},{"t":"一百洛叉为一俱<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10325.gif\" alt=\"𦙘\" title=\"𦙘\" />","level":0},{"t":"(洛叉此云[一/力]也俱<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10325.gif\" alt=\"𦙘\" title=\"𦙘\" />此云亿也又按此方黄帝<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06358.gif\" alt=\"𥫫\" title=\"𥫫\" />法惣有二十三数谓一二三四五六七八九十百千[一/力]亿兆京垓<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02424.gif\" alt=\"𥞑\" title=\"𥞑\" />壤沟<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00589.gif\" alt=\"㵎\" title=\"㵎\" />正载从万已去有三等数法其下者十十变之中者百百变之上者倍倍变之今此阿僧祇中上数法故云一百洛叉为一俱<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10325.gif\" alt=\"𦙘\" title=\"𦙘\" />俱<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10325.gif\" alt=\"𦙘\" title=\"𦙘\" />当此亿也阿<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12777.gif\" alt=\"𢈔\" title=\"𢈔\" />多兆也<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />由他京也餘皆依次准配可知今案此经十百千万十十变之从万至亿百倍变之从亿已去皆以能数量为一数复数至与能数量等变之能佛本行集苐十二中百百变之也)。","level":0},{"t":"矜羯","level":0},{"t":"(矜居凌反)。","level":0},{"t":"摩婆","level":0},{"t":"(婆之上声此后婆字并上声呼之)。","level":0},{"t":"[弓*(乞-乙+小)]伽","level":0},{"t":"(伽之上声下毗伽亦同此)。","level":0},{"t":"攞","level":0},{"t":"(郎我反)。","level":0},{"t":"毗佉担","level":0},{"t":"(担多甘反)。","level":0},{"t":"[醫-酉+王]攞陁","level":0},{"t":"(瑿於奚反)。","level":0},{"t":"阿麼","level":0},{"t":"(麼莫我反)。","level":0},{"t":"勃","level":0},{"t":"(蒲没反)。","level":0},{"t":"翳","level":0},{"t":"(烟计反)。","level":0},{"t":"薜","level":0},{"t":"(蒲计反)。","level":0},{"t":"窣","level":0},{"t":"(苏没反)。","level":0},{"t":"睥","level":0},{"t":"(普计反)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12695.gif\" alt=\"䛧\" title=\"䛧\" />","level":0},{"t":"(莫计反)。","level":0},{"t":"荼","level":0},{"t":"(宅加反)。","level":0},{"t":"寿量品","level":0},{"t":"娑婆","level":0},{"t":"(此云堪忍也谓具足众<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />境对堪行忍也)。","level":0},{"t":"释迦牟尼","level":0},{"t":"(释迦能也种族望称也释音作铄呼迦字作告俄反呼牟尼此云寂嘿也德行之号)。","level":0},{"t":"阿[弓*(乞-乙+小)]陁佛","level":0},{"t":"(正云阿弭陁婆耶此云无量寿也)。","level":0},{"t":"诸菩萨住处品","level":0},{"t":"支提山","level":0},{"t":"(支提本是塔庿之名此山似之故因为号然支提此云生净信之所具释如下七十五中)。","level":0},{"t":"毗舍离","level":0},{"t":"(此释为广愽谓此城於中印度诸城之中<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />广大也或亦翻为广严也)。","level":0},{"t":"度度罗城","level":0},{"t":"(或云摩偷罗亦云摩突罗此云孔雀城或云蜜善皆古事者也)。","level":0},{"t":"俱[玝-十+小]<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />城","level":0},{"t":"(或言俱陈<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />耶言俱陈者是名此云大盆<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />耶法律也昔此城未立之时有一五通仙名俱陈而於此地置一大盆畜水若池恒在盆侧修仙法律亦常为人说护净经及养性法於后学徒皆以师名及法为其姓氏人众渐广即於此处建立城郭故此举国人今皆姓俱陈<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />城亦因之立号耳)。","level":0},{"t":"目真隣陁窟","level":0},{"t":"(目真或曰牟真此云解脱是龙名也隣陁此云处也谓有龙於此窟中闻法脱龙苦故名解脱处窟也)。","level":0},{"t":"摩兰陁国","level":0},{"t":"(未翻)。","level":0},{"t":"甘菩遮国","level":0},{"t":"(未翻)。","level":0},{"t":"震旦国","level":0},{"t":"(或曰支<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />亦曰真丹此翻为思惟以其国人多所思虑多所计作故以为名即今此汉国是也)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />罗延","level":0},{"t":"(此云坚固)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00562.gif\" alt=\"䟽\" title=\"䟽\" />勒国","level":0},{"t":"(正名佚路数恒勒古来此方存略呼为<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00562.gif\" alt=\"䟽\" title=\"䟽\" />勒又讹数音为<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00562.gif\" alt=\"䟽\" title=\"䟽\" />然此名乃是彼国一山之号因云其称又或翻为<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />性国以其国人性多犷戾故也)。","level":0},{"t":"迦叶[弓*(乞-乙+小)]罗国","level":0},{"t":"(旧名<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00868.gif\" alt=\"𦋺\" title=\"𦋺\" />[實-毌+尸]国此翻阿谁入昔此国未建之时其地有大龙池人莫敢近其后有一罗汉见其形胜冝人居止乃从龙<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00855.gif\" alt=\"𠧒\" title=\"𠧒\" />容一膝地时龙许之而罗汉变身渐大其膝渐满龙池龙以言信便舍而去罗汉即以神力<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00371.gif\" alt=\"𠃵\" title=\"𠃵\" />竭其水令百姓於中建立屋宅人众咸云我等不因圣僧阿谁得入此处故从此语即立其名国即在北印度境<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00371.gif\" alt=\"𠃵\" title=\"𠃵\" />陁罗国次北隣也)。","level":0},{"t":"庵浮梨摩国","level":0},{"t":"(庵谓庵罗此云无垢即西域果名其果堪以疗疾诸国之中此国<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />多故以名焉其国即在中印度境内也)。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00371.gif\" alt=\"𠃵\" title=\"𠃵\" />陁罗国","level":0},{"t":"(此云持地国谓昔此国多有道果圣贤任住持其境不为他国侵<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10329.gif\" alt=\"𡧱\" title=\"𡧱\" />也又云<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00371.gif\" alt=\"𠃵\" title=\"𠃵\" />陁是香罗谓陁罗此云遍也言遍此国内多生香气之花故名香遍国其国在中印度比北印度南二界中闲也)。","level":0},{"t":"苫婆罗窟","level":0},{"t":"(苫式占反苫婆是香花树名其窟侧近多生此树故因名耳也)。","level":0}],[{"t":"经卷第四十六","level":2},{"t":"佛不思议法品之上","level":0},{"t":"寂漠无言","level":0},{"t":"(玉篇曰无人声曰寂郭璞注[迄-乙+小]疋曰漠谓静定也)。","level":0},{"t":"逮十力地","level":0},{"t":"(逮唐槩反说文曰逮及也字从辶不从廴)。","level":0},{"t":"讥谤","level":0},{"t":"(讥居疑反说文讥诽也)。","level":0}],[{"t":"经卷第四十七","level":2},{"t":"佛不思议法品之下","level":0},{"t":"人王都邑","level":0},{"t":"(左氏传曰凢有宗庿先君之主曰都无曰邑也汉书音义曰都城也广疋曰都国也司马法曰大国五百里为都风俗通曰天子所居之城曰都旧都曰邑也)。","level":0},{"t":"毗舍阇王","level":0},{"t":"(毗舍阇之王即是东方提头頼咤此云持国谓护持国土领二部鬼一名毗舍阇此云噉精气二名<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00371.gif\" alt=\"𠃵\" title=\"𠃵\" />闼婆此曰寻香也)。","level":0},{"t":"倮","level":0},{"t":"(胡寡力果二反玉篇曰倮祖也字又作躶裸两躰)。","level":0},{"t":"一切乐噐不鼓自鸣","level":0},{"t":"(鼓字冝从支支音普木普角二反经本有从皮者鍾鼓字也)。","level":0},{"t":"舍利","level":0},{"t":"(正云设利罗或云实利此翻为身)。","level":0},{"t":"诚敬","level":0},{"t":"(尓雅曰诚信也)。","level":0},{"t":"靡不惊慑","level":0},{"t":"(慑之叶反郑注礼记曰慑怯也畏惧也经本有作摄字者谬也)。","level":0},{"t":"信乐不回","level":0},{"t":"(回音回说文曰回转也今此谓信乐无转动也)。","level":0}],[{"t":"经卷第四十八","level":2},{"t":"如来十身相海品","level":0},{"t":"凞怡微笑","level":0},{"t":"(凞许基反怡与脂反方言湘润之闲谓喜曰凞怡或曰纷怡说文曰凞恱也怡和也谓容<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15032.gif\" alt=\"㒵\" title=\"㒵\" />和恱也熙字又作凞也)。","level":0},{"t":"炳然显现","level":0},{"t":"(炳彼永反苍颉篇曰炳著明也谓显著之明也字又作炳也)。","level":0},{"t":"洞彻","level":0},{"t":"(洞徒弄反玉篇曰洞犹通彻也字又作洞者也)。","level":0},{"t":"其掌安平","level":0},{"t":"(掌谓舌面平而且安)。","level":0},{"t":"玩味不忘","level":0},{"t":"(玩字正冝作忨杜注左传曰忨贪也经本作玩字者误也案孔安注书云戏弄贪忨即受乐之意也)。","level":0},{"t":"上咢","level":0},{"t":"(俄各反正躰作<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07635.gif\" alt=\"㖾\" title=\"㖾\" />又或作腭)。","level":0},{"t":"右辅下牙","level":0},{"t":"(左传宫支奇虢虞之表也犹辅车相依唇亡齿寒杜注曰辅颊也车牙车也又注曰辅类车骨)。","level":0},{"t":"[弓*(乞-乙+小)]卢藏云","level":0},{"t":"([弓*(乞-乙+小)]卢此云高以在仏上牙故也)。","level":0},{"t":"绀蒱成就","level":0},{"t":"(绀蒱正云劒蒱此云乃西域果名其色红赤腹国正云劒蒱三约撗文而佛颈成就彼相故云也今时俗谓颈圆有约为婴节者是也)。","level":0},{"t":"[弓*(乞-乙+小)]布十方","level":0},{"t":"(颜注汉书曰[弓*(乞-乙+小)]满也)。","level":0},{"t":"左臋","level":0},{"t":"(臋徒论反声类臋尻也尻音苦劳反也)。","level":0},{"t":"其<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00170.gif\" alt=\"䏶\" title=\"䏶\" />与[月*(十/田/寸)]","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00170.gif\" alt=\"䏶\" title=\"䏶\" />字正冝作脾古文作<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03001.gif\" alt=\"䠋\" title=\"䠋\" />今<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00170.gif\" alt=\"䏶\" title=\"䏶\" />未详所出[月<em>(十/田/寸)]字冝作腨今经本作[月</em>(十/田/寸)]者[謵-白+尒])。","level":0},{"t":"伊尼延鹿王腨","level":0},{"t":"(伊尼延者鹿名也其毛色多黑腨形<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00166.gif\" alt=\"𦟛\" title=\"𦟛\" />纤长短得所其鹿王<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />胜故取为喻腨字又作[跳-兆+專])。","level":0},{"t":"举足将步","level":0},{"t":"(将欲也步行也王逸注楚辞曰步徐行也)。","level":0},{"t":"足跟","level":0},{"t":"(跟各痕反)。","level":0},{"t":"因陁罗尼罗","level":0},{"t":"(因陁罗此云帝也尼罗此云青也)。","level":0}],[{"t":"如来随好光明功德品第三十五","level":3},{"t":"随好","level":0},{"t":"(呼告反令众生爱乐故又音呼暠反资严大相益殊胜故)。","level":0},{"t":"摩耶夫人","level":0},{"t":"(摩耶此云幻也由此菩萨唯依大<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02171.gif\" alt=\"𭛔\" title=\"𭛔\" />智幻法门行故故此名夫人者梵本云苐脾此翻女天案郑注礼云诸侯之妃曰夫人玉篇曰呼妇人为夫人者亦所以崇敬之称也又夫者男子美称妇因夫以成人故名夫人也西域呼王妃为苐脾呼男夫为苐婆也)。","level":0},{"t":"忏悔","level":0},{"t":"(忏谓忏摩此云请忍谓请前人忍受我悔罪也)。","level":0}],[{"t":"经卷第四十九","level":2}],[{"t":"普贤行品第三十六","level":3},{"t":"乐近凢庸","level":0},{"t":"(广疋曰凢轻也汉书集注口庸庸微小也言其轻薄寒微眇小之人耳)。","level":0},{"t":"习童蒙法","level":0},{"t":"(易称蒙卦者谓童蒙来求我非我求童蒙蒙者<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02640.gif\" alt=\"𢠽\" title=\"𢠽\" />也韩康注云蒙昧<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21894.gif\" alt=\"㓜\" title=\"㓜\" />小之象又玉篇曰童<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21894.gif\" alt=\"㓜\" title=\"㓜\" />迷意也广雅曰童痴也郑玄注周礼蒙[曰/月]也毛诗传曰蒙覆也言童幼之心愚昧所为惛[謵-白+尒]如以物覆蔽之)。","level":0},{"t":"口如哑羊障","level":0},{"t":"(亚於雅反巧能宣说大乘妙义名无亚羊障大智度论苐三云亚羊僧者谓虽不破戒钝根无惠不别好<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />不知轻重不知有罪若有僧事二人共诤不能断决嘿然无言譬如白羊乃至人煞不能作声是名哑羊僧也)。","level":0},{"t":"洎于法界","level":0},{"t":"(洎字正冝作暨暨音渠秘反珠藂曰暨谓及预也杜注左传曰暨至也经作洎者[謵-白+尒]也)。","level":0},{"t":"充洽","level":0},{"t":"(洽侯夹反小雅曰充俻也玉篇曰洽濡洽润之也)。","level":0},{"t":"工幻师","level":0},{"t":"(韵圃称工巧也谓巧能於幻术)。","level":0}],[{"t":"经卷第五十","level":2}],[{"t":"如来出现品第三十七之一","level":3},{"t":"偏祖","level":0},{"t":"(祖唐亶反露也字从示又音宅苋反非此所湏也)。","level":0},{"t":"右跽","level":0},{"t":"(跽其几反跪也)。","level":0},{"t":"如我惟忖","level":0},{"t":"(忖忩本反颜注汉书曰惟思也珠丛曰忖恻度也)。","level":0},{"t":"瞻仰如来仁及我","level":0},{"t":"(有仁德者号之为仁故谥法曰赀贤视也曰仁煞身以成人曰仁度功而行曰仁周礼曰天德曰仁礼记云上下相亲曰仁论语云克己复礼曰仁郑注礼云施恩曰仁白虎通曰仁者是忍好生爱人者也)。","level":0},{"t":"佉陁罗山","level":0},{"t":"(亦曰轲梨罗此即木名谓此方苦梗木也由彼山中多有此木故立其名耳)。","level":0},{"t":"尼民陁罗山","level":0},{"t":"(此翻为持边以彼山是七重金山中<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />外边故然即院绕护持餘内六山故名持边也)。","level":0},{"t":"目真隣陁山","level":0},{"t":"(目真此云解脱即是龙名也隣陁此云处也谓此山中是解脱住处也)。","level":0},{"t":"水族众生","level":0},{"t":"(孔安国注书曰族类也谓水畜之流类也)。","level":0},{"t":"大雨名洪霔","level":0},{"t":"(注之戊反洪大也并急写水曰霔也)。","level":0},{"t":"变湿令燥","level":0},{"t":"(燥苏早反燥乾也变字从<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07372.gif\" alt=\"䜌\" title=\"䜌\" />作又有从反者不是字也湿字有作湿者误也)。","level":0},{"t":"廓彻虚空","level":0},{"t":"(廓苦郭反尓雅曰廓大也今谓宽大遍虚空量也)。","level":0},{"t":"普照无<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30678.gif\" alt=\"𥝠\" title=\"𥝠\" />","level":0},{"t":"(玉篇曰事不公为<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30678.gif\" alt=\"𥝠\" title=\"𥝠\" />王逸注楚辞曰窃爱为私也郭象注<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />子曰世所谓无私者释己而爱人也言无己情偏有所为也私字厶上加撇者非也)。","level":0}],[{"t":"经卷第五十一","level":2},{"t":"如来出现品之二","level":0},{"t":"作务","level":0},{"t":"(作则各反务事业也)。","level":0},{"t":"或牟萨罗","level":0},{"t":"(或曰牟娑罗此云紫色宝)。","level":0},{"t":"哮吼","level":0},{"t":"(哮呼教反吼呼口反)。","level":0},{"t":"洞然","level":0},{"t":"(洞徒弄反韵圃称洞彻也谓通彻火然之状也字或冝作烔烔音徒东反韩诗传曰烔谓烧草传火焰也)。","level":0}],[{"t":"经卷第五十二","level":2},{"t":"如来出现品之三","level":0},{"t":"优波尼沙陁分","level":0},{"t":"(已见苐十七卷)。","level":0},{"t":"鼓杨海水","level":0},{"t":"(鼓公户反说文曰鼓击也字从支不从皮也)。","level":0},{"t":"则便谢","level":0},{"t":"(王逸注楚辞曰谢去也谓神识去身者也)。","level":0},{"t":"积同湏[弓*(乞-乙+小)]","level":0},{"t":"(说文曰积聚也聚谓堆聚聚音疾喻反也)。","level":0},{"t":"如乾草<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00036.gif\" alt=\"𧂐\" title=\"𧂐\" />","level":0},{"t":"(<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00036.gif\" alt=\"𧂐\" title=\"𧂐\" />即赐反郑玄注周礼塔小曰委垖大曰积积字从廿者俗也)。","level":0}],[{"t":"经卷第五十三","level":2}],[{"t":"离世闲品第三十八之一","level":3},{"t":"知诸称谓","level":0},{"t":"(称昌孕反称顺也汉书音义云谓者指趣也今谓於法门意趣皆顺知汉书又曰谓者称也事冝也谓凢诸事物知其名自识其所冝皆曰称谓也)。","level":0},{"t":"知诸制令","level":0},{"t":"(令力政反制谓禁制令谓法令也)。","level":0},{"t":"长婴疾苦","level":0},{"t":"(婴於征反汉书曰婴绕也谓常为疾苦之所緾绕也)。","level":0}],[{"t":"经卷第五十四","level":2},{"t":"离世闲品之二","level":0},{"t":"启一切众生心意","level":0},{"t":"(玉篇曰启闻也古体作启也)。","level":0},{"t":"闲无空处","level":0},{"t":"(闲古闲反谓中间也)。","level":0}],[{"t":"经卷第五十五","level":2},{"t":"离世闲品之三","level":0},{"t":"善言开喻","level":0},{"t":"(汉书音义曰喻晓也苍颉篇曰喻谏也)。","level":0},{"t":"棒打屠割","level":0},{"t":"(棒字正冝作棓或亦为柈今经本作棒杖之棒非打棓字然复有从手边作奉者乃是棒持之转远经意也广雅曰棓兼也又有木边作咅者即是棒杖之棓字体耳)。","level":0},{"t":"誓期自勉","level":0},{"t":"(郑注礼记曰勉勤也玉篇曰自劝强也)。","level":0},{"t":"挝打楚挞","level":0},{"t":"(挝陟苽反挞他沬反说文曰挝箠也郑玄注周礼箠击也楚杖也又注周礼曰挞犹杖之以荆也挝字从木古体作纂之也)。","level":0},{"t":"挑","level":0},{"t":"(天雕反)。","level":0},{"t":"或级其头","level":0},{"t":"(汉书卫青霍去病传苐二十五云斩首三千一十七级颜师古曰本以斩[敲-高+(嫡-女)]一首办爵一级故即因谓斩首为级亦即又名生获一人为一级也珠丛曰斩首一名为级也)。","level":0},{"t":"无央数刧","level":0},{"t":"(央於良反王逸注楚辤曰央尽也)。","level":0}]]