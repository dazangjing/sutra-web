[[{"t":"▆▆▆▆慈心哀之心▆…▆常念师恩父母但能生子养▆▆开<img class=\"gaiji\" src=\"asset://gaiji-CB/24/CB24763.gif\" alt=\"𣜦\" title=\"𣜦\" />善道断生死之道是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂盗不淂偷不淂贪人财物不淂念盗不淂诈诒人取钱物<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08128.gif\" alt=\"㚈\" title=\"㚈\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08128.gif\" alt=\"㚈\" title=\"㚈\" />尺寸不淂欺人一分以上不淂欺人见金银<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07190.gif\" alt=\"𭹀\" title=\"𭹀\" />宝如见土政使人持金银珎宝财物与沙门沙门不淂忘受受者不自入当惠乞丐资穷者輙当为世间人说言不当贪人财物是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂畜妇不淂念妇不淂思妇女坐起不淂与女人相干错不淂念妇女净絜行道中不举头相视视妇妇女女老者如母长如姉少者如弟妹小者如女行道中当仾头若卧若起有[洺-口+王]意者当念妇女有月经污露当断是生死之本生死者皆从妇女起是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂妄语不淂妄言证入人罪见者言见不见者言不见心亦当至诚语亦当至成不淂中伤人意语言当安心择语徐语语时不淂瞋怒不淂念忘语不淂思忘语如所闻者说不淂增益不淂与世间人诤自理是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂大语高声其有<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00981.gif\" alt=\"𮤟\" title=\"𮤟\" />者论觧论说其善取觧而已人有急性者教令慈仁不淂传言<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00981.gif\" alt=\"𮤟\" title=\"𮤟\" />人是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门语言不淂中伤人意当为众人所敬爱不淂欺<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07999.gif\" alt=\"𢢔\" title=\"𢢔\" />但淂说佛经不淂说世间之事是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂歌不淂念歌不闻经不淂忘从意作经夜读佛经当念经<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />当念𰻋[十/(罩-卓+心)]道根本所说经当使人喜闻读不淂忘是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂卧好高床不淂绵绣诸绿好色着身不淂於金银[咒-几+巫]中食於铁[咒-几+巫][几@二][咒-几+巫]饮食是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂饮酒不淂甞酒不淂念酒不淂畜酒不淂入酒舎不淂具酒是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂勋衣不淂畜香不淂持香不淂以泽香涂身不淂嗅香不淂念香是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂听琴<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21999.gif\" alt=\"𦂶\" title=\"𦂶\" />之音不淂皷琴不淂持不淂念不淂念畜不淂听是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂畜奴婢若世间人持奴婢乞丐沙门沙门不淂更取若世间人持男儿女儿乞丐沙〃门〃不淂取是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂畜牛马不淂畜诸畜不淂乗车不淂马不淂载车是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂倨稸储<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13463.gif\" alt=\"䅽\" title=\"䅽\" />粮不淂念使所止空中有<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13463.gif\" alt=\"䅽\" title=\"䅽\" />沙门朝起持钵行乞过七家过上头一家足淂饱不淂<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />过餘六家舎两家足不淂<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />过五家七家不淂食者当还归故<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />但饮水如飞鸟求食淂食即食饱即飞去无所遗持沙门行乞食淂食即食不淂食持钵而去如飞鸟是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />沙门不淂贩卖亦不说贩卖亦不淂买贱卖贵是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂畜田庐不淂畜菓▆树亦不淂念树是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂说彼<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />有池水中有好香莘亦不淂念某<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />水中有好香莘当念心意化使作善是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂说某国佳某郡佳某县佳某聚佳不淂说噵某国[十/(罩-卓+心)]某郡[十/(罩-卓+心)]某县[十/(罩-卓+心)]某聚[十/(罩-卓+心)]不淂言某沙门有舎宅无舎宅有薗无薗有<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13463.gif\" alt=\"䅽\" title=\"䅽\" />粮无<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13463.gif\" alt=\"䅽\" title=\"䅽\" />粮有衣无衣是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门若坐若卧不淂说国王治行善[十/(罩-卓+心)]不淂噵世间偷盗之事军兵闘变国国相伐之事是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂言某衣温某衣不温某衣好某不好是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂说牛马<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10165.gif\" alt=\"𩚑\" title=\"𩚑\" />食是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂言我明经某不明是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"其有沙门披罗门食众人食者熟自思惟是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂若何䓁知不淂有𱞽<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07999.gif\" alt=\"𢢔\" title=\"𢢔\" />之心是为沙门之<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门讲经不淂言我经利某不利我持<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />汝不持<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />我施行佛法汝不施行佛法是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂言我<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25562.gif\" alt=\"𨸲\" title=\"𨸲\" />佳若<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25562.gif\" alt=\"𨸲\" title=\"𨸲\" />[十/(罩-卓+心)]佛经一法身志当日开觧不淂诤师闘是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂言我父佳汝父[十/(罩-卓+心)]我母佳汝母[十/(罩-卓+心)]是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂噵某<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />沙门与我讲经意志不如我不淂念某<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />沙门有好杋某无好杋某有好被枕某无被枕某有床<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00186.gif\" alt=\"㯓\" title=\"㯓\" />某无床<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00254.gif\" alt=\"㩉\" title=\"㩉\" />是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂照镜<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00562.gif\" alt=\"䟽\" title=\"䟽\" />头摩抆发<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01930.gif\" alt=\"䰅\" title=\"䰅\" />不淂覩象闘牛琤闘一切不淂观是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂博戯不淂射不淂[(角*羊)/心]怠噵羙食不淂言我到某<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />当<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />从某来不淂作男子[監-皿+酉]姤女[監-皿+酉]不淂作牛马[監-皿+酉]不淂教人吐夏是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"沙门不淂手持弓弩兵刃<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09229.gif\" alt=\"𭂬\" title=\"𭂬\" />石刀杖戯是沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"不淂相男子及姤女相牛马不淂言今年多雨来年少雨岁熟不熟多病少病有灾异无灾异不淂言今年日月食地动多风少风星<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29763.gif\" alt=\"𪧐\" title=\"𪧐\" />政不政不淂隐相是为沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"佛告阿<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15924.gif\" alt=\"㧞\" title=\"㧞\" />言经中皆有是曺<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />沙门过时不食不<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />食亦不淂恨衣被<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00877.gif\" alt=\"𦿔\" title=\"𦿔\" />丑钵常在左脇所行<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />身当与钵相随如飞鸟羽翼我沙门所行口不忘食九孔皆端不恨身若常思念上<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />语常自鄙可时淂罗汉道不与世间人诤权但与世间人诤意自脱淂阿罗汉<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10165.gif\" alt=\"𩚑\" title=\"𩚑\" />亦念阿罗汉道持是<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />意念者是为佛弟子沙门坐起常思惟是上语常思是五藏摄志意不淂使动行在山中树下皆取痴意弃就善意弃怒意就慈意慈心於天下畜生虫狩心不淂有疑蜜如佛言淂罗汉不[去/共]是曺心者不淂罗汉道佛言如负责人心自计挍偿已皆欢喜我沙门已自知心中餘有几许[十/(罩-卓+心)]露[十/(罩-卓+心)]露欲觧如负责者喜如人系狱中一时淂出者皆欢喜如人有奴婢大夫一时勉奴婢奴婢皆欢喜我作奴婢若千岁今淂觧脱如人被长病积有年月弐一时病愈甚大欢喜如人行贾入深山越度无水浆<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />至他郡国<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />还见家心为欢喜佛告阿<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15924.gif\" alt=\"㧞\" title=\"㧞\" />沙门能觧五阴就五阳淂罗汉道者欢喜。","level":0},{"t":"如是去五阴使人淂道一阴者眼二隂者身三隂者谓思想精四阴谓生死精五隂谓魂魄是五隂皆<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00832.gif\" alt=\"䨱\" title=\"䨱\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00877.gif\" alt=\"𦿔\" title=\"𦿔\" />人使不淂觧脱我沙门皆已<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />五隂。","level":0},{"t":"自思惟我先世所作[十/(罩-卓+心)]今皆觧脱我痴意已去今已淂明意坐自思惟心不<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />担亦不走无所贪慕於世间是沙门苐一欢喜。","level":0},{"t":"自思惟身中五藏[十/(罩-卓+心)]露已欲洁净一心趣阿罗汉道沙门苐二欢喜。","level":0},{"t":"沙门自思惟已不<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />死已断生死今於世断忧断哭我不能<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />哭人人亦不哭我我不辱人人不欲我我不贪人人不贪我人虽不贪我我有慈心於人欲使人疾淂道皆如我人为道苦日少乐日多如世间人头身軆有垢沐浴垢者甚欢喜但去外垢心垢未除我阿罗汉外垢亦去中垢亦去是为苐三欢喜。","level":0},{"t":"沙门近阿罗汉坐树下自思惟世间人不同世间人心皆志不<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />我心安如四方石石在地雨不能怀风不能动我诸沙门淂道者如莲华莲华本从污<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25465.gif\" alt=\"𭰖\" title=\"𭰖\" />中出无不喜爱者华泠者中亦泠上亦泠我沙门自思惟身泠於世间心亦泠於世间志亦泠於世间泠者无所<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />欲沙门自念言我所<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06531.gif\" alt=\"𬱃\" title=\"𬱃\" />皆已淂有慈於佛所阿罗汉自说我父母一世养视子身佛是世间断生死之道阿罗汉自说言我事师从淂脱我便见五藏自知我寿命自思惟欲上天即上欲入海即能意常政世间有死人恃十种香汁沐浴死人宁使死人香耶教[十/(罩-卓+心)]人作善终不作善其人心不善口亦不善身亦不善沙门言我淂佛恩若人噵说善但作娑耳无有罗罗汉汉闻道是亦不应人亦不语人我沙门自思惟世间人皆不如我我曺正汝曺子语汝苟笑人狗遂啮人淂贤人亦笑欲啮淂[十/(罩-卓+心)]人亦[口<em>(乏-之+犮)]欲啮贤者善人见狗[口</em>(乏-之+犮)]常持慈心住向知狗态我沙门知世间人着新衣絜净者坐起用作喜不欲沰污我沙门淂罗汉憎世间人[十/(罩-卓+心)]露是为沙门苐四欢喜。","level":0},{"t":"我沙门自思惟意中亦无垢污见善重善见[十/(罩-卓+心)]者使作若沙门自念身者父母所生哺父母养育沐浴<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09707.gif\" alt=\"㵕\" title=\"㵕\" />洗成就生子不随父母意不随父母教令有过罪至后死不怨父母亦非怨父母过沙门言我曺作沙门淂佛经<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />去[十/(罩-卓+心)]就善正使百[十/(罩-卓+心)]来无<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />我曺意内外皆政佛言本先世无𰚆刼时我亦有师无为之道我沙门淂罗汉道自陈说我於某<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />淂湏阤洹某<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />淂斯阤含某<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />淂阿<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />含某<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />淂阿罗汉我沙门自说生死无能与生同事天下有量人观知世间青黄白黑我沙门淂阿罗汉道自知天下人<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30684.gif\" alt=\"䦢\" title=\"䦢\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00782.gif\" alt=\"𠇺\" title=\"𠇺\" />知天下人[洺-口+王]怒之态知天下有人𱞽<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07999.gif\" alt=\"𢢔\" title=\"𢢔\" />之态知天下人有贪味之态我沙门如是我沙门如是我沙门志意不在天上亦不在人中亦不乐天上亦不乐人中我沙门淂阿罗汉昼夜思念於天下人皆欲使淂阿罗汉天下人虽不能淂道不能行罗汉志当行罗汉意知人意志如<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21868.gif\" alt=\"𭂫\" title=\"𭂫\" />人见青黄白异阿罗汉知人生从何来死至何所我阿罗汉知某人入泥[利/尒]中知其人入薜荔中知某人入禽狩畜生中鬼神道我沙门淂阿罗汉道者说我身已度常念言碎我身亦可破我身亦可意淂所▆之道如天下人清泉水中若溪水中人以黄金明月珠流离水精所有皆现但用水清故所视輙见阿罗汉自思惟知内<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />知外心意清净也。","level":0},{"t":"五部僧服餙品苐五。","level":0},{"t":"昔佛在世时众僧被服唯着纯真死人杂帛自后起比丘罗旬喻每行分卫輙空而还佛知其<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29763.gif\" alt=\"𪧐\" title=\"𪧐\" />行欲现瑛福弈世明<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />佛使众僧分为为五部着五色袈裟令日随一部中行於是遂相制仪至於度世后立号称名各举所长名眼色▆[薩-產+(辛/工)]惒多部博通敏达<img class=\"gaiji\" src=\"asset://gaiji-CB/24/CB24763.gif\" alt=\"𣜦\" title=\"𣜦\" />利法化应着绛袈裟昙无徳部奉孰重<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />断当法侓应着皂袈裟迦叶惟部精勤勇恵救护众生应着兰袈裟<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30394.gif\" alt=\"𢏏\" title=\"𢏏\" />沙翼部禅思入微究畅玄幽应着青袈裟摩诃僧祇部懃学众经敷演仪理应着黄袈裟。","level":0},{"t":"佛告诸比丘舍家学道安利身神济度众生破坏狱苦受无量智当受佛教<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />行如佛行住如佛住坐如佛坐起如佛起食如佛食饮如佛饮顺无美着如毛<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00993.gif\" alt=\"𩬊\" title=\"𩬊\" />我知淂道不久矣。","level":0},{"t":"佛告五部比丘后末世时若曺五部当<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />分为三部何以故佛去世后多有诸龙子诸阅叉子及诸鬼神令淂见我欢喜故末世时皆淂人身当作沙门若作人中王所以者何用欢喜诸龙子见尊故若有沙门披罗门若国之长吏及众官属贪着财色赋敛细民人皆吁嗟仰天而吟如是皆龙鬼神种何以故是龙鬼神阅叉鬼神贪<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01618.gif\" alt=\"𨒫\" title=\"𨒫\" />食人故佛言若我法中沙门有持法者其行无缺者是我真弟子已离色欲日中乃食不畜遗餘衣身弊形食身充饱欲意已断一无所<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15164.gif\" alt=\"𮨇\" title=\"𮨇\" />或在山中野泽树下冡间不预人事是名阿练儿吾保其淂道是为苐一部。","level":0},{"t":"佛言若我法中有沙门持法侓者行如中行居佛寺淡然少行束衣身盖刑食取充口亦不言麤亦不言细但务経业讽诵无<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29833.gif\" alt=\"𤹍\" title=\"𤹍\" />若有耶事为断绝使了了若有<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00981.gif\" alt=\"𮤟\" title=\"𮤟\" />诤两断决使欢喜但以政道行之不随耶色设耶诡兴即退隐初不予[十/(罩-卓+心)]说之事设有诽谤受而不报[十/(罩-卓+心)]声来迦<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30037.gif\" alt=\"𨚫\" title=\"𨚫\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06924.gif\" alt=\"𨳰\" title=\"𨳰\" />室户心常恱喜视之如父母忏悔慙愧谢之不直如是行者是龙子转当淂阿练儿吾保其淂度脱生死无苦想报如是字为持<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />沙门是为苐二部。","level":0},{"t":"佛言若我法中有沙门不持法侓<img class=\"gaiji\" src=\"asset://gaiji-CB/22/CB22000.gif\" alt=\"𭸟\" title=\"𭸟\" />佛作沙门因淂学问聡明多智教授於人前授佛<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30037.gif\" alt=\"𨚫\" title=\"𨚫\" />授地狱何以故前授佛<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />欢喜便说无常事是为佛<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />后多赋致不淂便大瞋恚张目嚾吁骂詈如是弟子<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/20/CB20012.gif\" alt=\"𢘤\" title=\"𢘤\" />恨是为授人地狱<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />阿难问佛何故淂尒佛语阿难后是辈沙门甚多倍<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />倍不可𰚆也不附法侓是阅叉子辈作沙门大甚多还怀我法使人堕罪不能自免矣。","level":0},{"t":"阿难白佛言如是为可分别说不号佛语阿难可分别说身谛听之其有沙门不入众辈衣麁履弊好独<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />闲静以星<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29763.gif\" alt=\"𪧐\" title=\"𪧐\" />为<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29832.gif\" alt=\"𢟷\" title=\"𢟷\" />盖以天地为堀舎十方天下众川流以为财宝以一切人心为心以本无为父母如是行者是菩[薩-產+(辛/工)]也。","level":0},{"t":"佛言末世时沙门自守无他越溢常附经<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />不以文餙其说无二身口心意<img class=\"gaiji\" src=\"asset://gaiji-CB/20/CB20012.gif\" alt=\"𢘤\" title=\"𢘤\" />皆相当衣取盖刑不利文耒食取立躯无着羙味供养与不与其意一䓁如是行者是龙子。","level":0},{"t":"佛言末世时沙门自放恣不持法侓身衣缯缘珎宝之衣但以细滑五宍兹味以用自禁语欲淂胜不避豪贤乗马车舆自尊嚾吁<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29840.gif\" alt=\"𠯅\" title=\"𠯅\" />咄偃健𱞽<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07999.gif\" alt=\"𢢔\" title=\"𢢔\" />极[穴/(乏-之+犮)]於人欲令堕罪如是行为阅叉鬼神子智者默而避之不共诤诤者便[去/(冗-几+手)]人入罪门。","level":0},{"t":"佛告比丘比丘<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />优披塞扰披夷诸学士依经称𱞽自谓为智者此是魔种身多智而无言尒乃菩[薩-產+(辛/工)]身当谛知之阿难问佛言当何以知之佛言有人淂深般若波罗蜜故有瞋恚毒心不除是为魔种身有人淂深般若波罗蜜便淂柔濡行是为菩[薩-產+(辛/工)]。","level":0},{"t":"贤者阿难长跪叉手白佛言今佛在世分比丘僧为五部末世时五浊<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />分为三部何以尒于有何瑞应<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06531.gif\" alt=\"𬱃\" title=\"𬱃\" />佛觧说其义使此众人各淂开盲[(句-口+目)/丌]之心佛告阿难贤者谛听乐闻者一心听佛当若为说之佛言今我在世所以分比丘僧为五部者有沙门名罗旬喻常行分卫还輙空不能淂食遂尒至困不能自谐用是故分为五部各异服餙<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30726.gif\" alt=\"𮎛\" title=\"𮎛\" />然后罗旬喻曰随一部行分卫至日中皆空还不淂食五部<img class=\"gaiji\" src=\"asset://gaiji-CB/20/CB20012.gif\" alt=\"𢘤\" title=\"𢘤\" />如是罗旬喻止不行皆更大淂饭食何以故是罗旬喻前世无功徳所<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25913.gif\" alt=\"𦤺\" title=\"𦤺\" />阿难问佛言罗旬喻前世无功徳云何淂作沙门佛言此罗旬喻前世为贤者子作人姤嫉见沙门来分卫輙迎<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06924.gif\" alt=\"𨳰\" title=\"𨳰\" />门言大人不在沙门<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />到餘家<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/23/CB23936.gif\" alt=\"𢫀\" title=\"𢫀\" />餘家门户<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06924.gif\" alt=\"𨳰\" title=\"𨳰\" />之<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />言大人不在用是故今分卫不能淂这见他作施食便欢喜行食之见众沙门着前食便<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />言我亦当作沙门当<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />着前食用是故今淂作沙门沙门用是故便行分卫不能食淂穷困如是佛言夫人为道道之立神当以懃懃广作功徳世世不畏可淂道矣。","level":0},{"t":"阿难问佛言五部为应何䓁耶佛言如是罗旬喻但生五隂五盖为之[雨/(泳-永+复)]弊不能自照是其杲用是故作五部欲令灭断五隂盖立於五根<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />五力故末世时分为三部者用末世[十/(罩-卓+心)]<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01618.gif\" alt=\"𨒫\" title=\"𨒫\" />谄伪三毒炽盛人民刚强虽入佛法中诈诡调欺[十/(罩-卓+心)]<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01618.gif\" alt=\"𨒫\" title=\"𨒫\" />难信反东为西遴於法侓不专修道反行非法欲求名誉违远政道说反为政云云诤语用是故分为三部佛欲使灭三毒故立三徳何䓁三徳一佛徳二法徳三僧徳三徳具淂三向一者向泥洹二者向天清净三者向本无是为三沙门有十福衣之名曰三法何䓁为三法一曰佛法二曰法<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25465.gif\" alt=\"𭰖\" title=\"𭰖\" />洹三曰法本无是为三夫人为道当如清净泥洹淡泊无为少欲有多慈心欲附法侓不失莭度若说深法如佛所说终不憎盛是谓沙门清净之士。","level":0},{"t":"於是贤者阿难<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />前白佛言属者佛所说沙门衣十福何䓁为十福佛言袈裟三愊僧竭支三愊[社-土+复]<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12275.gif\" alt=\"𢴠\" title=\"𢴠\" />二愊泥洹僧二愊是为十福为应十方天下人非人用有十[十/(罩-卓+心)]故佛使沙门行分卫其人布施盖不足言淂福不可量施与一钱现世即有百钱之报应未来不可计夫种布施譬如种<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13463.gif\" alt=\"䅽\" title=\"䅽\" />禝禝应种豆豆应种麦麦应种麻麻应种政使种诸草实淂报如应夫人布施亦<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />如是天下所种无不应者譬如人<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04780.gif\" alt=\"𥞩\" title=\"𥞩\" />种种多淂多种少淂少町町不种永无所淂人不布施亦<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />如是夫人富而[堅/心]贪不肻布施譬如人极贫穷不肻<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04780.gif\" alt=\"𥞩\" title=\"𥞩\" />种便作是言今年<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13463.gif\" alt=\"䅽\" title=\"䅽\" />火熟我曺当<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />何忧号终不恐<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10165.gif\" alt=\"𩚑\" title=\"𩚑\" />饿是我曺福<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />到<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13463.gif\" alt=\"䅽\" title=\"䅽\" />熟其主各自<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30246.gif\" alt=\"𭣣\" title=\"𭣣\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13463.gif\" alt=\"䅽\" title=\"䅽\" />了<img class=\"gaiji\" src=\"asset://gaiji-CB/16/CB16487.gif\" alt=\"𥁞\" title=\"𥁞\" />其贫穷人尒乃吁嗟言困矣何甚我悔不<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04780.gif\" alt=\"𥞩\" title=\"𥞩\" />种湏我后年当大种真不<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />住这到后年天<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />大旱五<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13463.gif\" alt=\"䅽\" title=\"䅽\" />不熟遂尒至困羸顿不可言。","level":0},{"t":"佛言夫人布施皆自淂报末世人多有悭贪不别真伪不肻布施自谓富乐不觉一时命<img class=\"gaiji\" src=\"asset://gaiji-CB/16/CB16487.gif\" alt=\"𥁞\" title=\"𥁞\" />当堕泥[利/尒]薜[利/尒]饿鬼道中不淂衣食腂刑而行亦无饮食辟如此不<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04780.gif\" alt=\"𥞩\" title=\"𥞩\" />种人当时淂世间湏<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13376.gif\" alt=\"㬰\" title=\"㬰\" />乐不知后当有大<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10165.gif\" alt=\"𩚑\" title=\"𩚑\" />困之忧其人这於饿鬼中心悔言我生不布施今堕饿鬼中我后当为人时当大布施罪竟淂出为人<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />堕贫穷家生涷腂而坐衣不弊刑食不充饱<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />不值佛世永不见沙门道人如是贫穷人悔不益种这欲<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04780.gif\" alt=\"𥞩\" title=\"𥞩\" />种<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />值天大<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01002.gif\" alt=\"㝵\" title=\"㝵\" />者谓从[十/(罩-卓+心)]道脱生贫穷家<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />不值佛世遂尒当更刧寿尒乃曺值佛世身佛所以使沙门衣袈裟三愊者欲令人灭三毒故僧竭支三愊者欲令人离三[十/(罩-卓+心)]慎<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12264.gif\" alt=\"㨢\" title=\"㨢\" />罗二者愊者令人灭二色故泥洹僧二愊者欲使人离二[十/(罩-卓+心)]故。","level":0},{"t":"阿难问佛言何䓁为三毒何䓁为三患何䓁为二色二[十/(罩-卓+心)]乎。","level":0},{"t":"佛言[洺-口+王]怒<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01153.gif\" alt=\"𪪧\" title=\"𪪧\" />是三毒生老死病是三患色者眼耳鼻口是为二色二患者谓太山地狱薜荔畜生是为二[十/(罩-卓+心)]。","level":0},{"t":"佛言吾使沙门着十愊之衣行乞时但用十方天下人有是十[十/(罩-卓+心)]事故故著十愊衣耳人有淂二证信者便作沙门何䓁二证一者信生天上二者信有泥[利/尒]地狱饿鬼畜生便作沙门淂此十愊衣袈裟三愊以灭三毒入三脱门僧竭支三愊灭生老病死淂三向[杵-十+(且/八)]<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12264.gif\" alt=\"㨢\" title=\"㨢\" />罗二愊灭眼耳鼻口一不受即淂智恵泥洹僧二愊<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30274.gif\" alt=\"㓕\" title=\"㓕\" />断泥[利/尒]地狱饿鬼畜生进度无极淂清净无为之道是故佛使沙门行乞福度一切人令淂离苦众淂安隐佛说。","level":0},{"t":"是时诸比丘僧皆大欢喜头▆作礼。","level":0},{"t":"佛言如是有人布施沙门道人者其福甚无量人但以作徳可疾作佛虽尒沙门受布施物不可不审谛亦不知法侓<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/22/CB22000.gif\" alt=\"𭸟\" title=\"𭸟\" />佛法行受人布施是为罪身比丘善思惟之。","level":0},{"t":"阿难问佛言人布施沙门淂福无量何为沙门受布施为淂罪于。","level":0},{"t":"佛语阿难汝所问大善多所过度谛听当为汝广说其义贤者阿难及诸比丘比丘<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />叉手一心而听。","level":0},{"t":"佛告阿难及诸比丘我住曰经行至[薩-產+(辛/工)]罗国与五百比丘俱道见大枯树有人放火烧之其炎甚高佛摇见火烧树便住至火边去火𰚆十步而坐<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30072.gif\" alt=\"𠡠\" title=\"𠡠\" />诸比丘僧各自取草坐坐说。","level":0},{"t":"佛告诸比丘汝曺见是火烧树火炎不是<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01607.gif\" alt=\"𪪂\" title=\"𪪂\" />𤏟多炎少烟甚火热欝。","level":0},{"t":"佛告诸比丘若有人入大火中若坐若卧为何如。","level":0},{"t":"诸比丘言火中热<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />剧不可堪。","level":0},{"t":"佛言若有年少女人大端政殊好身着殊异采衣珠环香勋羙芬如是宁与是女人共坐若卧宁入是火中坐卧。","level":0},{"t":"诸比丘言坐卧是火中甚痛剧矣。","level":0},{"t":"佛言宁入此火中坐卧不与他家端政女人卧起一时何以故火烧人热<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />湏<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13376.gif\" alt=\"㬰\" title=\"㬰\" />闲耳贪[洺-口+王]之态将人入地狱中烧人热<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />火久动有刧𰚆其<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />不可思义夫人为道奉持经<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />当自折护捄度一切无淂有[洺-口+王]态於他人妇女若有沙门於外视如谨敬於内有[洺-口+王]态不能自端其心是为反行沙门。","level":0},{"t":"佛语诸比丘宁纵索使三四人对锲其股令到骨乃正耶宁使人来接沙门足兮。","level":0},{"t":"诸比丘言宁使人接沙门足。","level":0},{"t":"佛言宁以纵索使三四人对锲其股<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30072.gif\" alt=\"𠡠\" title=\"𠡠\" />使到骨<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />湏<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13376.gif\" alt=\"㬰\" title=\"㬰\" />耳使人接沙门足者死入太山地狱中鬼持利刀割其足火久<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />不可言诸比丘若曺善自思惟之。","level":0},{"t":"佛言外视如沙门内不除了受人<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30436.gif\" alt=\"𥘇\" title=\"𥘇\" />费食人饮食受人医药床卧具其毒心殊不除了不淂受人布施。","level":0},{"t":"佛语诸比丘纵索对锲其股至骨死死不当受布施物比丘汝曺坚持心奉持法侓如法侓行之。","level":0},{"t":"佛告诸比丘宁持利刀割身軆宍与人宁当受人布施物。","level":0},{"t":"诸比丘言持刀割身軆甚<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />剧。","level":0},{"t":"佛言是<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />尚可忍一时闻身沙门不持佛经<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />违於法侓而受人<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30436.gif\" alt=\"𥘇\" title=\"𥘇\" />费衣被饮食者死入太山地狱中鬼神取利刀割其身軆大久甚<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />剧。","level":0},{"t":"佛言夫人去家为道当自思惟勿外作沙门内利人衣被饮食财物心不绝。","level":0},{"t":"佛语诸比丘宁消铜持注口中入<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09727.gif\" alt=\"𠰸\" title=\"𠰸\" />燋入腹腹燋如是热者一时之间沙门不持禁<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />常有饮食贪味之态<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17447.gif\" alt=\"㥧\" title=\"㥧\" />勿贪取人饮食财物。","level":0},{"t":"佛问诸比丘宁饮人食宁饮消铜。","level":0},{"t":"诸比丘言饮消铜火毒<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />剧不可言。","level":0},{"t":"佛言宁饮消铜其<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />湏<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13376.gif\" alt=\"㬰\" title=\"㬰\" />闲身作沙门不持<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />舍於法侓而受人饮食者死入太山地狱中常饮消铜火久不可言诸比丘谛思惟之。","level":0},{"t":"佛言人见沙门颜类行步像如贤善自夺妻子饮食持与沙门而此沙门殊不持佛<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />但有贪[洺-口+王]之心诸比丘若曺作沙门善自<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />於心。","level":0},{"t":"佛语诸比丘宁烧石使赤摩身軆宁欲卧高好床上。","level":0},{"t":"诸比丘言烧石摩身軆大<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />剧不可言。","level":0},{"t":"佛言宁烧石摩身軆此<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />湏<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13376.gif\" alt=\"㬰\" title=\"㬰\" />闲身沙门不持佛<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />法侓而受人床卧具死入太山地狱中作人常卧热石上甚<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />不可言以作沙门身心口意当端志行不当有贪[洺-口+王]之态夫人见沙门道人颜类坐起似贤善其人自夺妻子及身床卧具持施沙门而沙门殊不端心心利色欲内不持<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />违於法侓不当受人财物也诸比丘若曺善自端心勿犯禁<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />。","level":0},{"t":"佛言若有铁床铜床床者皆火热欲卧其上不。","level":0},{"t":"诸比丘言铁床铜床火热不可堪。","level":0},{"t":"佛言此热湏<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13376.gif\" alt=\"㬰\" title=\"㬰\" />闲耳沙门不政心不持<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />法不淂卧板床绳床上。","level":0},{"t":"佛言人见沙门似如贤者善人自夺妻子及身床卧与沙门若持床卧上诸物遗与沙门而沙门殊不端心内不持经<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />常有贪[洺-口+王]之态不能自觧。","level":0},{"t":"佛言宁卧铁床热湏<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13376.gif\" alt=\"㬰\" title=\"㬰\" />身不持<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />死入地狱中为人常取着沸<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29834.gif\" alt=\"𣺦\" title=\"𣺦\" />汤中甚大久诸比丘若曺自<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />於心。","level":0},{"t":"佛言取世间铁鼎<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29834.gif\" alt=\"𣺦\" title=\"𣺦\" />满中沸汤以身囙扳其中行不如法死死不当受人财物沙门不持正<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />死入太山地狱中其数<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21868.gif\" alt=\"𭂫\" title=\"𭂫\" />十八<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08468.gif\" alt=\"𩂜\" title=\"𩂜\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08468.gif\" alt=\"𩂜\" title=\"𩂜\" />𰚆万年<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08760.gif\" alt=\"𦒱\" title=\"𦒱\" />治甚酷<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25263.gif\" alt=\"𭙡\" title=\"𭙡\" />其<img class=\"gaiji\" src=\"asset://gaiji-CB/22/CB22673.gif\" alt=\"𦛁\" title=\"𦛁\" />不可言沙门不持<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />不淂止佛寺中。","level":0},{"t":"佛言人见沙门道人似如贤善自有舎宅不能好欲作福徳夺妻子及身材木持作佛寺舎使沙门居其中欲使沙门淂道所沙门殊不持<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />反有贪[洺-口+王]之态<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11040.gif\" alt=\"𣸪\" title=\"𣸪\" />居塔寺中受人饮食衣被床卧当时自可用为大乐其沙门有如是者死入太山地狱中。","level":0},{"t":"佛言其有具足<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />便可淂取人物衣被饮食床卧具医药不淂者当从索之当使民皆淂其福。","level":0},{"t":"佛告诸比丘若曺善自思惟之。","level":0},{"t":"佛说是时有六十比丘觧<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />脱加裟各言我不能持是具足<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />有六十比丘即自思惟皆成罗汉有六十比丘<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00112.gif\" alt=\"𡰱\" title=\"𡰱\" />自思惟身軆皆流汗出佛说是时中有悲哀者中有欢喜者中有自归作<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30436.gif\" alt=\"𥘇\" title=\"𥘇\" />者中有谶悔者即淂道。","level":0},{"t":"佛语诸比丘谛思惟之道是身中持之便淂道不持不淂也诸比丘闻闻经欢喜作<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30436.gif\" alt=\"𥘇\" title=\"𥘇\" />而去。","level":0},{"t":"惟教三昧下卷","level":0},{"t":"全二丈四寺道人僧成敬冩供养","level":0},{"t":"普为法界众生","level":0}]]