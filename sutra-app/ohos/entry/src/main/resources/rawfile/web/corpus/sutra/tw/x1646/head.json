{"id":"x1646","title":"居士傳","titleTrad":"居士傳","byline":"清 彭際清述","bylineLabel":"著者·译者","dynasty":"","division":"史传部","canon":"X1646","canonName":"新纂卍續藏","volume":"X1646","juanCount":56,"textLength":187899,"imageCount":0,"summary":"","tags":["史传部","新纂卍續藏"],"order":2907,"guide":"","chunks":43,"toc":[{"level":3,"text":"居士傳序"},{"level":3,"text":"山龍開經曰。妙法蓮華經序品第一。王便請下座。山"},{"level":3,"text":"徧參講席。晚年專修念佛三昧。述淨土自信錄。其序"},{"level":3,"text":"石。與諸釋子往還。重刊法寶壇經。導諸來學。為之序"},{"level":3,"text":"又云。孟長於佛法中善善惡惡有春秋之志。其序"}],"chunksPerFile":20}