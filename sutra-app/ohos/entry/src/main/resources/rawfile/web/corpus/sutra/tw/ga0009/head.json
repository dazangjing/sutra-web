{"id":"ga0009","title":"普陀洛迦新志","titleTrad":"普陀洛迦新志","byline":"","bylineLabel":"著者·译者","dynasty":"","division":"","canon":"GA0009","canonName":"佛寺志彙刊","volume":"GA0009","juanCount":12,"textLength":246961,"imageCount":0,"summary":"","tags":["佛寺志彙刊"],"order":3289,"guide":"","chunks":23,"toc":[{"level":3,"text":"中將．農商總長．騰衝李根源謹序"},{"level":3,"text":"石印普陀山志序"},{"level":2,"text":"普陀洛迦新志卷一"},{"level":2,"text":"普陀洛迦新志卷二"},{"level":2,"text":"普陀洛迦新志卷三"},{"level":2,"text":"普陀洛迦新志卷四"},{"level":2,"text":"普陀洛迦新志卷五"},{"level":2,"text":"普陀洛迦新志卷六"},{"level":2,"text":"普陀洛迦新志卷七"},{"level":3,"text":"附錄：南海慈航序"},{"level":2,"text":"普陀洛迦新志卷八"},{"level":2,"text":"普陀洛迦新志卷九"},{"level":2,"text":"普陀洛迦新志卷十"},{"level":2,"text":"普陀洛迦新志卷十一"},{"level":2,"text":"知大概。按目錄五卷，在字號外。其目錄卷一"},{"level":2,"text":"小乘經，自竭字卷第六"},{"level":2,"text":"經，共計三百種，三十四函半，三百四十二卷。大乘律，自言字卷第八"},{"level":2,"text":"函餘，計四十七卷。小乘律，自初字卷第五"},{"level":2,"text":"卷。小乘論，自逸字卷第七"},{"level":2,"text":"自廣字起，至漆字止，共一百四十七種，十九函，一百九十卷。其目錄卷五"},{"level":2,"text":"普陀洛迦新志卷十二"},{"level":2,"text":"按：是志目次，卷首〈天章〉，卷一"}],"chunksPerFile":20}