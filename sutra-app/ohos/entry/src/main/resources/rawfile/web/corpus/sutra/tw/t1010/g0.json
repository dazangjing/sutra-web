[[{"t":"佛說出生無邊門陀羅尼儀軌不空三藏譯","level":0},{"t":"No. 1010佛說出生無邊門陀羅尼儀軌","level":0},{"t":"不空三藏譯","level":0,"quote":true},{"t":"真言如經。","level":0,"quote":true},{"t":"修行此出生，無邊門總持，","level":0,"quote":true},{"t":"轉目三種業，依三祕密門，","level":0,"quote":true},{"t":"所謂三金剛，身印語真言。","level":0,"quote":true},{"t":"心住三摩地，由入三平等，","level":0,"quote":true},{"t":"善住瑜伽故，自身同本尊，","level":0,"quote":true},{"t":"在凡成正覺，斯法最深祕。","level":0,"quote":true},{"t":"大日經王說，一生補處等，","level":0,"quote":true},{"t":"尚非其境界，況餘劣慧人，","level":0,"quote":true},{"t":"如獲輪王珠，祕持不妄說。","level":0,"quote":true},{"t":"是尊即羯摩，波羅蜜菩薩，","level":0,"quote":true},{"t":"由住出生故，示少年女形，","level":0,"quote":true},{"t":"顯明大慈母，諸佛住是智。","level":0,"quote":true},{"t":"能普現色身，處大菩提心，","level":0,"quote":true},{"t":"跏趺蓮臺上，大印威儀等，","level":0,"quote":true},{"t":"同不空成就，如來之相狀。","level":0,"quote":true},{"t":"定羽金剛拳，當心持蓮華，","level":0,"quote":true},{"t":"置般若梵夾，慧羽說法相，","level":0,"quote":true},{"t":"揚掌申五輪，忍峯現羯磨。","level":0,"quote":true},{"t":"十字金剛輪，首冠五如來，","level":0,"quote":true},{"t":"遍身草綠色，復於身支分，","level":0,"quote":true},{"t":"安布八字門：","level":0,"quote":true},{"t":"􄖵跛字住於心；􄙊攞字成毫相；","level":0,"quote":true},{"t":"􄙖嚩字置舌端；􄒶惹字置於頭，","level":0,"quote":true},{"t":"碧色成頂相；􄑀迦字置慧掌，","level":0,"quote":true},{"t":"緣色成羯摩，十二緣行輪；","level":0,"quote":true},{"t":"􄕻馱黃置定掌，成華般若夾；","level":0,"quote":true},{"t":"􄙢奢字安觀足；􄚴乞叉置止足。","level":0,"quote":true},{"t":"五字皆皓素，如雪乳鵝月，","level":0,"quote":true},{"t":"是字成輪相。三摩耶密印，","level":0,"quote":true},{"t":"加持頂印是，初後次第法，","level":0,"quote":true},{"t":"同諸部儀軌。八十俱胝佛，","level":0,"quote":true},{"t":"圍遶是尊住，復有八菩薩，","level":0,"quote":true},{"t":"安住於八方，及以八藥叉，","level":0,"quote":true},{"t":"四攝八供養，次第而布列，","level":0,"quote":true},{"t":"成祕曼荼羅。誦持真言經，","level":0,"quote":true},{"t":"所成如本教，修行諸儀則，","level":0,"quote":true},{"t":"結集決擇竟。","level":0,"quote":true},{"t":"出生無邊門陀羅尼儀軌","level":0,"quote":true},{"t":"􄖵􄙊􄙖　􄒶􄑀􄕻􄙢􄚴。","level":0,"quote":true},{"t":"元祿十六年正月二十九日以淨嚴上人","level":0,"quote":true},{"t":"之本再校了尊教","level":0,"quote":true},{"t":"校注軌摩善摩少佛摩緣摩壞CBETA 校注大正藏 校注新增校注","level":0,"quote":true}]]