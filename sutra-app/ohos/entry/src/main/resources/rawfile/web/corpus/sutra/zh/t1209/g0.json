[[{"t":"金刚顶瑜伽降三世成就极深密门一卷","level":0},{"t":"开府仪同三司特进试鸿胪卿肃国公食邑三千户赐紫赠司空谥大鉴正号大广智大兴善寺三藏沙门不空奉　诏译","level":0},{"t":"归命圣主宰，普贤金刚手，","level":0,"quote":true},{"t":"为降伏一切，现吽迦啰身。","level":0,"quote":true},{"t":"摧三世有毒，令即证菩提，","level":0,"quote":true},{"t":"是甚深秘密，降三世瑜伽。","level":0,"quote":true},{"t":"首依真实王，礼净合缚摧，","level":0,"quote":true},{"t":"入闭普贤印，按心称本誓。","level":0,"quote":true},{"t":"悦已又诵此：","level":0,"quote":true},{"t":"「摩诃拘噜(二合)驮萨怛嚩(二合无保反)唅」","level":0},{"t":"发言身即同，降三世金刚，","level":0,"quote":true},{"t":"四印加宝灌，鬘甲二拟系，","level":0,"quote":true},{"t":"拍掌同金刚。即入三摩地，","level":0,"quote":true},{"t":"谛观心阿字，成月或日轮，","level":0,"quote":true},{"t":"中生五智杵。次请尊及佛，","level":0,"quote":true},{"t":"入加三昧身，又以本教中，","level":0,"quote":true},{"t":"四印加已满，五宝鬘甲拍，","level":0,"quote":true},{"t":"陈内外供养，赞咏已念诵。","level":0,"quote":true},{"t":"若作圆具法，以五相成身，","level":0,"quote":true},{"t":"又普悦本誓，忿四印五佛，","level":0,"quote":true},{"t":"宝鬘甲拍等，以吽迦啰印，","level":0,"quote":true},{"t":"加心诵真言：","level":0,"quote":true},{"t":"「吽萨怛嚩(二合)<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02594.gif\" alt=\"𮧬\" title=\"𮧬\" />日哩(二合)惹嚩(二合)罗麼罗拘噜(二合)驮吽发咤(半声)阿地底瑟咤(二合)娑嚩(二合)<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00805.gif\" alt=\"𤚥\" title=\"𤚥\" />」","level":0},{"t":"次宝二风宝(餘准此)，","level":0,"quote":true},{"t":"法以火如莲，业建火逼风，","level":0,"quote":true},{"t":"额喉顶四印。五佛大日用，","level":0,"quote":true},{"t":"真实教王中，金刚界自在。","level":0,"quote":true},{"t":"诵此秘密言：","level":0,"quote":true},{"t":"「唵嚩日啰(二合)惹嚩(二合)攞钵啰(二合)跛多(二合)羯洒也萨嚩怛他蘖多摩贺嚩日啰(二合)三麼耶吽」","level":0},{"t":"四佛同四印，金刚佛真言：","level":0,"quote":true},{"t":"「吽萨怛嚩(二合)<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02594.gif\" alt=\"𮧬\" title=\"𮧬\" />日哩(二合)惹嚩(二合)逻末罗拘噜(二合)驮吽(引)发咤(半音)阿鼻诜(去)左<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00805.gif\" alt=\"𤚥\" title=\"𤚥\" />」","level":0},{"t":"宝用金刚宝(餘三准此)，鬘甲印准前。","level":0,"quote":true},{"t":"鬘真言曰：","level":0},{"t":"「唵<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02594.gif\" alt=\"𮧬\" title=\"𮧬\" />日啰(二合)莽<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00942.gif\" alt=\"㘑\" title=\"㘑\" />儞哩(二合)茶(去)」","level":0},{"t":"被甲诵此明：","level":0},{"t":"「唵<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02594.gif\" alt=\"𮧬\" title=\"𮧬\" />日啰(二合)<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02255.gif\" alt=\"𠸪\" title=\"𠸪\" />乞叉(三合)儞哩(二合)茶(去)」","level":0},{"t":"四摄八供养，同金刚界仪，","level":0,"quote":true},{"t":"唯现於拟叱。","level":0,"quote":true},{"t":"钩真言曰：","level":0},{"t":"「唵<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02594.gif\" alt=\"𮧬\" title=\"𮧬\" />日<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03298.gif\" alt=\"𠻴\" title=\"𠻴\" />(二合)句舍麼贺句噜(二合)驮羯洒耶沙(去)莽盐(引)吽惹(入)」","level":0},{"t":"索真言曰：","level":0},{"t":"「唵<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02594.gif\" alt=\"𮧬\" title=\"𮧬\" />日啰(二合)跛舍麼贺句噜(二合)驮羯洒耶娑(去)莽盐吽吽」","level":0},{"t":"锁真言曰：","level":0},{"t":"「唵<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02594.gif\" alt=\"𮧬\" title=\"𮧬\" />日啰(二合)寒普(二合)咤麼贺句噜(二合)驮羯洒耶娑(去)莽盐鑁」","level":0},{"t":"铃真言：","level":0},{"t":"「唵<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02594.gif\" alt=\"𮧬\" title=\"𮧬\" />日啰(二合)吠舍麼贺句噜(二合)驮羯洒耶娑(去)莾盐斛」","level":0},{"t":"嬉戏真言曰：","level":0},{"t":"「唵<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02594.gif\" alt=\"𮧬\" title=\"𮧬\" />日啰(二合)攞细麼贺句噜(二合)驮羯洒耶娑(去)莽盐斛」","level":0},{"t":"又前观智身，自心流婀字，","level":0,"quote":true},{"t":"面前成月轮，即出生金刚。","level":0,"quote":true},{"t":"五峰流猛焰，生三悦我是，","level":0,"quote":true},{"t":"又丈於世尊，即召满空佛。","level":0,"quote":true},{"t":"入金刚锁悦，又称明显言，","level":0,"quote":true},{"t":"金刚即变成，吽迦啰金刚，","level":0,"quote":true},{"t":"暴怒处月轮，身流火光聚，","level":0,"quote":true},{"t":"遍体玄青色，大自在天王，","level":0,"quote":true},{"t":"妃乌摩为座，历然分明见，","level":0,"quote":true},{"t":"即四印加持，又示羯摩印。","level":0,"quote":true},{"t":"满月已五灌，宝鬘甲拍等，","level":0,"quote":true},{"t":"施内外供养，自住萨埵身，","level":0,"quote":true},{"t":"扭掷金刚杵，震动大千界。","level":0,"quote":true},{"t":"诵百八名赞，都请诸圣贤，","level":0,"quote":true},{"t":"钩召索引入，锁止铃悦喜，","level":0,"quote":true},{"t":"四明召智身，入自体无二。","level":0,"quote":true},{"t":"又四加示誓。满月已五灌，","level":0,"quote":true},{"t":"宝鬘甲拍已，又陈内外供，","level":0,"quote":true},{"t":"即起平身立，举右足左旋，","level":0,"quote":true},{"t":"摄彼傲慢者，大自在欲王。","level":0,"quote":true},{"t":"扑至於地已，定按於彼顶，","level":0,"quote":true},{"t":"慧践彼王妃，乌摩乳房上，","level":0,"quote":true},{"t":"摧彼我慢故，以足加於顶。","level":0,"quote":true},{"t":"被害殒此已，灰严界成佛，","level":0,"quote":true},{"t":"住是三昧时，极力频身蹋，","level":0,"quote":true},{"t":"或身掉出污，当知尊摄受。","level":0,"quote":true},{"t":"定慧金刚拳，二地结风背，","level":0,"quote":true},{"t":"循身观相好，历然见如前，","level":0,"quote":true},{"t":"旋时诵足钩。","level":0,"quote":true},{"t":"真言曰：","level":0},{"t":"「唵(引)迦(引)那(引)羯哩洒(二合)庾嚩日啰(二合)吽(短)」","level":0},{"t":"步蹋时真言曰：","level":0},{"t":"「唵(引)嚩日啰(二合引)麼(半)吽(短)」","level":0},{"t":"又见自心月，金刚具五峰，","level":0,"quote":true},{"t":"中有所持明，流射金刚火。","level":0,"quote":true},{"t":"住是大三昧，持根本真言，","level":0,"quote":true},{"t":"或心一字明，或业心中心，","level":0,"quote":true},{"t":"擿枳王真言。住定疲极已，","level":0,"quote":true},{"t":"方坐诵赞叹，陈供及发愿。","level":0,"quote":true},{"t":"即作解脱法，以本法四印，","level":0,"quote":true},{"t":"四处掣开之。","level":0,"quote":true},{"t":"心上真言曰：","level":0},{"t":"「唵(引)萨怛嚩(二合)嚩日啰(二合)惹嚩(二合)罗麼(引)罗矩噜(二合引)驮吽(短)发咤(半音)目」","level":0},{"t":"又以真实王，四印掣开之。","level":0,"quote":true},{"t":"心上真言曰：","level":0},{"t":"「唵(引)萨怛嚩(二合)嚩日哩(二合)吽(短)」","level":0},{"t":"圣众还宫已，即宝鬘甲拍，","level":0,"quote":true},{"t":"护此常恒身。四礼五向等，","level":0,"quote":true},{"t":"餘皆同诸教，降三世瑜伽。","level":0,"quote":true},{"t":"二羽印当心，慧手持五钴，","level":0,"quote":true},{"t":"努臂如下拟，次箭剑直执，","level":0,"quote":true},{"t":"定上五钴钩，次弓次执索，","level":0,"quote":true},{"t":"皆直引臂持，四面正青色，","level":0,"quote":true},{"t":"右黄左绿色，后红咸忿怒，","level":0,"quote":true},{"t":"自在天王妃，为座如前说。","level":0,"quote":true},{"t":"吽迦啰金刚，作如是相好。","level":0,"quote":true},{"t":"金刚瑜伽降三世成就极深密门一卷","level":0}]]