[[{"t":"金刚顶普贤瑜伽大教王经大乐不空金刚萨埵一切时方成就仪","level":0},{"t":"稽首礼大密，从持金刚生，","level":0,"quote":true},{"t":"密言易成就，我说念诵仪。","level":0,"quote":true},{"t":"密语有先应，发心尽利乐，","level":0,"quote":true},{"t":"无餘有情界，随意称诵此，","level":0,"quote":true},{"t":"性成就密言，应发菩提心。","level":0,"quote":true},{"t":"(如上名愿菩提心)","level":0},{"t":"唵萨嚩喻誐质多母答跛(二合)那夜弭","level":0},{"t":"由才诵密言，发菩提心故，","level":0,"quote":true},{"t":"弥除一切障，获诸乐悦意，","level":0,"quote":true},{"t":"不被众魔阻，等同正遍知，","level":0,"quote":true},{"t":"受诸世间供。复观一切法，","level":0,"quote":true},{"t":"色无自性空(以上名胜义菩提心)，","level":0,"quote":true},{"t":"即彻见本心，圆白如满月，","level":0,"quote":true},{"t":"五峰素金刚，踊立月轮面。","level":0,"quote":true},{"t":"即观智金刚，变成婆伽梵，","level":0,"quote":true},{"t":"金刚萨埵身，形服如皓月，","level":0,"quote":true},{"t":"坐白莲华台，五佛以严冠，","level":0,"quote":true},{"t":"备饰装严具，背炽然赤光，","level":0,"quote":true},{"t":"依月轮中住，又以五金刚，","level":0,"quote":true},{"t":"装严心月轮。如是观己身，","level":0,"quote":true},{"t":"以二金刚拳，左胯右当心，","level":0,"quote":true},{"t":"名金刚萨埵，慢印吽迦罗，","level":0,"quote":true},{"t":"慧趺押定股，名普贤结跏。","level":0,"quote":true},{"t":"又结妙适悦，三摩耶密印，","level":0,"quote":true},{"t":"诸度聚应缚，力智以为根，","level":0,"quote":true},{"t":"禅形入彼门，徐动安应逼，","level":0,"quote":true},{"t":"念诵素啰多，塞怛鑁密语。","level":0,"quote":true},{"t":"由此印密言，圣有入己体，","level":0,"quote":true},{"t":"印心额喉顶，便作三昧拳，","level":0,"quote":true},{"t":"禅智并入中，进力屈跓背，","level":0,"quote":true},{"t":"诵唵嚩日罗，母瑟智鑁已，","level":0,"quote":true},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03879.gif\" alt=\"𢫱\" title=\"𢫱\" />为二业拳，诵萨缚悉地。","level":0,"quote":true},{"t":"复陈前幔印，大乐金刚心，","level":0,"quote":true},{"t":"密语吽迦罗。次合金刚掌，","level":0,"quote":true},{"t":"忍愿如莲合，进力安初节，","level":0,"quote":true},{"t":"顶额右旋置，而成五佛冠，","level":0,"quote":true},{"t":"密语次当演。顶中遍照佛，","level":0,"quote":true},{"t":"当诵唵<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03878.gif\" alt=\"㒒\" title=\"㒒\" />欠。阿閦佛发际，","level":0,"quote":true},{"t":"当诵嚩日啰，萨埵成密语。","level":0,"quote":true},{"t":"顶右宝生佛，亦称嚩日罗，","level":0,"quote":true},{"t":"罗怛曩成旬。后无量寿佛，","level":0,"quote":true},{"t":"又诵嚩日啰，达磨密语成。","level":0,"quote":true},{"t":"顶左诵不空，成就佛密语，","level":0,"quote":true},{"t":"嚩日啰羯磨。分佛身胜印，","level":0,"quote":true},{"t":"为二金刚拳，交臂当於额，","level":0,"quote":true},{"t":"分拳至玉杬，进力节相绕，","level":0,"quote":true},{"t":"三系金刚鬘，分手两耳傍，","level":0,"quote":true},{"t":"从檀慧历散，蕴藉垂缯带，","level":0,"quote":true},{"t":"称诵嚩日啰，莽攞<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00805.gif\" alt=\"𤚥\" title=\"𤚥\" />鑁已，","level":0,"quote":true},{"t":"由此印等成，受具足灌顶。","level":0,"quote":true},{"t":"为说圣众故，参差掌三拍，","level":0,"quote":true},{"t":"诵嚩日罗覩，史也谷密语，","level":0,"quote":true},{"t":"由拍金刚掌，速成萨埵体。","level":0,"quote":true},{"t":"次当遍安立，眷属十六尊，","level":0,"quote":true},{"t":"围绕大安乐，眼前处於前，","level":0,"quote":true},{"t":"二手持弓箭，形服莲红色，","level":0,"quote":true},{"t":"以二金刚拳，弯弓如射仪，","level":0,"quote":true},{"t":"诵弱嚩日啰，尔哩瑟致娑，","level":0,"quote":true},{"t":"也计麼咤句。右计里枳罗，","level":0,"quote":true},{"t":"交臂金刚拳，右内把金刚，","level":0,"quote":true},{"t":"月色形莲眼，诵吽嚩日罗，","level":0,"quote":true},{"t":"计里枳隷吽。后更持幢幡，","level":0,"quote":true},{"t":"麼迦罗为首，慧拳竖臂肘，","level":0,"quote":true},{"t":"定拳力智水，形眼类青莲，","level":0,"quote":true},{"t":"鑁嚩曰哩抳，娑麼啰啰咤。","level":0,"quote":true},{"t":"诵此密语已，二拳且腰侧，","level":0,"quote":true},{"t":"向左小低头，诵谷嚩日啰，","level":0,"quote":true},{"t":"迦冥涅嚩哩，怛览密语已，","level":0,"quote":true},{"t":"金刚幔居左，意体莲华黄。","level":0,"quote":true},{"t":"前右隅时春，二手捧华盘，","level":0,"quote":true},{"t":"形服莲华白，二拳仰上散，","level":0,"quote":true},{"t":"名华满空界，当诵唵末度，","level":0,"quote":true},{"t":"嚩日啰具唵。后右隅时雨，","level":0,"quote":true},{"t":"持𬬻献焚香，身色类悬云，","level":0,"quote":true},{"t":"覆二向下按，香云遍气馥，","level":0,"quote":true},{"t":"诵彼密语唵，嚩日啰铭祗，","level":0,"quote":true},{"t":"愚鲁愚鲁已。后左隅时秋，","level":0,"quote":true},{"t":"赤色持灯烛，禅智并相逼，","level":0,"quote":true},{"t":"金刚灯周擢，即诵唵舍罗，","level":0,"quote":true},{"t":"嚩曰哩揞句。雨散拭自胸，","level":0,"quote":true},{"t":"乃成涂香契，诵唵嚩日罗，","level":0,"quote":true},{"t":"势始隷吽吽，捧献涂香钵，","level":0,"quote":true},{"t":"安住前左隅，冬身莲衣黄。","level":0,"quote":true},{"t":"於外曼荼罗，四隅当安立，","level":0,"quote":true},{"t":"华方名嬉戏，覆二拳当心，","level":0,"quote":true},{"t":"旋诵系啰底，嚩日啰尾攞，","level":0,"quote":true},{"t":"悉尔怛罗咤。扬掌指口旁，","level":0,"quote":true},{"t":"笑诵系罗底，嚩日啰贺细，","level":0,"quote":true},{"t":"贺贺迦罗也，名笑住云外。","level":0,"quote":true},{"t":"秋外金刚歌，禅执梵箜篌，","level":0,"quote":true},{"t":"定拳力微屈，弯臂如箜篌，","level":0,"quote":true},{"t":"慧拳进亦然，禅定臂膊间。","level":0,"quote":true},{"t":"歌唱系啰底，嚩日罗儗帝，","level":0,"quote":true},{"t":"帝帝密语成。旋舞轮诸度，","level":0,"quote":true},{"t":"散拳还成拳，左右颊转上，","level":0,"quote":true},{"t":"金刚掌顶散，诵系啰底嚩，","level":0,"quote":true},{"t":"日啰尔哩帝，吠波吠波已，","level":0,"quote":true},{"t":"舞处冬外隅。如是四供养，","level":0,"quote":true},{"t":"并同金色身，檀慧相钩结，","level":0,"quote":true},{"t":"交臂申力度，屈进初如钩，","level":0,"quote":true},{"t":"当诵嚩曰<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03298.gif\" alt=\"𠻴\" title=\"𠻴\" />，矩势弱密语，","level":0,"quote":true},{"t":"持钩护前门。即以进力跓，","level":0,"quote":true},{"t":"如环成罗索，又诵嚩日罗，","level":0,"quote":true},{"t":"播势吽密语，执索守右门。","level":0,"quote":true},{"t":"进力极拘结，踀即成乃诵，","level":0,"quote":true},{"t":"嚩日啰商羯，隷鑁密语已，","level":0,"quote":true},{"t":"中踀住后门。不改前印相，","level":0,"quote":true},{"t":"当心微摇动，名震金刚铃，","level":0,"quote":true},{"t":"嚩日啰健致，谷密语诵已，","level":0,"quote":true},{"t":"执磬护左门。四摄尊形色，","level":0,"quote":true},{"t":"应内四泥微。如上十六尊，","level":0,"quote":true},{"t":"成尔妙安客，美艶备恣态，","level":0,"quote":true},{"t":"处莲普贤跏，皆依月轮住，","level":0,"quote":true},{"t":"一切庄严具，而用授饰身，","level":0,"quote":true},{"t":"并载五佛冠，裳莲随体色，","level":0,"quote":true},{"t":"皆已染悦目，瞻视持金刚。","level":0,"quote":true},{"t":"如是安立已，成□曼荼罗，","level":0,"quote":true},{"t":"彼中如轮形，八柱而严饰，","level":0,"quote":true},{"t":"金刚胜柱间，月轮而庄严。","level":0,"quote":true},{"t":"彼外曼荼罗，四方应四门，","level":0,"quote":true},{"t":"四外门相应，门户交合闻，","level":0,"quote":true},{"t":"填饰金刚宝。蔓荼罗诸角，","level":0,"quote":true},{"t":"半月而庄严，璎珞铃缯幡，","level":0,"quote":true},{"t":"处处而悬烈，微风吹摇激，","level":0,"quote":true},{"t":"出和雅畅音。周围金刚界，","level":0,"quote":true},{"t":"虚空为宫殿，蔓荼罗处中。","level":0,"quote":true},{"t":"如是谛思惟，一切时方住，","level":0,"quote":true},{"t":"自心所安立，自身为本尊。","level":0,"quote":true},{"t":"如是等供养，围绕献己身，","level":0,"quote":true},{"t":"行住常随逐。所见一切色，","level":0,"quote":true},{"t":"观彼等皆空，复思本尊身，","level":0,"quote":true},{"t":"诵唵迦路目，佉萨嚩达磨，","level":0,"quote":true},{"t":"拏摩尔努半，曩怛袜密语，","level":0,"quote":true},{"t":"或草称唵字。自胜解思惟，","level":0,"quote":true},{"t":"涂香灯焚香、华鬘及饮食、","level":0,"quote":true},{"t":"衣服宝幡盖、扇拂幡铃现、","level":0,"quote":true},{"t":"歌舞胜宫殿，遍诸虚空界，","level":0,"quote":true},{"t":"我今皆变化，一切胜供养，","level":0,"quote":true},{"t":"众圣受用之。即诵四赞王，","level":0,"quote":true},{"t":"射抱幢幔印，轮唱金刚欲，","level":0,"quote":true},{"t":"萨嚩努逻誐，苏佉萨怛莾，","level":0,"quote":true},{"t":"曩婆放前仪。怛鑁嚩日啰，","level":0,"quote":true},{"t":"萨埵跛啰麼，索啰跢妙陀，","level":0,"quote":true},{"t":"婆嚩铭磨诃，苏佉尔哩住，","level":0,"quote":true},{"t":"縒啰也那幢。钵啰底幡<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03925.gif\" alt=\"𭀍\" title=\"𭀍\" />，","level":0,"quote":true},{"t":"悉地者攞具，钵啰拏多慢。","level":0,"quote":true},{"t":"由此金刚歌，大乐随爱乐，","level":0,"quote":true},{"t":"适悦为坚固，皆得如意成。","level":0,"quote":true},{"t":"以妙适悦言，随分诵婀字，","level":0,"quote":true},{"t":"诸法本不生，当知如是义。","level":0,"quote":true},{"t":"大乐体不空，常诵吽迦罗，","level":0,"quote":true},{"t":"金刚孕法印，随意安密言，","level":0,"quote":true},{"t":"吽迦啰或餘。每诵发光焰，","level":0,"quote":true},{"t":"遍出毛孔中，如素颇胝迦，","level":0,"quote":true},{"t":"日现皓月光。身口心金刚，","level":0,"quote":true},{"t":"皆作是谛观，成就诸教法。","level":0,"quote":true},{"t":"金刚语念诵，唇齿合无声，","level":0,"quote":true},{"t":"微动舌念诵，作如是修习，","level":0,"quote":true},{"t":"乃至满一月，或二或六月，","level":0,"quote":true},{"t":"所观相皆现，自获萨埵身，","level":0,"quote":true},{"t":"安圣众身前。以唵迦<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00080.gif\" alt=\"𡀔\" title=\"𡀔\" />献，","level":0,"quote":true},{"t":"又陈八供养，歌诵四赞王，","level":0,"quote":true},{"t":"金刚嚩并合，忍愿度如幢，","level":0,"quote":true},{"t":"诵唵讫哩姤，嚩萨嚩萨埵，","level":0,"quote":true},{"t":"捺多也他努，誐萨縒持挽，","level":0,"quote":true},{"t":"没驮尾洒焰，补曩逻誐麼，","level":0,"quote":true},{"t":"那色覩唵嚩，日啰萨埵目。","level":0,"quote":true},{"t":"诵此密言已，以印顶上散，","level":0,"quote":true},{"t":"拳送诸圣众，从顶而流出。","level":0,"quote":true},{"t":"若欲一切时，依此仪作意，","level":0,"quote":true},{"t":"见一切色等，皆想献本尊。","level":0,"quote":true},{"t":"观身色空相，即是我本尊，","level":0,"quote":true},{"t":"作如是思惟，即名胜解眼。","level":0,"quote":true},{"t":"所覩彼彼色，皆空观又观，","level":0,"quote":true},{"t":"金刚萨埵身，此乃已与尊，","level":0,"quote":true},{"t":"当知皆本空，即同为一体。","level":0,"quote":true},{"t":"住如是瑜伽，行住若坐卧，","level":0,"quote":true},{"t":"随意念诵光，十万遍终目，","level":0,"quote":true},{"t":"尽夜不寝息，念诵至晨朝。","level":0,"quote":true},{"t":"又於一切时，用前妙适悦，","level":0,"quote":true},{"t":"三麼耶及鬘，各诵本密语，","level":0,"quote":true},{"t":"自身成本尊，心安系瑜伽。","level":0,"quote":true},{"t":"后当於四时，道场中念诵，","level":0,"quote":true},{"t":"共满十万遍。乃至末后夜，","level":0,"quote":true},{"t":"准前不寝息，至明念诵之，","level":0,"quote":true},{"t":"不久当成就。本尊体佛体，","level":0,"quote":true},{"t":"剋获尚不难，何况诸悉地。","level":0,"quote":true},{"t":"善贤阿阇梨，集此微妙义，","level":0,"quote":true},{"t":"我略说大经，缵集极秘旨。","level":0,"quote":true},{"t":"不入曼荼罗，擅用结罪垢，","level":0,"quote":true},{"t":"及诸教所说，犯大重罪障，","level":0,"quote":true},{"t":"无能除灭者，结金刚萨埵，","level":0,"quote":true},{"t":"大印尽能灭。修此三昧者，","level":0,"quote":true},{"t":"近意作诸法，一切教不说，","level":0,"quote":true},{"t":"皆随意成就。才结大印时，","level":0,"quote":true},{"t":"如来咸敬礼，密语者即为，","level":0,"quote":true},{"t":"诸佛之至宰。大印威德力，","level":0,"quote":true},{"t":"寂胜无伦疋，不作诸仪轨，","level":0,"quote":true},{"t":"唯结一大印，无能为障者，","level":0,"quote":true}],[{"t":"速疾得成就。护本三麼耶，","level":0,"quote":true},{"t":"不令身心苦，受乐取成就。","level":0,"quote":true},{"t":"普愿诸有情，信受入此法，","level":0,"quote":true},{"t":"悉皆速成就，金刚萨埵身，","level":0,"quote":true},{"t":"遍照坚固体，及诸随愿身。","level":0,"quote":true},{"t":"普贤瑜伽经大乐金刚萨埵成就仪轨","level":0},{"t":"大历三年八月十四日西京青龙寺僧愿力书写梵汉字记","level":0},{"t":"应德元年九月二十八日辰剋於桂林房以前唐院唐本传写了件唐本千手仪轨在谛耳良　记之","level":0}]]