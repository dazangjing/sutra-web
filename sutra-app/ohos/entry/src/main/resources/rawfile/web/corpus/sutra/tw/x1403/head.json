{"id":"x1403","title":"天如惟則禪師語錄","titleTrad":"天如惟則禪師語錄","byline":"小師 善遇 編","bylineLabel":"著者·译者","dynasty":"","division":"诸宗部","canon":"X1403","canonName":"新纂卍續藏","volume":"X1403","juanCount":9,"textLength":150744,"imageCount":0,"summary":"","tags":["诸宗部","新纂卍續藏"],"order":2621,"guide":"","chunks":50,"toc":[{"level":3,"text":"夫知　制誥同修　國史長沙楊宗瑞拜序"},{"level":3,"text":"天如禪師語錄序"},{"level":3,"text":"同知制誥兼　國史院編修官臨川危素序"},{"level":3,"text":"天如禪師別錄序"},{"level":3,"text":"等處儒學副提弟子李祁謹序"},{"level":3,"text":"師子林別錄序"},{"level":2,"text":"三百餘會所說之法，從一字一句，一卷一"},{"level":3,"text":"序"},{"level":3,"text":"照堂長老義感集序"},{"level":3,"text":"銅佛贊頌序"},{"level":3,"text":"道林訓上人遊方序"},{"level":3,"text":"送才侍者歸葬師序"},{"level":3,"text":"血書法華經序"},{"level":3,"text":"錢王銅塔詩卷序"},{"level":3,"text":"湛碧軒序"},{"level":3,"text":"千溪易名記後序"},{"level":3,"text":"五百尊者名號序"},{"level":3,"text":"送德藏主序"},{"level":3,"text":"首楞嚴經會解序"},{"level":3,"text":"助道。謂見道而後脩道，脩道而後證果，此常途之序"}],"chunksPerFile":20}