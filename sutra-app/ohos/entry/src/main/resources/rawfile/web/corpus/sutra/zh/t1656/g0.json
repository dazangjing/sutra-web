[[{"t":"宝行王正论一卷","level":0},{"t":"陈天竺三藏真谛译","level":0}],[{"t":"安乐解脱品第一","level":3},{"t":"解脱一切障，圆德所庄严，","level":0,"quote":true},{"t":"礼一切智尊，众生真善友。","level":0,"quote":true},{"t":"正法决定善，为爱法大王，","level":0,"quote":true},{"t":"我当说由法，流注法器人。","level":0,"quote":true},{"t":"先说乐因法，后辩解脱法，","level":0,"quote":true},{"t":"众生前安乐，次后得解脱。","level":0,"quote":true},{"t":"善道具名乐，解脱谓惑尽，","level":0,"quote":true},{"t":"略说此二因，唯信智二根。","level":0,"quote":true},{"t":"因信能持法，由智如实了，","level":0,"quote":true},{"t":"二中智最胜，先藉信发行。","level":0,"quote":true},{"t":"由痴贪瞋怖，而能不坏法，","level":0,"quote":true},{"t":"当知是有信，吉祥乐名器。","level":0,"quote":true},{"t":"已能熟简择，身口意三业，","level":0,"quote":true},{"t":"恒利益自他，说为有智人。","level":0,"quote":true},{"t":"杀生盗邪婬、妄言及两舌、","level":0,"quote":true},{"t":"恶骂不应语、贪瞋与邪见、","level":0,"quote":true},{"t":"此法名十恶，翻此即十善。","level":0,"quote":true},{"t":"离酒清净命，无逼恼心施，","level":0,"quote":true},{"t":"供养所应敬，略说法当尔。","level":0,"quote":true},{"t":"若但行苦行，决不生善法，","level":0,"quote":true},{"t":"以离智悲故；若唯有苦行，","level":0,"quote":true},{"t":"不能除损他，与救济利益，","level":0,"quote":true},{"t":"施戒修所明，正法大夷路。","level":0,"quote":true},{"t":"若弃行邪道，自苦受牛罚，","level":0,"quote":true},{"t":"是生死旷泽，无饮食树阴，","level":0,"quote":true},{"t":"或狼所食噉，长远於中行。","level":0,"quote":true},{"t":"因杀生短寿，逼恼招多病，","level":0,"quote":true},{"t":"由盗致乏财，侵他境多怨，","level":0,"quote":true},{"t":"妄语遭诽谤，两舌亲爱离，","level":0,"quote":true},{"t":"恶口闻不爱，绮语他憎嫉，","level":0,"quote":true},{"t":"由贪害所求，瞋恚受惊怖，","level":0,"quote":true},{"t":"邪见生僻执，饮酒心讷乱，","level":0,"quote":true},{"t":"不施故贫穷，邪命逢欺诳，","level":0,"quote":true},{"t":"不恭生卑贱，嫉妬无威德，","level":0,"quote":true},{"t":"恒恨形色丑，不问聪故痴。","level":0,"quote":true},{"t":"此报在人道，先已受恶趣，","level":0,"quote":true},{"t":"杀生等罪法，如所说果报；","level":0,"quote":true},{"t":"无贪等及业，说名善习因。","level":0,"quote":true},{"t":"恶修及诸苦，皆从邪法生；","level":0,"quote":true},{"t":"诸善道安乐，皆因善法起，","level":0,"quote":true},{"t":"常离一切恶，恒行一切善。","level":0,"quote":true},{"t":"由身口意业，应知此二法，","level":0,"quote":true},{"t":"由一法能脱，地狱等四趣，","level":0,"quote":true},{"t":"第二法能感，人天王富乐，","level":0,"quote":true},{"t":"由定梵住空，得受梵等乐，","level":0,"quote":true},{"t":"如是略说名，乐因及乐果。","level":0,"quote":true},{"t":"复次解脱法，微细深难见，","level":0,"quote":true},{"t":"无耳心凡夫，闻则生惊怖。","level":0,"quote":true},{"t":"我无当不生，现来我所无，","level":0,"quote":true},{"t":"凡人思此畏，智者怖永尽。","level":0,"quote":true},{"t":"世间我见生，他事执所系，","level":0,"quote":true},{"t":"佛由至道证，依悲为他说。","level":0,"quote":true},{"t":"我有及我所，此二实皆虚，","level":0,"quote":true},{"t":"由见如实理，二执不更生。","level":0,"quote":true},{"t":"诸阴我执生，我执由义虚，","level":0,"quote":true},{"t":"若种子不实，芽等云何真？","level":0,"quote":true},{"t":"若见阴不实，我见则不生，","level":0,"quote":true},{"t":"由我见灭尽，诸阴不更起。","level":0,"quote":true},{"t":"如人依净镜，得见自面影，","level":0,"quote":true},{"t":"此影但可见，一向不真实。","level":0,"quote":true},{"t":"我见亦如是，依阴得显现，","level":0,"quote":true},{"t":"如实捡非有，犹如镜面影。","level":0,"quote":true},{"t":"如人不执镜，不见自面影，","level":0,"quote":true},{"t":"如此若析阴，我见即不有。","level":0,"quote":true},{"t":"因闻如是义，大净命阿难，","level":0,"quote":true},{"t":"即得净法眼，恒为他说此。","level":0,"quote":true},{"t":"阴执乃至在，我见亦恒存，","level":0,"quote":true},{"t":"由有我见故，业及有恒有。","level":0,"quote":true},{"t":"生死轮三节，无初中后转，","level":0,"quote":true},{"t":"譬如旋火轮，生起互相由。","level":0,"quote":true},{"t":"从自他及二，三世不有故，","level":0,"quote":true},{"t":"证此我见灭，次业报亦然。","level":0,"quote":true},{"t":"如此见因果，生起及灭尽，","level":0,"quote":true},{"t":"故不执实有，世间有及无。","level":0,"quote":true},{"t":"愚人闻此法，能尽一切苦，","level":0,"quote":true},{"t":"由无智生怖，於无怖畏处。","level":0,"quote":true},{"t":"涅槃处无此，汝云何生怖？","level":0,"quote":true},{"t":"如所说实空，云何令汝怖？","level":0,"quote":true},{"t":"解脱无我阴，汝若受此法，","level":0,"quote":true},{"t":"舍我及诸阴，汝云何不乐？","level":0,"quote":true},{"t":"无尚非涅槃，何况当是有？","level":0,"quote":true},{"t":"有无执净尽，佛说名涅槃。","level":0,"quote":true},{"t":"若略说邪见，谓拨无因果，","level":0,"quote":true},{"t":"此今非福满，恶道因最重。","level":0,"quote":true},{"t":"若略说正见，谓信有因果，","level":0,"quote":true},{"t":"能令福德满，善道因最上。","level":0,"quote":true},{"t":"由智有无寂，超度福非福，","level":0,"quote":true},{"t":"故离善恶道，佛说名解脱。","level":0,"quote":true},{"t":"若见生有因，智人舍无执，","level":0,"quote":true},{"t":"由见灭共因，是故舍有执。","level":0,"quote":true},{"t":"先俱生二因，实义则非因，","level":0,"quote":true},{"t":"假名无依故，及生非实故。","level":0,"quote":true},{"t":"若此有彼有，譬如长及短，","level":0,"quote":true},{"t":"由此生彼生，譬如灯与光。","level":0,"quote":true},{"t":"先长后为短，不然非性故，","level":0,"quote":true},{"t":"光明不生故，灯亦非实有。","level":0,"quote":true},{"t":"如此因果生，若见不执无，","level":0,"quote":true},{"t":"已信世真实，由乱心所生。","level":0,"quote":true},{"t":"见灭非虚故，即证得真如，","level":0,"quote":true},{"t":"是故不执有，不依二解脱。","level":0,"quote":true},{"t":"色是远所见，若近最分明，","level":0,"quote":true},{"t":"鹿渴若实已，云何近不见？","level":0,"quote":true},{"t":"若远於实智，即见世间有，","level":0,"quote":true},{"t":"证实则不见，无相如鹿渴。","level":0,"quote":true},{"t":"如鹿渴似水，非水非实物，","level":0,"quote":true},{"t":"如此阴似人，非人非实法。","level":0,"quote":true},{"t":"计鹿渴为水，往彼若饮此，","level":0,"quote":true},{"t":"若无执为水，如此人愚痴。","level":0,"quote":true},{"t":"世间如鹿渴，若执实有无，","level":0,"quote":true},{"t":"此即是无明，痴故无解脱。","level":0,"quote":true},{"t":"执无堕恶趣，执有生善道，","level":0,"quote":true},{"t":"若能知如实，不二依解脱。","level":0,"quote":true},{"t":"不乐有无执，由择真实义，","level":0,"quote":true},{"t":"若堕於无执，何不说堕有？","level":0,"quote":true},{"t":"若言由破有，义至故堕无，","level":0,"quote":true},{"t":"如此破无故，云何不堕有？","level":0,"quote":true},{"t":"无言行及心，由依菩提故，","level":0,"quote":true},{"t":"若说彼堕无，何因不堕有？","level":0,"quote":true},{"t":"僧佉鞞世师，尼揵说人阴，","level":0,"quote":true},{"t":"约世汝问彼，若说过有无，","level":0,"quote":true},{"t":"是不可言法，以过有无故。","level":0,"quote":true},{"t":"汝应知甚深，佛正教甘露，","level":0,"quote":true},{"t":"如晓无去来，亦无一念住，","level":0,"quote":true},{"t":"若体过三世，何世为实有？","level":0,"quote":true},{"t":"二世无去来，现在实不住，","level":0,"quote":true},{"t":"世生及住灭，此言云何实？","level":0,"quote":true},{"t":"若恒有变异，何法不念灭？","level":0,"quote":true},{"t":"若无念念灭，云何有变异？","level":0,"quote":true},{"t":"若言念念灭，分具分灭故，","level":0,"quote":true},{"t":"不等证见故，此二无道理。","level":0,"quote":true},{"t":"若念灭皆尽，云何有故物？","level":0,"quote":true},{"t":"若坚无念灭，故物云何成？","level":0,"quote":true},{"t":"如刹那后际，前中际亦有，","level":0,"quote":true},{"t":"由刹那三分，故世念无住。","level":0,"quote":true},{"t":"是一念三际，应择际如念，","level":0,"quote":true},{"t":"前中后三际，不由自他成。","level":0,"quote":true},{"t":"非一念分故，若无分何有？","level":0,"quote":true},{"t":"离一多云何？离有何法无？","level":0,"quote":true},{"t":"由灭及对治，若言有成无，","level":0,"quote":true},{"t":"此无及对治，何法有无故？","level":0,"quote":true},{"t":"是故世涅槃，由义不成有，","level":0,"quote":true},{"t":"世间有后际，他问佛默然。","level":0,"quote":true},{"t":"是尊一切智，故智人识佛，","level":0,"quote":true},{"t":"由此甚深法，不说非器处。","level":0,"quote":true},{"t":"如此解脱法，甚深无系摄，","level":0,"quote":true},{"t":"诸佛一切智，故说无依底，","level":0,"quote":true},{"t":"於无依著法，过有无二边。","level":0,"quote":true},{"t":"世人受依著，由痴惊怖失，","level":0,"quote":true},{"t":"彼自失坏他，怖畏无依处。","level":0,"quote":true},{"t":"王愿汝不动，莫由彼自坏，","level":0,"quote":true},{"t":"为汝成不坏，我当说真理。","level":0,"quote":true},{"t":"由依无倒合，离有无二执，","level":0,"quote":true},{"t":"此过福非福，甚深义明了。","level":0,"quote":true},{"t":"非身见怖空，二人境当说，","level":0,"quote":true},{"t":"四大及空识，一聚俱非人。","level":0,"quote":true},{"t":"若合离非人，云何执人有？","level":0,"quote":true},{"t":"如六界非人，聚故虚非实，","level":0,"quote":true},{"t":"一一界同然，由聚故非实。","level":0,"quote":true},{"t":"阴非我我所，离阴我不显，","level":0,"quote":true},{"t":"不如薪火杂，何依阴成我？","level":0,"quote":true},{"t":"地界非三大，地中亦无三，","level":0,"quote":true},{"t":"三中亦无地，相离互不成。","level":0,"quote":true},{"t":"地水火风大，各自性不成，","level":0,"quote":true},{"t":"一离三不成，三离一亦尔。","level":0,"quote":true},{"t":"一三及三一，相离若不成，","level":0,"quote":true},{"t":"各各自不成，彼相离云何？","level":0,"quote":true},{"t":"若各离自成，离薪何无火，","level":0,"quote":true},{"t":"动碍及相聚，水风地亦然。","level":0,"quote":true},{"t":"若火不自成，三云何各立？","level":0,"quote":true},{"t":"三大缘生义，相违云何成？","level":0,"quote":true},{"t":"若彼各自成，云何更互有？","level":0,"quote":true},{"t":"若各自不成，云何互成有？","level":0,"quote":true},{"t":"若言不相离，诸大各自成，","level":0,"quote":true},{"t":"不杂则不共，若杂非独成。","level":0,"quote":true},{"t":"诸大非各成，云何各性相？","level":0,"quote":true},{"t":"各成无偏多，故相假名说。","level":0,"quote":true},{"t":"色声香味触，简择义如大，","level":0,"quote":true},{"t":"眼色识无明，业生择亦尔。","level":0,"quote":true},{"t":"作者业及事，数合因果世，","level":0,"quote":true},{"t":"短长及名想，非想择亦然。","level":0,"quote":true},{"t":"地水风火等，长短及小大，","level":0,"quote":true},{"t":"善恶言识智，智中灭无餘。","level":0,"quote":true},{"t":"如识处无形，无边遍一切，","level":0,"quote":true},{"t":"此中地等大，一切皆灭尽。","level":0,"quote":true},{"t":"於此无相智，短长善恶业，","level":0,"quote":true},{"t":"名色及诸阴，如此灭无餘。","level":0,"quote":true},{"t":"如此等於识，由无明先有，","level":0,"quote":true},{"t":"於识若起智，此等后皆尽。","level":0,"quote":true},{"t":"如是等世法，是然识火薪，","level":0,"quote":true},{"t":"由实量火光，世识薪烧尽。","level":0,"quote":true},{"t":"由痴别有无，后简择真如，","level":0,"quote":true},{"t":"寻有既不得，无云何可得？","level":0,"quote":true},{"t":"由无色所成，故空但名字，","level":0,"quote":true},{"t":"离大何为色？故色亦唯名。","level":0,"quote":true},{"t":"受想行及识，应思如四大，","level":0,"quote":true},{"t":"四大如我虚，六界非人法。","level":0,"quote":true}],[{"t":"宝行王正论杂品第二","level":3},{"t":"如分分析蕉，无餘尽不有，","level":0,"quote":true},{"t":"约六界扸人，尽空亦如是。","level":0,"quote":true},{"t":"是故佛正说，一切法无我，","level":0,"quote":true},{"t":"但六界名法，决判实无我。","level":0,"quote":true},{"t":"我无我二义，如实捡不得，","level":0,"quote":true},{"t":"是故如来遮，我无我二边。","level":0,"quote":true},{"t":"见闻觉知言，佛说无实虚，","level":0,"quote":true},{"t":"二相待成故，此二如实无。","level":0,"quote":true},{"t":"如实捡世间，过实亦过虚，","level":0,"quote":true},{"t":"则世间依实，故堕於有无。","level":0,"quote":true},{"t":"若法遍不如，云何佛得说，","level":0,"quote":true},{"t":"有边及无边，有二与无二？","level":0,"quote":true},{"t":"过去佛无量，现来过算数，","level":0,"quote":true},{"t":"过数众生边，三世由佛显。","level":0,"quote":true},{"t":"世间无长因，此际约世显，","level":0,"quote":true},{"t":"世间过有无，云何佛记边？","level":0,"quote":true},{"t":"由法如此深，於凡秘不说，","level":0,"quote":true},{"t":"说世如幻化，是佛甘露教。","level":0,"quote":true},{"t":"譬如幻化像，生灭尚可见，","level":0,"quote":true},{"t":"此像及生灭，实义捡非有。","level":0,"quote":true},{"t":"世间如幻化，生灭可见尔，","level":0,"quote":true},{"t":"世间及生灭，约实义皆虚。","level":0,"quote":true},{"t":"幻像无从来，去亦无有处，","level":0,"quote":true},{"t":"但迷众生心，由实有不住。","level":0,"quote":true},{"t":"世体过三世，若尔世何实？","level":0,"quote":true},{"t":"谁言说有无？有无实无义。","level":0,"quote":true},{"t":"故佛约四句，不记说世间，","level":0,"quote":true},{"t":"由有无皆虚，此虚不虚故。","level":0,"quote":true},{"t":"是身不净相，麁证智境界，","level":0,"quote":true},{"t":"恒数数所见，尚不入心住，","level":0,"quote":true},{"t":"况正法微细，甚深无依底，","level":0,"quote":true},{"t":"难证於散心，云何可易入？","level":0,"quote":true},{"t":"故佛初成道，舍说欲涅槃，","level":0,"quote":true},{"t":"由见此正法，甚深故难解。","level":0,"quote":true},{"t":"若法非正了，即害不聪人，","level":0,"quote":true},{"t":"由不如执此，堕邪见秽坑。","level":0,"quote":true},{"t":"人识法不明，由自高轻法，","level":0,"quote":true},{"t":"起谤坏自身，下首堕地狱。","level":0,"quote":true},{"t":"譬如胜饮食，偏用遭危害，","level":0,"quote":true},{"t":"若如理量食，得寿力强乐。","level":0,"quote":true},{"t":"若偏解正法，遭苦亦如此；","level":0,"quote":true},{"t":"若能如理解，感乐及菩提。","level":0,"quote":true},{"t":"智人於正法，舍谤及邪执，","level":0,"quote":true},{"t":"於正智起用，故成如意事。","level":0,"quote":true},{"t":"由不了此法，人起长我见，","level":0,"quote":true},{"t":"因此造三业，次生善恶道。","level":0,"quote":true},{"t":"乃至未证法，能除灭我见，","level":0,"quote":true},{"t":"恒敬起正勤，於戒施忍等。","level":0,"quote":true},{"t":"作事法为先，及法为中后，","level":0,"quote":true},{"t":"谓无虚真理，现来汝不沈。","level":0,"quote":true},{"t":"因法现好名，乐临死无怖，","level":0,"quote":true},{"t":"来生受富乐，故应恒事法。","level":0,"quote":true},{"t":"唯法是正治，因法天下爱，","level":0,"quote":true},{"t":"若主感民爱，现来不被诳。","level":0,"quote":true},{"t":"若非法治化，主遭臣厌恶，","level":0,"quote":true},{"t":"由世间憎恶，现来不欢喜。","level":0,"quote":true},{"t":"王法欺诳他，是大难恶道，","level":0,"quote":true},{"t":"恶智邪命论，云何说为正？","level":0,"quote":true},{"t":"若人专诳他，云何说正事？","level":0,"quote":true},{"t":"因此於万生，恒遭他欺诳。","level":0,"quote":true},{"t":"若欲使怨忧，舍失取其德，","level":0,"quote":true},{"t":"己利由此圆，即令怨忧恼。","level":0,"quote":true},{"t":"约施及爱语，利行与同利，","level":0,"quote":true},{"t":"愿汝摄世间，因此弘正法。","level":0,"quote":true},{"t":"王若一实语，如生民坚信，","level":0,"quote":true},{"t":"此如尊妄语，不起他安信。","level":0,"quote":true},{"t":"实意起无违，流靡能利他，","level":0,"quote":true},{"t":"是说名实语，翻此为妄言。","level":0,"quote":true},{"t":"一舍财若明，如能隐王失，","level":0,"quote":true},{"t":"如此主悋贿，能害王众德。","level":0,"quote":true},{"t":"若王静诸恶，德深人爱重，","level":0,"quote":true},{"t":"因此教明王，故应事寂静。","level":0,"quote":true},{"t":"由智王难动，自了不信他，","level":0,"quote":true},{"t":"永不遭欺诳，故决应修智。","level":0,"quote":true},{"t":"依谛舍静智，王则具四善，","level":0,"quote":true},{"t":"如四德正法，人天所赞叹。","level":0,"quote":true},{"t":"能伏说清净，由智悲无垢，","level":0,"quote":true},{"t":"恒共智人集，王法智生长。","level":0,"quote":true},{"t":"善说人难得，听善言亦难，","level":0,"quote":true},{"t":"第三人最胜，能疾行善教。","level":0,"quote":true},{"t":"若善非所爱，已知应疾修，","level":0,"quote":true},{"t":"如药味虽苦，乐差应强服。","level":0,"quote":true},{"t":"寿无病王位，恒应思无常，","level":0,"quote":true},{"t":"次生厌怖想，后专心行法。","level":0,"quote":true},{"t":"见决定应死，死从恶见苦，","level":0,"quote":true},{"t":"智人为现乐，故不应作罪。","level":0,"quote":true},{"t":"见一念无怖，若见后时畏，","level":0,"quote":true},{"t":"若一念心安，云何后不畏？","level":0,"quote":true},{"t":"由酒遭他轻，损事减身力，","level":0,"quote":true},{"t":"由痴行非事，故智人断酒。","level":0,"quote":true},{"t":"围碁等嬉戏，生贪瞋忧谄，","level":0,"quote":true},{"t":"诳妄恶口因，故应恒远离。","level":0,"quote":true},{"t":"婬逸过失生，由想女身净，","level":0,"quote":true},{"t":"寻思女身中，实无一毫净。","level":0,"quote":true},{"t":"女口涎唾器，齿舌垢臭秽，","level":0,"quote":true},{"t":"鼻臭由洟流，目泪种类处，","level":0,"quote":true},{"t":"腹屎尿肠器，餘身骨肉聚，","level":0,"quote":true},{"t":"痴人迷可厌，故贪著此身。","level":0,"quote":true},{"t":"根门最臭秽，是厌恶身因，","level":0,"quote":true},{"t":"於中若生爱，何缘得离欲？","level":0,"quote":true},{"t":"譬如屎尿器，猪好在中戏，","level":0,"quote":true},{"t":"於身不净门，多欲戏亦尔。","level":0,"quote":true},{"t":"此门所以生，为弃身土秽，","level":0,"quote":true},{"t":"痴人邪爱著，不顾己善利。","level":0,"quote":true},{"t":"汝自见一分，屎尿等不净，","level":0,"quote":true},{"t":"此聚说名身，云何汝生爱？","level":0,"quote":true},{"t":"赤白为生种，厕汁所沃养，","level":0,"quote":true},{"t":"如知身不净，何意苦生爱？","level":0,"quote":true},{"t":"秽聚可憎恶，臭湿皮缠裹，","level":0,"quote":true},{"t":"若能处中卧，则爱著女身。","level":0,"quote":true},{"t":"若可爱可憎，衰老及童女，","level":0,"quote":true},{"t":"女身皆不净，汝何处生欲？","level":0,"quote":true},{"t":"设粪聚好色，软滑相端正，","level":0,"quote":true},{"t":"起爱则不应，爱女身亦尔。","level":0,"quote":true},{"t":"内臭极不净，外皮所覆藏，","level":0,"quote":true},{"t":"是死尸种性，云何见不知？","level":0,"quote":true},{"t":"皮不净如衣，不可暂解浣，","level":0,"quote":true},{"t":"云何秽聚皮，可权时汰净？","level":0,"quote":true},{"t":"畫瓶满粪秽，外饰若汝憎，","level":0,"quote":true},{"t":"此身秽种满，云何汝不厌？","level":0,"quote":true},{"t":"若汝憎不净，云何不恶身？","level":0,"quote":true},{"t":"香花鬘饮食，本净而能污。","level":0,"quote":true},{"t":"如汝并憎恶，於自他粪秽，","level":0,"quote":true},{"t":"云何汝不厌，自他不净身？","level":0,"quote":true},{"t":"如女身不净，自身秽亦尔，","level":0,"quote":true},{"t":"是故离欲人，於内外相称。","level":0,"quote":true},{"t":"九门流不净，自证自浣濯，","level":0,"quote":true},{"t":"若不知不净，而造爱欲论，","level":0,"quote":true},{"t":"希有极无知，无惭及轻他，","level":0,"quote":true},{"t":"於最不净身，何方利益汝？","level":0,"quote":true},{"t":"多众生因此，无明覆其心，","level":0,"quote":true},{"t":"为尘欲结怨，如狗鬪争粪。","level":0,"quote":true},{"t":"如搔痒谓乐，不痒最安乐，","level":0,"quote":true},{"t":"如此有欲乐，无欲人最乐。","level":0,"quote":true},{"t":"若汝思此义，离欲不得成，","level":0,"quote":true},{"t":"由思欲轻故，不遭婬逸过。","level":0,"quote":true},{"t":"从猎感短寿，怖苦重逼恼，","level":0,"quote":true},{"t":"未来决受此，故应坚行悲。","level":0,"quote":true},{"t":"何人若他见，生彼极惊怖，","level":0,"quote":true},{"t":"譬粪秽污身，流出毒恶蛇。","level":0,"quote":true},{"t":"是人若至彼，众生得安乐，","level":0,"quote":true},{"t":"譬夏月大云，田夫见欲雨。","level":0,"quote":true},{"t":"故汝舍恶法，决心修善行，","level":0,"quote":true},{"t":"为自他俱得，无上菩提果。","level":0,"quote":true},{"t":"是菩提根本，心坚如山王，","level":0,"quote":true},{"t":"因十方际悲，及无二依智。","level":0,"quote":true},{"t":"大王汝谛听，此因我今说，","level":0,"quote":true},{"t":"感三十二相，能庄严汝身。","level":0,"quote":true},{"t":"支提圣尊人，供养恒亲侍，","level":0,"quote":true},{"t":"手足宝相轮，当成转轮王。","level":0,"quote":true},{"t":"手足滑柔软，身大七处高，","level":0,"quote":true},{"t":"由施美饮食，於他等丰足。","level":0,"quote":true},{"t":"身圆满端直，指足跟圆长，","level":0,"quote":true},{"t":"汝当感长寿，由悲济死囚。","level":0,"quote":true},{"t":"大王坚持法，令清净久住，","level":0,"quote":true},{"t":"由此足安平，当得成菩萨。","level":0,"quote":true},{"t":"行布施爱语，利行及同利，","level":0,"quote":true},{"t":"由此指网密，手足八十文，","level":0,"quote":true},{"t":"脚趺高可爱，旋毛端向上，","level":0,"quote":true},{"t":"由长不弃背，本所受持法。","level":0,"quote":true},{"t":"由恭敬施受，明处及工巧，","level":0,"quote":true},{"t":"故得鹿王腨，及聪明大智。","level":0,"quote":true},{"t":"他求自有物，我疾能惠施，","level":0,"quote":true},{"t":"由此臂<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00166.gif\" alt=\"𦟛\" title=\"𦟛\" />大，得为世化主。","level":0,"quote":true},{"t":"亲爱若别离，菩萨令和集，","level":0,"quote":true},{"t":"此感阴藏相，恒服惭羞衣。","level":0,"quote":true},{"t":"常施楼殿具，细软可爱色，","level":0,"quote":true},{"t":"故感天色身，润滑光微妙。","level":0,"quote":true},{"t":"由施无上护，如理顺尊长，","level":0,"quote":true},{"t":"感一孔一毛，白毫端严面。","level":0,"quote":true},{"t":"常说善爱语，又能顺正教，","level":0,"quote":true},{"t":"上身如师子，颈圆喻甘浮。","level":0,"quote":true},{"t":"看病给医药，或令他养护，","level":0,"quote":true},{"t":"故得腋下满，千脉别百味。","level":0,"quote":true},{"t":"於自他法事，常能为端首，","level":0,"quote":true},{"t":"顶骨欝尼沙，横竖颊匿瞿。","level":0,"quote":true},{"t":"由长时巧说，实美滑善言，","level":0,"quote":true},{"t":"得八相梵音，及舌根修广。","level":0,"quote":true},{"t":"已知事实利，数数为他说，","level":0,"quote":true},{"t":"得好如师子，面门方可爱。","level":0,"quote":true},{"t":"由尊他不轻，随顺行正理，","level":0,"quote":true},{"t":"齿白齐必胜，譬若真珠行。","level":0,"quote":true},{"t":"由数习此言，谓实不两舌，","level":0,"quote":true},{"t":"故具四十齿，平滑坚遒净。","level":0,"quote":true},{"t":"由瞻视众生，滑无贪瞋痴，","level":0,"quote":true},{"t":"眼珠青滑了，睑<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00263.gif\" alt=\"𥇒\" title=\"𥇒\" />如牛王。","level":0,"quote":true},{"t":"由如此略说，大人相及因，","level":0,"quote":true},{"t":"转轮王菩萨，美饰汝应知。","level":0,"quote":true},{"t":"随相有八十，从慈悲流生，","level":0,"quote":true},{"t":"大王我不说，为避多文辞。","level":0,"quote":true},{"t":"虽诸转轮王，同有此相好，","level":0,"quote":true},{"t":"净明及可爱，终不逮如来。","level":0,"quote":true},{"t":"从菩萨善心，一念中一分，","level":0,"quote":true},{"t":"轮王相好因，尚不能等此。","level":0,"quote":true},{"t":"一人万亿劫，修善根生长，","level":0,"quote":true},{"t":"於佛一毛相，此因亦不感。","level":0,"quote":true},{"t":"诸佛与轮王，相中一分等，","level":0,"quote":true},{"t":"譬如萤与日，於光微有似。","level":0,"quote":true}],[{"t":"宝行王正论菩提资粮品第三","level":3},{"t":"诸佛大相好，从难思福生，","level":0,"quote":true},{"t":"我今为汝说，依大乘阿舍。","level":0,"quote":true},{"t":"一切缘觉福，有学无学福，","level":0,"quote":true},{"t":"及十方世福，福如世难量。","level":0,"quote":true},{"t":"此福更十倍，感佛一毛相，","level":0,"quote":true},{"t":"九万九千毛，一一福皆尔。","level":0,"quote":true},{"t":"如此众多福，生佛一切毛，","level":0,"quote":true},{"t":"复更百倍增，方感佛一好。","level":0,"quote":true},{"t":"如是如是多，一一好得成，","level":0,"quote":true},{"t":"乃至满八十，随饰一大相。","level":0,"quote":true},{"t":"如是福德聚，能感八十好，","level":0,"quote":true},{"t":"合更百倍增，感佛一大相。","level":0,"quote":true},{"t":"如是多福德，能感三十相，","level":0,"quote":true},{"t":"复更百倍增，感毫如满月。","level":0,"quote":true},{"t":"能感白毫福，复更千倍增，","level":0,"quote":true},{"t":"此福感难见，顶上欝尼沙。","level":0,"quote":true},{"t":"如此无量福，方便说有量，","level":0,"quote":true},{"t":"於一切十方，如说十倍世。","level":0,"quote":true},{"t":"诸佛色身因，尚如世无量，","level":0,"quote":true},{"t":"况佛法身因，而当有边际？","level":0,"quote":true},{"t":"世间因虽小，若果大难量，","level":0,"quote":true},{"t":"佛因既无量，果量云何思？","level":0,"quote":true},{"t":"诸佛有色身，皆从福行起，","level":0,"quote":true},{"t":"大王佛法身，由智慧行成，","level":0,"quote":true},{"t":"故佛福慧行，是菩提正因，","level":0,"quote":true},{"t":"故愿汝恒行，菩提福慧行。","level":0,"quote":true},{"t":"於成菩提福，汝莫堕沈忧，","level":0,"quote":true},{"t":"有理及阿舍，能令心安信。","level":0,"quote":true},{"t":"如十方无边，空及地水火，","level":0,"quote":true},{"t":"有苦诸众生，彼无边亦尔。","level":0,"quote":true},{"t":"此无边众生，菩萨依大悲，","level":0,"quote":true},{"t":"从苦而拔济，愿彼般涅槃。","level":0,"quote":true},{"t":"从发此坚心，行住及卧觉，","level":0,"quote":true},{"t":"或时小放逸，无量福恒流。","level":0,"quote":true},{"t":"福量如众生，恒流无间隙，","level":0,"quote":true},{"t":"因果既相称，故菩提不难。","level":0,"quote":true},{"t":"时节及众生，菩提与福德，","level":0,"quote":true},{"t":"由此四无量，菩萨坚心行。","level":0,"quote":true},{"t":"菩提虽无量，因前四无量，","level":0,"quote":true},{"t":"修福慧二行，云何难可得？","level":0,"quote":true},{"t":"福慧二种行，如此无边际，","level":0,"quote":true},{"t":"菩萨身心苦，故疾得消除。","level":0,"quote":true},{"t":"恶道饥渴等，身苦恶业生，","level":0,"quote":true},{"t":"菩萨永离恶，行善苦不生。","level":0,"quote":true},{"t":"欲瞋怖畏等，心苦从痴生，","level":0,"quote":true},{"t":"由依无二智，菩萨离心苦。","level":0,"quote":true},{"t":"有苦时若促，难忍何况多；","level":0,"quote":true},{"t":"无苦时长远，有乐云何难？","level":0,"quote":true},{"t":"身苦永不有，假说有心苦，","level":0,"quote":true},{"t":"悲世间二苦，故恒住生死。","level":0,"quote":true},{"t":"故菩提长时，智人心不沈，","level":0,"quote":true},{"t":"为灭恶生善，是时无间修。","level":0,"quote":true},{"t":"贪瞋及无明，愿汝识舍离，","level":0,"quote":true},{"t":"无贪等众善，知应恭敬修。","level":0,"quote":true},{"t":"由贪生鬼道，由瞋堕地狱，","level":0,"quote":true},{"t":"由痴入畜生，翻此感人天。","level":0,"quote":true},{"t":"舍恶及修善，此法是乐因，","level":0,"quote":true},{"t":"若是解脱法，由智舍二执。","level":0,"quote":true},{"t":"佛像及支提，殿堂并寺庙，","level":0,"quote":true},{"t":"最胜多供具，汝应敬成立。","level":0,"quote":true},{"t":"坐宝莲花上，好色微妙畫，","level":0,"quote":true},{"t":"一切金宝种，汝应造佛像。","level":0,"quote":true},{"t":"正法及圣众，以命色事护，","level":0,"quote":true},{"t":"金宝网繖盖，奉献覆支提。","level":0,"quote":true},{"t":"金银众宝花，珊瑚琉璃珠，","level":0,"quote":true},{"t":"帝释青大青，金刚贡支提，","level":0,"quote":true},{"t":"能说正法人，以四事供养，","level":0,"quote":true},{"t":"六和敬等法，常应勤修行。","level":0,"quote":true},{"t":"於尊恭敬听，勤事而侍护，","level":0,"quote":true},{"t":"菩萨必应行，亡后亦供养。","level":0,"quote":true},{"t":"於天外道众，不应亲事礼，","level":0,"quote":true},{"t":"因无知邪信，莫事恶知识。","level":0,"quote":true},{"t":"佛阿含及论，书写读诵施，","level":0,"quote":true},{"t":"亦惠纸笔墨，汝应修此福。","level":0,"quote":true},{"t":"於国起学堂，雇师供学士，","level":0,"quote":true},{"t":"兴建永基业，汝行为长慧。","level":0,"quote":true},{"t":"解医巧历数，皆为立田畴，","level":0,"quote":true},{"t":"润老小病苦，於国有济益。","level":0,"quote":true},{"t":"起诸道伽蓝，园塘湖亭屋，","level":0,"quote":true},{"t":"於中给生具，草蓐饮食薪。","level":0,"quote":true},{"t":"於小大国土，应起寺亭馆，","level":0,"quote":true},{"t":"远路乏水浆，造井池施饮。","level":0,"quote":true},{"t":"病苦无依贫，下姓怖畏等，","level":0,"quote":true},{"t":"依慈悲摄受，勤心安立彼。","level":0,"quote":true},{"t":"随时新饮食，果菜及新谷，","level":0,"quote":true},{"t":"大众及须者，未施莫先用。","level":0,"quote":true},{"t":"屣繖瓶钩镊，针𫄧及扇等，","level":0,"quote":true},{"t":"荃提寝息具，应施寺亭馆。","level":0,"quote":true},{"t":"三果及三辛，蜜糖酥眼药，","level":0,"quote":true},{"t":"恒应安息省，书呪及药方。","level":0,"quote":true},{"t":"涂首身药油，澡盘灯𪎊果，","level":0,"quote":true},{"t":"水器及刀斧，应给亭馆中。","level":0,"quote":true},{"t":"米谷麻饮食，糖膏等相应，","level":0,"quote":true},{"t":"恒置阴凉处，及净水满器。","level":0,"quote":true},{"t":"於蚁鼠穴门，饮食谷糖等，","level":0,"quote":true},{"t":"愿令可信人，日日分布散。","level":0,"quote":true},{"t":"如意前后食，恒施於饿鬼，","level":0,"quote":true},{"t":"狗鼠鸟蚁等，愿汝恒施食。","level":0,"quote":true},{"t":"灾疫饥饿时，水旱及贼难，","level":0,"quote":true},{"t":"国败须济度，愿汝恒拯恤。","level":0,"quote":true},{"t":"田夫绝农业，愿给粮种具，","level":0,"quote":true},{"t":"随时蠲租税，轻微受调敛。","level":0,"quote":true},{"t":"施物济贫债，出息不长轻，","level":0,"quote":true},{"t":"直防许休偃，以时接宾客。","level":0,"quote":true},{"t":"境内外劫盗，方便断令息，","level":0,"quote":true},{"t":"随时遗商侣，平物价钧调。","level":0,"quote":true},{"t":"八座等判事，自如理观察，","level":0,"quote":true},{"t":"事能利万姓，恒恭敬修行。","level":0,"quote":true},{"t":"应作何自利？如汝恒敬思。","level":0,"quote":true},{"t":"利他云何成？如此汝急思。","level":0,"quote":true},{"t":"地水风火等，草药及野树，","level":0,"quote":true},{"t":"如此或暂时，受他无碍策。","level":0,"quote":true},{"t":"七步顷起心，为舍内外财，","level":0,"quote":true},{"t":"菩萨福德成，难量如虚空。","level":0,"quote":true},{"t":"童女好色严，惠施求得者，","level":0,"quote":true},{"t":"故获陀罗尼，能持一切法。","level":0,"quote":true},{"t":"爱色具庄严，并一切生具，","level":0,"quote":true},{"t":"施八万童女，释迦佛昔时。","level":0,"quote":true},{"t":"光明种种色，衣服庄严具，","level":0,"quote":true},{"t":"花香等应施，依悲惠求者。","level":0,"quote":true},{"t":"若人离此缘，於法无安行，","level":0,"quote":true},{"t":"则应施与之，过此后莫惠。","level":0,"quote":true},{"t":"毒亦许施彼，若此能利他；","level":0,"quote":true},{"t":"甘露不许施，若此损害他。","level":0,"quote":true},{"t":"若蛇啮人指，佛亦听则除，","level":0,"quote":true},{"t":"或佛教利他，逼恼亦可行。","level":0,"quote":true},{"t":"固谨持正法，及能说法人，","level":0,"quote":true},{"t":"恭敬听受法，或以法施他。","level":0,"quote":true},{"t":"莫爱世赞叹，恒乐出俗法，","level":0,"quote":true},{"t":"如立自体德，於他亦如此。","level":0,"quote":true},{"t":"於闻莫知足，及思修实义，","level":0,"quote":true},{"t":"於师报恩施，应敬行莫悋。","level":0,"quote":true},{"t":"莫读外邪论，但起诤慢故，","level":0,"quote":true},{"t":"不应赞自德，怨德亦可赞。","level":0,"quote":true},{"t":"莫显他密事，及恶心两舌，","level":0,"quote":true},{"t":"自於他有过，如理观悔露。","level":0,"quote":true},{"t":"若由此过失，智者诃责他，","level":0,"quote":true},{"t":"自须离此失，有能拔济他。","level":0,"quote":true},{"t":"他辱己莫瞋，即观宿恶业，","level":0,"quote":true},{"t":"莫报对他恶，为后不受苦。","level":0,"quote":true},{"t":"於他应作恩，莫希彼报答，","level":0,"quote":true},{"t":"唯自应受苦，共求众受乐。","level":0,"quote":true},{"t":"若得大富贵，自高不应作，","level":0,"quote":true},{"t":"遭枉如饿鬼，莫起下悲行。","level":0,"quote":true},{"t":"假设失王位，或死由实言，","level":0,"quote":true},{"t":"亦恒说此语，无实利默然。","level":0,"quote":true},{"t":"如言如此行，愿汝坚行善，","level":0,"quote":true},{"t":"因此好名遍，自在成胜量。","level":0,"quote":true},{"t":"应作熟简择，后则依理行，","level":0,"quote":true},{"t":"莫由信他作，须自了实义。","level":0,"quote":true},{"t":"若依理行善，好名遍十方，","level":0,"quote":true},{"t":"王侯续不断，王富乐转大。","level":0,"quote":true},{"t":"死缘百一种，寿命因不多，","level":0,"quote":true},{"t":"此因或死缘，故恒应修善。","level":0,"quote":true},{"t":"若人恒行善，是所得安乐，","level":0,"quote":true},{"t":"於自他若等，此善乐圆足。","level":0,"quote":true},{"t":"依法为性人，卧觉常安乐，","level":0,"quote":true},{"t":"梦中见善事，由内无过恶。","level":0,"quote":true},{"t":"若人养父母，恭奉自家尊，","level":0,"quote":true},{"t":"恭善人用财，忍辱有大度。","level":0,"quote":true},{"t":"软语不两舌，实言同止乐，","level":0,"quote":true},{"t":"此九天帝因，尽寿应修行。","level":0,"quote":true},{"t":"由昔行九法，天主感帝位，","level":0,"quote":true},{"t":"时时处法堂，至今恒说此。","level":0,"quote":true},{"t":"一日三时施，美食三百器，","level":0,"quote":true},{"t":"福不及刹那，行慈百分一。","level":0,"quote":true},{"t":"天人等爱护，日夜受喜乐，","level":0,"quote":true},{"t":"免怨火毒杖，是行慈现果，","level":0,"quote":true},{"t":"无功用获财，后生於色界，","level":0,"quote":true},{"t":"得慈十功德。若人未解脱，","level":0,"quote":true},{"t":"教一切众生，坚发菩提心。","level":0,"quote":true},{"t":"菩萨德如山，菩提心牢固，","level":0,"quote":true},{"t":"由信离八难，因戒生善道。","level":0,"quote":true},{"t":"数修真如空，得善无放逸，","level":0,"quote":true},{"t":"无谄得念根，恒思得慧根。","level":0,"quote":true},{"t":"恭敬得义理，护法感宿命，","level":0,"quote":true},{"t":"布施听闻法，或不障他闻，","level":0,"quote":true},{"t":"疾得如所爱，与佛相值遇。","level":0,"quote":true},{"t":"无贪作事成，不悭财物长，","level":0,"quote":true},{"t":"离慢招上品，法忍得总持。","level":0,"quote":true},{"t":"由行五实施，及惠无怖畏，","level":0,"quote":true},{"t":"非诸骂能辱，故感大胜力。","level":0,"quote":true},{"t":"支提列灯行，幽暗秉火烛，","level":0,"quote":true},{"t":"布施续明油，故得净天眼。","level":0,"quote":true},{"t":"供养支提时，即设鼓声乐，","level":0,"quote":true},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00657.gif\" alt=\"䗍\" title=\"䗍\" />角等妙音，故获净天耳。","level":0,"quote":true},{"t":"於他失默然，不谈人德阙，","level":0,"quote":true},{"t":"随顺护彼意，故得他心智。","level":0,"quote":true},{"t":"由施徙舟乘，运致羸乏人，","level":0,"quote":true},{"t":"恭谨瞻尊长，故获如意通。","level":0,"quote":true},{"t":"令他忆法事，及正法句义，","level":0,"quote":true},{"t":"或净心施法，故感宿命智。","level":0,"quote":true},{"t":"由知真实义，谓诸法无性，","level":0,"quote":true},{"t":"故得第六通，最胜是流尽。","level":0,"quote":true},{"t":"平等悲相应，由修如实智，","level":0,"quote":true},{"t":"故自得成佛，恒解脱众生。","level":0,"quote":true},{"t":"由种种净愿，故佛土清净，","level":0,"quote":true},{"t":"众宝献支提，故放无边光。","level":0,"quote":true},{"t":"如此业及果，已知义相应，","level":0,"quote":true}],[{"t":"故应修利他，即菩萨自利。","level":0,"quote":true}],[{"t":"宝行王正论正教王品第四","level":3},{"t":"王若行非法，或作非道理，","level":0,"quote":true},{"t":"事王人亦赞，故好恶难知。","level":0,"quote":true},{"t":"亦有世间人，非爱善难教，","level":0,"quote":true},{"t":"何况大国王，能受善人语。","level":0,"quote":true},{"t":"我今愍念汝，及悲诸世间，","level":0,"quote":true},{"t":"故我善教汝，实益若非爱。","level":0,"quote":true},{"t":"真滑有义利，依时由慈悲，","level":0,"quote":true},{"t":"佛令教弟子，故我为汝说。","level":0,"quote":true},{"t":"若听闻实语，应住於无瞋，","level":0,"quote":true},{"t":"可取必须受，如浴受净水。","level":0,"quote":true},{"t":"我今说善言，现来有利益，","level":0,"quote":true},{"t":"汝知应受行，为自及於世。","level":0,"quote":true},{"t":"由昔施贫苦，故今感富财，","level":0,"quote":true},{"t":"因贪不知恩，废施无更得。","level":0,"quote":true},{"t":"世间唯路粮，不雇无人负，","level":0,"quote":true},{"t":"由施供下品，未来荷百倍。","level":0,"quote":true},{"t":"愿汝发大心，恒兴建大事，","level":0,"quote":true},{"t":"若行大心事，是人得大果。","level":0,"quote":true},{"t":"小意陿劣王，心愿未曾触，","level":0,"quote":true},{"t":"好名吉祥事，三宝依应作。","level":0,"quote":true},{"t":"望王后等毛，若事非汝法，","level":0,"quote":true},{"t":"死亦起恶名，王不作最胜。","level":0,"quote":true},{"t":"广大事能起，大人希有用，","level":0,"quote":true},{"t":"能障下人愿，以命成此事。","level":0,"quote":true},{"t":"无自在弃物，只身入未来，","level":0,"quote":true},{"t":"若於法安财，前至逆相待。","level":0,"quote":true},{"t":"先帝诸产业，弃本属新王，","level":0,"quote":true},{"t":"能为前王生，法乐好名不？","level":0,"quote":true},{"t":"用财受现喜，若施感来乐，","level":0,"quote":true},{"t":"非此二唐失，唯生苦无欢。","level":0,"quote":true},{"t":"将终欲行施，臣碍失自在，","level":0,"quote":true},{"t":"祚绝故舍爱，随新王乐欲。","level":0,"quote":true},{"t":"若舍一切物，汝今安弘法，","level":0,"quote":true},{"t":"亦常在死缘，譬如风中灯。","level":0,"quote":true},{"t":"先诸王所起，平等功德处，","level":0,"quote":true},{"t":"谓天神庙堂，愿如本修理。","level":0,"quote":true},{"t":"离杀常行善，持戒爱容旧，","level":0,"quote":true},{"t":"巧增财无诤，勤力恒修善。","level":0,"quote":true},{"t":"清净无积聚，不舍於他事，","level":0,"quote":true},{"t":"安立为导首，受彼功德藏。","level":0,"quote":true},{"t":"盲病根不具，可悲匃无依，","level":0,"quote":true},{"t":"於庙不得遮，平等与彼食。","level":0,"quote":true},{"t":"道德无求人，或住餘王界，","level":0,"quote":true},{"t":"供事亦相似，应作无此彼。","level":0,"quote":true},{"t":"於一切法事，应立勤力人，","level":0,"quote":true},{"t":"无贪聪智善，不侵法畏罪。","level":0,"quote":true},{"t":"了正论行善，亲爱四观净，","level":0,"quote":true},{"t":"美语不怯弱，上姓能持戒。","level":0,"quote":true},{"t":"识恩知他苦，如理巧决断，","level":0,"quote":true},{"t":"八人互相羞，为国立八座。","level":0,"quote":true},{"t":"柔和有大度，胆勇甚爱王，","level":0,"quote":true},{"t":"坚实能用财，无放逸恒善。","level":0,"quote":true},{"t":"熟思所作事，能别十二轮，","level":0,"quote":true},{"t":"常行四方便，应立为大臣。","level":0,"quote":true},{"t":"持法戒清净，了事有干用，","level":0,"quote":true},{"t":"能生长护财，解义巧书算。","level":0,"quote":true},{"t":"於他心事等，畏罪亲爱王，","level":0,"quote":true},{"t":"富财多眷属，宜立为职掌。","level":0,"quote":true},{"t":"月月应问彼，一切财出入，","level":0,"quote":true},{"t":"问己法事等，喜心善教诲。","level":0,"quote":true},{"t":"为法处王位，不求名欲尘，","level":0,"quote":true},{"t":"王位胜有利，异此则不如。","level":0,"quote":true},{"t":"大王即世间，多互相食噉，","level":0,"quote":true},{"t":"立法王位义，汝谛听我说。","level":0,"quote":true},{"t":"长老於王处，上族解是非，","level":0,"quote":true},{"t":"畏恶多相顺，愿彼看王事。","level":0,"quote":true},{"t":"罚系鞭杖等，若彼依理行，","level":0,"quote":true},{"t":"王恒润大悲，於彼更施恩。","level":0,"quote":true},{"t":"为利一切人，应恒起慈心，","level":0,"quote":true},{"t":"若彼最重恶，亦应生大悲。","level":0,"quote":true},{"t":"重恶极害心，必於彼行悲，","level":0,"quote":true},{"t":"彼即是悲器，正行人悲境。","level":0,"quote":true},{"t":"贫人若被驻，五日须放散，","level":0,"quote":true},{"t":"餘人亦如理，随一莫拘留。","level":0,"quote":true},{"t":"若於一人所，起长系驻心，","level":0,"quote":true},{"t":"随人生不护，因此恶恒流。","level":0,"quote":true},{"t":"乃至彼未散，虽系亦安乐，","level":0,"quote":true},{"t":"庄饰浣饮食，药扇等相应。","level":0,"quote":true},{"t":"王欲他成器，依悲立善教，","level":0,"quote":true},{"t":"善恶人皆同，不由瞋及欲。","level":0,"quote":true},{"t":"熟思实知已，人增起反逆，","level":0,"quote":true},{"t":"不杀不逼彼，愿王摈他土。","level":0,"quote":true},{"t":"看自家如怨，由参人净眼，","level":0,"quote":true},{"t":"恒念无放逸，愿作如法事。","level":0,"quote":true},{"t":"赏重加供养，有恩人令得，","level":0,"quote":true},{"t":"如思德胜负，报偿亦如是。","level":0,"quote":true},{"t":"将接为饶花，赏施为大果，","level":0,"quote":true},{"t":"王树忍辱影，民鸟遍依事。","level":0,"quote":true},{"t":"王持戒能施，有威得物心，","level":0,"quote":true},{"t":"譬如沙糖丸，香剌味相杂。","level":0,"quote":true},{"t":"若王依道理，愚法则不行，","level":0,"quote":true},{"t":"无难无非法，恒有法欢乐。","level":0,"quote":true},{"t":"不从昔世引，不可将入来，","level":0,"quote":true},{"t":"王位从法得，为位莫坏法。","level":0,"quote":true},{"t":"王位如肆家，若传如所价，","level":0,"quote":true},{"t":"为不更求得，此用汝应行。","level":0,"quote":true},{"t":"王位如肆家，王传如所价，","level":0,"quote":true},{"t":"为欲更求得，此用应修行。","level":0,"quote":true},{"t":"转轮王得地，或具四天下，","level":0,"quote":true},{"t":"但身心二乐，餘富贵皆虚。","level":0,"quote":true},{"t":"但对治众苦，谓身喜乐受，","level":0,"quote":true},{"t":"心乐是想类，皆分别所作。","level":0,"quote":true},{"t":"对治苦为体，及分别为类，","level":0,"quote":true},{"t":"世间一切乐，虚故无真实。","level":0,"quote":true},{"t":"洲处土居止，坐处及衣等，","level":0,"quote":true},{"t":"饮食卧具乘，妻象马用一，","level":0,"quote":true},{"t":"若心随一缘，即由彼生乐，","level":0,"quote":true},{"t":"餘境非缘故，是时虚无用。","level":0,"quote":true},{"t":"五根缘五尘，若心不分别，","level":0,"quote":true},{"t":"虽复得成尘，不由此生乐。","level":0,"quote":true},{"t":"此尘根所缘，餘则非能所，","level":0,"quote":true},{"t":"故所餘根尘，真实无有义。","level":0,"quote":true},{"t":"此尘根所缘，心取过去相，","level":0,"quote":true},{"t":"分别起净想，於彼生乐受。","level":0,"quote":true},{"t":"一尘心所缘，心尘不同世，","level":0,"quote":true},{"t":"既离心非尘，离尘亦非心。","level":0,"quote":true},{"t":"以父母为因，汝说有子生，","level":0,"quote":true},{"t":"如此缘眼色，说有识等生。","level":0,"quote":true},{"t":"去来世根尘，不成由无义，","level":0,"quote":true},{"t":"不出二世故，现尘根无义。","level":0,"quote":true},{"t":"如眼见火轮，由根到乱故，","level":0,"quote":true},{"t":"於现在尘中，根缘尘亦尔。","level":0,"quote":true},{"t":"五根及境界，是四大尘类，","level":0,"quote":true},{"t":"一一大虚故，尘根亦不有。","level":0,"quote":true},{"t":"若大各离成，离薪火应然，","level":0,"quote":true},{"t":"若离无别体，尘亦同此判。","level":0,"quote":true},{"t":"四大二义虚，故不成和同，","level":0,"quote":true},{"t":"既实无和同，故色尘不成。","level":0,"quote":true},{"t":"识受想及行，一一体不成，","level":0,"quote":true},{"t":"不合乘缘生，非有故无合。","level":0,"quote":true},{"t":"如分别喜乐，缘苦对治成，","level":0,"quote":true},{"t":"如此所计苦，因乐坏故成。","level":0,"quote":true},{"t":"於乐和合爱，缘无相则灭，","level":0,"quote":true},{"t":"於苦远离贪，由此观不生。","level":0,"quote":true},{"t":"若依世言说，心为能见者，","level":0,"quote":true},{"t":"不然离所见，能见不成故。","level":0,"quote":true},{"t":"观行覩世间，如幻实不有，","level":0,"quote":true},{"t":"无取无分别，般涅槃如火。","level":0,"quote":true},{"t":"菩萨见如此，於菩提不退，","level":0,"quote":true},{"t":"由大悲引故，后相续至佛。","level":0,"quote":true},{"t":"诸菩萨修道，佛说於大乘，","level":0,"quote":true},{"t":"无智憎嫉人，自害拨不受。","level":0,"quote":true},{"t":"不识功德失，於德起失想，","level":0,"quote":true},{"t":"或憎嫉胜利，故人谤大乘。","level":0,"quote":true},{"t":"若知罪损他，功德能利益，","level":0,"quote":true},{"t":"故说诽谤人，不识憎嫉善。","level":0,"quote":true},{"t":"由不观自利，一味利益他，","level":0,"quote":true},{"t":"大乘众德器，故谤人灰粉。","level":0,"quote":true},{"t":"信人由僻执，不信由嫉憎，","level":0,"quote":true},{"t":"信人谤尚烧，何况瞋妬者。","level":0,"quote":true},{"t":"合毒为治毒，如医方所说，","level":0,"quote":true},{"t":"苦灭恶亦尔，此言何相违？","level":0,"quote":true},{"t":"诸法心先行，以心为上首，","level":0,"quote":true},{"t":"以苦灭他恶，善心人何过？","level":0,"quote":true},{"t":"苦来若能利，应取何况乐，","level":0,"quote":true},{"t":"或於自及他，此是本首法。","level":0,"quote":true},{"t":"由能弃小乐，后若见大乐，","level":0,"quote":true},{"t":"智人舍小乐，观於后大乐。","level":0,"quote":true},{"t":"若不忍此言，医师施苦乐，","level":0,"quote":true},{"t":"犯罪不可恕，故汝义不然。","level":0,"quote":true},{"t":"或见事不宜，智者由义行，","level":0,"quote":true},{"t":"或制或开许，此义处处有。","level":0,"quote":true},{"t":"诸菩萨威仪，悲为先智成，","level":0,"quote":true},{"t":"大乘说如此，何因可诽谤？","level":0,"quote":true},{"t":"无知故沈没，上乘广深义，","level":0,"quote":true},{"t":"故诽谤大乘，成自他怨家。","level":0,"quote":true},{"t":"施戒忍精进，定智悲为体，","level":0,"quote":true},{"t":"佛说大乘尔，有何邪说漏？","level":0,"quote":true},{"t":"由施戒利他，忍进为自利，","level":0,"quote":true},{"t":"定慧脱自他，略摄大乘义。","level":0,"quote":true},{"t":"略说佛正教，谓解脱自他，","level":0,"quote":true},{"t":"此六度为藏，何人能拨此？","level":0,"quote":true},{"t":"福慧为种类，佛说菩提道，","level":0,"quote":true},{"t":"立此名大乘，痴盲不能忍。","level":0,"quote":true},{"t":"如空难思量，福慧行成故，","level":0,"quote":true},{"t":"诸佛德难思，於大乘愿忍。","level":0,"quote":true},{"t":"大德舍利弗，佛戒非其境，","level":0,"quote":true},{"t":"故佛德难思，云何不可忍？","level":0,"quote":true},{"t":"於大乘无生，小乘说空灭，","level":0,"quote":true},{"t":"无生灭一体，自义莫违反。","level":0,"quote":true},{"t":"真空及佛德，若如法简择，","level":0,"quote":true},{"t":"大小两乘教，於智人何诤？","level":0,"quote":true},{"t":"佛不了义说，非下人易解，","level":0,"quote":true},{"t":"一三乘说中，护自体莫伤。","level":0,"quote":true},{"t":"若舍无非福，若憎恶无善，","level":0,"quote":true},{"t":"若欲爱自身，大乘不应谤。","level":0,"quote":true},{"t":"菩萨愿及行，回向等彼无，","level":0,"quote":true},{"t":"若依小乘修，云何成菩萨？","level":0,"quote":true},{"t":"菩萨道四依，於小乘不说，","level":0,"quote":true},{"t":"何法佛所修，而说能胜彼？","level":0,"quote":true},{"t":"约依谛助道，佛与彼若同，","level":0,"quote":true},{"t":"修因既不异，云何果殊越？","level":0,"quote":true},{"t":"菩提行总别，小乘中不说，","level":0,"quote":true},{"t":"於大乘具辩，故智应信受。","level":0,"quote":true},{"t":"如毘伽罗论，先教学字母，","level":0,"quote":true},{"t":"佛立教如此，约受化根性，","level":0,"quote":true},{"t":"有处或说法，令彼离众恶，","level":0,"quote":true},{"t":"或为成福德，或具依前二，","level":0,"quote":true},{"t":"或为遣此二，甚深怖劣人，","level":0,"quote":true}],[{"t":"或深悲为上，为他成菩提。","level":0,"quote":true},{"t":"是故聪明人，应舍憎大乘，","level":0,"quote":true},{"t":"当起胜信受，为得无等觉。","level":0,"quote":true},{"t":"由信受大乘，及行大乘教，","level":0,"quote":true},{"t":"故成无上道，中间种种乐。","level":0,"quote":true},{"t":"施戒及忍辱，多为在家说，","level":0,"quote":true},{"t":"此法悲为上，愿汝修成性。","level":0,"quote":true},{"t":"由世不平等，王位若乖法，","level":0,"quote":true},{"t":"为好名及法，事及出家胜。","level":0,"quote":true}],[{"t":"宝行王正论出家正行品第五","level":3},{"t":"初学出家人，敬心修禁戒，","level":0,"quote":true},{"t":"於木叉毘尼，多学破立义。","level":0,"quote":true},{"t":"次起正勤心，舍离麁类惑，","level":0,"quote":true},{"t":"数有五十七，谛听我当说。","level":0,"quote":true},{"t":"怪谓心相违，恨是结他失，","level":0,"quote":true},{"t":"覆恶罪名秘，及著恶显善，","level":0,"quote":true},{"t":"张他名欺诳，谄谓曲心续，","level":0,"quote":true},{"t":"嫉於他德忧，悋心怖畏舍，","level":0,"quote":true},{"t":"无羞及无惭，於自他无耻，","level":0,"quote":true},{"t":"不下不敬他，动乱瞋方便，","level":0,"quote":true},{"t":"醉谓不计他，放逸不修善。","level":0,"quote":true},{"t":"慢类有七种，我今当略说，","level":0,"quote":true},{"t":"若人起分别，从下下等等，","level":0,"quote":true},{"t":"从下及等胜，说此惑为慢。","level":0,"quote":true},{"t":"下人计自身，不如於等人，","level":0,"quote":true},{"t":"说此名下慢。由自下等类，","level":0,"quote":true},{"t":"下人高自身，与胜人平等，","level":0,"quote":true},{"t":"此惑名高慢。由自高等胜，","level":0,"quote":true},{"t":"下人计自己，胜於胜类人，","level":0,"quote":true},{"t":"说此名过慢。如痈上起泡，","level":0,"quote":true},{"t":"於五种取阴，自性空无人，","level":0,"quote":true},{"t":"由痴故计我，说此名我慢。","level":0,"quote":true},{"t":"实未得圣道，计自身已得，","level":0,"quote":true},{"t":"由修偏道故，说名增上慢。","level":0,"quote":true},{"t":"若人由作恶，而计自身胜，","level":0,"quote":true},{"t":"兼复拨他德，说此名邪慢。","level":0,"quote":true},{"t":"我今无复用，或能下自体，","level":0,"quote":true},{"t":"此亦名下慢。但缘自体起，","level":0,"quote":true},{"t":"为求利养赞，故守摄六根，","level":0,"quote":true},{"t":"能隐贪欲意，此惑名贡高。","level":0,"quote":true},{"t":"为得利供养，於他起爱语，","level":0,"quote":true},{"t":"此惑缘世法，说此名谢言。","level":0,"quote":true},{"t":"为欲得彼物，若赞美此财，","level":0,"quote":true},{"t":"说名为现相，能示自心故。","level":0,"quote":true},{"t":"为欲得所求，现前非拨他，","level":0,"quote":true},{"t":"说名为诃责，能伏彼令顺。","level":0,"quote":true},{"t":"由施欲求利，或赞彼先德，","level":0,"quote":true},{"t":"说名利求利，此五邪命摄。","level":0,"quote":true},{"t":"若人缘他失，心数种种诵，","level":0,"quote":true},{"t":"说名为愔隘。此或习恨心，","level":0,"quote":true},{"t":"惊怖不能安，由无知及病。","level":0,"quote":true},{"t":"於下麁自具，毁呰及懈著，","level":0,"quote":true},{"t":"欲瞋痴污想，说名种种相。","level":0,"quote":true},{"t":"不如现观察，说名非思惟。","level":0,"quote":true},{"t":"於正事懈怠，说名不恭敬。","level":0,"quote":true},{"t":"於师无尊心，说名不尊重。","level":0,"quote":true},{"t":"上心欲所起，於外名坚著，","level":0,"quote":true},{"t":"上心坚欲生，最重名遍著。","level":0,"quote":true},{"t":"自财生长欲，无足心名贪；","level":0,"quote":true},{"t":"爱著於他物，是名不等欲。","level":0,"quote":true},{"t":"於非境女人，求得非法欲，","level":0,"quote":true},{"t":"自无德显德，说名为恶欲。","level":0,"quote":true},{"t":"离知足恒求，说此名大欲。","level":0,"quote":true},{"t":"愿他知我德，说名为识欲。","level":0,"quote":true},{"t":"不能安苦受，说名为不忍。","level":0,"quote":true},{"t":"於师尊正事，邪行名不贵。","level":0,"quote":true},{"t":"如法善言教，轻慢名难语。","level":0,"quote":true},{"t":"於亲人爱著，思惟名亲觉。","level":0,"quote":true},{"t":"由欲於方处，思得名土觉。","level":0,"quote":true},{"t":"不虑死怖畏，说名不死觉。","level":0,"quote":true},{"t":"由真实功德，愿他尊重我，","level":0,"quote":true},{"t":"此思缘他识，说名顺觉觉。","level":0,"quote":true},{"t":"由爱及憎心，思自益损他，","level":0,"quote":true},{"t":"缘自及餘人，说名害他觉。","level":0,"quote":true},{"t":"忧忆染污心，无依名不安。","level":0,"quote":true},{"t":"身沈说名极，迟缓名懈怠。","level":0,"quote":true},{"t":"由随上心惑，曲发身名频。","level":0,"quote":true},{"t":"身乱不节食，说名为食醉。","level":0,"quote":true},{"t":"身心极疲羸，说名为下劣。","level":0,"quote":true},{"t":"贪爱於五尘，说名为欲欲。","level":0,"quote":true},{"t":"於他损害意，从九因缘生，","level":0,"quote":true},{"t":"三时疑灾横，说名为瞋恚。","level":0,"quote":true},{"t":"由身心重故，事无能名弱，","level":0,"quote":true},{"t":"心晦说名睡，身心掉名动。","level":0,"quote":true},{"t":"由恶事生悔，忧后燋然名。","level":0,"quote":true},{"t":"於三宝四谛，犹豫说名疑。","level":0,"quote":true},{"t":"若出家菩萨，须离此麁类，","level":0,"quote":true},{"t":"若能免此恶，对治德易生。","level":0,"quote":true},{"t":"此中诸功德，菩萨应修治，","level":0,"quote":true},{"t":"谓施戒及忍，勤定慧悲等。","level":0,"quote":true},{"t":"舍自物名施，起利他名戒，","level":0,"quote":true},{"t":"解脱瞋名忍，摄善名精进，","level":0,"quote":true},{"t":"心寂静名定，通真义名智，","level":0,"quote":true},{"t":"於一切众生，一味利名悲。","level":0,"quote":true},{"t":"施生富戒乐，忍爱勤焰炽，","level":0,"quote":true},{"t":"定静智解脱，悲生一切利。","level":0,"quote":true},{"t":"此七法若成，俱得至究竟，","level":0,"quote":true},{"t":"难思智境界，今到世尊位。","level":0,"quote":true},{"t":"如於小乘中，说诸声闻地，","level":0,"quote":true},{"t":"於大乘亦尔，说菩萨十地。","level":0,"quote":true},{"t":"初地名欢喜，於中喜希有，","level":0,"quote":true},{"t":"由三结灭尽，及生在佛家。","level":0,"quote":true},{"t":"因此地果报，现前修施度，","level":0,"quote":true},{"t":"於百佛世界，不动得自在。","level":0,"quote":true},{"t":"於剡浮等洲，为大转轮王，","level":0,"quote":true},{"t":"於世间恒转，宝轮及法轮。","level":0,"quote":true},{"t":"第二名无垢，身口意等业，","level":0,"quote":true},{"t":"十种皆清净，自性得自在。","level":0,"quote":true},{"t":"因此地果报，现前修戒度，","level":0,"quote":true},{"t":"於千佛世界，不动得自在。","level":0,"quote":true},{"t":"仙人天帝释，能除天爱欲，","level":0,"quote":true},{"t":"天魔及外道，皆所不能动。","level":0,"quote":true},{"t":"第三名明焰，寂慧光明生，","level":0,"quote":true},{"t":"由定及神通，欲瞋惑灭故。","level":0,"quote":true},{"t":"因此地果报，现前修忍辱，","level":0,"quote":true},{"t":"於万佛世界，不动得自在。","level":0,"quote":true},{"t":"作夜摩天帝，灭身见习气，","level":0,"quote":true},{"t":"一切邪师执，能破能正教。","level":0,"quote":true},{"t":"第四名烧然，智火光焰生，","level":0,"quote":true},{"t":"因此地果报，精进度现前。","level":0,"quote":true},{"t":"多修习道品，为灭惑生道，","level":0,"quote":true},{"t":"兜率陀天主，除外道见戒。","level":0,"quote":true},{"t":"由得生自在，於十方佛土，","level":0,"quote":true},{"t":"往还无障碍，餘义如前地。","level":0,"quote":true},{"t":"第五名难胜，魔二乘不及，","level":0,"quote":true},{"t":"圣谛微细义，证见所生故。","level":0,"quote":true},{"t":"因此地果报，定度得现前，","level":0,"quote":true},{"t":"为化乐天主，回二乘向大。","level":0,"quote":true},{"t":"第六名现前，正向佛法故，","level":0,"quote":true},{"t":"由数习定慧，证得灭圆满。","level":0,"quote":true},{"t":"因此地果报，般若度现前，","level":0,"quote":true},{"t":"他化自在天，能教真俗谛。","level":0,"quote":true},{"t":"第七名远行，远行数相续，","level":0,"quote":true},{"t":"於中念念得，无生及无灭。","level":0,"quote":true},{"t":"因此地果报，方便智现前，","level":0,"quote":true},{"t":"得为大梵王，能通第一义。","level":0,"quote":true},{"t":"证方便胜智，六度生无间，","level":0,"quote":true},{"t":"於三乘世俗，为最第一师。","level":0,"quote":true},{"t":"童子地不动，由不出真观，","level":0,"quote":true},{"t":"无分别难思，非身口意境。","level":0,"quote":true},{"t":"因此地果报，愿度常现前，","level":0,"quote":true},{"t":"胜遍光梵主，净土等自在。","level":0,"quote":true},{"t":"二乘等不及，於真俗一义，","level":0,"quote":true},{"t":"俱修动静故，行二利无间。","level":0,"quote":true},{"t":"第九名善慧，法王太子位，","level":0,"quote":true},{"t":"此中智最胜，由通达四辩。","level":0,"quote":true},{"t":"因此地果报，力度常现前，","level":0,"quote":true},{"t":"为遍净梵王，四答难无等。","level":0,"quote":true},{"t":"第十名法云，能雨正法雨，","level":0,"quote":true},{"t":"佛光水灌身，受佛灌顶位。","level":0,"quote":true},{"t":"因此地果报，智度常现前，","level":0,"quote":true},{"t":"为净居梵王，大自在天王。","level":0,"quote":true},{"t":"智慧境难思，诸佛秘密藏，","level":0,"quote":true},{"t":"得具足自在，后生补处位。","level":0,"quote":true},{"t":"如此菩萨地，十种我已说，","level":0,"quote":true},{"t":"佛地与彼异，具胜德难量。","level":0,"quote":true},{"t":"此地但略说，十力等相应，","level":0,"quote":true},{"t":"随此一一力，难量如虚空。","level":0,"quote":true},{"t":"如此等可言，诸佛无量德，","level":0,"quote":true},{"t":"如十方虚空，及地水火风。","level":0,"quote":true},{"t":"诸佛无量德，於餘人难信，","level":0,"quote":true},{"t":"若不见此因，难量如此果。","level":0,"quote":true},{"t":"为此因及果，现前佛支提，","level":0,"quote":true},{"t":"日夜各三遍，愿诵二十偈。","level":0,"quote":true},{"t":"诸佛法及僧，一切诸菩萨，","level":0,"quote":true},{"t":"我顶礼归依，餘可尊亦敬。","level":0,"quote":true},{"t":"我离一切恶，摄持一切善，","level":0,"quote":true},{"t":"众生诸善行，随喜及顺行。","level":0,"quote":true},{"t":"头面礼诸佛，合掌劝请住，","level":0,"quote":true},{"t":"愿为转法轮，穷生死后际。","level":0,"quote":true},{"t":"从此行我德，已作及未作，","level":0,"quote":true},{"t":"因此愿众生，皆发菩提心。","level":0,"quote":true},{"t":"度一切障难，圆满无垢根，","level":0,"quote":true},{"t":"具净命相应，愿彼自在事。","level":0,"quote":true},{"t":"一切具无边，与宝手相应，","level":0,"quote":true},{"t":"穷后际无尽，愿众生如此。","level":0,"quote":true},{"t":"愿一切女人，皆成胜丈夫，","level":0,"quote":true},{"t":"恒於一切时，明足得圆满。","level":0,"quote":true},{"t":"胜形貌威德，好色他爱见，","level":0,"quote":true},{"t":"无病力办具，长寿愿彼然。","level":0,"quote":true},{"t":"解脱诸苦畏，一向归三宝，","level":0,"quote":true},{"t":"於方便善巧，佛法为大财。","level":0,"quote":true},{"t":"慈悲喜净舍，恒居四梵住，","level":0,"quote":true},{"t":"施戒忍精进，定智所庄严。","level":0,"quote":true},{"t":"圆满福慧行，相好光明照，","level":0,"quote":true},{"t":"愿彼难思量，行十地无碍。","level":0,"quote":true},{"t":"与此德相应，餘德所庄严，","level":0,"quote":true},{"t":"解脱一切过，愿我爱众生。","level":0,"quote":true},{"t":"圆满一切善，及众生所乐，","level":0,"quote":true},{"t":"能除他众苦，愿我恒如此。","level":0,"quote":true},{"t":"若他有怖畏，一切时及处，","level":0,"quote":true},{"t":"由唯忆我名，得脱一切苦。","level":0,"quote":true},{"t":"敬信我及瞋，若见及忆持，","level":0,"quote":true},{"t":"乃至闻我名，愿彼定菩提。","level":0,"quote":true},{"t":"愿我得五通，恒随一切生，","level":0,"quote":true},{"t":"愿我恒能生，众生善及乐。","level":0,"quote":true},{"t":"若他欲作恶，於一切世界，","level":0,"quote":true},{"t":"愿遍断彼恶，如理令修善。","level":0,"quote":true},{"t":"如地水火风，野药及林树，","level":0,"quote":true},{"t":"如他欲受用，愿我自忍受。","level":0,"quote":true},{"t":"愿我他所爱，如念自寿命，","level":0,"quote":true},{"t":"愿我念众生，万倍胜自爱。","level":0,"quote":true},{"t":"愿彼所作恶，於我果报熟，","level":0,"quote":true},{"t":"是我所行善，於彼果报熟。","level":0,"quote":true},{"t":"一人未解脱，於有随生道，","level":0,"quote":true},{"t":"愿我为彼住，不先取菩提。","level":0,"quote":true},{"t":"能如此修行，福德若有体，","level":0,"quote":true},{"t":"於恒沙世界，其功不可量。","level":0,"quote":true},{"t":"佛世尊自说，如此因难量，","level":0,"quote":true}],[{"t":"众生界无量，利益愿亦尔。","level":0,"quote":true},{"t":"此法我略说，能生自他利，","level":0,"quote":true},{"t":"愿汝爱此法，如爱念自身。","level":0,"quote":true},{"t":"若人爱此法，是实爱自身，","level":0,"quote":true},{"t":"是所爱应憎，此憎由法成。","level":0,"quote":true},{"t":"故事法如身，事行如事法，","level":0,"quote":true},{"t":"如行事慧然，如慧事智者。","level":0,"quote":true},{"t":"净顺有智慧，伏他说正理，","level":0,"quote":true},{"t":"由自恶疑他，此人损自事。","level":0,"quote":true},{"t":"是诸善知识，汝应知略相，","level":0,"quote":true},{"t":"知足慈悲戒，智慧能灭恶。","level":0,"quote":true},{"t":"善友应教汝，汝知敬顺行，","level":0,"quote":true},{"t":"由内外胜德，汝必至胜处。","level":0,"quote":true},{"t":"实誓说爱言，乐性不可动，","level":0,"quote":true},{"t":"正事增谄曲，愿汝自易教。","level":0,"quote":true},{"t":"已舍无有悔，有焰炽心寂，","level":0,"quote":true},{"t":"无懈缓掉动，不贡高和同。","level":0,"quote":true},{"t":"愿清凉如月，有炽盛如日，","level":0,"quote":true},{"t":"甚深如大海，坚住如山王。","level":0,"quote":true},{"t":"一切果所离，众德所庄严，","level":0,"quote":true},{"t":"众生所受用，愿汝一切智。","level":0,"quote":true},{"t":"我不但为王，说如此善法，","level":0,"quote":true},{"t":"如理为餘人，由欲利一切。","level":0,"quote":true},{"t":"大王此正论，汝日日谛听，","level":0,"quote":true},{"t":"为令自及他，得无上菩提。","level":0,"quote":true},{"t":"胜戒敬尊长，忍辱无嫉妬，","level":0,"quote":true},{"t":"不悋财知足，救济堕难事。","level":0,"quote":true},{"t":"能行善恶人，摄持及制伏，","level":0,"quote":true},{"t":"弘护佛正法，求菩提应行。","level":0,"quote":true},{"t":"宝行王正论一卷","level":0}]]