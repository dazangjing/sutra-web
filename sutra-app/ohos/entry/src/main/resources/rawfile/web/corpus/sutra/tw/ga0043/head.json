{"id":"ga0043","title":"寒山寺志","titleTrad":"寒山寺志","byline":"","bylineLabel":"著者·译者","dynasty":"","division":"史传部","canon":"GA0043","canonName":"佛寺志彙刊","volume":"GA0043","juanCount":3,"textLength":56022,"imageCount":0,"summary":"","tags":["史传部","佛寺志彙刊"],"order":2754,"guide":"","chunks":11,"toc":[{"level":3,"text":"卷首自序自序"},{"level":2,"text":"目錄卷第一"},{"level":3,"text":"後序"},{"level":2,"text":"寒山寺志卷二"},{"level":3,"text":"世宗憲皇帝御製寒山子詩序"},{"level":2,"text":"寒山寺志卷三"},{"level":3,"text":"林幽隱之興，或譏諷時態，能警勵流俗。桐柏徵君徐靈府序"},{"level":3,"text":"明瞿汝稷：寒山詩序"},{"level":3,"text":"島田翰：刻宋本《寒山詩集》序"},{"level":3,"text":"乎？明治三十八年太歲乙巳夏四月，島田翰序"}],"chunksPerFile":20}