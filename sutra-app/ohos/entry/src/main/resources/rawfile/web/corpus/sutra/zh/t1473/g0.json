[[{"t":"佛说沙弥十戒仪则经(计七十二颂)","level":0},{"t":"西天译经三藏朝散大夫试鸿胪少卿传法大师臣施护奉　诏译","level":0},{"t":"顶礼一切智，妙法及圣众，","level":0,"quote":true},{"t":"略说沙弥行，令发出家心。","level":0,"quote":true},{"t":"於彼释迦教，坚持於禁戒，","level":0,"quote":true},{"t":"持戒如护身，防守勿令犯。","level":0,"quote":true},{"t":"夜卧从早起，净口及牙齿，","level":0,"quote":true},{"t":"念诵至天明，顶礼正等觉。","level":0,"quote":true},{"t":"参近於师房，以手轻击门，","level":0,"quote":true},{"t":"入已问讯师，身体安乐不？","level":0,"quote":true},{"t":"如是所作已，复作曼拏罗，","level":0,"quote":true},{"t":"供养而恭敬，早辰观水内，","level":0,"quote":true},{"t":"中后时亦然，瓮器盂钵等。","level":0,"quote":true},{"t":"水虫有大小，志心恒观照，","level":0,"quote":true},{"t":"以罗净滤水，审观而可用。","level":0,"quote":true},{"t":"食饮怀慈愍，勿令杀害虫，","level":0,"quote":true},{"t":"乃至草木上，涂坛牛粪中，","level":0,"quote":true},{"t":"如是受用时，救护於含识。","level":0,"quote":true},{"t":"或彼床座内，田地粪土中，","level":0,"quote":true},{"t":"一一子细观，是名出家行。","level":0,"quote":true},{"t":"一切承事师，洗钵令清净，","level":0,"quote":true},{"t":"依时三作礼，合掌向师前。","level":0,"quote":true},{"t":"问师何所食？作食治饥病，","level":0,"quote":true},{"t":"如是若为食，用前清净水，","level":0,"quote":true},{"t":"以水灌手净，如法默然食。","level":0,"quote":true},{"t":"食已说二偈，回向於信施，","level":0,"quote":true},{"t":"如说而依行，增长正念行。","level":0,"quote":true},{"t":"信解净戒法，依法而修持，","level":0,"quote":true},{"t":"正观自相应，出家心安乐。","level":0,"quote":true},{"t":"若人自犯戒，他见生轻毁，","level":0,"quote":true},{"t":"二人皆得罪，持者须一心。","level":0,"quote":true},{"t":"持戒或破戒，乃至病患人，","level":0,"quote":true},{"t":"说法不当机，他闻心不重，","level":0,"quote":true},{"t":"命终得大苦。若人行毒药，","level":0,"quote":true},{"t":"及行呪法等，令他得命终，","level":0,"quote":true},{"t":"又复以种种，方便而行杀，","level":0,"quote":true},{"t":"如是破戒因，永沈三恶道，","level":0,"quote":true},{"t":"地狱鬼畜生，如次受罪报。","level":0,"quote":true},{"t":"及彼诸天辈，若或亦杀生，","level":0,"quote":true},{"t":"还堕恶趣中，受彼诸恶报。","level":0,"quote":true},{"t":"若有出家者，恣用身口意，","level":0,"quote":true},{"t":"误杀蝼蚁类，於其三业中，","level":0,"quote":true},{"t":"而得三种罪。若人以拳棒，","level":0,"quote":true},{"t":"土石及塼瓦，打掷於有情，","level":0,"quote":true},{"t":"驼骡禽兽等，亦得破戒罪。","level":0,"quote":true},{"t":"驼骡象马类，而欲辄乘骑，","level":0,"quote":true},{"t":"往来逼迫他，亦得破戒罪。","level":0,"quote":true},{"t":"若有出家者，不得行偷盗，","level":0,"quote":true},{"t":"若自若教他，偷得於财物，","level":0,"quote":true},{"t":"迦哩沙波拏，四分中一分，","level":0,"quote":true},{"t":"如是破戒因，而成最重罪。","level":0,"quote":true},{"t":"饮食谷米等，花菓草木类，","level":0,"quote":true},{"t":"地生或水生，而行於偷窃，","level":0,"quote":true},{"t":"或偷官税利，私过於关津，","level":0,"quote":true},{"t":"及盗於有情，二足与多足。","level":0,"quote":true},{"t":"或彼出家人，受用虽具足，","level":0,"quote":true},{"t":"贪心复盗财，俱获於重罪。","level":0,"quote":true},{"t":"若自衣钵等，被贼所劫盗，","level":0,"quote":true},{"t":"勿得强取之，说法方便化，","level":0,"quote":true},{"t":"或复而回买，不允随他意。","level":0,"quote":true},{"t":"是名出家心，不动三业疮，","level":0,"quote":true},{"t":"戒性自成就。若有出家者，","level":0,"quote":true},{"t":"不得行婬欲。女男及黄门，","level":0,"quote":true},{"t":"自来相慕欲，愚迷而爱著，","level":0,"quote":true},{"t":"得彼根本罪。若彼故行婬，","level":0,"quote":true},{"t":"如蛇如毒药，损坏於自身，","level":0,"quote":true},{"t":"得大地狱苦，障碍於涅槃，","level":0,"quote":true},{"t":"不出於生死。正觉非如是，","level":0,"quote":true},{"t":"未曾身犯戒，持戒获大利。","level":0,"quote":true},{"t":"若有出家者，不得出妄语。","level":0,"quote":true},{"t":"若言见天人，与我同言语，","level":0,"quote":true},{"t":"大人所住处，我自亦曾到，","level":0,"quote":true},{"t":"乃至乾闼婆，恭伴龙夜叉，","level":0,"quote":true},{"t":"摩睺罗伽辈，毘舍紧那罗，","level":0,"quote":true},{"t":"钵哩哆鬼等，与我恒言话，","level":0,"quote":true},{"t":"此皆为妄语。或言得五通，","level":0,"quote":true},{"t":"正道及四果，晓了甚深法，","level":0,"quote":true},{"t":"未得言为得，如斯之妄语，","level":0,"quote":true},{"t":"永沈於恶趣。不得起两舌，","level":0,"quote":true},{"t":"离别他善友，及彼麁恶言，","level":0,"quote":true},{"t":"绮说非与是。设被他毁骂，","level":0,"quote":true},{"t":"勿得酬对他，种种鬪诤言，","level":0,"quote":true},{"t":"一一须忍受。若彼不依行，","level":0,"quote":true},{"t":"而得犯戒罪；智者一心持，","level":0,"quote":true},{"t":"获离口业过。若以谷米等，","level":0,"quote":true},{"t":"为酒醉於人，不得而故饮。","level":0,"quote":true},{"t":"或以甘蔗花，蒲萄菓实等，","level":0,"quote":true},{"t":"修酝可醉人，不得而故饮。","level":0,"quote":true},{"t":"自饮教他饮，迷乱而失念，","level":0,"quote":true},{"t":"增长放逸心，饮者得重罪。","level":0,"quote":true},{"t":"是故世尊言，若人以草叶，","level":0,"quote":true},{"t":"滴酒於口中，增长於过失。","level":0,"quote":true},{"t":"歌舞兼倡妓，故往而观看，","level":0,"quote":true},{"t":"而得犯戒罪。香油涂饰身，","level":0,"quote":true},{"t":"旃檀欝金等，及以好花鬘，","level":0,"quote":true},{"t":"金银珠宝类，种种庄严身，","level":0,"quote":true},{"t":"而得犯戒罪。若於眼目上，","level":0,"quote":true},{"t":"点畫令端正，而得犯戒罪。","level":0,"quote":true},{"t":"座床卧床等，量高可一肘，","level":0,"quote":true},{"t":"亦不作庄严，复不令广大，","level":0,"quote":true},{"t":"放逸不依行，而得犯戒罪。","level":0,"quote":true},{"t":"佛说出家人，过失宜远离。","level":0,"quote":true},{"t":"若受斋食时，不得过中午，","level":0,"quote":true},{"t":"日出至午前，可许受斋饭；","level":0,"quote":true},{"t":"非时而吃食，佛说得重罪。","level":0,"quote":true},{"t":"如有比丘病，治病救於身，","level":0,"quote":true},{"t":"可许中后食；无病不依时，","level":0,"quote":true},{"t":"而得犯戒罪。金银珍宝等，","level":0,"quote":true},{"t":"出家不得触，受者生於贪，","level":0,"quote":true},{"t":"而得犯戒罪。若有檀信施，","level":0,"quote":true},{"t":"供养佛法僧，为彼兴福利，","level":0,"quote":true},{"t":"可许而受用。一切快乐具，","level":0,"quote":true},{"t":"勿得生爱著，若有贪著者，","level":0,"quote":true},{"t":"彼人须摈出。所有戏笑等，","level":0,"quote":true},{"t":"沙弥不得作，作者得犯罪。","level":0,"quote":true},{"t":"若有呵欠时，以手遮盖口，","level":0,"quote":true},{"t":"不依而得罪。上座作啑喷，","level":0,"quote":true},{"t":"不审而顶礼，新戒等啑喷，","level":0,"quote":true},{"t":"上座须呪愿，长寿无其病。","level":0,"quote":true},{"t":"沙弥向师前，不得於洟唾，","level":0,"quote":true},{"t":"不得刷牙齿。不得向师前，","level":0,"quote":true},{"t":"经行及对座。耆年宿德者，","level":0,"quote":true},{"t":"如法而尊重。若入触溷时，","level":0,"quote":true},{"t":"如有后来者，低声而警觉。","level":0,"quote":true},{"t":"所滤无虫水，用添於净瓶，","level":0,"quote":true},{"t":"净手安详行，不失出家行。","level":0,"quote":true},{"t":"师自座卧床，恒用净衬褥，","level":0,"quote":true},{"t":"所有床椅等，不得沙弥座。","level":0,"quote":true},{"t":"师自若不在，依止清净僧，","level":0,"quote":true},{"t":"明了律仪者，承事而侍奉；","level":0,"quote":true},{"t":"勿更依别僧，违者而得罪。","level":0,"quote":true},{"t":"比丘若出行，而为求缘事，","level":0,"quote":true},{"t":"五日内复归，得利同行众；","level":0,"quote":true},{"t":"众得利亦然，复与外来者，","level":0,"quote":true},{"t":"如过五日后，二俱各无分。","level":0,"quote":true},{"t":"沙弥大小便，须问佛僧地，","level":0,"quote":true},{"t":"不得乱往来，行依自界分。","level":0,"quote":true},{"t":"一切凡所作，合掌先问师，","level":0,"quote":true},{"t":"如是所作为，不失於正行。","level":0,"quote":true},{"t":"日没礼佛塔，礼已复问师，","level":0,"quote":true},{"t":"与师濯双足，事毕一心听，","level":0,"quote":true},{"t":"颙望於所须。初夜及后夜，","level":0,"quote":true},{"t":"持诵勿须停。中夜睡眠时，","level":0,"quote":true},{"t":"如彼师子卧。所说一切法，","level":0,"quote":true},{"t":"志心而依行，薰识贤种子，","level":0,"quote":true},{"t":"烦恼自断除，速成无上觉。","level":0,"quote":true},{"t":"佛说沙弥十戒仪则经","level":0}]]