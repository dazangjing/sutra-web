{"id":"x0317","title":"楞嚴經正見","titleTrad":"楞嚴經正見","byline":"住婁東古興福禪寺沙門","bylineLabel":"著者·译者","dynasty":"","division":"经疏部","canon":"X0317","canonName":"新纂卍續藏","volume":"X0317","juanCount":10,"textLength":188059,"imageCount":0,"summary":"","tags":["经疏部","新纂卍續藏"],"order":1443,"guide":"","chunks":51,"toc":[{"level":3,"text":"序"},{"level":2,"text":"薩萬行首楞嚴經正見卷第一"},{"level":3,"text":"△一、序文分三：一、常序，二、別序，三、因緣序。初常序"},{"level":2,"text":"正見卷第二"},{"level":3,"text":"是總指佛綱宗之用也。經家省文，故作如此之序"},{"level":2,"text":"正見卷第三"},{"level":2,"text":"正見卷第四"},{"level":2,"text":"正見卷第五"},{"level":2,"text":"正見卷第六"},{"level":2,"text":"正見卷第七"},{"level":2,"text":"正見卷第八"},{"level":2,"text":"正見卷第九"},{"level":2,"text":"正見卷第十"},{"level":3,"text":"首楞嚴經正見後序"},{"level":3,"text":"後序"},{"level":3,"text":"無名正見禪人後序"}],"chunksPerFile":20}