[[{"t":"汝曹","level":0},{"t":"又作瞽同自劳反史记十餘曹[攸-ㄆ+盾]之如淳曰曹辈也。","level":0},{"t":"毗瑟笯","level":0},{"t":"奴故反天名也旧言毗纽天亦言毗搜纽天讹也。","level":0},{"t":"第十四卷","level":0},{"t":"梯隥","level":0},{"t":"都邓反广雅隥履也依之而上者也字从<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07293.gif\" alt=\"𠂤\" title=\"𠂤\" />。","level":0},{"t":"室路迦","level":0},{"t":"旧言输卢迦或云首卢迦又言首卢柯案西国数经之法皆以三十二字为一室路迦又多约凢夫作世闲咏者也此则阐陁论中之一数也。","level":0},{"t":"第十六卷","level":0},{"t":"升陟","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10325.gif\" alt=\"𦙘\" title=\"𦙘\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00331.gif\" alt=\"𣗥\" title=\"𣗥\" />反言进达之升曰陟诗云陟彼高岗陟登也尓雅陟升也谓登升之也。","level":0},{"t":"痱瘤","level":0},{"t":"蒲罪反下卢罪反字略云痱瘤小肿也今取其义。","level":0},{"t":"波沓波种","level":0},{"t":"徒荅反则婆罗门姓也。","level":0},{"t":"第十八卷","level":0},{"t":"池沼","level":0},{"t":"之遶反说文沼池也小池也。","level":0},{"t":"命命鸟","level":0},{"t":"梵言耆婆耆婆鸟也。","level":0},{"t":"子息","level":0},{"t":"思力反儿子曰息息者气在人身中所禀以生也东观汉记云此盖我子息是也今人出钱生子亦曰息义一也。","level":0},{"t":"第十九卷","level":0},{"t":"是畴","level":0},{"t":"除留反楚辝谁可与子疋畴王逸曰二人为疋四人为畴畴类也亦伴侣也。","level":0},{"t":"乳醅","level":0},{"t":"又作𨟷同疋回反谓末漉酒者也言乳能成酪醅能成酒也。","level":0},{"t":"广树","level":0},{"t":"籀文作尌同时注反广雅树立也凢置立皆曰树树亦种殖也。","level":0},{"t":"屡辩","level":0},{"t":"力句反尚书屡省乃成孔安国曰屡数也。","level":0},{"t":"第二十卷","level":0},{"t":"持羂","level":0},{"t":"又作[曰/月]同古犬公县二反声类云<img class=\"gaiji\" src=\"asset://gaiji-CB/22/CB22876.gif\" alt=\"𦊰\" title=\"𦊰\" />以绳系取鸟兽也。","level":0},{"t":"挽出","level":0},{"t":"古文𫏸同无远反说𫏸引车也。","level":0},{"t":"鄙俚","level":0},{"t":"字体作𨛋同力子反说文五酂为鄙鄙𨛋也苍颉篇国之下邑曰𨛋汉书质而不𨛋如淳曰虽质犹不如闾里之鄙言也鄙猥陋也广雅鄙羞耻也酂音祖旦反百家也。","level":0},{"t":"尚年","level":0},{"t":"市让反苍颉训诂云尚上犹盛年也。","level":0},{"t":"袤耄","level":0},{"t":"字体作𤸬同所龟反说文𤸬减也[損-口+ㄙ]也礼记年五十始𤸬瘘懈也下古文𠅸耄二形今耗同莫报反礼记八十曰耄耄谓惛忘也暗乱也。","level":0},{"t":"鸠摩罗设摩","level":0},{"t":"此云童寂多造诗咏者扇帙略外道名也造因明名即毗婆沙中扇提罗外道是也。","level":0},{"t":"第二十一卷","level":0},{"t":"无繁","level":0},{"t":"扶袁反诗云正月繁霜传曰繁多盛。","level":0},{"t":"水濯","level":0},{"t":"徒角反说文濯涤也洒也谓以水净物曰濯也。","level":0},{"t":"设支","level":0},{"t":"旧言舍脂此云能缚谓女人若可爱能生男子染著通名设支。","level":0},{"t":"第二十二卷","level":0},{"t":"荏苒","level":0},{"t":"而甚反下而琰反言湏[更-一]也。","level":0},{"t":"阿奴律陁","level":0},{"t":"亦作卢骨反此云随顺义人名。","level":0},{"t":"匡助","level":0},{"t":"丘方反尓疋匡正也助佐也匡亦复也。","level":0},{"t":"世罗乌波","level":0},{"t":"乌古反此云小石也。","level":0},{"t":"属斯","level":0},{"t":"之欲反属著也亦连续也适也。","level":0},{"t":"第二十三卷","level":0},{"t":"师雨","level":0},{"t":"于矩反谓雨安居也言师若干夏腊也。","level":0},{"t":"童竖","level":0},{"t":"殊<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12777.gif\" alt=\"𢈔\" title=\"𢈔\" />反谓寺人未冠者之名也使通内外之命以其无有礼入出便疾也。","level":0},{"t":"蟰蛸","level":0},{"t":"音肃萧尓疋蟰蛸一名长踦踦音居蚁反郭𤩶曰小蜘蛛长脚者俗呼为喜子诗云蟰蛸在户是也。","level":0},{"t":"虹电","level":0},{"t":"古文羾同胡公反俗音绛尓疋音义曰双出鲜盛者为雄雄曰虹暗者为雌雌曰蜺蜺音五鸡反说文䗖𬟽虹也江东呼为<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15880.gif\" alt=\"𩁹\" title=\"𩁹\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/18/CB18232.gif\" alt=\"𥼶\" title=\"𥼶\" />名虹攻也纯阳攻阴气也䗖音帝𬟽音童。","level":0},{"t":"缚喝国","level":0},{"t":"呼曷反北临缚河其国中有如来澡灌可一斗餘众色炫焴金石难名又有佛牙又有佛扫帚迦奢草作也长二尺餘园七寸其把杂宝饰之也。","level":0},{"t":"波咤<img class=\"gaiji\" src=\"asset://gaiji-CB/12/CB12530.gif\" alt=\"𨤲\" title=\"𨤲\" />","level":0},{"t":"力之反亦云波咤梨耶旧云巴连弗讹也是一花树名因此花树以目城也。","level":0},{"t":"第二十四卷","level":0},{"t":"尺蠖","level":0},{"t":"乌郭反说文申屈虫也尓疋蠖尺蠖一名屈宋地曰寻乘吴人名乘阖阖音古合反即乘虫也。","level":0},{"t":"阿泥律陁","level":0},{"t":"旧言阿<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />律或云阿<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00145.gif\" alt=\"㝹\" title=\"㝹\" />楼<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00501.gif\" alt=\"䭾\" title=\"䭾\" />亦言阿泥卢豆皆一也此云无灭亦云如意昔施辟支一食於八十劫人天之中徃来受乐于今不灭故云无灭又所求如意亦名如意即甘露饭王之子佛堂弟也。","level":0},{"t":"朋友","level":0},{"t":"蒲崩反下于久反说文同门曰朋同志曰友广雅友亲也爱也。","level":0},{"t":"方域","level":0},{"t":"为逼反域居也说文域邦也周礼方域谓建邦国造都鄙制乡邑也。","level":0},{"t":"酷毒","level":0},{"t":"口木反谓暴虐也说文酷<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03871.gif\" alt=\"㥯\" title=\"㥯\" />也甚也白虎通曰酷极也教令穷极也。","level":0},{"t":"兾除","level":0},{"t":"又作觊同羇致反小尓疋云觊望也。","level":0},{"t":"飘鼓","level":0},{"t":"匹遥反下公户反飘吹也鼓动也案凢动物皆谓之鼓也。","level":0},{"t":"第二十五卷","level":0},{"t":"师徒","level":0},{"t":"达胡反徒类也<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />子云孔丘之徒司马[彰-章+(皮-(〡/又)+(王/巾))]曰徒弟子也。","level":0},{"t":"仁孝","level":0},{"t":"而亲反爱人以及物曰仁上下相亲曰仁贵贤亲亲曰仁煞身成人曰仁尓疋善父母为孝谥法曰慈爱忘劳曰孝从命不违曰孝。","level":0},{"t":"承禀","level":0},{"t":"鄙锦反禀受也。","level":0},{"t":"第二十六卷","level":0},{"t":"苟欲","level":0},{"t":"公厚反广雅苟且也亦诚也。","level":0},{"t":"言词","level":0},{"t":"鱼鞬反下似资反直言曰言言己事也荅述为语为人说也礼记三年之丧言而不语是也言亦云也发端也说文词者意内而言外也亦审言语也。","level":0},{"t":"第二十七卷","level":0},{"t":"[圖-囗]度","level":0},{"t":"案诏定古文书图[圖-囗]二形同达胡反下徒各反广雅[圖-囗]度也议也亦计也度量也。","level":0},{"t":"每言","level":0},{"t":"莫载反三苍每非一定之辝也每亦数也。","level":0},{"t":"[山/(乏-之+虫)]诮","level":0},{"t":"(才笑反谓谓娆弄讥责也亦诃也)。","level":0},{"t":"第二十八卷","level":0},{"t":"纫绳","level":0},{"t":"女[玝-十+小]反字林云单绳曰纫纫索也。","level":0},{"t":"瀑流","level":0},{"t":"蒲报反苍颉解诘云瀑水溃起也。","level":0},{"t":"婆歰波言","level":0},{"t":"所立反此云气谓雾气等也。","level":0},{"t":"第二十九卷","level":0},{"t":"为杖","level":0},{"t":"直亮反杖犹据也亦杖托也。","level":0},{"t":"第三十卷","level":0},{"t":"染污","level":0},{"t":"纡剉乌故二反字书污涂也字林污秽也。","level":0},{"t":"咀嚼","level":0},{"t":"又作龃同才与反下慈药反含味也咀龃也通俗文咀啮曰嚼也。","level":0},{"t":"津液","level":0},{"t":"子隣反下夷石反三苍津液汁也说文液津润也广雅滋液也润泽也。","level":0},{"t":"诚言","level":0},{"t":"市盈反广疋诚实也说文诚信也敬也。","level":0},{"t":"乍可","level":0},{"t":"仕嫁反广雅乍暂也苍颉篇乍两辝也。","level":0},{"t":"齐心","level":0},{"t":"昨迷反说文毗齐人齐也字从肉毗音蒲迷反。","level":0},{"t":"讥刺","level":0},{"t":"居衣反下又作谏同且渍反广雅讥刾也说文讥诽也。","level":0},{"t":"数瞚","level":0},{"t":"又作瞬同尸闰反说文瞚目开閇数摇也。","level":0},{"t":"第三十一卷","level":0},{"t":"畟方","level":0},{"t":"楚力反谓正方也。","level":0},{"t":"开辟","level":0},{"t":"脾亦反说文辟开也。","level":0},{"t":"关闭","level":0},{"t":"补结补计二反说文𨶩门也广雅闭塞也守也或作閇俗字也。","level":0},{"t":"荼毒","level":0},{"t":"达胡反广疋荼毒痛也亦行<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />也。","level":0},{"t":"重垒","level":0},{"t":"又作垒同力癸反垒亦重也。","level":0},{"t":"拼量","level":0},{"t":"补茎反谓弹绳墨曰拼江南名抨音普庚反。","level":0},{"t":"寻稣","level":0},{"t":"息胡反稣活也小尓疋云死而复生谓之稣稣<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00896.gif\" alt=\"𥧝\" title=\"𥧝\" />也。","level":0},{"t":"祖瀬","level":0},{"t":"仕加反下力𦫿反通俗之𠚫餘曰祖广疋祖距也诗云如彼捿祖是也。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00603.gif\" alt=\"䶧\" title=\"䶧\" />足","level":0},{"t":"又作𫜪同五狡及<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00603.gif\" alt=\"䶧\" title=\"䶧\" />啮也关中行此音又下狡反江南行此音。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02237.gif\" alt=\"䶗\" title=\"䶗\" />颈","level":0},{"t":"字林丘加反下居井反言以口<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02237.gif\" alt=\"䶗\" title=\"䶗\" />也大啮也今以手颈项前也。","level":0},{"t":"擘胂","level":0},{"t":"补麦反下引人反当脊肉曰胂也擘分裂也。","level":0},{"t":"攫腹","level":0},{"t":"九缚居碧二反说文攫爪持也通俗文手把曰攫苍颉篇攫搏也兽穷则攫是也。","level":0},{"t":"掐心","level":0},{"t":"他劳反说文掐捾也捾一活反中国言掐江南言挑音土雕反。","level":0},{"t":"镵刾","level":0},{"t":"仕衫反下七亦反说文镵<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07536.gif\" alt=\"𨦣\" title=\"𨦣\" />也。","level":0},{"t":"漉诸","level":0},{"t":"或作浕同力木反水下<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15032.gif\" alt=\"㒵\" title=\"㒵\" />也。","level":0},{"t":"嗢钵罗","level":0},{"t":"乌没反此云黛花旧言优钵罗或云沤钵罗讹也。","level":0},{"t":"钵特摩","level":0},{"t":"徒得反此云赤莲花旧言波头摩云钵昙摩皆讹也。","level":0},{"t":"凄劲","level":0},{"t":"且奚反下居政反诗云凄其以风传曰凄寒风也劲切<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03871.gif\" alt=\"㥯\" title=\"㥯\" />也。","level":0},{"t":"屯聚","level":0},{"t":"徒昆反广雅屯<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />也<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />音才句反。","level":0},{"t":"僵鞕","level":0},{"t":"居良反下五更反字略云死不朽曰彊物坚曰鞕。","level":0},{"t":"紧捺落","level":0},{"t":"奴葛反此云是人非人歌神也头作马头旧言紧<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />罗或作真陁罗皆讹也。","level":0},{"t":"炬针","level":0},{"t":"其吕反下声类今作针同支谌反束火曰炬缝衣曰针。","level":0},{"t":"空欧","level":0},{"t":"又作呕同於口反欧吐也<img class=\"gaiji\" src=\"asset://gaiji-CB/18/CB18232.gif\" alt=\"𥼶\" title=\"𥼶\" />名云欧伛也将有所吐脊曲伛反。","level":0},{"t":"毒[胣-也+布]","level":0},{"t":"又作㾙𤴾二形同火靳反江南言[胣-也+布]肿说文肉反出也。","level":0},{"t":"鬼胭","level":0},{"t":"又作咽同一千反胭喉也北人名颈为胭也。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00315.gif\" alt=\"㓟\" title=\"㓟\" />𮊞","level":0},{"t":"音皮下又作涑同子礼反广雅<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00315.gif\" alt=\"㓟\" title=\"㓟\" />剥也𮊞漉也谓搦出汁也。","level":0},{"t":"飨受","level":0},{"t":"又作享同虚仰反歆享也谓神食气也亦献也歆虚音反。","level":0},{"t":"俱臻","level":0},{"t":"侧巾反尓疋臻至也。","level":0},{"t":"欢娱","level":0},{"t":"字诂古文虞今作娱同疑区反说文娱乐也言皆娱乐也。","level":0},{"t":"第三十二卷","level":0},{"t":"乌施罗","level":0},{"t":"末草名也形如此土细辛其体极冷。","level":0},{"t":"剋胜","level":0}],[{"t":"又作克同口得反字林剋能也剋亦胜也。","level":0},{"t":"林藤","level":0},{"t":"徒登反广雅藤万也今呼如葛<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10262.gif\" alt=\"𦽦\" title=\"𦽦\" />莚者为藤。","level":0},{"t":"率土","level":0},{"t":"所律反尓疋率自也[攸-ㄆ+盾]也。","level":0},{"t":"第三十三卷","level":0},{"t":"夷恱","level":0},{"t":"余之反说文夷平也亦明也常也恱乐也。","level":0},{"t":"所瀹","level":0},{"t":"又作爚鬻汋三形同[更-一]灼反通俗文以汤煮物曰瀹广雅瀹汤也谓汤内出之也江东呼瀹为煠煠音助甲反。","level":0},{"t":"不肖","level":0},{"t":"私妙反小尓疋不肖不似也言骨肉不似其先故曰不肖谓儜<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />之类也字从肉小声。","level":0},{"t":"厌祷","level":0},{"t":"於𮉼反下都导反字苑厌眠内不祥也伏合人心曰厌说文告事求请曰祷谓请於鬼神也。","level":0},{"t":"制作","level":0},{"t":"之世反制裁制也制断之也说文作制。","level":0},{"t":"庵没罗","level":0},{"t":"旧言庵磨罗亦作诃摩勒皆讹也[葉-世+ㄊ]如小枣果如胡桃其味酸而且甜堪入药分。","level":0},{"t":"主宰","level":0},{"t":"祖待反礼记宰夫为献主谓主膳食之官也。","level":0},{"t":"擅立","level":0},{"t":"市战反广雅擅专也专己自为也。","level":0},{"t":"专己","level":0},{"t":"之缘反专犹自是也专壹也任也。","level":0},{"t":"第三十四卷","level":0},{"t":"屋宇","level":0},{"t":"古文<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00716.gif\" alt=\"㝢\" title=\"㝢\" />籀文𢉠同于甫反说文宇屋边檐也<img class=\"gaiji\" src=\"asset://gaiji-CB/18/CB18232.gif\" alt=\"𥼶\" title=\"𥼶\" />云宇羽也如鸟羽翼自覆蔽也於国则四垂为宇。","level":0},{"t":"人捦","level":0},{"t":"又作鈘㯲二形<img class=\"gaiji\" src=\"asset://gaiji-CB/18/CB18232.gif\" alt=\"𥼶\" title=\"𥼶\" />名作钥同巨金反捦<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03871.gif\" alt=\"㥯\" title=\"㥯\" />持也持匈也。","level":0},{"t":"捶挞","level":0},{"t":"又作箠同之药反下古文𢽞同他达反广雅捶挞击也。","level":0},{"t":"壃界","level":0},{"t":"居良反壃境也亦界也尓疋畺垂也僵场在外垂也。","level":0},{"t":"摸放","level":0},{"t":"又作摹同莫胡反小尓疋摸法也谓规形曰摸亦掩取象也。","level":0},{"t":"第三十五卷","level":0},{"t":"评论","level":0},{"t":"皮柄反字书评订也订平议也订音唐顶反。","level":0},{"t":"为挫","level":0},{"t":"祖卧反说文挫摧也谓折其锋也挫折也。","level":0},{"t":"匈㯲","level":0},{"t":"居吟反说文㯲枉也声类云交领者。","level":0},{"t":"怳忽","level":0},{"t":"虚徃反汉书音义曰怳忽眼乱也似有无也虚妄见也。","level":0},{"t":"第三十七卷","level":0},{"t":"耶舍","level":0},{"t":"此云誉谓名誉也。","level":0},{"t":"苏陁夷","level":0},{"t":"旧言湏陁耶此云共起。","level":0},{"t":"大生主","level":0},{"t":"旧言摩诃波阇翻为大爱道者是也。","level":0},{"t":"迄今","level":0},{"t":"虚讫反尓疋迄至也。","level":0},{"t":"无乏","level":0},{"t":"扶法反暂无名乏乏阙少也反可为叵反正为乏字意也。","level":0},{"t":"第三十八卷","level":0},{"t":"婆雌子部","level":0},{"t":"婆音蒲贺反此云犊子部旧名跋私弗多罗上古仙人名跋私其母是此仙人种故姓跋私有罗汉是此女人之子从母作名说切有部中出也。","level":0},{"t":"矩摩逻多","level":0},{"t":"俱禹反亦作鸠摩此云童首谓诸童子中为上首也。","level":0},{"t":"嗢多罗僧","level":0},{"t":"乌没反旧言欝多罗亦云郁多罗此云上首衣此谓常著衣中<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08764.gif\" alt=\"㝡\" title=\"㝡\" />在上也。","level":0},{"t":"𠳮荅[弓*(乞-乙+小)]","level":0},{"t":"旧言𱞽昙[弓*(乞-乙+小)]或作瞿夷讹也此云女十二游经云明女。","level":0},{"t":"愽戯","level":0},{"t":"古文𱸪同补莫反方言愽或谓之棋说文𱸪<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04645.gif\" alt=\"𡱈\" title=\"𡱈\" />戯也六著十二棋古者焉曹作𱸪𱸪亦著名也。","level":0},{"t":"曲[卄/(阿-可+辛)/木]","level":0},{"t":"鱼列反说文牙米也谓渍谷等生牙者也。","level":0},{"t":"酝酿","level":0},{"t":"於问反下女亮反说文酝作酒曰酿酒母也酿投也。","level":0},{"t":"第三十九卷","level":0},{"t":"谤讟","level":0},{"t":"徒木反左传民无谤讟杜预曰讟诽也广雅讟<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />也方言讟痛也。","level":0},{"t":"深<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07703.gif\" alt=\"𠍴\" title=\"𠍴\" />","level":0},{"t":"古文作㥶[這-言+保]二形籀文作<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04727.gif\" alt=\"𮘧\" title=\"𮘧\" />今作愆同去连反说文<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07703.gif\" alt=\"𠍴\" title=\"𠍴\" />过也失也。","level":0},{"t":"第四十卷","level":0},{"t":"山泽","level":0},{"t":"直格反水聚曰泽<img class=\"gaiji\" src=\"asset://gaiji-CB/18/CB18232.gif\" alt=\"𥼶\" title=\"𥼶\" />名云兖州人谓泽为掌言水亭<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />如掌中也。","level":0},{"t":"第四十一卷","level":0},{"t":"媒媾","level":0},{"t":"孤<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07419.gif\" alt=\"𠋫\" title=\"𠋫\" />反白虎通曰媾厚也重婚曰媾。","level":0},{"t":"无[右/羊]","level":0},{"t":"古胡反尓疋[右/羊]罪也。","level":0},{"t":"扼捥","level":0},{"t":"又作槅同於责反说文扼杷也盈手扼广雅扼持也史记扼[捥-(夗-夕)+匕]以言是。","level":0},{"t":"用畅","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30072.gif\" alt=\"𠡠\" title=\"𠡠\" />亮反广雅畅达也明也。","level":0},{"t":"挥刀","level":0},{"t":"许归反说文挥奋也振讯也。","level":0},{"t":"吸水","level":0},{"t":"古文噏歙二形同<img class=\"gaiji\" src=\"asset://gaiji-CB/05/CB05430.gif\" alt=\"𦏁\" title=\"𦏁\" />及反广雅吸饮也气息引入也。","level":0},{"t":"第四十二卷","level":0},{"t":"呪诅","level":0},{"t":"又作祝说文作詶同之授反詶诅也下古文樝同侧据反<img class=\"gaiji\" src=\"asset://gaiji-CB/18/CB18232.gif\" alt=\"𥼶\" title=\"𥼶\" />名云祝属也以善<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />之辝相属著也诅阻也谓使人行事阻隈於言也。","level":0},{"t":"第四十三卷","level":0},{"t":"迦栗沙钵拏","level":0},{"t":"又作迦理沙般拏拏音女家反钵拏此云铜钱十六钵拏为一迦利沙钵拏。","level":0},{"t":"陋讷","level":0},{"t":"古文呐同奴骨反陋丑猥也亦小也讷遅䤜也说文讷难也。","level":0},{"t":"室利毱多","level":0},{"t":"此云吉祥护旧言尸利毱多讹。","level":0},{"t":"第四十四卷","level":0},{"t":"梅怛丽药","level":0},{"t":"都达反此云慈即旧云慈氏者也慈有二因缘一值慈佛发心二初得慈心三昧因以名焉言[弓*(乞-乙+小)]勒或云梅任梨并讹也。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/05/CB05195.gif\" alt=\"𥤱\" title=\"𥤱\" />闻","level":0},{"t":"呼旱反卑希也尓疋希[宋-木+(烈-列+(百-日+目))]尠<img class=\"gaiji\" src=\"asset://gaiji-CB/05/CB05195.gif\" alt=\"𥤱\" title=\"𥤱\" />也字从干从<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02508.gif\" alt=\"𠕀\" title=\"𠕀\" />。","level":0},{"t":"第四十五卷","level":0},{"t":"拘枳罗鸟","level":0},{"t":"居尓反或作拘耆罗此云好声鸟也。","level":0},{"t":"第四十六卷","level":0},{"t":"客馆","level":0},{"t":"又作馆同古玩反客舍也周礼五十里有馆馆有委积以待朝𮜷之客。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01057.gif\" alt=\"𨚗\" title=\"𨚗\" />地迦城","level":0},{"t":"此云鸣或云河主城名也。","level":0},{"t":"郡市迦林","level":0},{"t":"此云[夕/鹿]布袋林名也。","level":0},{"t":"蓝愽迦经","level":0},{"t":"此言作动经。","level":0},{"t":"第四十八卷","level":0},{"t":"珊若娑病","level":0},{"t":"乘干反此云废风病一不发不起者也。","level":0},{"t":"宝玩","level":0},{"t":"古文既同五唤反字林玩弄也广雅玩好也。","level":0},{"t":"第五十一卷","level":0},{"t":"愚戆","level":0},{"t":"都绛反说文愚痴也戆愚䤜也。","level":0},{"t":"於块","level":0},{"t":"古文由同苦对反由结土也土块也。","level":0},{"t":"愚蒙","level":0},{"t":"又作𥉕同莫公反蒙谓蒙覆不明也暗昧无知也。","level":0},{"t":"第五十二卷","level":0},{"t":"名鉴","level":0},{"t":"又作鉴同古镵反广雅鉴炤燿也鉴所以察形也。","level":0},{"t":"诡设","level":0},{"t":"居毁反诈不实也亦相欺也。","level":0},{"t":"夸诞","level":0},{"t":"苦华反下徒<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04132.gif\" alt=\"𮧊\" title=\"𮧊\" />反通俗文自矜曰夸谥法曰华而无实曰夸诞谩也欺也不实大也。","level":0},{"t":"第五十三卷","level":0},{"t":"憩无","level":0},{"t":"又作愒苍颉篇作憩同祛例反尓疋憩息也。","level":0},{"t":"钻燧","level":0},{"t":"又作鐆同辝醉反火母也论语钻燧改火是也世本造火者燧人因以名也。","level":0},{"t":"波涛","level":0},{"t":"徒劳反三苍大波为涛也。","level":0},{"t":"伺求","level":0},{"t":"涓慈先吏二反字林伺<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07419.gif\" alt=\"𠋫\" title=\"𠋫\" />也伺察也。","level":0},{"t":"第五十四卷","level":0},{"t":"凞怡","level":0},{"t":"虚之反下与之反说文凞怡和恱也方言怡喜也湘潭之闲曰纷凞或云凞怡。","level":0},{"t":"躭话","level":0},{"t":"籀文作譮古文作𦧵䛋二形同胡快声类云话讹言也广雅话调也谓调戯也。","level":0},{"t":"很戾","level":0},{"t":"胡垦反下力计反很违也戾曲也字从艮声。","level":0},{"t":"狻猊","level":0},{"t":"先桓反下五奚反即师子也出西域尓疋狻猊如虥猫食虎豹穆天子传狻猊走五百里是也虥音仕板反。","level":0},{"t":"眵垢","level":0},{"t":"充尸反说文蕺兜眵蕺音莫结反。","level":0},{"t":"𬹼齿","level":0},{"t":"下界反说文齿相切也三苍呜齿也。","level":0},{"t":"身矬","level":0},{"t":"才戈反广雅矬短也通俗文侏<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11174.gif\" alt=\"𪝥\" title=\"𪝥\" />曰矬也。","level":0},{"t":"夸衒","level":0},{"t":"古文眩𧗳二形同胡面公县二反说文行且卖也。","level":0},{"t":"殉名","level":0},{"t":"辝俊反苍颉篇殉求也广疋玽营也。","level":0},{"t":"抆拭","level":0},{"t":"武粉反下舒翼反广雅抆拭也振也尓足拭清也言抆拭所以为清絜也。","level":0},{"t":"第五十五卷","level":0},{"t":"侮蔑","level":0},{"t":"古文㑄同亡府反广雅侮轻也说文侮<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00129.gif\" alt=\"㑥\" title=\"㑥\" />也谓轻<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00129.gif\" alt=\"㑥\" title=\"㑥\" />也。","level":0},{"t":"第五十七卷","level":0},{"t":"俱祉罗","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30072.gif\" alt=\"𠡠\" title=\"𠡠\" />里反旧言摩诃俱𫄨罗此云大膝膝骨大故也即舍利子舅长爪梵志也。","level":0},{"t":"第五十八卷","level":0},{"t":"屏气","level":0},{"t":"俾领反屏蔽也隐也藏也蔽也。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07732.gif\" alt=\"𦚰\" title=\"𦚰\" />尊者","level":0},{"t":"虚业反即付法藏中波奢比丘常坐者也此人曾生<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07732.gif\" alt=\"𦚰\" title=\"𦚰\" />不著地因以名焉。","level":0},{"t":"第五十九卷","level":0},{"t":"𰴐度","level":0},{"t":"又作𫠆同九吹反下徒各反𰴐求也计也𰴐摸也世本倕作𰴐矩𰴐圆也矩方也字从夫从见言丈夫之见必合<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02420.gif\" alt=\"䂓\" title=\"䂓\" />矩。","level":0},{"t":"洄澓","level":0},{"t":"胡瓌反下扶福反三苍洄水转也澓亦回水深也。","level":0},{"t":"狎<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />","level":0},{"t":"古文𧆥同胡甲反狎近也广雅狎习也谓近而狎之习而行之也。","level":0},{"t":"薄矩罗","level":0},{"t":"俱禹反旧言薄俱罗此云善容持一不煞戒得五不死者也。","level":0},{"t":"涎洟","level":0},{"t":"诸书作㳄<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01698.gif\" alt=\"㵪\" title=\"㵪\" />唌𣼞四形同详延反字林慕欲口液也亦小儿唾也。","level":0},{"t":"班駮","level":0},{"t":"又作办同㭪蛮反苍颉篇班文云也杂色班也。","level":0},{"t":"黧黯","level":0},{"t":"力奚反下於斩反通俗文班黑谓之䵩黯。","level":0},{"t":"笑睇","level":0},{"t":"徒计反纂文顾视曰睇睇亦倾视也礼记不能睇视是也。","level":0},{"t":"憺怕","level":0},{"t":"徒滥反下疋白反说文憺安也怕静也又亦无为自得也。","level":0},{"t":"第六十卷","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02240.gif\" alt=\"㰆\" title=\"㰆\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02240.gif\" alt=\"㰆\" title=\"㰆\" />","level":0},{"t":"埤苍作[韋*(ㄆ/用)]东观汉记作排同皮拜反冶家用吹火令炽者也。","level":0}],[{"t":"剩辩","level":0},{"t":"食证反剩犹因也。","level":0},{"t":"胫踝","level":0},{"t":"古文踁同胡定反字林脚胻也<img class=\"gaiji\" src=\"asset://gaiji-CB/18/CB18232.gif\" alt=\"𥼶\" title=\"𥼶\" />名胫茎也直而长如物茎也。","level":0},{"t":"一寻","level":0},{"t":"似林反小尓疋云四尺为仞倍仞曰寻倍寻曰常方言寻长也。","level":0},{"t":"唯<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04645.gif\" alt=\"𡱈\" title=\"𡱈\" />","level":0},{"t":"衢玉反促也小尓疋<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04645.gif\" alt=\"𡱈\" title=\"𡱈\" />近也尓疋<img class=\"gaiji\" src=\"asset://gaiji-CB/04/CB04645.gif\" alt=\"𡱈\" title=\"𡱈\" />分也部分也字从口在尸下。","level":0},{"t":"第六十二卷","level":0},{"t":"嗢达洛迦曷逻","level":0},{"t":"此云极喜。","level":0},{"t":"考量","level":0},{"t":"枯老反考谓质核之也考挍也。","level":0},{"t":"第六十七卷","level":0},{"t":"魑魅","level":0},{"t":"又作离螭二形同<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30072.gif\" alt=\"𠡠\" title=\"𠡠\" />知反下又作𩲐<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17020.gif\" alt=\"𩲝\" title=\"𩲝\" />二形同莫兾反说文老物精也通俗文泽恠谓之魑[魅-未+弓]。","level":0},{"t":"冲虚","level":0},{"t":"说文作蛊同除隆反字书冲虚也中。","level":0},{"t":"第六十八卷","level":0},{"t":"自刎","level":0},{"t":"古文歾同亡粉反字略云断首曰刎割通俗文自刻曰刎也。","level":0},{"t":"庸愚","level":0},{"t":"[更-一]鍾反庸谓常愚常矩者也。","level":0},{"t":"第六十九卷","level":0},{"t":"巨富","level":0},{"t":"其吕反小尓疋巨大也方言齐鲁之闲谓大为巨。","level":0},{"t":"匪冝","level":0},{"t":"趺斐反诗云匪来[仞/貝]<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09212.gif\" alt=\"𢇁\" title=\"𢇁\" />传曰匪非也。","level":0},{"t":"傅药","level":0},{"t":"方务反附也谓涂附也方言凢欲药傅药而毒刺是也。","level":0},{"t":"萌牙","level":0},{"t":"古文氓同麦<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07211.gif\" alt=\"𥝷\" title=\"𥝷\" />反广雅萌始也萌亦<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07448.gif\" alt=\"𡨋\" title=\"𡨋\" />昧<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15032.gif\" alt=\"㒵\" title=\"㒵\" />也。","level":0},{"t":"第七十卷","level":0},{"t":"眇然","level":0},{"t":"亡绍反眇眇远也亦深大也。","level":0},{"t":"稽遅","level":0},{"t":"古奚反说文留止曰稽。","level":0},{"t":"第七十三卷","level":0},{"t":"朅地罗","level":0},{"t":"去谒反旧言佉陁罗木名也。","level":0},{"t":"第七十四卷","level":0},{"t":"孳产","level":0},{"t":"子思反方言东楚之闲凢人畜乳而双产谓之[(牙*力)/厘]孳下所限反生其种曰产说文产生也。","level":0},{"t":"朝贡","level":0},{"t":"古弄反贡廌也广雅贡上也。","level":0},{"t":"第七十五卷","level":0},{"t":"贸易","level":0},{"t":"莫<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07419.gif\" alt=\"𠋫\" title=\"𠋫\" />反小尓疋云贸交易也三苍贸换易也。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11462.gif\" alt=\"𢷤\" title=\"𢷤\" />黜","level":0},{"t":"又作绌同耻律反广疋黜去也亦放也退也。","level":0},{"t":"骁健","level":0},{"t":"古尧反广雅骁亦健也勇<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03871.gif\" alt=\"㥯\" title=\"㥯\" />也说文良马骏名也。","level":0},{"t":"怀孕","level":0},{"t":"古文𣎜同移证反含实曰孕三苍孕怀子也广雅孕㑗也字从子从乃。","level":0},{"t":"第七十六卷","level":0},{"t":"火[(乏-之+虫)*重]","level":0},{"t":"之容反今江北通谓螽蝗之类曰蝩亦曰簸蝩一名螽蟴一名蚣蜎俗名舂黍蚣音思容螖音思与反。","level":0},{"t":"逝多","level":0},{"t":"时制反此云战胜是俱[薩-產+(辛/工)]罗国波斯匿王之子也大子诞生之日王破贼军内宫闻奏因以名也旧云祇陁或云栘多亦言祇洹皆讹也栘音是奚反。","level":0},{"t":"第七十八卷","level":0},{"t":"娆乱","level":0},{"t":"三苍乃了反娆扰也弄也谓娆乱戯弄也。","level":0},{"t":"第七十九卷","level":0},{"t":"砂碛","level":0},{"t":"七亦反水中沙滩也说文水渚有石曰碛滩音他丹反。","level":0},{"t":"第八十卷","level":0},{"t":"奢侈","level":0},{"t":"昌是反侈亦奢泰也。","level":0},{"t":"痆斯","level":0},{"t":"女黠反国名也旧言波罗奈国也。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03878.gif\" alt=\"㒒\" title=\"㒒\" />[(上/天)*余]","level":0},{"t":"蒲卜反下力计反广雅僮仆伇使也<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03878.gif\" alt=\"㒒\" title=\"㒒\" />附也附从於人也周礼男子入于罪[(上/天)<em>余]郑众曰[(上/天)</em>余]奴也贱也伇也。","level":0},{"t":"求晴","level":0},{"t":"又作腥殅二形同自盈反声类云雨止曰晴晴亦精明也。","level":0}]]