{"id":"t2025","title":"勅修百丈清規","titleTrad":"勅修百丈清規","byline":"大智壽聖禪寺住持臣僧 德煇奉 勅重編","bylineLabel":"著者·译者","dynasty":"","division":"诸宗部","canon":"T2025","canonName":"大正藏","volume":"T2025","juanCount":8,"textLength":74395,"imageCount":0,"summary":"","tags":["诸宗部","大正藏"],"order":2426,"guide":"","chunks":28,"toc":[{"level":3,"text":"古清規序崇寧清規序"},{"level":3,"text":"咸淳清規序至大清規序"},{"level":2,"text":"勅修百丈清規卷第一"},{"level":3,"text":"訊領眾出堂。至法座前。列一行問訊歸西序"},{"level":2,"text":"勅修百丈清規卷第二"},{"level":3,"text":"昏鐘鳴時行者覆住持。鳴鼓一通。眾集兩序"},{"level":3,"text":"觸禮請云令客頭請兩序"},{"level":2,"text":"勅修百丈清規卷第三"},{"level":3,"text":"那當面問訊引。巡堂一匝。參隨人先出。兩序"},{"level":2,"text":"勅修百丈清規卷第四"},{"level":3,"text":"住持須預稟露。如有允意。方丈先請茶。兩序"},{"level":3,"text":"方丈管待新舊兩序"},{"level":3,"text":"分手。同序隨班位。次日點心坐位同前。西序"},{"level":2,"text":"勅修百丈清規卷第五"},{"level":2,"text":"勅修百丈清規卷第六"},{"level":3,"text":"領眾隨至法堂。或寢堂住持據座。侍者兩序"},{"level":3,"text":"方名德。西堂單寮勤舊。有功山門。住持兩序"},{"level":2,"text":"勅修百丈清規卷第七"},{"level":2,"text":"勅修百丈清規卷第八"},{"level":3,"text":"古清規序"},{"level":3,"text":"崇寧清規序"},{"level":3,"text":"咸淳清規序"},{"level":3,"text":"至大清規序"}],"chunksPerFile":20}