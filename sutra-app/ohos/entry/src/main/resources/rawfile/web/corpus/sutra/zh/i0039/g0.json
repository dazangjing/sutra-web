[[{"t":"合邑四十人造像记","level":0},{"t":"碑阴","level":0},{"t":"邑师法仙","level":0},{"t":"门师僧钦门师静□","level":0},{"t":"大魏大统四年岁在戊午十二月丙戊朔辛亥日。佛弟子合邑卌人等。生阎浮。运遭末劫。自飞高因妙业。无以同生彼岸。遂尒谪相率化。顷竭己资。仰为皇帝国主。建崇四面天宫石像一区。逮及师僧父母。七世所生。因缘眷属。香火邑义。生〃世〃。值佛闻法。弥勒现世。愿登先首。边地众生。普同正觉。咸登正果。","level":0},{"t":"□那侯桃枝","level":0,"quote":true},{"t":"□那鲁法容　蔡","level":0,"quote":true},{"t":"典录鲁阿回　王晏","level":0,"quote":true},{"t":"□主侯真姜　郭阿□","level":0,"quote":true},{"t":"□主董双台　鲁神妃","level":0,"quote":true},{"t":"像主蔡阿早　鲁阿妃","level":0,"quote":true},{"t":"像主李思好　鲁早妃　王□□","level":0,"quote":true},{"t":"□□敬容□买姜　袁次男","level":0,"quote":true},{"t":"□□□贵侯乐善　王定贵","level":0,"quote":true},{"t":"□女□□张敬姜　敬女晹","level":0,"quote":true},{"t":"□赐王鲁要容　张僧卖","level":0,"quote":true},{"t":"鲁洛姿董洛媚　侯憎迺","level":0,"quote":true},{"t":"鲁舍贵陈贱贵　董先敬","level":0,"quote":true},{"t":"鲁义胜杨令姿　张定姜","level":0,"quote":true},{"t":"任始贵鲁阿令","level":0,"quote":true},{"t":"鲁妙姿","level":0,"quote":true},{"t":"□小姿","level":0,"quote":true}]]