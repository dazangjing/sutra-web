{"id":"t1484","title":"梵網經","titleTrad":"梵網經","byline":"","bylineLabel":"著者·译者","dynasty":"","division":"经集部","canon":"T1484","canonName":"大正藏","volume":"T1484","juanCount":2,"textLength":21595,"imageCount":0,"summary":"","tags":["经集部","大正藏"],"order":4706,"guide":"","chunks":10,"toc":[{"level":3,"text":"序梵網經序"},{"level":2,"text":"百十二卷六十一"},{"level":3,"text":"序梵網經序"},{"level":2,"text":"解釋五十餘部。唯梵網經一百二十卷六十"},{"level":3,"text":"戒品第十卷上"},{"level":3,"text":"菩薩戒序梵網經菩薩戒序"},{"level":3,"text":"戒品第十卷下"},{"level":3,"text":"梵網經盧舍那佛說菩薩心地戒品第十之"},{"level":3,"text":"如王諸佛行處計信盡亦處由以梵網經盧舍那佛說菩薩心地戒品第十之"}],"chunksPerFile":20}