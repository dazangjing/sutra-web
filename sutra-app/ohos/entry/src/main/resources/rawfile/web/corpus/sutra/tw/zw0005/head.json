{"id":"zw0005","title":"天請問經疏","titleTrad":"天請問經疏","byline":"沙門文軌撰 李際寧整理","bylineLabel":"著者·译者","dynasty":"","division":"经疏部","canon":"ZW0005","canonName":"藏外佛教文獻","volume":"ZW0005","juanCount":1,"textLength":18071,"imageCount":0,"summary":"","tags":["经疏部","藏外佛教文獻"],"order":1911,"guide":"","chunks":3,"toc":[{"level":3,"text":"述曰：此下別序。以天來下，發請如來，方始起說，故是發起序"},{"level":3,"text":"一請答中，皆先請後答。一一請中，皆先序請，後正請。答亦先序"}],"chunksPerFile":20}