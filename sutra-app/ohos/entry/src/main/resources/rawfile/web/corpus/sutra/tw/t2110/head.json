{"id":"t2110","title":"辯正論","titleTrad":"辯正論","byline":"唐沙門釋法琳撰","bylineLabel":"著者·译者","dynasty":"","division":"论集部","canon":"T2110","canonName":"大正藏","volume":"T2110","juanCount":8,"textLength":93182,"imageCount":0,"summary":"","tags":["论集部","大正藏"],"order":888,"guide":"","chunks":14,"toc":[{"level":3,"text":"辯正論序"},{"level":2,"text":"辯正論卷第一"},{"level":2,"text":"辯正論卷第二"},{"level":2,"text":"辯正論卷第三"},{"level":2,"text":"辯正論卷第四"},{"level":3,"text":"百司供給四事豐厚。琳又預充執筆。迺為序"},{"level":2,"text":"辯正論卷第五"},{"level":2,"text":"辯正論卷第六"},{"level":3,"text":"答十異序"},{"level":2,"text":"辯正論卷第七"},{"level":2,"text":"力已倦。九流七略難甚攀天。萬卷百"},{"level":2,"text":"辯正論卷第八"},{"level":3,"text":"案道家四見論。凡有二十一條大義。一曰序"}],"chunksPerFile":20}