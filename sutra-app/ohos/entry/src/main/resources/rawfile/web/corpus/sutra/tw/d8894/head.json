{"id":"d8894","title":"頌義八拔萃","titleTrad":"頌義八拔萃","byline":"","bylineLabel":"著者·译者","dynasty":"","division":"诸宗部","canon":"D8894","canonName":"國圖善本佛典","volume":"D8894","juanCount":5,"textLength":119919,"imageCount":0,"summary":"","tags":["诸宗部","國圖善本佛典"],"order":2053,"guide":"","chunks":10,"toc":[{"level":2,"text":"同卷二"},{"level":2,"text":"心地觀經二卷一"},{"level":3,"text":"法無間道生空見分第二心法無間道法空見分第"},{"level":2,"text":"頌義八󳫠萃四卷第三"},{"level":3,"text":"分第六識俱身見等攝下品故不作意緣故遠隨"},{"level":3,"text":"分別身見等法彼為󵖔重名上品第六識中獨頭貪"},{"level":2,"text":"樣ナラハ隣次前道伏之歟至第十卷二"}],"chunksPerFile":20}