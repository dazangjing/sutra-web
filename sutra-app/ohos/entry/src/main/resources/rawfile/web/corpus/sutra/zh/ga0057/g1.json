[[{"t":"县南散兵，镇宋淳熙间建，有泉清冽出百洞。","level":0},{"t":"观心寺","level":0},{"t":"在县镇南桥，宋淳熙间建，俗呼铜肠寺。","level":0},{"t":"法轮寺","level":0},{"t":"在县白露河，宋绍熙间，建有石柱轮藏古塔。","level":0},{"t":"竹城寺","level":0},{"t":"县西七十里，即宝林院，宋宝祐元年建。","level":0},{"t":"大力寺","level":0},{"t":"在县王乔洞东北，宋景定间建，傍有大力泉，深不可测，味极佳，为合境第一。","level":0},{"t":"以上巢县。","level":0},{"t":"玉虚观","level":0},{"t":"在府城内即子胥台，一名中圣宫。","level":0},{"t":"梓潼观","level":0},{"t":"在府玉虚观东。","level":0},{"t":"白鹤观","level":0},{"t":"在府东门，唐建。","level":0},{"t":"冲元观","level":0},{"t":"府城南三河镇，元建。","level":0},{"t":"玉虚观","level":0},{"t":"在庐江县南关，一名南台，相传左慈所居，内有丹井遗址。","level":0},{"t":"真武观","level":0},{"t":"庐江县西门外。","level":0},{"t":"洞元观","level":0},{"t":"在舒城县北门外，宋元祐中建。","level":0},{"t":"崇德观","level":0},{"t":"在无为州治东隅，旧名群仙观，宋建。国朝顺治十五年重修。","level":0},{"t":"白鹤观","level":0},{"t":"在州襄安镇墩上，唐建，墩形如印，高十餘丈，中有墨泉。","level":0},{"t":"紫薇观","level":0},{"t":"旧在巢县北十里金庭山下，世所称第十八金庭洞天也，晋咸康四年创。宋宝祐二年勅建，有碑。湖山重复，岩谷幽閟，三峰峙於前，两洞拥於后，今遗址犹存。宋末迁入於城，洪武二年再迁於县治西北卧牛山。","level":0},{"t":"圣妃神宫","level":0},{"t":"在府东湖内姥山上，晋时勅建。","level":0},{"t":"凤阳府","level":0},{"t":"龙兴寺","level":0},{"t":"在府东三里盛家，山南初名皇觉寺，明太祖▆时潜踪之地。洪武初改今名，有太祖御书第一山三字碑阴，有御制文，又有神宗，勅赐藏经。康熙十二年，重修洪戒寺在府治东。","level":0},{"t":"栖岩寺","level":0},{"t":"府西白石山有石室宋高宗赐御书於此。","level":0},{"t":"灵泉寺","level":0},{"t":"府东南武，店中有银杏，根盘数丈，元建。","level":0},{"t":"大圣寺","level":0},{"t":"府西南，一名白塔寺，元建。","level":0},{"t":"法华寺","level":0},{"t":"在府西内有七级浮图。","level":0},{"t":"竹林寺","level":0},{"t":"府南门外，明建。","level":0},{"t":"开元寺","level":0},{"t":"在临淮县闻贤门内，一名庄台寺，唐开元二十六年，诏天下州郡各建一大寺，以纪年为额。南唐主李升微时尝寓此。","level":0},{"t":"鍾离寺","level":0},{"t":"在县东。","level":0},{"t":"竹林寺","level":0},{"t":"在县曲阳门外，创自唐时，明洪武初复建。","level":0},{"t":"净众寺","level":0},{"t":"县东北六十里，宋咸淳间创，弘治元年复建。","level":0},{"t":"大圣寺","level":0},{"t":"县东北七十里，宋咸淳间建。","level":0},{"t":"真如寺","level":0},{"t":"县东二十五里，元大德间建，明洪武间复建。","level":0},{"t":"戒香寺","level":0},{"t":"在县南明正统间重建，赐旧额。","level":0},{"t":"以上临淮县。","level":0},{"t":"大圣寺","level":0},{"t":"在怀远县南一里，宋雍熙元年建，明洪武重建。","level":0},{"t":"水月寺","level":0},{"t":"在县北一里。","level":0},{"t":"华严寺","level":0},{"t":"在县西，元建。","level":0},{"t":"崇宁寺","level":0},{"t":"在县龙亢集。","level":0},{"t":"灵岩寺","level":0},{"t":"在县涂山东顶","level":0},{"t":"山香寺","level":0},{"t":"县东北二十五里。","level":0},{"t":"罗汉寺","level":0},{"t":"在县东二里。","level":0},{"t":"以上怀远县。","level":0},{"t":"禅窟寺","level":0},{"t":"在定远县西北三十里，唐元和间建，明洪武八年重建。寺当山腰，有泉穿屋壁而出，声泠然若弦。奏前有系虎石，旁有茂林修竹，森映寺宇。国朝康熙十九年重修。","level":0},{"t":"西禅寺","level":0},{"t":"在县治西，旧为学宫，宋咸淳间建，明洪武间修。","level":0},{"t":"能仁寺","level":0},{"t":"在县东北，宋建。","level":0},{"t":"元封寺","level":0},{"t":"在县东六十里。","level":0},{"t":"大圣寺","level":0},{"t":"有三：一在县东十五里，一在县西三十五里，一在县西南三十里。","level":0},{"t":"大山顶寺","level":0},{"t":"在县东八十里。","level":0},{"t":"包公寺","level":0},{"t":"县南二十里。","level":0},{"t":"南万善寺","level":0},{"t":"县南四十里。","level":0},{"t":"永兴寺","level":0},{"t":"县南一名九子寺。","level":0},{"t":"南观音寺","level":0},{"t":"县西南四十里。","level":0},{"t":"慈氏寺","level":0},{"t":"在县西九十里，宋绍兴间建，明洪武间修。","level":0},{"t":"槎枒寺","level":0},{"t":"在县西北七十里，明洪武十六年建，勅赐圆通禅寺。前有石塔二，石碁枰一。","level":0},{"t":"以上定远县。","level":0},{"t":"释迦寺","level":0},{"t":"在虹县城东南隅，明洪武初建。","level":0},{"t":"清凉寺","level":0},{"t":"在县东北朱山下。","level":0},{"t":"潼城寺","level":0},{"t":"县东北潼城河。","level":0},{"t":"定林寺","level":0},{"t":"今为虹县城隍庙，止存碑记。","level":0},{"t":"祥兰寺","level":0},{"t":"在县赤山。","level":0},{"t":"以上虹县。","level":0},{"t":"栖贤寺","level":0},{"t":"在寿州六朝时古刹。","level":0},{"t":"兴福寺","level":0},{"t":"在州西北茅仙洞","level":0},{"t":"驻驾寺","level":0},{"t":"在州南，明成祖曾驻驾於此。","level":0},{"t":"黄溪塔寺","level":0},{"t":"在州南一百三十里。","level":0},{"t":"以上寿州。","level":0},{"t":"报恩寺","level":0},{"t":"旧名东禅寺，在凤台县治东北隅，有塔，宋天圣间建，明洪武中修，改今名。","level":0},{"t":"以上凤台县。","level":0},{"t":"圣果寺","level":0},{"t":"在宿州东北，宋治平丁未建，明洪武二年重建。","level":0},{"t":"上元寺","level":0},{"t":"州故相城内，汉御史薛广德授二龚鲁诗处。","level":0},{"t":"中元寺","level":0},{"t":"在州泉山阳方汀，即元之福胜院，有碑。","level":0},{"t":"大觉寺","level":0},{"t":"在州西关。","level":0},{"t":"以上宿州。","level":0},{"t":"圣寿寺","level":0},{"t":"在灵璧县东二里，创於元时，明洪武间重修。","level":0},{"t":"阳城寺","level":0},{"t":"在县齐眉山之东，明永乐初车驾驻跸於此。","level":0},{"t":"兴龙寺","level":0},{"t":"在县双沟渠。","level":0},{"t":"九湾寺","level":0},{"t":"县南九十里。","level":0},{"t":"巍桥寺","level":0},{"t":"在县治，一名普济寺，有碑文。","level":0},{"t":"以上灵璧县。","level":0},{"t":"会仙观","level":0},{"t":"在府东十五里临濠水面奕坛，世传有仙人会奕於此，故名。","level":0},{"t":"翊真观","level":0},{"t":"俗称前宫。","level":0},{"t":"元妙宫","level":0},{"t":"俗称后宫，并在府东南。","level":0},{"t":"通真观","level":0},{"t":"在临淮县升仙坊，元至治间道士王永模创，明洪武中复建，内有石碑，刻蓝采和像，濠梁志：采和一日即市楼饮酒，有五色云覆楼上，饮毕乘云而去。今观即其地也。","level":0},{"t":"元妙观","level":0},{"t":"在怀远县涂山，旧名天庆观，元大德间改今名。","level":0},{"t":"漆园观","level":0},{"t":"在定远县治东，濠梁志云：唐弘道三载勅建。","level":0},{"t":"隐僊观","level":0},{"t":"在定远县东南六十里，宋宣和中建。","level":0},{"t":"真武观","level":0},{"t":"在定远县东后街。","level":0},{"t":"隐真观","level":0},{"t":"在虹县东南隅，元泰定间建。","level":0},{"t":"梓橦观","level":0},{"t":"在寿州北，学正黄奇士讲学处。","level":0},{"t":"元妙观","level":0},{"t":"在凤台县西北，明正统间建。","level":0},{"t":"天庆观","level":0},{"t":"即上真观在宿州北关。雍熙中，回道人访观主，不遇题诗於壁，以玉筯篆其字，往往为人刮去煎汤，疗病字迹，旋刮旋生。","level":0},{"t":"南华观","level":0},{"t":"在灵璧县治北潼山，旧传庄子尝居此，元至元间建。","level":0},{"t":"插花塔","level":0},{"t":"在宿州西南，宋至正间建，常灿五色毫光，乡人异之。明永乐七年，坍塌得舍利子十一颗，佛牙一枝献上。上令火之，金光灿烂，乃命收舍利，以佛牙给还佛会镇塔。","level":0},{"t":"颍州府","level":0},{"t":"资福寺","level":0},{"t":"在府治西南，宋建，明洪武十六年重修贮藏经。","level":0},{"t":"新渡寺","level":0},{"t":"在府治，宋苏轼於此饯欧阳叔弼，有诗。","level":0},{"t":"善现寺","level":0},{"t":"在府东明，太祖曾驻跸於此，奉勅建，亦名北照寺。","level":0},{"t":"香台寺","level":0},{"t":"在府沈邱浮香台上，四面皆颍水绕之。","level":0},{"t":"艾亭寺","level":0},{"t":"在府南乡古艾亭","level":0},{"t":"龙兴寺","level":0},{"t":"旧在颍上县通津门内，元末改为仓，明洪武六年重建於城外北关。","level":0},{"t":"永宁寺","level":0},{"t":"在县东门外。","level":0},{"t":"宿缘寺","level":0},{"t":"县西南五十里古南赵寺，明洪武中建。","level":0},{"t":"新兴寺","level":0},{"t":"县西南四十里。","level":0},{"t":"灵台寺","level":0},{"t":"县西南五十里。","level":0},{"t":"水月寺","level":0},{"t":"县西正阳镇。","level":0},{"t":"以上颍上县。","level":0},{"t":"福昌寺","level":0},{"t":"在霍邱县治西，宋治平间建。","level":0},{"t":"圣寿寺","level":0},{"t":"县南开顺镇，宋建。","level":0},{"t":"圆觉寺","level":0}],[{"t":"在县西北，明洪武二十五年勅建赐额。","level":0},{"t":"华严寺","level":0},{"t":"县北十里。","level":0},{"t":"普济寺","level":0},{"t":"在县大别山。","level":0},{"t":"金华寺","level":0},{"t":"县芙蓉山隈","level":0},{"t":"朱砂寺","level":0},{"t":"县南有浮屠。","level":0},{"t":"莲花寺","level":0},{"t":"县南六十里。","level":0},{"t":"走马嵓寺","level":0},{"t":"在县开顺镇。","level":0},{"t":"七井寺","level":0},{"t":"县长山中。","level":0},{"t":"香山寺","level":0},{"t":"县南百里。","level":0},{"t":"龙泉寺","level":0},{"t":"县东十五里。","level":0},{"t":"以上霍邱县。","level":0},{"t":"咸平寺","level":0},{"t":"在毫州城北门内，明洪武二十八年建。","level":0},{"t":"铁佛寺","level":0},{"t":"有三：一在州南三十里，一在州南七十五里，一在州西北四十里。","level":0},{"t":"北李村寺","level":0},{"t":"在州东南。","level":0},{"t":"大云寺","level":0},{"t":"在州东南，有石塔，又一在州东南一百六十里。","level":0},{"t":"石佛寺","level":0},{"t":"有二：一在州东南六十里，一在东北二十五里。","level":0},{"t":"留鹿寺","level":0},{"t":"在州东南，元时建。","level":0},{"t":"杨村寺","level":0},{"t":"在州东南，明弘治三年建。","level":0},{"t":"海会寺","level":0},{"t":"州东南百二十五里。","level":0},{"t":"华严寺","level":0},{"t":"有二：一在州东南百四十里，一、在州东百里。","level":0},{"t":"晋庵寺","level":0},{"t":"在州西西台上明成化七年建。","level":0},{"t":"以上毫州。","level":0},{"t":"兴国寺","level":0},{"t":"在太和县东门内，明景泰间建，掘地得断碣，有兴国二字，故名。","level":0},{"t":"运邱寺","level":0},{"t":"在县运邱上，有古檀树干，可十围，叶荫二亩。","level":0},{"t":"倪邱寺","level":0},{"t":"在县倪邱东，有古银杏二株，连理大可数围。","level":0},{"t":"天宫寺","level":0},{"t":"县东天保乡。","level":0},{"t":"金佛寺","level":0},{"t":"县北六十里。","level":0},{"t":"海眼寺","level":0},{"t":"县北三十里，原有二塔，其一与寺俱废，其一尚存，今人呼为双浮屠。","level":0},{"t":"朱家浅","level":0},{"t":"寺县西北七十里。","level":0},{"t":"以上太和县。","level":0},{"t":"慈氏寺","level":0},{"t":"在蒙城县东南有古浮图一座，旧名慈氏院，元至正间，因故址修建。明洪武十五年重修改今名。","level":0},{"t":"兴化寺","level":0},{"t":"在县东，宋建。","level":0},{"t":"福圣寺","level":0},{"t":"在县西，元延祐中建。","level":0},{"t":"普照寺","level":0},{"t":"县西铁牛岭。","level":0},{"t":"太平寺","level":0},{"t":"县西西阳集，俱元建。","level":0},{"t":"寿圣寺","level":0},{"t":"县西蒙观镇之后，唐开元初建。","level":0},{"t":"普济寺　福建寺","level":0},{"t":"俱在县北，元泰定五年建。","level":0},{"t":"以上蒙城县。","level":0},{"t":"迎祥观","level":0},{"t":"在府西北隅，元泰定二年建，明洪武中修，相传张三丰修炼於此，遗有混元衣，至今犹存。","level":0},{"t":"灵坛观","level":0},{"t":"府城内有再生桧树。","level":0},{"t":"东华观","level":0},{"t":"颍上县城内，元建，明洪武十年重建。","level":0},{"t":"九仙观","level":0},{"t":"在霍邱县开顺镇。","level":0},{"t":"三清观","level":0},{"t":"在霍邱县西门外。","level":0},{"t":"东来第一宫","level":0},{"t":"在府西关，国朝康熙初建。","level":0},{"t":"清华观","level":0},{"t":"在太和县东三十里。","level":0},{"t":"丹阳观","level":0},{"t":"在蒙城县西南，金兴定二年建，后废为预备仓，明改建於崇元观侧。","level":0},{"t":"庆真观","level":0},{"t":"蒙城县东北，元至顺元年建。","level":0},{"t":"清源观","level":0},{"t":"蒙城县西街，明嘉靖间建。","level":0},{"t":"寥阳万寿宫","level":0},{"t":"在亳州城内，元通真子刘志义建，编修注禧撰碑记，今为军储仓，又为儒学碑犹存。","level":0},{"t":"天静宫","level":0},{"t":"老子所妊之地，在州东福宁镇，基址犹存，有元张起岩撰碑。","level":0},{"t":"兴国院","level":0},{"t":"在城父之北杨团村，旧名大圣，元泰定二年改曰兴国。","level":0},{"t":"法相禅院","level":0},{"t":"在亳州治，宋建，穆修作记。","level":0},{"t":"滁州","level":0},{"t":"龙兴寺","level":0},{"t":"在州城中，旧名兴寿院，周显德中改今名，明洪武十八年无为禅师重建。","level":0},{"t":"开化寺","level":0},{"t":"州南琅琊山，唐大历中刺史李幼卿与僧法琛建，宋太平兴国中赐今额藏，累朝御书，明洪武中拓而广之，今属龙兴寺。","level":0},{"t":"光孝寺","level":0},{"t":"州西南二里，宋元丰间，有僧净果创报恩光孝禅寺，熙宁三年赐额。寿圣政和七年改为神霄玉清万寿宫。宣和间，复为寺绍兴间，始赐今额，今为保丰堂。","level":0},{"t":"龙蟠广福寺","level":0},{"t":"城南十七里，僧慧江建。","level":0},{"t":"黄悦广福寺","level":0},{"t":"州东南四十五里，宋皇祐初建，熙宁中赐额寿圣淳熙中改今额。","level":0},{"t":"葛城广福寺","level":0},{"t":"州东南五十五里，即庄严寺。明天顺间改今额。","level":0},{"t":"龙华寺","level":0},{"t":"在州西丰山后。","level":0},{"t":"新珠广福寺","level":0},{"t":"州西四十里，明弘治中重修。","level":0},{"t":"幽栖寺","level":0},{"t":"在州西南旧名黄草洼明万历初建有罗汉像五百尊。","level":0},{"t":"黄山寺","level":0},{"t":"州西八十里有石柱，刻祥符元年造。","level":0},{"t":"法华寺","level":0},{"t":"州南蓼湖之西，南宋嘉定间建。","level":0},{"t":"宝林寺","level":0},{"t":"在全椒县西南，唐贞观七年建。","level":0},{"t":"新兴寺","level":0},{"t":"县西南三十里，宋绍兴间建。","level":0},{"t":"永安寺","level":0},{"t":"在县东，宋建。","level":0},{"t":"康丰寺","level":0},{"t":"县南二十五里。","level":0},{"t":"神山寺","level":0},{"t":"县西北，唐建。","level":0},{"t":"福山寺","level":0},{"t":"县西北有古井七。","level":0},{"t":"石溪寺","level":0},{"t":"县西七十里，元至正中建。","level":0},{"t":"以上全椒县。","level":0},{"t":"吉祥寺","level":0},{"t":"在来安县治北，僧会司在焉。宋建。","level":0},{"t":"延塘寺","level":0},{"t":"县东南五十里本真觉院，宋天圣三年建，治平中赐额寿圣，后改今名。","level":0},{"t":"三城寺","level":0},{"t":"县西南五十里，宋庆历三年建。","level":0},{"t":"孔雀寺","level":0},{"t":"县西北▆寺山。","level":0},{"t":"独山寺","level":0},{"t":"县西北三十五里。","level":0},{"t":"太平兴国寺","level":0},{"t":"县治西北八十步，唐淮南节度使刘长庆舍宅为寺，宋太平兴国中赐额。","level":0},{"t":"龙泉寺","level":0},{"t":"县东北三十里，元建。","level":0},{"t":"宝积寺","level":0},{"t":"县北石固山","level":0},{"t":"白塔寺","level":0},{"t":"县北六十里。","level":0},{"t":"新兴寺","level":0},{"t":"县北三十五里，元至正元年建。","level":0},{"t":"普贤寺","level":0},{"t":"县北三十里，宋元祐中建，明正德间修。","level":0},{"t":"永兴寺","level":0},{"t":"县北长店桥，宋建。","level":0},{"t":"以上来安县。","level":0},{"t":"梓橦观","level":0},{"t":"在州城内，即旧文昌宫，元泰定间建。","level":0},{"t":"真武观","level":0},{"t":"在州东即真武坛，宋咸淳中建。","level":0},{"t":"白鹤观","level":0},{"t":"在全椒县治西，唐垂拱初，侍郎邢文伟建。","level":0},{"t":"开元观","level":0},{"t":"旧在来安县北，宋淳熙间移东门内，明重修。","level":0},{"t":"(附)〔明，周之冕：记〕","level":0},{"t":"来安邑东有开元观。或曰：是唐开元时建，故名也。余考来安有县起于南唐，是庙乃能先县而有？且县设之后，迁废靡定，而是庙巍然独存，岂其未经兵燹耶？抑神灵呵护，虽兵燹而庙貌犹昔耶？是皆未之或知也。苐所祀者，为真武神帝之神，徧海宇今邑之祀帝也。吾诚莫测其来，其著响应于前朝也，吾亦不得详其颠，未惟我高皇混一寰海。时东吴有士诚，西楚有友谅二雄最称劲敌。虽然，士诚犹自守虏耳。告友谅奄有荆汉，富强独最。虽吾郡鄱湖之战，歼厥渠魁，而子理奔武昌阻，阴力守，未可一鼓而下。乃圣衷政尔犹豫，未决入楚之师，而帝俨然应之以梦揖让一堂，语为指导，自称迎驾，复许嘿助，且嘱以草庐。既毁成业之后，欲圣祖鼎新其庙，则其灵爽赫著何如耶？爰以江汉削平我圣祖，思酬神功，命有司于太和旧胜，置黄金殿，爼豆千秋，香火之盛，甲实宇无两嗣。后威灵赫著，遐迩倾慕，四方之民，梯航谒拜者，日不可隶首记而神旦区别。善恶立著报应，故其为震悔自新者不少，则神之德著於民，生盛又何如也？以功若彼，以德若此，宜乎崇祀者徧海内，何独太和？又何独於来安？惟来安有庙最久，而湫隘特甚。帝尝徵梦於别驾愚谷，周君召，乃崇其悚宇，广其址基，与诸父老共维新之事，成属余为之记。","level":0},{"t":"梓橦观","level":0},{"t":"在来安县南。","level":0},{"t":"真武观","level":0},{"t":"来安县南水口集。","level":0},{"t":"宝公庵","level":0},{"t":"全椒县西七十里，即龙山寺，梁武帝建。","level":0},{"t":"云隐庵","level":0},{"t":"全椒县西北五十里，宋嘉熙间建。","level":0},{"t":"全容宫","level":0},{"t":"在州学宫东，明万历三年建。","level":0},{"t":"玉皇殿","level":0},{"t":"在州城西南琅琊山，梁柱皆以石为之。","level":0},{"t":"和州","level":0},{"t":"百福寺","level":0},{"t":"在州城内。唐贞观二年建，初有五寺，因名以五华寺，一曰文殊，二曰泗州，三曰净土，四曰弥勒，五曰百福。元末俱毁於兵。吴元年，僧法珪重建百福寺。","level":0},{"t":"广胜寺","level":0},{"t":"在东北乌江镇。","level":0},{"t":"香延寺","level":0},{"t":"在州南，俱唐建。","level":0},{"t":"乾明寺","level":0},{"t":"州东南乘驷桥东，其西即宋学旧址。","level":0},{"t":"普明寺","level":0},{"t":"州东南天门山后，元至正二年建。","level":0},{"t":"极乐寺","level":0},{"t":"州南四十里。","level":0},{"t":"梵行寺","level":0},{"t":"州南五十里，有古塔。","level":0},{"t":"妙岩寺","level":0}],[{"t":"在州南裕溪北。","level":0},{"t":"清福寺","level":0},{"t":"州南二十里晋建。","level":0},{"t":"延庆寺","level":0},{"t":"在州西长寿乡，宋熙宁三年建。","level":0},{"t":"庄严寺","level":0},{"t":"宋太平兴国中，徙苦林村，有海棠洞、罩春亭。","level":0},{"t":"开化寺","level":0},{"t":"在州南六十里，宋元祐中建。","level":0},{"t":"香社寺","level":0},{"t":"在州北寺，旁有香泉，故名。有昭明书院，有塔。寺后有二松，甚奇。","level":0},{"t":"赭乐寺州","level":0},{"t":"北五十里，以土沙赤，故名。宋嘉定十年建。","level":0},{"t":"马鞍普明寺","level":0},{"t":"州北马鞍山中，元无用禅师建。","level":0},{"t":"六坟寺","level":0},{"t":"州北如方山下，相传有僧六世修道此山，六坟在焉，故名。释迦方志：东晋隆安初，凉州沙门释宝云常游天竺大夏，解诸国音，详译经论。后自江表幽栖六合山，以终六合，即今如方山，此寺所由创也。","level":0},{"t":"孔夫寺","level":0},{"t":"州北孔夫山下，明嘉靖间重修，有碑记。","level":0},{"t":"华严寺","level":0},{"t":"州东北三十里，宋建","level":0},{"t":"甘露寺","level":0},{"t":"州东北二十里，元至正三年建。","level":0},{"t":"泉水寺","level":0},{"t":"州西北七十里，寺有泉，甚奇，唐贞观五年建。","level":0},{"t":"安国寺","level":0},{"t":"在含山县城西南，唐贞观中澄禅师建","level":0},{"t":"褒山寺","level":0},{"t":"在县北褒禅山，因唐贞观惠褒禅师得名。宋元丰中，黄庭坚、王安石、王回皆有记。张孝祥书宝塔额。明永乐中，郑和使西域，还建殿堂，制度甚工，无蛛丝鼠竁，云有辟尘珠所致，然不知所在。藏经楮小而古，蠧不敢蚀，云有异香所涂，住持世守，更有玉杵、銕杖、金磬、锦悦、玻璃盘、旃檀座等物，或侵或毁，无复遗者。","level":0},{"t":"兴教寺","level":0},{"t":"在县东关，旧名兴教院，唐贞观二年铁船祖师创，明洪武十五年重建，有饮马池、卓刀泉。","level":0},{"t":"正觉寺","level":0},{"t":"在县运漕镇，唐贞观二年金禅师建。","level":0},{"t":"大善寺","level":0},{"t":"在县南，唐铁船祖师建。","level":0},{"t":"三塔寺","level":0},{"t":"在县十四都。","level":0},{"t":"永兴寺","level":0},{"t":"县十四都有汤泉。","level":0},{"t":"华阳寺","level":0},{"t":"在县十四都，寺后有华阳洞。","level":0},{"t":"云阁寺","level":0},{"t":"县北三十里，唐铁船禅师建。","level":0},{"t":"普明寺","level":0},{"t":"在县太湖山，宋元丰二年无用禅师建。","level":0},{"t":"佛慧寺","level":0},{"t":"县西三十五里，元至正间建。","level":0},{"t":"城山寺","level":0},{"t":"县昭关山麓，曲径逶迤，幽静特甚。","level":0},{"t":"圆通寺","level":0},{"t":"县南黄稻山。","level":0},{"t":"明山寺","level":0},{"t":"县六都明山。","level":0},{"t":"净戒寺","level":0},{"t":"县南七十里，唐贞观二年守密禅师建，有彭祖炼丹井，并仙室在焉。","level":0},{"t":"以上含山县。","level":0},{"t":"元妙观","level":0},{"t":"在州治西南，宋熙宁六年建，旧名天庆观，元改名。","level":0},{"t":"淳熙观","level":0},{"t":"州南四十里，葛仙翁尝炼丹於此，有八卦池。宋太祖驾幸观，诞生太子，又名寿宁宫。","level":0},{"t":"栖云观","level":0},{"t":"州西南三十里，即今枣林寺。","level":0},{"t":"元真观","level":0},{"t":"州治南，宋建，元毁，明洪武元年复建。","level":0},{"t":"宝台观","level":0},{"t":"在含山县东街，宋张知观建。","level":0},{"t":"长真观","level":0},{"t":"在县白石山，即彭祖仙室，一名白石观。","level":0},{"t":"麟川观","level":0},{"t":"县南六十里。","level":0},{"t":"苍山庵","level":0},{"t":"县南十三都庵，有龙泉，祷雨辄应。","level":0},{"t":"云雾庵","level":0},{"t":"县北二都。","level":0},{"t":"三元宫","level":0},{"t":"在县运漕镇。","level":0},{"t":"大彻禅院","level":0},{"t":"在县太湖山西，鹤岩禅师建，有雷鸣泉、象鼻峰、洗心涧、疉玉屏诸胜。","level":0},{"t":"广德州","level":0},{"t":"天寿寺","level":0},{"t":"在州治东，一名开化寺，唐天祐间法苑禅师建，宋太平兴国中赐额。","level":0},{"t":"圣感寺","level":0},{"t":"州治东南隅，亦法苑禅师建，宋赐额。","level":0},{"t":"天宁寺","level":0},{"t":"州城南，唐元和中归宗禅师建。","level":0},{"t":"定慧寺","level":0},{"t":"州南十五里，旧名竹山寺，唐咸通八年建，明太祖驻师广德，更今名。","level":0},{"t":"唐兴寺","level":0},{"t":"州治北三十里，唐武德二年建。","level":0},{"t":"海会寺","level":0},{"t":"州治西南五十里，晋义熙中建。","level":0},{"t":"牧马寺","level":0},{"t":"州治西南。","level":0},{"t":"东泉寺","level":0},{"t":"州治东北四十里。","level":0},{"t":"上辛丰寺","level":0},{"t":"州治西。","level":0},{"t":"灵山寺","level":0},{"t":"州治南七十里。","level":0},{"t":"崇法寺","level":0},{"t":"州治南。","level":0},{"t":"云门寺","level":0},{"t":"州北。","level":0},{"t":"以上六寺俱唐建。","level":0},{"t":"鎻山寺","level":0},{"t":"州北二十里，宋至道二年建。","level":0},{"t":"上柳寺","level":0},{"t":"州北二十五里，宋淳熙中建。","level":0},{"t":"明教寺","level":0},{"t":"州治西，宋崇宁二年建。","level":0},{"t":"东山寺","level":0},{"t":"州南，宋元祐中建。","level":0},{"t":"右辛丰寺","level":0},{"t":"州南，宋元祐建。","level":0},{"t":"资福寺","level":0},{"t":"在州西，宋大中祥符中建。","level":0},{"t":"资圣寺","level":0},{"t":"在州北，宋大中祥符中建。","level":0},{"t":"保安寺","level":0},{"t":"州北六十里，南唐保大七年建。","level":0},{"t":"石溪寺","level":0},{"t":"州治东南五十里，元延祐中建。","level":0},{"t":"开法寺","level":0},{"t":"在建平县城内。","level":0},{"t":"梵王寺","level":0},{"t":"县东南二十五里。","level":0},{"t":"宝光寺","level":0},{"t":"县西南三十里。","level":0},{"t":"宝林寺","level":0},{"t":"县西南六十里。","level":0},{"t":"兴教寺","level":0},{"t":"县南四十五里。","level":0},{"t":"静觉寺","level":0},{"t":"县南八十里。","level":0},{"t":"静安寺","level":0},{"t":"县东北二十五里。","level":0},{"t":"龙会寺","level":0},{"t":"县东北四十里。","level":0},{"t":"寿昌寺","level":0},{"t":"县北三十里，一名双柏寺。","level":0},{"t":"元妙观","level":0},{"t":"在州治东门外，旧在州南，初名天庆观，唐贞元元年易今名，明嘉靖初移。","level":0},{"t":"越城观","level":0},{"t":"在建平县西北二十里。","level":0},{"t":"阳春观","level":0},{"t":"县北二十里。","level":0},{"t":"存真道院","level":0},{"t":"在县治东，明洪武中建。","level":0},{"t":"六安州","level":0},{"t":"观音寺","level":0},{"t":"在州城西南，唐建，有碑刻吴道子畫大士像。","level":0},{"t":"文殊寺","level":0},{"t":"州武定门外。","level":0},{"t":"西安寺","level":0},{"t":"州通济门，俱宋建。","level":0},{"t":"化城寺","level":0},{"t":"在州溶河西北。","level":0},{"t":"石佛寺","level":0},{"t":"州四十九都宋建。","level":0},{"t":"云居寺","level":0},{"t":"在州西北，独龙涧水绕环其旁。唐建。","level":0},{"t":"华岩寺","level":0},{"t":"州南响河口，与八仙岩相望，唐开宝间建，有碑。","level":0},{"t":"黄莲寺","level":0},{"t":"州西四十里，寺前有池，旧生莲花，色如金明。嘉靖间重修，得断碑，载建炎年号。","level":0},{"t":"隆兴寺","level":0},{"t":"州西南九公山南，元建。","level":0},{"t":"万寿寺","level":0},{"t":"在英山县南，元建。","level":0},{"t":"长石寺","level":0},{"t":"在县治西北。","level":0},{"t":"万峰寺","level":0},{"t":"县西北，俱宋建。","level":0},{"t":"神峰寺","level":0},{"t":"在县西神峰山上。","level":0},{"t":"以上英山县。","level":0},{"t":"灊台寺","level":0},{"t":"在霍山县西灊台山，元建。","level":0},{"t":"会胜寺","level":0},{"t":"在县挹秀门外，有古佛、古炉，皆元时旧物。","level":0},{"t":"复览寺","level":0},{"t":"县东二十里，有圣泉三，清馨异常。","level":0},{"t":"云峰寺","level":0},{"t":"在县西野鸡岭。","level":0},{"t":"水口寺","level":0},{"t":"在县西三十五里，仙人冲山，凡数折，奇削天成，诸峰环抱。","level":0},{"t":"以上霍山县。","level":0},{"t":"佑圣观","level":0},{"t":"在州东北儒林冈左，宋建。","level":0},{"t":"太乙观","level":0},{"t":"在英山县治西，元建。","level":0},{"t":"祐圣观","level":0},{"t":"在霍山县西。","level":0},{"t":"冲虚观","level":0},{"t":"霍山县南，俱元建。","level":0},{"t":"万寿禅林","level":0},{"t":"在州通济门外，即大悲禅院，内建御书楼。","level":0},{"t":"泗州","level":0},{"t":"大圣寺","level":0},{"t":"在州治西，唐普照王寺，中宗避太后讳，易曰普光王寺，屡毁，元再建，有赵孟𫖯记，明永乐中重修。","level":0}],[{"t":"福庆寺","level":0},{"t":"在州治西，即今观音寺，宋淳熙中建，明万历间构藏经楼於内。","level":0},{"t":"临淮寺","level":0},{"t":"州东四十里，明建。","level":0},{"t":"卧佛寺","level":0},{"t":"州西甓山上，明建","level":0},{"t":"恭觉寺","level":0},{"t":"州西北龙窝镇，元延祐二年建。","level":0},{"t":"铁佛寺","level":0},{"t":"州西四十里，寺有古铁佛，唐建。","level":0},{"t":"上龟山寺","level":0},{"t":"在盱眙县西南，宋天禧二年建，明洪武初重修，有无梁殿、铁罗汉一百二十尊。","level":0},{"t":"下龟山寺","level":0},{"t":"在县东三十里，宋天禧间京师岁旱，有浮屠人断臂祷雨，官为起寺於龟山，所谓金臂祖师。明洪武八年僧永正重建佛像，皆铁铸。","level":0},{"t":"大宝塔云寺","level":0},{"t":"在县南一百二十里，唐建，明洪武五年修。","level":0},{"t":"静明寺","level":0},{"t":"县东紫阳山，宋建，明景泰中修，有古塔。","level":0},{"t":"开化寺","level":0},{"t":"县西七十里，宋皇祐间建，明洪武中修。","level":0},{"t":"五塔寺","level":0},{"t":"县西南面临淮水，寺后旧有五塔，下有石室三联，即今之归云洞。","level":0},{"t":"灵岩寺","level":0},{"t":"在县西浮山顶上。","level":0},{"t":"以上盱眙县。","level":0},{"t":"真胜寺","level":0},{"t":"在天长县东，梁普通间达磨建，明洪武中修。","level":0},{"t":"罗汉寺","level":0},{"t":"在县东，唐贞观中建，明洪武间修。","level":0},{"t":"地藏寺","level":0},{"t":"在县东北。","level":0},{"t":"大悲寺","level":0},{"t":"在县西，俱唐建。","level":0},{"t":"宝定寺","level":0},{"t":"县西南三十五里，明洪武中建。","level":0},{"t":"胜因禅寺","level":0},{"t":"县东南四十五里，宋建","level":0},{"t":"禅林寺","level":0},{"t":"县东北城门镇东，元至正五年建。","level":0},{"t":"天官寺","level":0},{"t":"县东横山，明洪武二十二年重建。","level":0},{"t":"宣梵寺","level":0},{"t":"县西四十五里，元文宗时建，明正统间浚古井，获石佛三十有六。","level":0},{"t":"以上天长县。","level":0},{"t":"寿圣寺","level":0},{"t":"旧在五河县北，宋德祐中建，明洪武十九年移建於县西。","level":0},{"t":"三清观","level":0},{"t":"在州治西，宋咸淳九年建，明洪武三十年修。","level":0},{"t":"瑞岩观","level":0},{"t":"在盱眙县玻璃泉南石岩上，宋时女冠朱妙真建，明永乐间修。","level":0},{"t":"元妙观","level":0},{"t":"在盱眙上龟山。","level":0},{"t":"至道观","level":0},{"t":"在天长县治，宋建。","level":0},{"t":"元妙观","level":0},{"t":"在天长县北，即真武祠。","level":0},{"t":"天保宫","level":0},{"t":"在五河县东南，明嘉靖二十五年改建，四十年重修为祝庆之所。","level":0},{"t":"观音院","level":0},{"t":"在州东门山，宋嘉祐间建，明洪武中修。","level":0},{"t":"嘉祐院","level":0},{"t":"在盱眙县昭信集，宋建。","level":0},{"t":"兴教塔院","level":0},{"t":"在天长县铜城镇，明洪武二年重建。","level":0},{"t":"真武庙","level":0},{"t":"在州北门城上，即今老君望，明洪武初建。","level":0},{"t":"灵瑞塔","level":0},{"t":"在州城西，唐景龙中建，宋太平兴国七年奉勅重建，塔高十三级，改名雍熙塔。后毁，元延祐二年改建甎塔，高一百五十尺，基广二十一丈，有赵孟𫖯碑记。国朝顺治九年重修。","level":0}]]