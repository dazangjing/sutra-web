{"id":"x0281","title":"楞嚴經圓通疏","titleTrad":"楞嚴經圓通疏","byline":"","bylineLabel":"著者·译者","dynasty":"","division":"经疏部","canon":"X0281","canonName":"新纂卍續藏","volume":"X0281","juanCount":10,"textLength":448811,"imageCount":0,"summary":"","tags":["经疏部","新纂卍續藏"],"order":1409,"guide":"","chunks":101,"toc":[{"level":3,"text":"大佛頂首楞嚴經圓通疏序"},{"level":3,"text":"菩薩戒天台宣灑虞淳熈和南謹序"},{"level":3,"text":"楞嚴經圓通疏序"},{"level":3,"text":"大佛頂首楞嚴經圓通疏序"},{"level":2,"text":"萬行首楞嚴經卷第一"},{"level":2,"text":"【疏】張無盡曰：九次第定，即第九卷四"},{"level":2,"text":"與首卷二"},{"level":2,"text":"次說三如來藏也。自四卷一"},{"level":2,"text":"首卷三"},{"level":2,"text":"首卷一"}],"chunksPerFile":20}