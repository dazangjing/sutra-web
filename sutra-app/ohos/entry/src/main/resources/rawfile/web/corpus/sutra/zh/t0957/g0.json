[[{"t":"金刚顶经一字顶轮王瑜伽一切时处念诵成佛仪轨一卷","level":0},{"t":"特进试鸿胪卿大兴善寺三藏沙门大广智不空奉　诏译","level":0},{"t":"稽首礼普贤，诸佛转轮王，","level":0,"quote":true},{"t":"现证大菩提，受名金刚界。","level":0,"quote":true},{"t":"为转教勅轮，从自顶流出，","level":0,"quote":true},{"t":"大金轮明王，威光逾众日，","level":0,"quote":true},{"t":"七宝具围绕，为一切佛顶。","level":0,"quote":true},{"t":"轮王之轮王，才现奇特身，","level":0,"quote":true},{"t":"诸圣众皆没，显胜绝不共，","level":0,"quote":true},{"t":"唯佛一体故。则彼婆伽梵，","level":0,"quote":true},{"t":"以自性智光，成威曜日轮，","level":0,"quote":true},{"t":"遍照无餘界，摧坏诸暗暝，","level":0,"quote":true},{"t":"令菩提心生。复以身口意，","level":0,"quote":true},{"t":"一切金刚界，成佛事业轮。","level":0,"quote":true},{"t":"其量同虚空，遍诸有情界，","level":0,"quote":true},{"t":"烁断彼罪障，妄执诸结使。","level":0,"quote":true},{"t":"为演不共法，赐髻珠七宝，","level":0,"quote":true},{"t":"令顿证菩提，是故当归依。","level":0,"quote":true},{"t":"我依金刚顶，瑜伽大教王，","level":0,"quote":true},{"t":"为修瑜伽者，纂集此微妙，","level":0,"quote":true},{"t":"成佛理趣门，自心成等觉，","level":0,"quote":true},{"t":"深奥穿能量，具以善诠示，","level":0,"quote":true},{"t":"无相无言法，毘卢遮那佛，","level":0,"quote":true},{"t":"一字顶轮王，殊胜秘密法。","level":0,"quote":true},{"t":"瑜伽念诵仪，修此三昧者，","level":0,"quote":true},{"t":"现证佛菩提。传法阿阇梨，","level":0,"quote":true},{"t":"先简择弟子，净信决定者，","level":0,"quote":true},{"t":"宿殖诸善根，族姓具相好，","level":0,"quote":true},{"t":"孝忠义德备，深教重三宝，","level":0,"quote":true},{"t":"渴爱於大乘，闻覩诸菩萨，","level":0,"quote":true},{"t":"顺世诸方便，随机化度事，","level":0,"quote":true},{"t":"不生疑惑心，乐修菩萨行，","level":0,"quote":true},{"t":"勇进不怯弱，护法行六度，","level":0,"quote":true},{"t":"捐舍身命财，无厌悔顾悋。","level":0,"quote":true},{"t":"求学瑜伽教，恒被大精进，","level":0,"quote":true},{"t":"大慈誓愿铠，欣三解脱门。","level":0,"quote":true},{"t":"乐心四无量，哀愍诸有情，","level":0,"quote":true},{"t":"拔济心无间，乃至令成佛。","level":0,"quote":true},{"t":"灌顶师若见，如此胜法器，","level":0,"quote":true},{"t":"以种种方便，慰诱先为说，","level":0,"quote":true},{"t":"大乘秘密门，三世诸如来，","level":0,"quote":true},{"t":"皆因入此法，速获一切智。","level":0,"quote":true},{"t":"种种开示已，教发菩提心，","level":0,"quote":true},{"t":"授与佛性戒，金刚坚固禁。","level":0,"quote":true},{"t":"当引入轮坛，灌顶受职已，","level":0,"quote":true},{"t":"令瞻覩圣会，告示三麼耶。","level":0,"quote":true},{"t":"从今至成佛，莫舍菩提心，","level":0,"quote":true},{"t":"敬仰阿阇梨，如诸佛世尊。","level":0,"quote":true},{"t":"所有言教诲，应当尽奉行，","level":0,"quote":true},{"t":"不寻求师短，随见烦恼行。","level":0,"quote":true},{"t":"观贪染本净，於诸同学处，","level":0,"quote":true},{"t":"不生嫌恨心，敬如执金刚。","level":0,"quote":true},{"t":"乃至诸含识，亦不应轻恼，","level":0,"quote":true},{"t":"诸天神仙等，皆不应礼事。","level":0,"quote":true},{"t":"勿不敬凌蔑，所覩一切物，","level":0,"quote":true},{"t":"不应故骑蓦，为有同坛内，","level":0,"quote":true},{"t":"诸圣所执持。亲从阿阇梨，","level":0,"quote":true},{"t":"对受诸仪轨，印契及密言，","level":0,"quote":true},{"t":"微妙三麼地，轮金刚杵铃，","level":0,"quote":true},{"t":"及餘诸道具，为求成就故，","level":0,"quote":true},{"t":"乃至登佛位，恒持不暂舍。","level":0,"quote":true},{"t":"於此教法中，一字不应向，","level":0,"quote":true},{"t":"未灌顶者说，本尊诸教法。","level":0,"quote":true},{"t":"除本受法师，设诸同行人，","level":0,"quote":true},{"t":"亦不得为说。纵已得成就，","level":0,"quote":true},{"t":"才说便散失，现招诸殃祸，","level":0,"quote":true},{"t":"中夭堕地狱。是故常守护，","level":0,"quote":true},{"t":"此三麼耶禁。诸佛共演说，","level":0,"quote":true},{"t":"众圣皆保持，应学勿违越。","level":0,"quote":true},{"t":"及修外仪式，洗濑嚼齿木，","level":0,"quote":true},{"t":"噉豆<img class=\"gaiji\" src=\"asset://gaiji-CB/03/CB03736.gif\" alt=\"𦽛\" title=\"𦽛\" />涂香，令身口香洁。","level":0,"quote":true},{"t":"不应食荤杂，酒肉诸残触，","level":0,"quote":true},{"t":"常洁身净服，令内外无垢。","level":0,"quote":true},{"t":"不应长爪甲，居秽违教处，","level":0,"quote":true},{"t":"内所谓六根，用三密净除。","level":0,"quote":true},{"t":"外谓诸仪轨，法香水灌沐，","level":0,"quote":true},{"t":"或外缘不备，即以法净除。","level":0,"quote":true},{"t":"此理趣最胜，当观念囕字，","level":0,"quote":true},{"t":"如下文广明，净除内外垢，","level":0,"quote":true},{"t":"不沐而成浴。常服当净衣，","level":0,"quote":true},{"t":"荡涤等虚空，无垢如法界，","level":0,"quote":true},{"t":"事理俱相应，如来最称赞。","level":0,"quote":true},{"t":"修习喻迦者，从师受本尊，","level":0,"quote":true},{"t":"瑜伽仪轨已，明了无疑惑，","level":0,"quote":true},{"t":"然乃勇进修，於一切时处，","level":0,"quote":true},{"t":"念诵皆成就。若於闲静处，","level":0,"quote":true},{"t":"名山随意乐，高峰最殊胜，","level":0,"quote":true},{"t":"或诸教所说，诸佛称赞处。","level":0,"quote":true},{"t":"若旧塔殿宇，或创建精室，","level":0,"quote":true},{"t":"依教净治地，以牛粪遍涂，","level":0,"quote":true},{"t":"极令细滑已，又磨白檀香，","level":0,"quote":true},{"t":"泥拭曼荼罗，方圆随大小，","level":0,"quote":true},{"t":"罗列诸圣位，散时花庄严。","level":0,"quote":true},{"t":"随力办供具，涂香阏伽水，","level":0,"quote":true},{"t":"焚香饮食灯，幡盖铃珮等，","level":0,"quote":true},{"t":"陈设坛四边。若有本尊像，","level":0,"quote":true},{"t":"室内面西安，瑜伽者面东。","level":0,"quote":true},{"t":"每初入道场，想佛常住世，","level":0,"quote":true},{"t":"以五轮著地，如教归命礼。","level":0,"quote":true},{"t":"复谛观诸佛，遍满虚空界，","level":0,"quote":true},{"t":"侧塞如胡麻，即应发是心：","level":0,"quote":true},{"t":"我今普礼献，即取香涂手，","level":0,"quote":true},{"t":"结一切供养，最胜出生印。","level":0,"quote":true},{"t":"先如常合掌，当自心即以，","level":0,"quote":true},{"t":"诸指右押左，初分互相交，","level":0,"quote":true},{"t":"成金刚合掌。一切诸密印，","level":0,"quote":true},{"t":"无非从此生，故名虚空库。","level":0,"quote":true},{"t":"结印诵密言，安顶上运心，","level":0,"quote":true},{"t":"想自身遍礼，一一如来足。","level":0,"quote":true},{"t":"复舍身奉献，诵舍身真言，","level":0,"quote":true},{"t":"诸佛菩萨众，求请念加持。","level":0,"quote":true},{"t":"诵一切金刚，不空三摩耶，","level":0,"quote":true},{"t":"诸佛事业心：","level":0,"quote":true},{"t":"「oṃ　sa　rva　vi","level":0},{"t":"由此印密言，等流自身遍，","level":0,"quote":true},{"t":"十方无边界，微尘刹土中，","level":0,"quote":true},{"t":"诸佛大海会，咸皆有自身，","level":0,"quote":true},{"t":"如羯磨菩萨，於一一尊前，","level":0,"quote":true},{"t":"持诸供养具，舍身奉献事，","level":0,"quote":true},{"t":"皆蒙受加持。悔喜劝请向，","level":0,"quote":true},{"t":"依普贤行愿，瑜伽花严等。","level":0,"quote":true},{"t":"即结跏趺坐，全半或轮跏，","level":0,"quote":true},{"t":"皆以右押左，端身定支节。","level":0,"quote":true},{"t":"左手仰跏上，仰右手安左，","level":0,"quote":true},{"t":"即发大悲心，拔济利安乐，","level":0,"quote":true},{"t":"尽无餘有情，以此性成就。","level":0,"quote":true},{"t":"菩提心密言，随意念诵之，","level":0,"quote":true},{"t":"发菩提胜心：","level":0,"quote":true},{"t":"「a","level":0},{"t":"由适诵密言，发菩提心故，","level":0,"quote":true},{"t":"摧灭诸罪障，获诸悦意乐。","level":0,"quote":true},{"t":"等同一切佛，超胜众魔罗，","level":0,"quote":true},{"t":"不能为障碍，应受诸世间，","level":0,"quote":true},{"t":"广大之供养。复次应谛观，","level":0,"quote":true},{"t":"根尘识诸法，自性本皆空。","level":0,"quote":true},{"t":"又思伽他义，一切如虚空，","level":0,"quote":true},{"t":"虚空亦无相，诸法相应故，","level":0,"quote":true},{"t":"舒遍於一切。诵此四句偈，","level":0,"quote":true},{"t":"所覩彼彼境，皆照空亦空。","level":0,"quote":true},{"t":"由胜解空体，自彻见本心，","level":0,"quote":true},{"t":"皎洁如满月，离能取所取，","level":0,"quote":true},{"t":"自性光明成，菩提体坚固。","level":0,"quote":true},{"t":"复从月轮内，踊出大法轮，","level":0,"quote":true},{"t":"金刚之所成，辐辋皆锋锐。","level":0,"quote":true},{"t":"其色如檀金，遍流大威光，","level":0,"quote":true},{"t":"过聚尘数日，依住月轮面。","level":0,"quote":true},{"t":"金刚表极坚，圆显福智满，","level":0,"quote":true},{"t":"利为无戏论，断坏诸妄执。","level":0,"quote":true},{"t":"光表一切智，除破诸愚瞑，","level":0,"quote":true},{"t":"以是现轮形，量同虚空故。","level":0,"quote":true},{"t":"虚空诸如来，尽入於轮内，","level":0,"quote":true},{"t":"即观此智轮，变成金轮王。","level":0,"quote":true},{"t":"遍照如来身，形服如素月，","level":0,"quote":true},{"t":"以一切相好，用庄严法身。","level":0,"quote":true},{"t":"戴金刚宝冠，轮鬘为首饰，","level":0,"quote":true},{"t":"众宝庄严具，种种拔饰身。","level":0,"quote":true},{"t":"持智拳大印，处於师子座，","level":0,"quote":true},{"t":"日轮白莲台。智拳印所谓：","level":0,"quote":true},{"t":"中小名掘梅，头指柱大背，","level":0,"quote":true},{"t":"金刚拳乃成，右握左头指，","level":0,"quote":true},{"t":"一节面当心，是名智拳印。","level":0,"quote":true},{"t":"当诵此密言：","level":0,"quote":true},{"t":"「bhrūṃ","level":0},{"t":"三密才相应，自身同本尊，","level":0,"quote":true},{"t":"能遍入佛智，成佛犹不难。","level":0,"quote":true},{"t":"获智寿力年，得一切遍行，","level":0,"quote":true},{"t":"现证大菩提，故名觉胜印。","level":0,"quote":true},{"t":"若修此瑜伽，设现造无量，","level":0,"quote":true},{"t":"极重诸罪障，必能超恶趣，","level":0,"quote":true},{"t":"剋疾证菩提。为显此最上，","level":0,"quote":true},{"t":"甚深微密义，故住此大印。","level":0,"quote":true},{"t":"拳能坚执持，诸佛智法海，","level":0,"quote":true},{"t":"坚固不散失，能成一切印，","level":0,"quote":true},{"t":"故名金刚拳，右执左头指。","level":0,"quote":true},{"t":"十方刹土中，唯有一佛乘，","level":0,"quote":true},{"t":"如来之顶法，等持诸佛体，","level":0,"quote":true},{"t":"是故名智拳。复观金刚轮，","level":0,"quote":true},{"t":"庄严心月轮。次结顶轮王，","level":0,"quote":true},{"t":"胜身三摩耶，印心额喉顶。","level":0,"quote":true},{"t":"其印如前作，坚金刚合掌，","level":0,"quote":true},{"t":"即并竖中指，由如青莲叶，","level":0,"quote":true},{"t":"屈头指各安，中指背上节。","level":0,"quote":true},{"t":"当知印相义，大指为结跏，","level":0,"quote":true},{"t":"中指像佛身，名小成光焰，","level":0,"quote":true},{"t":"二掌日月轮，腕表师子座，","level":0,"quote":true},{"t":"是故名如来，胜身三摩耶。","level":0,"quote":true},{"t":"当诵此密语：","level":0,"quote":true},{"t":"「oṃ　bhūḥ　khaṃ","level":0},{"t":"此毘卢遮那，佛三字密言，","level":0,"quote":true},{"t":"共一字无异，适以印密言。","level":0,"quote":true},{"t":"印心成镜智，速获菩提心，","level":0,"quote":true},{"t":"金刚坚固体。印额应当知，","level":0,"quote":true},{"t":"成平等性智，速获灌顶地，","level":0,"quote":true},{"t":"福聚庄严身。密语印口时，","level":0,"quote":true},{"t":"成妙观察智，即能转法轮，","level":0,"quote":true},{"t":"得佛智慧身。诵密言印顶，","level":0,"quote":true},{"t":"成成所作智，证佛变化身。","level":0,"quote":true},{"t":"能伏难调者，由此印密言，","level":0,"quote":true},{"t":"加持自身成，法界体性智，","level":0,"quote":true},{"t":"毘卢遮那佛，虚空法界身。","level":0,"quote":true}],[{"t":"即分印为二，金刚拳从额，","level":0,"quote":true},{"t":"等引至脑后，则竖二头指，","level":0,"quote":true},{"t":"每处三相绕，从小指历散，","level":0,"quote":true},{"t":"如垂下天衣。诵一切灌顶，","level":0,"quote":true},{"t":"三麼耶宝心：","level":0,"quote":true},{"t":"「trāṃ","level":0},{"t":"由此印密言，即蒙虚空界，","level":0,"quote":true},{"t":"一切佛世界，以金刚宝冠，","level":0,"quote":true},{"t":"轮鬘缯彩等，与具足灌顶，","level":0,"quote":true},{"t":"为悦圣众故。二手当心前，","level":0,"quote":true},{"t":"平掌三相拍，应诵此密言：","level":0,"quote":true},{"t":"「hoḥ","level":0},{"t":"由此拍掌仪，轮王及眷属，","level":0,"quote":true},{"t":"适悦而爱顺，速满瑜伽者，","level":0,"quote":true},{"t":"意愿悉地果，当获坚固体。","level":0,"quote":true},{"t":"次陈供养仪，奉尊并圣众，","level":0,"quote":true},{"t":"作金刚合掌，仪式如前说。","level":0,"quote":true},{"t":"安於自顶上，诵虚空库藏，","level":0,"quote":true},{"t":"大菩萨密言，当作是思惟。","level":0,"quote":true},{"t":"从印中流出，诸供养云海，","level":0,"quote":true},{"t":"阏伽众香水，诸天妙伎乐，","level":0,"quote":true},{"t":"歌舞嬉戏等，涂香花烧香，","level":0,"quote":true},{"t":"饮食灯贤瓶，劫树诸宝类。","level":0,"quote":true},{"t":"白拂繖台阁，宝幢幡铃珮，","level":0,"quote":true},{"t":"珠璎帐花鬘，宫殿天男女，","level":0,"quote":true},{"t":"及人天所有，一切受用物。","level":0,"quote":true},{"t":"於此瞻部洲，及十方佛土，","level":0,"quote":true},{"t":"水陆诸花等，人天意乐者，","level":0,"quote":true},{"t":"福感并变化，婵娟花馝馞。","level":0,"quote":true},{"t":"又以诸天人，所有本体香，","level":0,"quote":true},{"t":"和合变易香，烧香涂抹香，","level":0,"quote":true},{"t":"种种差别类，气馥妙悦意。","level":0,"quote":true},{"t":"复献诸人天，所有本体光，","level":0,"quote":true},{"t":"自性及差别，殊胜悦意光。","level":0,"quote":true},{"t":"三世三界中，一切天供养，","level":0,"quote":true},{"t":"众多种差别，如《金刚顶经》，","level":0,"quote":true},{"t":"及诸秘密教，一切众大乘，","level":0,"quote":true},{"t":"契经等所说。广大供养具，","level":0,"quote":true},{"t":"先奉献本尊，并眷属等已。","level":0,"quote":true},{"t":"次等引周遍，十方诸世界，","level":0,"quote":true},{"t":"尽虚空法界，微尘刹土中，","level":0,"quote":true},{"t":"诸佛大海会，一一圣众前，","level":0,"quote":true},{"t":"普供养而住。复观察十方，","level":0,"quote":true},{"t":"发如是愿言：「我今请诸佛，","level":0,"quote":true},{"t":"未转法轮者，愿速转法轮，","level":0,"quote":true},{"t":"欲入涅槃者，愿常住在世。」","level":0,"quote":true},{"t":"复兴如是念：「无边诸含识，","level":0,"quote":true},{"t":"沦溺於六趣，由自心虚妄。","level":0,"quote":true},{"t":"感种种业报，坏佛性不知，","level":0,"quote":true},{"t":"深可悲伤愍，我今云何救？」","level":0,"quote":true},{"t":"复作是思惟：「我所积福业，","level":0,"quote":true},{"t":"应用拯济彼，我由献涂香，","level":0,"quote":true},{"t":"当获五法身。愿从此等流，","level":0,"quote":true},{"t":"五无漏涂香，磨莹热恼者，","level":0,"quote":true},{"t":"奋破诸地狱，一切剧炎承。","level":0,"quote":true},{"t":"献花故当得，四八大人相，","level":0,"quote":true},{"t":"复回向此福，成妙觉花台。","level":0,"quote":true},{"t":"舒光遍照触，惊觉人天趣，","level":0,"quote":true},{"t":"耽著诸欲境，八苦所缠逼，","level":0,"quote":true},{"t":"天乐变化苦。愿彼诸天人，","level":0,"quote":true},{"t":"菩提心敷荣，获普贤常乐。","level":0,"quote":true},{"t":"我由奉焚香，得佛无碍智，","level":0,"quote":true},{"t":"悦泽具端严。回施此香云，","level":0,"quote":true},{"t":"氛馥寒水苦，献食获法喜，","level":0,"quote":true},{"t":"禅悦解脱味。回施饿鬼趣，","level":0,"quote":true},{"t":"普雨诸微妙，天甘露饮食。","level":0,"quote":true},{"t":"愿食加持食，皆悉得充足，","level":0,"quote":true},{"t":"永离饥渴苦，悭贪恶习业。","level":0,"quote":true},{"t":"献灯得五眼，以为般若灯，","level":0,"quote":true},{"t":"照曜阿修罗，永断矫诳心。","level":0,"quote":true},{"t":"恚痴好鬪诤，傍生鞭挞逼，","level":0,"quote":true},{"t":"互相害食噉。愿得慈悲心，","level":0,"quote":true},{"t":"常生人天路。色无色界天，","level":0,"quote":true},{"t":"耽著三昧味，愿脱此惑缠。","level":0,"quote":true},{"t":"献阏伽香水，证平等性智，","level":0,"quote":true},{"t":"三界法王位。回施此降注，","level":0,"quote":true},{"t":"金刚甘露水，灌沐水居者，","level":0,"quote":true},{"t":"永离傍生趣，速获净法身。","level":0,"quote":true},{"t":"及下彻无间，一切诸地狱，","level":0,"quote":true},{"t":"苦具碎如尘，皆成清凉地，","level":0,"quote":true},{"t":"受苦诸群品，解脱生净土。","level":0,"quote":true},{"t":"奉嬉常受悦，献笑佛怜念，","level":0,"quote":true},{"t":"奏歌得法音，供舞得神通，","level":0,"quote":true},{"t":"奉瓶得贤瓶，能满悦意愿。","level":0,"quote":true},{"t":"进宝获众宝，由贡庄严树，","level":0,"quote":true},{"t":"得佛衣觉树。奉幢得雨宝，","level":0,"quote":true},{"t":"能遍济贫乏，供幡超胜魔，","level":0,"quote":true},{"t":"献铃众归从。奉璎获严具，","level":0,"quote":true},{"t":"进鬘得宝冠，上花得佛容。","level":0,"quote":true},{"t":"复以此福聚，回施於无尽，","level":0,"quote":true},{"t":"无餘有情界，六趣四生等。","level":0,"quote":true},{"t":"乃至以自身，心口三金刚，","level":0,"quote":true},{"t":"地水火风界，周遍於无边，","level":0,"quote":true},{"t":"等虚空法界，与一切含识，","level":0,"quote":true},{"t":"悦意受用之。住此无缘悲，","level":0,"quote":true},{"t":"常拔济利乐，共彼同回向，","level":0,"quote":true},{"t":"愿成大菩提，应一切智智。」","level":0,"quote":true},{"t":"复作是观察，一切法皆空，","level":0,"quote":true},{"t":"三轮体非有，当知无所得。","level":0,"quote":true},{"t":"住是三摩地，能真实拔济，","level":0,"quote":true},{"t":"获无限福利，所作速成就。","level":0,"quote":true},{"t":"作是观念时，诵最胜出生，","level":0,"quote":true},{"t":"种种供养藏，广大仪如来，","level":0,"quote":true},{"t":"一切供养心。","level":0,"quote":true},{"t":"「oṃ","level":0},{"t":"由此密语印，加持威力故。","level":0,"quote":true},{"t":"纵观想不成，於诸佛海会，","level":0,"quote":true},{"t":"皆有如上等，诸供养云海，","level":0,"quote":true},{"t":"真实具成就。由诸佛诚谛，","level":0,"quote":true},{"t":"法尔所成故。次当诵本尊，","level":0,"quote":true},{"t":"一百八名赞，作金刚合掌，","level":0,"quote":true},{"t":"当心左低身，是为敬礼仪。","level":0,"quote":true},{"t":"应以美韵调，唱此金刚歌，","level":0,"quote":true},{"t":"次诵嬉戏密，言印用前印。","level":0,"quote":true},{"t":"「oṃ　va　jrasaṃ　gra　ksaṃ","level":0,"quote":true},{"t":"不改金刚掌，合臂舒安额，","level":0,"quote":true},{"t":"即是献花鬘，清雅调称此。","level":0,"quote":true},{"t":"「va　jra　ra　tna　ma　nutraṃ","level":0,"quote":true},{"t":"前印从於脐，渐上至口写，","level":0,"quote":true},{"t":"是奏歌即诵。","level":0,"quote":true},{"t":"「va　jra　dha　rmma　gā　ya　da","level":0},{"t":"当心右旋转，金刚合掌已，","level":0,"quote":true},{"t":"复安於顶上，名进金刚舞。","level":0,"quote":true},{"t":"如前诵复唱：","level":0,"quote":true},{"t":"「va　jra　ka　rmmaru　bha　va","level":0,"quote":true},{"t":"由陈是秘密，瑜伽歌咏赞，","level":0,"quote":true},{"t":"叹扬如来故，成佛尚不难，","level":0,"quote":true},{"t":"况求诸成就。应知何以故？","level":0,"quote":true},{"t":"所谓一切乐，不如婆伽梵，","level":0,"quote":true},{"t":"金刚萨埵乐，是故速成就。","level":0,"quote":true},{"t":"次以本部母，佛眼印密言，","level":0,"quote":true},{"t":"当心诵七遍，印四或五处，","level":0,"quote":true},{"t":"四心额喉顶，五额左右肩，","level":0,"quote":true},{"t":"心喉顶上散，处各诵一遍。","level":0,"quote":true},{"t":"其印如前作，金刚合掌已，","level":0,"quote":true},{"t":"并屈二头指，甲合并竖大，","level":0,"quote":true},{"t":"各押头指侧，谓佛眼密言：","level":0,"quote":true},{"t":"「na　maḥ　sa　ma　nta　bu　ddhā　nāṃ　oṃ　bu　ddhā　ru　ca　ni　svā　hā","level":0},{"t":"由部母加持，本尊并眷属，","level":0,"quote":true},{"t":"皆共喜爱念。瑜伽者纵有，","level":0,"quote":true},{"t":"违犯阙法等，矜愍不见过，","level":0,"quote":true},{"t":"亦不凌逼他。持诸密语者，","level":0,"quote":true},{"t":"若不作此法，不得微阙少，","level":0,"quote":true},{"t":"况犯三麼耶。若不依瑜伽，","level":0,"quote":true},{"t":"作事法念诵，不对坛舍利，","level":0,"quote":true},{"t":"非时处不净，辄结印念持，","level":0,"quote":true},{"t":"决定获殃咎。修行诸尊者，","level":0,"quote":true},{"t":"五百由旬内，尊皆不降赴，","level":0,"quote":true},{"t":"亦不赐悉地，以轮王威德，","level":0,"quote":true},{"t":"断坏诸法故。所以一切时，","level":0,"quote":true},{"t":"先作是加持，何故事法仪，","level":0,"quote":true},{"t":"不许非时处，念诵求成就？","level":0,"quote":true},{"t":"为轮王威德，最胜无极尊，","level":0,"quote":true},{"t":"不应无限约，降赴非时处。","level":0,"quote":true},{"t":"纯净无戏论，教命不可犯，","level":0,"quote":true},{"t":"是故不失期，辄称诵启请。","level":0,"quote":true},{"t":"瑜伽理趣门，自心所建立，","level":0,"quote":true},{"t":"自身为本尊，集诸如来体。","level":0,"quote":true},{"t":"加持为己身，尽以虚空界，","level":0,"quote":true},{"t":"为宫殿安住，自身处於中。","level":0,"quote":true},{"t":"住本尊瑜伽，圣眷属围绕，","level":0,"quote":true},{"t":"成大曼荼罗，由是故无碍。","level":0,"quote":true},{"t":"又为诸行者，不达空无相，","level":0,"quote":true},{"t":"如来体性故，瑜伽中教王，","level":0,"quote":true},{"t":"唯一平等净。观身知空相，","level":0,"quote":true},{"t":"即是自本尊，由此胜解故，","level":0,"quote":true},{"t":"於一切时处，念诵获成就。","level":0,"quote":true},{"t":"又作前智拳，诵一字密语，","level":0,"quote":true},{"t":"身观如前说，心月中轮脐。","level":0,"quote":true},{"t":"现一字金色，舌端亦如是，","level":0,"quote":true},{"t":"则是字为轮，其轮为转轮。","level":0,"quote":true},{"t":"持色如金容，备七珍围绕，","level":0,"quote":true},{"t":"宝轮宝在前，餘宝右旋置。","level":0,"quote":true},{"t":"珠宝与无量，摩尼众围绕，","level":0,"quote":true},{"t":"次宝女亦与，无边婇女俱。","level":0,"quote":true},{"t":"马宝及象宝，主库藏神宝，","level":0,"quote":true},{"t":"各领自眷属，无量众待立。","level":0,"quote":true},{"t":"兵宝持金刚，无能胜为师，","level":0,"quote":true},{"t":"佛眼如来母，共宝居八方。","level":0,"quote":true},{"t":"如世金轮王，具七宝眷属，","level":0,"quote":true},{"t":"如来顶轮王，以佛无上宝，","level":0,"quote":true},{"t":"为眷属围绕。作是观念时，","level":0,"quote":true},{"t":"诵本尊密语，一一遍谛观，","level":0,"quote":true},{"t":"从自成佛身，遍体毛孔中，","level":0,"quote":true},{"t":"等流出一切，世界微尘数。","level":0,"quote":true},{"t":"如来身舒遍，尽诸有情界，","level":0,"quote":true},{"t":"拔济利安乐，为转正法轮，","level":0,"quote":true},{"t":"现神通游戏，摧伏一切魔，","level":0,"quote":true},{"t":"令现证悉地，悦意受用等，","level":0,"quote":true},{"t":"还来入自身，住三摩地念。","level":0,"quote":true},{"t":"乃至疲倦已，或百八七三，","level":0,"quote":true},{"t":"复结胜身印，诵三字密言，","level":0,"quote":true},{"t":"三七随所宜。即取菩提珠，","level":0,"quote":true},{"t":"盘置合掌内，当心诵密语。","level":0,"quote":true},{"t":"菩提心密语，三遍或七遍，","level":0,"quote":true},{"t":"捧珠安顶上，诵金刚语心：","level":0,"quote":true},{"t":"「raṃ","level":0},{"t":"由以此密语，加持念珠故，","level":0,"quote":true},{"t":"所诵尊密语，掐一珠过已。","level":0,"quote":true},{"t":"一成一千遍，二手当心前，","level":0,"quote":true}],[{"t":"各撮聚五指，从母初珠起。","level":0,"quote":true},{"t":"一诵掐一遍，与密言齐平，","level":0,"quote":true},{"t":"至母珠却回，不应越母珠，","level":0,"quote":true},{"t":"蓦过越法罪。万千或百八，","level":0,"quote":true},{"t":"一数为常定，不应有增减，","level":0,"quote":true},{"t":"数限既终毕，还捧合加持，","level":0,"quote":true},{"t":"放置於净处，敬珠由如佛，","level":0,"quote":true},{"t":"不应轻弃触。《瑜伽珠经》云：","level":0,"quote":true},{"t":"「珠表菩萨果，中绝为断漏，","level":0,"quote":true},{"t":"线贯表观音，母为弥陀佛。」","level":0,"quote":true},{"t":"以是不应越。由珠积功德，","level":0,"quote":true},{"t":"速获成就故。次陈前供养，","level":0,"quote":true},{"t":"复结智拳印，入前三摩地，","level":0,"quote":true},{"t":"观念於一字，思惟其字义。","level":0,"quote":true},{"t":"诸法本无坏，无尘亦无染，","level":0,"quote":true},{"t":"清净如虚空，清净如空故。","level":0,"quote":true},{"t":"一切法无坏，诸法不坏故。","level":0,"quote":true},{"t":"一切法本净，诸法本净故。","level":0,"quote":true},{"t":"一切法无染，诸法非染故。","level":0,"quote":true},{"t":"空净不可得，观字义相应，","level":0,"quote":true},{"t":"心缘住於理，不缘於其字。","level":0,"quote":true},{"t":"同一体清净，遍周於法界，","level":0,"quote":true},{"t":"获得无戏论，轮王实相定。","level":0,"quote":true},{"t":"乃至於一念，净心相应故，","level":0,"quote":true},{"t":"获无上正智，无始积罪障，","level":0,"quote":true},{"t":"顿灭无有餘，十方诸如来，","level":0,"quote":true},{"t":"本尊皆现前，满所希求愿。","level":0,"quote":true},{"t":"世间出世间，一切皆与思，","level":0,"quote":true},{"t":"乃至於现生，成就本尊身。","level":0,"quote":true},{"t":"复结身胜印，诵三字密言，","level":0,"quote":true},{"t":"即观菩提心，思惟阿字门。","level":0,"quote":true},{"t":"诸法本不生，每作观念时，定慧应俱运，且如观婀字，才观即了知。诸法本不生，知本不生故，是名奢摩地。","level":0,"quote":true},{"t":"谛观於字体，是毘婆舍那，","level":0,"quote":true},{"t":"此名为双运，诸观皆如是。","level":0,"quote":true},{"t":"又结胜身印，於心额喉顶，","level":0,"quote":true},{"t":"各一掣印开，诵此解脱心：","level":0,"quote":true},{"t":"「bhrūṃ","level":0},{"t":"由此印密言，圣众得离缚，","level":0,"quote":true},{"t":"各归於本宫，修习瑜伽者，","level":0,"quote":true},{"t":"至於解脱地。复结佛眼印，","level":0,"quote":true},{"t":"诵佛母密言，如前加持身。","level":0,"quote":true},{"t":"又用本部中，无能胜明王，","level":0,"quote":true},{"t":"密言印自身，五处如前法。","level":0,"quote":true},{"t":"八指右指左，掌内各交合，","level":0,"quote":true},{"t":"大指开微屈，少离头指侧。","level":0,"quote":true},{"t":"诵此心密言：","level":0,"quote":true},{"t":"「huṃ","level":0},{"t":"由作此加持，於一切时处，","level":0,"quote":true},{"t":"魔冤不能侵，虎狼诸毒虫，","level":0,"quote":true},{"t":"恶心人非人，尽无能陵屈。","level":0,"quote":true},{"t":"如来初成佛，於菩提树下，","level":0,"quote":true},{"t":"以此印密言，摧坏天魔军。","level":0,"quote":true},{"t":"若入便易处，用触身忿怒，","level":0,"quote":true},{"t":"乌刍瑟摩印，右手如常拳，","level":0,"quote":true},{"t":"翘大指加持，五处如先说。","level":0,"quote":true},{"t":"诵此心密言：","level":0,"quote":true},{"t":"「oṃ　ṭru　ka","level":0},{"t":"由作此加持，入一切秽处，","level":0,"quote":true},{"t":"魔障不得便。次明念诵时，","level":0,"quote":true},{"t":"瑜伽教王中，如来所称赞，","level":0,"quote":true},{"t":"无有时方处。当知不令间，","level":0,"quote":true},{"t":"四时或三时，二时乃至一。","level":0,"quote":true},{"t":"无间一切时，三谓晨午昏，","level":0,"quote":true},{"t":"加夜半成四，二时谓晨暮。","level":0,"quote":true},{"t":"一时随得暇，从初乃至终，","level":0,"quote":true},{"t":"皆依此仪轨。或无坛净室，","level":0,"quote":true},{"t":"随处作念诵，先当观囕字，","level":0,"quote":true},{"t":"净身及净处，安字於顶上，","level":0,"quote":true},{"t":"发智火焚烧，身处无灰烬。","level":0,"quote":true},{"t":"清净如虚空。才住此三昧，","level":0,"quote":true},{"t":"百劫积重罪，一念顿荡除。","level":0,"quote":true},{"t":"夫人三摩地，不计身心相，","level":0,"quote":true},{"t":"及分别色等，但谛观一境。","level":0,"quote":true},{"t":"由是法加持，净二界空空，","level":0,"quote":true},{"t":"即於虚空中，观婀字成殿。","level":0,"quote":true},{"t":"如忉利天宫。又於宝殿内，","level":0,"quote":true},{"t":"如前初观念，婀字成心月，","level":0,"quote":true},{"t":"次第不复殊，是佛不空体。","level":0,"quote":true},{"t":"所疑不净者，皆观览字焚，","level":0,"quote":true},{"t":"由此法界心，密言威力故，","level":0,"quote":true},{"t":"所净如法界。当知囕字义，","level":0,"quote":true},{"t":"所谓一切法，本净无垢染，","level":0,"quote":true},{"t":"诸法清净故，净染不可得。","level":0,"quote":true},{"t":"阿字菩提心，种智之本源，","level":0,"quote":true},{"t":"是一切字母。十方三世佛，","level":0,"quote":true},{"t":"所说一切法，无非此字体，","level":0,"quote":true},{"t":"才念即同称，一切如来法。","level":0,"quote":true},{"t":"於眼观此字，即能成天眼，","level":0,"quote":true},{"t":"餘四悉具足，诸根例可知。","level":0,"quote":true},{"t":"乃至於铁石，安布谛观念，","level":0,"quote":true},{"t":"能动及成金。此性成密言，","level":0,"quote":true},{"t":"三世佛法教，皆广明此字。","level":0,"quote":true},{"t":"其义说难穷，粗陈其大略，","level":0,"quote":true},{"t":"所谓餘诸字，皆瞻於梵字，","level":0,"quote":true},{"t":"非是随方文。念诵既终毕，","level":0,"quote":true},{"t":"回於其福聚，普令诸有情，","level":0,"quote":true},{"t":"如我无有异。复敬礼三宝，","level":0,"quote":true},{"t":"悔喜劝请向，出外转大乘，","level":0,"quote":true},{"t":"乃至一四句。印塔修众善，","level":0,"quote":true},{"t":"以此积福业，加持资粮故，","level":0,"quote":true},{"t":"悉地速现前。又演略仪轨，","level":0,"quote":true},{"t":"如先诵婀字，用发菩提心，","level":0,"quote":true},{"t":"左趺押右股，右足安左股，","level":0,"quote":true},{"t":"是如来结跏。即结智拳印，","level":0,"quote":true},{"t":"身胜及灌顶。拍掌已又陈，","level":0,"quote":true},{"t":"金刚合掌仪。诵唵字供养，","level":0,"quote":true},{"t":"又部母加持，住智拳念诵，","level":0,"quote":true},{"t":"终毕如前仪。又说略仪轨，","level":0,"quote":true},{"t":"先用一切佛，部心印密言，","level":0,"quote":true},{"t":"印五处或四。其印以八指，","level":0,"quote":true},{"t":"右押左相叉，交合於掌内，","level":0,"quote":true},{"t":"并竖二大指，著右头指侧，","level":0,"quote":true},{"t":"诵一切佛心：","level":0,"quote":true},{"t":"「oṃ　jī　na　ji","level":0},{"t":"适以印此明，加持自身时，","level":0,"quote":true},{"t":"便同诸佛身，即部母加持。","level":0,"quote":true},{"t":"作智拳念诵，坐如前全跏，","level":0,"quote":true},{"t":"或作轮王坐，交脚或垂一，","level":0,"quote":true},{"t":"乃至独膝竖，轮王三种坐。","level":0,"quote":true},{"t":"或作普贤跏，左掌承右腿，","level":0,"quote":true},{"t":"右趺镇左髀，普贤跏乃成。","level":0,"quote":true},{"t":"是等坐随意，即金刚合掌，","level":0,"quote":true},{"t":"诵唵字供养，数限毕复陈。","level":0,"quote":true},{"t":"智拳诵一字，昼用部心印，","level":0,"quote":true},{"t":"夜以佛眼印，印五处作护。","level":0,"quote":true},{"t":"复次又开演，极略念诵仪，","level":0,"quote":true},{"t":"为修瑜伽者，不好乐多法，","level":0,"quote":true},{"t":"或众世务迫，用广法恐阙。","level":0,"quote":true},{"t":"先结智拳印，即胜身加持，","level":0,"quote":true},{"t":"次陈供养仪，即便作念诵，","level":0,"quote":true},{"t":"亦无所阙少。若更极驱迫，","level":0,"quote":true},{"t":"恐间阙时分，但作智拳印，","level":0,"quote":true},{"t":"诵本尊密言，七遍或三遍，","level":0,"quote":true},{"t":"即任行住坐，随意作念诵。","level":0,"quote":true},{"t":"若执珠记数，一百八未满，","level":0,"quote":true},{"t":"中间不应语。若要语当观，","level":0,"quote":true},{"t":"囕字於舌上，纵语不为间。","level":0,"quote":true},{"t":"或唯结身胜，大三摩耶印，","level":0,"quote":true},{"t":"便念诵亦得，支分皆不阙。","level":0,"quote":true},{"t":"何故此二印，独用成具法？","level":0,"quote":true},{"t":"以才结智拳，能摄诸如来，","level":0,"quote":true},{"t":"入住处随顺，胜身三麼耶。","level":0,"quote":true},{"t":"适结此印时，一切印已成，","level":0,"quote":true},{"t":"十方三世佛，所说之密印，","level":0,"quote":true},{"t":"尽在此印中。又一切如来，","level":0,"quote":true},{"t":"同一聚密合，成此一法身，","level":0,"quote":true},{"t":"更无有二相。诸佛皆随喜，","level":0,"quote":true},{"t":"菩萨咸敬奉，天龙人非人，","level":0,"quote":true},{"t":"摄伏而归命。由如是义故，","level":0,"quote":true},{"t":"不待诸印助，一成一切印。","level":0,"quote":true},{"t":"若如常念诵，当依广仪轨，","level":0,"quote":true},{"t":"不应执此义，而生懈怠心。","level":0,"quote":true},{"t":"我於诸瑜伽，大秘密经中，","level":0,"quote":true},{"t":"搜括至纲要，略集金轮王，","level":0,"quote":true},{"t":"速成佛理趣，瑜伽仪轨竟。","level":0,"quote":true},{"t":"一字顶轮王瑜伽念诵仪轨一卷","level":0},{"t":"长宽三秊五月十三日","level":0,"quote":true},{"t":"於劝修寺西明院书了范乘","level":0,"quote":true},{"t":"一交了","level":0,"quote":true}]]