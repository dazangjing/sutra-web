[[{"t":"榑桑国藏古袈裟图","level":0},{"t":"释弘一","level":0},{"t":"依三宝物具钞古本写。原图尺寸有不正确处、皆未改正、冀存古本之旧形。其中图形、不尽与别记尺寸符合、唯可见其大略。又<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01252.gif\" alt=\"𢂁\" title=\"𢂁\" />纽应安帖角中间、乃适宜也。","level":0},{"t":"丁丑八月十日居齐州湛山并记","level":0},{"t":"榑桑国圣德太子（当此土隋代）亲护粪扫郁多罗僧图","level":0},{"t":"法隆寺藏衣","level":0},{"t":"高井田寺写图","level":0},{"t":"<img src=\"asset://figures/G/G104p0585_01.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"题辞(略录)","level":0},{"t":"（前略）粤宝历六年（此土清乾隆二十一年）丙子四月、亲验此衣。其制造缝缀、事事合符毗尼、同辙经论。加之三道刺缘、信义净寄归之梵仪。四角押万、□南山感通之天说。叶缘齐序、明暗相当。<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01252.gif\" alt=\"𢂁\" title=\"𢂁\" />纽得处、马齿精缝。谓之决律藏残缺、发新学迷朦也、亦宜矣。此衣陈故财体、断为三四段。叶缘处处残坏、帖角唯餘一处、𫄧𫄟色脱、<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01252.gif\" alt=\"𢂁\" title=\"𢂁\" />失纽断。今举一隅复三隅、推右例左、亦足徵而得其正。阙疑於不可识、假令律文可徵、不敢妄以彼补此、所以<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01252.gif\" alt=\"𢂁\" title=\"𢂁\" />纽不加也。","level":0},{"t":"财体、布绢𫄟䌷等杂刺。缘、三道却刺。里、安著餘物总三重。","level":0,"quote":true},{"t":"押叶、马齿缝。帖角、押万字。","level":0,"quote":true},{"t":"短条纵一尺二寸四分餘。长条纵一尺九寸八分餘。上二并横一尺四寸四分餘。","level":0,"quote":true},{"t":"缘叶广狭相当二寸五分许。帖角方三寸九分半。<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01252.gif\" alt=\"𢂁\" title=\"𢂁\" />纽处帖方二寸半许。","level":0,"quote":true},{"t":"总合得长八尺六寸餘。广四尺七寸餘。","level":0,"quote":true},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01252.gif\" alt=\"𢂁\" title=\"𢂁\" />　古本又作钩、絇。","level":0},{"t":"榑桑国旧藏白<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00626.gif\" alt=\"㲲\" title=\"㲲\" />郁多罗僧图","level":0},{"t":"法隆寺藏衣","level":0},{"t":"彼寺传称。达磨大师西来、见南岳慧思禅师、告之云。汝□生东方日本国、弘通正法、救济群生。因付此衣为信。后圣德太子遣使臣妹子(人名)至隋取还。即此衣也。","level":0},{"t":"高井田寺写图","level":0},{"t":"<img src=\"asset://figures/G/G104p0586_01.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"缘、二道却刺。","level":0},{"t":"押叶、一道缝。","level":0},{"t":"木兰色、近口赤。","level":0},{"t":"短条纵一尺一寸许。","level":0,"quote":true},{"t":"横一尺五寸半许为中条、","level":0,"quote":true},{"t":"一尺二寸许为餘条。","level":0,"quote":true},{"t":"长条纵二尺一寸许。","level":0,"quote":true},{"t":"横准短条量。","level":0,"quote":true},{"t":"缘叶相当广三寸许。","level":0,"quote":true},{"t":"四角帖方三寸半。","level":0,"quote":true},{"t":"后纽处帖三寸半弱。","level":0,"quote":true},{"t":"纽、中折安之、当心去一寸二分为结。(原图不正确、别绘如右、以资参考。)","level":0,"quote":true},{"t":"一边条二尺六寸五分、一边条二尺三寸。但取量於当心。","level":0,"quote":true},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01252.gif\" alt=\"𢂁\" title=\"𢂁\" />处帖二寸半强。","level":0,"quote":true},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01252.gif\" alt=\"𢂁\" title=\"𢂁\" />长七寸、中折刺著两端、於当心去四分为结、即成两<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01252.gif\" alt=\"𢂁\" title=\"𢂁\" />。","level":0,"quote":true},{"t":"总合长七尺二寸许、","level":0,"quote":true},{"t":"广四尺五寸许。","level":0,"quote":true},{"t":"㊉今案此处、依彼文所示、应畫此图。<img src=\"asset://figures/G/G104p0586_02.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0},{"t":"於里（即背面）应畫此图。<img src=\"asset://figures/G/G104p0586_03.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0},{"t":"（此图、依古本、误畫於前粪扫衣上。今详考、前衣不应畫<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01252.gif\" alt=\"𢂁\" title=\"𢂁\" />纽。若移置於此、则符合矣。）","level":0},{"t":"榑桑国旧藏鉴真律师九条衣（鉴真、为唐扬州大明寺僧。玄宗天宝十年、渡榑桑、为彼邦律宗始祖。）","level":0},{"t":"<img src=\"asset://figures/G/G104p0587_01.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"财体白<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00626.gif\" alt=\"㲲\" title=\"㲲\" />。色木兰。缘二道却刺。押叶鸟足类缝。","level":0,"quote":true},{"t":"总横七尺三寸七分、竖三尺二寸二分五。","level":0,"quote":true},{"t":"榑桑国旧藏鉴真律师七条衣（此衣制法、可依上类推、故不畫出。）","level":0},{"t":"<img src=\"asset://figures/G/G104p0587_02.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true},{"t":"同上总横七尺五寸、　竖三尺一寸八分。","level":0,"quote":true},{"t":"上二衣唐招提寺藏老比丘宝静写图　(文化四年写)","level":0,"quote":true},{"t":"已上所记尺量、未明应用何尺。今以意度之、或是用日本尺量。附绘五寸如下。","level":0},{"t":"<img src=\"asset://figures/G/G104p0587_03.gif\" alt=\"\" loading=\"lazy\" decoding=\"async\" />","level":0,"img":true}]]