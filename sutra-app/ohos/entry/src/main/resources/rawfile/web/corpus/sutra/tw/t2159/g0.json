[[{"t":"傳教大師將來台州錄日本 最澄撰","level":0},{"t":"No. 2159傳教大師將來目錄傳教大師將來目錄","level":0}],[{"t":"刻根本大師將來錄序","level":3},{"t":"大師入唐求法目錄有二本。其一則記於台州所得經疏名目。謂之圓宗錄。其一則記於越州所受密典名數。謂之越府錄。越府錄有元祿年間印本。而文字紕訛不正。今因就橫川松禪院所藏大師真筆。以摸出之。其圓宗錄元龜之亂散失。不知所在。故就正二位前權大納言宗建卿所藏寫本。以錄出之。且挍以東寺觀智院所藏寬治五年寫本。遂并上木。翼傳之萬世。以備法門盛典云爾。文政四年辛巳大師千年遠忌之初夏叡嶽新探題權僧正真超識進官錄上表進官錄上表沙門最澄言。最澄聞。六爻探<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07411.gif\" alt=\"𧷤\" title=\"𧷤\" />局於生滅之場。百物正名未涉真如之境。豈若隨他權教開三乘於機門。隨自實教示一乘於道場哉。然則。圓教難說。演其義者天台。妙法難傳。暢其道者聖帝。伏惟陛下。纂靈出震。撫運登極。北蕃來朝請賀正於每年。東夷北首知歸德於先年。於是。屬想圓宗緬懷一乘。紹宣妙法以為大訓。由是。妙圓極教。應聖機而興顯。灌頂祕法。感皇緣而圓滿。最澄奉使求法。遠尋靈蹤。往登台嶺。躬寫教迹。所獲經并疏及記等。總二百三十部四百六十卷。且見進經一十卷。名曰金字妙法蓮華經七卷。金字金剛般若經一卷。金字菩薩戒經一卷。金字觀無量壽經一卷。及天台智者大師靈應圖一張。天台大師禪鎮一頭。天台山香爐峯送檉及柏木文釋四枚。說法白角如意一抦。謹遣弟子藏經奉進。但聖鑑照明二門圓滿。不任誠懇之至。奉表戰慄謹言。延曆二十四年七月十五日　沙門最澄上表","level":0},{"t":"傳教大師將來台州錄","level":0},{"t":"傳教大師將來台州錄最澄等勘定疏記目錄日本國求法僧最澄等勘定合疏記等壹佰貳","level":0,"quote":true},{"t":"部貳佰肆拾卷之中","level":0,"quote":true},{"t":"妙法蓮華經玄義十卷","level":0,"quote":true},{"t":"妙法蓮華經玄義釋十卷","level":0,"quote":true},{"t":"妙法蓮華經文句疏十卷","level":0,"quote":true},{"t":"妙法蓮華經文句疏記十卷","level":0,"quote":true},{"t":"妙法蓮華經觀音品義一卷","level":0,"quote":true},{"t":"妙法蓮華經觀音品義疏二卷","level":0,"quote":true},{"t":"妙法蓮華經科文二卷","level":0,"quote":true},{"t":"妙法蓮華經觀音品偈科文一卷","level":0,"quote":true},{"t":"妙法蓮華經大意一卷","level":0,"quote":true},{"t":"妙法蓮華經文句序一卷","level":0,"quote":true},{"t":"妙法蓮華經懺法一卷","level":0,"quote":true},{"t":"妙法蓮華經三昧補助儀一卷","level":0,"quote":true},{"t":"妙法蓮華經大意一卷","level":0,"quote":true},{"t":"妙法蓮華經玄義科文一卷","level":0,"quote":true},{"t":"妙法蓮華經文句疏科文一卷","level":0,"quote":true},{"t":"已上一十一部一十三卷同帙　法華部","level":0,"quote":true},{"t":"。","level":0,"quote":true},{"t":"摩訶止觀十卷","level":0,"quote":true},{"t":"摩訶止觀補行傳弘決十卷","level":0,"quote":true},{"t":"摩訶止觀文句二卷","level":0,"quote":true},{"t":"摩訶止觀義例二卷","level":0,"quote":true},{"t":"摩訶止觀心要一卷","level":0,"quote":true},{"t":"摩訶止觀音一卷","level":0,"quote":true},{"t":"摩訶止觀略音一卷","level":0,"quote":true},{"t":"摩訶止觀大意一卷","level":0,"quote":true},{"t":"摩訶止觀八教大意一卷","level":0,"quote":true},{"t":"摩訶止觀