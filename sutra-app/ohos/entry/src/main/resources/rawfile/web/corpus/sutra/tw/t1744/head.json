{"id":"t1744","title":"勝鬘寶窟","titleTrad":"勝鬘寶窟","byline":"隋 吉藏撰","bylineLabel":"著者·译者","dynasty":"","division":"经疏部","canon":"T1744","canonName":"大正藏","volume":"T1744","juanCount":3,"textLength":168302,"imageCount":0,"summary":"","tags":["经疏部","大正藏"],"order":1129,"guide":"","chunks":4,"toc":[{"level":2,"text":"為廣，開一題成一部；括廣為略，卷一"},{"level":3,"text":"結集，在於後代。宗歸雖一，須立二序。但二序"},{"level":3,"text":"量所解接化分。若就二序明義，上來證信序"}],"chunksPerFile":20}