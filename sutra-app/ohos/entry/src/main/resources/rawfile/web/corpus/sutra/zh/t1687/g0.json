[[{"t":"事师法五十颂(马鸣菩萨集)","level":0},{"t":"西天译经三藏朝散大夫试鸿胪少卿宣梵大师赐紫沙门臣日称等奉　诏译","level":0},{"t":"依诸经律秘密教，略出承事师仪轨，","level":0,"quote":true},{"t":"闻已爱乐发净心，当获如来金刚智。","level":0,"quote":true},{"t":"若於灌顶师，三时伸礼奉，","level":0,"quote":true},{"t":"则为已供养，十方诸如来。","level":0,"quote":true},{"t":"起最上恭敬，合掌以持花，","level":0,"quote":true},{"t":"散彼曼挐罗，头面接足礼。","level":0,"quote":true},{"t":"彼师或在家，及新受具戒，","level":0,"quote":true},{"t":"置经像於前，则息诸疑谤。","level":0,"quote":true},{"t":"若出家弟子，常净心承事，","level":0,"quote":true},{"t":"已坐当起迎，唯除於致礼。","level":0,"quote":true},{"t":"彼师及弟子，当互审其器，","level":0,"quote":true},{"t":"若不先观察，同得越法罪。","level":0,"quote":true},{"t":"若忿恚无慈，贪爱多散乱，","level":0,"quote":true},{"t":"慠易恃种族，以惠当拣择。","level":0,"quote":true},{"t":"具戒忍悲智，尊重无谄曲，","level":0,"quote":true},{"t":"了秘密仪范，博闲诸论议，","level":0,"quote":true},{"t":"善达真言相，曼挐罗事业，","level":0,"quote":true},{"t":"契证十真如，诸根悉清净。","level":0,"quote":true},{"t":"若彼求法者，於师生轻毁，","level":0,"quote":true},{"t":"则谤诸如来，常得诸苦恼。","level":0,"quote":true},{"t":"由增上愚痴，而获於现报，","level":0,"quote":true},{"t":"为恶曜执持，重病相缠缚，","level":0,"quote":true},{"t":"王法所逼切，及毒蛇伤螫，","level":0,"quote":true},{"t":"冤贼水火难，非人得其便，","level":0,"quote":true},{"t":"彼频那夜迦，常作诸障碍，","level":0,"quote":true},{"t":"从此而命终，即堕於恶趣。","level":0,"quote":true},{"t":"勿令阿阇黎，少分生烦恼，","level":0,"quote":true},{"t":"无智相违背，定入阿鼻狱，","level":0,"quote":true},{"t":"受种种极苦，说之深可怖。","level":0,"quote":true},{"t":"由谤阿阇黎，於中常止住，","level":0,"quote":true},{"t":"彼阿阇黎者，弘持正法藏，","level":0,"quote":true},{"t":"是故当一心，辄莫生轻毁。","level":0,"quote":true},{"t":"常於阿阇黎，承事而供养，","level":0,"quote":true},{"t":"发生尊重心，则蠲除障恼。","level":0,"quote":true},{"t":"又复於师所，乐行於喜舍，","level":0,"quote":true},{"t":"不恡於己身，何况於财物。","level":0,"quote":true},{"t":"於无量亿劫，勇猛勤修习，","level":0,"quote":true},{"t":"今始证菩提，斯极为希有。","level":0,"quote":true},{"t":"善护其深誓，供养诸如来，","level":0,"quote":true},{"t":"恭敬阿阇黎，等同一切佛。","level":0,"quote":true},{"t":"若於己所有，最上诸珍玩，","level":0,"quote":true},{"t":"求无尽菩提，诚心而奉献。","level":0,"quote":true},{"t":"施佛阿阇黎，念念常增长，","level":0,"quote":true},{"t":"是最胜福田，速得菩提果。","level":0,"quote":true},{"t":"如是求法者，具戒忍功德，","level":0,"quote":true},{"t":"不虚诳於师，当获金刚智。","level":0,"quote":true},{"t":"若足踏师影，获罪如破塔，","level":0,"quote":true},{"t":"於床坐资具，骑蓦罪过是。","level":0,"quote":true},{"t":"若师所教诲，欢喜当听受，","level":0,"quote":true},{"t":"自己或不能，则善言启白。","level":0,"quote":true},{"t":"由依止师故，所作皆成就，","level":0,"quote":true},{"t":"现乐及生天，何敢违其命！","level":0,"quote":true},{"t":"守护师财物，犹若己身命，","level":0,"quote":true},{"t":"於彼执侍人，如亲常敬奉。","level":0,"quote":true},{"t":"不应於师前，覆顶及乘御，","level":0,"quote":true},{"t":"翘足手扠腰，安然而坐卧。","level":0,"quote":true},{"t":"或事缘令坐，勿舒於双足，","level":0,"quote":true},{"t":"常具诸威仪，师起速当起。","level":0,"quote":true},{"t":"若於经行处，不应随举步，","level":0,"quote":true},{"t":"端谨立於傍，无弃於涕涶。","level":0,"quote":true},{"t":"亦勿於师前，私窃而言说，","level":0,"quote":true},{"t":"及隣近语笑，謌舞作唱等。","level":0,"quote":true},{"t":"或令坐或起，各安徐礼敬，","level":0,"quote":true},{"t":"若於险路中，白已作前导。","level":0,"quote":true},{"t":"又不应於前，身现疲劳相，","level":0,"quote":true},{"t":"屈指节作声，倚柱及墙壁。","level":0,"quote":true},{"t":"或浣衣濯足，及澡浴等事，","level":0,"quote":true},{"t":"先白师令知，所作无令见。","level":0,"quote":true},{"t":"又复於师名，不应辄称举，","level":0,"quote":true},{"t":"设有固问者，当示之一字。","level":0,"quote":true},{"t":"师或令干集，当伺其遣使，","level":0,"quote":true},{"t":"於彼所作事，忆持常不忘。","level":0,"quote":true},{"t":"或笑嗽伸<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06900.gif\" alt=\"㰦\" title=\"㰦\" />，则以手遮口，","level":0,"quote":true},{"t":"若有事启闻，当曲躬软语。","level":0,"quote":true},{"t":"若在家女人，净心来听法，","level":0,"quote":true},{"t":"合掌具威仪，专视於师面。","level":0,"quote":true},{"t":"闻已当奉持，舍离於憍慢，","level":0,"quote":true},{"t":"常如初适嫁，低颜其惭<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00718.gif\" alt=\"𧹞\" title=\"𧹞\" />。","level":0,"quote":true},{"t":"於彼严身具，无复生爱乐，","level":0,"quote":true},{"t":"与善非相应，皆思惟远离。","level":0,"quote":true},{"t":"常慕於师德，不应窥小过，","level":0,"quote":true},{"t":"随顺获成就，求过当自损。","level":0,"quote":true},{"t":"说法度弟子，曼拏罗护摩，","level":0,"quote":true},{"t":"城邑同师居，无旨不应作。","level":0,"quote":true},{"t":"或说法所得，净施诸财物，","level":0,"quote":true},{"t":"悉以奉其师，随得而可用。","level":0,"quote":true},{"t":"同学及法裔，不应为弟子，","level":0,"quote":true},{"t":"亦不於师前，受承事礼敬。","level":0,"quote":true},{"t":"若以物上师，二手持奉献，","level":0,"quote":true},{"t":"师或有所施，当恭敬顶受。","level":0,"quote":true},{"t":"自专修正行，常忆持不忘，","level":0,"quote":true},{"t":"他或非律仪，爱语相教示。","level":0,"quote":true},{"t":"若师所教勅，或病缘不作，","level":0,"quote":true},{"t":"当作礼咨陈，斯则无其咎。","level":0,"quote":true},{"t":"常令师欢喜，离诸烦恼事，","level":0,"quote":true},{"t":"当勤而行之，恐繁故不述。","level":0,"quote":true},{"t":"彼金刚如来，亲如是宣说，","level":0,"quote":true},{"t":"及餘教所明，依师获成就。","level":0,"quote":true},{"t":"若弟子清净，能归依三宝，","level":0,"quote":true},{"t":"设使命将终，亦为宣法要，","level":0,"quote":true},{"t":"及授秘密教，令作正法器；","level":0,"quote":true},{"t":"若现相诵持，当获根本罪。","level":0,"quote":true},{"t":"若能随顺师行学，则成一切诸功德，","level":0,"quote":true},{"t":"以我所集斯善因，愿与众生速成佛。","level":0,"quote":true},{"t":"事师法五十颂","level":0}]]