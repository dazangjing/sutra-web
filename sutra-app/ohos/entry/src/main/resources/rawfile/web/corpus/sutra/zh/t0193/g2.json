[[{"t":"应食此地肥。』弟子目揵连，","level":0,"quote":true},{"t":"能以左手举，三千世界地；","level":0,"quote":true},{"t":"置於右掌中，擎著他世界。","level":0,"quote":true},{"t":"一切众生类，无有觉知者，","level":0,"quote":true},{"t":"亦不怀恐怖。如是三千土，","level":0,"quote":true},{"t":"大千之世界，此三千世界，","level":0,"quote":true},{"t":"满中众生类，神力如目连；","level":0,"quote":true},{"t":"比佛身神力，百千万巨亿，","level":0,"quote":true},{"t":"终不得相喻。使十方众生，","level":0,"quote":true},{"t":"神力如缘觉，诸弟子神力，","level":0,"quote":true},{"t":"并佛身神力；以比佛意力，","level":0,"quote":true},{"t":"百千万亿倍，无量不可计；","level":0,"quote":true},{"t":"终不得为喻。」尔时诸力士，","level":0,"quote":true},{"t":"稽首礼佛足，叉手白佛言：","level":0,"quote":true},{"t":"「唯然天中天，已见乳哺力，","level":0,"quote":true},{"t":"福慧神足力，唯说定意力，","level":0,"quote":true},{"t":"解畅其境界。」佛告诸力士：","level":0,"quote":true},{"t":"「乐闻者静听。」「唯然当听受。」","level":0,"quote":true},{"t":"佛告诸力士：「须弥四方域，","level":0,"quote":true},{"t":"诸龙上升天；同时降暴雨，","level":0,"quote":true},{"t":"周遍四天下。是四方大水，","level":0,"quote":true},{"t":"皆流入大海；佛皆别识知，","level":0,"quote":true},{"t":"是诸雨水渧，初堕某方域，","level":0,"quote":true},{"t":"某方某村落，某家某园田；","level":0,"quote":true},{"t":"某树某枝叶，某花某果实。","level":0,"quote":true},{"t":"因流来入海，此四方大域，","level":0,"quote":true},{"t":"一切所有水；佛之定意力，","level":0,"quote":true},{"t":"悉能分别知，诸水渧原由，","level":0,"quote":true},{"t":"所从来方面，是为佛定意。","level":0,"quote":true},{"t":"微妙之神力，前已过去佛，","level":0,"quote":true},{"t":"甫当兴世者，吾今现说法；","level":0,"quote":true},{"t":"一切皆平等，等音等称量，","level":0,"quote":true},{"t":"等德等相好，等诸报应法；","level":0,"quote":true},{"t":"唯二事不等，形体及寿命。","level":0,"quote":true},{"t":"何故二不等？世人寿长时，","level":0,"quote":true},{"t":"人形体长大；佛亦顺世俗，","level":0,"quote":true},{"t":"寿长形体大。末世人寿短，","level":0,"quote":true},{"t":"形体丑短小；佛亦随世俗，","level":0,"quote":true},{"t":"寿短形体小。以故诸佛兴，","level":0,"quote":true},{"t":"以二事不等。」佛告诸力士：","level":0,"quote":true},{"t":"「吾已为汝等，颁宣具解说。","level":0,"quote":true},{"t":"佛之乳哺力，福德智慧力，","level":0,"quote":true},{"t":"神足定意力，是所说诸力。","level":0,"quote":true},{"t":"当於今暮夜，为无常大力，","level":0,"quote":true},{"t":"所击坏碎灭。如是诸人等，","level":0,"quote":true},{"t":"世间归无常；一切有形类，","level":0,"quote":true},{"t":"皆当归别离。坏散灭亡法，","level":0,"quote":true},{"t":"生者归於死，成者必当败，","level":0,"quote":true},{"t":"合者有别离，聚者当各散，","level":0,"quote":true},{"t":"立者必倾堕。」佛为诸力士，","level":0,"quote":true},{"t":"因说要偈言：「有为归无常，","level":0,"quote":true},{"t":"兴起归尽法；诸兴衰自然，","level":0,"quote":true},{"t":"勤求寂灭安。有为归无常，","level":0,"quote":true},{"t":"兴起归尽法；佛最第一尊，","level":0,"quote":true},{"t":"寿亦有终尽。於是短寿命，","level":0,"quote":true},{"t":"如梦忽便过；自纵不勤学，","level":0,"quote":true},{"t":"是愚可愍伤。譬如山水峻，","level":0,"quote":true},{"t":"速往终不返；人命亦如是，","level":0,"quote":true},{"t":"逝者不复还。如弓之遣箭，","level":0,"quote":true},{"t":"已逝不中返；人命犹如此，","level":0,"quote":true},{"t":"去者不复还。众苦苦起原，","level":0,"quote":true},{"t":"当勤求灭苦；觉八贤圣路，","level":0,"quote":true},{"t":"致吉服甘露。」时佛说是已，","level":0,"quote":true},{"t":"三千大千界，地六返震动；","level":0,"quote":true},{"t":"无数兆姟天，忽舍其宫殿，","level":0,"quote":true},{"t":"测塞虚空中；雨诸天华香，","level":0,"quote":true},{"t":"末金银栴檀；诸天鼓妓乐，","level":0,"quote":true},{"t":"梵天礼佛足，叉手於佛前，","level":0,"quote":true},{"t":"因说此偈言：「诸佛难值见，","level":0,"quote":true},{"t":"正觉意难有；如花优昙钵，","level":0,"quote":true},{"t":"佛又难於此。勇健趋难遇，","level":0,"quote":true},{"t":"人上释师子；与诸天人众，","level":0,"quote":true},{"t":"今故叉手礼。」於时天帝释，","level":0,"quote":true},{"t":"便前礼佛足；长跪於佛前，","level":0,"quote":true},{"t":"因说是颂言：「令我得眼净，","level":0,"quote":true},{"t":"照曜於法炬；闭塞邪趣门，","level":0,"quote":true},{"t":"不畏堕恶路。大慈世之师，","level":0,"quote":true},{"t":"因愍伤众生；故与诸天众，","level":0,"quote":true},{"t":"於前叉手礼。」时六万诸天，","level":0,"quote":true},{"t":"见谛得道迹；礼佛遶三匝，","level":0,"quote":true},{"t":"忽还归天宫。时大会众人，","level":0,"quote":true},{"t":"归命於三尊，佛法贤圣众。","level":0,"quote":true},{"t":"尽毕其寿命，奉戒修十善；","level":0,"quote":true},{"t":"离著出家学，受戒为沙门；","level":0,"quote":true},{"t":"见谛证沟港，往还不还道。","level":0,"quote":true},{"t":"或成无著真，或发缘觉乘；","level":0,"quote":true},{"t":"发大道意者，无限不可量。","level":0,"quote":true},{"t":"又有众生类，未曾有善本，","level":0,"quote":true},{"t":"始初发道意。无央数众生，","level":0,"quote":true},{"t":"勤摄身口心；念佛天人师，","level":0,"quote":true},{"t":"今当就无为。已见大恐惧，","level":0,"quote":true},{"t":"人身甚难得；其行离众苦，","level":0,"quote":true},{"t":"犹救头上火。因此行众善，","level":0,"quote":true},{"t":"勤行无懈惓；免离众苦恼，","level":0,"quote":true},{"t":"逮无为清凉。","level":0,"quote":true}],[{"t":"佛本行经卷第七","level":2},{"t":"<strong>译者</strong>：宋凉州沙门释宝云译","level":0}],[{"t":"大灭品第二十九","level":3},{"t":"时佛与大众，游至双树林；","level":0,"quote":true},{"t":"梵音告阿难，诣双树敷床。","level":0,"quote":true},{"t":"佛便在绳床，右脇而倚卧；","level":0,"quote":true},{"t":"面向於西方，首北而累足。","level":0,"quote":true},{"t":"时贤善须跋，修仁除躁性；","level":0,"quote":true},{"t":"欲见佛求度，来谓阿难言：","level":0,"quote":true},{"t":"「我觉天人师，时至欲灭度；","level":0,"quote":true},{"t":"故来诣难见，觉知一切法。","level":0,"quote":true},{"t":"今求欲礼觐，云何尽苦原？","level":0,"quote":true},{"t":"今若不及见，如日入永冥。」","level":0,"quote":true},{"t":"请阿难通入，阿难心烦毒；","level":0,"quote":true},{"t":"便谓须跋言：「今非见师时。」","level":0,"quote":true},{"t":"佛以一切智，彻照应度者；","level":0,"quote":true},{"t":"百福德相貌，慈意视须跋。","level":0,"quote":true},{"t":"佛以柔软音，告语阿难言：","level":0,"quote":true},{"t":"「莫违来现者，吾出世为善。」","level":0,"quote":true},{"t":"须跋得所愿，甚怀喜踊跃；","level":0,"quote":true},{"t":"即往至佛所，果必蒙解脱。","level":0,"quote":true},{"t":"尔时贤须跋，谦敬尊佛德；","level":0,"quote":true},{"t":"倾屈而敬礼，逊辞白世尊：","level":0,"quote":true},{"t":"「前师觉世间，云尊从得道；","level":0,"quote":true},{"t":"己已得解脱，又复度众生。","level":0,"quote":true},{"t":"愿以见开示，傥能蒙觉悟；","level":0,"quote":true},{"t":"故来敬礼尊，不敢称智力。」","level":0,"quote":true},{"t":"佛见须跋来，心怀甚喜敬；","level":0,"quote":true},{"t":"为说以贤圣，示灭苦无为。","level":0,"quote":true},{"t":"时须跋闻之，寻即得解脱；","level":0,"quote":true},{"t":"邪迷意觉悟，逮得解脱道。","level":0,"quote":true},{"t":"本执邪倒见，故从迷生死；","level":0,"quote":true},{"t":"倒见六十二，以是世沈没。","level":0,"quote":true},{"t":"彼尽无有餘，白衣致得道；","level":0,"quote":true},{"t":"漏尽成罗汉，济此无往受。","level":0,"quote":true},{"t":"觉佛所往路，普世缘爱生；","level":0,"quote":true},{"t":"爱渴两俱灭，灭意诸苦结。","level":0,"quote":true},{"t":"觉佛之所说，深正真言教；","level":0,"quote":true},{"t":"以除意染著，心净无餘漏。","level":0,"quote":true},{"t":"觉世之生死，须跋谛思惟；","level":0,"quote":true},{"t":"谓世间断灭，是见眼脱除。","level":0,"quote":true},{"t":"世本归灭亡，意觉如是已；","level":0,"quote":true},{"t":"世间有常见，邪疑霍然除。","level":0,"quote":true},{"t":"彼前所执持，舍是诸倒见；","level":0,"quote":true},{"t":"闻佛真善言，开慈心受持。","level":0,"quote":true},{"t":"因其前世时，所修诸善本；","level":0,"quote":true},{"t":"愿入泥洹城，故速疾解脱。","level":0,"quote":true},{"t":"已得善无为，除冥觉正真；","level":0,"quote":true},{"t":"建立永甘露，除尽诸尘劳。","level":0,"quote":true},{"t":"时见佛世尊，欲舍就灭度；","level":0,"quote":true},{"t":"以慈心视佛，意便起是念：","level":0,"quote":true},{"t":"「我今理不宜，见佛舍寿行；","level":0,"quote":true},{"t":"普世之炬燿，众生所恃怙。","level":0,"quote":true},{"t":"施善於一切，愿我先舍身；","level":0,"quote":true},{"t":"曼佛天中天，未舍寿之顷。」","level":0,"quote":true},{"t":"心善踊无量，起五情投地；","level":0,"quote":true},{"t":"稽首礼佛足，生定意如山。","level":0,"quote":true},{"t":"即时寻速灭，犹如兴大云；","level":0,"quote":true},{"t":"普雨降甘润，灭尽小野火。","level":0,"quote":true},{"t":"佛告勅比丘：「供养须跋身。」","level":0,"quote":true},{"t":"佛末后弟子，度立泥洹城。","level":0,"quote":true},{"t":"因即右脇倚，卧於绳床上；","level":0,"quote":true},{"t":"欲放舍佛身，尽受命之数。","level":0,"quote":true},{"t":"初夜时欲过，星月光明损；","level":0,"quote":true},{"t":"林薮鸟兽寂。佛告诸弟子：","level":0,"quote":true},{"t":"「卿等敬具戒，如尊师炬燿；","level":0,"quote":true},{"t":"吾去世之后，顺从莫违犯。","level":0,"quote":true},{"t":"净摄身口心，舍利求大安；","level":0,"quote":true},{"t":"田役畜乘仆，仓藏园莫为。","level":0,"quote":true},{"t":"无种殖树木，亦莫斩伐伤；","level":0,"quote":true},{"t":"不得为己身，造立垣墙壁。","level":0,"quote":true},{"t":"无仰观历数，合和汤药方；","level":0,"quote":true},{"t":"知时限节食，修己莫望敬。","level":0,"quote":true},{"t":"无身隐短秽，无行呪自活；","level":0,"quote":true},{"t":"无为王者使，无瞻相吉凶。","level":0,"quote":true},{"t":"汝等后当足，衣食疾汤药；","level":0,"quote":true},{"t":"每摄意知足，守限节忍苦。","level":0,"quote":true},{"t":"汝等但能勤，奉持是禁戒；","level":0,"quote":true},{"t":"具戒之根株，相载之泥洹。","level":0,"quote":true},{"t":"从是起定慧，禁戒具谐偶；","level":0,"quote":true},{"t":"守护能备悉，智慧增长益。","level":0,"quote":true},{"t":"除灭诸尘劳，缘是致泥洹；","level":0,"quote":true},{"t":"此言戒印封，因识守戒者。","level":0,"quote":true},{"t":"其戒具不缺，备悉无短少；","level":0,"quote":true},{"t":"彼则清净善，脱尘劳寂灭。","level":0,"quote":true},{"t":"无有禁戒者，彼则无沙门；","level":0,"quote":true},{"t":"因禁戒地立，成沙门善妙。","level":0,"quote":true},{"t":"已立净戒具，心不走诸欲；","level":0,"quote":true},{"t":"勉则制令住，伏使忍不起。","level":0,"quote":true},{"t":"如回牛离苗，纵情念邪者；","level":0,"quote":true},{"t":"差失净禁戒，颠坠大衰耗。","level":0,"quote":true},{"t":"若遇恶贼对，一世受苦身；","level":0,"quote":true},{"t":"随从诸欲者，今世及后世，","level":0,"quote":true},{"t":"具受诸苦毒，故不当从欲；","level":0,"quote":true},{"t":"悦可诸欲者，后必遭大苦。","level":0,"quote":true},{"t":"人不当畏惧，炽火之所烧；","level":0,"quote":true},{"t":"莫畏蛇虺毒，及凶弊恶贼。","level":0,"quote":true},{"t":"害夺人命者，当自畏痴意；","level":0,"quote":true},{"t":"如愚见岩蜜，不顾碎身患。","level":0,"quote":true},{"t":"如无钩醉象，躁跳如猕猴；","level":0,"quote":true},{"t":"心昼夜随欲，莫听随所便。","level":0,"quote":true},{"t":"不灭其心者，身不得休息；","level":0,"quote":true},{"t":"已能调伏心，不邪屈泥洹。","level":0,"quote":true},{"t":"得食如服药，不当起爱憎；","level":0,"quote":true},{"t":"所得方便食，趣愈饥支形。","level":0,"quote":true},{"t":"喻如众蜂集，采花之精味；","level":0,"quote":true},{"t":"以时度施食，无坏人慈敬。","level":0,"quote":true},{"t":"莫烦好施者，莫数役良畜；","level":0,"quote":true},{"t":"好施烦则厌，良畜数役疲。","level":0,"quote":true},{"t":"汝等昼夜勤，方便加建进；","level":0,"quote":true},{"t":"莫自纵睡眠，损耗难得命。","level":0,"quote":true},{"t":"普世死所烧，谁通夜安寐；","level":0,"quote":true},{"t":"怨贼所围遶，恐怖焉得安。","level":0,"quote":true},{"t":"可舍尘劳垢，陈宿久居者；","level":0,"quote":true},{"t":"尘劳盖安寐，觉寐灭尘劳。","level":0,"quote":true},{"t":"惭愧为衣服，璎珞象之钩；","level":0,"quote":true},{"t":"放舍惭愧者，众德善所弃。","level":0,"quote":true},{"t":"执持惭愧者，以故名为人；","level":0,"quote":true},{"t":"强颜不知惭，是名为畜兽。","level":0,"quote":true},{"t":"若节节支解，心不当起乱；","level":0,"quote":true},{"t":"亦莫违禁戒，口发麤犷言。","level":0,"quote":true},{"t":"戒则是忍辱，亦是其强力；","level":0,"quote":true},{"t":"不忍他麤言，终不得解脱。","level":0,"quote":true},{"t":"恚坏法失名，善心悦颜怨；","level":0,"quote":true},{"t":"心毒不当听，令止宿斯须。","level":0,"quote":true},{"t":"诸善之强敌，无过於瞋恚；","level":0,"quote":true},{"t":"捷疾无为喻，毁坏仁禁戒。","level":0,"quote":true},{"t":"居家有爱著，虽恚愆不重；","level":0,"quote":true},{"t":"守戒恚愆重，如冷水出火。","level":0,"quote":true},{"t":"剃头被法衣，执钵行乞食；","level":0,"quote":true},{"t":"威仪以持世，不宜与恚俱。","level":0,"quote":true},{"t":"慢增则善损，居家者尚尔；","level":0,"quote":true},{"t":"况舍家离著，调伏定心者。","level":0,"quote":true},{"t":"中平正真法，不与邪伪合；","level":0,"quote":true},{"t":"正法建善事，邪伪者虚欺。","level":0,"quote":true},{"t":"积财圣忧恼，少欲者离苦；","level":0,"quote":true},{"t":"是故吾弟子，少求增众善。","level":0,"quote":true},{"t":"卿等当知足，尔乃心安定；","level":0,"quote":true},{"t":"知足人间乐，无厌生天苦。","level":0,"quote":true},{"t":"饶财无厌贫，财贪知足富；","level":0,"quote":true},{"t":"无厌贫驰骋，知足者所怜。","level":0,"quote":true},{"t":"欲求解脱者，莫依众愦閙；","level":0,"quote":true},{"t":"天帝释以下，敬礼独静者。","level":0,"quote":true},{"t":"卿等除亲爱，亲爱苦止宿；","level":0,"quote":true},{"t":"舍家恋亲爱，如老象没泥。","level":0,"quote":true},{"t":"志意勇进者，众事无疑难；","level":0,"quote":true},{"t":"水性彻柔弱，渐渧能穿石。","level":0,"quote":true},{"t":"钻火数休息，不能得致火；","level":0,"quote":true},{"t":"勤钻寻致火，精进者谐偶。","level":0,"quote":true},{"t":"故当建精进，趣向泥洹门；","level":0,"quote":true},{"t":"邪违无为道，汝等慎莫为。","level":0,"quote":true},{"t":"守志不错乱，众邪不得下；","level":0,"quote":true},{"t":"守志沙门友，失志忘众善。","level":0,"quote":true},{"t":"志被钾仗备，敌莫能得胜；","level":0,"quote":true},{"t":"心专服德铠，尘劳无能胜。","level":0,"quote":true},{"t":"专精定意者，谛了世生死；","level":0,"quote":true},{"t":"是故当定意，意定苦不起。","level":0,"quote":true},{"t":"若欲度流水，因桥梁浮材；","level":0,"quote":true},{"t":"欲度一切苦，定意第一舡。","level":0,"quote":true},{"t":"卿等慧离者，今故显世法；","level":0,"quote":true},{"t":"有是则得度，法外者不爱。","level":0,"quote":true},{"t":"不谓为舍家，铠良药利器；","level":0,"quote":true},{"t":"舟船度流江，智慧度生死。","level":0,"quote":true},{"t":"是故常听法，当从法言教；","level":0,"quote":true},{"t":"慧见者见正，无慧者盲冥。","level":0,"quote":true},{"t":"心与尘劳俱，终不得解脱；","level":0,"quote":true},{"t":"审欲求度者，勤除去尘劳。","level":0,"quote":true},{"t":"沙门学调心，除去放逸意；","level":0,"quote":true},{"t":"天帝心调乐，阿须伦无乐。","level":0,"quote":true},{"t":"吾教汝等善，卿等当勤修；","level":0,"quote":true},{"t":"广设众方便，便令至泥洹。","level":0,"quote":true},{"t":"静寂山岩间，林薮空闲舍；","level":0,"quote":true},{"t":"於中学定意，吾去后莫恨。","level":0,"quote":true},{"t":"良医尽方术，合和若干药；","level":0,"quote":true},{"t":"病者服得瘳，医不自还服。","level":0,"quote":true},{"t":"导师引导正，从者无忧患；","level":0,"quote":true},{"t":"违失者有损，不顾虑患故。","level":0,"quote":true},{"t":"吾已为汝等，敷演四正谛；","level":0,"quote":true},{"t":"怀疑者便问，今正是其时。」","level":0,"quote":true},{"t":"时佛令如是，弟子默无言；","level":0,"quote":true},{"t":"阿那律知念，於大众中曰：","level":0,"quote":true},{"t":"「日可令凉冷，月可使炎热；","level":0,"quote":true},{"t":"是四谛真正，终不可违故。","level":0,"quote":true},{"t":"苦谛苦所逼，终爱则有苦；","level":0,"quote":true},{"t":"诸佛之所说，灭尽谛灭爱。","level":0,"quote":true},{"t":"甘露八正道，寂灭为泥洹；","level":0,"quote":true},{"t":"觉是沙门众，佛后末度厄。","level":0,"quote":true},{"t":"众会未度者，初入道老少；","level":0,"quote":true},{"t":"佛粗说罗汉，如冥电照道。","level":0,"quote":true},{"t":"其已得解脱，度於生死者；","level":0,"quote":true},{"t":"众共怀悲恨，师灭一何速。」","level":0,"quote":true},{"t":"佛闻阿那律，如是正谛语；","level":0,"quote":true},{"t":"欲坚众生意，慈悲说是言：","level":0,"quote":true},{"t":"「假令有劫寿，必当终归尽；","level":0,"quote":true},{"t":"吾以具施善，何用长寿为？","level":0,"quote":true},{"t":"世间及天上，吾所应度者；","level":0,"quote":true},{"t":"半度半示道，转教法得住。","level":0,"quote":true},{"t":"汝等当觉制，不足追念吾；","level":0,"quote":true},{"t":"但勤说方便，莫遭离别痛。","level":0,"quote":true},{"t":"以慧灯除冥，觉世无牢强；","level":0,"quote":true},{"t":"垂终心怀悦，犹如重患除。","level":0,"quote":true},{"t":"慧者脱凶衰，远离弊恶人；","level":0,"quote":true}],[{"t":"得舍是二患，何缘得怀忧。","level":0,"quote":true},{"t":"汝等勤修善，一切次当死；","level":0,"quote":true},{"t":"吾入泥洹城，时今已近到。","level":0,"quote":true},{"t":"於是舍寿行，是吾末后言。」","level":0,"quote":true},{"t":"佛於是思惟，第一离欲禅，","level":0,"quote":true},{"t":"从第一禅起，思惟第二禅，","level":0,"quote":true},{"t":"如是历四禅；如是周遍历，","level":0,"quote":true},{"t":"往返於九禅，逆顺尽端绪；","level":0,"quote":true},{"t":"世尊天中天，还至第一禅。","level":0,"quote":true},{"t":"从第一禅起，重思至四禅；","level":0,"quote":true},{"t":"佛时审谛思，逆顺历禅观。","level":0,"quote":true},{"t":"又还从是起，微震动其意；","level":0,"quote":true},{"t":"然后舍寿行，奄入泥洹城。","level":0,"quote":true},{"t":"佛适舍寿行，地六返震动；","level":0,"quote":true},{"t":"空中有大炬，如劫尽烧火。","level":0,"quote":true},{"t":"四方有大火，犹如阿修罗；","level":0,"quote":true},{"t":"烧天林树泽，名曰爱尽乐。","level":0,"quote":true},{"t":"暴雨雹其尘，电光如吐炎；","level":0,"quote":true},{"t":"普世如大火，雷震甚可畏。","level":0,"quote":true},{"t":"卒暴尘雾风，折树崩山岩；","level":0,"quote":true},{"t":"犹如劫尽风，所摧伤无限。","level":0,"quote":true},{"t":"白日无精光，星月暗不明；","level":0,"quote":true},{"t":"日月俱失光，譬如泥所涂。","level":0,"quote":true},{"t":"日月虽俱照，黤黮不精明；","level":0,"quote":true},{"t":"莫能识东西，昼夜不可知。","level":0,"quote":true},{"t":"世尊冥所覆，江河皆逆流；","level":0,"quote":true},{"t":"佛树侧双林，忧感花零落。","level":0,"quote":true},{"t":"江河水皆热，犹如沸釜汤；","level":0,"quote":true},{"t":"双树为之萎，屈覆世尊身。","level":0,"quote":true},{"t":"五头大龙王，悲痛身放缓；","level":0,"quote":true},{"t":"或闷热视佛，啼哭眼皆赤。","level":0,"quote":true},{"t":"即时吐热气，欝毒不可言；","level":0,"quote":true},{"t":"烧热其咽喉，如吐心重患。","level":0,"quote":true},{"t":"观世都无常，自谏强除忧；","level":0,"quote":true},{"t":"自意王将从，念法制啼泣。","level":0,"quote":true},{"t":"净居诸天子，解道心调定；","level":0,"quote":true},{"t":"寂然不啼泣，愍世或起灭。","level":0,"quote":true},{"t":"第一执乐神，龙王大力神；","level":0,"quote":true},{"t":"爱重法天神，悲感塞虚空。","level":0,"quote":true},{"t":"普为忧所覆，周慞走哀动；","level":0,"quote":true},{"t":"杂类之大声，遍满於世间。","level":0,"quote":true},{"t":"魔已得其愿，及恶兵属喜；","level":0,"quote":true},{"t":"舞调雷震鼓，种种放洪声。","level":0,"quote":true},{"t":"大叫传令言：「吾主强敌亡，","level":0,"quote":true},{"t":"自今谁复能，越其境界者？」","level":0,"quote":true},{"t":"佛德树崩堕，如大象牙折；","level":0,"quote":true},{"t":"如高山岩摧，如大牛角脱。","level":0,"quote":true},{"t":"佛今舍身寿，世间诸天人；","level":0,"quote":true},{"t":"无所复归仰，失恃怙如是。","level":0,"quote":true},{"t":"如虚空无日，如国失仓藏；","level":0,"quote":true},{"t":"如华池被霜，众华皆摧伤。","level":0,"quote":true},{"t":"世尊舍躯命，寂潜於泥洹；","level":0,"quote":true},{"t":"一切有形类，莫不失精荣。","level":0,"quote":true}],[{"t":"佛本行经叹无为品第三十","level":3},{"t":"於时从空中，天宝宫照耀；","level":0,"quote":true},{"t":"驾以千象车，悬虚而在上；","level":0,"quote":true},{"t":"敬心熟视佛，舍命卧身形；","level":0,"quote":true},{"t":"怀感而悲叹，因说是辞曰：","level":0,"quote":true},{"t":"「处在大生死，一切皆无常；","level":0,"quote":true},{"t":"始生现兴盛，卒衰损灭亡。","level":0,"quote":true},{"t":"回旋向所乐，便生种种苦；","level":0,"quote":true},{"t":"都灭尽诸苦，无为第一快。","level":0,"quote":true},{"t":"生死杂种薪，烧令无有餘；","level":0,"quote":true},{"t":"慧炎德称烟，流遍天世间。","level":0,"quote":true},{"t":"无常水忽至，灭佛盛光明；","level":0,"quote":true},{"t":"犹如野猛火，卒遇大暴雨。」","level":0,"quote":true},{"t":"复有天仙人，敏善心调良；","level":0,"quote":true},{"t":"止处净居宫，清净除诸欲。","level":0,"quote":true},{"t":"见佛甚爱敬，啼泣如云雨；","level":0,"quote":true},{"t":"意重如须弥，便发是言曰：","level":0,"quote":true},{"t":"「世间终不有，生而不死者；","level":0,"quote":true},{"t":"自古来未曾，生而有长存。","level":0,"quote":true},{"t":"上中下究畅，决定无不知；","level":0,"quote":true},{"t":"是尚不得免，其餘难长在。","level":0,"quote":true},{"t":"是世间大导，去邪示正路；","level":0,"quote":true},{"t":"慧眼最第一，观世转上下。","level":0,"quote":true},{"t":"如是世慧灭，当还往邪导；","level":0,"quote":true},{"t":"犹如盲无目，迷失平正路。」","level":0,"quote":true},{"t":"弟子天眼最，号名阿难律；","level":0,"quote":true},{"t":"爱憎意已竭，劳尽生死断。","level":0,"quote":true},{"t":"见佛已灭度，世间当暗冥；","level":0,"quote":true},{"t":"诸根寂意灭，便叹是辞言：","level":0,"quote":true},{"t":"「处在大生死，慧义不得畅；","level":0,"quote":true},{"t":"世间如雾气，斯须空不现。","level":0,"quote":true},{"t":"无常金刚杵，击佛宝须弥；","level":0,"quote":true},{"t":"忽然尽崩坏，今坠堕于地。","level":0,"quote":true},{"t":"生世何轻脆，无一可恃怙；","level":0,"quote":true},{"t":"恍惚无坚要，躁动合则散。","level":0,"quote":true},{"t":"普世灭亡法，如梦无吾我；","level":0,"quote":true},{"t":"佛师子能伏，尘劳象自堕。","level":0,"quote":true},{"t":"未逮道迹者，何能不畏是；","level":0,"quote":true},{"t":"观世叵恃怙，如朝露聚沫。","level":0,"quote":true},{"t":"佛号天人师，金刚之大柱；","level":0,"quote":true},{"t":"忽然坏在地，其力安所在？","level":0,"quote":true},{"t":"六种生五枝，一萌五菓实；","level":0,"quote":true},{"t":"俱溉是三株，劳意固难伐。","level":0,"quote":true},{"t":"佛大力之象，突坏尘劳树；","level":0,"quote":true},{"t":"碎散令无餘，然后自堕地。","level":0,"quote":true},{"t":"千目执金刚，天帝蒙时雨；","level":0,"quote":true},{"t":"立之於正法，灭其苦清凉。","level":0,"quote":true},{"t":"德称弥弘广，普覆於世间；","level":0,"quote":true},{"t":"诸圣贤之师，寂然而隐灭。","level":0,"quote":true},{"t":"名德无不周，微妙法澹润；","level":0,"quote":true},{"t":"犹如秋时雨，法水满江河。","level":0,"quote":true},{"t":"天师垂济护，自意王营从；","level":0,"quote":true},{"t":"授以无为道，潜身如日没。","level":0,"quote":true},{"t":"兴云降是雨，秋冬雨雪霜；","level":0,"quote":true},{"t":"炽火之炽炎，莫之为之灭。","level":0,"quote":true},{"t":"如祠竟火灭，今诸天师火；","level":0,"quote":true},{"t":"霍灭寂无光，世间永长冥。","level":0,"quote":true},{"t":"断解脱者望，违本愿失欢；","level":0,"quote":true},{"t":"善名德流布，周遍满十方。","level":0,"quote":true},{"t":"怀四等大慈，愍众如赤子；","level":0,"quote":true},{"t":"莫不蒙其善，如何寂然灭。","level":0,"quote":true},{"t":"得妙无著道，诸佛之所生；","level":0,"quote":true},{"t":"无碍诸善法，寂然而自觉。","level":0,"quote":true},{"t":"以神足轻举，觉身是苦灭；","level":0,"quote":true},{"t":"以是故速疾，舍身安无为。","level":0,"quote":true},{"t":"除一切心冥，如日千光明；","level":0,"quote":true},{"t":"灭心之婬垢，如雨掩地尘。","level":0,"quote":true},{"t":"不复遭众苦，不为恼所迫；","level":0,"quote":true},{"t":"已度广无边，无涯底海渊。","level":0,"quote":true},{"t":"出兴显于世，坏诸苦毒患；","level":0,"quote":true},{"t":"愍伤於世间，欲求寂灭者。","level":0,"quote":true},{"t":"众好甚明曜，寂如梵天王；","level":0,"quote":true},{"t":"大智慧普备，为世天人师。","level":0,"quote":true},{"t":"转众生以善，练尘劳离恶；","level":0,"quote":true},{"t":"昼夜增诸善，如月之初生。","level":0,"quote":true},{"t":"每长养众善，德称弘广普；","level":0,"quote":true},{"t":"在家时已解，况其舍家后。","level":0,"quote":true},{"t":"乃往古自誓，当为尘劳战；","level":0,"quote":true},{"t":"愍诸贫贱者，誓充其所愿。","level":0,"quote":true},{"t":"佛以平等心，食不却<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00562.gif\" alt=\"䟽\" title=\"䟽\" />恶；","level":0,"quote":true},{"t":"亦无所专著，於精细美味。","level":0,"quote":true},{"t":"惠施难放舍，人所不能者；","level":0,"quote":true},{"t":"不受取於人，亦不求利益。","level":0,"quote":true},{"t":"相好大名称，自然如向应；","level":0,"quote":true},{"t":"广采众善意，决定於善听。","level":0,"quote":true},{"t":"故现相姿好，见者三垢灭；","level":0,"quote":true},{"t":"发言成法律，长益众生善。","level":0,"quote":true},{"t":"以行忍相明，与尘劳为怨；","level":0,"quote":true},{"t":"积功德无量，不免於无常。","level":0,"quote":true},{"t":"所生积功德，受报无有限；","level":0,"quote":true},{"t":"决定得正道，如薪尽火灭。","level":0,"quote":true},{"t":"示众生善道，伐尽尘劳林；","level":0,"quote":true},{"t":"制御於一切，生死缚著者。","level":0,"quote":true},{"t":"舍八胜五趣，覩见於三趣；","level":0,"quote":true},{"t":"伐三审尽三，因得净三眼。","level":0,"quote":true},{"t":"隐一觉知一，逮一至重七；","level":0,"quote":true},{"t":"散令无有餘，乃誓於无碍。","level":0,"quote":true},{"t":"以甘露充世，言辞断瞋恚；","level":0,"quote":true},{"t":"用善染众生，世间难悟者。","level":0,"quote":true},{"t":"每殖众善本，不施恶於恶；","level":0,"quote":true},{"t":"建立正法幢，於一切世间。","level":0,"quote":true},{"t":"鹿野转法轮，普喜悦世间；","level":0,"quote":true},{"t":"成就诸解脱，净诸自爱者。","level":0,"quote":true},{"t":"见所未曾见，普与清净合；","level":0,"quote":true},{"t":"觉诸难觉事，诸未曾觉法。","level":0,"quote":true},{"t":"告世以无常，所生輙有苦；","level":0,"quote":true},{"t":"告世以无我，无彼长迷惑。","level":0,"quote":true},{"t":"建立法幢幡，坏破贡高山；","level":0,"quote":true},{"t":"犹如七宝柱，於祠祀中崩。","level":0,"quote":true},{"t":"面毁不怀恨，不悦於叹誉；","level":0,"quote":true},{"t":"厌生受天福，方便求不生。","level":0,"quote":true},{"t":"自度生死海，又度脱一切；","level":0,"quote":true},{"t":"自以慧逮觉，又觉悟众生。","level":0,"quote":true},{"t":"如觉时润云，如山林薮花；","level":0,"quote":true},{"t":"脱见如日出，又授以正见。","level":0,"quote":true},{"t":"虽生於世间，不染於世事；","level":0,"quote":true},{"t":"涉世之险路，不同其所趣。","level":0,"quote":true},{"t":"心未曾犯非，得善道尚灭；","level":0,"quote":true},{"t":"普世遭艰难，无恃怙可伤。","level":0,"quote":true},{"t":"愚痴蔽其眼，终无所顾虑；","level":0,"quote":true},{"t":"不思设方便，求出生死要。","level":0,"quote":true},{"t":"生老病死苦，迫世间无免；","level":0,"quote":true},{"t":"唯佛能救苦，授之以甘露。","level":0,"quote":true},{"t":"往昔天魔兵，不能胜天师；","level":0,"quote":true},{"t":"自然无常力，无常忽胜之。","level":0,"quote":true},{"t":"世尊耳所听，三千世界声；","level":0,"quote":true},{"t":"神足然升降，乃至梵居天。","level":0,"quote":true},{"t":"觉众生心念，下至无择狱；","level":0,"quote":true},{"t":"诸生死起灭，悉审谛见了。","level":0,"quote":true},{"t":"天师从始生，轮转所周更；","level":0,"quote":true},{"t":"谛忆如面见，尽生死漏原。","level":0,"quote":true},{"t":"具足六通慧，备悉觉决定；","level":0,"quote":true},{"t":"今尽罢舍置，弃身餘寿行。","level":0,"quote":true},{"t":"世爱流生死，谁说法令息；","level":0,"quote":true},{"t":"世俗愚无智，谁当觉慧灭。","level":0,"quote":true},{"t":"犹如车无御，江海船失师；","level":0,"quote":true},{"t":"笃病离良医，如何当自持。","level":0,"quote":true},{"t":"如言离诚信，无觉意求智；","level":0,"quote":true},{"t":"王者失容饰，行善不忍辱。","level":0,"quote":true},{"t":"已离是四事，其功不显现；","level":0,"quote":true},{"t":"今佛舍世间，无济难成事。","level":0,"quote":true},{"t":"如夏五六月，清净无风云；","level":0,"quote":true},{"t":"亢阳相薄烧，及至诸虫物。","level":0,"quote":true},{"t":"众生应度者，今当普遭难；","level":0,"quote":true},{"t":"世尊舍寿命，何一甚苦痛。","level":0,"quote":true},{"t":"时天怀悲心，慈愍说是辞；","level":0,"quote":true},{"t":"婬怒痴薄故，叹师毁生死。」","level":0,"quote":true},{"t":"弟子未脱者，悲痛<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00079.gif\" alt=\"㘁\" title=\"㘁\" />啼哭；","level":0,"quote":true},{"t":"已得解脱者，谛计兴衰数。","level":0,"quote":true},{"t":"声流闻诸国，拘夷诸力士；","level":0,"quote":true},{"t":"悲勇速驰赴，集诣双树间。","level":0,"quote":true},{"t":"哀踊自投壁，种种叹佛德；","level":0,"quote":true},{"t":"其声甚悲痛，如群鹄遇鹰。","level":0,"quote":true},{"t":"倒见佛无光，寂灭叵复觉；","level":0,"quote":true},{"t":"同声悲啼叫，宛转如旱鱼。","level":0,"quote":true},{"t":"见佛奄然卧，支体皆展直；","level":0,"quote":true},{"t":"犹转轮王崩，诸国靡不<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00079.gif\" alt=\"㘁\" title=\"㘁\" />。","level":0,"quote":true},{"t":"人民无央数，出城诣佛所；","level":0,"quote":true},{"t":"诸男女长幼，怀悲毒狂乱。","level":0,"quote":true},{"t":"或掣裂衣裳，痛感口自啮；","level":0,"quote":true},{"t":"或自搣头发，爬爴坏面目。","level":0,"quote":true},{"t":"又复无数人，懊恼自投掷；","level":0,"quote":true},{"t":"椎胸向天<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00079.gif\" alt=\"㘁\" title=\"㘁\" />，叹佛德无量。","level":0,"quote":true},{"t":"「呜呼！天人师，众生所仰赖；","level":0,"quote":true},{"t":"相舍弃何疾，永绝无复望。」","level":0,"quote":true},{"t":"大众悲啼哭，各尽所堪任；","level":0,"quote":true},{"t":"诸力士之王，毒痛<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00079.gif\" alt=\"㘁\" title=\"㘁\" />叹言：","level":0,"quote":true},{"t":"「觉法悟世师，已卧不复起；","level":0,"quote":true},{"t":"犹如大军罢，大幢不复现。","level":0,"quote":true},{"t":"所办事已办，应觉佛已觉；","level":0,"quote":true},{"t":"於世犹如眼，今奄然长眠。","level":0,"quote":true},{"t":"佛是度苦桥，以济驶流江；","level":0,"quote":true},{"t":"大桥卒破坏，因何度苦痛。","level":0,"quote":true},{"t":"佛慧光照曜，心明精进晖；","level":0,"quote":true},{"t":"昔佛日现耀，令天地普明。","level":0,"quote":true},{"t":"今便隐光潜，无为之大山；","level":0,"quote":true},{"t":"世间便当还，奄入长衰冥。」","level":0,"quote":true},{"t":"或悲<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00079.gif\" alt=\"㘁\" title=\"㘁\" />寱语，或怀闷熟视；","level":0,"quote":true},{"t":"或有尽声哭，或有面掩地。","level":0,"quote":true},{"t":"众生怀恼毒，啼哭形不同；","level":0,"quote":true},{"t":"莫不怀恋慕，疼痛心惕灼。","level":0,"quote":true},{"t":"於是七宝挍，象牙之辇舆；","level":0,"quote":true},{"t":"诸力士舆佛，擎置宝辇上。","level":0,"quote":true},{"t":"华香之杂珍，种种众奇妙；","level":0,"quote":true},{"t":"诸力士<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00079.gif\" alt=\"㘁\" title=\"㘁\" />哭，供养佛舍利。","level":0,"quote":true},{"t":"诸贵姓少女，体婉手柔弱；","level":0,"quote":true},{"t":"执持七宝幔，微妙如天缯。","level":0,"quote":true},{"t":"明珠挍宝盖，或持宝垂珠；","level":0,"quote":true},{"t":"或捉宝拂扇，供养佛舍利。","level":0,"quote":true},{"t":"诸力士擎舆，啼哭眼皆赤；","level":0,"quote":true},{"t":"空中雷震声，称耳悦意乐。","level":0,"quote":true},{"t":"天散诸意花，续下如淋雨；","level":0,"quote":true},{"t":"诸天堕花地，鲜明始如敷。","level":0,"quote":true},{"t":"诸天塞虚空，众宝供养佛；","level":0,"quote":true},{"t":"畅发悲楚辞，追叹佛功德。","level":0,"quote":true},{"t":"诸执乐神女，洒栴檀香汁；","level":0,"quote":true},{"t":"散璎珞宝衣，供养佛舍利。","level":0,"quote":true},{"t":"诸力士擎舆，携至城中央；","level":0,"quote":true},{"t":"天人恭敬礼，追慕而啼哭。","level":0,"quote":true},{"t":"缯彩宝幢幡，严饰其城郭；","level":0,"quote":true}],[{"t":"华香及伎乐，供养尊舍利。","level":0,"quote":true},{"t":"供养擎宝舆，从城西门出；","level":0,"quote":true},{"t":"至城西便度，宝底流江水。","level":0,"quote":true},{"t":"上於甘树下，以种种香木；","level":0,"quote":true},{"t":"积为大薪<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00036.gif\" alt=\"𧂐\" title=\"𧂐\" />，及若干种香。","level":0,"quote":true},{"t":"若干种花香，及种种泽香；","level":0,"quote":true},{"t":"各各秉炬火，欲烧佛薪<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00036.gif\" alt=\"𧂐\" title=\"𧂐\" />。","level":0,"quote":true},{"t":"三烧佛薪<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00036.gif\" alt=\"𧂐\" title=\"𧂐\" />，火终不肯燃；","level":0,"quote":true},{"t":"众人咸怀疑，不知其缘故。","level":0,"quote":true},{"t":"大迦叶不远，怀慈往见佛；","level":0,"quote":true},{"t":"时火以是故，共吹终不然。","level":0,"quote":true},{"t":"时迦叶速至，礼敬佛<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00036.gif\" alt=\"𧂐\" title=\"𧂐\" />已；","level":0,"quote":true},{"t":"於是佛薪<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00036.gif\" alt=\"𧂐\" title=\"𧂐\" />，即时自然燃。","level":0,"quote":true},{"t":"尘劳不损佛，今为火所燃；","level":0,"quote":true},{"t":"肌体虽然尽，骨如故不燋。","level":0,"quote":true},{"t":"尔时诸力士，以乳浇灭火；","level":0,"quote":true},{"t":"以香汤洗骨，金瓶盛舍利。","level":0,"quote":true},{"t":"犹往昔天帝，欲烧金刚山；","level":0,"quote":true},{"t":"以其功德大，故火不能烧。","level":0,"quote":true},{"t":"今以大炽火，不能烧佛骨；","level":0,"quote":true},{"t":"诸力士展转，说此喻相谓：","level":0,"quote":true},{"t":"「四等心所生，灭除婬欲火；","level":0,"quote":true},{"t":"尊骨寂清凉，我等心燋燃。","level":0,"quote":true},{"t":"诸天神力士，不能胜佛身；","level":0,"quote":true},{"t":"忽今遭无常，我以能担行。","level":0,"quote":true},{"t":"佛力强无比，声流闻十方；","level":0,"quote":true},{"t":"如何便恍惚，盛之在金甖。","level":0,"quote":true},{"t":"佛辉辉喻日，未曾以贡高；","level":0,"quote":true},{"t":"遭遇无常火，唯留其神骨。","level":0,"quote":true},{"t":"以金刚慧杵，坏尘劳强山；","level":0,"quote":true},{"t":"遭苦不舍忍，心坚定不动。","level":0,"quote":true},{"t":"断尽诸苦本，灭不更受身；","level":0,"quote":true},{"t":"如是之妙体，永终於火中。」","level":0,"quote":true},{"t":"力士每所至，力伏令人啼；","level":0,"quote":true},{"t":"人来归伏者，能慰沃使悦。","level":0,"quote":true},{"t":"假其遭艰难，恃力未曾泣；","level":0,"quote":true},{"t":"念慈敬佛德，啼哭担舍利。","level":0,"quote":true},{"t":"力强勇武备，志精怀自大；","level":0,"quote":true},{"t":"啼哭还入城，意谦除贡高。","level":0,"quote":true},{"t":"幡盖授大殿，施七宝高座；","level":0,"quote":true},{"t":"舍利置其上，一切礼供养。","level":0,"quote":true}],[{"t":"佛本行经八王分舍利品第三十一","level":3},{"t":"诸力士悲感，在於王殿上；","level":0,"quote":true},{"t":"供养尊舍利，如是至数日。","level":0,"quote":true},{"t":"隣侧七国王，时各寻遣使；","level":0,"quote":true},{"t":"皆共同一时，如会至城下。","level":0,"quote":true},{"t":"各通其王命，诸力士相闻；","level":0,"quote":true},{"t":"皆陈其敬意，求得舍利分。","level":0,"quote":true},{"t":"诸力士答言：「佛於我国灭，","level":0,"quote":true},{"t":"自供养舍利，不能以相与。」","level":0,"quote":true},{"t":"尔时诸国使，相闻至数返；","level":0,"quote":true},{"t":"力士擎舍利，又恃其力强。","level":0,"quote":true},{"t":"使不肯还返，当遣以威力；","level":0,"quote":true},{"t":"意各赍贡高，无心分舍利。","level":0,"quote":true},{"t":"诸使还返命，诸王各起意；","level":0,"quote":true},{"t":"寻即兴师众，风发至其城。","level":0,"quote":true},{"t":"以无数军众，围绕力士城；","level":0,"quote":true},{"t":"军来趣其城，如霖雨暴水。","level":0,"quote":true},{"t":"人民入城底，莫不怀恐怖；","level":0,"quote":true},{"t":"人众甚繁多，城中不能容。","level":0,"quote":true},{"t":"七国王军众，象吼马鸣声；","level":0,"quote":true},{"t":"震动其城墎，人民战如波。","level":0,"quote":true},{"t":"於是七王军，各於其部分；","level":0,"quote":true},{"t":"精练甚壮勇，战士及象马。","level":0,"quote":true},{"t":"於是诸国王，力任各严办；","level":0,"quote":true},{"t":"四种之战阵，象马车步兵。","level":0,"quote":true},{"t":"力士亦严施，城上拒战具；","level":0,"quote":true},{"t":"修治其池壍，杜塞诸城门。","level":0,"quote":true},{"t":"即便皆建立，军阵大行旗；","level":0,"quote":true},{"t":"国内诸细民，莫不怀恐怖。","level":0,"quote":true},{"t":"於时七国王，计议同一心；","level":0,"quote":true},{"t":"各与无数众，器钾精锐备。","level":0,"quote":true},{"t":"犹如七星宿，同夜俱出现；","level":0,"quote":true},{"t":"七王之兵众，俱时到城下。","level":0,"quote":true},{"t":"大众起黄尘，坌塞人众眼；","level":0,"quote":true},{"t":"但象之气臭，塞鼻不得息。","level":0,"quote":true},{"t":"鼓角吹贝声，塞耳无所闻；","level":0,"quote":true},{"t":"妇女诸幼小，惶怖皆失色。","level":0,"quote":true},{"t":"对设火攻具，消铜铁为汤；","level":0,"quote":true},{"t":"皆贯胄被钾，当仗严进战。","level":0,"quote":true},{"t":"象马皆被钾，整阵当对战；","level":0,"quote":true},{"t":"力士没体命，不图分舍利。","level":0,"quote":true},{"t":"城里皆令催，执仗上城战；","level":0,"quote":true},{"t":"诸力士齐心，决定战不退。","level":0,"quote":true},{"t":"皆立於城上，楼橹却敌间；","level":0,"quote":true},{"t":"看城外诸王，军众无央数。","level":0,"quote":true},{"t":"军奋作威势，同时大叫呼；","level":0,"quote":true},{"t":"一时大叫呼，声向震天地。","level":0,"quote":true},{"t":"拔露剑掷弄，晃昱曜天日；","level":0,"quote":true},{"t":"或有跳勇走，捷疾欲向城。","level":0,"quote":true},{"t":"外军见力士，严备自束带；","level":0,"quote":true},{"t":"决定欲对战，殊无退却意。","level":0,"quote":true},{"t":"各与其妻息，辞别当进战；","level":0,"quote":true},{"t":"诸战士妻息，怀怖心惊波。","level":0,"quote":true},{"t":"又有父母者，心爱恋其子；","level":0,"quote":true},{"t":"见子被钾铠，欲出诣战场。","level":0,"quote":true},{"t":"垂泣皆啼哭，呪树请神祇；","level":0,"quote":true},{"t":"子见父母悲，心皆怀遗疑。","level":0,"quote":true},{"t":"或有诸妇女，默然怀愁闷；","level":0,"quote":true},{"t":"或持天弓箭，啼遮不令战。","level":0,"quote":true},{"t":"见妻子啼哭，心猛锐果敢；","level":0,"quote":true},{"t":"掣夺取弓箭，必欲战不疑。","level":0,"quote":true},{"t":"诸力士自恃，意决必欲战；","level":0,"quote":true},{"t":"如藏虺在器，怀怒毒炽盛。","level":0,"quote":true},{"t":"心意皆决定，必欲战不疑；","level":0,"quote":true},{"t":"七王亦严办，对阵垂当战。","level":0,"quote":true},{"t":"皆以素严办，四部之兵众；","level":0,"quote":true},{"t":"象兵及马兵，车步之兵众。","level":0,"quote":true},{"t":"有贵姓梵志，厥名香草性；","level":0,"quote":true},{"t":"性博慧笃慈，喻谏诸王言：","level":0,"quote":true},{"t":"「观诸王威势，利器剑战备；","level":0,"quote":true},{"t":"欲伏强力敌，灭尽形势命。","level":0,"quote":true},{"t":"居城自守者，不易可得胜；","level":0,"quote":true},{"t":"力士得城内，皆共同一心。","level":0,"quote":true},{"t":"如今重围闭，意必欲获胜；","level":0,"quote":true},{"t":"唯愿诸大王，幸回隆盛威。","level":0,"quote":true},{"t":"省其城中有，遵善调良者；","level":0,"quote":true},{"t":"诸王皆共悉，何辜横加恼？","level":0,"quote":true},{"t":"以力所闭者，必果不独胜；","level":0,"quote":true},{"t":"或时堕围者，方便胜外敌。","level":0,"quote":true},{"t":"毒虺自济命，入穴藏其形；","level":0,"quote":true},{"t":"无故手探者，毒螫或死伤。","level":0,"quote":true},{"t":"自觉有威势，能震彼令恐；","level":0,"quote":true},{"t":"集聚入城藏，坚固修守备。","level":0,"quote":true},{"t":"虽素力薄弱，入城成大力；","level":0,"quote":true},{"t":"如灯火垂灭，得膏薪还炽。","level":0,"quote":true},{"t":"若其城中有，戒具神真者；","level":0,"quote":true},{"t":"以其戒德重，外敌自坏散。","level":0,"quote":true},{"t":"犹昔重怨王，用兵力竭尽；","level":0,"quote":true},{"t":"清明王有德，胜外强怨敌。","level":0,"quote":true},{"t":"往过去诸王，以力广土地；","level":0,"quote":true},{"t":"欲以恣其情，驰名至无外。","level":0,"quote":true},{"t":"王食禄忽过，如牛饮氷水；","level":0,"quote":true},{"t":"诸王尽过去，国土地续存。","level":0,"quote":true},{"t":"是故当熟思，世间正真理；","level":0,"quote":true},{"t":"设方便和同，得舍利为贵。","level":0,"quote":true},{"t":"以矢力胜怨，生讐逆返迫；","level":0,"quote":true},{"t":"以和顺取胜，终已不起返。","level":0,"quote":true},{"t":"虽所言愚鄙，诚无可采纳；","level":0,"quote":true},{"t":"诸王力盛强，能消伏微敌。","level":0,"quote":true},{"t":"如所敬尊师，奉法者为上；","level":0,"quote":true},{"t":"今宜追念师，受行忍辱教。」","level":0,"quote":true},{"t":"今时彼梵志，尽其体所知；","level":0,"quote":true},{"t":"和顺正真言，慈心谏诸王。","level":0,"quote":true},{"t":"皆回降诸王，隆盛猛锐心；","level":0,"quote":true},{"t":"於是诸王便，顺辞答梵志：","level":0,"quote":true},{"t":"「所言得时宜，和顺知方便；","level":0,"quote":true},{"t":"今所说善理，笃厚存终始。","level":0,"quote":true},{"t":"汝当审吾等，心悟善法力；","level":0,"quote":true},{"t":"心之所求欲，不劳恣世俗。","level":0,"quote":true},{"t":"或以愿以力，或以忿恚恨；","level":0,"quote":true},{"t":"已诤今鬪者，曼当对战者。","level":0,"quote":true},{"t":"如我等今意，纯求以佛德；","level":0,"quote":true},{"t":"执仗求舍利，不贪国财宝。」","level":0,"quote":true},{"t":"往古烈力士，贡高答曰大：","level":0,"quote":true},{"t":"「战诤於仙林，死伤难呰计。","level":0,"quote":true},{"t":"佛布教世间，除劳灭自大；","level":0,"quote":true},{"t":"如何不为佛，爱危脆命为？","level":0,"quote":true},{"t":"往古诸帝王，迷惑贤女色；","level":0,"quote":true},{"t":"兴师相讨罚，诸王死无数。","level":0,"quote":true},{"t":"佛教戒世间，灭除贪婬意；","level":0,"quote":true},{"t":"而我不为佛，爱危脆命为？","level":0,"quote":true},{"t":"往日有兄弟，愚嫉兴嫌诤；","level":0,"quote":true},{"t":"还共相伤杀，令尽无有餘。","level":0,"quote":true},{"t":"佛兴显於世，灭除愚嫉心；","level":0,"quote":true},{"t":"如何不为佛，惜命而不战？","level":0,"quote":true},{"t":"昔手臂力士，挟嫌结瞋恚；","level":0,"quote":true},{"t":"便执持武备，欲尽诸王种。","level":0,"quote":true},{"t":"佛出於世间，能除尽恚害；","level":0,"quote":true},{"t":"我等为佛故，爱此躯命为？","level":0,"quote":true},{"t":"昔者华上子，号曰十头神；","level":0,"quote":true},{"t":"坚固著色欲，缘丧没身命。","level":0,"quote":true},{"t":"佛出於世间，解一切缚著；","level":0,"quote":true},{"t":"我等为佛故，著此身命为？","level":0,"quote":true},{"t":"往昔诸愚人，以痴诤水虫；","level":0,"quote":true},{"t":"以其愚痴盛，求其相杀害。","level":0,"quote":true},{"t":"佛兴出於世，除一切愚痴；","level":0,"quote":true},{"t":"我等为佛故，愚爱是身为？","level":0,"quote":true},{"t":"古来愚不达，所诤诸臭秽；","level":0,"quote":true},{"t":"无有一坚要，相害不可计。","level":0,"quote":true},{"t":"佛出除世患，吾等为佛故；","level":0,"quote":true},{"t":"当与阎罗鬪，岂当疑世战？","level":0,"quote":true},{"t":"吾等心坚正，终不疑於战。","level":0,"quote":true},{"t":"劳人使入城，至诸力士所，","level":0,"quote":true},{"t":"尽意设方便，陈吾等至意；","level":0,"quote":true},{"t":"其委仰於仁，必令一对战。","level":0,"quote":true},{"t":"吾等错利矢，剋意当交战；","level":0,"quote":true},{"t":"闻仁说善法，正真之言辞。","level":0,"quote":true},{"t":"内心即退灭，瞋恚之恶毒；","level":0,"quote":true},{"t":"犹如虺被呪，毒害灭无餘。」","level":0,"quote":true},{"t":"尔时其梵志，承诸王教命；","level":0,"quote":true},{"t":"便即行入城，至诸力士所。","level":0,"quote":true},{"t":"欲见诸力士，贵重有势者；","level":0,"quote":true},{"t":"便以谦恪意，宣诸王教命：","level":0,"quote":true},{"t":"「城外诸王兵，皆各严备仗；","level":0,"quote":true},{"t":"贯丳被宝钾，晧晧曜天日。","level":0,"quote":true},{"t":"发心欲同声，以尽其武力；","level":0,"quote":true},{"t":"意勇如师子，张目向城看。","level":0,"quote":true},{"t":"摩拭豫严张，金宝错涂弓；","level":0,"quote":true},{"t":"意勇无疲极，昼夜不脱铠。","level":0,"quote":true},{"t":"卒发心忆念，佛之慈明法；","level":0,"quote":true},{"t":"劳以义相让，不疑畏战鬪。","level":0,"quote":true},{"t":"不以诤土地，来至此城下；","level":0,"quote":true},{"t":"不自大贪悋，不以瞋慊来。","level":0,"quote":true},{"t":"敬佛功德故，来到汝此耳；","level":0,"quote":true},{"t":"客以善义来，主人宜敬待。","level":0,"quote":true},{"t":"佛为一切师，吾等同敬事；","level":0,"quote":true},{"t":"欲供养舍利，故来至此城。","level":0,"quote":true},{"t":"共为法兄弟，幸可分舍利；","level":0,"quote":true},{"t":"广可令众生，各各得供养。","level":0,"quote":true},{"t":"悭惜财宝者，是不为秽耻；","level":0,"quote":true},{"t":"悭惜善法者，是乃为愧耻。","level":0,"quote":true},{"t":"爱悋之为物，必有丑秽名；","level":0,"quote":true},{"t":"除悭施善者，圣贤之所叹。","level":0,"quote":true},{"t":"仁等若执意，不与舍利者；","level":0,"quote":true},{"t":"今便可出城，与客共捔力。","level":0,"quote":true},{"t":"居城依门扇，不执杖出战；","level":0,"quote":true},{"t":"是则不为王，非贵非勇士。","level":0,"quote":true},{"t":"城外诸王意，如向来所说；","level":0,"quote":true},{"t":"鄙俱有善心，等义示二家。","level":0,"quote":true},{"t":"又别有私意，欲以向仁等；","level":0,"quote":true},{"t":"幸小垂听采，请说正真法。","level":0,"quote":true},{"t":"唯仁等莫必，专意求欲战；","level":0,"quote":true},{"t":"古来战诤中，无善义无利。","level":0,"quote":true},{"t":"佛天师每叹，忍辱德第一；","level":0,"quote":true},{"t":"今诸仁何故，炽然怒求战？","level":0,"quote":true},{"t":"若忿诤六欲，若诤宝财货；","level":0,"quote":true},{"t":"若以此战诤，事理犹可通。","level":0,"quote":true},{"t":"以福德之故，是善法叹誉；","level":0,"quote":true},{"t":"善与诤为怨，是义当审思。","level":0,"quote":true},{"t":"每以普慈心，和调安隐性；","level":0,"quote":true},{"t":"佛天师导教，当慈加众生。","level":0,"quote":true},{"t":"莫杀害众生，而行敬事佛；","level":0,"quote":true},{"t":"终无有利义，是事不宜尔。","level":0,"quote":true},{"t":"仁等宜开意，分诸王舍利；","level":0,"quote":true},{"t":"善法当流布，因此为无始。","level":0,"quote":true},{"t":"若能为是者，则无复战诤；","level":0,"quote":true},{"t":"可逮二善义，福德及名称。","level":0,"quote":true},{"t":"其有专己见，离正入邪道；","level":0,"quote":true},{"t":"善人尽方便，当牵入正路。","level":0,"quote":true},{"t":"诸王设方便，欲广建善法，","level":0,"quote":true}],[{"t":"欲普导世间，牵至天人道。","level":0,"quote":true},{"t":"世尊每叹誉，众施法最善；","level":0,"quote":true},{"t":"所至则为师，天人之所叹。","level":0,"quote":true},{"t":"普观诸世间，财施者不少；","level":0,"quote":true},{"t":"以法惠施者，时有或无有。","level":0,"quote":true},{"t":"法施名称博，广安隐世间。」","level":0,"quote":true},{"t":"是诸力士众，闻是善法言；","level":0,"quote":true},{"t":"心内窃怀惭，默然熟相视。","level":0,"quote":true},{"t":"以谦爱敬辞，而谓梵志言：","level":0,"quote":true},{"t":"「仁乃善方便，加爱敬於众；","level":0,"quote":true},{"t":"为梵志不妄，勤建立著善。","level":0,"quote":true},{"t":"能降下我等，善行者道中；","level":0,"quote":true},{"t":"犹御不调马，不令入兽中。","level":0,"quote":true},{"t":"便可相从意，如师所开示；","level":0,"quote":true},{"t":"爱厚笃敬信，我等可用耳。","level":0,"quote":true},{"t":"忽舍忠怒言，正直善谏者；","level":0,"quote":true},{"t":"事败遇艰难，后追悔无及。」","level":0,"quote":true},{"t":"即时以金甖，分圣尊舍利；","level":0,"quote":true},{"t":"别以为八分，安谛一平等。","level":0,"quote":true},{"t":"於是诸力士，从中取一分；","level":0,"quote":true},{"t":"致其餘七分，送与七国王。","level":0,"quote":true},{"t":"尔时诸力士，上宾待诸王；","level":0,"quote":true},{"t":"诸王得舍利，悲喜各归国。","level":0,"quote":true},{"t":"於是七国王，各各自於国；","level":0,"quote":true},{"t":"兴师建神塔，高乃至云际。","level":0,"quote":true},{"t":"梵志草香性，欲己聚起塔；","level":0,"quote":true},{"t":"便从诸力士，乞量舍利甖。","level":0,"quote":true},{"t":"界内贵梵志，乞佛积灰炭；","level":0,"quote":true},{"t":"皆共收拾聚，恭敬立神塔。","level":0,"quote":true},{"t":"诸王造初起，以舍利神塔；","level":0,"quote":true},{"t":"於阎浮提地，巍巍德如山。","level":0,"quote":true},{"t":"梵志所建立，金甖塔第九；","level":0,"quote":true},{"t":"佛积炭灰塔，满十妙巍巍。","level":0,"quote":true},{"t":"华香宝幡盖，表显供养塔；","level":0,"quote":true},{"t":"挍饰甚妙好，如香熏山岩；","level":0,"quote":true},{"t":"隣侧诸国邑，无央数人集；","level":0,"quote":true},{"t":"或喜悲啼哭，礼事敬神塔。","level":0,"quote":true},{"t":"皆共追恋慕，忆念佛功德；","level":0,"quote":true},{"t":"辛酸悲楚毒，永逝一何剧！","level":0,"quote":true},{"t":"以善施世间，众生所恃赖；","level":0,"quote":true},{"t":"迷失路者导，重病者良医。","level":0,"quote":true},{"t":"寒者之春阳，旱热者凉池；","level":0,"quote":true},{"t":"三界之覆盖，忽便寂然灭。","level":0,"quote":true},{"t":"三界失覆盖，无恃可痛怜；","level":0,"quote":true},{"t":"当迷失正路，随邪遭艰难。","level":0,"quote":true},{"t":"世失正倾邪，流入三恶趣；","level":0,"quote":true},{"t":"世谁有大力，能制令还者？","level":0,"quote":true},{"t":"世间诸众生，愚痴蔽其眼；","level":0,"quote":true},{"t":"贪婬瞋恚火，之所见烧然。","level":0,"quote":true},{"t":"一切世众生，婴尘劳重病。","level":0,"quote":true},{"t":"世尊普慈心，为三界良医。","level":0,"quote":true},{"t":"佛日盛光明，始出现世时；","level":0,"quote":true},{"t":"普奋大光明，照三千世界。","level":0,"quote":true},{"t":"普开敷世间，天人芙蓉花。","level":0,"quote":true},{"t":"犹如诸池花，蒙日光而开。","level":0,"quote":true},{"t":"诸天世人民，及诸大国王；","level":0,"quote":true},{"t":"悲泣追叹慕，向塔咏佛德：","level":0,"quote":true},{"t":"「唯世大覆护，第一慈悲师；","level":0,"quote":true},{"t":"忽孤弃众生，一何甚速疾。","level":0,"quote":true},{"t":"佛日之光明，忽然而潜入；","level":0,"quote":true},{"t":"愚雾弥覆世，当何从见明？","level":0,"quote":true},{"t":"谁当导众生，示以正谛路；","level":0,"quote":true},{"t":"使至泥洹城，寂静无恐惧？」","level":0,"quote":true},{"t":"时密迹力士，广为诸天人；","level":0,"quote":true},{"t":"以次说是法，宣佛本行德。","level":0,"quote":true},{"t":"诸天闻所说，悚然毛衣竖；","level":0,"quote":true},{"t":"思惟所说理，追寻佛功德：","level":0,"quote":true},{"t":"「所积众善本，无限无有量；","level":0,"quote":true},{"t":"从难计数劫，善行之积聚。","level":0,"quote":true},{"t":"行六度无极，大海渊之地；","level":0,"quote":true},{"t":"众宝德相慧，充满甚盈溢。","level":0,"quote":true},{"t":"今此贤劫中，所兴千菩萨；","level":0,"quote":true},{"t":"假令诸罗汉，慧如舍利弗。","level":0,"quote":true},{"t":"寿劫叹佛德，不能令终竟；","level":0,"quote":true},{"t":"况吾智浅末，限陈所见闻。」","level":0,"quote":true},{"t":"时诸会天人，闻其所说法；","level":0,"quote":true},{"t":"心中忽明悟，意如面见佛。","level":0,"quote":true},{"t":"皆共怀悲感，恻怆追慕佛，","level":0,"quote":true},{"t":"愿志大乘意，写情心专固。","level":0,"quote":true},{"t":"稽首归命佛，忽然各飞去。","level":0,"quote":true}]]