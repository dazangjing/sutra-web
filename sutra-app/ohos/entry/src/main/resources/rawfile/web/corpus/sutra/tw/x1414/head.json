{"id":"x1414","title":"了菴清欲禪師語錄","titleTrad":"了菴清欲禪師語錄","byline":"","bylineLabel":"著者·译者","dynasty":"","division":"诸宗部","canon":"X1414","canonName":"新纂卍續藏","volume":"X1414","juanCount":9,"textLength":171369,"imageCount":0,"summary":"","tags":["诸宗部","新纂卍續藏"],"order":2629,"guide":"","chunks":45,"toc":[{"level":3,"text":"南堂了菴禪師語錄序"},{"level":3,"text":"中大夫知　制誥兼脩　國史金華宋濂景濂序"},{"level":3,"text":"宋濂序"},{"level":3,"text":"至仁撰續集序"},{"level":3,"text":"硯銘并序"},{"level":3,"text":"陸放翁所製無用禪師語錄序"},{"level":3,"text":"谷陵，選為後堂首座。佛性遷建業保寧，分第一座說"},{"level":3,"text":"南堂和尚語錄續集序"}],"chunksPerFile":20}