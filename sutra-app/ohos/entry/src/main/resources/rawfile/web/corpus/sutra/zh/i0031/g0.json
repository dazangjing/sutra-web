[[{"t":"俊蒙文姬卅一人等造像记","level":0},{"t":"之一　碑侧","level":0},{"t":"夫大□□□萨云表挺世之容。妙法开敷。波若阐权显之音。如来奄过□□殊迁祀。像法虽隆。床宗者尠。是以大代永熙二年岁次□□正月戊子朔八日乙未。北雍州宜君郡黄堡县邑主俊蒙文姬□□娥合邑子卅一人等。自慨丕逾。流转无窃。故减割家珍。聘名□□□大路显敞之处。敬造石像一区。功就成讫。令国祚永隆人民□　洽。下愿庆七世。永超八难。神县福堂。济生死之苦。愿诸邑子□□蒙拯。众患消□。□愿初首。书人夫蒙显达。","level":0},{"t":"之二　碑侧","level":0},{"t":"邑子清信瓽高□邑子清信杨妙娥邑子清信同<img class=\"gaiji\" src=\"asset://gaiji-CB/14/CB14685.gif\" alt=\"𤧛\" title=\"𤧛\" />凤皇","level":0,"quote":true},{"t":"姬　邑子清信同<img class=\"gaiji\" src=\"asset://gaiji-CB/14/CB14685.gif\" alt=\"𤧛\" title=\"𤧛\" />标姬　邑子清信同<img class=\"gaiji\" src=\"asset://gaiji-CB/14/CB14685.gif\" alt=\"𤧛\" title=\"𤧛\" />照姬　邑子清信同<img class=\"gaiji\" src=\"asset://gaiji-CB/14/CB14685.gif\" alt=\"𤧛\" title=\"𤧛\" />枝达","level":0,"quote":true},{"t":"邑子清信同<img class=\"gaiji\" src=\"asset://gaiji-CB/14/CB14685.gif\" alt=\"𤧛\" title=\"𤧛\" />真朱","level":0,"quote":true},{"t":"伏男邑子清信成定姬邑子清信钳耳支诚","level":0,"quote":true},{"t":"男姬　邑子清信同<img class=\"gaiji\" src=\"asset://gaiji-CB/14/CB14685.gif\" alt=\"𤧛\" title=\"𤧛\" />妙娥","level":0,"quote":true},{"t":"邑子清信同<img class=\"gaiji\" src=\"asset://gaiji-CB/14/CB14685.gif\" alt=\"𤧛\" title=\"𤧛\" />轩朱　邑子清信同<img class=\"gaiji\" src=\"asset://gaiji-CB/14/CB14685.gif\" alt=\"𤧛\" title=\"𤧛\" />标姬　邑子清信夫蒙百伏","level":0,"quote":true},{"t":"邑子清信□□□","level":0,"quote":true},{"t":"之三　碑阳","level":0},{"t":"惟那清□□拔连香火清信王兰小","level":0,"quote":true},{"t":"邑谓清信同<img class=\"gaiji\" src=\"asset://gaiji-CB/14/CB14685.gif\" alt=\"𤧛\" title=\"𤧛\" />云□典录清信同<img class=\"gaiji\" src=\"asset://gaiji-CB/14/CB14685.gif\" alt=\"𤧛\" title=\"𤧛\" />阿美","level":0,"quote":true},{"t":"邑主清信俊蒙文姬邑正清信同<img class=\"gaiji\" src=\"asset://gaiji-CB/14/CB14685.gif\" alt=\"𤧛\" title=\"𤧛\" />娥媚","level":0,"quote":true},{"t":"比丘僧郭僧景名丰洛　弹官清信夫蒙妙朱","level":0,"quote":true},{"t":"沙弥夫蒙僧贵弹官清信同<img class=\"gaiji\" src=\"asset://gaiji-CB/14/CB14685.gif\" alt=\"𤧛\" title=\"𤧛\" />天姬","level":0,"quote":true},{"t":"邑主清信瓽姬娥邑正清信朱阿傥","level":0,"quote":true},{"t":"邑谓清信同<img class=\"gaiji\" src=\"asset://gai