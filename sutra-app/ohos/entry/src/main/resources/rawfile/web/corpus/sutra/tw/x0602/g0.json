[[{"t":"法華經要解溫陵開元蓮寺比丘 戒環 解","level":0},{"t":"No. 602-A 妙法蓮華經解序No. 602-A","level":0}],[{"t":"妙法蓮華經解序","level":3},{"t":"前住福州上生禪院嗣祖沙門及南撰","level":0},{"t":"諸佛出興，唯為一事；千經所演，無有餘乘。直以妙萬","level":0},{"t":"法而明一心，即幻華而示實相，則妙法蓮華經者，諸","level":0},{"t":"佛之本宗，千經之輨轄，一心之元鑑，實相之妙門也。","level":0},{"t":"秦譯已還，垂八百載，訓辭釋義，代有哲人，而責備求","level":0},{"t":"全，互有得失。信曰：滿世間之鶖子，如恒沙之菩薩，盡","level":0},{"t":"思度量，莫知少分。故雖多歷講解，有所未盡，而潤色","level":0},{"t":"評論，不拒來者。溫陵蓮寺環師，深究一乘，博探眾說，","level":0},{"t":"研幾摭要，為之科解。宣和己亥，初辱不鄙，命予校證，","level":0},{"t":"既又徧質宗匠，務契佛心。越丙午，復會予南山，討疏","level":0},{"t":"尋經，參詳再四，黜名相，芟蘩蔓，使入佛知見者，無摘","level":0},{"t":"葉尋枝之厭，有析薪秉燭之觀，是真能發明祕要之","level":0},{"t":"藏也。或者扣師：七軸文中，何處為正說妙法？曰：千經","level":0},{"t":"萬論，唯為此事，豈茲一席，輙有異談？世尊以是而開","level":0},{"t":"示，群迷以是而悟入，火宅以是而出離，寶所以是而","level":0},{"t":"前進。若等多劫以半日，現大千於一身，龍女之成佛，","level":0},{"t":"不輕之徧記，藥王之然身，觀音之隨應，淨藏之轉邪，","level":0},{"t":"普賢之勸發，凡以是也。不明此事，則滿目陳言；開佛","level":0},{"t":"知見，則孰非妙法？竊觀一期之問答，見全經之述作","level":0},{"t":"矣。儻沿披味深，造而自得，遂可跏趺無量義處，反照","level":0},{"t":"白毫相光，開方便門，示真實相，直拋糞器，長御白牛，","level":0},{"t":"則一乘妙法，備在我而不在佛，備在心而不在經矣。","level":0},{"t":"譬如琴瑟箜篌，雖有妙音，若無妙指，終不能發。則夫","level":0},{"t":"欲發明是事，當以斯解為妙指也。","level":0}],[{"t":"靖康丁未春暮中澣日謹序","level":3},{"t":"目次法華經要解目次","level":0},{"t":"卷首","level":0},{"t":"科","level":0},{"t":"卷第一之一","level":0}],[{"t":"序祥邁註弘傳序","level":3}],[{"t":"序品第一","level":3},{"t":"卷第一之二","level":0}],[{"t":"序品第二","level":3},{"t":"卷第一之三","level":0},{"t":"方便品之餘","level":0},{"t":"卷第二之一","level":0}],[{"t":"譬喻品第三","level":3},{"t":"卷第二之二","level":0},{"t":"譬喻品之餘","level":0},{"t":"卷第二之三","level":0}],[{"t":"信解品第四","level":3},{"t":"卷第三之一","level":0}],[{"t":"藥草喻品第六","level":3},{"t":"卷第三之二","level":0}],[{"t":"化城喻品第七","level":3},{"t":"卷第三之三","level":0},{"t":"化城喻品之餘","level":0},{"t":"卷第四之一","level":0}],[{"t":"五百弟子品第九","level":3},{"t":"卷第四之二","level":0}],[{"t":"法師品第十一","level":3},{"t":"卷第四之三","level":0}],[{"t":"提婆達多品第十三","level":3},{"t":"卷第五之一","level":0}],[{"t":"安樂行品第十四","level":3},{"t":"卷第五之二","level":0}],[{"t":"涌出品第十六","level":3},{"t":"卷第五之三","level":0}],[{"t":"分別功德品第十七"