[[{"t":"心貪嗅諸香。","level":0},{"t":"施塗香末香故，當得淨戒多聞諸三摩地塗香聖","level":0},{"t":"行故，當得徧體香潔妙香聖行故。今以自心破戒","level":0},{"t":"聖行功德難生，故立願爾。","level":0},{"t":"復作是願：寧以百千刃刀割斷其舌，終不以破戒之","level":0},{"t":"心食人百味淨食。","level":0},{"t":"今但取五塵中舌所甞味，異前第三。佛言：施上味","level":0},{"t":"者，當感得甘露上味大大夫相，於一切味中常得","level":0},{"t":"最上第一義味。今者破戒上味之福不生，故立願","level":0},{"t":"爾。","level":0},{"t":"復作是願：寧以利斧斬碎其身，終不以破戒之心貪","level":0},{"t":"著好觸。","level":0},{"t":"即五塵中觸境也。上妙可意，適悅稱心，故名好觸。","level":0},{"t":"即衣服、臥具、飲食、湯藥等物，施此福生，並如上說。","level":0},{"t":"今者破戒，福利難生，故立願爾。","level":0},{"t":"復作是願：願一切眾生悉得成佛。","level":0},{"t":"第十三願，普利無邊法界眾生，總願成就無上菩","level":0},{"t":"提。","level":0},{"t":"而菩薩若不發是願者，犯輕垢罪。","level":0},{"t":"違制結罪，一切菩薩總須發上十三願也。","level":0},{"t":"若佛子！常應二時。","level":0},{"t":"春秋二時","level":0},{"t":"頭陀。","level":0},{"t":"正云杜多，此云除棄。有十二種頭陀行，一一皆十","level":0},{"t":"種功德勝用，如十二頭陀經說。且常坐十種者：一、","level":0},{"t":"不貪身樂；二、不貪睡眠樂；三、不貪臥具樂；四、無臥","level":0},{"t":"時勝著席苦；五、不隨身欲；六、易得坐禪；七、易讀誦","level":0},{"t":"經典；八、少睡眠蓋；九、身輕易起；十、求座臥具衣服","level":0},{"t":"心薄。","level":0},{"t":"冬夏坐禪。","level":0},{"t":"極寒熱時不出，又夏多蟲蟻，恐傷物命。","level":0},{"t":"結夏安居。","level":0},{"t":"修道求聖，結夏文廣。","level":0},{"t":"常用楊枝。","level":0},{"t":"亦名齒木。此下列十八事。","level":0},{"t":"澡豆","level":0},{"t":"能去垢、淨口、淨手。","level":0},{"t":"三衣","level":0},{"t":"五條七條大衣，福田之衣，常須隨身。","level":0},{"t":"瓶","level":0},{"t":"梵語君遲，此云淨瓶，盛水淨手。","level":0},{"t":"鉢。","level":0},{"t":"具云鉢多羅，此云應量器。","level":0},{"t":"坐具","level":0},{"t":"正敷坐，兼禮佛。","level":0},{"t":"鍚杖","level":0},{"t":"束心不亂，止虎等難。","level":0},{"t":"香爐","level":0},{"t":"用焚信香","level":0},{"t":"漉水囊","level":0},{"t":"即濾水羅，恐食蟲故。","level":0},{"t":"手巾","level":0},{"t":"拭手巾。拭脚巾，觸淨別也。","level":0},{"t":"刀子","level":0},{"t":"刀長四寸，割甲裁衣等用。","level":0},{"t":"火鐆。","level":0},{"t":"火鏡也。以銅為之，仰日得火，焚香造食等。","level":0},{"t":"鑷子。","level":0},{"t":"拔刺除毛。","level":0},{"t":"繩床","level":0},{"t":"隨處坐禪，修觀止息。","level":0},{"t":"經。","level":0},{"t":"要察佛意，攝心除亂。","level":0},{"t":"律：","level":0},{"t":"知持犯軌則，理應有論，詮慧學故。","level":0},{"t":"佛像。","level":0},{"t":"觀像擬知真佛。","level":0},{"t":"菩薩像。","level":0},{"t":"常觀先進，為良友故。此十八物，並具頭陀。進道之","level":0},{"t":"緣，須常隨身。","level":0},{"t":"而菩薩行頭陀時。","level":0},{"t":"牒前二時","level":0},{"t":"及遊方時。","level":0},{"t":"遊禮學問之時。","level":0},{"t":"行來！","level":0},{"t":"必有行去。","level":0},{"t":"百里千里","level":0},{"t":"舉此二數影，顯餘遠近來去，皆用是物。","level":0},{"t":"此十八種物，常隨其身。","level":0},{"t":"此指遊方時也。","level":0},{"t":"頭陀者。","level":0},{"t":"此下定二時隨身也。","level":0},{"t":"從正月十五日至三月十五日，八月十五日至十月","level":0},{"t":"五日，是二時中，此十八種物常隨其身。","level":0},{"t":"然佛菩薩經律論，更不定時常要隨身。","level":0},{"t":"如鳥二翼。","level":0},{"t":"喻時及物，鳥無翼而不能高飛，菩薩虧此莫可遊","level":0},{"t":"行。","level":0},{"t":"若布薩日。","level":0},{"t":"如有鬪諍比丘來，佛令增減說戒，若知十四日來，","level":0},{"t":"十三日前說；若知十五日來，十四說、或不說、或隨","level":0},{"t":"何日諍滅即說。","level":0},{"t":"新學菩薩半月半月布薩，應誦諸佛法戒。若誦戒時，","level":0},{"t":"於佛菩薩形像前，一人布薩即一人誦，若二人、三人","level":0},{"t":"乃至百千人亦一人誦。誦者高坐，聽者下坐，各各披","level":0},{"t":"九條、七條、五條袈裟。","level":0},{"t":"梵語布薩，此云淨住。或唯言淨，由懺悔己身，器清","level":0},{"t":"淨住。或云長養，長養淨心。或云和合，大眾和合，同","level":0},{"t":"佛事故。若四人已上，作白說戒。若三人各各脩儀，","level":0},{"t":"更牙云：二大德一心念！今僧十五日說戒，我某甲","level":0},{"t":"清淨。若二人相向，彼此如上。若一人心念口言：今","level":0},{"t":"僧十五日說戒，我某甲清淨。上各三說。","level":0},{"t":"結夏安居，一一如法。","level":0},{"t":"結前安居文也。","level":0},{"t":"若頭陀時。","level":0},{"t":"菩薩修十二，種頭陀行時，","level":0},{"t":"莫入難處。","level":0},{"t":"此總標難處。","level":0},{"t":"若國難惡王，土地高下，草木深邃，獅子虎狼，水火風","level":0},{"t":"難，及以劫賊，道路毒虵。","level":0},{"t":"此別列八難也。","level":0},{"t":"一切難處，悉不得入。","level":0},{"t":"結上八處。","level":0},{"t":"若頭陀行道乃至夏坐安居，是諸難處皆不得入。","level":0},{"t":"遊方不入。夏坐不入。","level":0},{"t":"若故入者，犯輕垢罪。","level":0},{"t":"違制得罪。","level":0},{"t":"若佛子！應如法次第坐。","level":0},{"t":"既稱佛子，須知正法，禮法次第，應合如法。此總標","level":0},{"t":"次第也。","level":0},{"t":"先受戒者在前坐，後受戒者在後坐。","level":0},{"t":"此正明次第也。","level":0},{"t":"不問老少，比丘、比丘尼、貴人、國王、王子，乃至黃門、奴","level":0},{"t":"婢，皆應先受戒者在前坐，後受戒者次第而坐。","level":0},{"t":"別示菩薩但依四眾軌儀，各自次第，不容雜亂坐","level":0},{"t":"也。","level":0},{"t":"莫如外道癡人，若老若少，無前無後，坐無次第，兵奴","level":0},{"t":"之法。","level":0},{"t":"外道愚戇，實昧禮儀，兵奴兇劣，難辨尊卑，故無次","level":0},{"t":"第。","level":0},{"t":"我佛法中，先者先坐，後者後坐。","level":0},{"t":"佛法有規，故依次第結自正也。","level":0},{"t":"而菩薩不如法次第坐者，犯輕垢罪。","level":0},{"t":"違禁得罪。","level":0},{"t":"若佛子，常應教化。","level":0},{"t":"自能進善，損能化生，是名菩薩，","level":0},{"t":"一切眾生，","level":0},{"t":"是所化也。","level":0},{"t":"建立僧坊","level":0},{"t":"安僧之所。","level":0},{"t":"山林園田，立作佛塔。","level":0},{"t":"行道之處。","level":0},{"t":"冬夏安居，坐禪處所。","level":0},{"t":"深房靜室，離喧雜所。","level":0},{"t":"一切行道處，皆應立之。","level":0},{"t":"但是進修道行之處，總應修崇，令其清雅。","level":0},{"t":"而菩薩應為一切眾生。","level":0},{"t":"怨親無二。","level":0},{"t":"講說大乘經律。","level":0},{"t":"此明菩薩正所行事也。菩薩大根故，講說大乘也。","level":0},{"t":"若疾病：","level":0},{"t":"一切眾生有疾病時，應為講經律救之。","level":0},{"t":"國難賊難。","level":0},{"t":"同上。救之。","level":0},{"t":"父母、兄弟、和尚、阿闍梨亡滅之日，及三七日乃至七","level":0},{"t":"七日，應讀誦講說大乘經律，一切齋會求福。","level":0},{"t":"初亡滅日，或每歲亡日，即忌辰日，及字超初二七","level":0},{"t":"日也，乃至字超四五六三个七日也。問：但為亡者","level":0},{"t":"講經即得，何須七日？答：中有身七日一度命終，要","level":0},{"t":"經福資疾受生故，故云爾也。","level":0},{"t":"行來治生。","level":0},{"t":"即養活義，以求利者多為養活命故。","level":0},{"t":"大火所燒，大水所漂，黑風所吹，船舫、江河、大海、羅剎","level":0},{"t":"之難。","level":0},{"t":"五難生時。","level":0},{"t":"亦讀誦講說此經律。","level":0},{"t":"一一令讀誦講此戒經，經即是律也。","level":0},{"t":"乃至一切罪報。","level":0},{"t":"總攝輕重，總講此經。","level":0},{"t":"三惡","level":0},{"t":"即是三塗。","level":0},{"t":"七逆","level":0},{"t":"業障。","level":0},{"t":"八難，杻械枷鏁繫縛其身。","level":0},{"t":"並是報障。","level":0},{"t":"多婬、多瞋、多愚癡。","level":0},{"t":"是煩惱障。","level":0},{"t":"多疾病。","level":0},{"t":"報障。","level":0},{"t":"皆應讀誦講說此經律。","level":0},{"t":"如是三障，亦講此經，能滅除也。","level":0},{"t":"而新學菩薩若不爾者，犯輕垢罪。","level":0},{"t":"違禁結罪。","level":0},{"t":"如是九戒應當學，敬心奉持，梵壇品中當廣說。","level":0},{"t":"結勸指廣。","level":0},{"t":"佛言：佛子！與人受戒時。","level":0},{"t":"指受戒機，求受戒時。","level":0},{"t":"不得揀擇。","level":0},{"t":"佛誠能授，慈心普濟。","level":0},{"t":"一切。","level":0},{"t":"此總標舉所揀。","level":0},{"t":"國王、王子、大臣、百官、比丘、比丘尼、信男、信女、婬男、婬","level":0},{"t":"女、十八梵天、六欲天子、無根、二根、黃門、奴婢、一切鬼","level":0},{"t":"神，盡得受戒。","level":0},{"t":"此別示戒器，有一十七類，但要解語，領納文旨，方","level":0},{"t":"堪受戒。若不解語，非戒器也。","level":0},{"t":"應教身所著袈裟。","level":0},{"t":"此不正色出家人受戒也。","level":0},{"t":"皆使壞色。","level":0},{"t":"壞本白色，違愛心故。","level":0}],[{"t":"與道相應。","level":0},{"t":"與所修道行相稱，須衣色儋，捨於情愛。","level":0},{"t":"皆染使青黃赤黑紫色，一切染衣乃至臥具盡以壞","level":0},{"t":"色。","level":0},{"t":"正明壞色衣也。","level":0},{"t":"身所著衣，一切染色，","level":0},{"t":"除袈裟外，餘一切衣亦壞本白色。白色外，餘色皆","level":0},{"t":"名壞色壞本白色。","level":0},{"t":"若一切國土中人所著衣服，比丘皆應與其俗服有異。","level":0},{"t":"不論何方國土，但色異俗服便得。","level":0},{"t":"若欲受戒時。","level":0},{"t":"標告戒師：有求戒人，欲於師所求受戒時。","level":0},{"t":"師應問言：","level":0},{"t":"戒師問彼：","level":0},{"t":"汝現身不作七逆罪耶？","level":0},{"t":"以過去久遠不知故，只問現有七逆重障，故非戒","level":0},{"t":"器。將欲受戒，先問其罪。","level":0},{"t":"菩薩法師不得與七逆人現身受戒。","level":0},{"t":"誡，能授戒師也。","level":0},{"t":"七逆者，出佛身血、殺父、殺母、殺阿闍梨、破羯磨、轉法","level":0},{"t":"輪僧、殺聖人。","level":0},{"t":"此列七逆罪也。","level":0},{"t":"若具七遮，即現身不得戒。","level":0},{"t":"結不應受之所以也。","level":0},{"t":"餘一切人盡得受戒。","level":0},{"t":"除七逆外，餘解師語，可得受戒。","level":0},{"t":"出家人法","level":0},{"t":"儀軌法則","level":0},{"t":"不向國王禮拜，不向父母禮拜。","level":0},{"t":"出家法則","level":0},{"t":"六親不敬。","level":0},{"t":"亦是不禮拜義。","level":0},{"t":"鬼神不禮，但解法師語，有百里千里來求法者。","level":0},{"t":"但字下。結成須得與受戒而無擇也。","level":0},{"t":"而菩薩法師以惡心瞋心，而不即與授一切眾生戒","level":0},{"t":"者，犯輕垢罪。","level":0},{"t":"若佛子教化，人起信心時，","level":0},{"t":"利人之初，信心為本。信為入法之初基，超聖道之","level":0},{"t":"元首，故。","level":0},{"t":"菩薩與他人作教誡法師者。","level":0},{"t":"此牒定能教之人也。","level":0},{"t":"見欲受戒人。","level":0},{"t":"見有來求受戒之人。","level":0},{"t":"應教請二師。","level":0},{"t":"教求受戒人請。","level":0},{"t":"和尚！","level":0},{"t":"即釋迦如來不可見師。","level":0},{"t":"阿闍梨！","level":0},{"t":"即我身是，可見師也。","level":0},{"t":"二師應問言：","level":0},{"t":"即前和尚、阿闍梨第二師問也。若佛在世，即佛、菩","level":0},{"t":"薩為六師。今佛滅後，可應問言：傳戒師為和尚，羯","level":0},{"t":"磨師為阿闍梨。擬其經中通六師也。","level":0},{"t":"汝有七遮罪不？若現身有七遮，師不應與受戒；無七","level":0},{"t":"遮者，得與受戒。","level":0},{"t":"此問遮罪法也。","level":0},{"t":"若有犯十重者。","level":0},{"t":"十波羅夷罪也。","level":0},{"t":"應教懺悔。","level":0},{"t":"重罪在身，必障聖道，使令懺悔。","level":0},{"t":"在佛菩薩形像前。","level":0},{"t":"此教授師，教知軌儀，對聖像前，至誠懇惻，悔過自","level":0},{"t":"責。","level":0},{"t":"日夜六時，誦十重四十八輕戒。","level":0},{"t":"懺悔，行相也。由誦戒故，憶知罪相也。","level":0},{"t":"苦到","level":0},{"t":"苦切至到。","level":0},{"t":"禮三世千佛。","level":0},{"t":"恭敬<img class=\"gaiji\" src=\"asset://gaiji-CB/05/CB05418.gif\" alt=\"䖍\" title=\"䖍\" />心，禮拜三劫三千佛也。","level":0},{"t":"得見好相。","level":0},{"t":"此總言也，即吉祥善相。","level":0},{"t":"若一七日，二三七日，乃至一年，","level":0},{"t":"此是懺悔時限也。各自障，有厚薄遠近不等。","level":0},{"t":"要見好相。","level":0},{"t":"但要見相為限。","level":0},{"t":"好相者，佛來摩頂，見光見華，種種異相。","level":0},{"t":"明所見相，相有多般，如餘經辯。","level":0},{"t":"便得滅罪。","level":0},{"t":"以障盡故相現，得滅罪也。","level":0},{"t":"若無好相。","level":0},{"t":"戒無形狀，無相不知，故此云爾。","level":0},{"t":"雖懺無益。","level":0},{"t":"戒由相表，無相不能表戒圓故。","level":0},{"t":"是人現身亦不得戒。","level":0},{"t":"不得舊戒圓也。","level":0},{"t":"而得增受戒。","level":0},{"t":"但令戒加增益資長，未得圓滿無相表戒，重受方","level":0},{"t":"圓。","level":0},{"t":"若犯四十八輕戒者，對首懺罪滅。","level":0},{"t":"但對一人，於佛像前，當面陳白：比丘某甲，我犯某","level":0},{"t":"罪，今向大德懺悔，惟願哀憫憶我，我清淨故滅。三","level":0},{"t":"說。前僧告云：汝自深悔，後莫重犯。答云：何可爾？","level":0},{"t":"不同七遮。","level":0},{"t":"反釋前七遮罪，相表亦滅，故言不同，應更云亦不","level":0},{"t":"同十重。","level":0},{"t":"而教誡師。","level":0},{"t":"佛告命能教之師也。","level":0},{"t":"於是法中。","level":0},{"t":"於前三類輕重罪相法中。","level":0},{"t":"一一，好解。","level":0},{"t":"了知重，輕知輕，有相無相，罪滅不滅，稱法所詮，如","level":0},{"t":"法實了，故名好解也。","level":0},{"t":"若不解大乘經律。","level":0},{"t":"此牒迷教。","level":0},{"t":"若輕若重，是非之相。","level":0},{"t":"於前七遮、十重、四十八輕不了知故。","level":0},{"t":"不解第一義諦。","level":0},{"t":"不知所詮真勝諦理。","level":0},{"t":"習種性。","level":0},{"t":"十信","level":0},{"t":"長養性。","level":0},{"t":"攝十住、十行也。","level":0},{"t":"性、種性、不可壞性。","level":0},{"t":"十迴向位","level":0},{"t":"道種性。","level":0},{"t":"十地","level":0},{"t":"正法性","level":0},{"t":"佛位不解五位伏斷行相。","level":0},{"t":"其中多少觀行。","level":0},{"t":"於五位中，明行多少。","level":0},{"t":"出入十禪支。","level":0},{"t":"四禪十八支不雜，但十支：尋、伺、喜、樂、定、內淨、捨、念、","level":0},{"t":"慧、中受，不了出定、入定。四禪各具支多少。","level":0},{"t":"一切行法。","level":0},{"t":"不知一切觀，行進趣法則，","level":0},{"t":"一一不得，此法中意。","level":0},{"t":"總結五位，十支法中不解得故。","level":0},{"t":"而菩薩為利養故。","level":0},{"t":"貪利","level":0},{"t":"為名聞故。","level":0},{"t":"詐言能解","level":0},{"t":"惡求？","level":0},{"t":"非理強求。","level":0},{"t":"多求","level":0},{"t":"求之無厭。","level":0},{"t":"貪利弟子。","level":0},{"t":"貪著有名利者弟子。","level":0},{"t":"而詐現解，一切經律。","level":0},{"t":"內實無知，外現解相。","level":0},{"t":"是自欺詐。","level":0},{"t":"自隱覆心，知自不解。","level":0},{"t":"亦欺詐他人。","level":0},{"t":"無解誑他，是欺他人。","level":0},{"t":"故與人授戒者，犯輕垢罪。","level":0},{"t":"若佛子！不得為利養故，於未受菩薩戒者前。","level":0},{"t":"雖有大姓，以未發大心，亦未信大戒。","level":0},{"t":"外道惡人前。","level":0},{"t":"毀謗大乘。","level":0},{"t":"說此千佛大戒。","level":0},{"t":"千華上佛，或三世三千佛，皆說此戒。","level":0},{"t":"邪見人前亦不得說。","level":0},{"t":"亦謗。","level":0},{"t":"除國王。","level":0},{"t":"以王有損益佛法之力，要說須說。","level":0},{"t":"餘一切不得說。","level":0},{"t":"凡常之人，者不為說。大臣要說，亦可為說。有力諫","level":0},{"t":"王，損益佛法。","level":0},{"t":"是惡人輩，不受佛戒。","level":0},{"t":"此句貫下。","level":0},{"t":"名為畜生。","level":0},{"t":"愚甚如畜。","level":0},{"t":"生生不見三寶。","level":0},{"t":"當必墮落不見，又不奉見，如不見故。","level":0},{"t":"如木石無心。","level":0},{"t":"不知業果責如彼也。","level":0},{"t":"名為外道，邪見人輩，木頭無異，","level":0},{"t":"釋成不說有八，所以即八句經也。","level":0},{"t":"而菩薩於是惡人，前說七佛教戒者，","level":0},{"t":"理實此戒，十方三世塵沙諸佛，已說當說今說，就","level":0},{"t":"近且言七也。","level":0},{"t":"犯輕垢罪。","level":0},{"t":"若佛子！信心出家受佛正戒故，起心毀犯聖戒者。","level":0},{"t":"明毀戒者人也。","level":0},{"t":"不得受一切檀越供養。","level":0},{"t":"如分一毛為百千分處，即損施主一分福。喻鹹鹵","level":0},{"t":"地，雖下種子，不生苗實。","level":0},{"t":"亦不得國王地上行，不得飲國王水。","level":0},{"t":"持戒之福，七分之中，王得二分。今既破戒，無福稅","level":0},{"t":"王，地行飲水，以輸王稅。","level":0},{"t":"五千大鬼，常遮其前。鬼言：大賊！","level":0},{"t":"無戒受施，無福與他，如盜他物，","level":0},{"t":"若入房舍城邑宅中，鬼復常掃其脚跡。","level":0},{"t":"戒圓神護，破戒神怒。","level":0},{"t":"一切世人皆罵言：佛法中賊！","level":0},{"t":"一切諸天龍神有天眼者，見犯戒比丘來時云賊","level":0},{"t":"來，去時云賊去至。","level":0},{"t":"一切眾生，眼不欲見，","level":0},{"t":"通人天等，皆不欲見。","level":0},{"t":"犯戒之人，畜生無異。","level":0},{"t":"呵同畜生，但念所食。癡無識覺，","level":0},{"t":"木頭無異。","level":0},{"t":"復似木石，頑礙無知。","level":0},{"t":"若故毀正戒者。","level":0},{"t":"隨犯於一，輕重正戒。","level":0},{"t":"犯輕垢罪。","level":0},{"t":"故毀，招罪摧身。","level":0},{"t":"若佛子！常應一心。","level":0},{"t":"佛子！修善不容怠慢，進善無雜，修心無間。","level":0},{"t":"受持。","level":0},{"t":"受領其文，攝持不忘。","level":0}],[{"t":"讀誦","level":0},{"t":"依本曰讀，背本曰誦。","level":0},{"t":"大乘經律。","level":0},{"t":"二、利大行。","level":0},{"t":"剝皮為紙，㓨血為墨，以髓為水，折骨為筆，書寫佛戒。","level":0},{"t":"但表至重不一身命護持佛戒，未必用被堪書佛","level":0},{"t":"戒。","level":0},{"t":"木皮","level":0},{"t":"桑皮等紙。","level":0},{"t":"榖紙","level":0},{"t":"即楮構也。","level":0},{"t":"絹素竹帛。","level":0},{"t":"烝竹拍破，舒展如紙。","level":0},{"t":"亦應悉書持。","level":0},{"t":"此正可用書之。","level":0},{"t":"常以七寶、無價香花、一切雜寶為箱囊，盛經律卷。","level":0},{"t":"嚴持佛戒。","level":0},{"t":"若不如法供養者。","level":0},{"t":"依上說故名如法，今不如法故當其罪。","level":0},{"t":"犯輕垢罪。","level":0},{"t":"違制之罪。","level":0},{"t":"若佛子，常起大悲心，","level":0},{"t":"悲若不生，無以化物。","level":0},{"t":"若入一切，城邑舍宅，","level":0},{"t":"行化之處。","level":0},{"t":"見一切眾生。","level":0},{"t":"自修大行所化之生，通五乘也。","level":0},{"t":"應當唱言：汝等眾生盡應受。","level":0},{"t":"正勸令受，雖非皆受，願心普化令受，又令知戒堪","level":0},{"t":"可受故。","level":0},{"t":"三歸十戒","level":0},{"t":"固此漸化令受餘戒，是大乘戒之因。","level":0},{"t":"若見牛馬猪，羊一切畜生，","level":0},{"t":"不解人語，不能發心，但約菩薩悲心平等，故作是","level":0},{"t":"說。或有一類龍等，或依劫初近從人天中來，皆作","level":0},{"t":"人言：","level":0},{"t":"應心念口言：","level":0},{"t":"心發悲念，如念啟言，意在警覺，作遠因緣。","level":0},{"t":"汝是畜生，發菩提心。","level":0},{"t":"法句經說：有五百獼猴，效羅漢立塔，旦夕禮拜，時","level":0},{"t":"遇山水，一時漂沒，即生忉利天。上等五百白兔亦","level":0},{"t":"爾，皆是畜生發菩提心也。","level":0},{"t":"而菩薩入一切處山川林野，皆使一切眾生發菩提","level":0},{"t":"心。","level":0},{"t":"此明所化處也。","level":0},{"t":"是菩薩若，不發教化，眾生心者，","level":0},{"t":"不化發心，利他行闕。","level":0},{"t":"犯輕垢罪。","level":0},{"t":"若佛子，常行教化。","level":0},{"t":"依教行化，令生進達，修斷理趣，","level":0},{"t":"起大悲心。","level":0},{"t":"悲心不起，化行難生。化行，因也。","level":0},{"t":"入檀越。","level":0},{"t":"修施度家。","level":0},{"t":"貴人家。","level":0},{"t":"公卿高貴之家。","level":0},{"t":"一切眾中。","level":0},{"t":"二眾、四眾、八部之眾，是說法處。","level":0},{"t":"不得立為白衣說法，應白衣眾前高座上坐。法師比","level":0},{"t":"丘不得地立為四眾說法。","level":0},{"t":"此示說法之儀。","level":0},{"t":"若說法時，法師高座，香華供養四眾，聽者下坐，如孝","level":0},{"t":"順父母、敬順師教。","level":0},{"t":"說聽恭謹之事也。","level":0},{"t":"如事火婆羅門。","level":0},{"t":"如三迦葉，日日三時，禮事火神，","level":0},{"t":"其說法者，若不如法說；","level":0},{"t":"唯明口業，亦兼身意。","level":0},{"t":"犯輕垢罪。","level":0},{"t":"若佛子！皆以信心受佛戒者。","level":0},{"t":"信心是受戒之因，若無信心，必不肯受。","level":0},{"t":"國王太子百官四部弟子。","level":0},{"t":"此之七類，並是信心受佛戒人。","level":0},{"t":"自恃高貴，破滅佛法戒律，明作制法，制我四部弟子，","level":0},{"t":"不聽出家行道，亦復不聽造立形像佛塔經律。","level":0},{"t":"即恃貴破法也。若四部眾，自雖無力制法，憑託前","level":0},{"t":"三，亦自破法。前三唯能制，後四通能所制。所制事","level":0},{"t":"如經。","level":0},{"t":"是破三寶之罪，而菩薩故作破法者，犯輕垢罪。","level":0},{"t":"除制惡人出家造像賣等，餘結破三寶罪也。","level":0},{"t":"若佛子，不以好心出家；","level":0},{"t":"好者，善也。不善，即三毒也。三中，貪、增也。","level":0},{"t":"而為名聞利養。","level":0},{"t":"正是惡心所為，也要自身招高上之名，得利養故。","level":0},{"t":"於國王百官前，說七佛法戒。","level":0},{"t":"來名比丘向於王臣說於輕重戒條，今彼王臣知","level":0},{"t":"解，言彼比丘所犯而治罰之。","level":0},{"t":"橫與。","level":0},{"t":"佛教比丘犯戒，只令懺悔，令依王法條治，故云橫","level":0},{"t":"與。","level":0},{"t":"比丘、比丘尼、菩薩弟子、","level":0},{"t":"此兼在家。","level":0},{"t":"作繫縛事。","level":0},{"t":"因令報持箠縛，或因退道。","level":0},{"t":"如獅子身中蟲，自食獅子肉。","level":0},{"t":"七夢經說：獅子死經多日，眾獸猶生怖畏，等不敢","level":0},{"t":"近。多日之後，身中自生其蟲，食盡獅子肉也。","level":0},{"t":"非外道天魔能破壞。","level":0},{"t":"以合歸元本破法戒之人所得罪故。以佛出世，外","level":0},{"t":"道歸伏，猶如獅子遊行無畏，眾獸潛伏。如來滅後","level":0},{"t":"所遺教法，如獅子死後之身，多日眾獸怖畏不敢","level":0},{"t":"近，喻佛正法一千七百年內，外道天魔無能毀壞。","level":0},{"t":"多日後，獅子身中生蟲，自食獅子肉盡者，喻一千","level":0},{"t":"七百年後，佛弟子破戒惡行，自破佛教也，非魔道","level":0},{"t":"能破故。","level":0},{"t":"若受佛戒者。","level":0},{"t":"此牒定受戒人。","level":0},{"t":"應護佛戒。","level":0},{"t":"受佛戒，稱佛子，依教奉行，須護佛戒。","level":0},{"t":"如念一子。","level":0},{"t":"如慈父母，思念一子，念念常憶，","level":0},{"t":"如事父母。","level":0},{"t":"如孝順之子，事養父母，心心不離，","level":0},{"t":"而聞外道惡人以惡言謗佛戒時，如三百矛㓨心，千","level":0},{"t":"刀萬杖打拍其身，等無有異。寧自入地獄百劫，而不","level":0},{"t":"用聞一惡言破佛戒之聲。","level":0},{"t":"此喻成護戒之心也。","level":0},{"t":"而況自破佛戒。","level":0},{"t":"但聞破戒之聲，尚痛不可，豈況自破，寧不心切？","level":0},{"t":"教人破法因緣。","level":0},{"t":"二利不行，已是其過，今行二破，故當重罪也。","level":0},{"t":"亦無孝順之心。","level":0},{"t":"由破法故因壞三寶，壞三寶故殃累父母。","level":0},{"t":"若故作者，犯輕垢罪。","level":0},{"t":"結歸破法之罪。","level":0},{"t":"如是九戒，應當學，敬心奉持。","level":0},{"t":"結數勸持。","level":0},{"t":"諸佛子！是四十八輕戒，汝等受持，過去諸菩薩已學，","level":0},{"t":"未來諸菩薩當學，現在諸菩薩今學。","level":0},{"t":"此結勸修學也。","level":0},{"t":"諸佛子諦聽！","level":0},{"t":"此下結勸流通也。佛說如是十重四十八輕戒訖，","level":0},{"t":"佛告當機三賢之眾：專心奉行，故令諦聽。","level":0},{"t":"此十重四十八輕戒。","level":0},{"t":"牒前所說戒條之數","level":0},{"t":"三世諸佛。","level":0},{"t":"非指三劫名為三世也。過去無邊，未來無盡，及現","level":0},{"t":"在世，皆同誦也。故下云：","level":0},{"t":"已誦、當誦、今誦，我今亦如是誦。","level":0},{"t":"我今釋迦佛，與諸佛誦同，","level":0},{"t":"汝等一切大眾！","level":0},{"t":"總標指告現前眾等。","level":0},{"t":"若國王、王子、百官、比丘、比丘尼、信男、信女。","level":0},{"t":"此別列七類也。","level":0},{"t":"受持菩薩戒者。","level":0},{"t":"於七類中有不曾受，不在流通此戒之數。","level":0},{"t":"應受持、讀誦、解說、書寫。","level":0},{"t":"護持最勝，此十法行中五行也。","level":0},{"t":"佛性常住戒卷","level":0},{"t":"由受持讀誦戒卷，方能證得佛性常住真理。又以","level":0},{"t":"戒卷能詮顯佛性常住真理，佛性即常住，佛性常","level":0},{"t":"住之戒卷。","level":0},{"t":"流通三世，一切眾生。","level":0},{"t":"由前受持，展轉傳受，故通三世。","level":0},{"t":"化化不絕。","level":0},{"t":"燈燈不盡。","level":0},{"t":"得見千佛。","level":0},{"t":"由受持戒得入二地，得見千華臺上盧舍那佛，千","level":0},{"t":"華臺上一千个大化身佛。又因持戒得見三劫三","level":0},{"t":"千佛，經總言故。","level":0},{"t":"佛佛授手。","level":0},{"t":"佛以慈悲垂於教手，眾生發心以信為手，二手相","level":0},{"t":"契引出眾生，眾生成佛復化眾生，眾生又成又化","level":0},{"t":"生故，故云佛佛授手也。","level":0},{"t":"世世不墮惡道八難。","level":0},{"t":"持戒心善。","level":0},{"t":"常生人道天中。","level":0},{"t":"由持戒力，近生人天，三賢十地，究竟成佛。","level":0},{"t":"我今在此樹下。","level":0},{"t":"小化身釋迦佛，在此菩提樹下坐，宣說此戒。","level":0},{"t":"略開：","level":0},{"t":"此心地法門一品經，又如不可說法門中一毛頭","level":0},{"t":"許。","level":0},{"t":"七，佛法戒。","level":0},{"t":"據近且言：","level":0},{"t":"汝等當一心學波羅提木叉，歡喜奉行。","level":0},{"t":"此明大眾信受奉行。","level":0},{"t":"如無相天王品勸學中，一一廣明。","level":0},{"t":"此明懸指廣文也。此經序云：此經本有一百一十","level":0},{"t":"二卷六十一品，今指在彼中天王品說也。","level":0},{"t":"三千學士，時坐聽者。","level":0},{"t":"疏指三千登地，聽者地前。又三千已學、現學，聽者","level":0},{"t":"未學。今什誦戒，有三千學士隨誦，便云三千學士。","level":0},{"t":"此下譯主助勸，結歡流通，分二：初長行，後偈頌。此","level":0},{"t":"初譯主敘自學徒喜躍受持也。羅什和尚誦此心","level":0},{"t":"地法門品時，於草堂中有三千學士於法師處受","level":0},{"t":"學所譯經、律、論故。今聞法師誦此心地戒品，從來","level":0},{"t":"未聞，剏聞深奇，