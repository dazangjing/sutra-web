{"id":"b0163","title":"重修曹溪通志","titleTrad":"重修曹溪通志","byline":"","bylineLabel":"著者·译者","dynasty":"","division":"诸宗部","canon":"B0163","canonName":"大藏經補編","volume":"B0163","juanCount":8,"textLength":130217,"imageCount":0,"summary":"","tags":["诸宗部","大藏經補編"],"order":2040,"guide":"","chunks":22,"toc":[{"level":3,"text":"序舊志序舊志序"},{"level":2,"text":"品題詞翰志凡為卷四"},{"level":3,"text":"志謹序"},{"level":3,"text":"丁酉別清公以戊戌志成在己亥庚子之間而余序"},{"level":3,"text":"重修序一重修曹溪通志序"},{"level":3,"text":"重修序二重修曹溪通志序"},{"level":3,"text":"厚自幸適志成而　馬公以其序"},{"level":3,"text":"清吏司郎中毘陵史樹駿序"},{"level":3,"text":"舊志叢錯不次雖經重修頗有節目復煩雜失序"},{"level":2,"text":"曹谿通志卷第一"},{"level":2,"text":"曹溪通志卷第二"},{"level":2,"text":"曹溪通志卷第三"},{"level":3,"text":"序"},{"level":3,"text":"御製壇經法寶序"},{"level":3,"text":"性入善之指南云故序"},{"level":2,"text":"曹溪通志卷第四"},{"level":2,"text":"劇盜洊至鎮山之常住金谷席卷一"},{"level":2,"text":"曹溪通志卷第六"},{"level":2,"text":"曹溪通志卷第七"},{"level":2,"text":"曹溪通志卷第八"}],"chunksPerFile":20}