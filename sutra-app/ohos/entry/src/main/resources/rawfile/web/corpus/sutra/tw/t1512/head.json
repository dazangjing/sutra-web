{"id":"t1512","title":"金剛仙論","titleTrad":"金剛仙論","byline":"魏天平二年菩提流支三藏於洛陽譯","bylineLabel":"著者·译者","dynasty":"","division":"论集部","canon":"T1512","canonName":"大正藏","volume":"T1512","juanCount":10,"textLength":137197,"imageCount":0,"summary":"","tags":["论集部","大正藏"],"order":791,"guide":"","chunks":15,"toc":[{"level":2,"text":"金剛仙論卷第一"},{"level":2,"text":"金剛仙論卷第二"},{"level":2,"text":"金剛仙論卷第三"},{"level":2,"text":"金剛仙論卷第四"},{"level":3,"text":"「論曰：復有疑」，論主將欲設偈釋此分第三經"},{"level":2,"text":"金剛仙論卷第五"},{"level":2,"text":"金剛仙論卷第六"},{"level":2,"text":"金剛仙論卷第七"},{"level":3,"text":"斷疑分第一段中，明實無有法名為菩薩。次"},{"level":2,"text":"金剛仙論卷第八"},{"level":3,"text":"佛成就八十種好三十二相而名為佛」者，序"},{"level":2,"text":"金剛仙論卷第九"},{"level":3,"text":"住分及此斷疑分第四經中並言「菩薩若作"},{"level":2,"text":"金剛仙論卷第十"}],"chunksPerFile":20}