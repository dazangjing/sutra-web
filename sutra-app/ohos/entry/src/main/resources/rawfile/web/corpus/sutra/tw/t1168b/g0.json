[[{"t":"八曼荼羅經","level":0},{"t":"No. 1168B [No. 1167]八曼荼羅經","level":0},{"t":"􄖩􄗰如􆿏是􄙠􄗥我􄗲􄭢􄕗一􄗫􄑀􈉡􄙺􄗥􄗷婆􄗙","level":0},{"t":"伽􄑘梵􈊷在􄖽布􄕗得􄙊攞􄑆迦􄙘山􄚨􄗽住􄕙􅋌觀􆿆自􅝪在􄙖","level":0},{"t":"􄙒􄑂宮􄕝殿􈂫􄗽􄣢􄗙􄙖􄖯與􆿅無􄖯量􄑀􄗕􄕽","level":0},{"t":"􄙺􄽙􄑆􄓝􄖩􄗵􄕗百􄙢千􄕗句􄙺致􄚨􈉢菩􄖵薩􄙀前􆱘","level":0},{"t":"後􄕟􄖹圍􄗽遶􈍅􄕢􆿅時􄕣有􄑌菩􄙎薩􄗽名􅑈寶􄑘藏􅝑月􄑼􈁢","level":0},{"t":"􄙖光􄗚􄚤􄖪􄗰􄗕􄕽􄙺􄽚􄗥􄚩􄙺􄽤􄕗􄩥","level":0},{"t":"􄙖􄖵中􅞻􄕱􄙺􄽛􄖵􄕙􄕟􄗞􈇪􄕙􄙮􈅶即􄙺","level":0},{"t":"􄕗起􄩧􈉣􄗲􄙺􄖪一􄕵心􈂾􄙺􈁃􆽕􄗾恭􄚦敬􄑢合􆮧","level":0},{"t":"掌􄽚􄕯􄚶􄕋􄦾供􄖭養􄗥尊􆧽重􄙔􆯯􄕥􄢿􄪼􄕙􅁙","level":0},{"t":"􄗷􄖩􄗙􄑘􈊾􆶯􄖪􄒶頂􄙌禮􄪼􄕋􄢦世􄗙尊􄑘􄙖","level":0},{"t":"􆽕作􄗫如􄕗是􄕯􄙞言􄑼􆯯􇪡􄗱􄗥􄚲婆􄗙伽􄑘梵􈊾􄕗","level":0},{"t":"􄕤􄑘􄕗應􄗥􄚲供􆩠正􄙺等􄢦􇩀􈎭􇪭􈆡所􄑾有􄕵􄙖","level":0},{"t":"􄪼􄕵諭示􄙬􄙺教􅇁受􄗙令􄑘無􄙗􄖩􄙖疑􄑁􄙬惑􄑄􅝪􈅸","level":0},{"t":"􆵋􄪼􅓺􄢾􄑀􄗽􄕋􄗱如􆿏是􄙖􈁃說􈅯以􄗙􄑘","level":0},{"t":"佛􈊾􄗽寶􅑈􄑘藏􅝑月􄑼􈆦􄙖光􄗚􄚦菩􄗕提􄕽􄙺􄽙􄗫","level":0},{"t":"􄕗􄕯􄙞􄑼言􄙞􄑼􄢿􄑀􄗽當􄕑􄖩一􄑾心􆽕􄗥􄗾","level":0},{"t":"􄕻諦􄗳聽􄣜􇧆如􆿏是􄙖􈁃說􈅯已􄗽寶􅑎􄗽􅑈􄑘藏􅝑􄑼","level":0},{"t":"􈆦􄙖􄗚􄚤菩􄗕薩􄕽􄙺􄽟􄗙􄑘􄙖􆩖作􄗫􄕗是􄕯","level":0},{"t":"􄙞真􄑼􄙗􄑼言􄗼若􄑀有􈃫􆥮􄑘善􄙠男􄭞子􈁜􄑄􄙊􄖹","level":0},{"t":"善􄩦􄙞女􄑄人􄙊􈇚􄚪􄕘欲􄑽􆿆修􆵋曼􄗥荼􆧽羅􄙊􄖹􄑊","level":0},{"t":"􄑀者􈇜􄑁􄗭􄗙􄙖􄕙彼􄕝等􄖩􄑀􄕭云􄑀何􄗽方􄕎","level":0},{"t":"便􄗻而􄗙世􄑘尊􄙗告􄖪言􄚨善􄙺哉􈃁善􄙻哉􈃁􄑄􄙊􈁃􄩞","level":0},{"t":"􄗙􄩶􄑁􆶩賢􄪼勇􄕙族􄗚姓􄖪子􈉥􅑉生􆿅􄟗􄙸利􄑄益􄙊","level":0},{"t":"多􄖹􄩞諸􄙖􈂪眾􄒶生􄖩􈂼令􄑍得􄗱安樂􈇢能􄕣􄙺生􄖹眾􈉥","level":0},{"t":"生􅑉􈁀三􄙺世􄽚􈁀􆿅􄕛􄢲􈂤智􄖩慧􄒶􄗷是􄕝故􄖩應􄚪","level":0},{"t":"知􆱜􆧽善􄑄男􄙊子􄖹此􄩟八􆵌菩薩􈁀􄗕􄕽􄙺􄽙􄖪心􆱨􄕯","level":0},{"t":"􄗲􄖫種􄗷子􆱨字􄕯􄗱􄖩由􄙺能􆮧􈇚□􈇞□􄙀之􄕗者􄗦􄩞","level":0},{"t":"􄕋滅􄖿盡􄑽􄖩五􆽕無􅝪間􄕍􄚴罪􄗻􄗲􄕙一􄙺切􅞣􅚼","level":0},{"t":"皆􄙼得􈂧􄑼􄪽成􆻬就􄕙􇧆􈁴􆿆􄙙􄗽􅁥􄚩此􄗥","level":0},{"t":"名􈅥如􄗙來􄑘胎􈊾藏􆿅以􄖯心􄖩􆱨􄕯􄗷􄖩供􈁂養􄝠􇩵","level":0},{"t":"􄚳􇪯􆱘􄗷􅁥􄚩􇧆觀􆿅自􄙖在􄙒菩􄑂薩􄕝","level":0},{"t":"心􈂫􄗽􄣢􆱨􄕯􄗼􇧆􄗫􈉦􄗽􄕋􅁥􄚩􇧆","level":0},{"t":"是􄗫名􄩤彌􄗱勒􄣢菩􆱨薩􄕯心􄗼􇧆􇩱􄑘􅝒􄗱􅁥􄚩􇧆","level":0},{"t":"是􆿆名􄑁虛􄙢空􄑘藏􅝑菩􄣢薩􆱨心􄕯􄗼􇧆􄚿􄚩􄗽􄒼􅁥","level":0},{"t":"􄚩􇧆是􄚶名􄕙地􄑘藏􅝑菩􄣢薩􆱨心􄕯􄗼􇧆􆿏􄕘􄡈","level":0},{"t":"􆵑􄙞􅁥􄚩􇧆􄒶􄗱􅁥􄚩􇧆􄙺􄗥􆩖􄗙􄩶􄣢􆱨􄕯􄗱􄑄􄙖􄗽􅁥􄚩􇧆􄙖􄦽􄖵􄕍􄗕􄕽􄙺􆮧􄣢􆱨􄕯􄗱􄭠􆿅􄗽􄑤􅁥􄚩􇧆􄗯􄒺􄭟􄗕􄕽􄙺􄽙􄣢􆱨􄕯􄗱􄖫􄙺􄗽􄕗􅁥􄚩􇧆􄙺􅞣􄖬􄙖􈉧􆫎􄕋􄗕􄕽􄙺􄽙􄣢􆱨􄕯􄗱􄕽􄙺􄽙􆱨􄕯􄗲􄖫􄕗􄕤􄑘􄕗􄙺􄗫􄕘􄖪􄗥􄗥􆧽􄙊􄑀􄣢􄖹􄗽􄕟􄗱大正藏 校注","level":0}]]