{"id":"jb325","title":"解惑篇","titleTrad":"解惑篇","byline":"廣州南海寶象林沙門弘贊在犙編","bylineLabel":"著者·译者","dynasty":"","division":"华严部","canon":"JB325","canonName":"新文豐版","volume":"JB325","juanCount":2,"textLength":89278,"imageCount":0,"summary":"","tags":["华严部","新文豐版"],"order":3767,"guide":"","chunks":5,"toc":[{"level":3,"text":"序解惑編序"},{"level":3,"text":"朱熹屏山李居士鳴道集說序"},{"level":3,"text":"之，欲為書糾其蕪謬而未暇，豈意屏山先我著鞭，遂為序"},{"level":2,"text":"洪武十八年，翰林待詔沈士榮撰，上卷七"}],"chunksPerFile":20}