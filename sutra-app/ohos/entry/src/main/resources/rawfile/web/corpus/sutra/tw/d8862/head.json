{"id":"d8862","title":"楞嚴經四依解","titleTrad":"楞嚴經四依解","byline":"明湖南邵陵五臺菴沙門觀𢖍述、明湖南邵陵五臺𤲅沙門觀𢖍述","bylineLabel":"著者·译者","dynasty":"","division":"经疏部","canon":"D8862","canonName":"國圖善本佛典","volume":"D8862","juanCount":10,"textLength":351998,"imageCount":0,"summary":"","tags":["经疏部","國圖善本佛典"],"order":965,"guide":"","chunks":16,"toc":[{"level":3,"text":"序楞嚴経四依解序"},{"level":3,"text":"自昧可謂日用而不知也圎覺序"},{"level":2,"text":"不別明問曰既三觀一體何又將初卷二"},{"level":2,"text":"經四依觧卷第一"},{"level":2,"text":"經四依觧卷第二"},{"level":2,"text":"經四依觧卷第三"},{"level":2,"text":"經四依觧卷第四"},{"level":3,"text":"不同義必󳠦焉但麄細前後互出故不凖常序"},{"level":2,"text":"經四依觧卷第五"},{"level":2,"text":"經四依觧卷第六"},{"level":2,"text":"經四依解卷第七"},{"level":2,"text":"經四依觧卷第八"},{"level":2,"text":"之義也上結示經名已竟自初卷七"},{"level":2,"text":"經四依觧卷第九"},{"level":2,"text":"經四依觧卷第十"}],"chunksPerFile":20}