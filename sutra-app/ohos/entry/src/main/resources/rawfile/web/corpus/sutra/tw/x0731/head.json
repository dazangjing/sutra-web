{"id":"x0731","title":"四分律疏","titleTrad":"四分律疏","byline":"沙門","bylineLabel":"著者·译者","dynasty":"","division":"律疏部","canon":"X0731","canonName":"新纂卍續藏","volume":"X0731","juanCount":10,"textLength":558626,"imageCount":0,"summary":"","tags":["律疏部","新纂卍續藏"],"order":1941,"guide":"","chunks":120,"toc":[{"level":2,"text":"第一本四分律疏卷第一"},{"level":3,"text":"教非信不傳，故此偈序寄歎戒功勸信奉修以明序"},{"level":3,"text":"三四合者，對不對分第五之一對中僧別，三四對別"},{"level":2,"text":"第二本四分律疏卷第二"},{"level":3,"text":"第者，憙為易犯，建在初明。故祇初戒，五年冬分第五"},{"level":2,"text":"第三本四分律疏卷第三"},{"level":2,"text":"第四本四分律疏卷第四"},{"level":2,"text":"第五本四分律疏卷第五"},{"level":3,"text":"衣請如前；三、前衣食請，後食唯請犯。依五分第三戒"},{"level":2,"text":"第六本四分律疏卷第六"},{"level":2,"text":"第七本四分律疏卷第七"},{"level":2,"text":"第八本四分律疏卷第八"},{"level":2,"text":"第九本四分律疏卷第九"},{"level":3,"text":"言諍下品第二，彼諍比丘不忍第一僧已下，次以現"},{"level":3,"text":"前滅言諍中品第三，爾時舍衛國已下總用二藥滅"},{"level":2,"text":"第十本四分律疏卷第十"}],"chunksPerFile":20}