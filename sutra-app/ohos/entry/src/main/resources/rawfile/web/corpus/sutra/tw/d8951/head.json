{"id":"d8951","title":"如來香","titleTrad":"如來香","byline":"清 唐時編","bylineLabel":"著者·译者","dynasty":"","division":"诸宗部","canon":"D8951","canonName":"國圖善本佛典","volume":"D8951","juanCount":14,"textLength":504311,"imageCount":0,"summary":"","tags":["诸宗部","國圖善本佛典"],"order":2061,"guide":"","chunks":28,"toc":[{"level":3,"text":"序序一如来香序"},{"level":3,"text":"序"},{"level":3,"text":"唐沙門志寧序"},{"level":3,"text":"唐沙門慧研序"},{"level":3,"text":"明李贄小序"},{"level":3,"text":"序(上)序"},{"level":3,"text":"(附)唐沙門志寧序唐沙門志寧序"},{"level":3,"text":"(附)沙門慧研序沙門慧研序"},{"level":3,"text":"(附)明李卓吾小序明李卓吾小序"},{"level":3,"text":"畧釋新華嚴經修行次第決疑論序"},{"level":3,"text":"嚴品第一者。即眾篇義類之別目。大以曠兼無際。方"},{"level":3,"text":"序"},{"level":3,"text":"序(中)序"},{"level":2,"text":"畫。手迹宛然。悲喜太息。從是悟入。常以經卷四"},{"level":3,"text":"大方廣圓覺修多羅了義經畧疏注序"},{"level":2,"text":"為諸分之本。又是前古未傳。凡勒成四百卷八十五"},{"level":2,"text":"深。辭亦豐祕。凡五十九卷三十一"},{"level":3,"text":"序"},{"level":3,"text":"序(下)序"},{"level":2,"text":"億四千萬卷。其大卷萬"},{"level":2,"text":"長兩睂千卷萬"}],"chunksPerFile":20}