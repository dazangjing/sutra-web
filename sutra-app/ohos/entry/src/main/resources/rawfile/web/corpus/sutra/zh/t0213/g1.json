[[{"t":"法集要颂经瞋恚品第二十","level":3},{"t":"除瞋去我慢，远离诸烦恼，","level":0,"quote":true},{"t":"不染彼名色，冤家无有伴。","level":0,"quote":true},{"t":"除恚得善眠，恚尽不怀忧，","level":0,"quote":true},{"t":"恚为毒根本，苾刍为甘甜。","level":0,"quote":true},{"t":"贤圣悉能除，断彼善眠睡，","level":0,"quote":true},{"t":"人兴恚怒心，作诸不善业。","level":0,"quote":true},{"t":"后恚若得除，智火渐炽盛。","level":0,"quote":true},{"t":"无惭复无愧，复好生瞋怒，","level":0,"quote":true},{"t":"为瞋所缠缚，如暗失明灯。","level":0,"quote":true},{"t":"彼力非为力，以恚为力者，","level":0,"quote":true},{"t":"恚为凡朽法，不知善响应。","level":0,"quote":true},{"t":"有力近猛军，无力退怯弱，","level":0,"quote":true},{"t":"能忍为上将，宜当忍勿羸。","level":0,"quote":true},{"t":"举众共轻之，有力名为忍，","level":0,"quote":true},{"t":"能忍最为上，宜当怀忍羸。","level":0,"quote":true},{"t":"自我与彼人，大畏不可救，","level":0,"quote":true},{"t":"如知彼瞋恚，宜灭己中瑕，","level":0,"quote":true},{"t":"二俱行其义，我与彼亦然。","level":0,"quote":true},{"t":"如知彼瞋恚，宜忍彼中瑕，","level":0,"quote":true},{"t":"俱行於二义，我忍彼亦然。","level":0,"quote":true},{"t":"愚谓我无力，观法亦复尔，","level":0,"quote":true},{"t":"若愚胜於智，麁言及恶语，","level":0,"quote":true},{"t":"欲常得胜者，於言宜寂默。","level":0,"quote":true},{"t":"常习智者教，不与愚人集，","level":0,"quote":true},{"t":"能忍秽陋言，故说忍中上。","level":0,"quote":true},{"t":"恚者不发言，处众若屏处，","level":0,"quote":true},{"t":"人恚以炽然，终己不自觉。","level":0,"quote":true},{"t":"谛说不瞋恚，乞者念以施，","level":0,"quote":true},{"t":"三分有定处，自然处天宫。","level":0,"quote":true},{"t":"息意何有恚？自捡寿中明，","level":0,"quote":true},{"t":"等智定解脱，知已无有恚。","level":0,"quote":true},{"t":"若为恶意者，怒有怒果报，","level":0,"quote":true},{"t":"怒不报其怒，胜其彼鬪负。","level":0,"quote":true},{"t":"忍辱胜於怨，善胜不善者，","level":0,"quote":true},{"t":"胜者能施善，真诚胜欺善。","level":0,"quote":true},{"t":"无恚亦不害，恒念真实行，","level":0,"quote":true},{"t":"愚者自生恚，结冤常存在。","level":0,"quote":true},{"t":"恚能自制断，如止奔走车，","level":0,"quote":true},{"t":"是为善调御，去冥入光明。","level":0,"quote":true},{"t":"沙门及正道利养、怨、忆念","level":0,"quote":true},{"t":"清净、水兼华马、恚为第十","level":0,"quote":true}],[{"t":"法集要颂经如来品第二十一","level":3},{"t":"自获正觉最无等，一染世间一切法，","level":0,"quote":true},{"t":"具一切智力无畏，自然无师亦无证。","level":0,"quote":true},{"t":"自获正觉最无等，不染一切世间法，","level":0,"quote":true},{"t":"具一切智力无畏，自然无师无保证。","level":0,"quote":true},{"t":"善逝独证无等伦，应现世间成正道，","level":0,"quote":true},{"t":"如来诸天世中尊，一切神通智圆满。","level":0,"quote":true},{"t":"我为佛世尊，断漏无婬欲，","level":0,"quote":true},{"t":"诸天及世人，一切从吾心。","level":0,"quote":true},{"t":"我既无师保，亦独无伴侣，","level":0,"quote":true},{"t":"积诸行得佛，自然通圣道。","level":0,"quote":true},{"t":"己胜不受恶，一切世间胜，","level":0,"quote":true},{"t":"叡智廓无边，诱蒙吾为胜。","level":0,"quote":true},{"t":"今往波罗奈，欲击甘露鼓，","level":0,"quote":true},{"t":"当转於法轮，未曾有转者。","level":0,"quote":true},{"t":"智人不处愚，观世而随化，","level":0,"quote":true},{"t":"说於无垢迹，永息无有上。","level":0,"quote":true},{"t":"勇猛师子吼，正法名如来，","level":0,"quote":true},{"t":"法说及义说，觉者永安宁。","level":0,"quote":true},{"t":"勇健立静虑，出家日夜灭，","level":0,"quote":true},{"t":"诸天常卫护，为佛所称记。","level":0,"quote":true},{"t":"於彼天人中，叹说正等觉，","level":0,"quote":true},{"t":"速修而自觉，最后离胎身。","level":0,"quote":true},{"t":"说诸过去佛，及以当来者，","level":0,"quote":true},{"t":"现在正等觉，多除群生忧。","level":0,"quote":true},{"t":"尽皆尊重法，已敬今敬者，","level":0,"quote":true},{"t":"若当生恭敬，是谓佛法要。","level":0,"quote":true},{"t":"若欲自求要，正身最第一，","level":0,"quote":true},{"t":"信敬於正法，忆念佛教戒。","level":0,"quote":true},{"t":"诸有不信佛，如此群盲类，","level":0,"quote":true},{"t":"当堕於恶道，如商遇罗刹。","level":0,"quote":true},{"t":"船师能度水，精进为桥梁，","level":0,"quote":true},{"t":"人以种姓系，度者为勇健。","level":0,"quote":true},{"t":"如来无等伦，爱尽无所积，","level":0,"quote":true},{"t":"解脱心无漏，恩慧天世人。","level":0,"quote":true},{"t":"思惟二观行，善观二闲静，","level":0,"quote":true},{"t":"除冥超神仙，善获得自在。","level":0,"quote":true},{"t":"譬人立山顶，徧见村落人，","level":0,"quote":true},{"t":"审观法如是，如登楼观园。","level":0,"quote":true},{"t":"若人恒观察，烦恼永不生，","level":0,"quote":true},{"t":"降甘露法雨，连注无穷尽。","level":0,"quote":true}],[{"t":"法集要颂经多闻品第二十二","level":3},{"t":"多闻善能行，修善无烦恼，","level":0,"quote":true},{"t":"所行业障消，沙门获妙果。","level":0,"quote":true},{"t":"愚迷不觉知，好行不死法，","level":0,"quote":true},{"t":"善解知法者，病如芭蕉树。","level":0,"quote":true},{"t":"犹如盖屋密，暗冥无所见，","level":0,"quote":true},{"t":"虽有众妙色，有目不见明。","level":0,"quote":true},{"t":"犹如有一人，智达广博学，","level":0,"quote":true},{"t":"不闻则不知，善法及恶法。","level":0,"quote":true},{"t":"譬如执明烛，悉见诸色相，","level":0,"quote":true},{"t":"闻已尽能知，善恶之所趣。","level":0,"quote":true},{"t":"虽称为多闻，禁戒不具足，","level":0,"quote":true},{"t":"为法律所弹，所闻便有阙。","level":0,"quote":true},{"t":"行人虽少闻，禁戒悉具足，","level":0,"quote":true},{"t":"於法律所称，於闻便有阙。","level":0,"quote":true},{"t":"虽少多有闻，持戒不完具，","level":0,"quote":true},{"t":"二俱被呵责，所愿而皆失。","level":0,"quote":true},{"t":"多闻能持固，奉法为垣墙，","level":0,"quote":true},{"t":"精进难毁誉，从是三学成。","level":0,"quote":true},{"t":"多闻能奉法，智慧常定意，","level":0,"quote":true},{"t":"如彼阎浮金，孰能说有瑕。","level":0,"quote":true},{"t":"智博为多闻，持戒悉完具，","level":0,"quote":true},{"t":"二俱得称誉，所闻而尽获。","level":0,"quote":true},{"t":"多闻如宝镜，照法尽无餘，","level":0,"quote":true},{"t":"自照兼照他，二俱生喜悦。","level":0,"quote":true},{"t":"多闻如璎珞，自身先严饰，","level":0,"quote":true},{"t":"有情生喜悦，爱乐无穷尽。","level":0,"quote":true},{"t":"诸有称己色，有叹说名德，","level":0,"quote":true},{"t":"斯皆诸贪欲，然自不觉知。","level":0,"quote":true},{"t":"闻为知法律，解疑亦见正，","level":0,"quote":true},{"t":"从闻舍非法，行到不死处。","level":0,"quote":true},{"t":"内无人自知，外无人所见，","level":0,"quote":true},{"t":"内不见其果，便随声而住。","level":0,"quote":true},{"t":"内既而知之，外无人所见，","level":0,"quote":true},{"t":"二果俱已成，便随声而住。","level":0,"quote":true},{"t":"内有而所知，外有而所见，","level":0,"quote":true},{"t":"彼有其明智，不随声而住。","level":0,"quote":true},{"t":"耳识多所闻，眼识多所见，","level":0,"quote":true},{"t":"闻见不牢固，事由义析理。","level":0,"quote":true},{"t":"智牢善说快，闻知定意快，","level":0,"quote":true},{"t":"彼不用智定，速行放逸者。","level":0,"quote":true},{"t":"贤圣乐於法，所行应於口，","level":0,"quote":true},{"t":"以忍思惟空，闻意则牢固。","level":0,"quote":true}],[{"t":"法集要颂经己身品第二十三","level":3},{"t":"常习善语言，沙门思坐起，","level":0,"quote":true},{"t":"一坐而所乐，欲求於息心。","level":0,"quote":true},{"t":"一坐而一卧，独步而无伴，","level":0,"quote":true},{"t":"当自降伏心，自乐居山林。","level":0,"quote":true},{"t":"千千而为敌，一夫能胜之，","level":0,"quote":true},{"t":"莫若自伏心，便为战中胜。","level":0,"quote":true},{"t":"自胜而为上，如彼众生心，","level":0,"quote":true},{"t":"自降为大士，众行则具足。","level":0,"quote":true},{"t":"非天彦达嚩，非魔及梵天，","level":0,"quote":true},{"t":"弃胜最为上，如智慧苾刍。","level":0,"quote":true},{"t":"先自而正己，然后正他人，","level":0,"quote":true},{"t":"若自而正者，乃谓之上士。","level":0,"quote":true},{"t":"先自而正己，然后正他人，","level":0,"quote":true},{"t":"若自而正者，不侵名真智。","level":0,"quote":true},{"t":"当自而修剋，随其教训之，","level":0,"quote":true},{"t":"己不被教训，焉能教训他？","level":0,"quote":true},{"t":"念自而修剋，使彼而信解，","level":0,"quote":true},{"t":"我己意专心，智者所习学。","level":0,"quote":true},{"t":"为己或为彼，多有不成就，","level":0,"quote":true},{"t":"其有学此者，自正兼训彼。","level":0,"quote":true},{"t":"身全得存道，尔时岂容彼？","level":0,"quote":true},{"t":"己以被降伏，智者演其义。","level":0,"quote":true},{"t":"自己心为师，不随他为师，","level":0,"quote":true},{"t":"自己为师者，获真智人法。","level":0,"quote":true},{"t":"自己心为师，不依他为师，","level":0,"quote":true},{"t":"自己为师者，得誉获利乐。","level":0,"quote":true},{"t":"自己心为师，不依他为师，","level":0,"quote":true},{"t":"自己为师者，获智为天人。","level":0,"quote":true},{"t":"自己心为师，不依他为师，","level":0,"quote":true},{"t":"自己为师者，久受生天乐。","level":0,"quote":true},{"t":"自己心为师，不依他为师，","level":0,"quote":true},{"t":"自己为师者，亲族中最胜。","level":0,"quote":true},{"t":"自己心为师，不依他为师，","level":0,"quote":true},{"t":"自己为师者，烦恼中无忧。","level":0,"quote":true},{"t":"自己心为师，不依他为师，","level":0,"quote":true},{"t":"自己为师者，断除一切缚。","level":0,"quote":true},{"t":"自己心为师，不依他为师，","level":0,"quote":true},{"t":"自己为师者，能破诸恶趣。","level":0,"quote":true},{"t":"自己心为师，不依他为师，","level":0,"quote":true},{"t":"自己为师者，长作真智师。","level":0,"quote":true},{"t":"自己心为师，不依他为师，","level":0,"quote":true},{"t":"自己为师者，解脱一切苦。","level":0,"quote":true},{"t":"自己心为师，不依他为师，","level":0,"quote":true},{"t":"自己为师者，速证圆寂果。","level":0,"quote":true}],[{"t":"法集要颂经卷第三","level":2},{"t":"<strong>译者</strong>：尊者法救集","level":0},{"t":"西天中印度惹烂駄啰国密林寺三藏明教大师赐紫沙门臣天息灾奉　诏译","level":0}],[{"t":"法集要颂经广说品第二十四","level":3},{"t":"虽说百伽陀，句义不周正，","level":0,"quote":true},{"t":"不如解一句，闻乃得解脱。","level":0,"quote":true},{"t":"虽说百伽陀，不明有何益？","level":0,"quote":true},{"t":"不如解一义，闻乃得止息。","level":0,"quote":true},{"t":"虽解多伽陀，不行无所益，","level":0,"quote":true},{"t":"不如行一句，习行可得道。","level":0,"quote":true},{"t":"若人寿百岁，毁戒意不息，","level":0,"quote":true},{"t":"不如一日中，供养持戒人。","level":0,"quote":true},{"t":"若人寿百岁，懈怠劣精进，","level":0,"quote":true},{"t":"不如一日中，勇猛行精进。","level":0,"quote":true},{"t":"若人寿百岁，不观生灭法，","level":0,"quote":true},{"t":"不如一日中，而解生灭法。","level":0,"quote":true},{"t":"若人寿百岁，不观成败事，","level":0,"quote":true},{"t":"不如一日中，覩微知所忌。","level":0,"quote":true},{"t":"若人寿百岁，不见无漏句，","level":0,"quote":true},{"t":"不如一日中，得见无漏道。","level":0,"quote":true},{"t":"若人寿百岁，不见无动句，","level":0,"quote":true},{"t":"不如一日中，得见无动道。","level":0,"quote":true},{"t":"若人寿百岁，不覩难见句，","level":0,"quote":true},{"t":"不如一日中，得见微妙道。","level":0,"quote":true},{"t":"若人寿百岁，不见无生句，","level":0,"quote":true},{"t":"不如一日中，得见无生道。","level":0,"quote":true},{"t":"若人寿百岁，不见无作句，","level":0,"quote":true},{"t":"不如一日中，得见无作道。","level":0,"quote":true},{"t":"若人寿百岁，不见最上句，","level":0,"quote":true},{"t":"不如一日中，得见最上道。","level":0,"quote":true},{"t":"若人寿百岁，不见寂灭句，","level":0,"quote":true},{"t":"不如一日中，得见寂灭道。","level":0,"quote":true},{"t":"若人寿百岁，不见甘露句，","level":0,"quote":true},{"t":"不如一日中，得服甘露味。","level":0,"quote":true},{"t":"若人寿百岁，不见无垢句，","level":0,"quote":true},{"t":"不如一日中，得见清净道。","level":0,"quote":true},{"t":"若人寿百岁，不见离垢句，","level":0,"quote":true},{"t":"不如一日中，离垢得解脱。","level":0,"quote":true},{"t":"虽复寿百岁，山林祭火神，","level":0,"quote":true},{"t":"不如须臾间，观身而积行。","level":0,"quote":true},{"t":"虽复百岁中，山林祭火神，","level":0,"quote":true},{"t":"不如须臾间，正见得解脱。","level":0,"quote":true},{"t":"从月至於月，愚者用饮食，","level":0,"quote":true},{"t":"彼人不信佛，十六不获一。","level":0,"quote":true},{"t":"若人祷神祀，经岁望其福，","level":0,"quote":true},{"t":"彼於四分中，亦不获其一。","level":0,"quote":true},{"t":"从月至於月，愚者用饮食，","level":0,"quote":true},{"t":"不生慈愍心，十六不及一。","level":0,"quote":true},{"t":"从月至於月，愚者用饮食，","level":0,"quote":true},{"t":"彼不知法数，十六不及一。","level":0,"quote":true},{"t":"从月至於月，常行平等会，","level":0,"quote":true},{"t":"彼人不信佛，十六不及一。","level":0,"quote":true},{"t":"从月至於月，常行平等会，","level":0,"quote":true},{"t":"彼人不信法，十六不及一。","level":0,"quote":true},{"t":"从月至於月，常行平等会，","level":0,"quote":true},{"t":"彼人不信僧，十六不及一。","level":0,"quote":true},{"t":"月月常千祀，恒施於平等，","level":0,"quote":true},{"t":"彼无慈愍心，十六不及一。","level":0,"quote":true},{"t":"月月常千祀，恒施於平等，","level":0,"quote":true},{"t":"彼不恤蠕动，十六不及一。","level":0,"quote":true},{"t":"月月常千祀，恒施於平等，","level":0,"quote":true},{"t":"若无悲念心，十六不及一。","level":0,"quote":true},{"t":"月月常千祀，恒施於平等，","level":0,"quote":true},{"t":"彼怀怨恨心，十六不及一。","level":0,"quote":true},{"t":"月月常千祀，恒施於平等，","level":0,"quote":true},{"t":"不见择灭法，十六不及一。","level":0,"quote":true},{"t":"月月常千祀，终身而不辍，","level":0,"quote":true},{"t":"不如须臾间，一心念真法。","level":0,"quote":true},{"t":"一念福无边，胜彼终身祀，","level":0,"quote":true},{"t":"虽终百岁寿，奉事祀火神。","level":0,"quote":true},{"t":"不如须臾间，供养佛法僧，","level":0,"quote":true},{"t":"一念供养福，胜彼终身祀。","level":0,"quote":true}],[{"t":"法集要颂经善友品第二十五","level":3},{"t":"无信怀憎嫉，鬪乱彼此人，","level":0,"quote":true},{"t":"智者所弃嫌，愚习以为乐。","level":0,"quote":true},{"t":"有信无憎嫉，精进信多闻，","level":0,"quote":true},{"t":"智者所敬待，贤圣以为乐。","level":0,"quote":true},{"t":"不亲恶知识，不与非法会，","level":0,"quote":true},{"t":"亲近善知识，恒与正法会。","level":0,"quote":true},{"t":"行路念防虑，持戒多闻人，","level":0,"quote":true},{"t":"思虑无量境，闻彼善言教。","level":0,"quote":true},{"t":"各各知差别，近恶自陷溺，","level":0,"quote":true},{"t":"习善致名称。妙者恒自妙，","level":0,"quote":true},{"t":"此由身真正；善者终以善，","level":0,"quote":true},{"t":"斯由亲近善。智慧为最上，","level":0,"quote":true},{"t":"持戒永寂灭。","level":0,"quote":true},{"t":"如鱼凑臭烂，人贪竞取之，","level":0,"quote":true},{"t":"意者不觉臭，习恶亦如是。","level":0,"quote":true},{"t":"多誐波罗叶，众生往采取，","level":0,"quote":true},{"t":"叶薰香远布，习善亦如是。","level":0,"quote":true},{"t":"亲近恶知识，罪垢日夜增，","level":0,"quote":true},{"t":"如猪身不净，自污兼污他。","level":0,"quote":true},{"t":"己自不习恶，亲近习恶者，","level":0,"quote":true},{"t":"为人所轻笑，恶名日夜炽。","level":0,"quote":true},{"t":"观习而习之，知近而亲近，","level":0,"quote":true},{"t":"毒箭在其束，净者被其污。","level":0,"quote":true},{"t":"勇夫能除污，去恶不为伴，","level":0,"quote":true},{"t":"是故知果报，智人悉分别。","level":0,"quote":true},{"t":"非亲慎莫习，习当近於贤，","level":0,"quote":true},{"t":"苾刍修行道，忍苦尽诸漏。","level":0,"quote":true},{"t":"愚人尽形寿，承事明智人，","level":0,"quote":true},{"t":"亦不知真法，如杓斟酌食。","level":0,"quote":true},{"t":"智者须臾间，承事贤圣人，","level":0,"quote":true},{"t":"一一知真法，如舌了众味。","level":0,"quote":true},{"t":"智者寻一句，演出无量义，","level":0,"quote":true},{"t":"愚者诵千句，不解一句义。","level":0,"quote":true},{"t":"一句义成就，智者所修学，","level":0,"quote":true},{"t":"愚者好远离，真佛之所说。","level":0,"quote":true},{"t":"怨憎有智胜，不随亲友义，","level":0,"quote":true},{"t":"愚者训非道，渐趣地狱径。","level":0,"quote":true},{"t":"愚者自称愚，当知善黠慧，","level":0,"quote":true},{"t":"愚人自称智，是谓愚中甚。","level":0,"quote":true},{"t":"若复叹誉愚，毁訾智者身，","level":0,"quote":true},{"t":"毁智犹有胜，叹愚不为上。","level":0,"quote":true},{"t":"莫见愚闻声，亦莫与愚居，","level":0,"quote":true},{"t":"与愚同居难，犹如怨同处。","level":0,"quote":true},{"t":"莫见愚闻声，亦莫与愚居，","level":0,"quote":true},{"t":"与愚同居难，犹如怨同处。","level":0,"quote":true},{"t":"当选择共居，如与亲亲会，","level":0,"quote":true},{"t":"是故事多闻，并及持戒者。","level":0,"quote":true},{"t":"如是人中上，如月在众星。","level":0,"quote":true}],[{"t":"法集要颂经圆寂品第二十六","level":3},{"t":"如龟藏其六，苾刍摄意想，","level":0,"quote":true},{"t":"无倚无害彼，圆寂无言说。","level":0,"quote":true},{"t":"忍辱第一道，佛说圆寂最，","level":0,"quote":true},{"t":"不以怀烦热，害彼为沙门。","level":0,"quote":true},{"t":"言当莫麁犷，所说应辩才，","level":0,"quote":true},{"t":"少闻共论难，反受彼屈伏。","level":0,"quote":true},{"t":"数自兴烦恼，犹彼器败坏，","level":0,"quote":true},{"t":"生死数流转，长没无出期。","level":0,"quote":true},{"t":"若不自烦恼，犹器完牢具，","level":0,"quote":true},{"t":"如是至圆寂，永无诸尘翳。","level":0,"quote":true},{"t":"无病第一利，知足第一富，","level":0,"quote":true},{"t":"知亲第一友，圆寂第一乐。","level":0,"quote":true},{"t":"饥为第一患，行为第一苦，","level":0,"quote":true},{"t":"如实知此者，圆寂第一乐。","level":0,"quote":true},{"t":"最妙圣言教，流布无穷际，","level":0,"quote":true},{"t":"世共传习者，实无有厌时。","level":0,"quote":true},{"t":"如是无等伦，所说善言教，","level":0,"quote":true},{"t":"身苦所逼迫，何过饥患苦？","level":0,"quote":true},{"t":"趣善之徒少，趣恶之徒多，","level":0,"quote":true},{"t":"如实知此者，速求於圆寂。","level":0,"quote":true},{"t":"有缘生善处，有缘生恶趣，","level":0,"quote":true},{"t":"有缘般涅槃，如斯皆有缘。","level":0,"quote":true},{"t":"鹿归於田野，鸟归於虚空，","level":0,"quote":true},{"t":"义归於分别，真人归寂灭。","level":0,"quote":true},{"t":"不以懈怠意，怯弱有所至，","level":0,"quote":true},{"t":"欲求於圆寂，焚烧诸缚著。","level":0,"quote":true},{"t":"苾刍速杼船，以杼便当轻，","level":0,"quote":true},{"t":"求断贪欲情，然后至圆寂。","level":0,"quote":true},{"t":"我有本以无，本有我今无，","level":0,"quote":true},{"t":"非无亦非有，如今不可获。","level":0,"quote":true},{"t":"难见谛不动，善观而不动，","level":0,"quote":true},{"t":"当察爱尽源，是谓名业际。","level":0,"quote":true},{"t":"断爱除其欲，竭河无流兆，","level":0,"quote":true},{"t":"能明此爱本，是谓名苦际。","level":0,"quote":true},{"t":"无身灭其想，诸痛得清凉，","level":0,"quote":true},{"t":"众行永止息，识想不复兴。","level":0,"quote":true},{"t":"如实知此者，是谓名苦际，","level":0,"quote":true},{"t":"住动虚则静，非近非有乐。","level":0,"quote":true},{"t":"无动得轻安，静乃获圆寂，","level":0,"quote":true},{"t":"亦不由往来，往来绝生灭。","level":0,"quote":true},{"t":"老死烦恼除，断苦获圆寂，","level":0,"quote":true},{"t":"吾已无往来，不去而不来，","level":0,"quote":true},{"t":"不没不复生，此际名圆寂。","level":0,"quote":true},{"t":"智生之本末，有为知无为，","level":0,"quote":true},{"t":"生死所缠缚，缚者而难制。","level":0,"quote":true},{"t":"如是四大身，五蕴苦恼集，","level":0,"quote":true},{"t":"安住观实苦，尽苦获圆寂。","level":0,"quote":true},{"t":"诸法无往来，往来恒生灭，","level":0,"quote":true},{"t":"老病死迁流，无漏获圆寂。","level":0,"quote":true},{"t":"苾刍有世生，有造无作行，","level":0,"quote":true},{"t":"有无生无有，无作无所行。","level":0,"quote":true},{"t":"苾刍吾已知，无复诸地入，","level":0,"quote":true},{"t":"无有虚空入，无诸入用入。","level":0,"quote":true},{"t":"无想非想入，无今世后世，","level":0,"quote":true},{"t":"亦无日月想，无往亦无来。","level":0,"quote":true},{"t":"从食因缘有，从食致忧乐，","level":0,"quote":true},{"t":"而此要灭者，诸苦法已尽。","level":0,"quote":true},{"t":"非食命不济，孰能不搏食？","level":0,"quote":true},{"t":"夫立食为先，然后乃至道。","level":0,"quote":true},{"t":"地种及水火，是时风无吹，","level":0,"quote":true},{"t":"光焰所不照，亦不见其实。","level":0,"quote":true},{"t":"非月非有光，非日非有照，","level":0,"quote":true},{"t":"审谛观此者，乃应真圆寂。","level":0,"quote":true},{"t":"端正色纵容，得脱一切苦，","level":0,"quote":true},{"t":"非色非无色，得脱第一苦。","level":0,"quote":true},{"t":"究竟不恐惧，越缚无狐疑，","level":0,"quote":true},{"t":"未断有欲刺，岂知身为患？","level":0,"quote":true},{"t":"所谓究竟者，圆寂为第一，","level":0,"quote":true},{"t":"尽断诸想著，文句不错谬。","level":0,"quote":true},{"t":"知节不知节，最胜舍有行，","level":0,"quote":true},{"t":"内自思惟行，如卵坏其膜。","level":0,"quote":true},{"t":"众施法施胜，众乐法乐上，","level":0,"quote":true},{"t":"众力忍力最，爱尽圆寂乐。","level":0,"quote":true}],[{"t":"法集要颂经观察品第二十七","level":3},{"t":"善观己瑕隙，使己不露外，","level":0,"quote":true},{"t":"彼彼自有隙，如彼飞轻尘。","level":0,"quote":true},{"t":"若己称无瑕，罪福俱并至，","level":0,"quote":true},{"t":"但见他人隙，恒怀无明想。","level":0,"quote":true},{"t":"知惭寿中上，焉以贪牵缚，","level":0,"quote":true},{"t":"力士无畏忌，斯等命短促。","level":0,"quote":true},{"t":"知惭不尽寿，恒求清净行，","level":0,"quote":true},{"t":"威仪不缺漏，当观真净寿。","level":0,"quote":true},{"t":"世间普盲冥，智眼尠尠耳，","level":0,"quote":true},{"t":"群鸟堕罗网，生天不足言。","level":0,"quote":true},{"t":"观世衰耗法，但见众色变，","level":0,"quote":true},{"t":"愚者自系缚，为暗所缠绕，","level":0,"quote":true},{"t":"亦不见於行，观而无所有。","level":0,"quote":true},{"t":"众生皆有我，为彼而生患，","level":0,"quote":true},{"t":"一一不相见，不覩邪见刺。","level":0,"quote":true},{"t":"观此刺因缘，众生多染著，","level":0,"quote":true},{"t":"我造彼非有，彼造非我有。","level":0,"quote":true},{"t":"众生为慢缠，染著於憍慢，","level":0,"quote":true},{"t":"为见所迷惑，不免生死际。","level":0,"quote":true},{"t":"已得与当得，二俱受尘垢，","level":0,"quote":true},{"t":"习於病根本，及觉诸所学。","level":0,"quote":true},{"t":"观诸持戒者，梵行清净人，","level":0,"quote":true},{"t":"瞻侍病瘦者，是谓至边际。","level":0,"quote":true},{"t":"当观水上泡，亦观幻野马，","level":0,"quote":true},{"t":"如是不观身，亦不见死至。","level":0,"quote":true},{"t":"当观水上泡，亦观幻野马，","level":0,"quote":true},{"t":"如是不观世，亦不见死王。","level":0,"quote":true},{"t":"如是当观身，如王杂色车，","level":0,"quote":true},{"t":"愚者所染著，善求远离彼。","level":0,"quote":true},{"t":"如是当观身，如王杂色车，","level":0,"quote":true},{"t":"愚者所染著，智者远离之。","level":0,"quote":true},{"t":"如是当观身，众病之所因，","level":0,"quote":true},{"t":"病与愚合会，焉能可恃怙？","level":0,"quote":true},{"t":"当观畫形像，摩尼绀青发，","level":0,"quote":true},{"t":"愚者以为缘，不求越彼岸。","level":0,"quote":true},{"t":"当观畫形像，摩尼绀青发，","level":0,"quote":true},{"t":"愚者以为缘，智者所厌患。","level":0,"quote":true},{"t":"强以彩畫形，庄严丑秽身，","level":0,"quote":true},{"t":"愚者以为缘，亦不求自度。","level":0,"quote":true},{"t":"爪发为八分，双部眼耳珰，","level":0,"quote":true},{"t":"愚者所染著，亦不求自度。","level":0,"quote":true},{"t":"著欲染於欲，不究结使缘，","level":0,"quote":true},{"t":"不以生结使，当度欲有流。","level":0,"quote":true},{"t":"非园脱於园，脱园复就园，","level":0,"quote":true},{"t":"当复观此人，脱缚复就缚。","level":0,"quote":true},{"t":"今舍天王位，不造生死本，","level":0,"quote":true},{"t":"求离地狱苦，愿说圆寂乐。","level":0,"quote":true},{"t":"青衣白盖身，御者御一轮，","level":0,"quote":true},{"t":"观彼未离垢，求便断缚著。","level":0,"quote":true},{"t":"人多求自归，山川树木神，","level":0,"quote":true},{"t":"园观及神祀，望免苦患难。","level":0,"quote":true},{"t":"此非自归上，亦非有吉利，","level":0,"quote":true},{"t":"如有自归者，不脱一切苦。","level":0,"quote":true},{"t":"若有自归佛，及法苾刍僧，","level":0,"quote":true},{"t":"修习圣四谛，如慧之所见，","level":0,"quote":true},{"t":"苦因缘苦生，当越此苦本，","level":0,"quote":true},{"t":"贤圣八品道，灭尽甘露际。","level":0,"quote":true},{"t":"是为自归上，非不有吉利，","level":0,"quote":true},{"t":"如有自归者，得脱一切苦。","level":0,"quote":true},{"t":"观已观当观，不观亦当观，","level":0,"quote":true},{"t":"观而复重观，观而不复观。","level":0,"quote":true},{"t":"观而复重观，分别彼性本，","level":0,"quote":true},{"t":"计昼以为夜，宝身坏不久。","level":0,"quote":true},{"t":"观而不重观，虽见亦不见，","level":0,"quote":true},{"t":"如见而不见，观而亦不见。","level":0,"quote":true},{"t":"云何见不见？何说见不见？","level":0,"quote":true},{"t":"因何见不见？因为出何见。","level":0,"quote":true},{"t":"犹若不观苦，常当深自观，","level":0,"quote":true},{"t":"以解苦根原，是为明妙观。","level":0,"quote":true},{"t":"谁令凡夫人，不观众行本？","level":0,"quote":true},{"t":"因彼而观察，去冥见大明。","level":0,"quote":true}],[{"t":"法集要颂经罪障品第二十八","level":3},{"t":"诸恶业莫作，诸善业奉行，","level":0,"quote":true},{"t":"自净其意行，是名诸佛教。","level":0,"quote":true},{"t":"惠施获福报，不藏恚怒怀，","level":0,"quote":true},{"t":"以善灭其恶，欲怒痴无餘。","level":0,"quote":true},{"t":"独行勿逐愚，欲群当逐智，","level":0,"quote":true},{"t":"智者灭其恶，如鹤择乳饮。","level":0,"quote":true},{"t":"观世若干变，知法起灭迹，","level":0,"quote":true},{"t":"贤圣不乐世，愚者不处贤。","level":0,"quote":true},{"t":"解知念待味，思惟休息义，","level":0,"quote":true},{"t":"无热无饥想，当服於法味。","level":0,"quote":true},{"t":"人不损其心，亦不毁其意，","level":0,"quote":true},{"t":"以善永灭恶，不忧随恶道。","level":0,"quote":true},{"t":"人欲鍊其神，要当数修琢，","level":0,"quote":true},{"t":"智者易雕饰，乃名世之雄。","level":0,"quote":true},{"t":"能亲近彼者，安隐无忧恼，","level":0,"quote":true},{"t":"永息无过者，柔和不卒暴，","level":0,"quote":true},{"t":"吹弃诸恶法，如风落其叶。","level":0,"quote":true},{"t":"无故畏彼人，谤毁清净者，","level":0,"quote":true},{"t":"寻恶获其力，烟云风所吹。","level":0,"quote":true},{"t":"人之为善恶，各各自知之，","level":0,"quote":true},{"t":"修善得善果，为恶随恶趣。","level":0,"quote":true},{"t":"达己净不净，何虑他人净？","level":0,"quote":true},{"t":"愚者不自鍊，如铁钻纯钢。","level":0,"quote":true},{"t":"若眼见非邪，黠人求方便，","level":0,"quote":true},{"t":"智者善寿世，亦不为众恶。","level":0,"quote":true},{"t":"商人在路惧，伴少而货多，","level":0,"quote":true},{"t":"经过险难处，然有折轴忧。","level":0,"quote":true},{"t":"有身无疮疣，不为毒所害，","level":0,"quote":true},{"t":"毒无奈疮何？无恶无所造。","level":0,"quote":true},{"t":"多有行众恶，必为身作累，","level":0,"quote":true},{"t":"施善布恩德，此事甚为难。","level":0,"quote":true},{"t":"善哉修善者，伤哉为甚恶，","level":0,"quote":true},{"t":"恶恶自为易，恶人为善难。","level":0,"quote":true},{"t":"愚者自谓正，犹恶不成熟，","level":0,"quote":true},{"t":"恶已成熟满，诸苦亦复熟。","level":0,"quote":true},{"t":"贤者见於恶，不为恶所熟，","level":0,"quote":true},{"t":"如恶以不熟，恶者观其恶。","level":0,"quote":true},{"t":"贤者观其恶，乃至贤不熟，","level":0,"quote":true},{"t":"设以贤熟者，贤贤自相观。","level":0,"quote":true},{"t":"人虽为恶行，亦不数数行，","level":0,"quote":true},{"t":"於彼意不乐，知恶之为苦。","level":0,"quote":true},{"t":"人能作其福，亦当数数造，","level":0,"quote":true},{"t":"於彼意愿乐，善爱其福报。","level":0,"quote":true},{"t":"先当制善心，摄持恶根本，","level":0,"quote":true},{"t":"由是兴福业，心由乐於恶。","level":0,"quote":true},{"t":"为恶虽复少，后世受苦深，","level":0,"quote":true},{"t":"当获无边福，如毒在心腹。","level":0,"quote":true},{"t":"为福虽微少，后受大福德，","level":0,"quote":true},{"t":"当获大果报，如种获真实。","level":0,"quote":true},{"t":"无过而强轻，无恚而强侵，","level":0,"quote":true},{"t":"当於十品处，便当趣於彼。","level":0,"quote":true},{"t":"痛痒语麤犷，此形必坏败，","level":0,"quote":true},{"t":"众病所逼切，心乱而不定。","level":0,"quote":true},{"t":"宗族别离散，财货费耗尽，","level":0,"quote":true},{"t":"为贼所劫掠，所愿不从意。","level":0,"quote":true},{"t":"或复无数变，为火所焚烧，","level":0,"quote":true},{"t":"身坏无智慧，亦趣於十品。","level":0,"quote":true},{"t":"作恶勿言无，人作言无罪，","level":0,"quote":true},{"t":"屏隈言无罪，斯皆有证验。","level":0,"quote":true},{"t":"作恶言有忧，久作亦言忧，","level":0,"quote":true},{"t":"忧屏隈亦言，忧彼报亦忧。","level":0,"quote":true},{"t":"此忧彼亦忧，恶行二俱忧，","level":0,"quote":true},{"t":"彼忧彼受报，见行乃审知。","level":0,"quote":true},{"t":"此喜彼亦喜，福行二俱喜，","level":0,"quote":true},{"t":"彼行彼受报，见行自清净。","level":0,"quote":true},{"t":"此煮彼亦煮，罪行二俱煮，","level":0,"quote":true},{"t":"彼煮彼受报，见行自有验。","level":0,"quote":true},{"t":"作福不作恶，皆由宿行法，","level":0,"quote":true},{"t":"终不畏死径，如船截流渡。","level":0,"quote":true}],[{"t":"法集要颂经相应品第二十九","level":3},{"t":"夜光照于冥，至日未出间，","level":0,"quote":true},{"t":"日光布大明，夜光便黤黮。","level":0,"quote":true},{"t":"察者布光明，如来未出顷，","level":0,"quote":true},{"t":"佛出放大明，无察无声闻。","level":0,"quote":true},{"t":"不坚起坚想，坚起不坚想，","level":0,"quote":true},{"t":"后不至於坚，由起邪见故。","level":0,"quote":true},{"t":"坚而知坚者，不坚知不坚，","level":0,"quote":true},{"t":"彼人求於坚，正治以为本。","level":0,"quote":true},{"t":"愚者以为坚，反被九结缚，","level":0,"quote":true},{"t":"如鸟堕罗网，斯由爱深固。","level":0,"quote":true},{"t":"诸有怀狐疑，今世及后世，","level":0,"quote":true},{"t":"禅定尽能灭，无恼修梵行。","level":0,"quote":true},{"t":"无尘离於尘，能持此服者，","level":0,"quote":true},{"t":"无御无所至，","level":0,"quote":true},{"t":"此不应法服。若能除垢秽，","level":0,"quote":true},{"t":"修戒等慧定，彼应思惟业，","level":0,"quote":true},{"t":"此应服袈裟。不以柔和言，","level":0,"quote":true},{"t":"名称有所至，人有善颜色，","level":0,"quote":true},{"t":"乃怀巧伪心，有能断是者，","level":0,"quote":true},{"t":"永拔其根本。","level":0,"quote":true},{"t":"智者除诸秽，乃名为善色，","level":0,"quote":true},{"t":"不以色纵容，暂覩知人意。","level":0,"quote":true},{"t":"世多违行人，游荡在世界，","level":0,"quote":true},{"t":"如彼虚伪𨱎，其中纯有铜。","level":0,"quote":true},{"t":"独游无畏忌，内秽外不净，","level":0,"quote":true},{"t":"贪餮不自节，三转随时行，","level":0,"quote":true},{"t":"如圈被养猪，数数受胞胎。","level":0,"quote":true},{"t":"人能专其意，於食知止足，","level":0,"quote":true},{"t":"趣欲支其形，养寿守其道，","level":0,"quote":true},{"t":"观净而自净。诸根不具足，","level":0,"quote":true},{"t":"於食无厌足，斯等凡品行，","level":0,"quote":true},{"t":"转增於欲意。如屋坏穿漏，","level":0,"quote":true},{"t":"当观不净行，诸根无缺漏，","level":0,"quote":true},{"t":"於食知止足。有信执精进，","level":0,"quote":true},{"t":"不恣於欲意，如风吹泰山。","level":0,"quote":true},{"t":"空闲甚可乐，然人不乐彼，","level":0,"quote":true},{"t":"无欲常居之，非欲之所处。","level":0,"quote":true},{"t":"难移难可动，如彼重雪山，","level":0,"quote":true},{"t":"非贤则不现，犹夜射冥室。","level":0,"quote":true},{"t":"贤者有千数，智者在丛林，","level":0,"quote":true},{"t":"义理极深邃，智者所分别。","level":0,"quote":true},{"t":"多有众生类，非射而不值，","level":0,"quote":true},{"t":"今观此义理，无戒人所耻。","level":0,"quote":true},{"t":"观有知恐怖，变易知有无，","level":0,"quote":true},{"t":"是故不乐有，当念远离有。","level":0,"quote":true},{"t":"无信无反复，穿墙而盗窃，","level":0,"quote":true},{"t":"断彼希望思，是名为勇士。","level":0,"quote":true},{"t":"除其父母缘，王家及二种，","level":0,"quote":true},{"t":"徧灭其境界，无垢为梵行。","level":0,"quote":true},{"t":"若人无所依，知彼所贵食，","level":0,"quote":true},{"t":"空及无相愿，思惟以为行。","level":0,"quote":true},{"t":"鸟飞於虚空，而无足迹现，","level":0,"quote":true},{"t":"如彼行行人，言说无所趣。","level":0,"quote":true},{"t":"诸能断有本，不依於未然，","level":0,"quote":true},{"t":"空及无相愿，思惟以为行。","level":0,"quote":true},{"t":"希有诸众生，多不顺其性，","level":0,"quote":true},{"t":"有度不度者，为灭甚为难。","level":0,"quote":true},{"t":"诸有平等说，法法共相观，","level":0,"quote":true},{"t":"尽断诸结使，无复有热恼。","level":0,"quote":true},{"t":"行路无复忧，终日得解脱，","level":0,"quote":true},{"t":"一切结使尽，无复有众恼。","level":0,"quote":true},{"t":"如鸟飞虚空，而无有所碍，","level":0,"quote":true},{"t":"彼人获无漏，空无相愿定。","level":0,"quote":true},{"t":"如鸟飞虚空，而无有所碍，","level":0,"quote":true},{"t":"行人到彼岸，空无相愿定。","level":0,"quote":true},{"t":"无造无有造，造者受烦恼，","level":0,"quote":true},{"t":"非造非无造，前忧后亦忧。","level":0,"quote":true},{"t":"造者为善妙，以作不怀忧，","level":0,"quote":true},{"t":"造而乐而造，生天受欢乐。","level":0,"quote":true},{"t":"虚空无辙迹，沙门无外意，","level":0,"quote":true},{"t":"众人尽乐恶，唯佛净无秽。","level":0,"quote":true},{"t":"虚空无辙迹，沙门无外意，","level":0,"quote":true},{"t":"世间皆无常，佛无我所有。","level":0,"quote":true},{"t":"诸天及世人，一切行相应，","level":0,"quote":true},{"t":"得脱一切苦，离爱免轮回。","level":0,"quote":true},{"t":"诸天及世人，一切行相应，","level":0,"quote":true},{"t":"能远诸恶业，不堕於恶趣。","level":0,"quote":true},{"t":"亦复不知论，贤愚无差别，","level":0,"quote":true},{"t":"若复知论义，所说无垢迹。","level":0,"quote":true},{"t":"说应法议论，当竖仙人幢，","level":0,"quote":true},{"t":"法幢为仙人，仙人为法幢。","level":0,"quote":true},{"t":"或有寂然骂，或有在众骂，","level":0,"quote":true},{"t":"或有未声骂，世无不骂者。","level":0,"quote":true},{"t":"一毁及一誉，但利养其名，","level":0,"quote":true},{"t":"非有亦非有，则亦不可知。","level":0,"quote":true},{"t":"智人所称誉，若好兼及丑，","level":0,"quote":true},{"t":"智人无缺漏，慧定得解脱。","level":0,"quote":true},{"t":"如紫磨真金，内外彻清净，","level":0,"quote":true},{"t":"犹如安明山，不为风所动，","level":0,"quote":true},{"t":"智人亦如是，不为毁誉动。","level":0,"quote":true},{"t":"如树无有根，无枝况有叶？","level":0,"quote":true},{"t":"健者以解缚，谁能毁其德？","level":0,"quote":true},{"t":"无垢无有住，身壍种苦子，","level":0,"quote":true},{"t":"最胜无有爱，天世人不知。","level":0,"quote":true},{"t":"犹如网丛林，无爱况有餘？","level":0,"quote":true},{"t":"佛有无量行，无迹谁迹将？","level":0,"quote":true},{"t":"若有不欲生，以生不受有，","level":0,"quote":true},{"t":"佛有无量行，无迹谁迹将？","level":0,"quote":true},{"t":"若欲灭其想，内外无诸因，","level":0,"quote":true},{"t":"亦无过色想，四应不受生。","level":0,"quote":true},{"t":"舍前及舍后，舍间越於有，","level":0,"quote":true},{"t":"一切尽皆舍，不复受生老。","level":0,"quote":true}],[{"t":"法集要颂经卷第四","level":2},{"t":"<strong>译者</strong>：尊者法救集","level":0},{"t":"西天中印度惹烂駄啰国密林寺三藏明教大师赐紫沙门臣天息灾奉　诏译","level":0}],[{"t":"法集要颂经乐品第三十","level":3},{"t":"忍胜则怨贼，自负则自鄙，","level":0,"quote":true},{"t":"息意则快乐，无胜无负心。","level":0,"quote":true},{"t":"若人扰乱彼，自求安乐世，","level":0,"quote":true},{"t":"遂成其怨憎，终不得解脱。","level":0,"quote":true},{"t":"善乐於爱欲，以杖加群生，","level":0,"quote":true},{"t":"於中自求安，后世不得乐。","level":0,"quote":true},{"t":"人欲得欢乐，杖不加群生，","level":0,"quote":true},{"t":"於中自求乐，后世亦得乐。","level":0,"quote":true},{"t":"乐法乐学行，慎莫行恶法，","level":0,"quote":true},{"t":"能善行法者，今世后世乐。","level":0,"quote":true},{"t":"护法行法者，修法获善报，","level":0,"quote":true},{"t":"此应法律教，行法不趣恶。","level":0,"quote":true},{"t":"护法行法者，如盖覆其形，","level":0,"quote":true},{"t":"此应法律教，行法不趣恶。","level":0,"quote":true},{"t":"恶行入地狱，所生堕恶道，","level":0,"quote":true},{"t":"非法自陷溺，如手把蚖蛇。","level":0,"quote":true},{"t":"不以法非法，二事俱同报，","level":0,"quote":true},{"t":"非法入地狱，正法生於天。","level":0,"quote":true},{"t":"施与战同处，此德智不誉，","level":0,"quote":true},{"t":"施时亦战时，此事二俱等。","level":0,"quote":true},{"t":"人遭百千变，等除憍慢怨，","level":0,"quote":true},{"t":"时施清净心，健夫最为胜。","level":0,"quote":true},{"t":"忍少得胜多，戒胜懈怠多，","level":0,"quote":true},{"t":"有信慧施者，后身受善报。","level":0,"quote":true},{"t":"快乐施福报，所愿皆全成，","level":0,"quote":true},{"t":"速得第一灭，渐入无为际。","level":0,"quote":true},{"t":"若彼求方便，贤圣智慧施，","level":0,"quote":true},{"t":"尽其苦原本，当知获大报。","level":0,"quote":true},{"t":"爱法善安隐，心意洁清净，","level":0,"quote":true},{"t":"贤圣所说法，智者所娱乐。","level":0,"quote":true},{"t":"若人心乐禅，亦复乐不起，","level":0,"quote":true},{"t":"亦乐四意止，并及七觉意，","level":0,"quote":true},{"t":"及彼四神足，贤圣八品道，","level":0,"quote":true},{"t":"善乐於抟食，善乐摄法服，","level":0,"quote":true},{"t":"善乐於经行，乐处於山薮，","level":0,"quote":true},{"t":"已逮安乐处，现法而无为。","level":0,"quote":true},{"t":"已越诸恐惧，超世诸染著，","level":0,"quote":true},{"t":"善乐於念持，善观於诸法。","level":0,"quote":true},{"t":"善哉世无害，养育众生类，","level":0,"quote":true},{"t":"世无欲爱乐，越诸染著意，","level":0,"quote":true},{"t":"能灭己憍慢，此名第一乐。","level":0,"quote":true},{"t":"耆年持戒乐，有信成就乐；","level":0,"quote":true},{"t":"分别义趣乐，不造众恶业；","level":0,"quote":true},{"t":"世有父母乐，众集和亦乐；","level":0,"quote":true},{"t":"世有沙门乐，静志乐亦然；","level":0,"quote":true},{"t":"诸佛出兴乐，说法堪受乐；","level":0,"quote":true},{"t":"众僧和合乐，和则常有安；","level":0,"quote":true},{"t":"持戒完具乐，多闻广知乐。","level":0,"quote":true},{"t":"覩见真人乐，解脱行迹乐，","level":0,"quote":true},{"t":"德水清凉乐，法财自集快。","level":0,"quote":true},{"t":"得智明慧快，灭慢无邪快，","level":0,"quote":true},{"t":"得覩诸贤乐，同会亦复乐。","level":0,"quote":true},{"t":"不与愚从事，毕固永已乐，","level":0,"quote":true},{"t":"不与愚从事，经历无数日。","level":0,"quote":true},{"t":"与愚同居难，如与怨憎会，","level":0,"quote":true},{"t":"与智同处易，如共亲亲会。","level":0,"quote":true},{"t":"人智甚难遇，终不虚托生，","level":0,"quote":true},{"t":"设当托生处，彼家必蒙庆。","level":0,"quote":true},{"t":"一切得安隐，梵志取灭度，","level":0,"quote":true},{"t":"不为欲所染，尽脱於诸处。","level":0,"quote":true},{"t":"尽断不祥结，降伏内烦恼，","level":0,"quote":true},{"t":"永息得睡眠，心识得清彻。","level":0,"quote":true},{"t":"慎莫著於乐，当就护来行，","level":0,"quote":true},{"t":"当念舍於世，观於快乐事。","level":0,"quote":true},{"t":"如世欲欢乐，及彼天上乐，","level":0,"quote":true},{"t":"此名为爱极，十六未获一。","level":0,"quote":true},{"t":"欲舍於重担，更不造重业，","level":0,"quote":true},{"t":"重担世之苦，能舍最快乐。","level":0,"quote":true},{"t":"尽断诸爱欲，及灭一切行，","level":0,"quote":true},{"t":"并灭五蕴本，更不受三有。","level":0,"quote":true},{"t":"义聚则有乐，朋友食福乐，","level":0,"quote":true},{"t":"彼灭寂然乐，展转普及人。","level":0,"quote":true},{"t":"苦以乐为本，犹彼焰火炉，","level":0,"quote":true},{"t":"赫焰而炽然，渐渐而还灭。","level":0,"quote":true},{"t":"不知所凑处，如是等见人，","level":0,"quote":true},{"t":"免於爱欲泥，去亦无处所。","level":0,"quote":true},{"t":"以获无动乐，中间无有恚，","level":0,"quote":true},{"t":"有变易不停，除忧无有愁。","level":0,"quote":true},{"t":"寂然观世有，有乐无有恼，","level":0,"quote":true},{"t":"正法而多闻，设见有所损。","level":0,"quote":true},{"t":"人人贪於色，无结世善寿，","level":0,"quote":true},{"t":"大法知结源，人当明结瑕。","level":0,"quote":true},{"t":"人人心缚著，亦缚於色本，","level":0,"quote":true},{"t":"一切受辱苦，一切任己乐。","level":0,"quote":true},{"t":"胜负自然兴，竟不有所获，","level":0,"quote":true},{"t":"诸欲得乐寿，能忍彼轻报。","level":0,"quote":true},{"t":"忍者忍於人，不忍处诸有，","level":0,"quote":true},{"t":"诸欲得乐寿，於惑而无惑。","level":0,"quote":true},{"t":"惑者惑於人，我斯无有惑，","level":0,"quote":true},{"t":"诸欲得乐寿，终己无结者。","level":0,"quote":true},{"t":"当食於念食，如彼光音天，","level":0,"quote":true},{"t":"恒以念为食，意身无所烧。","level":0,"quote":true},{"t":"众生见苦乐，圣法无损坏，","level":0,"quote":true},{"t":"虽值触乐迹，无迹焉有触。","level":0,"quote":true},{"t":"如苾刍在定，不著一切垢，","level":0,"quote":true},{"t":"众生遭苦乐，而不能觉知。","level":0,"quote":true},{"t":"如来与多闻己身、广、善友","level":0,"quote":true},{"t":"圆寂、观、罪障相应、乐第十","level":0,"quote":true}],[{"t":"法集要颂经护心品第三十一","level":3},{"t":"心轻难调伏，为欲所居怀，","level":0,"quote":true},{"t":"降心则为善，以降便轻安。","level":0,"quote":true},{"t":"如鱼在旱地，以离於深渊，","level":0,"quote":true},{"t":"心识极惶惧，魔众而奔驰。","level":0,"quote":true},{"t":"心走非一处，犹如日光明，","level":0,"quote":true},{"t":"智者所能制，如钩止恶象。","level":0,"quote":true},{"t":"今我论此心，无坚不可见，","level":0,"quote":true},{"t":"我今欲训诲，慎莫生瑕隟。","level":0,"quote":true},{"t":"汝心莫游行，恣意而放逸，","level":0,"quote":true},{"t":"我今还摄汝，如御暴逸象。","level":0,"quote":true},{"t":"生死无有量，往来无端绪，","level":0,"quote":true},{"t":"求於屋舍者，数数受胞胎。","level":0,"quote":true},{"t":"以观此居屋，更不造诸舍，","level":0,"quote":true},{"t":"梁栈看已坏，台阁则摧折。","level":0,"quote":true},{"t":"心已离诸行，中间是己心，","level":0,"quote":true},{"t":"心多为轻躁，难持难调护。","level":0,"quote":true},{"t":"智者能自正，如匠搦箭直，","level":0,"quote":true},{"t":"有恚则知恚，有恚知有恚。","level":0,"quote":true},{"t":"是意皆自造，非干父母为，","level":0,"quote":true},{"t":"除邪就正定，为福勿回复。","level":0,"quote":true},{"t":"盖屋若不密，天雨则常漏，","level":0,"quote":true},{"t":"人不思惟行，恒历婬怒痴。","level":0,"quote":true},{"t":"盖屋若不密，天雨则常漏，","level":0,"quote":true},{"t":"人自思惟行，永无婬怒痴。","level":0,"quote":true},{"t":"心为诸法本，心尊是心使，","level":0,"quote":true},{"t":"心若念恶行，即言即恶行，","level":0,"quote":true},{"t":"罪苦自追随，车轹终于辙，","level":0,"quote":true},{"t":"心为诸法本，心尊是心使，","level":0,"quote":true},{"t":"心若念善行，即言即善行，","level":0,"quote":true},{"t":"福庆自追随，如影随其形。","level":0,"quote":true},{"t":"不以不净意，亦及瞋怒人，","level":0,"quote":true},{"t":"欲得知法者，正等觉所说。","level":0,"quote":true},{"t":"诸有除贡高，心意极清净，","level":0,"quote":true},{"t":"能舍伤害怀，乃得闻正法。","level":0,"quote":true},{"t":"心不住止息，亦不知善法，","level":0,"quote":true},{"t":"迷於出世事，无有正知见。","level":0,"quote":true},{"t":"三十六使流，并及心意漏，","level":0,"quote":true},{"t":"数数有邪见，依於欲想结。","level":0,"quote":true},{"t":"舍意放其根，人随意回转，","level":0,"quote":true},{"t":"为少灭名称，如鸟舍空林。","level":0,"quote":true},{"t":"在静自修学，慎勿逐欲迹，","level":0,"quote":true},{"t":"莫吞热铁丸，嘷哭受其报。","level":0,"quote":true},{"t":"应修而不修，恃力不精勤，","level":0,"quote":true},{"t":"自陷人形卑，懈怠不解慧。","level":0,"quote":true},{"t":"乱观及正观，皆由意所生，","level":0,"quote":true},{"t":"能觉知心观，愚心数数乱。","level":0,"quote":true},{"t":"智者如是观，念者专为行，","level":0,"quote":true},{"t":"咄嗟意无著，惟佛能灭此。","level":0,"quote":true},{"t":"观身如空瓶，安心如丘城，","level":0,"quote":true},{"t":"以慧与魔战，守胜勿复失。","level":0,"quote":true},{"t":"观身如聚沫，如阳焰野马，","level":0,"quote":true},{"t":"以慧与魔战，守胜勿复失。","level":0,"quote":true},{"t":"心念七觉意，等意不差违，","level":0,"quote":true},{"t":"当舍愚惑意，乐於不起忍。","level":0,"quote":true},{"t":"尽漏无有漏，於世取灭度，","level":0,"quote":true},{"t":"当自护其意，若<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01738.gif\" alt=\"𤛆\" title=\"𤛆\" />牛护尾。","level":0,"quote":true},{"t":"有施於一切，终不离其乐，","level":0,"quote":true},{"t":"一龙出众龙，龙中六牙者。","level":0,"quote":true},{"t":"心心自平等，独乐於旷野，","level":0,"quote":true},{"t":"不以能害心，尽为一切人，","level":0,"quote":true},{"t":"慈心为众生，彼无有怨恨。","level":0,"quote":true},{"t":"慈心为一人，便护诸善本，","level":0,"quote":true},{"t":"尽当为一切，贤圣福称上。","level":0,"quote":true},{"t":"普慈於一切，愍念众生类，","level":0,"quote":true},{"t":"修行於慈心，后受无极乐。","level":0,"quote":true},{"t":"若以踊跃意，欢喜不懈怠，","level":0,"quote":true},{"t":"修於诸善法，获致安隐处。","level":0,"quote":true},{"t":"自则致欢喜，身口意相应，","level":0,"quote":true},{"t":"以得等解脱，苾刍息意快。","level":0,"quote":true},{"t":"一切诸结尽，无复有尘劳，","level":0,"quote":true},{"t":"正使五音乐，不能悦人意。","level":0,"quote":true},{"t":"不如一正心，向於平等法，","level":0,"quote":true},{"t":"最胜得善眼，亦不计有我。","level":0,"quote":true},{"t":"诸有心乐禅，不乐於欲意，","level":0,"quote":true},{"t":"最胜踊跃意，亦不见有我。","level":0,"quote":true},{"t":"诸有心乐禅，不乐於欲意，","level":0,"quote":true},{"t":"诸结永已尽，如山不可动。","level":0,"quote":true},{"t":"於染无所染，於恚不起恚，","level":0,"quote":true},{"t":"诸有如此心，焉知苦踪迹？","level":0,"quote":true},{"t":"无害无所染，具足於戒律，","level":0,"quote":true},{"t":"於食知止足，及诸床卧具，","level":0,"quote":true},{"t":"修意求方便，是谓诸佛教。","level":0,"quote":true},{"t":"行人观心相，分别念待意，","level":0,"quote":true},{"t":"以得入禅定，便获喜安乐。","level":0,"quote":true},{"t":"护意自庄严，嫉彼而营己，","level":0,"quote":true},{"t":"遭忧不患苦，智者审谛住。","level":0,"quote":true},{"t":"人不守护心，为邪见所害，","level":0,"quote":true},{"t":"兼怀掉戏意，斯等就死径。","level":0,"quote":true},{"t":"是故当护心，等修清净行，","level":0,"quote":true},{"t":"正见恒在前，分别起灭法。","level":0,"quote":true},{"t":"苾刍降睡眠，尽苦更不造，","level":0,"quote":true},{"t":"降心复於乐，护心勿复调。","level":0,"quote":true},{"t":"有情心所误，尽受地狱苦，","level":0,"quote":true},{"t":"降心则致乐，护心勿复调。","level":0,"quote":true},{"t":"护心勿复调，心为众妙门，","level":0,"quote":true},{"t":"护而不漏失，便在圆寂道。","level":0,"quote":true}],[{"t":"法集要颂经苾刍品第三十二","level":3},{"t":"苾刍若乞食，以得勿积聚，","level":0,"quote":true},{"t":"天人所叹誉，生净无瑕秽。","level":0,"quote":true},{"t":"苾刍为慈愍，爱敬於佛教，","level":0,"quote":true},{"t":"深入妙止观，灭秽行乃安。","level":0,"quote":true},{"t":"苾刍诸爱尽，舍爱去贡高，","level":0,"quote":true},{"t":"无我去吾我，此义孰不亲。","level":0,"quote":true},{"t":"当知是法行，身之出要径，","level":0,"quote":true},{"t":"如象御强敌，苾刍恒习行。","level":0,"quote":true},{"t":"人不寿劫尽，内与自心诤，","level":0,"quote":true},{"t":"护身念道谛，苾刍惟净安。","level":0,"quote":true},{"t":"念亲同朋友，正命无杂糅，","level":0,"quote":true},{"t":"施知应所施，亦合威仪具。","level":0,"quote":true},{"t":"苾刍备众行，乃能尽苦际，","level":0,"quote":true},{"t":"乐法意欲法，思惟安隐法。","level":0,"quote":true},{"t":"苾刍依法行，正而勿废忘，","level":0,"quote":true},{"t":"当学入空定，苾刍常安静。","level":0,"quote":true},{"t":"爱乐非人处，观察平等法，","level":0,"quote":true},{"t":"当制於五蕴，服意如水流，","level":0,"quote":true},{"t":"清净恒和悦，为饮甘露味。","level":0,"quote":true},{"t":"如彼极峻山，不为风所动，","level":0,"quote":true},{"t":"苾刍尽愚痴，所在不倾动。","level":0,"quote":true},{"t":"一切诸名色，非有莫生惑，","level":0,"quote":true},{"t":"不近则不爱，乃名真苾刍。","level":0,"quote":true},{"t":"苾刍非剃发，慢诞无戒律，","level":0,"quote":true},{"t":"舍贪思惟道，乃应真苾刍。","level":0,"quote":true},{"t":"息心非剃发，放逸无志信，","level":0,"quote":true},{"t":"能灭众苦恼，为胜大沙门。","level":0,"quote":true},{"t":"苾刍得慈定，承受诸佛教，","level":0,"quote":true},{"t":"极得灭尽迹，无亲慎莫覩。","level":0,"quote":true},{"t":"心喜极欢悦，加以受念者，","level":0,"quote":true},{"t":"苾刍多熙怡，尽空无根源。","level":0,"quote":true},{"t":"息身而息意，摄口亦乃善，","level":0,"quote":true},{"t":"舍世为苾刍，度苦无有碍。","level":0,"quote":true},{"t":"无禅则无智，无智则无禅，","level":0,"quote":true},{"t":"道从禅智生，得近圆寂路。","level":0,"quote":true},{"t":"禅行无放逸，莫为欲乱心，","level":0,"quote":true},{"t":"无吞洋铜汁，自恼燋形躯。","level":0,"quote":true},{"t":"能自护身口，护意无有恶，","level":0,"quote":true},{"t":"后获禁戒法，故号为苾刍。","level":0,"quote":true},{"t":"诸有修善法，七觉意为本，","level":0,"quote":true},{"t":"此名为妙法，故名定苾刍。","level":0,"quote":true},{"t":"如今现所说，自知苦尽源，","level":0,"quote":true},{"t":"此名为善本，是无漏苾刍。","level":0,"quote":true},{"t":"不以持戒力，及以多闻义，","level":0,"quote":true},{"t":"正使得定意，不著於文饰。","level":0,"quote":true},{"t":"苾刍有所倚，尽於无漏行，","level":0,"quote":true},{"t":"当观正觉乐，勿近於凡夫。","level":0,"quote":true},{"t":"观此现世事，分别於五蕴，","level":0,"quote":true},{"t":"修行勿作恶，必强自制心。","level":0,"quote":true},{"t":"舍家而得解，意犹复染著，","level":0,"quote":true},{"t":"习行懈缓者，劳意勿除之，","level":0,"quote":true},{"t":"非净则梵行，焉致大财宝？","level":0,"quote":true},{"t":"心得永休息，苾刍摄意行，","level":0,"quote":true},{"t":"以尽老病死，便脱魔罗缚。","level":0,"quote":true},{"t":"心已得永寂，苾刍摄意行，","level":0,"quote":true},{"t":"以尽老病死，更不复受有。","level":0,"quote":true},{"t":"以断於爱相，苾刍摄意行，","level":0,"quote":true},{"t":"以尽老病死，更不复受有。","level":0,"quote":true},{"t":"无有结使心，苾刍摄意行，","level":0,"quote":true},{"t":"以尽老病死，更不复受有。","level":0,"quote":true},{"t":"不能断有根，苾刍摄意行，","level":0,"quote":true},{"t":"以尽老病死，更不复受有。","level":0,"quote":true},{"t":"能断三毒根，苾刍摄意行，","level":0,"quote":true},{"t":"以尽老病死，更不复受有。","level":0,"quote":true},{"t":"以脱於魔界，以胜丛林刺，","level":0,"quote":true},{"t":"及除骂詈者，犹凭妙高山。","level":0,"quote":true},{"t":"苾刍不受苦，不念今后世，","level":0,"quote":true},{"t":"观世如幻梦，苾刍胜彼此。","level":0,"quote":true},{"t":"如蛇脱故皮，能断爱根本，","level":0,"quote":true},{"t":"尽竭欲深泉，苾刍胜彼此。","level":0,"quote":true},{"t":"如蛇脱故皮，能断於五欲，","level":0,"quote":true},{"t":"断於欲根本，苾刍胜彼此。","level":0,"quote":true},{"t":"如蛇脱故皮，能断於五结，","level":0,"quote":true},{"t":"拔於爱欲刺，苾刍胜彼此。","level":0,"quote":true},{"t":"如蛇脱故皮，诸有无家业，","level":0,"quote":true},{"t":"又断不善根，苾刍胜彼此。","level":0,"quote":true},{"t":"如蛇脱故皮，诸有不热恼，","level":0,"quote":true},{"t":"又断不善根，苾刍胜彼此。","level":0,"quote":true},{"t":"如蛇脱故皮，断欲无遗餘，","level":0,"quote":true},{"t":"如拔不牢固，苾刍胜彼此。","level":0,"quote":true},{"t":"如蛇脱故皮，爱生如流溢，","level":0,"quote":true},{"t":"犹蛇含毒药，苾刍胜彼此。","level":0,"quote":true},{"t":"如蛇脱故皮，诸有断相观，","level":0,"quote":true},{"t":"内不造其心，苾刍胜彼此。","level":0,"quote":true},{"t":"如蛇脱故皮，贪根若断尽，","level":0,"quote":true},{"t":"是名真苾刍，降伏魔罗军。","level":0,"quote":true},{"t":"得尽苦轮回，瞋根若断尽，","level":0,"quote":true},{"t":"是名真苾刍，解脱诸烦恼。","level":0,"quote":true},{"t":"得尽苦轮回，痴根若断尽，","level":0,"quote":true},{"t":"是名真苾刍，远离於缠缚。","level":0,"quote":true},{"t":"得尽苦轮回，慢根若断尽，","level":0,"quote":true},{"t":"是名真苾刍，能离於爱染。","level":0,"quote":true},{"t":"得尽苦轮回，悭悋若断尽，","level":0,"quote":true},{"t":"是名真苾刍，信乐於正觉。","level":0,"quote":true},{"t":"得尽苦轮回，贪心聚落刺，","level":0,"quote":true},{"t":"苾刍应思惟，若能远离彼。","level":0,"quote":true},{"t":"佛说真苾刍，瞋心聚落刺，","level":0,"quote":true},{"t":"苾刍应思惟，能离於瞋恚。","level":0,"quote":true},{"t":"佛说真苾刍，痴心聚落刺，","level":0,"quote":true},{"t":"苾刍应思惟，若离於愚痴。","level":0,"quote":true},{"t":"佛说真苾刍，慢心聚落刺，","level":0,"quote":true},{"t":"苾刍应思惟，若能离憍慢。","level":0,"quote":true},{"t":"佛说真苾刍，悭悋聚落刺，","level":0,"quote":true},{"t":"苾刍应思惟，若能离悭悋。","level":0,"quote":true},{"t":"佛说真苾刍，调伏贪爱念，","level":0,"quote":true},{"t":"如药解蛇毒，苾刍能破坏。","level":0,"quote":true},{"t":"如蛇脱故皮，调伏瞋恚念，","level":0,"quote":true},{"t":"如药解蛇毒，苾刍能破坏。","level":0,"quote":true},{"t":"如蛇脱故皮，调伏愚痴念，","level":0,"quote":true},{"t":"如药解蛇毒，苾刍能远离。","level":0,"quote":true},{"t":"如蛇脱故皮，调伏憍慢念，","level":0,"quote":true},{"t":"如药解蛇毒，苾刍能远离。","level":0,"quote":true},{"t":"如蛇脱故皮，调伏悭悋念，","level":0,"quote":true},{"t":"如药解蛇毒，苾刍能远离。","level":0,"quote":true},{"t":"如蛇脱故皮，贪欲彼若发，","level":0,"quote":true},{"t":"断截如芦苇，烦恼如海深。","level":0,"quote":true},{"t":"苾刍应精进，瞋恚彼若发，","level":0,"quote":true},{"t":"断截如芦苇，烦恼深如海。","level":0,"quote":true},{"t":"苾刍应精进，愚痴彼若发，","level":0,"quote":true},{"t":"断截如芦苇，烦恼如海深。","level":0,"quote":true},{"t":"苾刍应精进，憍慢彼若发，","level":0,"quote":true},{"t":"断截如芦苇，烦恼深如海。","level":0,"quote":true},{"t":"苾刍应精进，悭悋彼若发，","level":0,"quote":true},{"t":"断截如芦苇，烦恼如海深。","level":0,"quote":true},{"t":"苾刍应精进，持戒谓苾刍，","level":0,"quote":true},{"t":"有空乃行禅，行空究其源。","level":0,"quote":true},{"t":"无为最为乐，苾刍忍所忧，","level":0,"quote":true},{"t":"分别床卧具，当习无放逸，","level":0,"quote":true},{"t":"断有爱无餘。","level":0,"quote":true}],[{"t":"法集要颂经梵志品第三十三","level":3},{"t":"所谓梵志者，不但在裸形，","level":0,"quote":true},{"t":"居险卧荆棘，而名为梵志。","level":0,"quote":true},{"t":"弃身无依倚，不诵异法言，","level":0,"quote":true},{"t":"恶法而尽除，是名为梵志。","level":0,"quote":true},{"t":"今世行净因，后世无秽果，","level":0,"quote":true},{"t":"无习诸恶法，是名为梵志。","level":0,"quote":true},{"t":"若倚於爱欲，心无所贪著，","level":0,"quote":true},{"t":"已舍已得正，是名灭终苦。","level":0,"quote":true},{"t":"诸有无所倚，恒习於正见，","level":0,"quote":true},{"t":"常念尽有漏，是名为梵志。","level":0,"quote":true},{"t":"愚者受猥发，并及床卧具，","level":0,"quote":true},{"t":"内怀贪著意，文饰外何求？","level":0,"quote":true},{"t":"被服弊恶衣，躬禀善法行，","level":0,"quote":true},{"t":"闲居自思惟，是名为梵志。","level":0,"quote":true},{"t":"见凡愚往来，堕堑受苦恼，","level":0,"quote":true},{"t":"欲独度彼岸，不好他言说，","level":0,"quote":true},{"t":"惟灭恶不起，是名为梵志。","level":0,"quote":true},{"t":"截流而已渡，无欲如梵天，","level":0,"quote":true},{"t":"智行以尽漏，是名为梵志。","level":0,"quote":true},{"t":"不以水清净，多有人沐浴，","level":0,"quote":true},{"t":"能除弊恶法，是名为梵志。","level":0,"quote":true},{"t":"非剃为沙门，称吉为梵行，","level":0,"quote":true},{"t":"若能灭众恶，是则为道人。","level":0,"quote":true},{"t":"彼以不二行，清净无瑕秽，","level":0,"quote":true},{"t":"诸欲断缚著，是名为梵志。","level":0,"quote":true},{"t":"出家为梵行，入正为沙门，","level":0,"quote":true},{"t":"弃舍众秽行，是则名舍家。","level":0,"quote":true},{"t":"人无幻惑意，无慢无疑惑，","level":0,"quote":true},{"t":"无贪无我想，是名为梵志。","level":0,"quote":true},{"t":"我不说梵志，托父母生者，","level":0,"quote":true},{"t":"彼多众瑕秽，灭则为梵志。","level":0,"quote":true},{"t":"身口及与意，清净无过失，","level":0,"quote":true},{"t":"能摄三种行，是名为梵志。","level":0,"quote":true},{"t":"见骂见相击，默受不生怒，","level":0,"quote":true},{"t":"有大忍辱力，是名为梵志。","level":0,"quote":true},{"t":"若见相侵欺，但念守戒行，","level":0,"quote":true},{"t":"端身自调伏，是名为梵志。","level":0,"quote":true},{"t":"世所称善恶，修短及巨细，","level":0,"quote":true},{"t":"无取若无与，是名为梵志。","level":0,"quote":true},{"t":"身为善行本，口意应无犯，","level":0,"quote":true},{"t":"能办三妙处，是名为梵志。","level":0,"quote":true},{"t":"来不作欢悦，去亦无忧愁，","level":0,"quote":true},{"t":"於聚应远聚，是名为梵志。","level":0,"quote":true},{"t":"以断於恩爱，离家无爱欲，","level":0,"quote":true},{"t":"爱欲若已尽，是名为梵志。","level":0,"quote":true},{"t":"适彼则无彼，彼彼适亦无，","level":0,"quote":true},{"t":"舍离於贪欲，是名为梵志。","level":0,"quote":true},{"t":"适彼则无彼，彼彼适则虚，","level":0,"quote":true},{"t":"不染三恶处，是名为梵志。","level":0,"quote":true},{"t":"能舍於家业，拔於爱欲本，","level":0,"quote":true},{"t":"无贪能知足，是名为梵志。","level":0,"quote":true},{"t":"如今尽所知，究其苦源际，","level":0,"quote":true},{"t":"无复欲爱心，是名为梵志。","level":0,"quote":true},{"t":"於罪并与福，两行应永除，","level":0,"quote":true},{"t":"无忧无有尘，是名为梵志。","level":0,"quote":true},{"t":"於罪并与福，两行应永除，","level":0,"quote":true},{"t":"三处无染著，是名为梵志。","level":0,"quote":true},{"t":"犹如众华叶，以针贯芥子，","level":0,"quote":true},{"t":"不为欲所染，是名为梵志。","level":0,"quote":true},{"t":"心喜无尘垢，如月盛圆满，","level":0,"quote":true},{"t":"谤毁以尽除，是名为梵志。","level":0,"quote":true},{"t":"如月清明朗，悬处於虚空，","level":0,"quote":true},{"t":"不染於爱欲，是名为梵志。","level":0,"quote":true},{"t":"避诤而不诤，犯而不愠怒，","level":0,"quote":true},{"t":"恶来以善待，是名为梵志。","level":0,"quote":true},{"t":"深解微妙慧，辩道不正道，","level":0,"quote":true},{"t":"体解无上义，是名为梵志。","level":0,"quote":true},{"t":"诸在世间人，乞索而自济，","level":0,"quote":true},{"t":"无我若无著，不失梵志行，","level":0,"quote":true},{"t":"说智无涯际，是名为梵志。","level":0,"quote":true},{"t":"若能弃欲爱，去家舍诸受，","level":0,"quote":true},{"t":"以断於欲漏，是名为梵志。","level":0,"quote":true},{"t":"慈愍於有情，使不生恐惧，","level":0,"quote":true},{"t":"不害有益善，是名为梵志。","level":0,"quote":true},{"t":"避怨则无怨，无所於伤损，","level":0,"quote":true},{"t":"志其邪僻见，是名为梵志。","level":0,"quote":true},{"t":"于前及于后，及中则无有，","level":0,"quote":true},{"t":"无操无舍行，是名为梵志。","level":0,"quote":true},{"t":"去其婬怒痴，憍慢诸恶行，","level":0,"quote":true},{"t":"针贯於芥子，是名为梵志。","level":0,"quote":true},{"t":"城以堑为固，来往受其苦，","level":0,"quote":true},{"t":"欲适度彼岸，不宜受他语，","level":0,"quote":true},{"t":"惟能灭不起，是名为梵志。","level":0,"quote":true},{"t":"人能断爱欲，今世及后世，","level":0,"quote":true},{"t":"有爱应已尽，是名为梵志。","level":0,"quote":true},{"t":"有情无希望，今世及后世，","level":0,"quote":true},{"t":"以无所希望，是名为梵志。","level":0,"quote":true},{"t":"自己识不知，天人彦达嚩，","level":0,"quote":true},{"t":"能知无量观，是名为梵志。","level":0,"quote":true},{"t":"归命人中尊，归命人中上，","level":0,"quote":true},{"t":"不审今世尊，为因何等禅？","level":0,"quote":true},{"t":"惟愿天中天，敷演其教戒。","level":0,"quote":true},{"t":"自识於宿命，得见天人道，","level":0,"quote":true},{"t":"知生尽苦原，智心永寂灭。","level":0,"quote":true},{"t":"自知心解脱，脱欲无所著，","level":0,"quote":true},{"t":"三明已成就，是名为梵志。","level":0,"quote":true},{"t":"自识於宿命，知有情因缘，","level":0,"quote":true},{"t":"如来觉无著，是名为梵志。","level":0,"quote":true},{"t":"尽断一切结，亦不有热恼，","level":0,"quote":true},{"t":"如来觉无著，是名为梵志。","level":0,"quote":true},{"t":"仙人龙中上，大仙最为尊，","level":0,"quote":true},{"t":"无数佛沐浴，是名为梵志。","level":0,"quote":true},{"t":"所有烦恼尽，度流而无漏，","level":0,"quote":true},{"t":"从此越彼岸，是名为梵志。","level":0,"quote":true},{"t":"苾刍塜间衣，观於欲非真，","level":0,"quote":true},{"t":"坐树空闲处，是名为梵志。","level":0,"quote":true},{"t":"人若无识知，无语无言说，","level":0,"quote":true},{"t":"体冷无温暖，是名为梵志。","level":0,"quote":true},{"t":"弃缘舍居家，出家无所畏，","level":0,"quote":true},{"t":"能服甘露味，是名为梵志。","level":0,"quote":true},{"t":"断绝於世事，口无麤犷言，","level":0,"quote":true},{"t":"八正道审谛，是名为梵志。","level":0,"quote":true},{"t":"远逝独游行，隐藏无形影，","level":0,"quote":true},{"t":"难降能自调，是名为梵志。","level":0,"quote":true},{"t":"无形不可见，此亦不可见，","level":0,"quote":true},{"t":"解知此句者，念则有所由，","level":0,"quote":true},{"t":"觉知结使尽，是名为梵志。","level":0,"quote":true},{"t":"能断生死河，能忍超度世，","level":0,"quote":true},{"t":"自觉出苦堑，是名为梵志。","level":0,"quote":true},{"t":"当求截流度，梵志无有欲，","level":0,"quote":true},{"t":"内自观诸情，是名为梵志。","level":0,"quote":true},{"t":"能知如是者，乃名为梵志。","level":0,"quote":true},{"t":"学先去其母，率君及二臣，","level":0,"quote":true},{"t":"尽胜诸境界，是名为梵志。","level":0,"quote":true},{"t":"诸有知深法，不问老以少，","level":0,"quote":true},{"t":"审谛守戒信，犹祀火梵志，","level":0,"quote":true},{"t":"於己法在外，梵志为最上。","level":0,"quote":true},{"t":"一切诸有漏，皆尽皆无餘，","level":0,"quote":true},{"t":"或复观於法，皆尽皆无餘，","level":0,"quote":true},{"t":"或复观合会，皆尽皆无餘，","level":0,"quote":true},{"t":"或复观因缘，皆尽皆无餘。","level":0,"quote":true},{"t":"犹如内法本，梵志为在表，","level":0,"quote":true},{"t":"若使共床褥，如彼薄俱罗。","level":0,"quote":true},{"t":"犹如内法本，梵志为在表，","level":0,"quote":true},{"t":"知生知老病，转知於死径。","level":0,"quote":true},{"t":"日照照於昼，月照照於夜，","level":0,"quote":true},{"t":"甲兵照於军，禅照於道人，","level":0,"quote":true},{"t":"佛出照天下，能照一切冥。","level":0,"quote":true},{"t":"梵志无有是，有忧无忧念，","level":0,"quote":true},{"t":"如如意所转，彼彼灭狐疑。","level":0,"quote":true},{"t":"出生诸深法，梵志习入禅，","level":0,"quote":true},{"t":"能解狐疑网，身知其苦痛。","level":0,"quote":true},{"t":"出生诸深法，梵志习入禅，","level":0,"quote":true},{"t":"徧照一切世，犹日在虚空。","level":0,"quote":true},{"t":"出生诸深法，梵志习入禅，","level":0,"quote":true},{"t":"能御魔罗敌，如佛脱众垢。","level":0,"quote":true},{"t":"护心及苾刍梵志品在末","level":0,"quote":true},{"t":"依次品而说，具足三十二。","level":0,"quote":true},{"t":"圣尊者法救集诸佛法颂偈竟。","level":0}]]