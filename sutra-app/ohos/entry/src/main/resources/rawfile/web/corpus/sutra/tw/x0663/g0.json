[[{"t":"科南本涅槃經元 師正排科 可度重訂","level":0},{"t":"No. 663-A 科南本涅槃經序No. 663-A","level":0}],[{"t":"科南本涅槃經序","level":3},{"t":"元崇聖院傳天台宗教校經沙門師正述","level":0},{"t":"吾佛大聖人最後雙林會上，為末世比丘普及大地","level":0},{"t":"眾生明心見性而說是經也。備明戒檢，廣開常宗，摩","level":0},{"t":"訶止觀依之為扶律顯常，喻之以贖命重寶。故經云：","level":0},{"t":"此經若在，佛法則在；此經若滅，佛法則滅。佛法命脉，","level":0},{"t":"存亡繫焉。始於沮渠蒙遜請曇無讖及猛法師兩度","level":0},{"t":"翻譯，共十三品，成四十軸，行之北方。至宋文帝敕嚴、","level":0},{"t":"觀二師同謝康樂更共治定，開為二十五品，縮為三","level":0},{"t":"十六軸，行之江南。其間說聽領悟甚眾，著述申明亦","level":0},{"t":"多，如僧傳所載也。去聖逾遙，神根轉鈍。吾祖章安尊","level":0},{"t":"者約龍樹宗旨，用天台義門，製疏科經，深符佛意。荊","level":0},{"t":"溪刪補，法道重明。自四明慈雲講唱、孤山作記之後，","level":0},{"t":"寥寥絕聞，其故何哉？蓋由經文浩博，疏義淵微，加之","level":0},{"t":"科未入經，卒難尋討。師正刻志斯典，有年于茲。宋之","level":0},{"t":"壬申，寓古源法師永清輪下為座首，遂倣法華、光明","level":0},{"t":"體例，以疏科句分標經上。凡疏不牒者，起盡難定，而","level":0},{"t":"與諸友往復徵折，方丈主決必歸於是。每夜集於猊","level":0},{"t":"峯軒下，經科疏記輪環讀之。預斯集者，大慈懷總、報","level":0},{"t":"慈大成、大雲居簡、壽星文勝、龍華清正、園華懷坦、天","level":0},{"t":"竺法杭。始於是秋之八月，終於明年之季春。無極東","level":0},{"t":"堂可度重加讐訂，白雲古山僧錄道安鋟梓流通。願","level":0},{"t":"與後人受持讀誦，如說而行，上不孤於佛祖，下不負","level":0},{"t":"於己靈，壽祝一人，功霑九有云。","level":0}],[{"t":"時至元歲在壬午聖制日序","level":3},{"t":"目次","level":0},{"t":"序品一","level":0},{"t":"經　疏　鈔","level":0},{"t":"純陀品二","level":0},{"t":"哀歎品三","level":0},{"t":"經　疏　鈔","level":0},{"t":"長壽品四","level":0},{"t":"金剛身品五","level":0},{"t":"名字功德品六","level":0},{"t":"經　疏　鈔","level":0},{"t":"四相品七","level":0},{"t":"經　疏　鈔","level":0},{"t":"四依品八","level":0},{"t":"經　疏　鈔","level":0},{"t":"邪正品九","level":0},{"t":"四諦品十","level":0},{"t":"四倒品十一","level":0},{"t":"經　疏　鈔","level":0},{"t":"如來性起品十二","level":0},{"t":"文字品十三","level":0},{"t":"烏喻品十四","level":0},{"t":"經　疏　鈔","level":0},{"t":"月喻品十五","level":0},{"t":"菩薩品十六","level":0},{"t":"經　疏　鈔","level":0},{"t":"大眾所問品十七","level":0},{"t":"經　疏　鈔","level":0},{"t":"現病品十八","level":0},{"t":"聖行品十九","level":0},{"t":"經　疏　鈔","level":0},{"t":"梵行品二十","level":0},{"t":"嬰兒品二十一","level":0},{"t":"經　疏　鈔","level":0},{"t":"高貴菩薩品二十二","level":0},{"t":"經　疏　鈔","level":0},{"t":"師子吼品二十三","level":0},{"t":"經　疏　鈔","level":0},{"t":"迦葉菩薩品二十