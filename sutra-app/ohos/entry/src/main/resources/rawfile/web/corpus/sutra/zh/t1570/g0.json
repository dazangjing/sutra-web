[[{"t":"No. 1570 [cf. Nos. 1569, 1571]广百论本一卷","level":0},{"t":"圣天菩萨造","level":0},{"t":"三藏法师玄奘奉　诏译","level":0}],[{"t":"破常品第一","level":3},{"t":"一切为果生，所以无常性；","level":0,"quote":true},{"t":"故除佛无有，如实号如来。","level":0,"quote":true},{"t":"无有时方物，有性非缘生；","level":0,"quote":true},{"t":"故无时方物，有性而常住。","level":0,"quote":true},{"t":"非无因有性，有因即非常；","level":0,"quote":true},{"t":"故无因欲成，真见说非有。","level":0,"quote":true},{"t":"见所作无常，谓非作常住；","level":0,"quote":true},{"t":"既见无常有，应言常性无。","level":0,"quote":true},{"t":"愚夫妄分别，谓空等为常；","level":0,"quote":true},{"t":"智者依世间，亦不见此义。","level":0,"quote":true},{"t":"非唯一有分，遍满一切分；","level":0,"quote":true},{"t":"故知一一分，各别有有分。","level":0,"quote":true},{"t":"若法体实有，卷舒用可得；","level":0,"quote":true},{"t":"此定从他生，故成所生果。","level":0,"quote":true},{"t":"若离所生果，无有能生因；","level":0,"quote":true},{"t":"是故能生因，皆成所生果。","level":0,"quote":true},{"t":"诸法必变异，方作餘生因；","level":0,"quote":true},{"t":"如是变异因，岂得名常住？","level":0,"quote":true},{"t":"若本无今有，自然常为因；","level":0,"quote":true},{"t":"既许有自然，因则为妄立。","level":0,"quote":true},{"t":"云何依常性，而起於无常？","level":0,"quote":true},{"t":"因果相不同，世所未曾见。","level":0,"quote":true},{"t":"若一分是因，餘分非因者；","level":0,"quote":true},{"t":"即应成种种，种种故非常。","level":0,"quote":true},{"t":"在因微圆相，於果则非有；","level":0,"quote":true},{"t":"是故诸极微，非遍体和合。","level":0,"quote":true},{"t":"於一极微处，既不许有餘；","level":0,"quote":true},{"t":"是故亦不应，许因果等量。","level":0,"quote":true},{"t":"微若有东方，必有东方分；","level":0,"quote":true},{"t":"极微若有分，如何是极微？","level":0,"quote":true},{"t":"要取前舍后，方得说为行；","level":0,"quote":true},{"t":"此二若是无，行者应非有。","level":0,"quote":true},{"t":"极微无初分，中后分亦无；","level":0,"quote":true},{"t":"是则一切眼，皆所不能见。","level":0,"quote":true},{"t":"若因为果坏，是因即非常；","level":0,"quote":true},{"t":"或许果与因，二体不同处。","level":0,"quote":true},{"t":"不见有诸法，常而是有对；","level":0,"quote":true},{"t":"故极微是常，诸佛未曾说。","level":0,"quote":true},{"t":"离缚所缚因，更无真解脱；","level":0,"quote":true},{"t":"生成用阙故，设有亦名无。","level":0,"quote":true},{"t":"究竟涅槃时，无蕴亦无我；","level":0,"quote":true},{"t":"不见涅槃者，依何有涅槃？","level":0,"quote":true},{"t":"我时舍诸德，离爱有何思？","level":0,"quote":true},{"t":"若有我无思，便用无所有。","level":0,"quote":true},{"t":"无餘有我种，则定能生思；","level":0,"quote":true},{"t":"要无我无思，诸有乃无有。","level":0,"quote":true},{"t":"若离苦有我，则定无涅槃；","level":0,"quote":true},{"t":"是故涅槃中，我等皆永灭。","level":0,"quote":true},{"t":"宁在世间求，非求於胜义；","level":0,"quote":true},{"t":"以世间少有，於胜义都无。","level":0,"quote":true}],[{"t":"破我品第二","level":3},{"t":"内我实非男，非女非非二；","level":0,"quote":true},{"t":"但由无智故，谓我为丈夫。","level":0,"quote":true},{"t":"若诸大种中，无男女非二；","level":0,"quote":true},{"t":"云何诸大种，有男等相生？","level":0,"quote":true},{"t":"汝我餘非我，故我无定相；","level":0,"quote":true},{"t":"岂不於无常，妄分别为我？","level":0,"quote":true},{"t":"我即同於身，生生有变易；","level":0,"quote":true},{"t":"故离身有我，常住理不然。","level":0,"quote":true},{"t":"若法无触对，则无有动摇；","level":0,"quote":true},{"t":"是故身作业，非命者能造。","level":0,"quote":true},{"t":"我常非所害，岂烦修护因？","level":0,"quote":true},{"t":"谁恐食金刚，执杖防众蠹？","level":0,"quote":true},{"t":"若有宿生念，便谓我为常；","level":0,"quote":true},{"t":"既见昔时痕，身亦应常住。","level":0,"quote":true},{"t":"若我与思合，转成思念者；","level":0,"quote":true},{"t":"思亦应非思，故我非常住。","level":0,"quote":true},{"t":"我与乐等合，种种如乐等；","level":0,"quote":true},{"t":"我如乐等故，非一亦非常。","level":0,"quote":true},{"t":"若谓我思常，缘助成邪执；","level":0,"quote":true},{"t":"如言火常住，则不缘薪等。","level":0,"quote":true},{"t":"如至灭动物，作用彼无有；","level":0,"quote":true},{"t":"故有我无思，其理不成就。","level":0,"quote":true},{"t":"餘方起思界，别处见於思；","level":0,"quote":true},{"t":"如铁铤镕销，我体应变坏。","level":0,"quote":true},{"t":"思如意量小，我似虚空大；","level":0,"quote":true},{"t":"唯应观自相，则不见於思。","level":0,"quote":true},{"t":"我德若周遍，何为他不受？","level":0,"quote":true},{"t":"能障既言通，不应唯障一。","level":0,"quote":true},{"t":"若德并悲思，何能造一切？","level":0,"quote":true},{"t":"彼应与狂乱，俱痴无所成。","level":0,"quote":true},{"t":"若德能善解，造舍等诸物，","level":0,"quote":true},{"t":"而不知受用，非理宁过此！","level":0,"quote":true},{"t":"有动作无常，虚通无动作；","level":0,"quote":true},{"t":"无用同无性，何不欣无我？","level":0,"quote":true},{"t":"或观我周遍，或见量同身，","level":0,"quote":true},{"t":"或执如极微，智者达非有。","level":0,"quote":true},{"t":"常法非可恼，何舍恼解脱？","level":0,"quote":true},{"t":"是故计我常，证解脱非理。","level":0,"quote":true},{"t":"我若实有性，不应赞离我；","level":0,"quote":true},{"t":"定知真实者，趣解脱应虚。","level":0,"quote":true},{"t":"解脱中若无，前亦应非有；","level":0,"quote":true},{"t":"无杂时所见，彼真性应知。","level":0,"quote":true},{"t":"若无常皆断，草等何不然？","level":0,"quote":true},{"t":"此理设为真，无明亦非有。","level":0,"quote":true},{"t":"现见色等行，从缘生住灭；","level":0,"quote":true},{"t":"故知汝执我，虽有而无有。","level":0,"quote":true},{"t":"如缘成芽等，缘成种等生；","level":0,"quote":true},{"t":"故无常诸法，皆无常所起。","level":0,"quote":true},{"t":"以法从缘生，故体而无断；","level":0,"quote":true},{"t":"以法从缘灭，故体亦非常。","level":0,"quote":true}],[{"t":"破时品第三","level":3},{"t":"瓶等在未来，即非有过现；","level":0,"quote":true},{"t":"未来过现有，便是未来无。","level":0,"quote":true},{"t":"未来若已谢，而有未来体；","level":0,"quote":true},{"t":"此则恒未来，云何成过现？","level":0,"quote":true},{"t":"法若在未来，现有未来相，","level":0,"quote":true},{"t":"应即为现在，如何名未来？","level":0,"quote":true},{"t":"去来如现有，取果用何无？","level":0,"quote":true},{"t":"若体恒非无，何为不常住？","level":0,"quote":true},{"t":"过去若过去，如何成过去？","level":0,"quote":true},{"t":"过去不过去，如何成过去？","level":0,"quote":true},{"t":"未来若有生，如何非现在？","level":0,"quote":true},{"t":"未来若无生，如何非常住？","level":0,"quote":true},{"t":"若未来无生，坏故非常者；","level":0,"quote":true},{"t":"过去既无坏，何不谓为常？","level":0,"quote":true},{"t":"现在世无常，非由过去等；","level":0,"quote":true},{"t":"除斯二所趣，更无有第三。","level":0,"quote":true},{"t":"若后生诸行，先已有定体；","level":0,"quote":true},{"t":"说有定性人，应非是邪执。","level":0,"quote":true},{"t":"若法因缘生，即非先有体；","level":0,"quote":true},{"t":"先有而生者，生已复应生。","level":0,"quote":true},{"t":"若见去来有，如何不见无？","level":0,"quote":true},{"t":"既见有去来，应不说为远。","level":0,"quote":true},{"t":"未作法若有，修戒等唐捐；","level":0,"quote":true},{"t":"若少有所为，果则非先有。","level":0,"quote":true},{"t":"诸行既无常，果则非恒有；","level":0,"quote":true},{"t":"若有初有后，世共许非常。","level":0,"quote":true},{"t":"应非勤解脱，解脱无去来；","level":0,"quote":true},{"t":"或许有去来，贪应离贪者。","level":0,"quote":true},{"t":"若执果先有，造宫舍严具，","level":0,"quote":true},{"t":"柱等则唐捐；果先无亦尔。","level":0,"quote":true},{"t":"诸法有转变，慧者未曾有；","level":0,"quote":true},{"t":"唯除无智人，妄分别为有。","level":0,"quote":true},{"t":"无常何有住？住无有何体？","level":0,"quote":true},{"t":"初若有住者，后应无变衰。","level":0,"quote":true},{"t":"譬如无一识，能了於二义；","level":0,"quote":true},{"t":"如是无一义，二识所能知。","level":0,"quote":true},{"t":"时若有餘住，住则不成时；","level":0,"quote":true},{"t":"时若餘住无，后灭应非有。","level":0,"quote":true},{"t":"法与无常异，法则非无常；","level":0,"quote":true},{"t":"法与无常一，法应非有住。","level":0,"quote":true},{"t":"无常初既劣，住力定应强；","level":0,"quote":true},{"t":"此二复何缘，后见成颠倒？","level":0,"quote":true},{"t":"若遍诸法体，无常力初劣；","level":0,"quote":true},{"t":"应都无有住，或一切皆常。","level":0,"quote":true},{"t":"无常若恒有，住相应常无；","level":0,"quote":true},{"t":"或彼法先常，后乃非常住。","level":0,"quote":true},{"t":"若法无常俱，而言有住者；","level":0,"quote":true},{"t":"无常相应妄，或住相应虚。","level":0,"quote":true},{"t":"无所见见无，回心缘妄境；","level":0,"quote":true},{"t":"是故唯虚假，有忆念名生。","level":0,"quote":true}],[{"t":"破见品第四","level":3},{"t":"禀和希胜慧，是法器应知；","level":0,"quote":true},{"t":"异此有师资，无因获胜利。","level":0,"quote":true},{"t":"说有及有因，净与净方便；","level":0,"quote":true},{"t":"世间自不了，过岂在牟尼？","level":0,"quote":true},{"t":"舍诸有涅槃，邪宗所共许；","level":0,"quote":true},{"t":"真空破一切，如何彼不欣？","level":0,"quote":true},{"t":"不知舍证因，无由能舍证；","level":0,"quote":true},{"t":"是故牟尼说，清凉餘定无。","level":0,"quote":true},{"t":"若於佛所说，深事以生疑；","level":0,"quote":true},{"t":"可依无相空，而生决定信。","level":0,"quote":true},{"t":"观现尚有妄，知后定为虚；","level":0,"quote":true},{"t":"诸依彼法行，被诳终无已。","level":0,"quote":true},{"t":"智者自涅槃，是能作难作；","level":0,"quote":true},{"t":"愚夫逢善导，而无随趣心。","level":0,"quote":true},{"t":"不知无怖畏，遍知亦复然；","level":0,"quote":true},{"t":"定由少分知，而生於怖畏。","level":0,"quote":true},{"t":"生死顺流法，愚夫常习行，","level":0,"quote":true},{"t":"未曾修逆流，是故生怖畏。","level":0,"quote":true},{"t":"诸有愚痴人，障他真实见；","level":0,"quote":true},{"t":"无由生善趣，如何证涅槃？","level":0,"quote":true},{"t":"宁毁犯尸罗，不损坏正见；","level":0,"quote":true},{"t":"尸罗生善趣，正见得涅槃。","level":0,"quote":true},{"t":"宁彼起我执，非空无我见；","level":0,"quote":true},{"t":"后兼向恶趣，初唯背涅槃。","level":0,"quote":true},{"t":"空无我妙理，诸佛真境界；","level":0,"quote":true},{"t":"能怖众恶见，涅槃不二门。","level":0,"quote":true},{"t":"愚闻空法名，皆生大怖畏；","level":0,"quote":true},{"t":"如见大力者，怯劣悉奔逃。","level":0,"quote":true},{"t":"诸佛虽无心，说摧他论法；","level":0,"quote":true},{"t":"而他论自坏，如野火焚薪。","level":0,"quote":true},{"t":"诸有悟正法，定不乐邪宗；","level":0,"quote":true},{"t":"为餘出伪门，故显真空义。","level":0,"quote":true},{"t":"若知佛所说，真空无我理；","level":0,"quote":true},{"t":"随顺不生欣，乖违无厌怖。","level":0,"quote":true},{"t":"见诸外道众，为多无义因；","level":0,"quote":true},{"t":"乐正法有情，谁不深悲愍！","level":0,"quote":true},{"t":"婆罗门离系，如来三所宗；","level":0,"quote":true},{"t":"耳眼意能知，故佛法深细。","level":0,"quote":true},{"t":"婆罗门所宗，多令行诳诈；","level":0,"quote":true},{"t":"离系外道法，多分顺愚痴。","level":0,"quote":true},{"t":"恭敬婆罗门，为诵诸明故；","level":0,"quote":true},{"t":"愍念离系者，由自苦其身。","level":0,"quote":true},{"t":"如苦业所感，非真解脱因；","level":0,"quote":true},{"t":"胜身业所生，亦非证解脱。","level":0,"quote":true},{"t":"略言佛所说，具二别餘宗；","level":0,"quote":true},{"t":"不害生人天，观空证解脱。","level":0,"quote":true},{"t":"世人耽自宗，如爱本生地；","level":0,"quote":true},{"t":"正法能摧灭，邪党不生欣。","level":0,"quote":true},{"t":"有智求胜德，应信受真宗；","level":0,"quote":true},{"t":"正法如日轮，有目因能见。","level":0,"quote":true}],[{"t":"破根境品第五","level":3},{"t":"於瓶诸分中，可见唯是色；","level":0,"quote":true},{"t":"言瓶全可见，如何能悟真？","level":0,"quote":true},{"t":"诸有胜慧人，随前所说义，","level":0,"quote":true},{"t":"於香味及触，一切类应遮。","level":0,"quote":true},{"t":"若唯见瓶色，即言见瓶者；","level":0,"quote":true},{"t":"既不见香等，应名不见瓶。","level":0,"quote":true},{"t":"有障碍诸色，体非全可见，","level":0,"quote":true},{"t":"彼分及中间，由此分所隔。","level":0,"quote":true},{"t":"极微分有无，应审谛思察；","level":0,"quote":true},{"t":"引不成为证，义终不可成。","level":0,"quote":true},{"t":"一切有碍法，皆众分所成；","level":0,"quote":true},{"t":"言说字亦然，故非根所取。","level":0,"quote":true},{"t":"离显色有形，云何取形色？","level":0,"quote":true},{"t":"即显取形色，何故不由身？","level":0,"quote":true},{"t":"离色有色因，应非眼所见；","level":0,"quote":true},{"t":"二法体既异，如何不别观。","level":0,"quote":true},{"t":"身觉於坚等，共立地等名；","level":0,"quote":true},{"t":"故唯於触中，说地等差别。","level":0,"quote":true},{"t":"瓶所见生时，不见有异德；","level":0,"quote":true},{"t":"体生如所见，故实性都无。","level":0,"quote":true},{"t":"眼等皆大造，何眼见非餘？","level":0,"quote":true},{"t":"故业果难思，牟尼真实说。","level":0,"quote":true},{"t":"智缘未有故，智非在见先；","level":0,"quote":true},{"t":"居后智唐捐，同时见无用。","level":0,"quote":true},{"t":"眼若行至境，色远见应迟；","level":0,"quote":true},{"t":"何不亦分明，照极远近色？","level":0,"quote":true},{"t":"若见已方行，行即为无用；","level":0,"quote":true},{"t":"若不见而往，定欲见应无。","level":0,"quote":true},{"t":"若不往而观，应见一切色；","level":0,"quote":true},{"t":"眼既无行动，无远亦无障。","level":0,"quote":true},{"t":"诸法体相用，前后定应同；","level":0,"quote":true},{"t":"如何此眼根，不见於眼性？","level":0,"quote":true},{"t":"眼中无色识，识中无色眼；","level":0,"quote":true},{"t":"色内二俱无，何能合见色？","level":0,"quote":true},{"t":"所闻若能表，何不成非音？","level":0,"quote":true},{"t":"声若非能诠，何故缘生解？","level":0,"quote":true},{"t":"声若至耳闻，如何了声本？","level":0,"quote":true},{"t":"声无顿说理，如何全可知？","level":0,"quote":true},{"t":"乃至非所闻，应非是声性；","level":0,"quote":true},{"t":"先无而后有，理定不相应。","level":0,"quote":true},{"t":"心若离诸根，去亦应无用；","level":0,"quote":true},{"t":"设如是命者，应常无有心。","level":0,"quote":true},{"t":"令心妄取尘，依先见如焰，","level":0,"quote":true},{"t":"妄立诸法义，是想蕴应知。","level":0,"quote":true},{"t":"眼色等为缘，如幻生诸识；","level":0,"quote":true},{"t":"若执为实有，幻喻不应成。","level":0,"quote":true},{"t":"世间诸所有，无不皆难测；","level":0,"quote":true},{"t":"根境理同然，智者何惊异！","level":0,"quote":true},{"t":"诸法如火轮，变化梦幻事，","level":0,"quote":true},{"t":"水月彗星响，阳焰及浮云。","level":0,"quote":true}],[{"t":"破边执品第六","level":3},{"t":"诸法若实有，应不依他成；","level":0,"quote":true},{"t":"既必依他成，定知非实有。","level":0,"quote":true},{"t":"非即色有瓶，非离色有瓶；","level":0,"quote":true},{"t":"非依瓶有色，非有瓶依色。","level":0,"quote":true},{"t":"若见二相异，谓离瓶有同；","level":0,"quote":true},{"t":"二相既有殊，应离瓶有异。","level":0,"quote":true},{"t":"若一不名瓶，瓶应不名一；","level":0,"quote":true},{"t":"瓶一曾无合，瓶应无一名。","level":0,"quote":true},{"t":"若色遍於实，色应得大名；","level":0,"quote":true},{"t":"敌论若非他，应申自宗义。","level":0,"quote":true},{"t":"有数等能相，显所相不成；","level":0,"quote":true},{"t":"除此更无因，故诸法非有。","level":0,"quote":true},{"t":"离别相无瓶，故瓶体非一；","level":0,"quote":true},{"t":"一一非瓶故，瓶体亦非多。","level":0,"quote":true},{"t":"非无有触体，与有触体合；","level":0,"quote":true},{"t":"故色等诸法，不可合为瓶。","level":0,"quote":true},{"t":"色是瓶一分，故色体非瓶；","level":0,"quote":true},{"t":"有分既为无，一分如何有？","level":0,"quote":true},{"t":"一切色等性，色等相无差；","level":0,"quote":true},{"t":"唯一类是瓶，餘非有何理？","level":0,"quote":true},{"t":"若色异味等，不异於瓶等；","level":0,"quote":true},{"t":"瓶等即味等，色何即瓶等？","level":0,"quote":true},{"t":"瓶等既无因，体应不成果；","level":0,"quote":true},{"t":"故若异色等，瓶等定为无。","level":0,"quote":true},{"t":"瓶等因若有，可为瓶等因；","level":0,"quote":true},{"t":"瓶等因既无，如何生瓶等？","level":0,"quote":true},{"t":"色等和合时，终不成香等；","level":0,"quote":true},{"t":"故和合一体，应如瓶等无。","level":0,"quote":true},{"t":"如离於色等，瓶体实为无；","level":0,"quote":true},{"t":"色体亦应然，离风等非有。","level":0,"quote":true},{"t":"煖即是火性，非煖如何烧？","level":0,"quote":true},{"t":"故薪体为无，离此火非有。","level":0,"quote":true},{"t":"餘煖杂故成，如何不成火？","level":0,"quote":true},{"t":"若餘不成煖，由火法应无。","level":0,"quote":true},{"t":"若火微无薪，应离薪有火；","level":0,"quote":true},{"t":"火微有薪者，应无火极微。","level":0,"quote":true},{"t":"审观诸法时，无一体实有；","level":0,"quote":true},{"t":"一体既非有，多体亦应无。","level":0,"quote":true},{"t":"若法更无餘，汝谓为一体；","level":0,"quote":true},{"t":"诸法皆三性，故一体为无。","level":0,"quote":true},{"t":"有非有俱非，一非一双泯，","level":0,"quote":true},{"t":"随次应配属，智者达非真。","level":0,"quote":true},{"t":"於相续假法，恶见诸真常；","level":0,"quote":true},{"t":"积集假法中，邪执言实有。","level":0,"quote":true},{"t":"诸法众缘成，性羸无自在；","level":0,"quote":true},{"t":"虚假依他立，故我法皆无。","level":0,"quote":true},{"t":"果众缘合成，离缘无别果；","level":0,"quote":true},{"t":"如是合与果，诸圣达皆无。","level":0,"quote":true},{"t":"识为诸有种，境是识所行；","level":0,"quote":true},{"t":"见境无我时，诸有种皆灭。","level":0,"quote":true}],[{"t":"破有为相品第七","level":3},{"t":"若本无而生，先无何不起？","level":0,"quote":true},{"t":"本有而生者，后有复应生。","level":0,"quote":true},{"t":"果若能违因，先无不应理；","level":0,"quote":true},{"t":"果立因无用，先有亦不成。","level":0,"quote":true},{"t":"此时非有生，彼时亦无生；","level":0,"quote":true},{"t":"此彼时无生，何时当有生？","level":0,"quote":true},{"t":"如生於自性，生义既为无，","level":0,"quote":true},{"t":"於他性亦然，生义何成有？","level":0,"quote":true},{"t":"初中后三位，生前定不成？","level":0,"quote":true},{"t":"二一既为无，一一如何有？","level":0,"quote":true},{"t":"非离於他性，唯从自性生；","level":0,"quote":true},{"t":"非从他及俱，故生定非有。","level":0,"quote":true},{"t":"前后及同时，二俱不可说；","level":0,"quote":true},{"t":"故生与瓶等，唯假有非真。","level":0,"quote":true},{"t":"旧若在新前，前生不应理；","level":0,"quote":true},{"t":"旧若居新后，后生理不成。","level":0,"quote":true},{"t":"现非因现起，亦非因去来；","level":0,"quote":true},{"t":"未来亦不因，去来今世起。","level":0,"quote":true},{"t":"若具即无来，既灭应非往；","level":0,"quote":true},{"t":"法体相如是，幻等喻非虚。","level":0,"quote":true},{"t":"生住灭三相，同时有不成，","level":0,"quote":true},{"t":"前后亦为无，如何执为有？","level":0,"quote":true},{"t":"若生等诸相，复有别生等；","level":0,"quote":true},{"t":"应住灭如生，或生住如灭。","level":0,"quote":true},{"t":"所相异能相，何为体非常？","level":0,"quote":true},{"t":"不异四应同，或复全非有。","level":0,"quote":true},{"t":"有不生有法，有不生无法；","level":0,"quote":true},{"t":"无不生有法，无不生无法。","level":0,"quote":true},{"t":"有不成有法，有不成无法；","level":0,"quote":true},{"t":"无不成有法，无不成无法。","level":0,"quote":true},{"t":"半生半未生，非一生时体；","level":0,"quote":true},{"t":"或以未生位，应亦是生时。","level":0,"quote":true},{"t":"生时若是果，体即非生时；","level":0,"quote":true},{"t":"生时若自然，应失生时性。","level":0,"quote":true},{"t":"已生异未生，别有中间位；","level":0,"quote":true},{"t":"生时异二位，应别有中间。","level":0,"quote":true},{"t":"若谓生时舍，方得已生时；","level":0,"quote":true},{"t":"是则应有餘，得时而可见。","level":0,"quote":true},{"t":"若至已生位，理必无生时；","level":0,"quote":true},{"t":"已生有生时，云何从彼起？","level":0,"quote":true},{"t":"未至已生位，若立为生时；","level":0,"quote":true},{"t":"何不谓无瓶？未生无别故。","level":0,"quote":true},{"t":"非生时有用，能简未生时；","level":0,"quote":true},{"t":"亦非体未圆，别於已生位。","level":0,"quote":true},{"t":"前位生时无，后位方言有；","level":0,"quote":true},{"t":"兼成已生位，故此位非无。","level":0,"quote":true},{"t":"有时名已生，无时名未起；","level":0,"quote":true},{"t":"除兹有无位，谁复谓生时？","level":0,"quote":true},{"t":"诸有执离因，无别所成果；","level":0,"quote":true},{"t":"转生及转灭，理皆不可成。","level":0,"quote":true}],[{"t":"教诫弟子品第八","level":3},{"t":"由少因缘故，疑空谓不空；","level":0,"quote":true},{"t":"依前诸品中，理教应重遣。","level":0,"quote":true},{"t":"能所说若有，空理则为无；","level":0,"quote":true},{"t":"诸法假缘成，故三事非有。","level":0,"quote":true},{"t":"若唯说空过，不空义即成；","level":0,"quote":true},{"t":"不空过已明，空义应先立。","level":0,"quote":true},{"t":"诸欲坏他宗，必应成己义；","level":0,"quote":true},{"t":"何乐谈他失，而无立己宗？","level":0,"quote":true},{"t":"为破一等执，假立遣为宗；","level":0,"quote":true},{"t":"他三执既除，自宗随不立。","level":0,"quote":true},{"t":"许执为现见，空因非有能；","level":0,"quote":true},{"t":"餘宗现见因，此宗非所许。","level":0,"quote":true},{"t":"若无不空理，空理如何成？","level":0,"quote":true},{"t":"汝既不立空，不空应不立。","level":0,"quote":true},{"t":"若许有无宗，有宗方可立；","level":0,"quote":true},{"t":"无宗若非有，有宗应不成。","level":0,"quote":true},{"t":"若诸法皆空，如何火名煖？","level":0,"quote":true},{"t":"此如前具遣，火煖俗非真。","level":0,"quote":true},{"t":"若谓法实有，遮彼说为空；","level":0,"quote":true},{"t":"应四论皆真，见何过而舍？","level":0,"quote":true},{"t":"若诸法都无，生死应非有；","level":0,"quote":true},{"t":"诸佛何曾许，执法定为无？","level":0,"quote":true},{"t":"若真离有无，何缘言俗有？","level":0,"quote":true},{"t":"汝本宗亦尔，致难复何为？","level":0,"quote":true},{"t":"诸法若都无，差别应非有；","level":0,"quote":true},{"t":"执诸法皆有，差别亦应无。","level":0,"quote":true},{"t":"若谓法非有，无能破有因；","level":0,"quote":true},{"t":"破有因已明，汝宗何不立？","level":0,"quote":true},{"t":"说破因易得，是世俗虚言；","level":0,"quote":true},{"t":"汝何缘不能，遮破真空义？","level":0,"quote":true},{"t":"有名诠法有，谓法实非无；","level":0,"quote":true},{"t":"无名表法无，法实应非有。","level":0,"quote":true},{"t":"由名解法有，遂谓法非无；","level":0,"quote":true},{"t":"因名知法无，应信法非有。","level":0,"quote":true},{"t":"诸世间可说，皆是假非真；","level":0,"quote":true},{"t":"离世俗名言，乃是真非假。","level":0,"quote":true},{"t":"谤诸法为无，可坠於无见；","level":0,"quote":true},{"t":"唯蠲诸妄执，如何说堕无？","level":0,"quote":true},{"t":"有非真有故，无亦非真无；","level":0,"quote":true},{"t":"既无有真无，何有於真有？","level":0,"quote":true},{"t":"有因证法空，法空应不立；","level":0,"quote":true},{"t":"宗因无异故，因体实为无。","level":0,"quote":true},{"t":"谓空喻别有，例诸法非空；","level":0,"quote":true},{"t":"唯有喻应成，内我同乌黑。","level":0,"quote":true},{"t":"若法本性空，见空有何德？","level":0,"quote":true},{"t":"虚妄分别缚，证空见能除。","level":0,"quote":true},{"t":"法成一成无，违真亦违俗；","level":0,"quote":true},{"t":"故与有一异，二俱不可言。","level":0,"quote":true},{"t":"有非有俱非，诸宗皆寂灭；","level":0,"quote":true},{"t":"於中欲兴难，毕竟不能申。","level":0,"quote":true},{"t":"圣天菩萨造论既周，重叙摧邪，复说颂曰：","level":0},{"t":"「我在为燎邪宗火，沃以如来正教酥，","level":0,"quote":true},{"t":"又扇因明广大风，谁敢如蛾投猛焰？」","level":0,"quote":true},{"t":"广百论本一卷","level":0}]]