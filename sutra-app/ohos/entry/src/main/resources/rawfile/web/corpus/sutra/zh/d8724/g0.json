[[{"t":"愚痴人弟子杨仙鸖","level":0},{"t":"报恩金刚经文十二段","level":0},{"t":"其经无相为宗般若是体此经文悭义广䓁量虚空妙理幽玄非愚人之可恻弟子诸经<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00562.gif\" alt=\"䟽\" title=\"䟽\" />论不曾披寻孔子典藉一字不识狂言风语诈恻圣情恣意无眀漫出道理大弘噐量不责小[彳<em>((天</em>天)/心)]拙句<img class=\"gaiji\" src=\"asset://gaiji-CB/28/CB28420.gif\" alt=\"𡪍\" title=\"𡪍\" />辝<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" />闻者布施弟子欢喜了知四大本来虚幻漫执我人众▆▆缘妄识随六根攀缘结集贪嗔痴烦<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29789.gif\" alt=\"𤇱\" title=\"𤇱\" />欲▆▆十二部经体性一一不离人身心向外波波求佛渴鹿徒烦趂其阳焰智者细察不可爱影而嫌身愚者空里漫擿狂花惣缘服其莨菪众生错悟弃水而求氷今欲报作湏菩提问佛诈<img class=\"gaiji\" src=\"asset://gaiji-CB/25/CB25577.gif\" alt=\"㑅\" title=\"㑅\" />如来一一尽荅欲得直拔众生三毒之根▆▆除妄相花苗顿破五蕴烦<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29789.gif\" alt=\"𤇱\" title=\"𤇱\" />之林速证清▆▆▆性言辝<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00562.gif\" alt=\"䟽\" title=\"䟽\" />拙<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06960.gif\" alt=\"𢙢\" title=\"𢙢\" />不惬众情愿发菩[薩-產+(辛/工)]之心▆▆▆庶弟子忏悔。","level":0},{"t":"佛说金刚经从舎卫大城<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00855.gif\" alt=\"𠧒\" title=\"𠧒\" />食至欢喜奉行▆▆众生身心说苐一义如来所说金刚经众生闻者湏解佛意舎卫大城不离身给孤独园俱在此我人受者千二百五蕴众生同会理心佛持钵入四大六根次第<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00855.gif\" alt=\"𠧒\" title=\"𠧒\" />䓁智眼耳鼻舌舍色尘不生分别名普施戒<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />恵香飡法食<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />水清净洗足已<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15756.gif\" alt=\"𠬧\" title=\"𠬧\" />衣得座解脱床身心不动无量义达身空是湏菩提智恵长老会中起。","level":0},{"t":"苐二湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />问降心义","level":0},{"t":"湏菩提会中从坐起叹佛世尊希有事偏袒右<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10468.gif\" alt=\"𡱎\" title=\"𡱎\" />合掌礼我今<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />唘降心义如来付嘱大菩[薩-產+(辛/工)]护念转教小佛子众生心如狂野马云何降心而得止惟愿诸佛说观门众生惣悟於心地。","level":0},{"t":"佛告湏菩提莫疑悟惟劝众生降心住从此妄相自然息是故不堕三毒苦身心不动澄清净众生即是诸佛土吾今谓说无为法闻者谛<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" />善思取应观此心䓁虚空速得超於三界路湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />闻说妙法了了唯然觧佛语。","level":0},{"t":"苐三湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />问度十类众生义","level":0},{"t":"湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00566.gif\" alt=\"䠒\" title=\"䠒\" />跪膝着地合掌恭敬问十类不缘此会四部众惣缘<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />世诸佛子胎<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09238.gif\" alt=\"𡖉\" title=\"𡖉\" />湿化及诸天佛言先度无餘理众生现在六道中生死苦海不曾止惟愿诸佛说修行众生永离於生死。","level":0},{"t":"佛告善吉及摩诃汝今谛<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" />思吾语众生不肯𭗒细观五蕰上头生嫉姤从此妄相遍恒沙是故轮回堕六趣胎<img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09238.gif\" alt=\"𡖉\" title=\"𡖉\" />湿化及诸天吾说彼生不坚固饶伊无相非非相福尽还堕三毒苦惟点恵灯破无眀<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />水懃洗六根垢三毒本来是解脱身外更无别净土自知作佛疑网除吾劝众生是真语了知妄相本清净实无众生得<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30274.gif\" alt=\"㓕\" title=\"㓕\" />度若悟烦<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08974.gif\" alt=\"𢙉\" title=\"𢙉\" />同一如<img class=\"gaiji\" src=\"asset://gaiji-CB/17/CB17699.gif\" alt=\"𡖋\" title=\"𡖋\" />同菩[薩-產+(辛/工)]离我所。","level":0},{"t":"苐四湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />问破色身义","level":0},{"t":"湏菩提未解诸佛意恭敬顶礼头着地请问如来说色身真解众生疑未止唯愿佛破此相一切众生达妙理。","level":0},{"t":"佛告长老湏菩提汝今谛<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" />慧刀裁吾现色身非真有只徒接引下愚迷觅佛众生心上觅向外求得是魔来若见色身是外道破相离执见如来。","level":0},{"t":"苐五湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />问众生受持金刚经实相","level":0},{"t":"湏菩提心里有疑悟<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />唘如来说四句有人受持金(刚经一▆)能生实相不不於一二三四五无量佛所早发路持戒念念生净信如来<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01556.gif\" alt=\"𢘻\" title=\"𢘻\" />知无罪垢若有书冩闻一偈此人合生诸佛土众生现被烦<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29789.gif\" alt=\"𤇱\" title=\"𤇱\" />緾无常湏臾地狱苦惟愿诸佛大慈悲速开三门閇六趣应病与药断贪瞋一切众生惣醒悟。","level":0},{"t":"佛告湏菩提莫麁语吾与众生下法雨有人受持四句偈此经即是诸佛母无为之法本是一四果所修染着<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />吾今慇懃劝众生念念修行离我所欲得阿<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00803.gif\" alt=\"䅶\" title=\"䅶\" />三菩提断除烦<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29789.gif\" alt=\"𤇱\" title=\"𤇱\" />如筏喻悟则了心一刹郍迷则百刧无出路大道宽广不能行小迳波波漫辛苦<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />水清净息妄念恵灯内外觉了取惣缘此身染声香如蝅吐丝自缚住发毛<img class=\"gaiji\" src=\"asset://gaiji-CB/11/CB11894.gif\" alt=\"𤓰\" title=\"𤓰\" />齿假安立四大五蕰都无主三百个砕骨相连接膓<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00787.gif\" alt=\"𦝩\" title=\"𦝩\" />肝胆不净聚从顶至足细观看我人众生依何<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />破此世界作𭗒尘莲花超水无染污烦<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29789.gif\" alt=\"𤇱\" title=\"𤇱\" />沤泥得宝珠此个是名真四句众生悟此无相施速证法舩生净土。","level":0},{"t":"苐六湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />问如来喻恒河沙䓁七宝不如受持金刚经义","level":0},{"t":"湏菩提叹佛大慈父金口所说如甘露遶佛三[這-言+市]住一面合掌恭敬问四句佛举四大恒河沙七宝湏弥来积聚有人持用将布施不及众生问一句众生不知心是佛向外波波觅净土着相取文求解脱不免轮回堕六趣惟愿诸佛<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />申陈众生有八苦醍醐灌顶於身心无明[聲-耳+(夕*(ㄗ@、))]绽自开悟众生壑然悟本心都由世尊下法雨。","level":0},{"t":"佛告达空湏菩提四果之中汝苐一无争三昧超人天未得具六波罗蜜阿修罗王有福徳类汝四果不可疋汝今谛<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" />善思惟惟劝众生莫放逸吾举四大恒河沙七宝湏弥广行施其福甚多不可量不如众生悟心地吾今殷勤根本说闻者谛<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" />湏欢喜五蕰林里有真经六根流出<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />恵水浇浊身心三毒痛多宝佛塔在心里妄念𭗒尘化菩[薩-產+(辛/工)]从地踊出皆卫侍违遶赞叹而供养众生即是诸佛子一一依吾能修行顿超三界离生死。","level":0},{"t":"苐七湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />问如来作忍辱仙人义","level":0},{"t":"湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00566.gif\" alt=\"䠒\" title=\"䠒\" />跪白世尊<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />唘如来说忍门非但众生有疑惑我得慧眼未曾闻昔被歌利王莭莭解手足耳鼻当头分其王湏臾速忏悔仙人发愿得本身众生心上能作忍诸佛先来无我人惟愿世尊说实相修者皆得金刚身。","level":0},{"t":"佛告湏菩提莫散汝今谛<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" />吾与判所作有为执我人是故生死恒不断唯证心王磨恵刀截其妄相数百叚手足耳鼻惣是假皮宍觔骨𭗒细观六根莫随他境走四大五蕴无形叚有为功徳如入暗无漏福田不可笇欲得金刚不坏身<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />恵双行达彼岸。","level":0},{"t":"苐八湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />问日舍三恒河沙身命布施义","level":0},{"t":"湏菩提渴佛功徳水我是小(乗)问大义不缘此会阿罗汉惣缘<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08891.gif\" alt=\"𢙣\" title=\"𢙣\" />业众生类佛言受持金刚经胜着三时舍身施若有书冩及解说恒河身命不可比一切罪鄣<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01556.gif\" alt=\"𢘻\" title=\"𢘻\" />消除惣缘受持四句偈非但小乗有疑惑众生闻者闷擗地惟愿世尊说大乗荷檐众生温盘里。","level":0},{"t":"佛告湏菩提莫疑悔吾说众生根本罪有为功得生人天是故不出三界外舍身不及断攀缘读经唯湏照心内每日三时息妄念身心清净无垢秽刹郍得证唘真如此个是名四句偈生众若能𭗒细观了见佛性更无罪当知此身即是塔天人阿修罗皆集会赞叹散花而供养此<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30529.gif\" alt=\"𠁅\" title=\"𠁅\" />即有真容在众生悟此最上乗便得清净证三昧。","level":0},{"t":"苐九湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />问佛供养郍由他诸佛不如众生受持四句义","level":0},{"t":"湏菩提心里有疑网<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />问如来说供养八百四千郍由佛一一恭敬无偏傥教量譬喻四句偈众生受持最为上先世罪业实消除惣缘今世持不妄有人打骂能忍辱佛说消却地狱鄣众生闻即心狂乱唯愿诸佛<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />敷唱一一指示达本源令得众生速回向。","level":0},{"t":"佛告湏菩提汝细意<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" />吾广开大法义是我供养不足难且教众生了心地三千大千七宝施其福虽多假名字<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />水唯湏澄清净智恵法灯无为理随心起念是化佛一一供养生慙愧念<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30274.gif\" alt=\"㓕\" title=\"㓕\" />心寂是真如众生䓁佛更无异先世罪业实消除惣缘受持四句义众生若能解吾语是故万行速圎俻菩提妙花遍<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00982.gif\" alt=\"㽵\" title=\"㽵\" />严清净法林长安置不舍烦<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29789.gif\" alt=\"𤇱\" title=\"𤇱\" />证涅盘无为功徳不可比众生若能如是观燃灯佛前亲受记。","level":0},{"t":"苐十湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />问五眼清净义","level":0},{"t":"湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00566.gif\" alt=\"䠒\" title=\"䠒\" />跪白大师佛有五眼不思议我今知佛方便意众生闻者尽怀疑唯愿诸佛从凢说一切众生能受持。","level":0},{"t":"佛告长老及善吉吾有五眼是真实宍眼天眼及恵眼法眼佛眼从何出汝今谛<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" />莫怀疑吾今为汝略陈述吾从凢夫𭗒细修五蕰上头不放逸五根境上勤磨柫佛眼清净从心出一切众生学吾修还得具六波罗蜜。","level":0},{"t":"苐十一湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />问卅二相疋轮转圣王义","level":0},{"t":"湏菩提顶礼头著地合掌供敬瞻仰视我今心里有怀疑重问如来卅二是我所叹妙色身云何轮王来相比饶伊千子常围遶王得四天不▆死世尊身如金刚身何故将天而比地唯愿诸佛𭗒妙说众生惣证无为理。","level":0},{"t":"佛告湏菩提莫疑网吾说虚空不可量毗卢遮郍体清净卅二相无取相众生作福求化身吾谓众生现色相平䓁性智𭗒细观八十种好是虚妄众生自证清净智即同法身一合相。","level":0},{"t":"苐十二湏菩提<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />问破此经有为法义","level":0},{"t":"湏菩提疑网未能绝唯愿世尊<img class=\"gaiji\" src=\"asset://gaiji-CB/31/CB31037.gif\" alt=\"𠕂\" title=\"𠕂\" />踈决是我昔闻诸佛演书冩此经及解说七宝积聚如湏弥恒河沙䓁由比劣此经现破有为法如泡电云湏<img class=\"gaiji\" src=\"asset://gaiji-CB/13/CB13376.gif\" alt=\"㬰\" title=\"㬰\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30274.gif\" alt=\"㓕\" title=\"㓕\" />众生未识根本罪唯愿诸佛身心说破却四大五蕰空言不得证离生<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30274.gif\" alt=\"㓕\" title=\"㓕\" />。","level":0},{"t":"佛告湏菩提能切磋汝为众生是摩诃一一谛<img class=\"gaiji\" src=\"asset://gaiji-CB/10/CB10881.gif\" alt=\"𦗟\" title=\"𦗟\" />思吾语莫作渴鹿漫波波孝顺了心用力少读经不行费力多有人水𩘔而渴死穷人数宝不得他劝汝受持四句偈胜舍身命百恒河唯取<img class=\"gaiji\" src=\"asset://gaiji-CB/30/CB30070.gif\" alt=\"㝎\" title=\"㝎\" />水浇三毒证取<img class=\"gaiji\" src=\"asset://gaiji-CB/21/CB21061.gif\" alt=\"𢦶\" title=\"𢦶\" />香六根磨智恵法灯内外照色尘境界不敢过烦<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29789.gif\" alt=\"𤇱\" title=\"𤇱\" />变成清净海都由悟心一刹郍不舍豪𰚨名大施其福无<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01002.gif\" alt=\"㝵\" title=\"㝵\" />遍娑婆天人阿修罗闻佛说欢喜齐赞妙释迦。","level":0},{"t":"弟子自和无眀五言八十字诗一首","level":0},{"t":"弟子实愚痴▆▆▆臆传▆性元不识经论不曾转自疾不能救劝人作方便欲得修道者妄念勤除剪但知调三业六根湏磨鍊暗室点眀灯水清石子见智杵破<img class=\"gaiji\" src=\"asset://gaiji-CB/18/CB18268.gif\" alt=\"𨚌\" title=\"𨚌\" />山烦<img class=\"gaiji\" src=\"asset://gaiji-CB/29/CB29789.gif\" alt=\"𤇱\" title=\"𤇱\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/09/CB09400.gif\" alt=\"𠛴\" title=\"𠛴\" />郍<img class=\"gaiji\" src=\"asset://gaiji-CB/33/CB33370.gif\" alt=\"𣂾\" title=\"𣂾\" />悟心豁然开了见佛面","level":0}]]