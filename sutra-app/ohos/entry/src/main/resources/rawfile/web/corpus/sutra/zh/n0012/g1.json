[[{"t":"彼对诸欲不期待我言斯人寂静者","level":0,"quote":true},{"t":"系缚於彼不存在於彼能度诸系著","level":0,"quote":true},{"t":"（一〇）","level":0},{"t":"八五八","level":0},{"t":"彼无妻子无家畜田地器具亦无有","level":0,"quote":true},{"t":"彼乃无我无常见断见非我亦不得","level":0,"quote":true},{"t":"（一一）","level":0},{"t":"八五九","level":0},{"t":"凡夫沙门婆罗门贪廉之行苛论彼","level":0,"quote":true},{"t":"彼於贪等皆不顾对诸苛论彼不动","level":0,"quote":true},{"t":"（一二）","level":0},{"t":"八六〇","level":0},{"t":"远离贪求无悭吝牟尼虽对於得胜","level":0,"quote":true},{"t":"或等或劣皆不论无别不至妄分别","level":0,"quote":true},{"t":"（一三）","level":0},{"t":"八六一","level":0},{"t":"彼於世间无所有更亦无忧无所有","level":0,"quote":true},{"t":"彼於诸法皆不至彼实可谓寂静者」","level":0,"quote":true},{"t":"（一四）","level":0},{"t":"死前经竟","level":0},{"t":"一一　斗诤经","level":0},{"t":"八六二","level":0},{"t":"「争斗诤论悲愁悭慢与过慢及两舌","level":0,"quote":true},{"t":"此由何处令生起冀愿世尊为我说」","level":0,"quote":true},{"t":"（一）","level":0},{"t":"八六三","level":0},{"t":"「争斗诤讼悲与愁慢及过慢并悭吝","level":0,"quote":true},{"t":"两舌皆由爱所生争斗诤讼伴悭贪","level":0,"quote":true},{"t":"争讼生时有两舌」","level":0,"quote":true},{"t":"（二）","level":0},{"t":"八六四","level":0},{"t":"「爱於世间何因缘世间诸人皆为贪","level":0,"quote":true},{"t":"彷徨贪欲何因缘此为人人所依趣","level":0,"quote":true},{"t":"意欲成就何因缘」","level":0,"quote":true},{"t":"（三）","level":0},{"t":"八六五","level":0},{"t":"「爱於世间欲因缘人於世间生贪欲","level":0,"quote":true},{"t":"彷徨贪欲之因缘此为人人所依趣","level":0,"quote":true},{"t":"意欲成就欲因缘」","level":0,"quote":true},{"t":"（四）","level":0},{"t":"八六六","level":0},{"t":"「欲於世间何因缘决定所见何处生","level":0,"quote":true},{"t":"疑妄语沙门说此诸烦恼何处生」","level":0,"quote":true},{"t":"（五）","level":0},{"t":"八六七","level":0},{"t":"「世间可意不可意此为近依因欲生","level":0,"quote":true},{"t":"於诸色见有无有人以世间为定见","level":0,"quote":true},{"t":"（六）","level":0},{"t":"八六八","level":0},{"t":"忿与妄语及疑惑此等诸法有二者","level":0,"quote":true},{"t":"可不可意发生时疑惑者佛之所说","level":0,"quote":true},{"t":"知法智路为应学」","level":0,"quote":true},{"t":"（七）","level":0},{"t":"八六九","level":0},{"t":"「可不可意何因缘何者无时此等无","level":0,"quote":true},{"t":"有与无有等之义以何因缘为我说」","level":0,"quote":true},{"t":"（八）","level":0},{"t":"八七〇","level":0},{"t":"「可不可意触因缘触若无时此等无","level":0,"quote":true},{"t":"与有无有等之义以触为缘我语汝」","level":0,"quote":true},{"t":"（九）","level":0},{"t":"八七一","level":0},{"t":"「触於世间何因缘又或徧取何处生","level":0,"quote":true},{"t":"何无之时执无我何无之时触非触」","level":0,"quote":true},{"t":"（一〇）","level":0},{"t":"八七二","level":0},{"t":"「名色为缘而有触欲求为缘有徧取","level":0,"quote":true},{"t":"欲求无时我执无色无之时触非触」","level":0,"quote":true},{"t":"（一一）","level":0},{"t":"八七三","level":0},{"t":"「云何行者为无色如何乐苦而为无","level":0,"quote":true},{"t":"云何为无对我说我意欲知其所以」","level":0,"quote":true},{"t":"（一二）","level":0},{"t":"八七四","level":0},{"t":"「既非想想亦非无无想想非无想想","level":0,"quote":true},{"t":"想想者无想想者如是行者色既无","level":0,"quote":true},{"t":"障碍以想为因缘」","level":0,"quote":true},{"t":"（一三）","level":0},{"t":"八七五","level":0},{"t":"「尊师已答我等问问尊师者冀为说","level":0,"quote":true},{"t":"非想非非想处定谓是人之最高净","level":0,"quote":true},{"t":"抑或更有其他净」","level":0,"quote":true},{"t":"（一四）","level":0},{"t":"八七六","level":0},{"t":"「或有贤者持此说谓是人之最高净","level":0,"quote":true},{"t":"彼等善说无餘依说灭始是最高净","level":0,"quote":true},{"t":"（一五）","level":0},{"t":"八七七","level":0},{"t":"知彼依著诸见者观慧牟尼知依著","level":0,"quote":true},{"t":"慧者不复归诸有知解脱者无诤论」","level":0,"quote":true},{"t":"（一六）","level":0},{"t":"斗诤经竟","level":0},{"t":"一二　小集积经","level":0},{"t":"八七八","level":0},{"t":"「恶见者徧住己见异执自善种种论","level":0,"quote":true},{"t":"如斯知者能知法呵责此者非究竟","level":0,"quote":true},{"t":"（一）","level":0},{"t":"八七九","level":0},{"t":"彼等争论持异执且言他愚与不善","level":0,"quote":true},{"t":"彼等一切说自善彼中何论有真理","level":0,"quote":true},{"t":"（二）","level":0},{"t":"八八〇","level":0},{"t":"不受他人之法见愚者劣者贱劣慧","level":0,"quote":true},{"t":"彼等徧住自见故不外愚贱劣慧者","level":0,"quote":true},{"t":"（三）","level":0},{"t":"八八一","level":0},{"t":"若依自见诤论者善净慧者具慧者","level":0,"quote":true},{"t":"彼等所见皆究竟其中无有劣慧者","level":0,"quote":true},{"t":"（四）","level":0},{"t":"八八二","level":0},{"t":"相互敌对言愚见此见如真我不言","level":0,"quote":true},{"t":"彼等各执为真理是故见他为愚者」","level":0,"quote":true},{"t":"（五）","level":0},{"t":"八八三","level":0},{"t":"「人谓真理或如真言他诸人为虚妄","level":0,"quote":true},{"t":"如斯异执起诤论何故沙门不一致」","level":0,"quote":true},{"t":"（六）","level":0},{"t":"八八四","level":0},{"t":"「真理唯一无有二知解自知何诤论","level":0,"quote":true},{"t":"彼诸恶见称真理故说沙门不一致","level":0,"quote":true},{"t":"（七）","level":0},{"t":"八八五","level":0},{"t":"自称为善议论者何故种种说真理","level":0,"quote":true},{"t":"彼多真理闻由他彼等或由自思择","level":0,"quote":true},{"t":"（八）","level":0},{"t":"八八六","level":0},{"t":"除去依想诸常道世间无有多真理","level":0,"quote":true},{"t":"徧计思择於诸见而称真理或虚妄","level":0,"quote":true},{"t":"（九）","level":0},{"t":"八八七","level":0},{"t":"见闻戒修与觉知依止此等蔑视他","level":0,"quote":true},{"t":"定立己见心喜悦言他是愚或不善","level":0,"quote":true},{"t":"（一〇）","level":0},{"t":"八八八","level":0},{"t":"以他为愚之所见故而称己是至善","level":0,"quote":true},{"t":"彼说自己是为善轻蔑於他斯起诤","level":0,"quote":true},{"t":"（一一）","level":0},{"t":"八八九","level":0},{"t":"过误之见彼成就狂慢自思为完整","level":0,"quote":true},{"t":"第一人者意自认如斯之见为成就","level":0,"quote":true},{"t":"（一二）","level":0},{"t":"八九〇","level":0},{"t":"以他言语为贱劣彼亦共成贱劣者","level":0,"quote":true},{"t":"自称吠陀贤达人沙门之中无愚者","level":0,"quote":true},{"t":"（一三）","level":0},{"t":"八九一","level":0},{"t":"『我说之外所宣法违反净法非完者』","level":0,"quote":true},{"t":"如斯外道作住著彼贪自见染著故","level":0,"quote":true},{"t":"（一四）","level":0},{"t":"八九二","level":0},{"t":"『唯此我说乃有净言餘诸法难清净』","level":0,"quote":true},{"t":"如此住著诸外道坚持以论自己道","level":0,"quote":true},{"t":"（一五）","level":0},{"t":"八九三","level":0},{"t":"坚持以论自道者於兹何以见他愚","level":0,"quote":true},{"t":"说他愚见不净法彼自固执於将来","level":0,"quote":true},{"t":"（一六）","level":0},{"t":"八九四","level":0},{"t":"自当善量立定见彼於世间起诤论","level":0,"quote":true},{"t":"若舍一切决定见人於世间不固执」","level":0,"quote":true},{"t":"（一七）","level":0},{"t":"小集积经竟","level":0},{"t":"一三　大集积经","level":0},{"t":"八九五","level":0},{"t":"「此等之见徧住者唯此真理起诤论","level":0,"quote":true},{"t":"彼等由他蒙毁訾只於自派受赞赏","level":0,"quote":true},{"t":"（一）","level":0},{"t":"八九六","level":0},{"t":"鄙小赏赞不趋寂我言诤讼唯毁誉","level":0,"quote":true},{"t":"如是无诤为安稳观察汝等不可诤","level":0,"quote":true},{"t":"（二）","level":0},{"t":"八九七","level":0},{"t":"世间此等诸凡俗知者不与彼等近","level":0,"quote":true},{"t":"对於见闻不为忍不近著者何得近","level":0,"quote":true},{"t":"（三）","level":0},{"t":"八九八","level":0},{"t":"自制有净最上戒受持勤修而著住","level":0,"quote":true},{"t":"自见修学应有净彼等善说有引拉","level":0,"quote":true},{"t":"（四）","level":0},{"t":"八九九","level":0},{"t":"若以亡失戒行者违背戒行彼骇怖","level":0,"quote":true},{"t":"彼兹热望冀求净如出家者离商队","level":0,"quote":true},{"t":"（五）","level":0},{"t":"九〇〇","level":0},{"t":"舍断一切戒苦修又舍有罪无罪业","level":0,"quote":true},{"t":"净与不净不冀求寂无取著行离贪","level":0,"quote":true},{"t":"（六）","level":0},{"t":"九〇一","level":0},{"t":"近依所厌之苦行或亲见闻与觉知","level":0,"quote":true},{"t":"举声称净说述者对於诸有不离爱","level":0,"quote":true},{"t":"（七）","level":0},{"t":"九〇二","level":0},{"t":"不断冀求诸热望徧计时有破损惧","level":0,"quote":true},{"t":"处兹无死无生者彼无热望何骇怖","level":0,"quote":true},{"t":"（八）","level":0},{"t":"九〇三","level":0},{"t":"或人所言第一法其他诸人谓是劣","level":0,"quote":true},{"t":"彼等皆善说自见彼等何有真理说","level":0,"quote":true},{"t":"（九）","level":0},{"t":"九〇四","level":0}],[{"t":"自己之法为完整他人之法是低劣","level":0,"quote":true},{"t":"如斯异执起诤论各谓假俗是真理","level":0,"quote":true},{"t":"（一〇）","level":0},{"t":"九〇五","level":0},{"t":"被人轻贱说为劣诸法之中无一胜","level":0,"quote":true},{"t":"如此坚持自法论说他之法为贱劣","level":0,"quote":true},{"t":"（一一）","level":0},{"t":"九〇六","level":0},{"t":"如同赞赏自己道尊敬自己所属法","level":0,"quote":true},{"t":"一切议论应如真彼等各自皆成净","level":0,"quote":true},{"t":"（一二）","level":0},{"t":"九〇七","level":0},{"t":"不为他导婆罗门诸法决定无执取","level":0,"quote":true},{"t":"故彼超越诸诤论不见他法为最胜","level":0,"quote":true},{"t":"（一三）","level":0},{"t":"九〇八","level":0},{"t":"『我知我见唯如真』依见解净有诸人","level":0,"quote":true},{"t":"若是依见自何为不解四谛越正见","level":0,"quote":true},{"t":"依他彼等说净法","level":0,"quote":true},{"t":"（一四）","level":0},{"t":"九〇九","level":0},{"t":"有见者不见名色见已不得知常乐","level":0,"quote":true},{"t":"任其多少见名色诸善巧者不说净","level":0,"quote":true},{"t":"（一五）","level":0},{"t":"九一〇","level":0},{"t":"执著论者难调伏徧计之见彼重视","level":0,"quote":true},{"t":"诸师说净依自见自见如真净说者","level":0,"quote":true},{"t":"（一六）","level":0},{"t":"九一一","level":0},{"t":"正察妄想无分别以智不亲诸爱见","level":0,"quote":true},{"t":"彼知假俗凡俗见舍置他人取著见","level":0,"quote":true},{"t":"（一七）","level":0},{"t":"九一二","level":0},{"t":"牟尼遣世诸系缚生诸诤论不加入","level":0,"quote":true},{"t":"彼寂无关诸不寂不取他人取著见","level":0,"quote":true},{"t":"（一八）","level":0},{"t":"九一三","level":0},{"t":"舍弃旧漏不作新无欲不为执著论","level":0,"quote":true},{"t":"智者解脱诸恶见不染世间自呵责","level":0,"quote":true},{"t":"（一九）","level":0},{"t":"九一四","level":0},{"t":"彼於一切之诸法见闻觉知破恼住","level":0,"quote":true},{"t":"卸除重担得解脱分别爱乐无冀求」","level":0,"quote":true},{"t":"（二〇）","level":0},{"t":"世尊如斯宣说已","level":0},{"t":"大集积经竟","level":0},{"t":"一四　迅速经","level":0},{"t":"九一五","level":0},{"t":"「日种大仙我尊师请问远离与寂句","level":0,"quote":true},{"t":"於世云何见比丘不取何物而寂灭」","level":0,"quote":true},{"t":"（一）","level":0},{"t":"九一六","level":0},{"t":"世尊曰：","level":0},{"t":"「我慢乃为诸障本一切真慧亦绝灭","level":0,"quote":true},{"t":"内心所有一切爱调伏此等常念学","level":0,"quote":true},{"t":"（二）","level":0},{"t":"九一七","level":0},{"t":"知通内外所有法由彼强慢不可为","level":0,"quote":true},{"t":"自言我今成寂灭为诸善人所不说","level":0,"quote":true},{"t":"（三）","level":0},{"t":"九一八","level":0},{"t":"依慢而胜不可思虽劣等同亦不念","level":0,"quote":true},{"t":"应具种种诸胜德自己不再妄分别","level":0,"quote":true},{"t":"（四）","level":0},{"t":"九一九","level":0},{"t":"内心时时应寂静比丘不由他求寂","level":0,"quote":true},{"t":"於内成就寂静者无我更何有非我","level":0,"quote":true},{"t":"（五）","level":0},{"t":"九二〇","level":0},{"t":"譬如海洋正中央波浪不生常止静","level":0,"quote":true},{"t":"如斯静止成不动比丘何处不增盛」","level":0,"quote":true},{"t":"（六）","level":0},{"t":"九二一","level":0},{"t":"「汝明眼者自内证调伏危险述涅槃","level":0,"quote":true},{"t":"汝贤善者说行道说定说戒别解脱」","level":0,"quote":true},{"t":"（七）","level":0},{"t":"九二二","level":0},{"t":"「以眼不可生动贪卑俗之论尽於耳","level":0,"quote":true},{"t":"美味之觉莫贪求世间何物我无执","level":0,"quote":true},{"t":"（八）","level":0},{"t":"九二三","level":0},{"t":"有触为病被触时比丘决不可悲泣","level":0,"quote":true},{"t":"不可热望世诸有对诸恐怖无骇惧","level":0,"quote":true},{"t":"（九）","level":0},{"t":"九二四","level":0},{"t":"食物饮物及硬食衣服等得不贮藏","level":0,"quote":true},{"t":"彼等虽为无有得不为因此生恐惧","level":0,"quote":true},{"t":"（一〇）","level":0},{"t":"九二五","level":0},{"t":"沉思静虑莫彷徨远离恶作不放逸","level":0,"quote":true},{"t":"坐处卧处皆无声比丘应作如是住","level":0,"quote":true},{"t":"（一一）","level":0},{"t":"九二六","level":0},{"t":"睡卧不可屡屡