"一〇二四","level":0},{"t":"「诸天乃至众梵天须阇之夫帝释天","level":0,"quote":true},{"t":"我等意中发质问向谁应答此是问」","level":0,"quote":true},{"t":"（四九）","level":0},{"t":"一〇二五","level":0},{"t":"「我等之师婆和利徧问顶与顶裂智","level":0,"quote":true},{"t":"敬请世尊教我等仙人请除我等疑」","level":0,"quote":true},{"t":"（五〇）","level":0},{"t":"一〇二六","level":0},{"t":"「无明为顶应须知信心正念及禅定","level":0,"quote":true},{"t":"欲与精进得相应明是顶裂有关智」","level":0,"quote":true},{"t":"（五一）","level":0},{"t":"一〇二七","level":0},{"t":"如是於此诸学童发起感激大狂喜","level":0,"quote":true},{"t":"偏袒衣服羚羊皮头面顶礼佛两足","level":0,"quote":true},{"t":"（五二）","level":0},{"t":"一〇二八","level":0},{"t":"「彼婆罗门婆和利乃至诸弟子等俱","level":0,"quote":true},{"t":"彼等踊跃心欢悦头面顶礼世尊足」","level":0,"quote":true},{"t":"（五三）","level":0},{"t":"一〇二九","level":0},{"t":"「彼婆罗门婆和利乃至弟子共安乐","level":0,"quote":true},{"t":"学童汝亦应如是获得安乐且长寿","level":0,"quote":true},{"t":"（五四）","level":0},{"t":"一〇三〇","level":0},{"t":"婆和利以及汝等一切疑问悉令解","level":0,"quote":true},{"t":"汝等之意欲须问莫论何事尽可问」","level":0,"quote":true},{"t":"（五五）","level":0},{"t":"一〇三一","level":0},{"t":"由正觉者令解明学童合掌而旁坐","level":0,"quote":true},{"t":"阿耆多面向如来此乃第一之请问","level":0,"quote":true},{"t":"（五六）","level":0},{"t":"序偈讫","level":0},{"t":"二　阿耆多学童所问","level":0},{"t":"一〇三二","level":0},{"t":"尊者阿耆多曰：","level":0},{"t":"「因何世间有五盖因何世间无光辉","level":0,"quote":true},{"t":"何以世间有染著何以言是大怖畏」","level":0,"quote":true},{"t":"（一）","level":0},{"t":"一〇三三","level":0},{"t":"世尊宣曰：「阿耆多","level":0},{"t":"世间缘无明有盖悭吝放逸故无辉","level":0,"quote":true},{"t":"我言热望起染著苦是世间大怖畏」","level":0,"quote":true},{"t":"（二）","level":0},{"t":"一〇三四","level":0},{"t":"尊者阿耆多曰：","level":0},{"t":"「烦恼流徧一切处","level":0,"quote":true},{"t":"云何其流成遮障流之防护请语我","level":0,"quote":true},{"t":"依何其流得闭塞？」","level":0,"quote":true},{"t":"（三）","level":0},{"t":"一〇三五","level":0},{"t":"世尊曰：「阿耆多","level":0},{"t":"世间所有烦恼流","level":0,"quote":true},{"t":"其流遮障是为念流之防护我语汝","level":0,"quote":true},{"t":"依慧此等使闭塞」","level":0,"quote":true},{"t":"（四）","level":0},{"t":"一〇三六","level":0},{"t":"尊者阿耆多曰：","level":0},{"t":"「慧与念及名与色","level":0,"quote":true},{"t":"如何情形可湮灭我今以此问世尊","level":0,"quote":true},{"t":"〔请佛世尊〕为我说」","level":0,"quote":true},{"t":"（五）","level":0},{"t":"一〇三七","level":0},{"t":"「汝阿耆多如斯问我今语汝其因由","level":0,"quote":true},{"t":"识灭既已名色灭此处慧念名色灭」","level":0,"quote":true},{"t":"（六）","level":0},{"t":"一〇三八","level":0},{"t":"「一切诸法察悟者及此凡夫诸有学","level":0,"quote":true},{"t":"彼等之动作行道我问智者请语我」","level":0,"quote":true},{"t":"（七）","level":0},{"t":"一〇三九","level":0},{"t":"「诸欲不可以贪求心意混浊不可有","level":0,"quote":true},{"t":"於一切法之善巧有念比丘应普行」","level":0,"quote":true},{"t":"（八）","level":0},{"t":"阿耆多学童所问讫","level":0},{"t":"三　帝须弥勒学童所问","level":0},{"t":"一〇四〇","level":0},{"t":"尊者帝须弥勒曰：","level":0},{"t":"「谁於此世为满足谁於此世不动贪","level":0,"quote":true},{"t":"谁能知达於两端慧智不著於中端","level":0,"quote":true},{"t":"世间谁谓是大人谁能於兹超缝爱」","level":0,"quote":true},{"t":"（一）","level":0},{"t":"一〇四一","level":0},{"t":"世尊曰：「弥勒","level":0},{"t":"於诸欲中具梵行远离渴爱常有念","level":0,"quote":true},{"t":"比丘寂灭察悟法於彼心中不动贪","level":0,"quote":true},{"t":"（二）","level":0},{"t":"一〇四二","level":0},{"t":"彼能知达於两端不著中端以智慧","level":0,"quote":true},{"t":"我即言彼是大人彼能於兹超缝爱」","level":0,"quote":true},{"t":"（三）","level":0},{"t":"帝须弥勒学童所问讫","level":0},{"t":"四　富那迦学童所问","level":0},{"t":"一〇四三","level":0},{"t":"尊者富那迦曰：","level":0},{"t":"「世尊不动见根本我今前来欲请问","level":0,"quote":true},{"t":"为何仙人刹帝利婆罗门与诸人等","level":0,"quote":true},{"t":"广为诸天行供养我请尊师为我语」","level":0,"quote":true},{"t":"（一）","level":0},{"t":"一〇四四","level":0},{"t":"世尊曰：「富那迦","level":0},{"t":"此等仙人刹帝利婆罗门与诸人等","level":0,"quote":true},{"t":"广为诸天行供养富那迦彼望人天","level":0,"quote":true},{"t":"富那迦彼望人天」","level":0,"quote":true},{"t":"（二）","level":0},{"t":"一〇四五","level":0},{"t":"尊者富那迦曰：","level":0},{"t":"「诸仙人与刹帝利","level":0,"quote":true},{"t":"婆罗门与诸人等广为诸天行供养","level":0,"quote":true},{"t":"彼等供养不放逸果能得度生老否","level":0,"quote":true},{"t":"我请世尊为我语」","level":0,"quote":true},{"t":"（三）","level":0},{"t":"一〇四六","level":0},{"t":"世尊曰：「富那迦","level":0},{"t":"希望赞叹望献供热望诸欲缘利得","level":0,"quote":true},{"t":"彼等供养有贪染我言不能度死生」","level":0,"quote":true},{"t":"（四）","level":0},{"t":"一〇四七","level":0},{"t":"尊者富那迦曰：","level":0},{"