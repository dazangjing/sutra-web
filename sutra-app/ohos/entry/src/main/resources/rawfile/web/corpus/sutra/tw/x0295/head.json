{"id":"x0295","title":"楞嚴經述旨","titleTrad":"楞嚴經述旨","byline":"唐天竺沙門","bylineLabel":"著者·译者","dynasty":"","division":"经疏部","canon":"X0295","canonName":"新纂卍續藏","volume":"X0295","juanCount":10,"textLength":76793,"imageCount":0,"summary":"","tags":["经疏部","新纂卍續藏"],"order":1421,"guide":"","chunks":27,"toc":[{"level":2,"text":"大佛頂如來密因修證了義諸菩薩萬行首楞嚴經卷第一"},{"level":3,"text":"徵心品第一"},{"level":3,"text":"辯見品第二"},{"level":3,"text":"分別外道品第四"},{"level":3,"text":"見妄品第五"},{"level":3,"text":"覺非和合品第六"},{"level":3,"text":"外道因緣自然疑辯品第十二"},{"level":3,"text":"訶責戲論品第十三"},{"level":3,"text":"決定二義品第十四"},{"level":3,"text":"圓六湛品第十五"},{"level":3,"text":"究竟修因品第十六"},{"level":2,"text":"多羅貝多樹也，刀斷則不復生。卷第六"},{"level":3,"text":"長道體，圓十身，為佛子，任佛事，此十住始終之序"},{"level":3,"text":"精研七趣品第二十八"}],"chunksPerFile":20}