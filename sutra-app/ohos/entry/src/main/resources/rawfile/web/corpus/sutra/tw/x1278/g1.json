[[{"t":"師，白髮老僧七十五。","level":0},{"t":"佛佛授手無多子，祖祖相傳似海深。昨夜西風撼門","level":0},{"t":"扇，天明無迹可追尋。","level":0},{"t":"栗色伽黎千百結，倚松捫腹看雲飛，有人問我雲山","level":0},{"t":"趣，向道春深筍蕨肥。","level":0},{"t":"山中十日九日雨，樹頭青子落不住，白犬尋蹤入草","level":0},{"t":"間，驚起竹雞飛上樹。","level":0},{"t":"一樹青松一抹煙，一輪明月一泓𭥚，丹青若寫歸圖","level":0},{"t":"畫，添箇頭陀坐石邊。","level":0},{"t":"新縫紙被烘來煖，一覺安眠到五更，聞得上方鐘鼓","level":0},{"t":"動，又添一日在浮生。","level":0},{"t":"生涯滿目是青山，一榻翛然屋半間，不是老僧誇富","level":0},{"t":"貴，日閒閒又夜閒閒。","level":0},{"t":"谿上坐來久，谿聲流水長隔籬煙上竹，道者煑茶湯。","level":0},{"t":"占得溪房最上層，山中拋却一堂僧，小園祇在欄杆","level":0},{"t":"下，自摘青棃雜飯蒸。","level":0},{"t":"背負斜陽出西堰，春雲狼藉藏春阪。過一谿橋見一","level":0},{"t":"邨，人聲漸近松聲遠。","level":0},{"t":"乘閒偶出青山去，日暮歸來趁野泉谷口是曾風雨","level":0},{"t":"過，草堂修竹亂春煙。","level":0},{"t":"梅花昨夜破寒汀，曉日初融露尚零無事道人翻有","level":0},{"t":"事，一枝先供佛前瓶。","level":0},{"t":"送雨風無力，流花水不情啼春枝上鳥，今日更分明","level":0},{"t":"。","level":0},{"t":"半生株守獨家邨，愛月常常不閉門枯木作菴伸脚","level":0},{"t":"睡，風流不減雪峯存。","level":0}],[{"t":"雜毒海卷八","level":2},{"t":"<strong>译者</strong>：京都柏林嗣祖沙門　性音　重編","level":0},{"t":"山居山居山居","level":0},{"t":"三間茅屋從來住，一道神光萬境閒。莫把是非來辨","level":0},{"t":"我，浮生穿鑿不相關。","level":0},{"t":"一杯晴雪早茶香，午睡初醒春晝長。拶著通身俱是","level":0},{"t":"眼，半窗疎影轉斜陽。","level":0},{"t":"春山筍蕨正蒙茸，好把黃粱徹夜舂，莫謂西來無此","level":0},{"t":"意，祖師渾在󰊇盂中。","level":0},{"t":"山靜課花蜂股重，林空含籜筍肌明，倚欄不覺成癡","level":0},{"t":"兀，又得黃鸝喚一聲。","level":0},{"t":"紫蕨伸拳筍破梢，楊花飛盡綠陰交，分明西祖單傳","level":0},{"t":"句，黃鸝留鳴燕語巢。","level":0},{"t":"就樹縛茅成屋住，拾荊編戶傍谿開，是他嬾瓚無靈","level":0},{"t":"驗，惹得天書動地來。","level":0},{"t":"冷風疎雨做新年，寂寞寒冰古<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00589.gif\" alt=\"㵎\" title=\"㵎\" />邊暖閣地爐煨榾","level":0},{"t":"柮，送窮不用更燒錢。","level":0},{"t":"草堂秋似廣寒宮，金色花開碧玉叢坐久不知凡骨","level":0},{"t":"換，天香清散月明中。","level":0},{"t":"茶罷焚香獨坐時，金蓮水滴漏聲遲。夜深欲睡問童","level":0},{"t":"子，月上梅花第幾枝。","level":0},{"t":"無事山房門不開，土階春雨綠生苔，此心將謂無人","level":0},{"t":"委，幽鳥一聲何處來？","level":0},{"t":"竹裏編茅倚石根，竹莖疎處見前邨閒眠盡日無人","level":0},{"t":"到，自有清風為埽門。","level":0},{"t":"煑菜無鹽懶去賒，化糧道者未還家，一條百衲拈來","level":0},{"t":"看，昨夜霜添瓦上花。","level":0},{"t":"蕎麥花開曉日晴，喚來童子聽叮嚀。好將紫芋收歸","level":0},{"t":"了，<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06078.gif\" alt=\"𢹂\" title=\"𢹂\" />取長鑱劚茯苓。","level":0},{"t":"處世心如臘月冰，住山自笑百無能。菜羮且莫熬油","level":0},{"t":"者，留點堂前供佛燈。","level":0},{"t":"鼓腹而遊是何日？無事乘閒向谿立，谿風晚生谿樹","level":0},{"t":"寒，谿上落花高一尺。","level":0},{"t":"買山開地別為家，折霧盤雲小徑斜。人跡如今到不","level":0},{"t":"到，侵階祇看紫苔花。","level":0},{"t":"麻製衣裳草結廬，疎人先就我身疎。得車失馬都休","level":0},{"t":"問，萬事我今面壁初。","level":0},{"t":"山紅草碧萬點螢，樹中落落黃茅亭。微風吹座更吹","level":0},{"t":"我，明月照人還照經。","level":0},{"t":"昨夜秋風忽作威，白雲和葉曉還飛，幽人不用頻頻","level":0},{"t":"埽，況此山深客到稀。","level":0},{"t":"豈為老來登眺少？却因病後得閒多。呼童洗硯無他","level":0},{"t":"事，重寫當年破院歌。","level":0},{"t":"寰中獨許五臺高，無位真人伴寂寥，一任諸方風浩","level":0},{"t":"浩，常空兩眼視雲霄。","level":0},{"t":"甘貧林下思悠悠，竹榻高眠石枕頭。格外生涯隨分","level":0},{"t":"足，都緣胷次略無求。","level":0},{"t":"自住丹巖綠水傍，了無榮辱與閒忙。老僧不會還源","level":0},{"t":"旨，一任青山青又黃。","level":0},{"t":"深隱巖阿不記年，名韁利鎖莫能牽。七斤衫子重聯","level":0},{"t":"補，日炙風吹寂轉鮮。","level":0},{"t":"颯颯春風和鳥哀，清音直到耳邊來。爐燒柏子端然","level":0},{"t":"坐，對月殘經又展開。","level":0},{"t":"凝眸終日對青山，石几爐煙意自閒懸榻久無高士","level":0},{"t":"駕，劃然長嘯白雲閒。","level":0},{"t":"大千總是一茅廬，善惡都從箇裏居。長的長來短的","level":0},{"t":"短，得便宜處失便宜。","level":0},{"t":"荊谿陽羨佳山水，無福消受也難居翠竹蒼松千萬","level":0},{"t":"頃，紅塵飛不到庭除。","level":0},{"t":"山中有居薜蘿下，山中有人瘦入畫，人兮歸來勿久","level":0},{"t":"淹，莫遣蘿陰逐時化。","level":0},{"t":"春雲裂破一聲鳥，七片五片花飛沼。清冷莓苔爛石","level":0},{"t":"頭，新鮮薜茘穿林杪。","level":0},{"t":"老倒扶寒破衲遮，黃昏眠去五更鴉。通身是痛醫難","level":0},{"t":"治，同病相憐誰作家。","level":0},{"t":"簾捲春風啼曉鴉，閒情無過是吾家，青山箇箇伸頭","level":0},{"t":"看，看我菴中喫苦茶。","level":0},{"t":"秋光一度正將殘，野菊無香木葉乾。入骨半窗寒雨","level":0},{"t":"過，愁人不在布衣單。","level":0},{"t":"半天紅日照青巒，草薦封門睡正酣。莫道老僧真箇","level":0},{"t":"懶，起來吹火怕風寒。","level":0},{"t":"青山茅屋洞雲齊，石壁煙蘿鳥合棲。誰道我年三十","level":0},{"t":"五，一身禪病懶如泥。","level":0},{"t":"昨夜夢回茅屋冷，石牀生筍竈生苔。糧空正欲尋知","level":0},{"t":"己，一片白雲谿上來。","level":0},{"t":"居山道者如何說？天際無雲月上竿，老兔地邊偷菜","level":0},{"t":"喫，齒寒嚼嚼又看看。","level":0},{"t":"一間破屋雲為幕，半樹枯梅雪作花。爐煖不知人睡","level":0},{"t":"去，夢回天曉竹林鴉。","level":0},{"t":"過橋數里道人家，亂放疎籬白荳花，扶杖科頭望雲","level":0},{"t":"到，燒香促膝喫杯茶。","level":0},{"t":"卜築青山身便安，黃毛捲雪火爐寒。添些骨董煨些","level":0},{"t":"粥，雲到柴門月已殘。","level":0},{"t":"三分月色七分秋，黃葉疎疎共水流。莫道寒光消落","level":0},{"t":"盡，更留煙雨在枝頭。","level":0},{"t":"宜花宜雨草分香，斷續歌聲山夢長。春老不啼樵徑","level":0},{"t":"晚，離離曲曲水雲鄉。","level":0},{"t":"從頭簡點總無能，枯木巖前老衲僧，信步<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06078.gif\" alt=\"𢹂\" title=\"𢹂\" />筐尋野","level":0},{"t":"菜，攀蘿又上一稜層。","level":0},{"t":"高居世外絕人求，深種良田自有秋，禪客扣門無可","level":0},{"t":"待，與他劈脊一拳頭。","level":0},{"t":"讀經未罷眼如醉，驅遣睡魔無秘方，山堂一枕眠方","level":0},{"t":"穩，門外千竿玉送涼。","level":0},{"t":"邨煙乞食路迢迢，火種刀耕足挂瓢，但得攀緣兩字","level":0},{"t":"免，紅塵無夢到雲霄。","level":0},{"t":"翻土刪雲驅行者，澆蔬引水課兒曹。莫嫌活計同流","level":0},{"t":"俗，佛法長年無一毫。","level":0},{"t":"清詞喜唱短長調，侍者唯留大小空。一等住山真快","level":0},{"t":"活，不分白月與清風。","level":0},{"t":"愛行千聖頂<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00576.gif\" alt=\"𩕳\" title=\"𩕳\" />路，喜說諸方剩下禪，身老而今多閣","level":0},{"t":"起，人來嬾得豎麤拳。","level":0},{"t":"橫塘十里隱菰蒲，紅樹邨邨入畫圖。聞說故人秋興","level":0},{"t":"好，小船昨夜宿西湖。","level":0},{"t":"師子遊行無伴侶，白雲冉冉眾峯高，祖師活計埋芳","level":0},{"t":"草，三界何曾挂眼梢？","level":0},{"t":"情義合時膠入漆，因緣離處火成<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01926.gif\" alt=\"灰\" title=\"灰\" />。木人花鳥機關","level":0},{"t":"絕，那有一絲恩怨來。","level":0},{"t":"了了瞻烏知兩月，綠雲芳草意遲遲。老年厭說忘情","level":0},{"t":"語，新竹滿林花滿枝。","level":0},{"t":"夜深何處是清秋，月在青山雲乍收。坐倚繩牀開戶","level":0},{"t":"牗，故鄉天盡望西頭。","level":0},{"t":"野雲香帶焙茶煙，布穀聲頻穀雨前。會得一花同淨","level":0},{"t":"妙，不妨消遣住山緣。","level":0},{"t":"三有大城無事客，五濁惡世太平僧。鼻頭烈火沒些","level":0},{"t":"子，肚裏寒<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01926.gif\" alt=\"灰\" title=\"灰\" />有數升。","level":0},{"t":"破舊衲衣縫又補，郎當茅屋拄還撐，不能入眾同寒","level":0},{"t":"拾，燒火邏齋過一生。","level":0},{"t":"深山大澤家風冷，麥飯柴門笑語香。閒踏雪晴乘瘦","level":0},{"t":"蹇，衝寒野老惠壺漿。","level":0},{"t":"月色一天茗椀白，梅花十樹草堂清。此時想箇同消","level":0},{"t":"受，頻看牀前折脚鐺。","level":0},{"t":"少眠每笑祥叉手，多病嘗嗟燦赤頭。起意年來也改","level":0},{"t":"作，與他兩箇認同流。","level":0},{"t":"薙草燒田土脈肥，離離葵藿滿荊扉山廚自足充清","level":0},{"t":"供，客至何須更採薇。","level":0},{"t":"芒鞋踏破寒林色，遍地芬芳綴落梅。野󳭋餐餘香滿","level":0},{"t":"舌，宮商不是等閒來。","level":0},{"t":"一榻松風來枕上，凉生背後最相宜老儂一種天真","level":0},{"t":"樂，萬兩黃金不讓伊。","level":0},{"t":"曉日微明煙樹叢，采芝人立板橋東平抽石筍花朝","level":0},{"t":"雨，淡卷溪雲谷口風。","level":0},{"t":"石幢雨霽月華明，自笑頻年夢不生。眼底已空今古","level":0},{"t":"事，襟懷不讓碧潭清。","level":0},{"t":"廛居廛居","level":0},{"t":"閙叢叢裏密提撕，門掩春風日又低，冷地有時親聽","level":0},{"t":"得，賣花聲在畫樓西。","level":0},{"t":"水居水居","level":0},{"t":"壁黏祖偈風吹落，簷罥蛛絲雨打開，滿徑綠陰花落","level":0},{"t":"盡，門前百鳥不曾來。","level":0},{"t":"船居船居","level":0},{"t":"千尺絲綸直下埀，一波纔動萬波隨夜靜水寒魚不","level":0},{"t":"食，滿船空載月明歸。","level":0},{"t":"三十年來海上遊，水清魚現不吞鈎。釣竿斫盡重栽","level":0},{"t":"竹，不計功程得便休。","level":0},{"t":"葉內翰選日集賓迎優禮作偈辭之葉內翰選日，集賓迎優禮，作偈辭之","level":0},{"t":"昨日曾將今日期，出門倚杖又思惟，為僧祇合居巖","level":0},{"t":"谷，國士筵中甚不宜。","level":0},{"t":"普明牧牛十頌普明牧牛十頌","level":0},{"t":"未牧未牧","level":0},{"t":"生獰頭角恣跑哮，奔走溪山路轉遙，一片黑雲橫谷","level":0},{"t":"口，誰知步步犯佳苗？","level":0},{"t":"水草溪邊縱意哮，鼻頭無繫去迢遙，誰知宇踏皆王","level":0},{"t":"化？亂踏雲山犯稼苗。","level":0},{"t":"湘之南，潭之北，頭角分明，東觸西觸。","level":0},{"t":"初調初調","level":0},{"t":"我有芒繩驀鼻穿，一回奔競痛加鞭，從來劣性難調","level":0},{"t":"制，猶得山童盡力牽。","level":0},{"t":"鼻孔生獰不易穿，一回入草一加鞭，狂心何計能拴","level":0},{"t":"續？賴有山童把索牽。","level":0},{"t":"少護頭，多捕尾，月下風前，盛溺埽屎。","level":0},{"t":"受制受制","level":0},{"t":"漸調漸伏息奔馳，渡水穿雲步步隨手把芒繩無少","level":0},{"t":"緩，牧童終日自忘疲。","level":0},{"t":"熟徑難忘欲逞馳，芒繩在手緊相隨，豈容逐草尋芳","level":0},{"t":"去？晝夜拘拴不憚疲。","level":0},{"t":"面月白，蹄墨黑，有索有鈎，忍饑受渴。","level":0},{"t":"回首回首","level":0},{"t":"日久功深始轉頭，顛狂心力漸調柔，山童未肯全相","level":0},{"t":"許，猶把芒繩且繫留。","level":0},{"t":"翻然自肯便回頭，滿地殘紅襯草柔故國有懷情未","level":0},{"t":"撇，暗愁春老尚遲留。","level":0},{"t":"遠邪蹊，趨正道，步步登高，山長路杳。","level":0},{"t":"馴伏馴伏","level":0},{"t":"綠楊陰下古溪邊，放去收來得自然，日暮碧雲芳草","level":0},{"t":"地，牧童歸去不須牽。","level":0},{"t":"暖風晴日柳溪邊，俛首循人意悄然花落郊原春色","level":0},{"t":"晚，相隨歸去不須牽。","level":0},{"t":"戴寒鴉，履芳草，毛骨馨香，見者道好。","level":0},{"t":"無礙無礙","level":0},{"t":"露地安眠意自如，不勞鞭<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15081.gif\" alt=\"䇿\" title=\"䇿\" />永無拘，山童穩坐青松","level":0},{"t":"下，一曲昇平樂有餘。","level":0},{"t":"寒暑安忙，閒得故鄉寬廓，任出任入。","level":0},{"t":"任運任運","level":0},{"t":"柳岸春波夕照中，淡煙芳草綠茸茸饑餐渴飲隨時","level":0},{"t":"過，石上山童睡正濃。","level":0},{"t":"百花溪上柳陰中，飽食和雲臥綠茸歌罷山童無所","level":0},{"t":"事，遺鞭枕上睡方濃。","level":0},{"t":"朝隴畝，暮茅檐，隨時水草，明月同閒。","level":0},{"t":"相忘相忘","level":0},{"t":"白牛當在白雲中，人自無心牛亦同。月透白雲雲影","level":0},{"t":"白，白雲明月任西東。","level":0},{"t":"撐撐頭角臥林中，渠我渾忘雲水同，為愛山前蒭草","level":0},{"t":"細，夜深乘月過溪東。","level":0},{"t":"刀砍水，珠斷貫，澹泊明志，寧靜致遠。","level":0},{"t":"獨照獨照","level":0},{"t":"牛兒無處牧童閒，一片孤雲碧嶂間拍手高歌明月","level":0},{"t":"下，歸來猶有一重關。","level":0},{"t":"一道寒光萬境閒，寥寥四顧水雲間，夜深明月歸來","level":0},{"t":"晚，照徹空王向上關。","level":0},{"t":"失却牛，撞破壁，一箇窮身赤灑灑的。","level":0}],[{"t":"雙泯雙泯","level":0},{"t":"人牛不見杳無蹤，明月光寒萬象空，若問其中端的","level":0},{"t":"意，野花芳草自叢叢。","level":0},{"t":"人牛謾說絕形蹤，何異吹風欲滿空？若問還源親的","level":0},{"t":"旨，參天荊棘亂叢叢。","level":0},{"t":"拋靈符，瞎正目。函葢乾坤，火寒雪毒。","level":0},{"t":"梁山牧牛十頌梁山牧牛十頌","level":0},{"t":"尋牛尋牛","level":0},{"t":"忙忙撥草去追尋，水闊山遙路更深，力盡神疲無處","level":0},{"t":"覓，但聞楓樹晚蟬吟。","level":0},{"t":"暫時不在急須尋，莫待渠儂入草深，滿目青山何處","level":0},{"t":"去？祇消回首自沉吟。","level":0},{"t":"見跡見跡","level":0},{"t":"水邊林下跡偏多，荒草離披見也麼？蹤是深山更深","level":0},{"t":"處，撩天鼻孔爭藏他？","level":0},{"t":"也知隔遠苦無多，祇管貪程作甚麼？蹄踏蹄兮嘴對","level":0},{"t":"嘴，明明此物更非他。","level":0},{"t":"山坡柳岸蹄痕多，子細凝眸是也麼？識得跡蹤須著","level":0},{"t":"力，從今步步要尋它。","level":0},{"t":"見牛見牛","level":0},{"t":"黃鸝樹上一聲聲，日暖風和岸柳青，祇此更無迴避","level":0},{"t":"處，森森頭角畫難成。","level":0},{"t":"識得形容認得聲，戴嵩從此妙丹青，徹頭徹尾渾相","level":0},{"t":"似，子細看來未十成。","level":0},{"t":"遠遠忽聞呌幾聲，隔溪一望草青青，本來鼻孔端然","level":0},{"t":"在，縱使嵩公畫不成。","level":0},{"t":"得牛得牛","level":0},{"t":"竭盡精神獲得渠，心狂力壯卒難除，有時才到高原","level":0},{"t":"上，又入煙霞深處居。","level":0},{"t":"撩天鼻孔要穿渠，直待芒繩爛始除，向去不須分皂","level":0},{"t":"白，泥牛合水且同居。","level":0},{"t":"牧牛牧牛","level":0},{"t":"鞭索時時不離身，恐伊縱步惹埃塵。相將收得□□","level":0},{"t":"□，羈鎖無拘自逐人。","level":0},{"t":"甘分山林寄此身，有時亦踏馬蹄塵不曾犯著人苗","level":0},{"t":"稼，來往空勞背上人。","level":0},{"t":"騎牛騎牛","level":0},{"t":"騎牛迤邐欲還家，羗笛聲聲送晚霞，一拍一歌無限","level":0},{"t":"意，知音何必鼓唇牙？","level":0},{"t":"指點歬坡即是家，旋吹筒角出煙霞，忽然變作還鄉","level":0},{"t":"曲，未必知音是伯牙。","level":0},{"t":"歷盡溪山始到家，任從落日散雲霞，歸來不語程途","level":0},{"t":"事，何必逢人挂齒牙？","level":0},{"t":"忘牛存人忘牛存人","level":0},{"t":"騎牛已得到家山，牛也空兮人也閒，紅日三竿猶作","level":0},{"t":"夢，鞭繩空頓草堂間。","level":0},{"t":"欄內無牛趁出山，煙蓑雨笠亦空閒，行歌坐樂無拘","level":0},{"t":"繫，贏得一身天地間。","level":0},{"t":"千重雲樹萬重山，倒臥橫眠任我閒，此景畫圖收不","level":0},{"t":"得，誰言身在畫圖間？","level":0},{"t":"人牛俱忘人牛俱忘","level":0},{"t":"鞭索人牛盡屬空，碧天寥廓信難通紅爐<img class=\"gaiji\" src=\"asset://gaiji-CB/08/CB08504.gif\" alt=\"𦦨\" title=\"𦦨\" />上曾容","level":0},{"t":"雪，到此方能合正宗。","level":0},{"t":"人牛雙遣露真空，內外無私萬法通，莫立纖塵蹤跡","level":0},{"t":"泯，堂堂何處不歸宗？","level":0},{"t":"返本還源返本還源","level":0},{"t":"返本還源已費功，爭如直下若盲聾？菴中不見葊前","level":0},{"t":"物，水自茫茫花自紅。","level":0},{"t":"現成公案孰施功？眼不盲兮耳不聾，一一音聲諸色","level":0},{"t":"相，分明黑白間青紅。","level":0},{"t":"入廛垂手入廛垂手","level":0},{"t":"露胷跣足入廛來，抹土塗<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01926.gif\" alt=\"灰\" title=\"灰\" />笑滿腮，不用神仙真妙","level":0},{"t":"訣，直教枯休放花開。","level":0},{"t":"殺人便解活人來，<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15168.gif\" alt=\"𩮻\" title=\"𩮻\" />頷何妨又託腮，甘作畜生行異","level":0},{"t":"類，重重關鎖盡𤈭開。","level":0},{"t":"酒肆淫房任往來，莫教腦後露雙腮，全身同事全機","level":0},{"t":"攝，要使羣生眼盡開。","level":0},{"t":"時節元旦元旦","level":0},{"t":"新歲新春雪又濃，森羅萬象盡皆同，相逢莫認者般","level":0},{"t":"事，筋斗全拋示祖風。","level":0},{"t":"百年難遇歲朝春，姹女梳粧越樣新，惟有東邨王大","level":0},{"t":"姐，依前滿面是埃塵。","level":0},{"t":"太湖山上賀新年，萬象森羅笑揭天，驚得泥牛吞石","level":0},{"t":"虎，塵塵剎剎自安然。","level":0},{"t":"一年三百六十日，今日分明是初一。會得一兮萬事","level":0},{"t":"周，世間出世從茲立。","level":0},{"t":"立春立春","level":0},{"t":"無影枝頭一點春，可憐大地盡埋塵，陳年宿債昨宵","level":0},{"t":"盡，錯謂今朝又是新。","level":0},{"t":"春風纔動春花開，春雨相催春水來惟有通元峯頂","level":0},{"t":"石，依前白蘚與青苔。","level":0},{"t":"春風春載入春郊，春蹋春芳春事饒，春日釀春春最","level":0},{"t":"麗，春歌春鼓閙春宵。","level":0},{"t":"元宵元宵","level":0},{"t":"元宵佳節同歡樂，處處咸然無盡燈，火光爍破勝熱","level":0},{"t":"面，夜神忽喚冷頭疼。","level":0},{"t":"曠大劫來燈一椀，照天照地幾人知？要看不盡傳持","level":0},{"t":"處，兜率宮中夢覺時。","level":0},{"t":"春日春日","level":0},{"t":"兩兩三三陌上行，春雲踏碎一天青，雖然各立風光","level":0},{"t":"處，又較儂家半月程。","level":0},{"t":"解冬解冬","level":0},{"t":"祖師門下絕人行，深嶮過於萬丈阬，埀手不能空費","level":0},{"t":"力，任他堂上綠苔生。","level":0},{"t":"寒食寒食","level":0},{"t":"禁煙時節陳寒食，荒塚野田人啼泣，死髑髏上活眼","level":0},{"t":"開，鬼神茶飯俱打失。","level":0},{"t":"清明日日爽精神，風送楊花足四隣，分付子規謾啼","level":0},{"t":"血，明年更有許多春。","level":0},{"t":"春朝晴日望飛煙，半是人家燒紙錢，本有爺娘渾不","level":0},{"t":"識，却看黃土哭蒼天。","level":0},{"t":"瞬目今年三閱月，一春半在雨中過，西來祖意都狼","level":0},{"t":"藉，花落風前知幾多？","level":0},{"t":"結夏結夏","level":0},{"t":"揮戈佛日不西流，照徹人間洞九幽，從此安居無一","level":0},{"t":"事，休將元妙挂心頭。","level":0},{"t":"西峯結制不尋常，穀滿倉兮僧滿堂，既得者些根蒂","level":0},{"t":"固，大家搖扇取風涼。","level":0},{"t":"一百禪和三十州，無繩自縛萬山頭。誰是護身誰是","level":0},{"t":"殺，白雲影裏鐵船浮。","level":0},{"t":"端午端午","level":0},{"t":"諸方盡喫菖蒲茶，惟我自酌青原酒，儱儱閧閧發顛","level":0},{"t":"狂，打落南辰連北斗。","level":0},{"t":"是處人家懸艾虎，靈巖但喫菖蒲茶，莫言淡薄無滋","level":0},{"t":"味，畢竟風流出當家。","level":0},{"t":"中夏中夏","level":0},{"t":"一夏悠悠今已半，尅期取證事如何？幻華非幻消磨","level":0},{"t":"盡，祇與從前不較多。","level":0},{"t":"祈雨祈雨","level":0},{"t":"山磵水流如鑿開，旱年祈雨為民災。不知雲從何處","level":0},{"t":"起，祇見雨從頭上來。","level":0},{"t":"遮墺龍王現白龜，應身何事出潭遲？欲知利物及民","level":0},{"t":"處，便好為霖濟旱時。","level":0},{"t":"久旱山川若火焚，龍神何忍臥淵深。願興雷電重施","level":0},{"t":"雨，以濟斯民渴望心。","level":0},{"t":"謝雨謝雨","level":0},{"t":"山僧多幸造靈祠，却感龍天力護持。上澤不知何以","level":0},{"t":"報，重來聊復謝恩私。","level":0},{"t":"祈晴祈晴","level":0},{"t":"天關久鎖不開容，日夜滂沱鼓黑風奮性一椎俱擊","level":0},{"t":"碎，頂門迸出一輪紅。","level":0},{"t":"廓然天地清如洗，散盡陰雲見古臺，物物頭頭全體","level":0},{"t":"露，衲僧正眼自應開。","level":0},{"t":"解夏解夏","level":0},{"t":"百煉黃金鑄鐵牛，十分高價與人酬庭前不有花含","level":0},{"t":"笑，又是東山一夏休。","level":0},{"t":"一箇葫蘆纔倒地，滿地葫蘆盡傾倒，欲識單傳直指","level":0},{"t":"禪，今日鬬凑得恰好。","level":0},{"t":"老矣無心鑄鐵牛，眼前隨分即相酬，庭前葉脫西風","level":0},{"t":"起，且喜凌霄一夏休。","level":0},{"t":"禪人解夏東西去，莫道腰包趁早涼，三界炎炎如火","level":0},{"t":"宅，不知何處是家鄉？","level":0},{"t":"中秋中秋","level":0},{"t":"從本無心無可傳，何須握地覓青天？無心恰似中秋","level":0},{"t":"月，照見三千與大千。","level":0},{"t":"土木場中輥一回，平生己眼豁然開，廣寒宮殿無關","level":0},{"t":"鑰，撞破髑髏歸去來。","level":0},{"t":"重陽重陽","level":0},{"t":"金蕋叢叢帶露新，采來烹茗賞芳辰，浮杯何必須宜","level":0},{"t":"酒，但有清香自醉人。","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/05/CB05304.gif\" alt=\"𩖼\" title=\"𩖼\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/05/CB05304.gif\" alt=\"𩖼\" title=\"𩖼\" />籬根菊正黃，妙談西祖意琅琅不知誰解聞斯","level":0},{"t":"語，堪為宗門立紀綱。","level":0},{"t":"種陽黃菊未成花，落帽無勞憶孟嘉但得青山長在","level":0},{"t":"眼，不妨流水去無涯。","level":0},{"t":"時移節換是尋常，過了重陽又一陽人事自生今日","level":0},{"t":"意，黃花祇作去年香。","level":0},{"t":"中峯用處沒疎親，道合寧論主與賓？却笑汾陽強分","level":0},{"t":"別，重陽九日菊花新。","level":0},{"t":"胷中一寸<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01926.gif\" alt=\"灰\" title=\"灰\" />已冷，頭上千莖雪未消老步祇宜平地","level":0},{"t":"去，不知何事又登高。","level":0},{"t":"茱萸鮮嫩菊花香，暢殺陶家醉倒郎，我輩泛觴雖絕","level":0},{"t":"分，東籬閒玩也無妨。","level":0},{"t":"結冬結冬","level":0},{"t":"火冷<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01926.gif\" alt=\"灰\" title=\"灰\" />寒炭又無，大家兀坐嘴盧都，冷<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01926.gif\" alt=\"灰\" title=\"灰\" />堆裏忽豆","level":0},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/15/CB15090.gif\" alt=\"𪹼\" title=\"𪹼\" />，大地通紅火一爐。","level":0},{"t":"擁門黃葉深三尺，冰齒寒泉懸萬尋，禁得苦寒忘閴","level":0},{"t":"寂，梅開不待嶺頭春。","level":0},{"t":"冬至冬至","level":0},{"t":"羣陰剝盡一陽生，草木園林盡發萌，惟有衲僧無底","level":0},{"t":"鉢，依然盛飯又盛羮。","level":0},{"t":"六陰已極一陽生，佛道還同世道亨，惟有祖師門下","level":0},{"t":"客，依前日午打三更。","level":0},{"t":"羣陰剝盡一陽生，萬國歡呼賀太平，日出三竿天四","level":0},{"t":"霽，五雲獨遶九重城。","level":0},{"t":"謝雪謝雪","level":0},{"t":"雪覆蘆花欲暮天，謝家人不在漁船，白牛放却無尋","level":0},{"t":"處，空把山童贈鐵鞭。","level":0},{"t":"凍雲四合雪漫漫，孰解當機作水看？祇為眼中花未","level":0},{"t":"瞥，啟窗猶看玉琅玕。","level":0},{"t":"捱到虗空粉碎時，空花一任眼前飛。若還別覓安心","level":0},{"t":"法，客路漫漫沒處歸。","level":0},{"t":"雪覆千峯光不散，梅開一樹暗香飄，西來祖意盡呈","level":0},{"t":"露，何用山僧把舌饒？","level":0},{"t":"除夕除夕","level":0},{"t":"一年三百六十日，今宵正是結交頭。移身換步無多","level":0},{"t":"子，六合清風卒未休。","level":0},{"t":"一年三百六十日，日日塵勞事不同。今夜勸君都放","level":0},{"t":"下，管教明取少林宗。","level":0},{"t":"浮世光陰自不多，看看又是一年過，夜參欲說無窮","level":0},{"t":"事，奈此風頭峭硬何？","level":0},{"t":"春回幽谷見梅新，雪水煎茶樂不勝，誰道夜深年是","level":0},{"t":"盡？曉來依舊日東昇。","level":0},{"t":"一年三百六十日，逗到今朝是除夕，遠年帳目盡丟","level":0},{"t":"開，摩訶般若波羅密。","level":0},{"t":"送了窮神接好年，家家燒紙揖門前。隨鄉也把空拳","level":0},{"t":"豎，聊當兒孫壓歲錢。","level":0},{"t":"校注已已采已已已钁已已已已斂己钁已券已但已埃已已已從斂券已已已眼圓已已埃已己春已已已钁已刺已已己窣已已已已已己已葡溝刺已刺已已已已已己己已己已采已但□□□已已活已己采但已卍續藏 校注新增校注","level":0}]]