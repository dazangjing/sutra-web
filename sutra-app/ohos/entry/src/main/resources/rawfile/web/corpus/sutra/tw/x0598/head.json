{"id":"x0598","title":"法華經文句格言","titleTrad":"法華經文句格言","byline":"四明沙門栢庭 善月 述","bylineLabel":"著者·译者","dynasty":"","division":"经疏部","canon":"X0598","canonName":"新纂卍續藏","volume":"X0598","juanCount":3,"textLength":71527,"imageCount":0,"summary":"","tags":["经疏部","新纂卍續藏"],"order":1602,"guide":"","chunks":17,"toc":[{"level":3,"text":"首，從序類也。今用釋於經，初亦類也，故於中便釋序"},{"level":3,"text":"品第一，則其次也。明以其私序，王又次之，故以知冠"}],"chunksPerFile":20}