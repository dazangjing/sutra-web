[[{"t":"佛说内身观章句经","level":0},{"t":"失译人名在后汉录","level":0},{"t":"一切一其心，皆听美言训，","level":0,"quote":true},{"t":"佛所从得道，且听我彼经。","level":0,"quote":true},{"t":"彼空亦不断，有行皆非常，","level":0,"quote":true},{"t":"夫行不败坏，佛以讲授经。","level":0,"quote":true},{"t":"深微难见事，非章原之句，","level":0,"quote":true},{"t":"通彼能敷演，是以故为师。","level":0,"quote":true},{"t":"从本以存本，有造法之积，","level":0,"quote":true},{"t":"从慧以除弃，上士所讲说。","level":0,"quote":true},{"t":"所从因缘有，有行皆无有，","level":0,"quote":true},{"t":"亦有前世除，无知彼诸行；","level":0,"quote":true},{"t":"亦如欲演身，日亲之所讲，","level":0,"quote":true},{"t":"大灾患无数，皆以归流身。","level":0,"quote":true},{"t":"删定如本文，所演众要言，","level":0,"quote":true},{"t":"靡丽五字句，明誓以劝勉。","level":0,"quote":true},{"t":"以颂文具足，偶字音商备，","level":0,"quote":true},{"t":"若花实杂糅，皆听彼我诲。","level":0,"quote":true},{"t":"身非人非命，不丈夫非士，","level":0,"quote":true},{"t":"若体若不艶，斯事都无彼。","level":0,"quote":true},{"t":"夫身造而有，以有即败亡，","level":0,"quote":true},{"t":"无强皆归命，如沫蹈践碎；","level":0,"quote":true},{"t":"无强则无常，无常即无乐；","level":0,"quote":true},{"t":"无常亦为苦，非身身非我；","level":0,"quote":true},{"t":"身非常亦苦，非彼应为身。","level":0,"quote":true},{"t":"若体艶我有，身都无可有；","level":0,"quote":true},{"t":"若以都无体，有存亦有亡。","level":0,"quote":true},{"t":"慧者以本末，何彼已有体？","level":0,"quote":true},{"t":"若以无主者，不得以自由，","level":0,"quote":true},{"t":"有校计若此，何彼体我有？","level":0,"quote":true},{"t":"斯体身为空，体我有为虚，","level":0,"quote":true},{"t":"应因缘为有，非身逝心造，","level":0,"quote":true},{"t":"非众人身造，亦非自身造，","level":0,"quote":true},{"t":"都无身有造，亦身无不造。","level":0,"quote":true},{"t":"以身无造者，从彼为得谛。","level":0,"quote":true},{"t":"亦非都骨节，","level":0,"quote":true},{"t":"从前世方来，亦非天造身，","level":0,"quote":true},{"t":"非神所化城，非无行无本，","level":0,"quote":true},{"t":"无因为自有，是身有所由，","level":0,"quote":true},{"t":"有事亦有物。有本有所起，","level":0,"quote":true},{"t":"稍稍为生有，本以痴亦爱，","level":0,"quote":true},{"t":"心与爱有漏，亦有缚亦结，","level":0,"quote":true},{"t":"行二品为漏。斯为本亦餘，","level":0,"quote":true},{"t":"世与受因缘，以由彼斯身，","level":0,"quote":true},{"t":"以渐能致有。初始有精沫，","level":0,"quote":true},{"t":"精沫为转凝，足为生两两，","level":0,"quote":true},{"t":"以两为转厚，以序有四体，","level":0,"quote":true},{"t":"为生头第五，若干骨积聚，","level":0,"quote":true},{"t":"从行为用成，头九为髑髅，","level":0,"quote":true},{"t":"頞<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02929.gif\" alt=\"䪼\" title=\"䪼\" />为二骨，齿根三十二，","level":0,"quote":true},{"t":"齿三十二骨，颈为与耳本，","level":0,"quote":true},{"t":"鼻为与上腭，心与颈咙喉，","level":0,"quote":true},{"t":"凡为骨八十。颊车与颈四，","level":0,"quote":true},{"t":"咽亦为骨四，左臂与右臂，","level":0,"quote":true},{"t":"凡有骨五十。若其斯左脇，","level":0,"quote":true},{"t":"应有十三肋；亦斯右脇然，","level":0,"quote":true},{"t":"应有肋十三，斯为四十八。","level":0,"quote":true},{"t":"三三三相连，二为二相连，","level":0,"quote":true},{"t":"其餘不相连，身者以为彊。","level":0,"quote":true},{"t":"如束苇无彊，脊膂三十二，","level":0,"quote":true},{"t":"尻与腰为三，若其斯左髀，","level":0,"quote":true},{"t":"骨为二十五；右髀为亦然，","level":0,"quote":true},{"t":"为骨二十五；肩髀有骨四，","level":0,"quote":true},{"t":"凡三百二十。敷演名之谛，","level":0,"quote":true},{"t":"佛以日断嗣，彼叚悉以聚，","level":0,"quote":true},{"t":"诸根为以缝，非疮而裹之，","level":0,"quote":true},{"t":"肉血以涂<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02949.gif\" alt=\"𢴉\" title=\"𢴉\" />，如木机关缕，","level":0,"quote":true},{"t":"为如幻师幻。骨机关亦然，","level":0,"quote":true},{"t":"以筋缠缚成，合聚骨若此，","level":0,"quote":true},{"t":"以为是形体。愚者莫不著，","level":0,"quote":true},{"t":"智者而不著。生革以隐蔽，","level":0,"quote":true},{"t":"九孔为大疮，周匝为渗漏，","level":0,"quote":true},{"t":"不净腐臭处，口喙如为孔，","level":0,"quote":true},{"t":"满之以诸谷，是身为若此。","level":0,"quote":true},{"t":"以进若干腑，毛发与爪齿，","level":0,"quote":true},{"t":"尘埃亦皮革，骨节亦骨髓，","level":0,"quote":true},{"t":"为凡筋与脉，胃与心亦脾，","level":0,"quote":true},{"t":"大肠亦小肠，肝与肺亦肾，","level":0,"quote":true},{"t":"脂<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02924.gif\" alt=\"𦠻\" title=\"𦠻\" />亦大便，泪与唾亦汗，","level":0,"quote":true},{"t":"鼻涕膏亦血，寒热肪小便，","level":0,"quote":true},{"t":"<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02965.gif\" alt=\"𮌗\" title=\"𮌗\" />之与<img class=\"gaiji\" src=\"asset://gaiji-CB/02/CB02965.gif\" alt=\"𮌗\" title=\"𮌗\" />膜，皆以沈没彼，","level":0,"quote":true},{"t":"如泥涂老牛，如其成不知。","level":0,"quote":true},{"t":"身之内与外，夫城骨与墙，","level":0,"quote":true},{"t":"肉血为涂严，为怨所破坏。","level":0,"quote":true},{"t":"恒为以内外，彼央若干百，","level":0,"quote":true},{"t":"以为贪其肉，其外亦灾害，","level":0,"quote":true},{"t":"皆以多尤彼，斯身腐败坏。","level":0,"quote":true},{"t":"譬如久故城，昼夜供侍之，","level":0,"quote":true},{"t":"坏如已复坏，如坎与空聚；","level":0,"quote":true},{"t":"恒盗贼俱止，取之欺殆人，","level":0,"quote":true},{"t":"身为毒虺穴，夫毒虺剧毒；","level":0,"quote":true},{"t":"恒于身居止，喜怒毒奸弊，","level":0,"quote":true},{"t":"孚不和大毒。正使满百岁，","level":0,"quote":true},{"t":"恒以和安隐，忿则无反复，","level":0,"quote":true},{"t":"须臾复不安。斯身为灾祸，","level":0,"quote":true},{"t":"嫌而有恐畏，如虎游荒泽，","level":0,"quote":true},{"t":"有畏多恐怖。诸念为以仰，","level":0,"quote":true},{"t":"为一切苦器，亦为诸剧事。","level":0,"quote":true},{"t":"斯身主为受，沈於苦之法，","level":0,"quote":true},{"t":"一切诸病宅，为老死之法。","level":0,"quote":true},{"t":"身为增恩爱，苦以寒与热，","level":0,"quote":true},{"t":"或风而不和，是则病如生。","level":0,"quote":true},{"t":"为败坏诸根，失疾贼害人，","level":0,"quote":true},{"t":"老死笮厄人，如雪聚得火，","level":0,"quote":true},{"t":"疾而为解释。斯若此无数，","level":0,"quote":true},{"t":"身之多灾祸，吾所演一切，","level":0,"quote":true},{"t":"未能已备具。要以为诸苦，","level":0,"quote":true},{"t":"腐身为不实，多因缘以成，","level":0,"quote":true},{"t":"大耶以为躯。","level":0,"quote":true},{"t":"佛说内身观章句经","level":0},{"t":"十一因缘章","level":0},{"t":"佛言：「行者有十一因缘，灭道制令人不堕恶道，当不识者，谓万物。一为大会，谓人众；二者多食，谓诸美，亦谓过饱；三者为多行，谓多业；四为多喧，谓多语；五为多睡眠；六为会聚，谓禅中；七为习行，谓多事；八为爱身；九为轻，谓非法语；十为贪，谓多欲；十一为不好善处居，谓恶人中。行道者当断是十一因缘，得道疾。」","level":0}]]