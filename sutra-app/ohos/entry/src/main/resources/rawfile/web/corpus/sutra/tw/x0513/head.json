{"id":"x0513","title":"仁王經合疏","titleTrad":"仁王經合疏","byline":"鍥仁王般若經合疏敘","bylineLabel":"著者·译者","dynasty":"","division":"经疏部","canon":"X0513","canonName":"新纂卍續藏","volume":"X0513","juanCount":3,"textLength":79092,"imageCount":0,"summary":"","tags":["经疏部","新纂卍續藏"],"order":1548,"guide":"","chunks":36,"toc":[{"level":3,"text":"元祿壬午春二月下浣　天台山亮潤大雲序"},{"level":3,"text":"合刻仁王護國般若經疏序"},{"level":3,"text":"仁王護國般若經疏序"},{"level":3,"text":"政和二年壬辰四月癸卯序"},{"level":3,"text":"序品第一"},{"level":3,"text":"觀空品第三"},{"level":3,"text":"菩薩教化品第四"},{"level":3,"text":"護國品第六"},{"level":3,"text":"受持品第八"},{"level":3,"text":"一證信序"},{"level":3,"text":"二發起序"},{"level":3,"text":"序品第一"},{"level":3,"text":"佛說仁王護國般若波羅蜜經，即一部之通稱。序"},{"level":3,"text":"品第一，即部內之別名也。序者，由也，次也。品者，梵"},{"level":3,"text":"觀空品第二"},{"level":3,"text":"教化品第三"},{"level":3,"text":"品分明，即第四炎地勝，即中品第五難勝地。難勝"},{"level":3,"text":"二諦品第四"},{"level":3,"text":"護國品第五"},{"level":3,"text":"散華品第六"},{"level":3,"text":"受持品第七"},{"level":3,"text":"囑累品第八"}],"chunksPerFile":20}