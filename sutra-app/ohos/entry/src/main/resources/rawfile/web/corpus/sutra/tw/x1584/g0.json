[[{"t":"續燈存稿目錄","level":0},{"t":"No. 1584-A 續燈存稾敘No. 1584-A","level":0},{"t":"續燈存稾敘","level":0},{"t":"欲識佛性義，當觀時節因緣。昔者世尊拈華，迦葉破","level":0},{"t":"顏微笑。達磨面壁，神光斷臂安心。逮至曹谿以降，沿","level":0},{"t":"流益長，波瀾益廣。唱愈高，機愈峻。派列五家，門庭各","level":0},{"t":"立。或電捲風馳，或孤危聳峭，或金鍼綿密，或父子投","level":0},{"t":"機，或箭鋒相拄。其因緣時節，千差萬別，各各不同。苟","level":0},{"t":"非具載本末，則後學何從考證。斯傳燈之所由作也。","level":0},{"t":"自景德出傳燈，其後有廣燈，有續燈，有聯燈，有普燈。","level":0},{"t":"以暨紹興間，大川濟公之會元，布列分張，騰輝溢彩，","level":0},{"t":"盛行於宋矣。自宋季閱元，而明迄今。","level":0},{"t":"聖代四百餘秊，雖溈仰、法眼、雲門三宗不幸後先相","level":0},{"t":"繼無傳，而臨濟、曹洞二支繩繩不絕，聯芳竝茂，代有","level":0},{"t":"其人。柰何<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07292.gif\" alt=\"𨶑\" title=\"𨶑\" />然未有繼其作者，致使大方宗匠湮沒","level":0},{"t":"無聞，殘󳬴斷碣沉埋於荒榛腐莽中。祖祖慧命，何翅","level":0},{"t":"一絲之懸九鼎哉？先南<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00589.gif\" alt=\"㵎\" title=\"㵎\" />為此深懼，留意捃摭，蒐羅","level":0},{"t":"有秊，每出訪求，不遠千里。崇禎壬午夏，適雲間，晤施","level":0},{"t":"別駕笠澤居士，得其所纂，不謀而同。於是浩然而歸，","level":0},{"t":"載筆從事。又數秊，編集始得成書。正謀命工鏤板，遭","level":0},{"t":"時搶攘，復秘而藏之，標曰續燈存稾。事未及舉，不幸","level":0},{"t":"先師遽云示寂。十餘秊來，昱僻居荒裔，力不從心。切","level":0},{"t":"思秊運往矣，來日幾何？投足拊髀，詎容再緩？參徒定","level":0},{"t":"浪平，能憂人之憂，慨然擔荷，願與諸祖列宗眉毛廝","level":0},{"t":"結，出一口氣。嗚呼！其時節因緣若是耶？後之君子復","level":0},{"t":"有繼而作者，或繇此而推廣之，俾燈燈不墜，斯文豈","level":0},{"t":"有既哉？","level":0},{"t":"康熈丙午中秋前一日武林南<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00589.gif\" alt=\"㵎\" title=\"㵎\" />嗣法比丘龍丘","level":0},{"t":"行昱熏沐拜敘","level":0},{"t":"No. 1584-B 廣求皇明禪師語錄塔銘備續傳燈小札No. 1584-B","level":0},{"t":"廣求皇明禪師語錄塔銘備續傳燈小札","level":0},{"t":"竊念正法眼藏，從世尊囑付迦葉，至達磨東度，直指","level":0},{"t":"人心以來，燈燈相續，各有傳記，以為人天眼目。獨自","level":0},{"t":"勝國迄今，幾三百餘秊，傳燈斷缺，致使熈朝宗匠湮","level":0},{"t":"沒無聞，識者悲之。達觀大師有志弗遂，迨將入寂，乃","level":0},{"t":"有傳燈未續，則我慧命一大負之嘆。余讀紫柏集，不","level":0},{"t":"勝感憤，偶因家有藏書，輒思蒐羅我明諸尊宿語錄","level":0},{"t":"及傳記、塔銘，彚集成書，以俟作者。豈謂徧簡文集、誌","level":0},{"t":"乘，凡仙釋傳記，咸為俗子刪除，寥寥數家，殊慚寡陋。","level":0},{"t":"且當衰眊之秊，不能遠出尋求，敢勒此以告通都大","level":0},{"t":"邑、叢林尊宿及在家居士，儻藏有我明禪師語錄及","level":0},{"t":"傳記、塔銘、梵剎志乘，除嘉興楞嚴現今流通之外，無","level":0},{"t":"論全書、彚稾、斷簡、殘篇，凡一字一句有裨傳燈者，悉","level":0},{"t":"祈惠教，以便彚錄付梓，為將來續燈之助。所以闡揚","level":0},{"t":"法寶，續佛慧命，其功德真無量無邊，不可思議矣。","level":0},{"t":"崇禎壬午夏五月笠澤居士華亭施沛啟","level":0},{"t":"凡例凡例","level":0},{"t":"是編既彚集成書，仍曰存稾者，蓋以先師手澤，未","level":0},{"t":"敢遽移，惟俟當來有志續傳燈者。","level":0},{"t":"按濟宗大鑑第十八世已載會元末卷，茲復重起","level":0},{"t":"者，以會元所收未備故。","level":0},{"t":"曹洞宗世代淵源，悉從遠公續略。遠為雲門之子","level":0},{"t":"若孫，諒無冐濫祖宗之咎。","level":0},{"t":"是書專為流通宗眼，未獲機緣法語，不與收入。嗣","level":0},{"t":"內得姓氏出處大略者，載之以備續攷。","level":0},{"t":"按大川輯會元，列大慧居虎丘先。翠峯居頂續傳","level":0},{"t":"燈，列虎丘居大慧先。遠公會元續略，置洞宗於首","level":0},{"t":"卷。議者謂各尊自出之祖，恐非作者至意。揆之事","level":0},{"t":"義，各得其宜。蓋傳燈非一家書，何可作自他尊。抑","level":0},{"t":"之見今臨濟曹洞，率由其舊。總標大鑑第幾十幾","level":0},{"t":"世，不與會元之世次間列者，以適兩宗之便閱，亦","level":0},{"t":"非有所自外也。未詳法嗣，因附於末。","level":0},{"t":"濟宗始自大鑑第十八世，終於第三十四世。洞宗","level":0},{"t":"始自大鑑第十六世，終於第三十六世。為卷十二，","level":0},{"t":"為冊六。行昱和南謹述","level":0},{"t":"No. 1584","level":0},{"t":"續燈存稾目錄續燈存稾目錄","level":0},{"t":"卷首","level":0},{"t":"敘文　小札","level":0},{"t":"凡例","level":0},{"t":"卷一","level":0},{"t":"臨濟宗","level":0},{"t":"大鑑下第十八世","level":0,"quote":true},{"t":"天童華禪師法嗣","level":0},{"t":"天童咸傑禪師　光孝善登禪師","level":0},{"t":"南書記　侍郎李浩居士","level":0},{"t":"教授嚴康朝居士","level":0},{"t":"教忠光禪師法嗣","level":0},{"t":"法石慧空禪師　淨慈曇密禪師","level":0},{"t":"青原唯禋禪師","level":0},{"t":"東林顏禪師法嗣","level":0},{"t":"公安祖珠禪師　報恩法演禪師","level":0},{"t":"淨慈彥充禪師　智者真慈禪師","level":0},{"t":"昭覺紹淵禪師　簡上座","level":0},{"t":"西禪需禪師法嗣","level":0},{"t":"鼓山安永禪師　龍翔南雅禪師","level":0},{"t":"天王志清禪師　劍門安分菴主","level":0},{"t":"育王光禪師法嗣","level":0},{"t":"靈隱之善禪師　退谷義雲禪師","level":0},{"t":"育王權禪師　北磵居簡禪師","level":0},{"t":"徑山如琰禪師　東禪智觀禪師","level":0},{"t":"上方義銛禪師　靈隱印禪師","level":0},{"t":"育王宗印禪師　育王師瑞禪師","level":0},{"t":"天童了派禪師　天童師齊禪師","level":0},{"t":"雲居梵琮禪師　石菴正玸禪師","level":0},{"t":"東禪嶽禪師法嗣","level":0},{"t":"鼓山宗逮禪師　徑山德灊禪師","level":0},{"t":"鼓山知玿禪師。","level":0},{"t":"天童全禪師法嗣","level":0},{"t":"育王妙堪禪師　靈隱希夷禪師","level":0},{"t":"雪竇處南禪師　雪峯了宗禪師","level":0},{"t":"盤山思卓禪師　丞相錢象祖居士","level":0},{"t":"西禪淨禪師法嗣","level":0},{"t":"乾元宗穎禪師　華嚴雲禪師","level":0},{"t":"中濟立才禪師","level":0},{"t":"華藏演禪師法嗣",