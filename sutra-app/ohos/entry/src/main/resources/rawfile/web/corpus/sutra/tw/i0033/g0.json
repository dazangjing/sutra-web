[[{"t":"法義兄弟等二百人造像記顏娟英主編","level":0},{"t":"No. 33法義兄弟等二百人造像記","level":0},{"t":"維大魏永熙三年歲次□□□三月癸未朔五日丁亥夫大覺遷方。託靈像以□福。法雖謝世。寄三乘以存教。自非遠鑒幽源。寧能辨其由。是以法義兄弟二百人等。識攬玄宗。敬崇正法。減割家財。仰為皇帝　陛下。令為七世父母。營造微福。始訪石孤巖。瑍珍玄豁。采□妙手。敬造尊像一區。二侍菩薩。嚴姿超絕。色精琨寶。光拂紫虛。暉洞皎日。崇髣髴於幽蹤。依悕於聖容者也。緣□微因。願令亡者遊神西方淨佛國土。現存同福長保遐□。一切　群生。共沐□澤。","level":0},{"t":"比丘尼法榮□□□","level":0,"quote":true},{"t":"都維那張黨比丘尼法□□□□","level":0,"quote":true},{"t":"都化主楊珍魯當珠楊□□","level":0,"quote":true},{"t":"維那張景　鄭縵姬王□□","level":0,"quote":true},{"t":"維那楊僧哲梁漢女張銀姜","level":0,"quote":true},{"t":"維那張文　李貳同劉顯姿","level":0,"quote":true},{"t":"維那王漢□田勝姜杜妙娥","level":0,"quote":true},{"t":"維那楊天　凌伯□張侍□","level":0,"quote":true},{"t":"維那鄭明　王智□□□□","level":0,"quote":true},{"t":"維那楊□　楊瓫生孫□□","level":0,"quote":true},{"t":"維那趙□　展憐香楊眾□","level":0,"quote":true},{"t":"維那楊□　逄桃生楊□□","level":0,"quote":true},{"t":"張萬孫趙秀姜□□□","level":0,"quote":true},{"t":"張勝叔孫好陵楊石留","level":0,"quote":true},{"t":"比丘□□　逄□□周好女","level":0,"quote":true},{"t":"此是定光佛出比丘惠進　楊安□齊白□","level":0,"quote":true},{"t":"比丘惠敬　王惠彌楊□姜","level":0,"quote":true},{"t":"比丘道□　楊惠□張□珠","level":0,"quote":true},{"t":"比丘法□　王延康王伏英","level":0,"quote":true},{"t":"比丘惠□　王安國孫姜珠","level":0,"quote":true},{"t":"比丘惠□　□阿祖","level":0,"quote":true},{"t":"比丘智達　王雙憐","level":0,"quote":true},{"t":"王牛仁逄阿終山石","level":0,"quote":true},{"t":"張伯周王惠達楊顯賓　韓阿姜","level":0,"quote":true},{"t":"王天護楊棒生王文達　逄文玉","level":0,"quote":true},{"t":"王伯恭楊雙鳥王伯珍　王□□","level":0,"quote":true},{"t":"楊安國楊德林王祖興　楊容生","level":0,"quote":true},{"t":"牟　懷孟容生張世敬","level":0,"quote":true},{"t":"楊禹生王信都王阿憐","level":0,"quote":true},{"t":"王族之楊影□楊統周","level":0,"quote":true},{"t":"牟桃苻鄭道延楊承貴","level":0,"quote":true},{"t":"王德意王興孫楊仲琬","level":0,"quote":true},{"t":"王副祖趙文興王惠生","level":0,"quote":true},{"t":"鄭容生張弘柳","level":0,"quote":true},{"t":"孟延興牟思洛","level":0,"quote":true},{"t":"楊仙之楊檀生","level":0,"quote":true},{"t":"楊慎之王祖□","level":0,"quote":true},{"t":"王樹生張伏賜","level":0,"quote":true},{"t":"王世興陳天授","level":0,"quote":true},{"t":"校注像辨崇正微瑍像中央研究院歷史語言研究所 校注","level":0,"quote":true}]]