[[{"t":"漩澓偈","level":0},{"t":"杜顺法师作","level":0},{"t":"若人欲识真空理　身内真如还遍外情与非情共一体　处处皆同真法界不离幻色即见空　即此真如含一切一念照入於多刧　一一念刧收一切於一境内一切智　於一智中诸境界秖用一念观诸境　一切诸境同时会时处帝网现重重　一切智通无<img class=\"gaiji\" src=\"asset://gaiji-CB/07/CB07724.gif\" alt=\"𦊱\" title=\"𦊱\" /><img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01002.gif\" alt=\"㝵\" title=\"㝵\" />","level":0},{"t":"(第一句)","level":0},{"t":"真空不动智凡圣本来同虽为万有体曾无起作功","level":0},{"t":"(第二句)","level":0},{"t":"真如无作性弥亘等虚空岂如浮沤质出没在海中","level":0},{"t":"(第三句)","level":0},{"t":"无情无自性性体发於真顿现如镜像谁作自他身","level":0},{"t":"(第四句)","level":0},{"t":"智现情无<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01002.gif\" alt=\"㝵\" title=\"㝵\" />心通事岂妨事理融无二何处非道场","level":0},{"t":"(第五六句)","level":0},{"t":"幻性本无宗根尘结色空了尘无自性一切法皆同","level":0},{"t":"(第七句)","level":0},{"t":"绝念超情识如镜照十方万像斯顿现那假在思量","level":0},{"t":"(第八句)","level":0},{"t":"譬如一镜鉴十方　十方一一镜皆同无<img class=\"gaiji\" src=\"asset://gaiji-CB/01/CB01002.gif\" alt=\"㝵\" title=\"㝵\" />心镜照古今　九世重重<img class=\"gaiji\" src=\"asset://gaiji-CB/28/CB28575.gif\" alt=\"㸦\" title=\"㸦\" />相容","level":0},{"t":"(第九句)","level":0},{"t":"心为万法宗万法一心通　毛端一滴海一切海皆同","level":0},{"t":"(第十句)","level":0},{"t":"一一万法体同空　一一虚空<img class=\"gaiji\" src=\"asset://gaiji-CB/28/CB28575.gif\" alt=\"㸦\" title=\"㸦\" />相容一海鱼龙尚无尽　一切海中多少龙","level":0},{"t":"(第十一十二句)","level":0},{"t":"三际无思理等空　空中何法不含容一智万差融事理　尘尘刹刹普皆同","level":0},{"t":"(第十三十四句)","level":0},{"t":"寂用系兴帝网宗　一尘才举十方通六相十玄融斯理　主伴交暎<img class=\"gaiji\" src=\"asset://gaiji-CB/28/CB28575.gif\" alt=\"㸦\" title=\"㸦\" />重重","level":0},{"t":"(通颂前文)","level":0},{"t":"又赞曰","level":0},{"t":"尊从悲智起文殊海一沤片言通帝网漩澓显深幽一心圆顿备十重万行周无边花藏界摄在一毛头","level":0},{"t":"释花严漩澓偈","level":0}]]