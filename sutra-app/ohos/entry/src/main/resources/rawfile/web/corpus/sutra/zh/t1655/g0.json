[[{"t":"止观门论颂一卷","level":0},{"t":"世亲菩萨造","level":0},{"t":"三藏法师义净奉　诏译","level":0},{"t":"若见女形相，及以艶娇姿，","level":0,"quote":true},{"t":"愚人不了知，妄生婬染意。","level":0,"quote":true},{"t":"佛说膖胀等，蠲除婬欲念，","level":0,"quote":true},{"t":"能随世尊教，得胜果非餘。","level":0,"quote":true},{"t":"戒净有闻思，策励常修习，","level":0,"quote":true},{"t":"系念观诸境，斯为解脱因。","level":0,"quote":true},{"t":"若人有瞋染，及昏沈睡眠，","level":0,"quote":true},{"t":"掉恶作并疑，此五遮修定。","level":0,"quote":true},{"t":"少闻与众居，鄙事情欣乐，","level":0,"quote":true},{"t":"爱身并受用，亦能遮定心。","level":0,"quote":true},{"t":"心乱有五缘，情随众境散，","level":0,"quote":true},{"t":"味著并沈掉，我慢重名闻。","level":0,"quote":true},{"t":"苾刍依圣教，有过应说除，","level":0,"quote":true},{"t":"善取住心缘，是为最初行。","level":0,"quote":true},{"t":"次依寂静处，妨难并皆无，","level":0,"quote":true},{"t":"然后息邪思，是苾刍初业。","level":0,"quote":true},{"t":"应可住尸林，著粪扫衣服，","level":0,"quote":true},{"t":"常求静息事，断除婬染心。","level":0,"quote":true},{"t":"乞食见女人，应观为不净，","level":0,"quote":true},{"t":"摄眼除邪意，正心当取食。","level":0,"quote":true},{"t":"多言多事务，此皆须远离，","level":0,"quote":true},{"t":"恼乱缘来逼，慧力应须忍。","level":0,"quote":true},{"t":"树下草<img class=\"gaiji\" src=\"asset://gaiji-CB/00/CB00036.gif\" alt=\"𧂐\" title=\"𧂐\" />中，或居崖窟内，","level":0,"quote":true},{"t":"观时应住此，寂静可修心。","level":0,"quote":true},{"t":"习定缘境时，不太高太下，","level":0,"quote":true},{"t":"不应极近远，於境使相应。","level":0,"quote":true},{"t":"善取所缘境，子细善观察，","level":0,"quote":true},{"t":"闭目住心时，犹如开眼见。","level":0,"quote":true},{"t":"根门皆摄敛，住念凝内心，","level":0,"quote":true},{"t":"缘境现前观，念念令相续。","level":0,"quote":true},{"t":"於前所取相，形貌用心观，","level":0,"quote":true},{"t":"膖胀女根边，可畏可嫌贱。","level":0,"quote":true},{"t":"犹如浊池水，风吹令动摇，","level":0,"quote":true},{"t":"观诸树影时，不善分明住。","level":0,"quote":true},{"t":"心垢烦恼水，乱情风所吹，","level":0,"quote":true},{"t":"澄念观察时，暗昧不能住。","level":0,"quote":true},{"t":"心沈应策举，可观胜妙事，","level":0,"quote":true},{"t":"如蛭饮血困，水浇令使苏；","level":0,"quote":true},{"t":"还应速收敛，於旧境安心，","level":0,"quote":true},{"t":"令意有堪能，调善皆随念。","level":0,"quote":true},{"t":"若其心掉举，应思厌恶事，","level":0,"quote":true},{"t":"令心寂静住，如钩<img class=\"gaiji\" src=\"asset://gaiji-CB/06/CB06154.gif\" alt=\"𣃁\" title=\"𣃁\" />象头；","level":0,"quote":true},{"t":"远离於沈掉，应平等运心，","level":0,"quote":true},{"t":"随情住舍中，此时无过咎。","level":0,"quote":true},{"t":"从此渐得住，取相影心安，","level":0,"quote":true},{"t":"明了中道行，正念灯持照。","level":0,"quote":true},{"t":"此时用寻伺，次第应观察，","level":0,"quote":true},{"t":"定影即便生，分明现前住。","level":0,"quote":true},{"t":"不动摇明净，如大丈夫形，","level":0,"quote":true},{"t":"此影望前观，是为差别相。","level":0,"quote":true},{"t":"此相既生已，欲爱等便除，","level":0,"quote":true},{"t":"即是系心人，初定方便相。","level":0,"quote":true},{"t":"次知瞋恚体，本由贪染发，","level":0,"quote":true},{"t":"欲爱既已除，得离於瞋恚。","level":0,"quote":true},{"t":"次以勤策念，遣除昏睡心，","level":0,"quote":true},{"t":"既观差别相，疑情即便息。","level":0,"quote":true},{"t":"次当除恶作，善行安隐路，","level":0,"quote":true},{"t":"寂静无障碍，能防於掉举。","level":0,"quote":true},{"t":"应知用麁寻，观其所取相，","level":0,"quote":true},{"t":"即於心影内，以伺细推求。","level":0,"quote":true},{"t":"见差别心喜，由此得轻安，","level":0,"quote":true},{"t":"次证於乐定，定支次如是，","level":0,"quote":true},{"t":"即是根本定，善安於念心，","level":0,"quote":true},{"t":"犹如欲至村，及至村中者。","level":0,"quote":true},{"t":"既获根本定，更复作餘修，","level":0,"quote":true},{"t":"得他心宿住，神通天眼耳。","level":0,"quote":true},{"t":"於此有伺时，心未能静住，","level":0,"quote":true},{"t":"犹如河有浪，非上地应知。","level":0,"quote":true},{"t":"既得初定已，仍於所缘住，","level":0,"quote":true},{"t":"次依二静虑，寻伺皆止息。","level":0,"quote":true},{"t":"虽得住此位，尚有喜水漂，","level":0,"quote":true},{"t":"入第三定时，其心便静住。","level":0,"quote":true},{"t":"由其心有乐，未能令住念，","level":0,"quote":true},{"t":"既证四静虑，众过并皆除。","level":0,"quote":true},{"t":"退分胜进分，住分决择分，","level":0,"quote":true},{"t":"静虑有四种，修定者初知。","level":0,"quote":true},{"t":"若定顺烦恼，此名为退分，","level":0,"quote":true},{"t":"后胜为胜分，自住住应知。","level":0,"quote":true},{"t":"由先善分别，是决择道因，","level":0,"quote":true},{"t":"此定能招彼，名为决择分。","level":0,"quote":true},{"t":"於无常等相，作苦等行解，","level":0,"quote":true},{"t":"若得此定者，是煖等道分。","level":0,"quote":true},{"t":"於青膖等相，观事有多途，","level":0,"quote":true},{"t":"如圣教修行，差别宜应识。","level":0,"quote":true},{"t":"死尸风鼓腹，穴处有脓流，","level":0,"quote":true},{"t":"连跨并皆麁，说名为膖胀。","level":0,"quote":true},{"t":"不爱身麁分，唯贪细滑身，","level":0,"quote":true},{"t":"对此染心人，令修如是观。","level":0,"quote":true},{"t":"若於死尸分，少有白脓流，","level":0,"quote":true},{"t":"餘肉并多青，说此为青膖。","level":0,"quote":true},{"t":"覩色而生爱，斯名爱色人，","level":0,"quote":true},{"t":"对治以青膖，日亲之所说。","level":0,"quote":true},{"t":"死尸脓遍出，是谓脓流相，","level":0,"quote":true},{"t":"对彼爱香人，令观染心息。","level":0,"quote":true},{"t":"死尸腰烂断，名为断坏相，","level":0,"quote":true},{"t":"对彼爱全身，大仙尊为说。","level":0,"quote":true},{"t":"尸骸狐狢噉，鸟啄有残筋，","level":0,"quote":true},{"t":"对治爱肌肤，为说食残相。","level":0,"quote":true},{"t":"手足诸支骨，随处皆分散，","level":0,"quote":true},{"t":"对贪支分人，说骨邪乱相。","level":0,"quote":true},{"t":"即於骨乱相，刀杖斫分离，","level":0,"quote":true},{"t":"亦为爱全身，令观打乱相。","level":0,"quote":true},{"t":"尸骸被刀斫，或由𫓴箭伤，","level":0,"quote":true},{"t":"流血遍残躯，名为血涂相。","level":0,"quote":true},{"t":"净洁香涂体，新庄著彩衣，","level":0,"quote":true},{"t":"於此起贪人，用斯为妙药。","level":0,"quote":true},{"t":"於境唯独爱，不许外人看，","level":0,"quote":true},{"t":"多虫唼死尸，令观除恶念。","level":0,"quote":true},{"t":"骸肉皆销散，但唯牙骨存，","level":0,"quote":true},{"t":"於齿生贪者，令观齿骨相。","level":0,"quote":true},{"t":"若见新死者，识去有残形，","level":0,"quote":true},{"t":"乐著众生贪，令除娇态欲。","level":0,"quote":true},{"t":"屎尿及洟唾，合聚共成身，","level":0,"quote":true},{"t":"三十二种物，皮囊唤作人。","level":0,"quote":true},{"t":"发毛并爪齿，肝肚等相因，","level":0,"quote":true},{"t":"内扶三百骨，横缠九百筋，","level":0,"quote":true},{"t":"九孔流不净，垢污秽难陈，","level":0,"quote":true},{"t":"审观真可恶，智者不应亲。","level":0,"quote":true},{"t":"既观他女体，亦复察己形，","level":0,"quote":true},{"t":"於斯贪染因，理应常系念。","level":0,"quote":true},{"t":"不出三界狱，咸由欲染心，","level":0,"quote":true},{"t":"是故明智者，极善思其事。","level":0,"quote":true},{"t":"经多地狱苦，幸会得人身，","level":0,"quote":true},{"t":"岂得纵狂心，不修殊胜行？","level":0,"quote":true},{"t":"婬贪有多种，随生爱不同，","level":0,"quote":true},{"t":"一观并能除，谓是白骨观。","level":0,"quote":true},{"t":"色触形娇态，衣缨生染著，","level":0,"quote":true},{"t":"何药能除此，无过白骨观。","level":0,"quote":true},{"t":"先於足大指，定心缘作疮，","level":0,"quote":true},{"t":"破坏既脓流，肉皆随堕落。","level":0,"quote":true},{"t":"即观指骨形，由如白鸽色，","level":0,"quote":true},{"t":"其疮既渐大，肤肉尽皆除。","level":0,"quote":true},{"t":"作如是次第，身肉皆除尽，","level":0,"quote":true},{"t":"正念胜解成，但观其骨锁。","level":0,"quote":true},{"t":"若有片肉在，即名为乱意，","level":0,"quote":true},{"t":"况复纵心猨，驰求趣诸境。","level":0,"quote":true},{"t":"於多时系想，自知能善住，","level":0,"quote":true},{"t":"次渐及餘人，总观为骨锁。","level":0,"quote":true},{"t":"渐宽至海际，满中皆白骨，","level":0,"quote":true},{"t":"此定既成已，舍广复令狭。","level":0,"quote":true},{"t":"略时从外舍，乃至唯身骨，","level":0,"quote":true},{"t":"还观足指端，是定心次第。","level":0,"quote":true},{"t":"或时片片舍，极至於顶骨，","level":0,"quote":true},{"t":"应知最后心，眉间摄令住。","level":0,"quote":true},{"t":"若作此修习，常生胜梵宫，","level":0,"quote":true},{"t":"不落堕三涂，得生於五净。","level":0,"quote":true},{"t":"人间散心善，还流生死河，","level":0,"quote":true},{"t":"智人修定心，如救身衣火。","level":0,"quote":true},{"t":"即可舍诸缘，宜居静林处，","level":0,"quote":true},{"t":"勿使无常逼，虚死散心中。","level":0,"quote":true},{"t":"以般若净心，终获可爱果，","level":0,"quote":true},{"t":"如不愿后有，於胜道应修。","level":0,"quote":true},{"t":"剃发著袈裟，宜应修圣道，","level":0,"quote":true},{"t":"自餘諠杂事，咸为生死因。","level":0,"quote":true},{"t":"止观行门七十颂","level":0}]]