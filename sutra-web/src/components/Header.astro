---
import SealMark from './SealMark.astro';
import { nav, site } from 'sutra-shared/config/site';
import { albums } from 'sutra-shared/config/collections';
import { stripBase, u } from '../lib/url';

const current = stripBase(Astro.url.pathname);
const isActive = (item: (typeof nav)[number]) => {
  if (!item.match) return current === item.path;
  if (item.match === 'topics') return current.startsWith('/topics');
  return current.startsWith(`/categories/${item.match}`);
};

/** 当前所处之专辑（若在专辑中） */
const currentAlbum = albums.find((a) => current.startsWith(`/topics/${a.slug}`));
/** 「专辑」总页亦视作专辑一级之内 */
const inAlbums = current.startsWith('/topics');
---

<header class="site-header sticky top-0 z-50 border-b border-line bg-bg/80 backdrop-blur-xl">
  <div class="mx-auto flex h-[66px] max-w-[1260px] items-center gap-6 px-4 sm:px-8">
    <a href={u('/')} class="flex shrink-0 items-center gap-3" aria-label={`${site.title} 首页`}>
      <SealMark size={42} char={site.sealChar} />
      <span class="flex flex-col leading-tight">
        <strong class="font-serif text-[21px] font-semibold tracking-[0.16em] text-ink">{site.title}</strong>
        <em class="mt-[3px] font-mono text-[10.5px] tracking-[0.22em] text-ink-3 not-italic">{site.tagline}</em>
      </span>
    </a>

    <nav id="site-nav" class="ml-auto max-lg:fixed max-lg:inset-x-0 max-lg:top-[66px] max-lg:z-50 max-lg:-translate-y-2 max-lg:opacity-0 max-lg:pointer-events-none max-lg:border-b max-lg:border-line max-lg:bg-bg-soft/95 max-lg:px-4 max-lg:pb-5 max-lg:pt-3 max-lg:transition-all max-lg:backdrop-blur-xl lg:static lg:translate-y-0 lg:opacity-100 lg:pointer-events-auto lg:border-0 lg:bg-transparent lg:pb-0 lg:pt-0 lg:backdrop-blur-none" aria-label="主导航">
      <ul class="flex flex-col gap-0.5 lg:flex-row lg:items-center lg:gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={u(item.path)}
                aria-current={isActive(item) ? 'page' : undefined}
                class:list={[
                  'relative block rounded-chip px-3 py-2 text-[14px] whitespace-nowrap transition-colors lg:py-[8px]',
                  isActive(item) ? 'text-jade' : 'text-ink-2 hover:bg-panel hover:text-ink',
                ]}
              >
                {item.title}
                <span
                  class:list={[
                    'absolute bottom-0.5 left-1/2 h-[1.5px] -translate-x-1/2 rounded-full bg-jade transition-all duration-300 lg:left-[13px] lg:translate-x-0',
                    isActive(item) ? 'w-[22px] opacity-100 shadow-[0_0_12px_var(--yzj-jade)]' : 'w-0 opacity-0',
                  ]}
                />
              </a>
            </li>
          ))
        }

        <!--
          专辑：与三大分类同为一级，故于导航中亦占一席。
          专辑项多，故收于下拉 —— 其中每一专辑皆为一等条目。
        -->
        <li class="album-menu group relative hidden lg:block">
          <button
            type="button"
            class="relative flex items-center gap-1.5 rounded-chip px-3 py-[8px] text-[14px] whitespace-nowrap transition-colors"
            class:list={[inAlbums ? 'text-jade' : 'text-ink-2 hover:bg-panel hover:text-ink']}
            aria-haspopup="true"
            aria-expanded="false"
          >
            专辑
            <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" class="opacity-60 transition-transform duration-300 group-hover:rotate-180">
              <path d="M2 4.5 6 8.5l4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
            </svg>
            <span
              class:list={[
                'absolute bottom-0.5 left-[13px] h-[1.5px] rounded-full bg-jade transition-all duration-300',
                inAlbums ? 'w-[22px] opacity-100 shadow-[0_0_12px_var(--yzj-jade)]' : 'w-0 opacity-0',
              ]}
            ></span>
          </button>

          <div
            class="invisible absolute top-full right-0 z-50 mt-2 w-[620px] translate-y-1 rounded-card border border-line bg-bg-soft/97 p-4 opacity-0 shadow-panel backdrop-blur-xl transition-all duration-250 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
            role="menu"
          >
            <div class="mb-3 flex items-center gap-2 border-b border-line-2 pb-2.5">
              <span class="font-mono text-[9.5px] tracking-[0.22em] text-ink-3">ALBUMS · 专辑</span>
              <span class="h-px flex-1 bg-line-2"></span>
              <span class="font-mono text-[9.5px] text-ink-3">{albums.length} 个 · 一级分类</span>
            </div>
            <ul class="grid grid-cols-3 gap-x-4 gap-y-0.5">
              {
                albums.map((a) => (
                  <li>
                    <a
                      href={u(`/topics/${a.slug}/`)}
                      role="menuitem"
                      aria-current={currentAlbum?.slug === a.slug ? 'page' : undefined}
                      class="flex items-center gap-2 rounded-[7px] px-2 py-1.5 text-[13px] text-ink-2 transition-colors hover:bg-panel-2 hover:text-ink"
                    >
                      <span class="serif grid h-[19px] w-[19px] shrink-0 place-items-center rounded-[5px] border border-line text-[11px] leading-none text-jade">
                        {a.glyph}
                      </span>
                      <span class="min-w-0 flex-1 truncate">{a.name}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a
              href={u('/topics/')}
              class="mt-3 flex items-center justify-center gap-1.5 border-t border-line-2 pt-2.5 text-[12px] text-ink-3 transition-colors hover:text-jade"
            >
              全部专辑 →
            </a>
          </div>
        </li>
      </ul>

      <!-- 窄屏：专辑逐条列出（与三大分类同为一级，故不折叠） -->
      <div class="mt-3 border-t border-line-2 pt-3 lg:hidden">
        <div class="mb-2 flex items-center gap-2 px-3">
          <span class="font-mono text-[9.5px] tracking-[0.22em] text-ink-3">ALBUMS · 专辑</span>
          <span class="h-px flex-1 bg-line-2"></span>
        </div>
        <ul class="grid grid-cols-2 gap-x-3 gap-y-0.5">
          {
            albums.map((a) => (
              <li>
                <a
                  href={u(`/topics/${a.slug}/`)}
                  aria-current={currentAlbum?.slug === a.slug ? 'page' : undefined}
                  class="flex items-center gap-2 rounded-[7px] px-3 py-2 text-[13.5px] transition-colors hover:bg-panel"
                  class:list={[
                    currentAlbum?.slug === a.slug ? 'text-jade' : 'text-ink-2',
                  ]}
                >
                  <span class="serif grid h-[19px] w-[19px] shrink-0 place-items-center rounded-[5px] border border-line text-[11px] leading-none">
                    {a.glyph}
                  </span>
                  <span class="min-w-0 flex-1 truncate">{a.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href={u('/topics/')}
          class="mt-2 block rounded-[7px] px-3 py-2 text-center text-[12.5px] text-ink-3 transition-colors hover:text-jade"
        >
          全部专辑 →
        </a>
      </div>
    </nav>

    <div class="ml-1 flex items-center gap-2 lg:ml-2">
      <a href={u('/browse/')} class="grid h-9 w-9 place-items-center rounded-chip border border-line bg-panel text-ink-2 transition-all hover:-translate-y-px hover:border-line hover:text-jade hover:shadow-[0_0_0_1px_var(--yzj-line),0_0_30px_-10px_var(--yzj-jade)]" title="检索经藏目录" aria-label="检索经藏目录">
        <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><circle cx="10" cy="10" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M14.3 14.3 L18.5 18.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </a>

      <button id="theme-toggle" type="button" class="grid h-9 w-9 place-items-center rounded-chip border border-line bg-panel text-ink-2 transition-all hover:-translate-y-px hover:border-line hover:text-jade hover:shadow-[0_0_0_1px_var(--yzj-line),0_0_30px_-10px_var(--yzj-jade)]" title="切换墨夜 / 素白" aria-label="切换主题">
        <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" class="block dark-only"><path d="M13.5 2.5a7.5 7.5 0 1 0 4 9.9A6.2 6.2 0 0 1 13.5 2.5Z" fill="currentColor"></path></svg>
        <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" class="hidden paper-only"><circle cx="10" cy="10" r="4.2" fill="currentColor"></circle><g stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6L16 16M16 4l-1.4 1.4M5.4 14.6L4 16"></path></g></svg>
      </button>

      <button id="nav-toggle" type="button" class="grid h-9 w-9 place-items-center rounded-chip border border-line bg-panel text-ink-2 lg:hidden" aria-label="展开导航" aria-expanded="false" aria-controls="site-nav">
        <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </div>
  <div class="pointer-events-none absolute inset-x-0 bottom-[-1px] h-px bg-[linear-gradient(90deg,transparent,var(--yzj-jade),var(--yzj-gold),transparent)] opacity-50"></div>
</header>

<style>
  .dark-only {
    display: block;
  }
  .paper-only {
    display: none;
  }
  :global([data-theme='paper']) .dark-only {
    display: none;
  }
  :global([data-theme='paper']) .paper-only {
    display: block;
  }
  .album-menu .duration-250 {
    transition-duration: 250ms;
  }
</style>
