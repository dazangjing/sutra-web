---
/**
 * 大藏目录页
 *
 * 篇目自**列表索引**取之（`scripts/build-list-index.py` 所建）：
 *
 *     index/list.json            筛选索引（检索与筛选之字段）
 *     index/cards/all.json       卡片索引（卡片显示之字段）
 *
 * 页面于**构建期**写入首批卡片（故无 JS 之读者亦得见内容，
 * 且首屏不待网络）；其余由 `src/scripts/browse.ts` 按需增量补入。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { fixedCategories, topics } from 'sutra-shared/config/collections';
import { loadCards } from '../lib/list-index';
import { u } from '../lib/url';

const cards = await loadCards('all');
const total = cards.length;
/** 首批（构建期写入） */
const initial = cards.slice(0, 60);
---

<BaseLayout title="大藏经目录" description="阅藏经全站篇目索引，支持关键词检索与分类筛选。" bodyClass="page-browse">
  <PageHero
    kicker="/ BROWSE"
    title="大藏经目录"
    desc="以关键词检索全站篇目，或按分类、部类、译者、朝代过滤。索引随正文即时生成。"
    count={`${total.toLocaleString('en-US')} 篇`}
  />

  <section class="mx-auto max-w-[1260px] px-4 pt-2 pb-16 sm:px-8 sm:pb-24">
    <div class="reveal mb-6.5 flex flex-col gap-4">
      <div class="flex items-center gap-3 rounded-full border border-line bg-panel px-5 py-1.5 transition-all focus-within:border-line-2 focus-within:shadow-[0_0_0_1px_var(--yzj-line),0_0_34px_-10px_var(--yzj-jade)]">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" class="shrink-0 text-ink-3"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M12.8 12.8 L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
        <input
          id="search-input"
          type="search"
          placeholder="检索篇名、译者、藏经编号、部类…"
          autocomplete="off"
          spellcheck="false"
          aria-label="检索篇目"
          class="w-full min-w-0 bg-transparent py-3 text-[15px] text-ink outline-none placeholder:text-ink-3"
        />
        <button id="search-clear" type="button" class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-[13px] text-ink-3 transition-colors hover:bg-panel-2 hover:text-cinnabar" aria-label="清空">✕</button>
      </div>

      <div class="flex flex-wrap items-center gap-3.5">
        <span class="font-mono text-[10.5px] tracking-[0.22em] text-ink-3">FILTER</span>
        <div id="filter-chips" class="flex flex-wrap gap-2">
          <button class="filter-chip is-active" data-filter="all" type="button">全部</button>
          {
            fixedCategories.map((col) => (
              <button class="filter-chip" data-filter={`cat:${col.slug}`} type="button">
                {col.name}
              </button>
            ))
          }
          {
            topics.map((topic) => (
              <button class="filter-chip" data-filter={`topic:${topic.slug}`} type="button">
                {topic.name}
              </button>
            ))
          }
        </div>
        <span id="result-count" class="ml-auto font-mono text-[11.5px] tracking-[0.14em] text-ink-3">{total.toLocaleString('en-US')} / {total.toLocaleString('en-US')}</span>
      </div>
    </div>

    <ol
      id="browse-list"
      data-base={import.meta.env.BASE_URL.replace(/\/+$/, '')}
      data-slug="all"
      class="grid gap-4 md:grid-cols-2 lg:grid-cols-3"
    >
      {
        initial.map((card, i) => (
          <li class="reveal is-in flex">
            <a
              href={u(`/read/${card.i}/`)}
              class="group relative flex w-full items-start gap-4 overflow-hidden rounded-card border border-line bg-panel px-5 py-5 transition-all duration-300 hover:-translate-y-[3px] hover:border-line-2 hover:bg-panel-2 hover:shadow-panel"
            >
              <span class="absolute inset-y-0 left-0 w-[2px] origin-top scale-y-0 bg-[linear-gradient(var(--yzj-jade),transparent)] transition-transform duration-300 group-hover:scale-y-100"></span>
              <span class="shrink-0 pt-0.5 font-mono text-[11.5px] tabular-nums text-ink-3">{String(i + 1).padStart(3, '0')}</span>
              <span class="flex min-w-0 flex-1 flex-col gap-1.5">
                <span class="flex flex-wrap items-center gap-x-2 gap-y-1 font-serif text-[17px] font-semibold tracking-[0.05em] text-ink transition-colors group-hover:text-jade">
                  <span>{card.t}</span>
                  {card.p > 0 && (
                    <span class="inline-flex shrink-0 items-center gap-1 align-middle text-cinnabar" title={`正文含图 ${card.p} 幅`} aria-label={`正文含图 ${card.p} 幅`}>
                      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" class="shrink-0 overflow-visible">
                        <rect x="1.4" y="2.6" width="13.2" height="10.8" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.15"></rect>
                        <circle cx="5.5" cy="6" r="1.35" fill="currentColor"></circle>
                        <path d="M2.2 12.2 6 8.6l2.6 2.3 2.1-1.9 3.1 3.2" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                      {card.p > 1 && <span class="font-mono text-[10px] tabular-nums leading-none">{card.p}</span>}
                    </span>
                  )}
                </span>
                <span class="font-mono text-[11.5px] text-ink-3">{card.a}{card.v && ` · ${card.v}`}</span>
                {card.s && <span class="line-clamp-2 text-[13px] leading-relaxed text-ink-2">{card.s}</span>}
                <span class="mt-0.5 flex flex-wrap gap-1.5">
                  {card.c && <i class="rounded-[5px] border border-line-2 bg-panel-2 px-1.5 py-0.5 font-mono text-[10.5px] text-ink-3 not-italic">{card.c}</i>}
                  {card.j > 0 && <i class="rounded-[5px] border border-line-2 bg-panel-2 px-1.5 py-0.5 font-mono text-[10.5px] text-ink-3 not-italic">{card.j} 卷</i>}
                </span>
              </span>
              <span class="mt-1 h-5 w-5 shrink-0 self-center text-ink-3 transition-all duration-300 group-hover:translate-x-1 group-hover:text-jade">
                <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-9 flex flex-col items-center gap-3">
      <button
        id="load-more"
        type="button"
        class="rounded-full border border-line bg-panel px-7 py-3 text-[14px] text-ink-2 transition-all duration-300 hover:-translate-y-0.5 hover:border-line-2 hover:text-jade hover:shadow-[0_0_0_1px_var(--yzj-line),0_0_34px_-10px_var(--yzj-jade)]"
      >
        载入更多
      </button>
      <p id="browse-hint" class="font-mono text-[11.5px] text-ink-3"></p>
    </div>

    <p id="browse-empty" class="hidden py-16 text-center text-[14px] text-ink-3">未检索到匹配篇目，请尝试更换关键词。</p>
  </section>

  <script>
    import '../scripts/browse.ts';
  </script>
</BaseLayout>

<style>
  .filter-chip {
    padding: 7px 16px;
    border-radius: 999px;
    border: 1px solid var(--yzj-line);
    font-size: 13px;
    color: var(--yzj-ink-2);
    background: var(--yzj-panel);
    transition: all 0.26s var(--ease-zen);
  }
  .filter-chip:hover {
    color: var(--yzj-ink);
    border-color: var(--yzj-line);
  }
  .filter-chip.is-active {
    color: #04211c;
    background: linear-gradient(135deg, var(--yzj-jade), var(--yzj-jade-2));
    border-color: transparent;
    font-weight: 600;
  }
  :global([data-theme='paper']) .filter-chip.is-active {
    color: #f2fbf7;
  }
</style>

