---
import { getEntry, render } from 'astro:content';
import Reading from '../layouts/Reading.astro';
import { u } from '../lib/url';
import { corpusTotals } from 'sutra-shared/config/corpus-stats';
import { canonTotals } from 'sutra-shared/config/corpus-canon';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('缺少 src/content/pages/about.md');

const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const meta = [
  ...entry.data.meta.map((m) => ({ label: m.label, value: m.value })),
  { label: '入库篇目', value: `${corpusTotals.works.toLocaleString('en-US')} 篇` },
  { label: '正文字数', value: `${(corpusTotals.chars / 1e4).toLocaleString('en-US', { maximumFractionDigits: 1 })} 万字` },
  { label: '藏经来源', value: `${canonTotals.sources} 种` },
];
if (entry.data.updated) meta.push({ label: '更新', value: entry.data.updated });
---

<Reading
  title={entry.data.title}
  description={entry.data.description}
  crumbs={[{ label: '首页', href: u('/') }, { label: entry.data.title }]}
  eyebrow={[{ label: '本站说明' }]}
  subtitle={entry.data.subtitle}
  byline={entry.data.byline}
  bylineLabel={entry.data.byline_label}
  summary={entry.data.description}
  meta={meta}
  toc={toc}
  footNote="本页所述统计数字随语料更新自动刷新；引用经文请核对原典，引用本站文字请注明出处。"
  bodyClass="page-about"
>
  <Content />
</Reading>
