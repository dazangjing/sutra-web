---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { topics, fixedCategories } from '../../data/collections';
import { collectDocs } from '../../lib/collections';
import { u } from '../../lib/url';

const docs = (await getCollection('sutra')).sort((a, b) => a.data.order - b.data.order);
const counts = Object.fromEntries(topics.map((t) => [t.slug, collectDocs(docs, t).length]));

const accentClass: Record<string, { text: string; border: string; bg: string; glow: string; wash: string }> = {
  jade: { text: 'text-jade', border: 'border-jade/35', bg: 'bg-jade/10', glow: 'hover:shadow-[0_0_0_1px_rgb(95_227_192/0.2),0_26px_60px_-30px_rgb(95_227_192/0.55)]', wash: 'from-jade/20' },
  gold: { text: 'text-gold', border: 'border-gold/35', bg: 'bg-gold/10', glow: 'hover:shadow-[0_0_0_1px_rgb(227_192_105/0.2),0_26px_60px_-30px_rgb(227_192_105/0.5)]', wash: 'from-gold/20' },
  violet: { text: 'text-violet', border: 'border-violet/35', bg: 'bg-violet/10', glow: 'hover:shadow-[0_0_0_1px_rgb(155_140_245/0.2),0_26px_60px_-30px_rgb(155_140_245/0.5)]', wash: 'from-violet/20' },
  cinnabar: { text: 'text-cinnabar', border: 'border-cinnabar/35', bg: 'bg-cinnabar/10', glow: 'hover:shadow-[0_0_0_1px_rgb(224_100_79/0.2),0_26px_60px_-30px_rgb(224_100_79/0.5)]', wash: 'from-cinnabar/20' },
  slate: { text: 'text-ink-2', border: 'border-ink-3/45', bg: 'bg-ink-3/10', glow: 'hover:shadow-[0_0_0_1px_rgb(109_124_121/0.25),0_26px_60px_-30px_rgb(109_124_121/0.45)]', wash: 'from-ink-3/20' },
};
---

<BaseLayout title="专辑" description="大藏经专辑：按宗派与门类组织的一级分类，跨部类读本集合。" bodyClass="page-topics">
  <PageHero
    kicker="/ ALBUMS"
    title="专辑"
    desc="专辑与三大固定分类同为一级分类：不拘于部类，而以宗派、门类为线索，横跨经律论注疏诸部，择取一组可连缀而读之典籍。"
    count={`${topics.length} 个专辑`}
  />

  <section class="mx-auto max-w-[1260px] px-4 pb-14 sm:px-8 sm:pb-20">
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        topics.map((topic) => {
          const a = accentClass[topic.accent];
          return (
            <article class:list={['reveal group relative overflow-hidden rounded-card border border-line bg-panel px-6 py-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-line-2', a.glow]}>
              <div class:list={['pointer-events-none absolute inset-x-[-20%] top-0 h-[240px] bg-gradient-to-b to-transparent opacity-50 transition-opacity duration-300 group-hover:opacity-90', a.wash]}></div>

              <div class="relative flex items-center justify-between">
                <span class:list={['grid h-[46px] w-[46px] place-items-center rounded-[10px] border font-serif text-[23px]', a.border, a.bg, a.text]}>
                  {topic.glyph}
                </span>
                <span class="font-mono text-[11px] tracking-[0.14em] text-ink-3">{(counts[topic.slug] ?? 0).toLocaleString('en-US')} 篇</span>
              </div>

              <h3 class="relative mt-4.5 mb-1 font-serif text-[24px] font-semibold tracking-[0.1em] text-ink">{topic.name}</h3>
              <p class:list={['relative mb-3.5 font-mono text-[10.5px] tracking-[0.24em]', a.text]}>{topic.en}</p>
              <p class="relative mb-5 text-[13.5px] leading-[1.95] text-ink-2">{topic.desc}</p>

              <ul class="relative mb-5 flex flex-wrap gap-1.5">
                {topic.keywords.slice(0, 5).map((k) => (
                  <li class="rounded-[5px] border border-line-2 bg-panel-2 px-1.5 py-0.5 font-mono text-[10.5px] text-ink-3">{k}</li>
                ))}
              </ul>

              <a href={u(`/topics/${topic.slug}/`)} class:list={['relative inline-flex items-center gap-2 text-[13px] tracking-[0.08em]', a.text]}>
                进入专辑
                <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">
                  <path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="reveal mx-auto max-w-[1260px] border-t border-line px-4 py-8.5 text-center sm:px-8 sm:py-11">
    <p class="mb-4 text-[11.5px] tracking-[0.2em] text-ink-3">同为一级分类 · 三大固定分类</p>
    <div class="flex flex-wrap justify-center gap-2.5">
      {
        fixedCategories.map((c) => (
          <a
            href={u(`/categories/${c.slug}/`)}
            class="inline-flex items-center gap-2 rounded-full border border-line bg-panel px-4.5 py-2.5 text-[13.5px] text-ink-2 transition-all duration-300 hover:-translate-y-0.5 hover:border-line-2 hover:text-jade hover:shadow-[0_0_0_1px_var(--yzj-line),0_0_34px_-10px_var(--yzj-jade)]"
          >
            <span class="font-serif text-jade">{c.glyph}</span>
            {c.name}
          </a>
        ))
      }
      <a href={u('/browse/')} class="rounded-full border border-line bg-panel px-4.5 py-2.5 text-[13.5px] text-ink-3 transition-all duration-300 hover:-translate-y-0.5 hover:border-line-2 hover:text-jade">大藏目录</a>
    </div>
  </section>
</BaseLayout>
