---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { u } from '../../lib/url';
import { categoryMap } from '../../data/categories';

export async function getStaticPaths() {
  const docs = await getCollection('sutra');
  return docs.map((doc) => ({ params: { id: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const data = doc.data;
const cat = categoryMap[data.category];

const all = (await getCollection('sutra')).sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((d) => d.id === doc.id);
const prev = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const byline = data.translator ?? data.author ?? '';
const bylineLabel = data.translator ? (data.translator_label ?? '著者·译者') : (data.author_label ?? '著者');

const facts = [
  { label: '藏经', value: data.canon },
  { label: '藏名', value: data.canon_name },
  { label: '册次', value: data.volume },
  { label: '部类', value: data.division },
  { label: '卷数', value: data.juan_count ? `${data.juan_count} 卷` : undefined },
  { label: '字数', value: data.text_length ? `${data.text_length.toLocaleString('en-US')} 字` : undefined },
  { label: '篇幅', value: data.length },
  { label: '时代', value: data.dynasty },
].filter((f) => f.value);
---

<BaseLayout title={data.title} description={data.summary ?? ''} ogType="article">
  <article class="mx-auto grid max-w-[1260px] grid-cols-1 items-start gap-8 px-4 pt-10 pb-16 sm:px-8 lg:grid-cols-[236px_minmax(0,1fr)] lg:gap-12">
    <!-- 侧栏 -->
    <aside class="lg:sticky lg:top-[88px]">
      <div class="flex flex-col gap-6 lg:gap-7">
        {
          toc.length > 0 && (
            <nav aria-label="篇目目录" class="min-w-0 flex-1">
              <p class="mb-3 font-mono text-[10.5px] tracking-[0.22em] text-ink-3">CONTENTS</p>
              <ol class="max-h-[52vh] overflow-y-auto border-l border-line pr-1">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc-link
                      class:list={[
                        'block border-l-2 border-transparent py-1.5 pl-3.5 text-[13px] leading-relaxed text-ink-3 transition-colors hover:text-ink-2',
                        h.depth === 3 && 'pl-7 text-[12.5px]',
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <div class="min-w-0 flex-1">
          <p class="mb-3 font-mono text-[10.5px] tracking-[0.22em] text-ink-3">READING</p>
          <dl class="grid gap-2.5 font-mono">
            <div class="flex items-baseline gap-2.5">
              <dt class="w-[52px] shrink-0 text-[10.5px] tracking-[0.1em] text-ink-3">分类</dt>
              <dd class="text-[12px] text-ink-2">
                <a href={u(`/categories/${cat.slug}/`)} class="hover:text-jade">{cat.name}</a>
              </dd>
            </div>
            {
              byline && (
                <div class="flex items-baseline gap-2.5">
                  <dt class="w-[52px] shrink-0 text-[10.5px] tracking-[0.1em] text-ink-3">{bylineLabel}</dt>
                  <dd class="text-[12px] leading-relaxed text-ink-2">{byline}</dd>
                </div>
              )
            }
            {
              data.division && (
                <div class="flex items-baseline gap-2.5">
                  <dt class="w-[52px] shrink-0 text-[10.5px] tracking-[0.1em] text-ink-3">部类</dt>
                  <dd class="text-[12px] text-ink-2">{data.division}</dd>
                </div>
              )
            }
            {
              data.canon && (
                <div class="flex items-baseline gap-2.5">
                  <dt class="w-[52px] shrink-0 text-[10.5px] tracking-[0.1em] text-ink-3">编号</dt>
                  <dd class="text-[12px] text-ink-2">{data.canon}</dd>
                </div>
              )
            }
            {
              data.text_length && (
                <div class="flex items-baseline gap-2.5">
                  <dt class="w-[52px] shrink-0 text-[10.5px] tracking-[0.1em] text-ink-3">字数</dt>
                  <dd class="text-[12px] text-ink-2">{data.text_length.toLocaleString('en-US')}</dd>
                </div>
              )
            }
          </dl>

          <div class="mt-3.5 flex gap-2">
            <button id="font-down" type="button" class="rounded-[7px] border border-line bg-panel px-2.5 py-1.5 font-mono text-[11px] text-ink-3 transition-all hover:border-line-2 hover:text-jade hover:shadow-[0_0_0_1px_var(--yzj-line),0_0_30px_-10px_var(--yzj-jade)]" title="缩小字号">A−</button>
            <button id="font-up" type="button" class="rounded-[7px] border border-line bg-panel px-2.5 py-1.5 font-mono text-[11px] text-ink-3 transition-all hover:border-line-2 hover:text-jade hover:shadow-[0_0_0_1px_var(--yzj-line),0_0_30px_-10px_var(--yzj-jade)]" title="放大字号">A+</button>
            <button id="copy-link" type="button" class="rounded-[7px] border border-line bg-panel px-2.5 py-1.5 font-mono text-[11px] text-ink-3 transition-all hover:border-line-2 hover:text-jade hover:shadow-[0_0_0_1px_var(--yzj-line),0_0_30px_-10px_var(--yzj-jade)]" title="复制本页链接">链接</button>
          </div>
        </div>
      </div>
    </aside>

    <!-- 正文 -->
    <div class="min-w-0 max-w-[760px]">
      <header class="reveal mb-8.5">
        <div class="mb-4.5 flex flex-wrap items-center gap-3">
          <a
            href={u(`/categories/${cat.slug}/`)}
            class:list={[
              'inline-flex items-center gap-2 rounded-full border px-3 py-1 font-mono text-[11.5px] tracking-[0.1em]',
              cat.accent === 'jade' && 'border-jade/30 bg-jade/10 text-jade',
              cat.accent === 'gold' && 'border-gold/30 bg-gold/10 text-gold',
              cat.accent === 'violet' && 'border-violet/30 bg-violet/10 text-violet',
              cat.accent === 'cinnabar' && 'border-cinnabar/30 bg-cinnabar/10 text-cinnabar',
              cat.accent === 'slate' && 'border-ink-3/40 bg-ink-3/10 text-ink-2',
            ]}
          >
            <i class="h-1.5 w-1.5 rounded-full bg-current shadow-[0_0_8px_currentColor]"></i>
            {cat.name}
          </a>
          {
            data.division && (
              <span class="font-mono text-[11px] tracking-[0.08em] text-ink-3">{data.division}</span>
            )
          }
        </div>

        <h1 class="font-serif text-[clamp(26px,4.4vw,42px)] leading-[1.35] font-semibold tracking-[0.06em] text-ink">
          {data.title}
        </h1>
        {data.title_trad && <p class="mt-2 font-serif text-[17px] tracking-[0.1em] text-ink-3">{data.title_trad}</p>}
        {data.subtitle && <p class="mt-3 text-[15px] text-ink-2">{data.subtitle}</p>}

        {
          byline && (
            <p class="mt-5 flex items-baseline gap-3">
              <span class="rounded-[5px] border border-gold/28 bg-gold/10 px-2.5 py-1 font-mono text-[10px] tracking-[0.18em] text-gold">
                {bylineLabel}
              </span>
              <span class="font-serif text-[15px] tracking-[0.06em] text-ink">{byline}</span>
            </p>
          )
        }

        {
          data.summary && (
            <p class="mt-5 rounded-r-chip border-l-2 border-line bg-panel py-3.5 pr-4 pl-4.5 text-[13.5px] leading-[1.95] text-ink-2">
              {data.summary}
            </p>
          )
        }

        {
          facts.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2.5 border-t border-line pt-4 font-mono text-[11.5px] text-ink-2">
              {facts.map((f) => (
                <li class="flex items-baseline gap-2">
                  <span class="tracking-[0.12em] text-ink-3">{f.label}</span>
                  {f.value}
                </li>
              ))}
            </ul>
          )
        }
      </header>

      <div id="article-body" class="prose-zen">
        <Content />
      </div>

      <footer class="reveal mt-13.5 border-t border-line pt-7.5">
        <div class="mb-7 flex gap-3.5">
          <span class="h-fit shrink-0 rounded-[5px] border border-gold/26 bg-gold/10 px-2.5 py-1 font-mono text-[10px] tracking-[0.16em] text-gold">NOTE</span>
          <p class="m-0 text-[12px] leading-[1.9] text-ink-3">
            本页正文依 CBETA 佛典数据库（中华电子佛典协会）整理本录入，仅供学习与研究参考；
            不同版本字句或有出入，引用时请核对原典。
          </p>
        </div>

        <nav class="grid gap-3.5 sm:grid-cols-2" aria-label="上下篇">
          {
            prev && (
              <a href={u(`/read/${prev.id}/`)} class="flex flex-col gap-2 rounded-card border border-line bg-panel px-4.5 py-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-line-2 hover:bg-panel-2">
                <span class="font-mono text-[10.5px] tracking-[0.16em] text-ink-3">← 上一篇</span>
                <span class="font-serif text-[15.5px] tracking-[0.04em] text-ink transition-colors hover:text-jade">{prev.data.title}</span>
              </a>
            )
          }
          {
            next && (
              <a href={u(`/read/${next.id}/`)} class="flex flex-col gap-2 rounded-card border border-line bg-panel px-4.5 py-4 text-right transition-all duration-300 hover:-translate-y-0.5 hover:border-line-2 hover:bg-panel-2">
                <span class="font-mono text-[10.5px] tracking-[0.16em] text-ink-3">下一篇 →</span>
                <span class="font-serif text-[15.5px] tracking-[0.04em] text-ink transition-colors hover:text-jade">{next.data.title}</span>
              </a>
            )
          }
        </nav>
      </footer>
    </div>
  </article>

  <script>
    import '../../scripts/reader.ts';
  </script>
</BaseLayout>
