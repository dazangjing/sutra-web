---
import { getCollection, render } from 'astro:content';
import Reading from '../../layouts/Reading.astro';
import { u } from '../../lib/url';
import { fixedCategories } from '../../data/collections';
import { collectDocs } from '../../lib/collections';

export async function getStaticPaths() {
  const docs = await getCollection('sutra');
  return docs.map((doc) => ({ params: { id: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const data = doc.data;

const all = (await getCollection('sutra')).sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((d) => d.id === doc.id);
const prev = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;

/* 所属集合（面包屑第二级）：先取专类（禅宗 / 近代著作），再退回大藏经 */
const specific = fixedCategories.filter((col) => col.slug !== 'tripitaka');
const fallback = fixedCategories.filter((col) => col.slug === 'tripitaka');
const owner =
  specific.find((col) => collectDocs(all, col).some((d) => d.id === doc.id)) ??
  fallback.find((col) => collectDocs(all, col).some((d) => d.id === doc.id)) ??
  fixedCategories[0];

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const byline = data.translator ?? data.author ?? '';
const bylineLabel = data.translator ? (data.translator_label ?? '著者·译者') : (data.author_label ?? '著者');

const meta = [
  { label: '藏经', value: data.canon ?? '' },
  { label: '藏名', value: data.canon_name ?? '' },
  { label: '册次', value: data.volume ?? '' },
  { label: '部类', value: data.division ?? '' },
  { label: '卷数', value: data.juan_count ? `${data.juan_count} 卷` : '' },
  { label: '字数', value: data.text_length ? `${data.text_length.toLocaleString('en-US')} 字` : '' },
  { label: '时代', value: data.dynasty ?? '' },
].filter((m) => m.value);

const crumbs = [{ label: '首页', href: u('/') }, { label: owner.name, href: u(`/categories/${owner.slug}/`) }];
if (data.division) {
  crumbs.push({ label: data.division, href: u(`/browse/?q=${encodeURIComponent(data.division)}`) });
}
crumbs.push({ label: data.title });
---

<Reading
  title={data.title}
  description={data.summary ?? ''}
  crumbs={crumbs}
  eyebrow={[{ label: owner.name, href: u(`/categories/${owner.slug}/`) }]}
  subtitle={data.subtitle}
  tradTitle={data.title_trad}
  tags={data.tags}
  byline={byline}
  bylineLabel={bylineLabel}
  summary={data.summary}
  meta={meta}
  toc={toc}
  footNote="本页正文依 CBETA 佛典数据库（中华电子佛典协会）整理本录入，仅供学习与研究参考；不同版本字句或有出入，引用时请核对原典。"
  prev={prev ? { title: prev.data.title, url: u(`/read/${prev.id}/`) } : undefined}
  next={next ? { title: next.data.title, url: u(`/read/${next.id}/`) } : undefined}
  bodyClass="page-reading"
>
  <Content />
</Reading>
