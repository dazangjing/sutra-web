---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DocCard from '../components/DocCard.astro';
import { fixedCategories, topics } from '../data/collections';
import { u } from '../lib/url';

const docs = (await getCollection('sutra')).sort((a, b) => a.data.order - b.data.order);
const initial = docs.slice(0, 60);
const total = docs.length;
---

<BaseLayout title="大藏经目录" description="阅藏经全站篇目索引，支持关键词检索与分类筛选。" bodyClass="page-browse">
  <PageHero
    kicker="/ BROWSE"
    title="大藏经目录"
    desc="以关键词检索全站篇目，或按分类、部类、译者、朝代过滤。索引随正文即时生成。"
    count={`${total.toLocaleString('en-US')} 篇`}
  />

  <section class="mx-auto max-w-[1260px] px-4 pt-2 pb-16 sm:px-8 sm:pb-24">
    <div class="reveal mb-6.5 flex flex-col gap-4">
      <div class="flex items-center gap-3 rounded-full border border-line bg-panel px-5 py-1.5 transition-all focus-within:border-line-2 focus-within:shadow-[0_0_0_1px_var(--yzj-line),0_0_34px_-10px_var(--yzj-jade)]">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" class="shrink-0 text-ink-3"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M12.8 12.8 L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
        <input
          id="search-input"
          type="search"
          placeholder="检索篇名、译者、藏经编号、部类…"
          autocomplete="off"
          spellcheck="false"
          aria-label="检索篇目"
          class="w-full min-w-0 bg-transparent py-3 text-[15px] text-ink outline-none placeholder:text-ink-3"
        />
        <button id="search-clear" type="button" class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-[13px] text-ink-3 transition-colors hover:bg-panel-2 hover:text-cinnabar" aria-label="清空">✕</button>
      </div>

      <div class="flex flex-wrap items-center gap-3.5">
        <span class="font-mono text-[10.5px] tracking-[0.22em] text-ink-3">FILTER</span>
        <div id="filter-chips" class="flex flex-wrap gap-2">
          <button class="filter-chip is-active" data-filter="all" type="button">全部</button>
          {
            fixedCategories.map((col) => (
              <button class="filter-chip" data-filter={`cat:${col.slug}`} type="button">
                {col.name}
              </button>
            ))
          }
          {
            topics.map((topic) => (
              <button class="filter-chip" data-filter={`topic:${topic.slug}`} type="button">
                {topic.name}
              </button>
            ))
          }
        </div>
        <span id="result-count" class="ml-auto font-mono text-[11.5px] tracking-[0.14em] text-ink-3">{total.toLocaleString('en-US')} / {total.toLocaleString('en-US')}</span>
      </div>
    </div>

    <ol id="browse-list" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {initial.map((doc, i) => <DocCard doc={doc} index={i + 1} />)}
    </ol>

    <div class="reveal mt-9 flex flex-col items-center gap-3">
      <button
        id="load-more"
        type="button"
        class="rounded-full border border-line bg-panel px-7 py-3 text-[14px] text-ink-2 transition-all duration-300 hover:-translate-y-0.5 hover:border-line-2 hover:text-jade hover:shadow-[0_0_0_1px_var(--yzj-line),0_0_34px_-10px_var(--yzj-jade)]"
      >
        载入更多
      </button>
      <p id="browse-hint" class="font-mono text-[11.5px] text-ink-3"></p>
    </div>

    <p id="browse-empty" class="hidden py-16 text-center text-[14px] text-ink-3">未检索到匹配篇目，请尝试更换关键词。</p>
  </section>
</BaseLayout>

<style>
  .filter-chip {
    padding: 7px 16px;
    border-radius: 999px;
    border: 1px solid var(--yzj-line);
    font-size: 13px;
    color: var(--yzj-ink-2);
    background: var(--yzj-panel);
    transition: all 0.26s var(--ease-zen);
  }
  .filter-chip:hover {
    color: var(--yzj-ink);
    border-color: var(--yzj-line);
  }
  .filter-chip.is-active {
    color: #04211c;
    background: linear-gradient(135deg, var(--yzj-jade), var(--yzj-jade-2));
    border-color: transparent;
    font-weight: 600;
  }
  :global([data-theme='paper']) .filter-chip.is-active {
    color: #f2fbf7;
  }
</style>

<script define:vars={{ base: import.meta.env.BASE_URL.replace(/\/+$/, '') }}>
  type Entry = {
    id: string;
    t: string;
    x: string;
    a: string;
    c: string;
    n: string;
    v: string;
    g: string;
    k: string;
    s: string;
    j: number;
    z: number;
    /** 所属集合（三大固定分类 + 专题） */
    m: string[];
  };

  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const clear = document.getElementById('search-clear');
  const chips = document.getElementById('filter-chips');
  const count = document.getElementById('result-count');
  const empty = document.getElementById('browse-empty');
  const list = document.getElementById('browse-list');
  const loadMore = document.getElementById('load-more');
  const hint = document.getElementById('browse-hint');

  let index: Entry[] = [];
  let activeCat = 'all';
  let keyword = '';
  let shown = 60;
  let loading = false;

  const normalize = (value: string) => value.toLowerCase().replace(/\s+/g, '');

  const esc = (value: string) =>
    value.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]!);

  const card = (entry: Entry, no: number) => `
    <li class="reveal flex">
      <a href="${base}/read/${encodeURIComponent(entry.id)}/" class="group relative flex w-full items-start gap-4 overflow-hidden rounded-card border border-line bg-panel px-5 py-5 transition-all duration-300 hover:-translate-y-[3px] hover:border-line-2 hover:bg-panel-2 hover:shadow-panel">
        <span class="absolute inset-y-0 left-0 w-[2px] origin-top scale-y-0 bg-[linear-gradient(var(--yzj-jade),transparent)] transition-transform duration-300 group-hover:scale-y-100"></span>
        <span class="shrink-0 pt-0.5 font-mono text-[11.5px] tabular-nums text-ink-3">${String(no).padStart(3, '0')}</span>
        <span class="flex min-w-0 flex-1 flex-col gap-1.5">
          <span class="font-serif text-[17px] font-semibold tracking-[0.05em] text-ink transition-colors group-hover:text-jade">${esc(entry.t)}</span>
          <span class="font-mono text-[11.5px] text-ink-3">${esc(entry.a)}${entry.v ? ` · ${esc(entry.v)}` : ''}</span>
          <span class="line-clamp-2 text-[13px] leading-relaxed text-ink-2">${esc(entry.s)}</span>
          <span class="mt-0.5 flex flex-wrap gap-1.5">
            <i class="rounded-[5px] border border-line-2 bg-panel-2 px-1.5 py-0.5 font-mono text-[10.5px] text-ink-3 not-italic">${esc(entry.c)}</i>
            ${entry.j ? `<i class="rounded-[5px] border border-line-2 bg-panel-2 px-1.5 py-0.5 font-mono text-[10.5px] text-ink-3 not-italic">${entry.j} 卷</i>` : ''}
          </span>
        </span>
        <span class="mt-1 h-5 w-5 shrink-0 self-center text-ink-3 transition-all duration-300 group-hover:translate-x-1 group-hover:text-jade">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </span>
      </a>
    </li>`;

  const matches = (entry: Entry) => {
    if (activeCat !== 'all' && !entry.m.includes(activeCat)) return false;
    if (!keyword) return true;
    const hay = normalize(`${entry.t} ${entry.x} ${entry.a} ${entry.c} ${entry.n} ${entry.v} ${entry.g} ${entry.s}`);
    return hay.includes(keyword);
  };

  const render = () => {
    if (!list) return;
    const hits = index.filter(matches);
    const slice = hits.slice(0, shown);
    list.innerHTML = slice.map((entry, i) => card(entry, i + 1)).join('');

    if (count) count.textContent = `${hits.length.toLocaleString('en-US')} / ${index.length.toLocaleString('en-US')}`;
    empty?.classList.toggle('hidden', hits.length !== 0);
    loadMore?.classList.toggle('hidden', hits.length <= shown);
    if (hint) {
      hint.textContent = hits.length > shown ? `已显示 ${shown} / ${hits.length.toLocaleString('en-US')} 篇` : '';
    }
    // 重新触发进场动效
    list.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
  };

  // URL 参数预填：/browse/?q=般若部
  const params = new URLSearchParams(window.location.search);
  const prefill = params.get('q');
  if (prefill && input) {
    input.value = prefill;
    keyword = normalize(prefill);
  }

  const load = async () => {
    if (loading) return;
    loading = true;
    try {
      const res = await fetch(`${base}/search-index.json`);
      index = (await res.json()) as Entry[];
      render();
    } catch {
      if (hint) hint.textContent = '索引载入失败，请刷新重试。';
    } finally {
      loading = false;
    }
  };

  input?.addEventListener('input', () => {
    keyword = normalize(input.value);
    shown = 60;
    render();
  });

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      input.value = '';
      keyword = '';
      shown = 60;
      render();
    }
  });

  clear?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      input.focus();
    }
    keyword = '';
    shown = 60;
    render();
  });

  chips?.addEventListener('click', (event) => {
    const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('.filter-chip');
    if (!chip) return;
    chips.querySelectorAll('.filter-chip').forEach((el) => el.classList.remove('is-active'));
    chip.classList.add('is-active');
    activeCat = chip.dataset.filter ?? 'all';
    shown = 60;
    render();
  });

  loadMore?.addEventListener('click', () => {
    shown += 60;
    render();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && document.activeElement !== input) {
      event.preventDefault();
      input?.focus();
    }
  });

  load();
</script>
