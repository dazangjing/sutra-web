---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import DocCard from '../../components/DocCard.astro';
import ImageMark from '../../components/ImageMark.astro';
import { fixedCategories, topics, collectionMap } from '../../data/collections';
import { collectDocs, groupByDivision } from '../../lib/collections';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  return fixedCategories.map((col) => ({ params: { slug: col.slug }, props: { col } }));
}

const { col } = Astro.props;
const docs = (await getCollection('sutra')).sort((a, b) => a.data.order - b.data.order);
const list = collectDocs(docs, col);
const divisions = groupByDivision(list);

// 各部类中的代表作（取该部类首篇）
const representatives = divisions.slice(0, 12).map(([name, count]) => ({
  name,
  count,
  doc: list.find((d) => d.data.division === name),
}));
---

<BaseLayout title={col.name} description={col.desc} bodyClass="page-category">
  <PageHero kicker={`/ ${col.en}`} title={col.name} glyph={col.glyph} desc={col.desc} count={`${list.length.toLocaleString('en-US')} 篇`} />

  {
    divisions.length > 0 && (
      <section class="mx-auto max-w-[1260px] px-4 pb-10 sm:px-8">
        <div class="reveal mb-6 flex items-center gap-4">
          <h2 class="shrink-0 font-serif text-[clamp(19px,2.2vw,24px)] font-semibold tracking-[0.08em] text-ink">部类分布</h2>
          <span class="h-px flex-1 bg-[linear-gradient(90deg,var(--yzj-line),transparent)]"></span>
          <span class="shrink-0 font-mono text-[11.5px] tracking-[0.14em] text-ink-3">{divisions.length} 部类</span>
        </div>

        <ul class="reveal grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
          {divisions.map(([name, count]) => (
            <li>
              <a
                href={u(`/browse/?q=${encodeURIComponent(name)}`)}
                class="group flex items-baseline justify-between gap-3 rounded-chip border border-line bg-panel px-4 py-2.5 transition-all duration-300 hover:-translate-y-0.5 hover:border-line-2 hover:text-jade"
              >
                <span class="text-[13.5px] text-ink-2 transition-colors group-hover:text-jade">{name}</span>
                <span class="font-mono text-[11.5px] tabular-nums text-ink-3">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mx-auto max-w-[1260px] px-4 pb-14 sm:px-8 sm:pb-20">
    <div class="reveal mb-8.5 flex items-center gap-4">
      <h2 class="shrink-0 font-serif text-[clamp(21px,2.5vw,27px)] font-semibold tracking-[0.08em] text-ink">篇目一览</h2>
      <span class="h-px flex-1 bg-[linear-gradient(90deg,var(--yzj-line),transparent)]"></span>
      <span class="shrink-0 font-mono text-[11.5px] tracking-[0.16em] text-ink-3">{list.length.toLocaleString('en-US')} ITEMS</span>
    </div>

    <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {list.slice(0, 300).map((doc, i) => <DocCard doc={doc} index={i + 1} />)}
    </ol>

    {list.length > 300 && (
      <p class="reveal mt-7 text-center font-mono text-[11.5px] text-ink-3">
        共 {list.length.toLocaleString('en-US')} 篇，此处列出前 300 篇；完整目录请见
        <a href={u('/browse/')} class="text-jade hover:underline">大藏目录</a>
      </p>
    )}

    {
      representatives.length > 0 && (
        <div class="reveal mt-14">
          <h3 class="mb-5 font-serif text-[18px] font-semibold tracking-[0.08em] text-ink">各部类首篇</h3>
          <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {representatives.map(({ name, count, doc }) =>
              doc && (
                <li class="flex items-baseline gap-2.5 border-b border-line-2 pb-2 text-[13px]">
                  <span class="shrink-0 text-ink-3">{name}</span>
                  <span class="text-ink-3">·</span>
                  <a href={u(`/read/${doc.id}/`)} class="flex min-w-0 flex-1 items-baseline gap-1.5 truncate text-ink-2 transition-colors hover:text-jade">
                    <span class="truncate">{doc.data.title}</span>
                    {doc.data.image_count && <ImageMark count={doc.data.image_count} />}
                  </a>
                  <span class="ml-auto shrink-0 font-mono text-[11px] text-ink-3">{count}</span>
                </li>
              ),
            )}
          </ul>
        </div>
      )
    }
  </section>

  <section class="reveal mx-auto max-w-[1260px] border-t border-line px-4 py-8.5 text-center sm:px-8 sm:py-11">
    <p class="mb-4 text-[11.5px] tracking-[0.2em] text-ink-3">继续浏览</p>
    <div class="flex flex-wrap justify-center gap-2.5">
      {
        topics.map((topic) => (
          <a
            href={u(`/topics/${topic.slug}/`)}
            class="inline-flex items-center gap-2 rounded-full border border-line bg-panel px-4.5 py-2.5 text-[13.5px] text-ink-2 transition-all duration-300 hover:-translate-y-0.5 hover:border-line-2 hover:text-jade hover:shadow-[0_0_0_1px_var(--yzj-line),0_0_34px_-10px_var(--yzj-jade)]"
          >
            <span class="font-serif text-jade">{topic.glyph}</span>
            {topic.name}
            <span class="font-mono text-[11px] text-ink-3">专辑</span>
          </a>
        ))
      }
      <a href={u('/browse/')} class="rounded-full border border-line bg-panel px-4.5 py-2.5 text-[13.5px] text-ink-3 transition-all duration-300 hover:-translate-y-0.5 hover:border-line-2 hover:text-jade">大藏目录</a>
    </div>
  </section>
</BaseLayout>
