---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import StatTable from '../components/StatTable.astro';
import DonutChart from '../components/DonutChart.astro';
import { classification, canons, distribution, distributionTotal } from '../data/tripitaka';
---

<BaseLayout title="藏经概览" description="大藏经部卷分类统计与历代刻藏概览。" bodyClass="page-stats">
  <PageHero
    kicker="/ STATISTICS"
    title="藏经概览"
    desc="一部大藏经，是两千余年间无数译经、刻经、印经者留下的体量。以下以部、卷为经纬，勾勒其构成与流变。"
    count="大藏经数据"
  />

  <section class="mx-auto max-w-[1260px] px-4 py-14 sm:px-8 sm:py-20">
    <div class="reveal mb-8.5 flex items-center gap-4">
      <h2 class="shrink-0 font-serif text-[clamp(21px,2.5vw,27px)] font-semibold tracking-[0.08em] text-ink">{classification.title}</h2>
      <span class="h-px flex-1 bg-[linear-gradient(90deg,var(--yzj-line),transparent)]"></span>
      <span class="shrink-0 font-mono text-[11.5px] tracking-[0.16em] text-ink-3">
        {classification.totalParts} 部 / {classification.totalVolumes} 卷
      </span>
    </div>

    <div class="reveal">
      <StatTable
        rows={classification.rows}
        totalParts={classification.totalParts}
        totalVolumes={classification.totalVolumes}
        showAverage
      />
      <p class="mt-3.5 px-0.5 font-mono text-[11.5px] tracking-[0.04em] text-ink-3">
        ※ 部卷分类统计依《大藏经》部卷分类通例整理；各刻本编次略有出入，仅供浏览参考。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1260px] px-4 py-14 sm:px-8 sm:py-20">
    <div class="reveal mb-8.5 flex items-center gap-4">
      <h2 class="shrink-0 font-serif text-[clamp(21px,2.5vw,27px)] font-semibold tracking-[0.08em] text-ink">{canons.title}</h2>
      <span class="h-px flex-1 bg-[linear-gradient(90deg,var(--yzj-line),transparent)]"></span>
      <span class="shrink-0 font-mono text-[11.5px] tracking-[0.16em] text-ink-3">{canons.rows.length} 藏</span>
    </div>

    <div class="reveal overflow-x-auto rounded-card border border-line bg-panel shadow-panel">
      <table class="stat-table min-w-[820px]">
        <caption class="sr-only">历代大藏经刻藏概览</caption>
        <thead>
          <tr>
            <th scope="col" class="w-20">时代</th>
            <th scope="col">藏经</th>
            <th scope="col" class="text-right">刊刻年代</th>
            <th scope="col" class="text-right">部数</th>
            <th scope="col" class="text-right">卷数</th>
            <th scope="col">特色与流布</th>
          </tr>
        </thead>
        <tbody>
          {
            canons.rows.map((canon) => (
              <tr>
                <td>
                  <span class="inline-grid min-w-10 place-items-center rounded-[5px] border border-line bg-panel-2 px-2 py-1 font-serif text-[12px] text-ink-2">
                    {canon.dynasty}
                  </span>
                </td>
                <td>
                  <strong class="font-serif text-[15.5px] font-semibold tracking-[0.04em]">{canon.name}</strong>
                </td>
                <td class="text-right font-mono text-[13px] tabular-nums text-ink-2">{canon.year}</td>
                <td class="text-right font-mono text-[13px] tabular-nums text-ink-2">{canon.parts}</td>
                <td class="text-right font-mono text-[13px] tabular-nums text-ink-2">{canon.volumes}</td>
                <td class="text-[13px] text-ink-2">{canon.feature}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-3.5 px-0.5 font-mono text-[11.5px] tracking-[0.04em] text-ink-3">
      ※ 部分藏本卷数依帙号、函次统计口径不同而有出入，「约」字表示概数。
    </p>
  </section>

  <section class="mx-auto grid max-w-[1260px] gap-6 px-4 py-14 sm:px-8 sm:py-20 lg:grid-cols-[320px_minmax(0,1fr)] lg:items-start">
    <div class="reveal">
      <DonutChart rows={distribution.rows} total={distributionTotal} />
    </div>

    <div class="reveal">
      <h2 class="mb-6 font-serif text-[clamp(21px,2.5vw,27px)] font-semibold tracking-[0.08em] text-ink">{distribution.title}</h2>
      <div class="grid gap-4">
        {
          distribution.rows.map((row) => {
            const pct = (row.value / distributionTotal) * 100;
            const color =
              row.key === 'sutra'
                ? 'var(--yzj-jade)'
                : row.key === 'shastra'
                  ? 'var(--yzj-violet)'
                  : row.key === 'vinaya'
                    ? 'var(--yzj-gold)'
                    : 'var(--yzj-cinnabar)';
            return (
              <div class="flex items-center gap-4">
                <span class="w-28 shrink-0 text-[14px] text-ink">
                  {row.name}
                  <em class="block font-mono text-[11px] text-ink-3 not-italic">{row.desc}</em>
                </span>
                <span class="bar flex-1">
                  <i style={`--w:${pct.toFixed(1)}%;background:${color}`}></i>
                </span>
                <span class="w-24 shrink-0 text-right font-mono text-[12px] tabular-nums text-ink-2">
                  {row.value} · {pct.toFixed(1)}%
                </span>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
