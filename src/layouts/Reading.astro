---
import BaseLayout from './BaseLayout.astro';

export type Crumb = { label: string; href?: string };
export type Meta = { label: string; value: string };
export type Toc = { depth: number; slug: string; text: string };
export type Page = { title: string; url: string };

interface Props {
  title: string;
  description?: string;
  /** 面包屑 */
  crumbs: Crumb[];
  /** 眉标（分类、标签） */
  eyebrow?: { label: string; href?: string }[];
  subtitle?: string;
  /** 底本繁体题名 */
  tradTitle?: string;
  /** 标签（眉标右侧） */
  tags?: string[];
  /** 著者·译者 */
  byline?: string;
  bylineLabel?: string;
  /** 提要 */
  summary?: string;
  /** meta 信息带 */
  meta?: Meta[];
  /** 篇目（构建期生成） */
  toc?: Toc[];
  /** 篇末按语 */
  footNote?: string;
  prev?: Page;
  next?: Page;
  bodyClass?: string;
}

const {
  title,
  description,
  crumbs,
  eyebrow,
  subtitle,
  tradTitle,
  tags = [],
  byline,
  bylineLabel = '著者·译者',
  summary,
  meta = [],
  toc = [],
  footNote,
  prev,
  next,
  bodyClass = '',
} = Astro.props;
---

<BaseLayout title={title} description={description ?? summary} ogType="article" bodyClass={bodyClass}>
  <article class="reading-page mx-auto max-w-[1260px] px-4 pt-8 pb-16 sm:px-8 sm:pt-10 sm:pb-24">

    <!-- ══ 上：篇首 ══ -->
    <header class="reading-head">
      <!-- 面包屑 -->
      <nav aria-label="面包屑" class="mb-3.5">
        <ol class="flex flex-wrap items-center gap-1.5 font-mono text-[11px] text-ink-3">
          {
            crumbs.map((crumb, i) => (
              <>
                {i > 0 && <li class="opacity-50" aria-hidden="true">/</li>}
                <li>
                  {crumb.href ? (
                    <a href={crumb.href} class="transition-colors hover:text-jade">
                      {crumb.label}
                    </a>
                  ) : (
                    <span class="max-w-[20rem] truncate text-ink-2" aria-current="page">
                      {crumb.label}
                    </span>
                  )}
                </li>
              </>
            ))
          }
        </ol>
      </nav>

      <!-- 眉标 -->
      {
        eyebrow && eyebrow.length > 0 && (
          <div class="mb-2.5 flex flex-wrap items-center gap-2.5">
            {eyebrow.map((item) => (
              <span class="inline-flex items-center gap-2 rounded-full border border-jade/30 bg-jade/10 px-3 py-1 font-mono text-[11.5px] tracking-[0.1em] text-jade">
                <i class="h-1.5 w-1.5 rounded-full bg-current shadow-[0_0_8px_currentColor]" />
                {item.href ? <a href={item.href}>{item.label}</a> : item.label}
              </span>
            ))}
            {tags.length > 0 && <span class="font-mono text-[11px] tracking-[0.08em] text-ink-3">{tags.join(' · ')}</span>}
          </div>
        )
      }

      <!-- 标题 -->
      <h1 class="font-serif text-[clamp(24px,4vw,38px)] leading-[1.24] font-semibold tracking-[0.05em] text-ink">
        {title}
      </h1>
      {tradTitle && <p class="mt-1.5 font-serif text-[15px] tracking-[0.08em] text-ink-3">{tradTitle}</p>}
      {subtitle && <p class="mt-2 text-[14px] text-ink-2">{subtitle}</p>}

      <!-- 著者 -->
      {
        byline && (
          <p class="mt-3 flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
            <span class="rounded-[4px] border border-gold/25 bg-gold/10 px-1.5 py-0.5 font-mono text-[9.5px] tracking-[0.16em] text-gold">
              {bylineLabel}
            </span>
            <span class="font-serif text-[14px] tracking-[0.04em] text-ink">{byline}</span>
          </p>
        )
      }

      <!-- 提要 -->
      {summary && <p class="mt-2.5 line-clamp-2 max-w-[76ch] text-[13px] leading-[1.8] text-ink-2">{summary}</p>}

      <!-- meta 信息带 + 工具条 -->
      <div class="mt-3.5 flex flex-wrap items-center gap-x-4 gap-y-2.5 border-t border-line pt-3">
        {
          meta.length > 0 && (
            <dl class="meta-row flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-[11.5px]">
              {meta.map((m) => (
                <div class="inline-flex items-baseline gap-1.5">
                  <dt class="text-ink-3">{m.label}</dt>
                  <dd class="text-ink-2">{m.value}</dd>
                </div>
              ))}
            </dl>
          )
        }

        <!-- 工具条：放大 / 缩小 / 全屏 / 链接 / 篇目 -->
        <div class="ml-auto flex items-center gap-2">
          <div class="flex items-center gap-0.5 rounded-chip border border-line bg-panel px-1 py-0.5">
            <button id="font-down" type="button" class="grid h-6 w-7 place-items-center rounded-[5px] text-[11.5px] text-ink-2 transition-colors hover:bg-panel-2 hover:text-jade" title="缩小字号" aria-label="缩小字号">A−</button>
            <button id="font-up" type="button" class="grid h-6 w-7 place-items-center rounded-[5px] text-[11.5px] text-ink-2 transition-colors hover:bg-panel-2 hover:text-jade" title="放大字号" aria-label="放大字号">A+</button>
            <span class="mx-0.5 h-3.5 w-px bg-line-2"></span>
            <button
              id="fullscreen-toggle"
              type="button"
              class="grid h-6 w-6 place-items-center rounded-[5px] text-ink-2 transition-colors hover:bg-panel-2 hover:text-jade"
              title="全屏阅读"
              aria-label="全屏阅读"
              aria-pressed="false"
            >
              <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                <path d="M2 6V2h4M14 6V2h-4M2 10v4h4M14 10v4h-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <button id="copy-link" type="button" class="grid h-6 place-items-center rounded-[5px] px-2 text-[10.5px] text-ink-2 transition-colors hover:bg-panel-2 hover:text-jade" title="复制本页链接">链接</button>
          </div>

          {
            toc.length > 0 && (
              <details class="toc-menu group relative">
                <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-chip border border-line bg-panel px-2.5 py-1.5 text-[11.5px] text-ink-2 transition-colors hover:border-line-2 hover:text-jade">
                  篇目
                  <span class="font-mono text-[10px] text-ink-3">{toc.length}</span>
                  <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" class="transition-transform duration-300 group-open:rotate-180">
                    <path d="M2 4.5 6 8.5l4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <ol class="absolute top-full left-0 z-30 mt-2 max-h-[52vh] w-[min(88vw,26rem)] overflow-y-auto rounded-card border border-line bg-bg-soft/97 p-3 shadow-panel backdrop-blur-xl">
                  {toc.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        data-toc-link
                        class:list={[
                          'block rounded-[6px] px-2.5 py-1.5 text-[13px] leading-relaxed text-ink-2 transition-colors hover:bg-panel-2 hover:text-jade',
                          h.depth === 3 && 'pl-6 text-[12.5px] text-ink-3',
                        ]}
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            )
          }
        </div>
      </div>
    </header>

    <!-- ══ 中：正文 ══ -->
    <div class="reading-body">
      <div id="article-body" class="prose-zen">
        <slot />
      </div>
    </div>

    <!-- ══ 下：篇末 ══ -->
    <footer class="reading-foot">
      {
        footNote && (
          <div class="flex gap-3.5">
            <span class="h-fit shrink-0 rounded-[5px] border border-gold/26 bg-gold/10 px-2.5 py-1 font-mono text-[10px] tracking-[0.16em] text-gold">NOTE</span>
            <p class="m-0 max-w-[72ch] text-[12px] leading-[1.9] text-ink-3">{footNote}</p>
          </div>
        )
      }

      {
        (prev || next) && (
          <nav class="mt-7 grid gap-3.5 sm:grid-cols-2" aria-label="上下篇">
            {prev && (
              <a href={prev.url} class="flex flex-col gap-2 rounded-card border border-line bg-panel px-4.5 py-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-line-2 hover:bg-panel-2">
                <span class="font-mono text-[10.5px] tracking-[0.16em] text-ink-3">← 上一篇</span>
                <span class="font-serif text-[15.5px] tracking-[0.04em] text-ink transition-colors hover:text-jade">{prev.title}</span>
              </a>
            )}
            {next && (
              <a href={next.url} class="flex flex-col gap-2 rounded-card border border-line bg-panel px-4.5 py-4 text-right transition-all duration-300 hover:-translate-y-0.5 hover:border-line-2 hover:bg-panel-2">
                <span class="font-mono text-[10.5px] tracking-[0.16em] text-ink-3">下一篇 →</span>
                <span class="font-serif text-[15.5px] tracking-[0.04em] text-ink transition-colors hover:text-jade">{next.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </footer>
  </article>

  <script>
    import '../scripts/reader.ts';
  </script>
</BaseLayout>
