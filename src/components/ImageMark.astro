---
/**
 * 含图标识：提示该篇正文内嵌有配图。
 * 形制取「画框 + 山」之意，线条极简，不夺标题之势。
 */
interface Props {
  /** 配图幅数；缺省视为 1 */
  count?: number;
  /** 图标像素尺寸 */
  size?: number;
  /** 附加类名 */
  class?: string;
}

const { count = 1, size = 13, class: className = '' } = Astro.props;
const label = count > 1 ? `正文含图 ${count} 幅` : '正文含图';
---

<span
  class={`inline-flex shrink-0 items-center gap-1 align-middle text-cinnabar ${className}`}
  title={label}
  aria-label={label}
>
  <svg viewBox="0 0 16 16" width={size} height={size} aria-hidden="true" class="shrink-0 overflow-visible">
    <rect
      x="1.4"
      y="2.6"
      width="13.2"
      height="10.8"
      rx="1.6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.15"></rect>
    <circle cx="5.5" cy="6" r="1.35" fill="currentColor"></circle>
    <path
      d="M2.2 12.2 6 8.6l2.6 2.3 2.1-1.9 3.1 3.2"
      fill="none"
      stroke="currentColor"
      stroke-width="1.15"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  {count > 1 && <span class="font-mono text-[10px] tabular-nums leading-none">{count}</span>}
</span>
