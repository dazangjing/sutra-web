---
import type { CollectionEntry } from 'astro:content';
import { u } from '../lib/url';

interface Props {
  slug: 'tripitaka' | 'chan' | 'modern';
  name: string;
  en: string;
  glyph: string;
  accent: 'jade' | 'gold' | 'violet' | 'cinnabar' | 'slate';
  desc: string;
  docs: CollectionEntry<'sutra'>[];
}

const { slug, name, en, glyph, accent, desc, docs } = Astro.props;

const accentClass = {
  jade: {
    text: 'text-jade',
    border: 'border-jade/35',
    bg: 'bg-jade/10',
    glow: 'hover:shadow-[0_0_0_1px_rgb(95_227_192/0.2),0_26px_60px_-30px_rgb(95_227_192/0.6)]',
    wash: 'from-jade/20',
    ring: 'border-jade/35',
  },
  gold: {
    text: 'text-gold',
    border: 'border-gold/35',
    bg: 'bg-gold/10',
    glow: 'hover:shadow-[0_0_0_1px_rgb(227_192_105/0.2),0_26px_60px_-30px_rgb(227_192_105/0.55)]',
    wash: 'from-gold/20',
    ring: 'border-gold/35',
  },
  violet: {
    text: 'text-violet',
    border: 'border-violet/35',
    bg: 'bg-violet/10',
    glow: 'hover:shadow-[0_0_0_1px_rgb(155_140_245/0.2),0_26px_60px_-30px_rgb(155_140_245/0.55)]',
    wash: 'from-violet/20',
    ring: 'border-violet/35',
  },
  cinnabar: {
    text: 'text-cinnabar',
    border: 'border-cinnabar/35',
    bg: 'bg-cinnabar/10',
    glow: 'hover:shadow-[0_0_0_1px_rgb(224_100_79/0.2),0_26px_60px_-30px_rgb(224_100_79/0.55)]',
    wash: 'from-cinnabar/20',
    ring: 'border-cinnabar/35',
  },
  slate: {
    text: 'text-ink-2',
    border: 'border-ink-3/45',
    bg: 'bg-ink-3/10',
    glow: 'hover:shadow-[0_0_0_1px_rgb(109_124_121/0.25),0_26px_60px_-30px_rgb(109_124_121/0.5)]',
    wash: 'from-ink-3/20',
    ring: 'border-ink-3/45',
  },
}[accent];
---

<article class:list={['reveal group relative overflow-hidden rounded-card border border-line bg-panel px-6 py-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-line-2', accentClass.glow]}>
  <div class:list={['pointer-events-none absolute inset-x-[-20%] top-0 h-[260px] bg-gradient-to-b to-transparent opacity-50 transition-opacity duration-300 group-hover:opacity-90', accentClass.wash]}></div>
  <div class:list={['pointer-events-none absolute -top-12 -right-12 h-[170px] w-[170px] rounded-full border opacity-50 transition-transform duration-500 group-hover:scale-110 group-hover:rotate-12', accentClass.ring]}></div>

  <div class="relative flex items-center justify-between">
    <span class:list={['grid h-[46px] w-[46px] place-items-center rounded-[10px] border font-serif text-[23px]', accentClass.border, accentClass.bg, accentClass.text]}>
      {glyph}
    </span>
    <span class="font-mono text-[11px] tracking-[0.14em] text-ink-3">{docs.length} 篇</span>
  </div>

  <h3 class="relative mt-4.5 mb-1 font-serif text-[26px] font-semibold tracking-[0.1em] text-ink">{name}</h3>
  <p class:list={['relative mb-3.5 font-mono text-[10.5px] tracking-[0.24em]', accentClass.text]}>{en}</p>
  <p class="relative mb-4.5 text-[13.5px] leading-[1.95] text-ink-2">{desc}</p>

  <ul class="relative mb-5 grid gap-px">
    {
      docs.slice(0, 3).map((doc) => (
        <li>
          <a href={u(`/read/${doc.id}/`)} class="flex items-baseline justify-between gap-3 border-b border-dashed border-line-2 py-2.5 text-[13.5px] text-ink-2 transition-all duration-300 hover:pl-1.5 hover:text-jade">
            <span class="truncate">{doc.data.title}</span>
            <em class="shrink-0 font-mono text-[11px] text-ink-3 not-italic">{doc.data.translator ?? doc.data.author ?? ''}</em>
          </a>
        </li>
      ))
    }
  </ul>

  <a href={u(`/categories/${slug}/`)} class:list={['relative inline-flex items-center gap-2 text-[13px] tracking-[0.08em]', accentClass.text]}>
    进入分类
    <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1"><path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </a>
</article>
