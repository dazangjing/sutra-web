---
import type { StatRow } from '../data/tripitaka';

interface Props {
  rows: StatRow[];
  totalParts: number;
  totalVolumes: number;
  showAverage?: boolean;
  class?: string;
}

const { rows, totalParts, totalVolumes, showAverage = false, class: className = '' } = Astro.props;
const max = Math.max(...rows.map((r) => r.volumes));

const tagClass: Record<StatRow['tag'], string> = {
  经: 'text-jade bg-jade/10 border-jade/30',
  论: 'text-violet bg-violet/10 border-violet/30',
  律: 'text-gold bg-gold/10 border-gold/30',
  杂: 'text-cinnabar bg-cinnabar/10 border-cinnabar/30',
};
---

<div class={`overflow-x-auto rounded-card border border-line bg-panel shadow-panel ${className}`}>
  <table class="stat-table min-w-[620px]">
    <caption class="sr-only">大藏经部卷分类统计</caption>
    <thead>
      <tr>
        <th scope="col" class="w-16">类别</th>
        <th scope="col">分部</th>
        <th scope="col" class="text-right">部数</th>
        <th scope="col" class="text-right">卷数</th>
        {showAverage && <th scope="col" class="text-right">均卷/部</th>}
        <th scope="col" class="w-[34%]">卷数占比</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => {
          const pct = (row.volumes / totalVolumes) * 100;
          const width = (row.volumes / max) * 100;
          return (
            <tr>
              <td>
                <span class:list={['inline-grid h-7 min-w-7 place-items-center rounded-[6px] border px-2 font-serif text-[13px] font-semibold', tagClass[row.tag]]}>
                  {row.tag}
                </span>
              </td>
              <td>
                <strong class="block font-serif text-[15.5px] font-semibold tracking-[0.04em] transition-colors">{row.name}</strong>
                <em class="mt-0.5 block text-[11.5px] text-ink-3 not-italic">{row.scope}</em>
              </td>
              <td class="text-right font-mono text-[15px] tabular-nums">{row.parts}</td>
              <td class="text-right font-mono text-[15px] tabular-nums">{row.volumes}</td>
              {showAverage && (
                <td class="text-right font-mono text-[13px] tabular-nums text-ink-2">{(row.volumes / row.parts).toFixed(2)}</td>
              )}
              <td>
                <span class="flex items-center gap-3">
                  <span class="bar min-w-24 flex-1">
                    <i style={`--w:${width.toFixed(1)}%`}></i>
                  </span>
                  <span class="w-14 shrink-0 text-right font-mono text-[11.5px] tabular-nums text-ink-3">{pct.toFixed(1)}%</span>
                </span>
              </td>
            </tr>
          );
        })
      }
    </tbody>
    <tfoot>
      <tr>
        <td></td>
        <td>
          <strong class="block font-serif text-[15.5px] font-semibold tracking-[0.04em] text-jade">合计</strong>
          <em class="mt-0.5 block text-[11.5px] text-ink-3 not-italic">大藏经主体全部分类</em>
        </td>
        <td class="text-right font-mono text-[15px] font-medium tabular-nums">{totalParts}</td>
        <td class="text-right font-mono text-[15px] font-medium tabular-nums">{totalVolumes}</td>
        {showAverage && <td class="text-right font-mono text-[13px] tabular-nums text-ink-2">{(totalVolumes / totalParts).toFixed(2)}</td>}
        <td>
          <span class="flex items-center gap-3">
            <span class="bar min-w-24 flex-1">
              <i style="--w:100%;background:linear-gradient(90deg,var(--yzj-gold-2),var(--yzj-gold));box-shadow:0 0 12px -2px rgb(227 192 105 / 0.7)"></i>
            </span>
            <span class="w-14 shrink-0 text-right font-mono text-[11.5px] tabular-nums text-ink-3">100%</span>
          </span>
        </td>
      </tr>
    </tfoot>
  </table>
</div>
