---
import type { CollectionEntry } from 'astro:content';
import { u } from '../lib/url';

interface Props {
  doc: CollectionEntry<'sutra'>;
  index?: number;
  showCategory?: boolean;
  /** 检索用：分类标识 */
  filterCategory?: string;
  /** 检索用：可被检索的文本 */
  filterText?: string;
}

const { doc, index, showCategory = false, filterCategory, filterText } = Astro.props;
const { data } = doc;
const byline = data.translator ?? data.author ?? '';
---

<li
  class:list={['reveal flex', filterCategory && 'browse-item']}
  data-category={filterCategory}
  data-search={filterText}
>
  <a
    href={u(`/read/${doc.id}/`)}
    class="group relative flex w-full items-start gap-4 overflow-hidden rounded-card border border-line bg-panel px-5 py-5 transition-all duration-300 hover:-translate-y-[3px] hover:border-line-2 hover:bg-panel-2 hover:shadow-panel"
  >
    <span class="absolute inset-y-0 left-0 w-[2px] origin-top scale-y-0 bg-[linear-gradient(var(--yzj-jade),transparent)] transition-transform duration-300 group-hover:scale-y-100"></span>

    {
      index !== undefined && (
        <span class="shrink-0 pt-0.5 font-mono text-[11.5px] tabular-nums text-ink-3">{String(index).padStart(3, '0')}</span>
      )
    }

    <span class="flex min-w-0 flex-1 flex-col gap-1.5">
      <span class="font-serif text-[17px] font-semibold tracking-[0.05em] text-ink transition-colors group-hover:text-jade">
        {data.title}
      </span>

      <span class="font-mono text-[11.5px] text-ink-3">
        {byline}
        {data.dynasty && ` · ${data.dynasty}`}
      </span>

      {data.summary && (
        <span class="line-clamp-2 text-[13px] leading-relaxed text-ink-2">{data.summary}</span>
      )}

      <span class="mt-0.5 flex flex-wrap gap-1.5">
        {
          showCategory && (
            <i class:list={[
              'rounded-[5px] border px-1.5 py-0.5 font-mono text-[10.5px] not-italic',
              data.category === 'tripitaka' && 'border-jade/30 bg-jade/10 text-jade',
              data.category === 'chan' && 'border-gold/30 bg-gold/10 text-gold',
              data.category === 'modern' && 'border-violet/30 bg-violet/10 text-violet',
            ]}>
              {data.category_name}
            </i>
          )
        }
        {data.canon && <i class="rounded-[5px] border border-line-2 bg-panel-2 px-1.5 py-0.5 font-mono text-[10.5px] text-ink-3 not-italic">{data.canon}</i>}
        {data.length && <i class="rounded-[5px] border border-line-2 bg-panel-2 px-1.5 py-0.5 font-mono text-[10.5px] text-ink-3 not-italic">{data.length}</i>}
      </span>
    </span>

    <span class="mt-1 h-5 w-5 shrink-0 self-center text-ink-3 transition-all duration-300 group-hover:translate-x-1 group-hover:text-jade">
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </span>
  </a>
</li>
