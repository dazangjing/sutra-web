---
/**
 * 藏经来源脉络
 *
 * 谱系（承袭／底本、增补与汇入）依 CBETA 各藏实际编纂关系整理，
 * 与 ../sutra_md_zh/藏经来源脉络.md 之 mermaid 图、SVG 同源；
 * 分布（档数／卷数／字数）自本库语料实算 —— 数据见 src/data/canon-lineage.ts。
 *
 * 版式：八列自左而右即承袭次第（列内各藏并列）。
 *   实线＝文本承袭／底本来源　　虚线＝增补与汇入
 */
import {
  canonLineage,
  lineageColumns,
  lineageEdges,
  lineageMergeEdges,
  lineageTotals,
} from '../data/canon-lineage';
import { u } from '../lib/url';

const byCode = new Map(canonLineage.map((n) => [n.code, n]));

/* 榜眼：藏量最多者 */
const topCode = canonLineage.reduce((a, b) => (b.works > a.works ? b : a), canonLineage[0]).code;

/* 明细表：按档数降序 */
const tableRows = [...canonLineage].sort((a, b) => b.works - a.works);
const maxWorks = Math.max(...tableRows.map((r) => r.works));

/* ── 版面常量 ─────────────────────────────────── */
const NODE_W = 156;
const NODE_H = 54;
const COL_GAP = 54;
const ROW_H = 66;
const PAD = 16;

/* 节点按列定位：列内自上而下均匀排布 */
type Slot = { code: string; x: number; y: number };
const slots = new Map<string, Slot>();

let maxRows = 0;
lineageColumns.forEach((col, ci) => {
  maxRows = Math.max(maxRows, col.nodes.length);
});

/* 各列居中于画布高度 */
const totalH = PAD * 2 + (maxRows - 1) * ROW_H + NODE_H;
lineageColumns.forEach((col, ci) => {
  const colH = (col.nodes.length - 1) * ROW_H + NODE_H;
  const top = PAD + (totalH - PAD * 2 - colH) / 2;
  col.nodes.forEach((code, ri) => {
    slots.set(code, {
      code,
      x: PAD + ci * (NODE_W + COL_GAP),
      y: top + ri * ROW_H,
    });
  });
});

const SVG_W = PAD * 2 + lineageColumns.length * NODE_W + (lineageColumns.length - 1) * COL_GAP;
const SVG_H = totalH;

/* ── 连线 ───────────────────────────────────────
 * 源节点右缘 → 目标节点左缘，走「源右 → 垂直中折 → 目标左」的正交折线。
 * 中折点取两节点 y 的中点，故不横穿任何节点框。
 */
type Edge = { d: string; dash: boolean; hot: boolean };
const edges: Edge[] = [];

function edgePath(fromCode: string, toCode: string): string | null {
  const a = slots.get(fromCode);
  const b = slots.get(toCode);
  if (!a || !b) return null;
  const x1 = a.x + NODE_W;
  const y1 = a.y + NODE_H / 2;
  const x2 = b.x;
  const y2 = b.y + NODE_H / 2;
  if (x2 <= x1) return null;
  const midX = x1 + (x2 - x1) / 2;
  return `M ${x1} ${y1} L ${midX} ${y1} L ${midX} ${y2} L ${x2} ${y2}`;
}

for (const e of lineageEdges) {
  const d = edgePath(e.from, e.to);
  if (d) edges.push({ d, dash: false, hot: e.from === 'T' || e.to === 'T' });
}
for (const e of lineageMergeEdges) {
  const d = edgePath(e.from, e.to);
  if (d) edges.push({ d, dash: true, hot: false });
}
---

<section id="lineage" class="mx-auto max-w-[1260px] px-4 py-14 sm:px-8 sm:py-20">
  <div class="reveal mb-8.5 flex items-center gap-4">
    <h2 class="shrink-0 font-serif text-[clamp(21px,2.5vw,27px)] font-semibold tracking-[0.08em] text-ink">藏经来源脉络</h2>
    <span class="h-px flex-1 bg-[linear-gradient(90deg,var(--yzj-line),transparent)]"></span>
    <span class="shrink-0 font-mono text-[11.5px] tracking-[0.16em] text-ink-3">
      {canonLineage.length} 藏 · {lineageTotals.works.toLocaleString('en-US')} 档
    </span>
  </div>

  <!-- ══ 脉络图 ══ -->
  <figure class="reveal overflow-hidden rounded-card border border-line bg-panel shadow-panel">
    <figcaption class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-line px-5 py-3">
      <span class="font-mono text-[10.5px] tracking-[0.22em] text-ink-3">CANON LINEAGE</span>
      <span class="h-px flex-1 bg-line-2"></span>
      <span class="flex items-center gap-1.5 font-mono text-[10.5px] text-ink-3">
        <svg width="22" height="8" aria-hidden="true"><path d="M1 4 H21" stroke="currentColor" stroke-width="1.2" fill="none" /></svg>
        承袭／底本
      </span>
      <span class="flex items-center gap-1.5 font-mono text-[10.5px] text-ink-3">
        <svg width="22" height="8" aria-hidden="true"><path d="M1 4 H21" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 3" fill="none" /></svg>
        增补／汇入
      </span>
    </figcaption>

    <div class="overflow-x-auto px-4 py-5">
      <svg
        viewBox={`0 0 ${SVG_W} ${SVG_H}`}
        width={SVG_W}
        height={SVG_H}
        role="img"
        aria-label="藏经来源脉络图"
        class="block shrink-0"
        style={`width:${SVG_W}px;height:${SVG_H}px`}
      >
        <defs>
          <linearGradient id="ln-solid" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-opacity="0.3" style="stop-color:var(--yzj-jade-2)"></stop>
            <stop offset="1" stop-opacity="0.72" style="stop-color:var(--yzj-jade)"></stop>
          </linearGradient>
          <linearGradient id="ln-dash" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-opacity="0.18" style="stop-color:var(--yzj-ink-3)"></stop>
            <stop offset="1" stop-opacity="0.45" style="stop-color:var(--yzj-ink-3)"></stop>
          </linearGradient>
        </defs>

        {/* 连线 */}
        <g fill="none" stroke-width="1.15" stroke-linejoin="round">
          {
            edges.map((e) => (
              <path
                d={e.d}
                stroke={e.dash ? 'url(#ln-dash)' : e.hot ? 'var(--yzj-gold)' : 'url(#ln-solid)'}
                stroke-dasharray={e.dash ? '4 4' : undefined}
                stroke-opacity={e.dash ? 1 : e.hot ? 0.5 : 1}
              />
            ))
          }
        </g>

        {/* 节点 */}
        {
          [...slots.values()].map((s) => {
            const n = byCode.get(s.code);
            if (!n) return null;
            const hot = s.code === topCode;
            const dim = n.works === 0;
            return (
              <g transform={`translate(${s.x},${s.y})`}>
                <rect
                  width={NODE_W}
                  height={NODE_H}
                  rx="6"
                  style={`fill:${hot ? 'rgb(227 192 105 / 0.08)' : 'rgb(255 255 255 / 0.03)'};stroke:${
                    hot ? 'var(--yzj-gold)' : 'var(--yzj-jade)'
                  };stroke-opacity:${dim ? 0.22 : hot ? 0.6 : 0.34};stroke-width:${hot ? 1.2 : 1}`}
                />
                <text
                  x="10"
                  y="20"
                  font-size="12"
                  letter-spacing="1"
                  style={`fill:${hot ? 'var(--yzj-gold)' : 'var(--yzj-jade)'};font-family:var(--font-mono);opacity:${
                    dim ? 0.5 : 1
                  }`}
                >
                  {n.code}
                </text>
                <text
                  x={NODE_W - 10}
                  y="20"
                  text-anchor="end"
                  font-size="10"
                  style="fill:var(--yzj-ink-3);font-family:var(--font-mono)"
                >
                  {n.era}
                </text>
                <text
                  x="10"
                  y="37"
                  font-size="13"
                  style={`fill:var(--yzj-ink);font-family:var(--font-serif);opacity:${dim ? 0.55 : 1}`}
                >
                  {n.name.length > 10 ? `${n.name.slice(0, 10)}…` : n.name}
                </text>
                <text
                  x="10"
                  y="49"
                  font-size="9.5"
                  style="fill:var(--yzj-ink-3);font-family:var(--font-mono)"
                >
                  {dim ? '本站未收' : `${n.works.toLocaleString('en-US')} 档 / ${n.juan.toLocaleString('en-US')} 卷`}
                </text>
                <title>{`${n.name}（${n.code}）｜${n.era}｜${n.kind}｜${n.base}`}</title>
              </g>
            );
          })
        }
      </svg>
    </div>

    <!-- 列题 -->
    <div class="overflow-x-auto border-t border-line px-4 py-3">
      <div class="flex min-w-max" style={`width:${SVG_W}px`}>
        {
          lineageColumns.map((col) => (
            <div class="shrink-0 px-1" style={`width:${NODE_W + COL_GAP}px`}>
              <p class="font-mono text-[10.5px] tracking-[0.14em] text-jade">{col.label}</p>
              <p class="mt-0.5 text-[11px] leading-snug text-ink-3">{col.note}</p>
            </div>
          ))
        }
      </div>
    </div>

    <p class="border-t border-line px-5 py-3 font-mono text-[11px] leading-relaxed tracking-[0.03em] text-ink-3">
      ※ 谱系依 CBETA 各藏实际编纂关系整理（承袭／底本），与《藏经来源脉络》一图同源；
      框内档数、卷数为本站语料实算。标「本站未收」者，为整部文集逾本站 150 KB 单档上限（印顺、太虚、吕澂诸集即属此例）。
      图可横向拖动。
    </p>
  </figure>

  <!-- ══ 各藏明细 ══ -->
  <div class="reveal mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
    <div class="rounded-card border border-line bg-panel shadow-panel">
      <div class="flex items-center gap-3 border-b border-line px-5 py-3">
        <span class="font-mono text-[10.5px] tracking-[0.22em] text-ink-3">SOURCES</span>
        <span class="h-px flex-1 bg-line-2"></span>
        <span class="font-mono text-[10.5px] text-ink-3">按本库收录档数</span>
      </div>
      <ul class="grid gap-x-8 px-5 py-3 sm:grid-cols-2 xl:grid-cols-3">
        {
          tableRows.map((n) => (
            <li class="border-b border-dashed border-line-2 py-2">
              <div class="grid grid-cols-[40px_1fr_auto] items-baseline gap-2.5">
                <span
                  class="rounded-[4px] border px-1 py-0.5 text-center font-mono text-[11px]"
                  style={
                    n.works === 0
                      ? 'border-color:rgb(125 226 199 / 0.14);color:var(--yzj-ink-3)'
                      : 'border-color:rgb(125 226 199 / 0.3);color:var(--yzj-jade);background:rgb(125 226 199 / 0.08)'
                  }
                >
                  {n.code}
                </span>
                <span class="min-w-0">
                  <span class="block truncate text-[13px] text-ink-2">{n.name}</span>
                  <span class="block font-mono text-[10px] tracking-[0.06em] text-ink-3">
                    {n.era} · {n.kind}
                  </span>
                </span>
                <span class="text-right font-mono text-[12px] tabular-nums">
                  <span class="text-ink">{n.works.toLocaleString('en-US')}</span>
                  <span class="ml-1 text-[10px] text-ink-3">档</span>
                </span>
              </div>
              <span class="bar mt-1.5 ml-[50px] block">
                <i style={`--w:${((n.works / maxWorks) * 100).toFixed(2)}%`}></i>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="flex flex-col gap-5">
      <div class="rounded-card border border-line bg-panel p-5 shadow-panel">
        <p class="mb-3.5 font-mono text-[10.5px] tracking-[0.22em] text-ink-3">FOOTPRINT</p>
        <dl class="grid grid-cols-3 gap-3 text-center">
          {
            [
              { k: '藏经', v: `${canonLineage.length}` },
              { k: '档', v: lineageTotals.works.toLocaleString('en-US') },
              { k: '卷', v: lineageTotals.juan.toLocaleString('en-US') },
            ].map((x) => (
              <div>
                <dt class="font-mono text-[10px] tracking-[0.14em] text-ink-3">{x.k}</dt>
                <dd class="mt-1 font-mono text-[17px] tabular-nums text-ink">{x.v}</dd>
              </div>
            ))
          }
        </dl>
        <a
          href={u('/stats/')}
          class="mt-4 block font-mono text-[11.5px] tracking-[0.1em] text-jade hover:underline"
        >
          查看藏经来源统计与刻藏概览 →
        </a>
      </div>

      <div class="rounded-card border border-line bg-panel p-5 shadow-panel">
        <p class="mb-3 font-mono text-[10.5px] tracking-[0.22em] text-ink-3">READING ORDER</p>
        <ol class="space-y-2 font-mono text-[11.5px] leading-relaxed tracking-[0.03em] text-ink-2">
          {
            lineageColumns.map((col) => (
              <li>
                <span class="text-jade">{col.label}</span>
                <span class="text-ink-3"> · </span>
                {col.note}
              </li>
            ))
          }
        </ol>
      </div>
    </aside>
  </div>
</section>
