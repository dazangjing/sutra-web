---
/**
 * 藏经来源脉络
 *
 * 谱系（藏名、时期、类别、底本）依 CBETA 各藏实际编纂关系整理，
 * 分布（档数／卷数／字数）自本库语料实算 —— 数据见 src/data/canon-lineage.ts。
 *
 * 图以年代先后自左而右排布：写本（敦煌·房山·高丽·赵城·南藏·北藏）
 * → 刻本（嘉兴·乾隆）→ 铅印缩印（频伽·卍正·大日本续藏）
 * → 汇刻诸藏（大正·卍新纂）→ 增补与释文（补编·藏外·中华）
 * → 民国专集与近现代整理 → CBETA 数字汇流。
 */
import { canonLineage, lineageEdges, lineageColumns, lineageTotals } from '../data/canon-lineage';
import { u } from '../lib/url';

/* ── 版面常量 ─────────────────────────────────── */
const NODE_W = 148;
const NODE_H = 56;
const GAP_X = 46;
const GAP_Y = 16;
const PAD = 18;

const byCode = new Map(canonLineage.map((n) => [n.code, n]));

/* 节点坐标：按列排布，列内垂直居中 */
const maxColH = Math.max(
  ...lineageColumns.map((col) => col.length * NODE_H + (col.length - 1) * GAP_Y),
);

const positions = new Map<string, { x: number; y: number }>();
lineageColumns.forEach((col, ci) => {
  const x = PAD + ci * (NODE_W + GAP_X);
  const colH = col.length * NODE_H + (col.length - 1) * GAP_Y;
  col.forEach((code, ri) => {
    positions.set(code, { x, y: PAD + ri * (NODE_H + GAP_Y) + (maxColH - colH) / 2 });
  });
});

const SVG_W = PAD * 2 + lineageColumns.length * NODE_W + (lineageColumns.length - 1) * GAP_X;
const SVG_H = PAD * 2 + maxColH;

/* ── 连线：贝塞尔曲线，由源节点右缘至目标节点左缘 ─── */
type Edge = { d: string; mid: { x: number; y: number }; hot: boolean };
const edges: Edge[] = [];

for (const e of lineageEdges) {
  const a = positions.get(e.from);
  const b = positions.get(e.to);
  if (!a || !b) continue;
  const x1 = a.x + NODE_W;
  const y1 = a.y + NODE_H / 2;
  const x2 = b.x;
  const y2 = b.y + NODE_H / 2;
  const dx = Math.max(28, (x2 - x1) * 0.55);
  edges.push({
    d: `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`,
    mid: { x: (x1 + x2) / 2, y: (y1 + y2) / 2 },
    hot: e.from === 'T' || e.to === 'T',
  });
}

/* ── 榜眼：藏量最多者 ─── */
const topCode = canonLineage.reduce((a, b) => (b.works > a.works ? b : a), canonLineage[0]).code;

/* 汇流终点：CBETA 数字库与本站阅读版，本身非「藏」 */
const TERMINALS = new Set(['CB', 'M2']);

/* ── 明细表：按档数降序（汇流终点不入表） ─── */
const tableRows = canonLineage
  .filter((n) => !TERMINALS.has(n.code))
  .sort((a, b) => b.works - a.works);
const maxWorks = Math.max(...tableRows.map((r) => r.works));
---

<section id="lineage" class="mx-auto max-w-[1260px] px-4 py-14 sm:px-8 sm:py-20">
  <div class="reveal mb-8.5 flex items-center gap-4">
    <h2 class="shrink-0 font-serif text-[clamp(21px,2.5vw,27px)] font-semibold tracking-[0.08em] text-ink">藏经来源脉络</h2>
    <span  style="class:h-px flex-1 bg-[linear-gradient(90deg,var(--yzj-line),transparent)]"></span>
    <span class="shrink-0 font-mono text-[11.5px] tracking-[0.16em] text-ink-3">
      {lineageTotals.sources} 藏 · {lineageTotals.works.toLocaleString('en-US')} 档
    </span>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start">
    <!-- ══ 脉络图 ══ -->
    <figure class="reveal overflow-hidden rounded-card border border-line bg-panel shadow-panel">
      <figcaption class="flex items-center gap-3 border-b border-line px-5 py-3">
        <span class="font-mono text-[10.5px] tracking-[0.22em] text-ink-3">CANON LINEAGE</span>
        <span class="h-px flex-1 bg-line-2"></span>
        <span class="font-mono text-[10.5px] tracking-[0.1em] text-ink-3">自左而右 · 承袭流变</span>
      </figcaption>

      <div class="overflow-x-auto px-4 py-4">
        <svg
          viewBox={`0 0 ${SVG_W} ${SVG_H}`}
          width={SVG_W}
          height={SVG_H}
          role="img"
          aria-label="藏经来源脉络图"
          class="h-auto w-full min-w-[920px]"
        >
          <defs>
            <linearGradient id="ln-edge" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-opacity="0.18" style="stop-color:var(--yzj-jade-2)"></stop>
              <stop offset="1" stop-opacity="0.5" style="stop-color:var(--yzj-jade-2)"></stop>
            </linearGradient>
            <linearGradient id="ln-edge-hot" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-opacity="0.3" style="stop-color:var(--yzj-gold-2)"></stop>
              <stop offset="1" stop-opacity="0.75" style="stop-color:var(--yzj-gold)"></stop>
            </linearGradient>
          </defs>

          {/* 连线 */}
          <g fill="none" stroke-width="1.1">
            {
              edges.map((e) => (
                <path d={e.d} stroke={e.hot ? 'url(#ln-edge-hot)' : 'url(#ln-edge)'} />
              ))
            }
          </g>

          {/* 节点 */}
          {
            [...positions.entries()].map(([code, pos]) => {
              const n = byCode.get(code);
              if (!n) return null;
              const terminal = TERMINALS.has(code);
              const dim = n.works === 0 && !terminal;
              const hot = code === topCode;
              const sub = terminal
                ? code === 'CB'
                  ? '各藏数字汇流'
                  : '本站阅读版'
                : dim
                  ? '本站未收'
                  : `${n.works.toLocaleString('en-US')} 档 · ${n.juan.toLocaleString('en-US')} 卷`;
              return (
                <g transform={`translate(${pos.x},${pos.y})`}>
                  <rect
                    width={NODE_W}
                    height={NODE_H}
                    rx="6"
                    fill={hot ? 'rgb(227 192 105 / 0.07)' : 'rgb(255 255 255 / 0.025)'}
                    stroke={hot ? 'var(--yzj-gold)' : terminal ? 'var(--yzj-gold-2)' : 'var(--yzj-jade)'}
                    stroke-opacity={dim ? 0.18 : hot ? 0.6 : terminal ? 0.55 : 0.3}
                    stroke-width={hot ? 1.2 : 1}
                  />
                  <text x="11" y="21" font-size="12.5" letter-spacing="1.2" style="font-family:var(--font-mono)">
                    {n.code}
                  </text>
                  <text y="21" text-anchor="end" font-size="10" style="fill:var(--yzj-ink-3);font-family:var(--font-mono)">
                    {n.era}
                  </text>
                  <text x="11" y="38" font-size="13" style="fill:var(--yzj-ink);font-family:var(--font-serif)">
                    {n.name.length > 9 ? `${n.name.slice(0, 9)}…` : n.name}
                  </text>
                  <text x="11" y="50" font-size="9.5" letter-spacing="0.4" style="fill:var(--yzj-ink-3);font-family:var(--font-mono)">
                    {sub}
                  </text>
                  <title>{`${n.name}（${n.code}）｜${n.era}｜${n.kind}｜${n.base}`}</title>
                </g>
              );
            })
          }
        </svg>
      </div>

      <p class="border-t border-line px-5 py-3 font-mono text-[11px] leading-relaxed tracking-[0.03em] text-ink-3">
        ※ 谱系依 CBETA 各藏实际编纂关系整理（承袭／底本）；各藏档数、卷数自本站语料实算，
        暗色节点为本库体量上限内未收之藏。
      </p>
    </figure>

    <!-- ══ 各藏明细 ══ -->
    <aside class="reveal flex flex-col gap-5">
      <div class="rounded-card border border-line bg-panel shadow-panel">
        <div class="flex items-center gap-3 border-b border-line px-5 py-3">
          <span class="font-mono text-[10.5px] tracking-[0.22em] text-ink-3">SOURCES</span>
          <span class="h-px flex-1 bg-line-2"></span>
          <span class="font-mono text-[10.5px] text-ink-3">档数</span>
        </div>
        <ul class="max-h-[420px] overflow-y-auto px-5 py-3">
          {
            tableRows.map((n) => (
              <li class="group border-b border-dashed border-line-2 py-2 last:border-b-0">
                <div class="grid grid-cols-[38px_1fr_auto] items-baseline gap-2.5">
                  <span
                    class="rounded-[4px] border px-1 py-0.5 text-center font-mono text-[11px]"
                    style={
                      n.works === 0
                        ? 'border-color:rgb(125 226 199 / 0.14);color:var(--yzj-ink-3)'
                        : 'border-color:rgb(125 226 199 / 0.3);color:var(--yzj-jade);background:rgb(125 226 199 / 0.08)'
                    }
                  >
                    {n.code}
                  </span>
                  <span class="min-w-0">
                    <span class="block truncate text-[13px] text-ink-2">{n.name}</span>
                    <span class="block font-mono text-[10px] tracking-[0.06em] text-ink-3">
                      {n.era} · {n.kind}
                    </span>
                  </span>
                  <span class="text-right font-mono text-[12px] tabular-nums">
                    <span class="text-ink">{n.works.toLocaleString('en-US')}</span>
                    <span class="ml-1.5 text-[10px] text-ink-3">档</span>
                  </span>
                </div>
                <span class="bar mt-1.5 ml-[46px] block">
                  <i style={`--w:${((n.works / maxWorks) * 100).toFixed(2)}%`}></i>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-card border border-line bg-panel p-5 shadow-panel">
        <p class="mb-3.5 font-mono text-[10.5px] tracking-[0.22em] text-ink-3">FOOTPRINT</p>
        <dl class="grid grid-cols-3 gap-3 text-center">
          {
            [
              { k: '藏经', v: `${lineageTotals.sources}` },
              { k: '档', v: lineageTotals.works.toLocaleString('en-US') },
              { k: '卷', v: lineageTotals.juan.toLocaleString('en-US') },
            ].map((x) => (
              <div>
                <dt class="font-mono text-[10px] tracking-[0.14em] text-ink-3">{x.k}</dt>
                <dd class="mt-1 font-mono text-[17px] tabular-nums text-ink">{x.v}</dd>
              </div>
            ))
          }
        </dl>
        <a
          href={u('/stats/')}
          class="mt-4 block font-mono text-[11.5px] tracking-[0.1em] text-jade hover:underline"
        >
          查看藏经来源统计与刻藏概览 →
        </a>
      </div>
    </aside>
  </div>
</section>
