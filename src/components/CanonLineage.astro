---
/**
 * 藏经来源脉络
 *
 * 谱系（藏名、时期、类别、底本）依 CBETA 各藏实际编纂关系整理，
 * 分布（档数／卷数／字数）自本库语料实算 —— 数据见 src/data/canon-lineage.ts。
 *
 * 版式：逐代横向铺开，每代一「列」，列内各藏自上而下并列，
 * 代与代之间以承袭关系标注（「承 X·Y」）。如此无交叉连线，
 * 脉络可读而图面不乱。
 */
import { canonLineage, lineageTiers, lineageSink, lineageSite, lineageTotals } from '../data/canon-lineage';
import { u } from '../lib/url';

const byCode = new Map(canonLineage.map((n) => [n.code, n]));

/* 汇流终点：CBETA 数字库与本站阅读版，本身非「藏」 */
const TERMINALS = new Set([lineageSink.code, lineageSite.code]);

/* 榜眼：藏量最多者 */
const topCode = canonLineage.reduce((a, b) => (b.works > a.works ? b : a), canonLineage[0]).code;

/* 明细表：按档数降序（汇流终点不入表） */
const tableRows = canonLineage
  .filter((n) => !TERMINALS.has(n.code))
  .sort((a, b) => b.works - a.works);
const maxWorks = Math.max(...tableRows.map((r) => r.works));

/* 各代之内按收录档数降序，主体在前 */
const tiers = lineageTiers.map((tier) => ({
  ...tier,
  items: tier.nodes
    .map((code) => ({ code, node: byCode.get(code)! }))
    .sort((a, b) => (b.node?.works ?? 0) - (a.node?.works ?? 0)),
}));

/* 各代承袭自何代（用于代题下方的说明） */
const tierFrom = new Map<number, string[]>();
for (const tier of lineageTiers) {
  const src = new Set<string>();
  for (const code of tier.nodes) {
    for (const p of tier.parents[code] ?? []) src.add(p);
  }
  tierFrom.set(tier.tier, [...src]);
}
const nameOf = (code: string) => byCode.get(code)?.name ?? code;
---

<section id="lineage" class="mx-auto max-w-[1260px] px-4 py-14 sm:px-8 sm:py-20">
  <div class="reveal mb-8.5 flex items-center gap-4">
    <h2 class="shrink-0 font-serif text-[clamp(21px,2.5vw,27px)] font-semibold tracking-[0.08em] text-ink">藏经来源脉络</h2>
    <span class="h-px flex-1 bg-[linear-gradient(90deg,var(--yzj-line),transparent)]"></span>
    <span class="shrink-0 font-mono text-[11.5px] tracking-[0.16em] text-ink-3">
      {lineageTotals.sources} 藏 · {lineageTotals.works.toLocaleString('en-US')} 档
    </span>
  </div>

  <!-- ══ 脉络：逐代铺陈 ══ -->
  <figure class="reveal overflow-hidden rounded-card border border-line bg-panel shadow-panel">
    <figcaption class="flex items-center gap-3 border-b border-line px-5 py-3">
      <span class="font-mono text-[10.5px] tracking-[0.22em] text-ink-3">CANON LINEAGE</span>
      <span class="h-px flex-1 bg-line-2"></span>
      <span class="font-mono text-[10.5px] tracking-[0.1em] text-ink-3">自左而右 · 逐代承袭</span>
    </figcaption>

    <div class="overflow-x-auto px-5 py-6">
      <div class="flex min-w-max items-stretch gap-0">
        {
          tiers.map((tier, ti) => (
            <div class="flex items-stretch">
              {/* 代 */}
              <div class="flex w-[218px] flex-col px-2">
                <div class="mb-3 border-b border-line pb-2">
                  <p class="font-mono text-[10.5px] tracking-[0.16em] text-jade">{tier.label}</p>
                  <p class="mt-1 text-[12px] leading-snug text-ink-2">{tier.note}</p>
                  {ti > 0 && tierFrom.get(tier.tier)?.length ? (
                    <p class="mt-1.5 font-mono text-[10px] leading-relaxed tracking-[0.02em] text-ink-3">
                      承自 {tierFrom.get(tier.tier)!.map((c) => `${c}·${nameOf(c)}`).join('　')}
                    </p>
                  ) : null}
                </div>

                <ul class="flex flex-1 flex-col gap-2.5">
                  {tier.items.map(({ code, node }) => {
                    const dim = !node || node.works === 0;
                    const hot = code === topCode;
                    return (
                      <li>
                        <div
                          class="rounded-card border px-3 py-2.5 transition-all duration-300 hover:-translate-y-0.5"
                          style={`border-color:${
                            hot
                              ? 'rgb(227 192 105 / 0.55)'
                              : dim
                                ? 'rgb(125 226 199 / 0.14)'
                                : 'rgb(125 226 199 / 0.3)'
                          };background:${hot ? 'rgb(227 192 105 / 0.07)' : 'rgb(255 255 255 / 0.025)'};opacity:${
                            dim ? 0.62 : 1
                          }`}
                        >
                          <div class="flex items-baseline gap-2">
                            <span
                              class="shrink-0 rounded-[4px] border px-1.5 py-0.5 font-mono text-[11px]"
                              style={`border-color:${
                                hot
                                  ? 'rgb(227 192 105 / 0.6)'
                                  : dim
                                    ? 'rgb(125 226 199 / 0.2)'
                                    : 'rgb(125 226 199 / 0.4)'
                              };color:${
                                hot ? 'var(--yzj-gold)' : dim ? 'var(--yzj-ink-3)' : 'var(--yzj-jade)'
                              }`}
                            >
                              {code}
                            </span>
                            <span class="min-w-0 flex-1 truncate font-serif text-[13.5px] text-ink">
                              {node?.name ?? code}
                            </span>
                          </div>
                          <div class="mt-1.5 flex items-baseline justify-between gap-2 font-mono text-[10px] tracking-[0.04em] text-ink-3">
                            <span class="truncate">
                              {node?.era ?? ''} · {node?.kind ?? ''}
                            </span>
                            <span class="shrink-0 tabular-nums">
                              {dim ? '逾体量上限' : `${node!.works.toLocaleString('en-US')} 档`}
                            </span>
                          </div>
                          {/* 体量条 */}
                          <span class="bar mt-2 block">
                            <i
                              style={`--w:${((node?.works ?? 0) / maxWorks * 100).toFixed(2)}%;${
                                hot
                                  ? 'background:linear-gradient(90deg,var(--yzj-gold-2),var(--yzj-gold))'
                                  : ''
                              }`}
                            ></i>
                          </span>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </div>

              {/* 代间承袭标记 */}
              {ti < tiers.length - 1 ? (
                <div class="flex w-11 shrink-0 items-center justify-center">
                  <svg width="30" height="44" viewBox="0 0 30 44" aria-hidden="true" class="overflow-visible">
                    <path
                      d="M 3 22 L 24 22"
                      fill="none"
                      stroke="var(--yzj-jade)"
                      stroke-opacity="0.5"
                      stroke-width="1.3"
                    ></path>
                    <path
                      d="M 16 14 L 25 22 L 16 30"
                      fill="none"
                      stroke="var(--yzj-jade)"
                      stroke-opacity="0.85"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </div>
              ) : null}
            </div>
          ))
        }
      </div>
    </div>

    <!-- 汇流 -->
    <div class="flex items-stretch border-t border-line px-5 py-4">
      <div class="flex w-[218px] shrink-0 items-center">
        <div class="w-full rounded-card border border-gold/40 bg-gold/[0.06] px-3 py-2.5">
          <div class="flex items-baseline gap-2">
            <span class="rounded-[4px] border border-gold/50 px-1.5 py-0.5 font-mono text-[11px] text-gold">
              {lineageSink.code}
            </span>
            <span class="font-serif text-[13.5px] text-ink">{lineageSink.name}</span>
          </div>
          <p class="mt-1.5 font-mono text-[10px] tracking-[0.04em] text-ink-3">
            {lineageSink.era} · 各藏数字汇流
          </p>
        </div>
      </div>
      <div class="flex w-11 shrink-0 items-center justify-center">
        <svg width="30" height="44" viewBox="0 0 30 44" aria-hidden="true" class="overflow-visible">
          <path d="M 3 22 L 24 22" fill="none" stroke="var(--yzj-gold)" stroke-opacity="0.55" stroke-width="1.3"></path>
          <path
            d="M 16 14 L 25 22 L 16 30"
            fill="none"
            stroke="var(--yzj-gold)"
            stroke-opacity="0.9"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </div>
      <div class="flex items-center">
        <div class="rounded-card border border-gold/40 bg-gold/[0.06] px-3 py-2.5">
          <div class="flex items-baseline gap-2">
            <span class="rounded-[4px] border border-gold/50 px-1.5 py-0.5 font-mono text-[11px] text-gold">
              {lineageSite.code}
            </span>
            <span class="font-serif text-[13.5px] text-ink">{lineageSite.name}</span>
          </div>
          <p class="mt-1.5 font-mono text-[10px] tracking-[0.04em] text-ink-3">
            {lineageSite.era} · 本站阅读版
          </p>
        </div>
      </div>
    </div>

    <p class="border-t border-line px-5 py-3 font-mono text-[11px] leading-relaxed tracking-[0.03em] text-ink-3">
      ※ 谱系依 CBETA 各藏实际编纂关系整理（承袭／底本），非本站臆断；各藏档数自本站语料实算。
      标「逾体量上限」者，多因整部文集单档逾本站 150 KB 上限（印顺、太虚、吕澂诸集即属此例）。横向可拖动。
    </p>
  </figure>

  <!-- ══ 各藏明细 ══ -->
  <div class="reveal mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
    <div class="rounded-card border border-line bg-panel shadow-panel">
      <div class="flex items-center gap-3 border-b border-line px-5 py-3">
        <span class="font-mono text-[10.5px] tracking-[0.22em] text-ink-3">SOURCES</span>
        <span class="h-px flex-1 bg-line-2"></span>
        <span class="font-mono text-[10.5px] text-ink-3">按本库收录档数</span>
      </div>
      <ul class="grid gap-x-8 px-5 py-3 sm:grid-cols-2 xl:grid-cols-3">
        {
          tableRows.map((n) => (
            <li class="border-b border-dashed border-line-2 py-2">
              <div class="grid grid-cols-[40px_1fr_auto] items-baseline gap-2.5">
                <span
                  class="rounded-[4px] border px-1 py-0.5 text-center font-mono text-[11px]"
                  style={
                    n.works === 0
                      ? 'border-color:rgb(125 226 199 / 0.14);color:var(--yzj-ink-3)'
                      : 'border-color:rgb(125 226 199 / 0.3);color:var(--yzj-jade);background:rgb(125 226 199 / 0.08)'
                  }
                >
                  {n.code}
                </span>
                <span class="min-w-0">
                  <span class="block truncate text-[13px] text-ink-2">{n.name}</span>
                  <span class="block font-mono text-[10px] tracking-[0.06em] text-ink-3">
                    {n.era} · {n.kind}
                  </span>
                </span>
                <span class="text-right font-mono text-[12px] tabular-nums">
                  <span class="text-ink">{n.works.toLocaleString('en-US')}</span>
                  <span class="ml-1 text-[10px] text-ink-3">档</span>
                </span>
              </div>
              <span class="bar mt-1.5 ml-[50px] block">
                <i style={`--w:${((n.works / maxWorks) * 100).toFixed(2)}%`}></i>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="flex flex-col gap-5">
      <div class="rounded-card border border-line bg-panel p-5 shadow-panel">
        <p class="mb-3.5 font-mono text-[10.5px] tracking-[0.22em] text-ink-3">FOOTPRINT</p>
        <dl class="grid grid-cols-3 gap-3 text-center">
          {
            [
              { k: '藏经', v: `${lineageTotals.sources}` },
              { k: '档', v: lineageTotals.works.toLocaleString('en-US') },
              { k: '卷', v: lineageTotals.juan.toLocaleString('en-US') },
            ].map((x) => (
              <div>
                <dt class="font-mono text-[10px] tracking-[0.14em] text-ink-3">{x.k}</dt>
                <dd class="mt-1 font-mono text-[17px] tabular-nums text-ink">{x.v}</dd>
              </div>
            ))
          }
        </dl>
        <a
          href={u('/stats/')}
          class="mt-4 block font-mono text-[11.5px] tracking-[0.1em] text-jade hover:underline"
        >
          查看藏经来源统计与刻藏概览 →
        </a>
      </div>

      <div class="rounded-card border border-line bg-panel p-5 shadow-panel">
        <p class="mb-3 font-mono text-[10.5px] tracking-[0.22em] text-ink-3">READING ORDER</p>
        <ol class="space-y-2 font-mono text-[11.5px] leading-relaxed tracking-[0.03em] text-ink-2">
          {
            lineageTiers.map((t) => (
              <li>
                <span class="text-jade">{t.label}</span>
                <span class="text-ink-3"> · </span>
                {t.note}
              </li>
            ))
          }
        </ol>
      </div>
    </aside>
  </div>
</section>
