{
  "name": "yuezangjing",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "阅藏经 —— AI大藏经全集在线阅读（Web 站 / 桌面端 / 移动端 三端一体）",
  "license": "MIT",
  "scripts": {
    "build": "node sutra_lib_tool/scripts/build-dist.mjs web",
    "build:all": "node sutra_lib_tool/scripts/build-dist.mjs all",
    "build:web": "node sutra_lib_tool/scripts/build-dist.mjs web",
    "build:desktop": "node sutra_lib_tool/scripts/build-dist.mjs desktop",
    "build:app": "node sutra_lib_tool/scripts/build-dist.mjs app",
    "build:macos": "node sutra_lib_tool/scripts/build-dist.mjs macos",
    "build:windows": "node sutra_lib_tool/scripts/build-dist.mjs windows",
    "build:android": "node sutra_lib_tool/scripts/build-dist.mjs android",
    "build:ios": "node sutra_lib_tool/scripts/build-dist.mjs ios",
    "build:ohos": "node sutra_lib_tool/scripts/build-dist.mjs ohos",
    "dev": "pnpm --filter sutra-web dev",
    "dev:desktop": "pnpm --filter sutra-desktop dev",
    "dev:app": "pnpm --filter sutra-app dev",
    "typecheck": "pnpm -r typecheck",
    "import:sutra": "pnpm --filter sutra-web import:sutra",
    "build:albums": "pnpm --filter sutra-web build:albums",
    "icons": "python3 packages/sutra-shared/scripts/make-icons.py"
  },
  "engines": {
    "node": ">=22"
  }
}
